---
import BaseLayout from "../src/layouts/BaseLayout.astro";
---

<BaseLayout title="FC Mobile Tools" description="Trackers, calculators and companion tools for FC Mobile, built by TanzimFC.">
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid"></div>
    <div class="floodlight"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow-pill"><span class="dot"></span>BUILT FOR FC MOBILE PLAYERS</span>
        <h1>Track it. Predict it.<br><em>Win the cycle.</em></h1>
        <p class="lead">TanzimFC builds the calculators and companion tools that turn every FC Mobile event into something you can actually plan for, starting with Football Centre, your live Showdown tracker.</p>
        <div class="hero-actions">
          <a class="btn primary" href="/football-centre">Open Football Centre →</a>
          <a class="btn" href="/trivia">Play Trivia</a>
          <a class="btn beta" href="/fc-mobile-beta"><span class="beta-dot"></span>Get FC Mobile Beta</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-glow"></div>
        <img src="https://tanzimfc.fcmobiletools.workers.dev/assets/images/7db804bcbdc99731a2d432435f99597b.svg" alt="" loading="eager" />
      </div>
    </div>
    <div class="ticker-shell">
      <div class="ticker" id="ticker"></div>
    </div>
  </section>

  <section id="tools">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-eyebrow">THE TOOLKIT</div>
          <h2>Everything you need,<br>before kickoff.</h2>
        </div>
        <p>No guesswork. Every tool here is built to match FC Mobile's actual scoring and event structure.</p>
      </div>

      <div class="bento">
        <a class="bcard flagship" href="/football-centre" onmousemove="tilt(event,this)">
          <div class="bcard-top">
            <div class="bcard-icon">⚽</div>
            <span class="status-chip live"><span class="dot"></span>LIVE TRACKER</span>
          </div>
          <h3>Football Centre</h3>
          <p>Pick your Showdown winners, log results as they happen, and see exactly how many points stand between you and the target — updated in real time as your cycle plays out.</p>
          <div class="flagship-preview">
            <div class="fp-stat"><span>Target</span><b>4,000</b></div>
            <div class="fp-stat"><span>Per win</span><b class="green">+400</b></div>
            <div class="fp-stat"><span>Showdowns</span><b>8</b></div>
          </div>
          <span class="bcard-link">Open the tracker <span class="arrow">→</span></span>
        </a>

        <a class="bcard trivia" href="/trivia" onmousemove="tilt(event,this)">
          <div class="bcard-top">
            <div class="bcard-icon">🧠</div>
            <span class="status-chip live"><span class="dot"></span>LIVE</span>
          </div>
          <h3>Trivia</h3>
          <p>FC Mobile questions and answers — test what you actually know about the game.</p>
          <span class="bcard-link">Play now <span class="arrow">→</span></span>
        </a>

        <div class="bcard creator" id="creator" onmousemove="tilt(event,this)">
          <div class="bcard-top">
            <div class="bcard-icon">👤</div>
            <span class="status-chip">CREATOR</span>
          </div>
          <div class="creator-row">
            <img class="creator-avatar" src="https://tanzimfc.fcmobiletools.workers.dev/assets/images/Annotation%202026-08-16%20121359.png" alt="TanzimFC" />
            <div>
              <h3 style="margin:0;font-size:18px">TanzimFC</h3>
              <p style="margin:4px 0 0">FC Mobile content &amp; tool builder.</p>
            </div>
          </div>
          <div class="creator-socials">
            <a class="csoc" href="https://www.youtube.com/@tanzimfc" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.8V8.2L16 12l-6.4 3.8Z"/></svg></a>
            <a class="csoc" href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener" aria-label="Discord"><svg viewBox="0 0 24 24"><path d="M19.5 4.5A16.8 16.8 0 0 0 15.6 3l-.5 1a14.3 14.3 0 0 0-6.2 0l-.5-1a16.8 16.8 0 0 0-3.9 1.5C2 8.2 1.3 12 1.7 15.8a16.4 16.4 0 0 0 4.8 2.4l1.2-1.6c-.7-.3-1.3-.6-1.9-1 .2.2.4.3.6.4 2.8 1.3 5.9 1.3 8.7 0 .2-.1.4-.2.6-.4-.6.4-1.2.7-1.9 1l1.2 1.6a16.4 16.4 0 0 0 4.8-2.4c.4-3.8-.3-7.6-1.3-11.3ZM8.8 13.3c-.9 0-1.7-.8-1.7-1.8s.8-1.8 1.7-1.8 1.7.8 1.7 1.8-.8 1.8-1.7 1.8Zm6.4 0c-.9 0-1.7-.8-1.7-1.8s.8-1.8 1.7-1.8 1.7.8 1.7 1.8-.8 1.8-1.7 1.8Z"/></svg></a>
            <a class="csoc" href="https://x.com/TanzimFC" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.49 22H3.38l7.24-8.28L2.8 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.5h1.73L8.25 4.37H6.39L17.8 19.5Z"/></svg></a>
          </div>
        </div>

        <div class="bcard soon" onmousemove="tilt(event,this)">
          <div class="bcard-top">
            <div class="bcard-icon">🛠️</div>
            <span class="status-chip soon">IN THE WORKS</span>
          </div>
          <h3>More tools soon</h3>
          <p>New trackers and calculators are in development. Join the Discord to see them first.</p>
          <div class="soon-dots"><span></span><span></span><span></span></div>
          <a class="bcard-link" href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener">Get notified <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="beta-strip" style="margin-top:16px">
        <div class="beta-strip-left">
          <div class="beta-strip-icon">📲</div>
          <div>
            <h3>FC Mobile Beta is up for download</h3>
            <p>Early access build, free, direct link. Play the newest FC Mobile update before it goes wide.</p>
          </div>
        </div>
        <a class="btn primary green" href="/fc-mobile-beta">Get the beta →</a>
      </div>
    </div>
  </section>

  <div class="strip">
    <div class="wrap">
      <div class="strip-grid">
        <div class="strip-item">
          <div class="num">01</div>
          <h4>Matches real scoring</h4>
          <p>Every calculation mirrors FC Mobile's actual point values, not estimates.</p>
        </div>
        <div class="strip-item">
          <div class="num">02</div>
          <h4>Updates every cycle</h4>
          <p>New Showdowns, teams and events are added as soon as they go live in-game.</p>
        </div>
        <div class="strip-item">
          <div class="num">03</div>
          <h4>Nothing to install</h4>
          <p>Runs straight in your browser, saves your progress locally, no account needed.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function tilt(e: MouseEvent, el: HTMLElement) {
    const r = el.getBoundingClientRect();
    el.style.setProperty("--mx", e.clientX - r.left + "px");
    el.style.setProperty("--my", e.clientY - r.top + "px");
  }
  // @ts-expect-error - exposed for inline onmousemove handlers
  window.tilt = tilt;

  const TICKS: [string, string, string][] = [
    ["🎯", "8/8", "SHOWDOWNS TRACKED THIS CYCLE"],
    ["⚡", "4,000", "POINT TARGET PER CYCLE"],
    ["🧠", "TRIVIA", "NEW QUESTIONS EVERY WEEK"],
    ["📈", "LIVE", "FOOTBALL CENTRE UPDATES IN REAL TIME"],
    ["🏆", "+400", "POINTS PER CORRECT PREDICTION"],
    ["🔔", "DISCORD", "JOIN FOR EARLY TOOL ACCESS"],
  ];
  const tickerEl = document.getElementById("ticker");
  const build = () =>
    TICKS.map(([icon, b, label]) => `<div class="tick"><span class="tick-dot"></span>${icon} <b>${b}</b> ${label}</div>`).join("");
  if (tickerEl) tickerEl.innerHTML = build() + build();
</script>

<style>
  .hero{position:relative;overflow:hidden;padding:88px 0 76px;isolation:isolate}
  .hero-bg{position:absolute;inset:0;z-index:-2;background:
    radial-gradient(ellipse 900px 500px at 18% 8%, #38bdf82e, transparent 60%),
    radial-gradient(ellipse 800px 480px at 88% -6%, #48d98a1f, transparent 62%),
    radial-gradient(ellipse 700px 400px at 50% 100%, #38bdf815, transparent 65%),
    var(--bg);
  }
  .hero-grid{position:absolute;inset:0;z-index:-1;opacity:.35;
    background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);
    background-size:44px 44px;
    mask-image:radial-gradient(ellipse 700px 420px at 50% 20%, black, transparent 75%);
  }
  .floodlight{position:absolute;top:-40%;left:50%;width:1400px;height:900px;transform:translateX(-50%);z-index:-1;pointer-events:none;
    background:conic-gradient(from 200deg at 50% 0%, transparent 0deg, #38bdf829 8deg, transparent 20deg, transparent 340deg, #48d98a1c 352deg, transparent 360deg);
    animation:sweep 9s ease-in-out infinite;
    mix-blend-mode:screen;
  }
  @keyframes sweep{0%,100%{transform:translateX(-52%) rotate(-2deg)}50%{transform:translateX(-48%) rotate(2deg)}}

  .hero-inner{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:32px}
  .hero-copy{max-width:560px}

  .hero-art{position:relative;display:flex;justify-content:center;align-items:center;min-height:420px}
  .hero-art-glow{position:absolute;width:480px;height:480px;border-radius:50%;
    background:radial-gradient(circle, #38bdf84a, #38bdf81a 55%, transparent 72%);
    filter:blur(6px);
    animation:artglow 4.5s ease-in-out infinite;
  }
  @keyframes artglow{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.08);opacity:1}}
  .hero-art img{position:relative;z-index:1;width:100%;max-width:460px;filter:drop-shadow(0 30px 60px #000a);opacity:0;animation:art-rise 1s cubic-bezier(.2,.8,.2,1) forwards .25s}
  @keyframes art-rise{from{opacity:0;transform:translateY(28px) scale(.96)}to{opacity:1;transform:none}}

  .eyebrow-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px 6px 8px;border-radius:99px;border:1px solid var(--border);background:var(--surface);font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.08em;color:var(--muted);margin-bottom:22px;opacity:0;animation:rise .7s ease forwards .05s}
  .eyebrow-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px #48d98a;animation:pulse 2s ease-in-out infinite}

  .hero h1{font-size:clamp(36px,5.4vw,68px);line-height:.98;letter-spacing:-.04em;font-weight:900;margin:0 0 20px;opacity:0;animation:rise .8s ease forwards .12s}
  .hero h1 em{font-style:normal;background:linear-gradient(135deg,var(--blue-light),var(--green));-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p.lead{font-size:clamp(15px,1.6vw,18px);color:var(--muted);max-width:520px;margin:0 0 34px;opacity:0;animation:rise .8s ease forwards .2s}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;opacity:0;animation:rise .8s ease forwards .28s}
  .hero-actions .btn{padding:13px 22px;font-size:13px}

  .ticker-shell{margin-top:56px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden;opacity:0;animation:rise .8s ease forwards .4s}
  .ticker{display:flex;gap:0;width:max-content;animation:ticker 26s linear infinite}
  .ticker-shell:hover .ticker{animation-play-state:paused}
  @keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .tick{display:flex;align-items:center;gap:9px;padding:14px 26px;font-family:var(--mono);font-size:11px;font-weight:600;color:var(--muted);white-space:nowrap;border-right:1px solid var(--border)}
  .tick b{color:var(--text);font-weight:700}
  .tick .tick-dot{width:5px;height:5px;border-radius:50%;background:var(--blue)}

  section{padding:88px 0}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:36px;flex-wrap:wrap}
  .section-eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--blue-light);font-weight:700;margin-bottom:10px}
  .section-head h2{font-size:clamp(26px,3.4vw,38px);letter-spacing:-.03em;margin:0;font-weight:850}
  .section-head p{color:var(--muted);font-size:14px;max-width:440px;margin:8px 0 0}

  .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:16px}
  .bcard{position:relative;display:flex;flex-direction:column;grid-column:span 6;border-radius:20px;border:1px solid var(--border);background:linear-gradient(160deg,#101720,#0b1119);padding:28px;overflow:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s ease,box-shadow .35s ease;isolation:isolate}
  .bcard.trivia{justify-content:space-between}
  .bcard.trivia p{margin-bottom:0}
  .bcard.flagship{grid-column:span 4;grid-row:span 2;padding:34px}
  .bcard.trivia{grid-column:span 2;grid-row:span 2}
  .bcard.creator{grid-column:span 3}
  .bcard.soon{grid-column:span 3}
  .bcard::before{content:"";position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .4s ease;
    background:radial-gradient(420px 260px at var(--mx,50%) var(--my,0%), #38bdf82e, transparent 70%);}
  .bcard:hover::before{opacity:1}
  .bcard:hover{transform:translateY(-4px);border-color:#3a3a42;box-shadow:0 20px 50px #00000059}
  .bcard-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:auto}
  .bcard-icon{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:19px;flex:0 0 auto;border:1px solid var(--border)}
  .bcard.flagship .bcard-icon{background:linear-gradient(145deg,#38bdf833,#38bdf80d)}
  .bcard.trivia .bcard-icon{background:linear-gradient(145deg,#48d98a2e,#48d98a0d)}
  .bcard.creator .bcard-icon{background:linear-gradient(145deg,#38bdf82e,#38bdf80d)}
  .status-chip{font-family:var(--mono);font-size:9px;font-weight:700;letter-spacing:.1em;padding:5px 9px;border-radius:99px;border:1px solid var(--border);color:var(--muted);display:flex;align-items:center;gap:6px}
  .status-chip.live{color:#9ff5c4;border-color:#255d42;background:#18432c33}
  .status-chip.live .dot{width:5px;height:5px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse 2s ease-in-out infinite}
  .status-chip.soon{color:#bae6fd;border-color:#3a3a42}

  .bcard h3{font-size:22px;font-weight:850;letter-spacing:-.02em;margin:18px 0 8px}
  .bcard.flagship h3{font-size:30px;margin-top:26px}
  .bcard p{color:var(--muted);font-size:13.5px;margin:0 0 20px;max-width:34ch}
  .bcard-link{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:750;color:var(--text)}
  .bcard-link .arrow{transition:transform .25s ease}
  .bcard:hover .bcard-link .arrow{transform:translateX(4px)}

  .flagship-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:22px 0 24px}
  .fp-stat{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:11px 12px}
  .fp-stat span{display:block;font-family:var(--mono);font-size:8.5px;color:var(--muted);letter-spacing:.05em;font-weight:600;text-transform:uppercase}
  .fp-stat b{display:block;margin-top:5px;font-size:17px;font-weight:800}
  .fp-stat b.green{color:var(--green)}

  .creator-row{display:flex;align-items:center;gap:14px;margin-top:18px}
  .creator-avatar{width:52px;height:52px;border-radius:14px;object-fit:cover;border:1px solid var(--border)}
  .creator-socials{display:flex;gap:8px;margin-top:16px}

  .soon-dots{display:flex;gap:6px;margin:18px 0}
  .soon-dots span{width:7px;height:7px;border-radius:50%;background:var(--border);animation:blink 1.4s ease-in-out infinite}
  .soon-dots span:nth-child(2){animation-delay:.2s}
  .soon-dots span:nth-child(3){animation-delay:.4s}
  @keyframes blink{0%,100%{opacity:.3}50%{opacity:1}}

  .beta-strip{position:relative;overflow:hidden;border-radius:20px;border:1px solid #255d42;background:linear-gradient(135deg,#0d1a14,#0d141c);padding:36px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .beta-strip-left{display:flex;align-items:center;gap:18px}
  .beta-strip-icon{width:52px;height:52px;border-radius:14px;background:var(--green-dim);border:1px solid #255d42;display:grid;place-items:center;font-size:22px;flex:0 0 auto}
  .beta-strip h3{font-size:19px;font-weight:850;margin:0 0 6px}
  .beta-strip p{font-size:13.5px;color:var(--muted);margin:0;max-width:44ch}

  .strip{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface)}
  .strip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0}
  .strip-item{padding:34px 30px;border-right:1px solid var(--border)}
  .strip-item:last-child{border-right:0}
  .strip-item .num{font-family:var(--mono);font-size:11px;color:var(--blue-light);font-weight:700;margin-bottom:10px}
  .strip-item h4{font-size:15px;margin:0 0 6px;font-weight:800}
  .strip-item p{font-size:12.5px;color:var(--muted);margin:0}

  @media(max-width:900px){
    .hero-inner{grid-template-columns:1fr;text-align:center}
    .hero-copy{max-width:none;margin:0 auto}
    .hero-actions{justify-content:center}
    .hero-art{order:-1;min-height:280px}
    .hero-art img{max-width:280px}
    .hero-art-glow{width:320px;height:320px}
    .bento{grid-template-columns:repeat(2,1fr)}
    .bcard,.bcard.flagship,.bcard.trivia,.bcard.creator,.bcard.soon{grid-column:span 2;grid-row:auto}
    .strip-grid{grid-template-columns:1fr}
    .strip-item{border-right:0;border-bottom:1px solid var(--border)}
    .strip-item:last-child{border-bottom:0}
    .beta-strip{flex-direction:column;align-items:flex-start;text-align:left}
  }
  @media(max-width:560px){
    .hero{padding:56px 0 52px}
    .hero-art{min-height:220px}
    .hero-art img{max-width:220px}
    .hero-art-glow{width:260px;height:260px}
    .bento{grid-template-columns:1fr}
    .bcard,.bcard.flagship,.bcard.trivia,.bcard.creator,.bcard.soon{grid-column:1}
    .flagship-preview{grid-template-columns:1fr 1fr}
    .hero-actions{flex-direction:column}
    .hero-actions .btn{width:100%;justify-content:center}
    .beta-strip{padding:26px}
    .beta-strip-left{flex-direction:column;align-items:flex-start}
  }
</style>
