---
// Shared shell for every Trivia page: design system, ambient background,
// JSON-LD slot and the small effects script (reveal, spotlight, tilt, counters).
import BaseLayout from './BaseLayout.astro';
import '../styles/trivia-base.css';
import '../styles/trivia-pages.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  robots?: string;
  /** "r, g, b" for the page accent glow (defaults to brand cyan). */
  accentRgb?: string;
  jsonLd?: unknown[];
  ambient?: boolean;
}
const { title, description, image, canonical, robots, accentRgb, jsonLd = [], ambient = true } = Astro.props;
const style = accentRgb ? `--tv-accent-rgb:${accentRgb};--tv-accent:rgb(${accentRgb});--g:${accentRgb}` : undefined;
---
<BaseLayout title={title} description={description} image={image} canonical={canonical} robots={robots}>
  <script is:inline slot="head">
    (function () {
      var root = document.documentElement;
      root.classList.add('tv-js', 'tv-page');
      // Fail-safe: if the effects script has not started within 3s, show everything instead of
      // leaving reveal-on-scroll content invisible.
      setTimeout(function () { if (!root.classList.contains('tv-fx')) root.classList.add('tv-nofx'); }, 3000);
    })();
  </script>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  {jsonLd.map((data) => <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(data)} />)}
  <main class="tv" style={style}>
    {ambient && (
      <div class="tv-ambient" aria-hidden="true">
        <i class="tv-aurora a"></i><i class="tv-aurora b"></i><i class="tv-aurora c"></i>
        <svg class="tv-pitch" viewBox="0 0 1100 700" fill="none" stroke="#fff" stroke-width="2">
          <rect x="20" y="20" width="1060" height="660" rx="6" /><path d="M550 20v660" /><circle cx="550" cy="350" r="92" />
          <rect x="20" y="190" width="170" height="320" /><rect x="910" y="190" width="170" height="320" />
          <rect x="20" y="268" width="62" height="164" /><rect x="1018" y="268" width="62" height="164" />
        </svg>
      </div>
    )}
    <slot />
  </main>
  <script>
    import '../scripts/trivia-fx.js';
  </script>
</BaseLayout>

<style is:global>
  /* ------------------------------------------------------------------
     Trivia pages: nothing sticks, floats or blocks the screen.
     (Scoped to html.tv-page, so the rest of the site is untouched.)
     ------------------------------------------------------------------ */
  /* The floating navbar island scrolls away with the page instead of following you down. */
  html.tv-page .fcmt { position: absolute; left: 0; right: 0; top: 0; }
  /* The fixed bottom dock used to sit on top of answer buttons on phones. */
  html.tv-page .fcmt-dock { display: none !important; }
  /* The splash loader blocked every click for up to ~3s. Trivia is a game; it should be playable at once. */
  html.tv-page .site-loader { display: none !important; }
  /* One continuous near-black canvas from navbar to footer (no colour seam). */
  html.tv-page, html.tv-page body { background: #08090c; }
</style>
