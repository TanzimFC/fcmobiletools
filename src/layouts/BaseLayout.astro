---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../../styles.css';
export interface Props { title: string; description?: string; }
const { title, description = 'FC Mobile tools, trivia, guides and event resources from TanzimFC.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#55c7f2" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <title>{title} — FC Mobile Tools</title>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YY53FCHMLW"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-YY53FCHMLW');</script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <Navbar />
  <div id="content"><slot /></div>
  <Footer />
  <style is="global">
    .skip-link{position:fixed;left:14px;top:14px;z-index:2000;transform:translateY(-180%);padding:10px 14px;border:1px solid var(--blue);border-radius:9px;background:var(--surface2);color:var(--text);font:800 10px var(--mono);text-decoration:none;transition:transform .18s}
    .skip-link:focus{transform:translateY(0)}
    #content{scroll-margin-top:90px}
    .legacy-app-host .nav,.legacy-app-host nav.nav{display:none!important}
    .legacy-app-host{isolation:isolate}
    .site-nav{position:sticky!important;z-index:1000!important}
  </style>
</body>
</html>
