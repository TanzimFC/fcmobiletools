---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteAds from '../components/SiteAds.astro';
import '../../styles.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  author?: string;
}

const {
  title,
  description = 'FCMOBILETOOLS is your FC Mobile hub for live events, redeem codes, player tools, calculators, guides and the latest game updates.',
  image = 'https://res.cloudinary.com/b0qikv7n/image/upload/f_auto,q_auto,w_1200/v1789653531/fc-mobile-tools/o6ocwktktmw5yml9n8km.png',
  type = 'website',
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://fcmobiletools.online');
const canonicalPath = Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(canonicalPath, siteOrigin);
const siteUrl = new URL('/', siteOrigin);
const siteName = 'FCMOBILETOOLS';
const siteDescription = description;
const socialImage = image ? new URL(image, siteOrigin).toString() : new URL('/assets/images/hero.png', siteOrigin).toString();
const isHomePage = canonical.pathname === '/';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteUrl.toString() + '#website',
  name: siteName,
  alternateName: 'FC Mobile Tools',
  url: siteUrl.toString(),
  description: siteDescription,
  publisher: { '@id': siteUrl.toString() + '#organization' }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl.toString() + '#organization',
  name: siteName,
  alternateName: 'FC Mobile Tools',
  url: siteUrl.toString(),
  logo: {
    '@type': 'ImageObject',
    url: new URL('/assets/images/favicon.png', siteOrigin).toString()
  }
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  '@id': canonical.toString() + '#webpage',
  url: canonical.toString(),
  name: title,
  description: description,
  isPartOf: { '@id': siteUrl.toString() + '#website' }
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#071018" />
  <meta name="description" content={description} />
  <meta name="author" content={author ?? 'FCMOBILETOOLS'} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content="FCMobiletools" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="FCMOBILETOOLS FC Mobile artwork" />
  {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
  {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}
  {section ? <meta property="article:section" content={section} /> : null}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:image" content={socialImage} />
  <title>{title} | FCMOBILETOOLS</title>
  {isHomePage ? <>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </> : <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YY53FCHMLW"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-YY53FCHMLW');</script>
</head>
<body>
  <div id="site-loader" class="site-loader" aria-hidden="true">
    <div class="sl-half sl-top"></div>
    <div class="sl-half sl-bot"></div>
    <i class="sl-line sl-line-l"></i>
    <i class="sl-line sl-line-r"></i>
    <div class="sl-core">
      <div class="sl-ring">
        <svg viewBox="0 0 220 220" fill="none" aria-hidden="true">
          <circle class="sl-track" cx="110" cy="110" r="96" />
          <circle class="sl-arc" cx="110" cy="110" r="96" pathLength="100" transform="rotate(-90 110 110)" />
          <g class="sl-head">
            <circle class="sl-halo" cx="110" cy="14" r="9" />
            <circle class="sl-dot" cx="110" cy="14" r="2.6" />
          </g>
        </svg>
        <img class="sl-logo" src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" fetchpriority="high" decoding="async" />
      </div>
      <span class="sl-num"><i>0</i>%</span>
    </div>
  </div>
  <noscript><style>.site-loader{display:none}</style></noscript>
  <a class="skip-link" href="#content">Skip to content</a>
  <Navbar />
  <div id="content"><slot /></div>
  <Footer />
  <SiteAds />
  <script is:inline>
    (() => {
      const loader = document.getElementById('site-loader');
      if (!loader) return;

      const arc = loader.querySelector('.sl-arc');
      const head = loader.querySelector('.sl-head');
      const num = loader.querySelector('.sl-num i');

      // Loader timing: MIN is the minimum visible time; MAX is the safety ceiling.
      const MIN = 650;
      const MAX = 2200;

      let p = 0;
      let start = performance.now();
      let raf = 0;
      let timer = 0;
      let ready = document.readyState === 'complete';

      const stop = () => {
        cancelAnimationFrame(raf);
        clearTimeout(timer);
      };

      const paint = () => {
        arc.style.strokeDashoffset = String(100 - p * 100);
        head.setAttribute('transform', 'rotate(' + p * 360 + ' 110 110)');
        num.textContent = Math.round(p * 100);
      };

      const open = () => {
        stop();
        p = 1;
        paint();
        loader.classList.add('done');
      };

      const tick = (now) => {
        const t = now - start;
        const canFinish = (ready || t > MAX) && t > MIN;

        if (canFinish) {
          p = Math.min(1, p + Math.max((1 - p) * 0.34, 0.02));
        } else {
          p += (Math.min(0.9, 1 - Math.exp(-t / 800)) - p) * 0.1;
        }

        paint();

        if (p < 1) {
          raf = requestAnimationFrame(tick);
        } else {
          timer = setTimeout(open, 120);
        }
      };

      if (!ready) {
        window.addEventListener('load', () => {
          ready = true;
        }, { once: true });
      }

      raf = requestAnimationFrame(tick);

      // Back/forward cache restore: never leave the loader stuck on screen.
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        stop();
        p = 1;
        paint();
        open();
      });
    })();
  </script>
  <script is:inline>
    (() => {
      const markInvalid = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
        if (field.validity?.valid) field.removeAttribute('aria-invalid');
        else field.setAttribute('aria-invalid','true');
      };
      document.addEventListener('invalid', (event) => markInvalid(event.target), true);
      document.addEventListener('input', (event) => markInvalid(event.target));
      document.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', () => {
          form.classList.add('was-validated');
          const submitter = form.querySelector('button[type="submit"],input[type="submit"]');
          if (submitter) {
            submitter.setAttribute('aria-busy','true');
            window.setTimeout(() => submitter.removeAttribute('aria-busy'), 12000);
          }
        });
      });
      window.addEventListener('pageshow', () => {
        document.querySelectorAll('[aria-busy="true"]').forEach((element) => element.removeAttribute('aria-busy'));
      });
    })();
  </script>
  <style is="global">
    /* ---- Site loader: a football pitch that splits along the halfway line ---- */
    .site-loader{
      --sl-bg:#050b11;
      --sl-ac:var(--primary,#4cc9ff);
      position:fixed;
      inset:0;
      z-index:5000;
      display:grid;
      place-items:center;
      overflow:hidden;
      visibility:visible;
      pointer-events:auto;
      background:var(--sl-bg);
    }
    .site-loader.done{
      visibility:hidden;
      pointer-events:none;
      transition:visibility 0s linear .48s;
    }

    .sl-half{
      position:absolute;
      left:0;
      right:0;
      height:50%;
      z-index:0;
      background:
        repeating-linear-gradient(90deg,rgba(255,255,255,.022) 0 72px,transparent 72px 144px),
        linear-gradient(180deg,rgba(255,255,255,.012),transparent 24%,transparent 76%,rgba(0,0,0,.06)),
        var(--sl-bg);
      transition:transform .55s cubic-bezier(.5,0,.2,1);
      will-change:transform;
    }
    .sl-top{top:0}
    .sl-bot{bottom:0}
    .done .sl-top{
      transform:translateY(-101%);
      transition:transform .38s cubic-bezier(.76,0,.24,1) .04s;
    }
    .done .sl-bot{
      transform:translateY(101%);
      transition:transform 1s cubic-bezier(.76,0,.24,1) .3s;
    }

    .sl-line{
      position:absolute;
      top:50%;
      z-index:1;
      height:1px;
      width:calc(50% - 128px);
      animation:sl-draw 1.1s cubic-bezier(.2,.7,.2,1) .1s both;
    }
    .sl-line-l{
      left:0;
      transform-origin:right center;
      background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--sl-ac) 50%,transparent));
    }
    .sl-line-r{
      right:0;
      transform-origin:left center;
      background:linear-gradient(270deg,transparent,color-mix(in srgb,var(--sl-ac) 50%,transparent));
    }
    .done .sl-line{
      opacity:0;
      transition:opacity .25s ease;
    }

    .sl-core{
      position:relative;
      z-index:2;
      transition:opacity .18s ease,transform .24s cubic-bezier(.4,0,.2,1);
    }
    .done .sl-core{
      opacity:0;
      transform:scale(1.045);
    }

    .sl-ring{
      position:relative;
      display:grid;
      place-items:center;
      width:220px;
      height:220px;
    }
    .sl-ring::before,
    .sl-ring::after{
      content:"";
      position:absolute;
      pointer-events:none;
      border:1px solid color-mix(in srgb,var(--sl-ac) 10%,transparent);
      border-radius:50%;
    }
    .sl-ring::before{
      inset:19px;
    }
    .sl-ring::after{
      inset:42px;
      opacity:.55;
    }
    .sl-ring svg{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      overflow:visible;
    }
    .sl-track{
      stroke:rgba(150,210,235,.11);
      stroke-width:1;
      animation:sl-fade .7s ease both;
    }
    .sl-arc{
      stroke:var(--sl-ac);
      stroke-width:1.5;
      stroke-linecap:round;
      stroke-dasharray:100 100;
      stroke-dashoffset:100;
      filter:drop-shadow(0 0 4px color-mix(in srgb,var(--sl-ac) 65%,transparent));
    }
    .sl-halo{
      fill:var(--sl-ac);
      opacity:.16;
    }
    .sl-dot{
      fill:#e6f9ff;
      filter:drop-shadow(0 0 4px var(--sl-ac));
    }

    .sl-logo{
      position:relative;
      width:118px;
      height:auto;
      object-fit:contain;
      filter:drop-shadow(0 10px 20px rgba(0,0,0,.34));
      animation:sl-in .9s cubic-bezier(.2,.7,.2,1) .2s both;
    }

    .sl-num{
      position:absolute;
      top:100%;
      left:50%;
      margin-top:28px;
      transform:translateX(-50%);
      color:rgba(190,226,240,.5);
      font:500 12px/1 var(--font-body);
      letter-spacing:.1em;
      font-variant-numeric:tabular-nums;
      white-space:nowrap;
      animation:sl-fade .6s ease .5s both;
    }
    .sl-num i{font-style:normal;color:color-mix(in srgb,var(--sl-ac) 76%,#dbeefa)}

    @keyframes sl-draw{
      from{transform:scaleX(0)}
      to{transform:scaleX(1)}
    }
    @keyframes sl-fade{
      from{opacity:0}
      to{opacity:1}
    }
    @keyframes sl-in{
      from{opacity:0;transform:scale(.94);filter:blur(8px)}
      to{opacity:1;transform:none;filter:blur(0)}
    }

    @media(max-width:520px){
      .sl-ring{width:180px;height:180px}
      .sl-logo{width:96px}
      .sl-line{width:calc(50% - 108px)}
      .sl-num{margin-top:24px}
    }

    @media(prefers-reduced-motion:reduce){
      .sl-line,.sl-logo,.sl-num,.sl-track{animation:none!important}
      .sl-half{transition:none!important}
      .done .sl-top,.done .sl-bot{transform:none!important}
      .done .sl-core{transform:none}
      .site-loader{transition:opacity .3s ease}
      .site-loader.done{
        opacity:0;
        transition:opacity .3s ease,visibility 0s linear .3s;
      }
    }

    .skip-link{
      position:fixed;left:16px;top:16px;z-index:2000;
      transform:translateY(-180%);padding:10px 14px;border:1px solid var(--primary);
      border-radius:10px;background:var(--surface2);color:var(--text);
      font:700 12px var(--font-body);text-decoration:none;transition:transform .18s ease;
    }
    .skip-link:focus{transform:translateY(0)}
    #content{scroll-margin-top:96px}
    .legacy-app-host .nav,.legacy-app-host nav.nav{display:none!important}
    .legacy-app-host{isolation:isolate}
  </style>
</body>
</html>