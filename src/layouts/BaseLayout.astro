---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteAds from '../components/SiteAds.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import HalloweenLoader from '../components/HalloweenLoader.astro';
import '../../styles.css';
import '../styles/luxe.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  author?: string;
  robots?: string;
  googlebot?: string;
  /** Override the canonical URL (path or absolute). Used by pages that point at a moved target. */
  canonical?: string;
}

const {
  title,
  description = 'FCMOBILETOOLS is your FC Mobile hub for live events, redeem codes, player tools, calculators, guides and the latest game updates.',
  image = 'https://res.cloudinary.com/b0qikv7n/image/upload/f_auto,q_auto,w_1200/v1789653531/fc-mobile-tools/o6ocwktktmw5yml9n8km.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  author = 'FCMOBILETOOLS',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  googlebot = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  canonical: canonicalOverride,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://fcmobiletools.online');
const canonicalPath = Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonical = new URL(canonicalOverride ?? canonicalPath, siteOrigin);
const siteUrl = new URL('/', siteOrigin);
const siteName = 'FCMOBILETOOLS';
const siteDescription = description;
const socialImage = image ? new URL(image, siteOrigin).toString() : new URL('/assets/images/hero.png', siteOrigin).toString();
const isHomePage = canonical.pathname === '/';

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteUrl.toString() + '#website',
  name: siteName,
  alternateName: 'FC Mobile Tools',
  url: siteUrl.toString(),
  description: siteDescription,
  publisher: { '@id': siteUrl.toString() + '#organization' }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': siteUrl.toString() + '#organization',
  name: siteName,
  alternateName: 'FC Mobile Tools',
  url: siteUrl.toString(),
  logo: {
    '@type': 'ImageObject',
    url: new URL('/assets/images/favicon.png', siteOrigin).toString()
  }
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical.toString() + '#webpage',
  url: canonical.toString(),
  name: title,
  description: description,
  isPartOf: { '@id': siteUrl.toString() + '#website' }
};
---
<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    (() => {
      const legacyHost = 'tanzimfc.fcmobiletools.workers.dev';
      if (window.location.hostname === legacyHost) {
        window.location.replace('https://fcmobiletools.online' + window.location.pathname + window.location.search + window.location.hash);
      }
    })();
  </script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5SG8X4YV03"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    // Google Consent Mode defaults. Analytics starts only after the visitor
    // grants analytics consent in the site's privacy controls.
    gtag('consent','default',{
      ad_storage:'denied',
      analytics_storage:'denied',
      ad_user_data:'denied',
      ad_personalization:'denied',
      wait_for_update:500
    });

    gtag('js', new Date());
    gtag('config', 'G-5SG8X4YV03');
    
    window.FCMOBILETOOLS_OPEN_PRIVACY_CHOICES=()=>{
      if(window.googlefc?.callbackQueue && typeof window.googlefc.showRevocationMessage==='function'){
        window.googlefc.callbackQueue.push(window.googlefc.showRevocationMessage);
        return true;
      }
      if(window.googlefc?.callbackQueue){
        window.googlefc.callbackQueue.push(()=>{
          if(typeof window.googlefc?.showRevocationMessage==='function') window.googlefc.showRevocationMessage();
        });
        return true;
      }
      window.dispatchEvent(new CustomEvent('fcmobiletools:privacy-unavailable'));
      return false;
    };
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#071018" />
  <meta name="description" content={description} />
  <meta name="author" content={author ?? 'FCMOBILETOOLS'} />
  <meta name="robots" content={robots} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="googlebot" content={googlebot} />
  <meta name="google-adsense-account" content="ca-pub-2527295119501596" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2527295119501596" crossorigin="anonymous"></script>
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/assets/images/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/images/favicon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {isHomePage ? <>
    <link rel="preload" as="image" href="/assets/images/hero-home.webp" type="image/webp" media="(min-width: 701px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/assets/images/hero-home-mobile.webp" type="image/webp" media="(max-width: 700px)" fetchpriority="high" />
  </> : null}
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  </noscript>
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content="FCMobiletools" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:alt" content="FCMOBILETOOLS FC Mobile artwork" />
  {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
  {modifiedTime ? <meta property="article:modified_time" content={modifiedTime} /> : null}
  {section ? <meta property="article:section" content={section} /> : null}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:image" content={socialImage} />
  <title>{title} | FCMOBILETOOLS</title>
  {isHomePage ? <>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </> : <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>}

  <slot name="head" />
</head>
<body>
  <HalloweenLoader />
  <a class="skip-link" href="#content">Skip to content</a>
  <Navbar />
  <div id="content"><slot /></div>
  <Footer />
  <SiteAds />
  <ConsentBanner />

  <script is:inline>
    (() => {
      const token = () => {
        try {
          const raw = localStorage.getItem('fcmobiletools-auth-v1');
          const data = raw ? JSON.parse(raw) : null;
          return data?.access_token || data?.session?.access_token || data?.currentSession?.access_token || '';
        } catch { return ''; }
      };
      const track = async (eventType, entityType, entityId, durationMs, metadata = {}) => {
        const accessToken = token();
        if (!accessToken) return;
        try {
          await fetch('/api/account/activity', {
            method: 'POST',
            headers: { authorization: 'Bearer ' + accessToken, 'content-type': 'application/json' },
            body: JSON.stringify({
              eventType,
              entityType,
              entityId,
              durationMs,
              metadata,
              idempotencyKey: crypto.randomUUID()
            }),
            keepalive: true
          });
        } catch {}
      };

      window.addEventListener('fcmobiletools:tool-activity', (event) => {
        const detail = event.detail;
        if (!detail?.entityId) return;
        track(
          'calculator_use',
          'calculator',
          String(detail.entityId),
          Math.max(3000, Math.min(600000, Number(detail.durationMs || 3000))),
          detail.metadata || {}
        );
      });

      const path = location.pathname.replace(/\/$/, '') || '/';
      const fallbackCalculators = {
        '/training-calculator': 'training-calculator',
        '/investment-calculator': 'investment-calculator'
      };
      const calculator = fallbackCalculators[path];
      if (calculator) {
        let touched = false;
        let timer = 0;
        const arm = () => {
          if (touched) return;
          touched = true;
          clearTimeout(timer);
          timer = setTimeout(() => track('calculator_use', 'calculator', calculator, 3000), 3500);
        };
        const main = document.querySelector('main');
        main?.addEventListener('input', arm, { once: true, passive: true });
        main?.addEventListener('change', arm, { once: true, passive: true });
        main?.addEventListener('click', (event) => {
          if (event.target?.closest('a,[data-site-nav]')) return;
          arm();
        }, { once: true });
      }
    })();
  </script>
  <script is:inline>
    (() => {
      const markInvalid = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
        if (field.validity?.valid) field.removeAttribute('aria-invalid');
        else field.setAttribute('aria-invalid','true');
      };
      document.addEventListener('invalid', (event) => markInvalid(event.target), true);
      document.addEventListener('input', (event) => markInvalid(event.target));
      document.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', () => {
          form.classList.add('was-validated');
          const submitter = form.querySelector('button[type="submit"],input[type="submit"]');
          if (submitter) {
            submitter.setAttribute('aria-busy','true');
            window.setTimeout(() => submitter.removeAttribute('aria-busy'), 12000);
          }
        });
      });
      window.addEventListener('pageshow', () => {
        document.querySelectorAll('[aria-busy="true"]').forEach((element) => element.removeAttribute('aria-busy'));
      });
    })();
  </script>
  <script is:inline>
    (() => {
      // Carry the current page (including filters and hash anchors) through every
      // account entry point. sessionStorage is a backup for JS redirects and OAuth.
      const RETURN_KEY = 'fcmt:account:return:v1';
      const isAccountPath = (pathname) => pathname === '/account' || pathname.startsWith('/account/');
      const currentReturnPath = () => location.pathname + location.search + location.hash;

      const rememberReturnPath = (path) => {
        try {
          sessionStorage.setItem(RETURN_KEY, JSON.stringify({ path, savedAt: Date.now() }));
        } catch {}
      };

      const makeAccountUrl = (mode = '', path = currentReturnPath()) => {
        const destination = new URL('/account/', location.origin);
        if (mode) destination.searchParams.set('mode', mode);
        destination.searchParams.set('next', path);
        return destination.pathname + destination.search + destination.hash;
      };

      window.FCAccountNavigation = {
        url: (mode = '', path = currentReturnPath()) => makeAccountUrl(mode, path),
        go: (mode = '', path = currentReturnPath()) => {
          rememberReturnPath(path);
          location.assign(makeAccountUrl(mode, path));
        }
      };

      const prepareAccountLink = (event) => {
        const link = event.target?.closest?.('a[href]');
        if (!link || isAccountPath(location.pathname)) return;
        try {
          const destination = new URL(link.getAttribute('href'), location.href);
          if (destination.origin !== location.origin || !isAccountPath(destination.pathname)) return;
          const explicitNext = destination.searchParams.get('next');
          const returnPath = explicitNext || currentReturnPath();
          rememberReturnPath(returnPath);
          if (!explicitNext) destination.searchParams.set('next', returnPath);
          link.href = destination.pathname + destination.search + destination.hash;
        } catch {}
      };

      document.addEventListener('pointerdown', prepareAccountLink, true);
      document.addEventListener('click', prepareAccountLink, true);
      document.addEventListener('auxclick', prepareAccountLink, true);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') prepareAccountLink(event);
      }, true);
    })();
  </script>
  <style is="global">
    .skip-link{
      position:fixed;left:16px;top:16px;z-index:2000;
      transform:translateY(-180%);padding:10px 14px;border:1px solid var(--primary);
      border-radius:10px;background:var(--surface2);color:var(--text);
      font:700 12px var(--font-body);text-decoration:none;transition:transform .18s ease;
    }
    .skip-link:focus{transform:translateY(0)}
    #content{scroll-margin-top:96px}
    .legacy-app-host .nav,.legacy-app-host nav.nav{display:none!important}
    .legacy-app-host{isolation:isolate}
  </style>
  <script>
    import '../scripts/luxe.js';
  </script>
</body>
</html>
