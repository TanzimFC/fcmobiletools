---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteAds from '../components/SiteAds.astro';
import '../../styles.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'FC Mobile tools, calculators, redeem codes, guides and event resources from FCMobiletools.',
  image = 'https://res.cloudinary.com/b0qikv7n/image/upload/f_auto,q_auto,w_1200/v1789653531/fc-mobile-tools/o6ocwktktmw5yml9n8km.png',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev');
const siteUrl = new URL('/', Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev');
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FCMobiletools',
  alternateName: 'FC Mobile Tools',
  url: siteUrl,
  publisher: {
    '@type': 'Person',
    name: 'Tanzim',
  },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#071018" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content="FCMobiletools" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:alt" content="FCMobiletools FC Mobile artwork" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <title>{title} — FCMobiletools</title>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YY53FCHMLW"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-YY53FCHMLW');</script>
</head>
<body>
  <div id="site-loader" class="site-loader" aria-hidden="true"><span class="site-loader-mark"></span><b>FCMOBILETOOLS</b></div>
  <a class="skip-link" href="#content">Skip to content</a>
  <Navbar />
  <div id="content"><slot /></div>
  <Footer />
  <SiteAds />
  <script is:inline>
    (() => {
      const loader = document.getElementById('site-loader');
      const finish = () => loader?.classList.add('done');
      if (document.readyState === 'complete') requestAnimationFrame(finish);
      else window.addEventListener('load', () => requestAnimationFrame(finish), { once: true });
      setTimeout(finish, 1400);
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a');
        if (!link || !loader || link.target === '_blank' || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.href);
        if (url.origin === location.origin && url.pathname !== location.pathname && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
          loader.classList.remove('done');
        }
      }, { capture: true });
    })();
  </script>
  <script is:inline>
    (() => {
      const markInvalid = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
        if (field.validity?.valid) field.removeAttribute('aria-invalid');
        else field.setAttribute('aria-invalid','true');
      };
      document.addEventListener('invalid', (event) => markInvalid(event.target), true);
      document.addEventListener('input', (event) => markInvalid(event.target));
      document.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', () => {
          form.classList.add('was-validated');
          const submitter = form.querySelector('button[type="submit"],input[type="submit"]');
          if (submitter) {
            submitter.setAttribute('aria-busy','true');
            window.setTimeout(() => submitter.removeAttribute('aria-busy'), 12000);
          }
        });
      });
      window.addEventListener('pageshow', () => {
        document.querySelectorAll('[aria-busy="true"]').forEach((element) => element.removeAttribute('aria-busy'));
      });
    })();
  </script>
  <style is="global">
    .site-loader{position:fixed;inset:0;z-index:5000;display:grid;place-items:center;gap:9px;align-content:center;background:rgba(5,11,16,.94);backdrop-filter:blur(12px);opacity:1;transition:opacity .28s ease}.site-loader.done{opacity:0;pointer-events:none}.site-loader b{font:800 9px/1 var(--font-body);letter-spacing:.22em;color:#a9c7d1}.site-loader-mark{width:28px;height:28px;border-radius:9px;border:1px solid rgba(76,201,255,.25);border-top-color:var(--primary);border-right-color:var(--primary);box-shadow:0 0 24px rgba(76,201,255,.11);animation:site-loader-spin .75s linear infinite}.site-loader:after{content:"";position:absolute;bottom:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,transparent,var(--primary),transparent);animation:site-loader-bar 1.1s ease-in-out infinite}@keyframes site-loader-spin{to{transform:rotate(360deg)}}@keyframes site-loader-bar{0%,100%{opacity:.25;transform:scaleX(.35);transform-origin:left}50%{opacity:1;transform:scaleX(1);transform-origin:center}}
    .skip-link{
      position:fixed;left:16px;top:16px;z-index:2000;
      transform:translateY(-180%);padding:10px 14px;border:1px solid var(--primary);
      border-radius:10px;background:var(--surface2);color:var(--text);
      font:700 12px var(--font-body);text-decoration:none;transition:transform .18s ease;
    }
    .skip-link:focus{transform:translateY(0)}
    #content{scroll-margin-top:96px}
    .legacy-app-host .nav,.legacy-app-host nav.nav{display:none!important}
    .legacy-app-host{isolation:isolate}
  </style>
</body>
</html>