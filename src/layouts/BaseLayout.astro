---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SiteAds from '../components/SiteAds.astro';
import '../../styles.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'FC Mobile tools, calculators, redeem codes, guides and event resources from FCMobiletools.',
  image = 'https://res.cloudinary.com/b0qikv7n/image/upload/f_auto,q_auto,w_1200/v1789653531/fc-mobile-tools/o6ocwktktmw5yml9n8km.png',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev');
const siteUrl = new URL('/', Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev');
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FCMobiletools',
  alternateName: 'FC Mobile Tools',
  url: siteUrl,
  publisher: {
    '@type': 'Person',
    name: 'Tanzim',
  },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#071018" />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content="FCMobiletools" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:alt" content="FCMobiletools FC Mobile artwork" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <title>{title} — FCMobiletools</title>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YY53FCHMLW"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-YY53FCHMLW');</script>
</head>
<body>
  <div id="site-loader" class="site-loader" aria-hidden="true">
    <div class="site-loader-grid" aria-hidden="true"></div>
    <div class="site-loader-aura" aria-hidden="true"></div>
    <div class="site-loader-center">
      <span class="site-loader-orbit site-loader-orbit-outer" aria-hidden="true"></span>
      <span class="site-loader-orbit site-loader-orbit-inner" aria-hidden="true"></span>
      <div class="site-loader-brand">
        <span class="site-loader-brand-glow" aria-hidden="true"></span>
        <img src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" fetchpriority="high" decoding="async" />
      </div>
      <div class="site-loader-caption" aria-hidden="true">
        <span>FCMOBILETOOLS</span>
        <i></i>
        <span>Loading experience</span>
      </div>
      <div class="site-loader-progress" aria-hidden="true"><span></span></div>
    </div>
  </div>
  <a class="skip-link" href="#content">Skip to content</a>
  <Navbar />
  <div id="content"><slot /></div>
  <Footer />
  <SiteAds />
  <script is:inline>
    (() => {
      const loader = document.getElementById('site-loader');
      const finish = () => loader?.classList.add('done');
      if (document.readyState === 'complete') requestAnimationFrame(finish);
      else window.addEventListener('load', () => requestAnimationFrame(finish), { once: true });
      setTimeout(finish, 1400);
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a');
        if (!link || !loader || link.target === '_blank' || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.href);
        if (url.origin === location.origin && url.pathname !== location.pathname && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
          loader.classList.remove('done');
        }
      }, { capture: true });
    })();
  </script>
  <script is:inline>
    (() => {
      const markInvalid = (field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
        if (field.validity?.valid) field.removeAttribute('aria-invalid');
        else field.setAttribute('aria-invalid','true');
      };
      document.addEventListener('invalid', (event) => markInvalid(event.target), true);
      document.addEventListener('input', (event) => markInvalid(event.target));
      document.querySelectorAll('form').forEach((form) => {
        form.addEventListener('submit', () => {
          form.classList.add('was-validated');
          const submitter = form.querySelector('button[type="submit"],input[type="submit"]');
          if (submitter) {
            submitter.setAttribute('aria-busy','true');
            window.setTimeout(() => submitter.removeAttribute('aria-busy'), 12000);
          }
        });
      });
      window.addEventListener('pageshow', () => {
        document.querySelectorAll('[aria-busy="true"]').forEach((element) => element.removeAttribute('aria-busy'));
      });
    })();
  </script>
  <style is="global">
    .site-loader{
      position:fixed;
      inset:0;
      z-index:5000;
      display:grid;
      place-items:center;
      overflow:hidden;
      isolation:isolate;
      background:
        radial-gradient(620px 420px at 50% 44%,rgba(76,201,255,.10),transparent 68%),
        radial-gradient(980px 620px at 50% 110%,rgba(11,57,80,.25),transparent 72%),
        linear-gradient(180deg,#061019 0%,#050b11 100%);
      opacity:1;
      visibility:visible;
      pointer-events:auto;
      transition:opacity .48s cubic-bezier(.22,.61,.36,1),visibility 0s linear 0s;
      backdrop-filter:blur(18px) saturate(1.08);
      -webkit-backdrop-filter:blur(18px) saturate(1.08);
    }
    .site-loader.done{
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:opacity .48s cubic-bezier(.22,.61,.36,1),visibility 0s linear .48s;
    }
    .site-loader-grid{
      position:absolute;
      inset:-20%;
      z-index:-2;
      opacity:.22;
      background-image:
        linear-gradient(rgba(145,210,235,.045) 1px,transparent 1px),
        linear-gradient(90deg,rgba(145,210,235,.045) 1px,transparent 1px);
      background-size:48px 48px;
      transform:perspective(700px) rotateX(68deg) translateY(18%);
      transform-origin:center bottom;
      mask-image:linear-gradient(to bottom,transparent 10%,#000 45%,#000 82%,transparent 100%);
      -webkit-mask-image:linear-gradient(to bottom,transparent 10%,#000 45%,#000 82%,transparent 100%);
    }
    .site-loader-aura{
      position:absolute;
      width:min(42vw,520px);
      aspect-ratio:1;
      border-radius:50%;
      background:radial-gradient(circle,rgba(76,201,255,.13) 0%,rgba(76,201,255,.055) 24%,transparent 69%);
      filter:blur(8px);
      opacity:.92;
      animation:site-loader-aura 3.2s ease-in-out infinite;
    }
    .site-loader-center{
      position:relative;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:0;
      width:min(86vw,420px);
      padding:28px 0;
    }
    .site-loader-orbit{
      position:absolute;
      left:50%;
      top:25px;
      width:156px;
      height:156px;
      border-radius:50%;
      pointer-events:none;
      transform:translateX(-50%);
    }
    .site-loader-orbit-outer{
      border:1px solid rgba(112,220,255,.13);
      box-shadow:0 0 40px rgba(76,201,255,.07),inset 0 0 24px rgba(76,201,255,.03);
      animation:site-loader-orbit-outer 3s linear infinite;
    }
    .site-loader-orbit-outer::after{
      content:"";
      position:absolute;
      inset:-1px;
      border-radius:50%;
      border:1px solid transparent;
      border-top-color:rgba(76,201,255,.90);
      border-right-color:rgba(76,201,255,.18);
      transform:rotate(-22deg);
    }
    .site-loader-orbit-inner{
      width:126px;
      height:126px;
      top:40px;
      border:1px dashed rgba(135,218,242,.12);
      animation:site-loader-orbit-inner 8s linear infinite reverse;
    }
    .site-loader-brand{
      position:relative;
      z-index:2;
      display:grid;
      place-items:center;
      width:176px;
      height:108px;
      padding:15px 18px;
      border:1px solid rgba(166,229,248,.11);
      border-radius:24px;
      background:linear-gradient(145deg,rgba(13,30,42,.78),rgba(7,17,25,.56));
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.045),
        0 26px 70px rgba(0,0,0,.34),
        0 0 0 1px rgba(76,201,255,.025),
        0 0 46px rgba(76,201,255,.09);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
      animation:site-loader-brand 2.6s ease-in-out infinite;
    }
    .site-loader-brand::after{
      content:"";
      position:absolute;
      inset:0;
      border-radius:inherit;
      background:linear-gradient(118deg,transparent 18%,rgba(255,255,255,.10) 42%,transparent 66%);
      transform:translateX(-120%);
      animation:site-loader-sheen 2.1s ease-in-out infinite;
      pointer-events:none;
    }
    .site-loader-brand-glow{
      position:absolute;
      inset:22%;
      border-radius:50%;
      background:rgba(76,201,255,.16);
      filter:blur(22px);
      opacity:.55;
      pointer-events:none;
    }
    .site-loader-brand img{
      position:relative;
      z-index:2;
      width:136px;
      height:auto;
      max-height:68px;
      object-fit:contain;
      filter:drop-shadow(0 10px 18px rgba(0,0,0,.38));
    }
    .site-loader-caption{
      display:flex;
      align-items:center;
      gap:8px;
      margin-top:34px;
      color:#a9c8d4;
      font:800 9px/1 var(--font-body);
      letter-spacing:.18em;
      text-transform:uppercase;
      white-space:nowrap;
    }
    .site-loader-caption i{
      width:3px;
      height:3px;
      flex:0 0 3px;
      border-radius:50%;
      background:var(--primary);
      box-shadow:0 0 12px rgba(76,201,255,.85);
      animation:site-loader-pulse 1.05s ease-in-out infinite;
    }
    .site-loader-progress{
      position:relative;
      width:min(240px,64vw);
      height:2px;
      margin-top:18px;
      overflow:hidden;
      border-radius:999px;
      background:rgba(164,214,233,.08);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.025);
    }
    .site-loader-progress span{
      display:block;
      width:42%;
      height:100%;
      border-radius:inherit;
      background:linear-gradient(90deg,transparent,var(--primary),#c0f3ff,transparent);
      box-shadow:0 0 16px rgba(76,201,255,.62);
      animation:site-loader-progress 1.35s cubic-bezier(.4,0,.2,1) infinite;
    }
    .site-loader::after{
      content:"";
      position:absolute;
      inset:auto 0 0;
      height:1px;
      background:linear-gradient(90deg,transparent,rgba(76,201,255,.75),transparent);
      box-shadow:0 0 20px rgba(76,201,255,.16);
      opacity:.68;
    }
    @keyframes site-loader-aura{0%,100%{transform:scale(.94);opacity:.72}50%{transform:scale(1.04);opacity:1}}
    @keyframes site-loader-orbit-outer{to{transform:translateX(-50%) rotate(360deg)}}
    @keyframes site-loader-orbit-inner{to{transform:translateX(-50%) rotate(-360deg)}}
    @keyframes site-loader-brand{0%,100%{transform:translateY(0);box-shadow:inset 0 1px 0 rgba(255,255,255,.045),0 26px 70px rgba(0,0,0,.34),0 0 0 1px rgba(76,201,255,.025),0 0 46px rgba(76,201,255,.09)}50%{transform:translateY(-3px);box-shadow:inset 0 1px 0 rgba(255,255,255,.055),0 30px 76px rgba(0,0,0,.38),0 0 0 1px rgba(76,201,255,.04),0 0 58px rgba(76,201,255,.13)}}
    @keyframes site-loader-sheen{0%,55%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
    @keyframes site-loader-pulse{0%,100%{transform:scale(.75);opacity:.42}50%{transform:scale(1.35);opacity:1}}
    @keyframes site-loader-progress{0%{transform:translateX(-125%)}100%{transform:translateX(270%)}}
    @media(max-width:520px){
      .site-loader-orbit{width:142px;height:142px;top:29px}
      .site-loader-orbit-inner{width:114px;height:114px;top:43px}
      .site-loader-brand{width:158px;height:98px;border-radius:21px}
      .site-loader-brand img{width:122px;max-height:60px}
      .site-loader-caption{margin-top:30px;font-size:8px;letter-spacing:.15em}
    }
    @media(prefers-reduced-motion:reduce){
      .site-loader-grid,.site-loader-aura,.site-loader-orbit,.site-loader-brand,.site-loader-brand::after,.site-loader-caption i,.site-loader-progress span{animation:none!important}
      .site-loader-progress span{width:100%;opacity:.72}
    }
    .skip-link{
      position:fixed;left:16px;top:16px;z-index:2000;
      transform:translateY(-180%);padding:10px 14px;border:1px solid var(--primary);
      border-radius:10px;background:var(--surface2);color:var(--text);
      font:700 12px var(--font-body);text-decoration:none;transition:transform .18s ease;
    }
    .skip-link:focus{transform:translateY(0)}
    #content{scroll-margin-top:96px}
    .legacy-app-host .nav,.legacy-app-host nav.nav{display:none!important}
    .legacy-app-host{isolation:isolate}
  </style>
</body>
</html>