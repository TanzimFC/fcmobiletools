---
import { monogram } from '../../lib/tournamentView.js';
interface Props { player?: { displayName?: string; playerTag?: string; avatarUrl?: string } | null; size?: number; ring?: boolean }
const { player = null, size = 28, ring = false } = Astro.props;
const { letters, hue } = monogram(player);
const img = player?.avatarUrl && /^https?:\/\//.test(player.avatarUrl) ? player.avatarUrl : '';
---
{player ? (
  <span class:list={['crest', { ring }]} style={`--h:${hue};--s:${size}px`} aria-hidden="true">
    {img ? <img src={img} alt="" loading="lazy" decoding="async" /> : letters}
  </span>
) : (
  <span class="crest empty" style={`--s:${size}px`} aria-hidden="true"></span>
)}
<style>
  .crest{display:inline-grid;place-items:center;flex:none;width:var(--s);height:var(--s);border-radius:calc(var(--s)*.32);overflow:hidden;font:700 calc(var(--s)*.4)/1 'Archivo Variable',system-ui,sans-serif;letter-spacing:.02em;color:hsl(var(--h) 85% 86%);background:linear-gradient(150deg,hsl(var(--h) 46% 30%),hsl(var(--h) 52% 17%));box-shadow:inset 0 0 0 1px hsl(var(--h) 55% 48% / .45)}
  .crest img{width:100%;height:100%;object-fit:cover;display:block}
  .crest.ring{box-shadow:inset 0 0 0 1px hsl(var(--h) 55% 46% / .45),0 0 0 3px #071018,0 0 0 4px rgba(246,196,83,.6)}
  .crest.empty{background:transparent;box-shadow:inset 0 0 0 1px rgba(255,255,255,.14)}
</style>
