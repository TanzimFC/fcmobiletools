---
import Crest from './Crest.astro';
const { m } = Astro.props;
const done = m.status === 'completed' && m.player1Score != null && m.player2Score != null;
const w1 = done && m.winnerPlayerId && m.winnerPlayerId === m.player1?.id;
const w2 = done && m.winnerPlayerId && m.winnerPlayerId === m.player2?.id;
---
<div class:list={['fx', { done }]}>
  <span class:list={['a', { w: w1 }]}>{m.player1?.displayName || 'TBD'}<Crest player={m.player1} size={20} /></span>
  <span class="res">{done ? <><b>{m.player1Score}</b><u>–</u><b>{m.player2Score}</b></> : <em>vs</em>}</span>
  <span class:list={['b', { w: w2 }]}><Crest player={m.player2} size={20} />{m.player2?.displayName || 'TBD'}</span>
</div>
<style>
  .fx{display:grid;grid-template-columns:minmax(0,1fr) 64px minmax(0,1fr);align-items:center;gap:10px;padding:9px 4px;border-top:1px solid rgba(255,255,255,.06);font:500 13.5px/1.2 'Inter',system-ui,sans-serif;color:#9fb0be}
  .a,.b{display:flex;align-items:center;gap:8px;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .a{justify-content:flex-end;text-align:right}
  .w{color:#fff;font-weight:700}
  .res{display:flex;justify-content:center;align-items:center;gap:5px;height:28px;border-radius:8px;background:#0b1722;font:700 14px 'Space Grotesk',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#fff}
  .res u{text-decoration:none;color:#566a7c}
  .res em{font:500 11.5px 'Inter',system-ui,sans-serif;font-style:normal;color:#566a7c}
  .fx:not(.done) .res{background:transparent;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
</style>
