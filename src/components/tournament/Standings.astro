---
import Crest from './Crest.astro';
const { rows = [], advance = 0, caption = 'Standings', form = null } = Astro.props;
const gd = (n) => (n > 0 ? `+${n}` : n < 0 ? `−${Math.abs(n)}` : '0');
const label = { W: 'Win', D: 'Draw', L: 'Loss' };
const hasForm = Boolean(form) && rows.some((r) => form[r.player?.id]?.length);
---
<div class="tbl-wrap">
  <table class="standings">
    <caption class="sr">{caption}</caption>
    <thead>
      <tr><th class="pos">#</th><th class="pl">Player</th><th>P</th><th>W</th><th class="xs">D</th><th class="xs">L</th><th>GD</th>{hasForm ? <th class="frm-h">Form</th> : null}<th class="pts">Pts</th></tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr class:list={{ adv: advance > 0 && i < advance }}>
          <td class="pos">{i + 1}</td>
          <td class="pl"><span class="pl-in"><Crest player={r.player} size={24} /><span class="nm"><b>{r.player?.displayName || 'TBD'}</b>{r.player?.playerTag ? <i>{r.player.playerTag}</i> : null}</span></span></td>
          <td>{r.played}</td><td>{r.wins}</td><td class="xs">{r.draws}</td><td class="xs">{r.losses}</td><td class:list={{ pos: r.goalDifference > 0, neg: r.goalDifference < 0 }}>{gd(r.goalDifference)}</td>
          {hasForm ? (
            <td class="frm-h"><span class="frm" aria-label={`Last results: ${(form[r.player?.id] || []).map((x) => label[x]).join(', ') || 'none yet'}`}>
              {(form[r.player?.id] || []).map((x) => <i class={x} title={label[x]}></i>)}
            </span></td>
          ) : null}
          <td class="pts">{r.points}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  .tbl-wrap{overflow-x:auto}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .standings{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
  th{padding:10px 8px;font:600 12px/1 'Instrument Sans Variable',system-ui,sans-serif;color:#6f8294;text-align:center;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,.08)}
  td{padding:10px 8px;text-align:center;font:500 13.5px/1.2 'Instrument Sans Variable',system-ui,sans-serif;color:#b9c7d2;border-top:1px solid rgba(255,255,255,.05)}
  tbody tr:first-child td{border-top:0}
  tbody tr:hover td{background:rgba(255,255,255,.03)}
  .pos{width:34px;text-align:center;color:#6f8294}
  td.pos:not(:first-child){width:auto;color:#6fd9a5}
  td.neg{color:#ff8e9b}
  .pl{text-align:left}
  th.pl{padding-left:0}
  .pl-in{display:flex;align-items:center;gap:10px;min-width:0}
  .nm{display:flex;align-items:baseline;gap:6px;min-width:0}
  .nm b{font-weight:600;color:#eaf1f6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .nm i{font-style:normal;font-size:11px;color:#6f8294}
  .pts{font:700 15px 'Archivo Variable',system-ui,sans-serif;color:#fff}
  .frm{display:inline-flex;gap:4px;align-items:center}
  .frm i{width:8px;height:8px;border-radius:50%;background:#42586b}
  .frm i.W{background:#4ee0a0}.frm i.L{background:#ff7a8a}.frm i.D{background:#6f8294}
  tr.adv td:first-child{box-shadow:inset 3px 0 #4cc9ff;color:#4cc9ff;font-weight:700}
  tr.adv .pts{color:#4cc9ff}
  @media(max-width:560px){.frm-h{display:none}}
  @media(max-width:420px){.xs{display:none}}
</style>
