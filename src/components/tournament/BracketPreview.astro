---
// Compact read-only bracket for hero cards. Same data and same builder as the full bracket.
import { buildKnockout } from '../../lib/tournamentView.js';
const { tournament } = Astro.props;
const stage = (tournament?.stages || []).find((s) => s.type === 'knockout');
const ko = stage ? buildKnockout(stage) : null;
const short = (p) => (p?.displayName || 'TBD');
---
{ko ? (
  <div class="mb" style={`--cols:${ko.rounds.length}`} role="img" aria-label={`${tournament.name} bracket preview`}>
    {ko.rounds.map((r) => (
      <div class="col">
        <small>{r.label}</small>
        <div class="ties">
          {r.ties.map((t) => (
            <div class:list={['t', { fin: r === ko.rounds[ko.rounds.length - 1] && Boolean(t.winnerId) }]}>
              {[[t.p1, t.s1], [t.p2, t.s2]].map(([p, s]) => (
                <span class:list={['r', { w: Boolean(t.winnerId) && p?.id === t.winnerId, l: Boolean(t.winnerId) && p && p.id !== t.winnerId }]}>
                  <b>{short(p)}</b><i>{s ?? ''}</i>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
) : null}
<style>
  .mb{display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:12px;min-height:230px}
  .col{display:flex;flex-direction:column;gap:10px;min-width:0}
  .col small{font:600 12px/1 'Instrument Sans Variable',system-ui,sans-serif;color:#6f8294}
  .ties{flex:1;display:flex;flex-direction:column;justify-content:space-around;gap:8px}
  .t{border:1px solid rgba(255,255,255,.09);border-radius:var(--r-md);background:rgba(7,16,24,.55);overflow:hidden}
  .r{display:flex;justify-content:space-between;gap:6px;padding:6px 8px;font:500 12px/1.2 'Instrument Sans Variable',system-ui,sans-serif;color:#7d8f9f}
  .r+.r{border-top:1px solid rgba(255,255,255,.06)}
  .r b{font-weight:inherit;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .r i{font:700 12px 'Archivo Variable',system-ui,sans-serif;font-style:normal;font-variant-numeric:tabular-nums}
  .r.w{color:#fff;background:linear-gradient(90deg,rgba(76,201,255,.16),transparent 80%);box-shadow:inset 2px 0 #4cc9ff}
  .r.w b{font-weight:600}.r.w i{color:#4cc9ff}
  .t.fin{border-color:rgba(246,196,83,.5)}
  .t.fin .r.w{background:linear-gradient(90deg,rgba(246,196,83,.16),transparent 80%);box-shadow:inset 2px 0 #f6c453}.t.fin .r.w i{color:#f6c453}
  @media(max-width:520px){.mb{gap:8px}.r{font-size:11px;padding:5px 6px}}
</style>
