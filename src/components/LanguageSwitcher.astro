---
// Language switcher. Every option is a real link, so it works without JavaScript and crawlers
// can follow it. The link goes to the same page in the chosen language when that translation
// exists, and to that language's closest page otherwise. A language with no translated pages
// at all is not offered.
import {
  LOCALES, LOCALE_CODES, DEFAULT_LOCALE, getLocaleFromPath, stripLocale, hasLocalizedPage,
  pathForLocale, fallbackPageFor, isLocalizablePath, translator
} from '../i18n/index.js';

export interface Props { variant?: 'bar' | 'sheet'; }
const { variant = 'bar' } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const tr = translator(locale);
const englishPath = stripLocale(Astro.url.pathname);

// Pages that are not part of the translated site (admin, blog, guides, creator tools) have no
// language versions, so the switcher is left out of them entirely.
const options = LOCALE_CODES.map((code) => {
  const exact = hasLocalizedPage(englishPath, code);
  const fallbackPath = exact ? englishPath : fallbackPageFor(code);
  if (!fallbackPath) return null;
  return {
    code,
    native: LOCALES[code].native,
    short: LOCALES[code].short,
    hreflang: LOCALES[code].hreflang,
    href: pathForLocale(fallbackPath, code),
    exact,
    current: code === locale,
    hint: exact ? '' : tr('switcher.fallbackHint', { language: LOCALES[code].native })
  };
}).filter(Boolean);

// Blog, guides, admin and API areas stay English only, so they get no switcher.
const show = isLocalizablePath(englishPath) && options.filter((o) => !o.current).length > 0;
const currentOption = LOCALES[locale];
const uid = variant === 'bar' ? 'fcmtLangBar' : 'fcmtLangSheet';
---
{show && variant === 'bar' && (
  <details class="fcmt-lang" id={uid} data-fcmt-lang>
    <summary class="fcmt-lang-btn" aria-label={`${tr('switcher.aria')}: ${currentOption.native}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9S14.6 18.4 12 21c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3z"/></svg>
      <span class="fcmt-lang-cur" lang={currentOption.htmlLang}>{currentOption.short}</span>
    </summary>
    <ul class="fcmt-lang-menu" role="list">
      {options.map((o) => (
        <li>
          <a href={o.href} hreflang={o.hreflang} lang={o.hreflang} data-lang-code={o.code} aria-current={o.current ? 'true' : undefined} title={o.hint || undefined} rel="alternate">
            <span>{o.native}</span>
            {o.current ? <i aria-hidden="true">✓</i> : null}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

{show && variant === 'sheet' && (
  <section class="fcmt-sec fcmt-lang-sec" data-fcmt-lang>
    <p class="fcmt-eyebrow">{tr('switcher.label')}</p>
    <div class="fcmt-lang-chips">
      {options.map((o) => (
        <a href={o.href} hreflang={o.hreflang} lang={o.hreflang} data-lang-code={o.code} aria-current={o.current ? 'true' : undefined} title={o.hint || undefined} rel="alternate">{o.native}</a>
      ))}
    </div>
  </section>
)}

<style is:global>
.fcmt-lang{position:relative;flex:0 0 auto}
.fcmt-lang-btn{list-style:none;display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 12px;border:1px solid rgba(255,255,255,.09);border-radius:13px;background:rgba(255,255,255,.035);color:var(--muted);font:700 12px/1 var(--font-body);cursor:pointer;transition:color .2s,background .2s,border-color .2s}
.fcmt-lang-btn::-webkit-details-marker{display:none}
.fcmt-lang-btn:hover,.fcmt-lang[open] .fcmt-lang-btn{color:var(--text);background:rgba(255,255,255,.06);border-color:rgba(76,201,255,.3)}
.fcmt-lang-btn:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
.fcmt-lang-menu{position:absolute;right:0;top:calc(100% + 10px);z-index:5;min-width:210px;margin:0;padding:8px;list-style:none;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:linear-gradient(180deg,rgba(20,34,49,.97),rgba(9,18,27,.98));box-shadow:0 24px 60px -14px rgba(0,0,0,.75)}
.fcmt-lang-menu a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-radius:11px;color:#b3c0cc;font:600 13px/1.4 var(--font-body);text-decoration:none;white-space:nowrap}
.fcmt-lang-menu a:hover,.fcmt-lang-menu a:focus-visible{background:rgba(76,201,255,.1);color:#fff;outline:none}
.fcmt-lang-menu a[aria-current="true"]{color:var(--primary)}
.fcmt-lang-menu i{font-style:normal;font-size:12px}
.fcmt-lang-chips{display:flex;flex-wrap:wrap;gap:8px}
.fcmt-lang-chips a{display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border:1px solid rgba(255,255,255,.1);border-radius:13px;background:rgba(255,255,255,.035);color:#c7d3de;font:700 13px/1.4 var(--font-body);text-decoration:none}
.fcmt-lang-chips a[aria-current="true"]{border-color:rgba(76,201,255,.55);background:rgba(76,201,255,.12);color:#fff}
.fcmt-lang-sec{margin-bottom:6px}
/* The mobile menu has its own language block, so the bar button is desktop only. */
@media(max-width:980px){.fcmt-lang[data-fcmt-lang]{display:none}}
@media(min-width:981px){.fcmt-sheet .fcmt-lang-sec{display:none}}
@media(max-width:1120px){.fcmt-lang-btn{padding:0 10px}}
/* The language button needs room in the bar, so on mid-size desktops the search box shrinks to its icon.
   Only bars that actually contain the switcher are affected. */
@media(min-width:981px) and (max-width:1320px){
  .fcmt-bar:has(.fcmt-lang) .fcmt-search{width:42px;padding:0;justify-content:center}
  .fcmt-bar:has(.fcmt-lang) .fcmt-search-txt,.fcmt-bar:has(.fcmt-lang) .fcmt-search kbd{display:none}
}
/* Longer translated labels must never wrap inside the bar. */
.fcmt-nav .fcmt-link,.fcmt-nav .fcmt-trigger{white-space:nowrap}
</style>

{show && variant === 'bar' && <script is:inline set:html={`
(() => {
  if (window.__fcmtLangInit) return;
  window.__fcmtLangInit = true;
  const i18n = () => window.FCMT_I18N;
  // Remember an explicit choice and keep the query string and hash when switching.
  document.addEventListener('click', (event) => {
    const link = event.target.closest && event.target.closest('[data-fcmt-lang] a[data-lang-code]');
    if (!link) return;
    try {
      const code = link.getAttribute('data-lang-code');
      if (i18n()) i18n().remember(code);
      const url = new URL(link.href, location.href);
      if (!url.search) url.search = location.search;
      if (!url.hash) url.hash = location.hash;
      link.href = url.pathname + url.search + url.hash;
    } catch {}
  }, true);
  // Close the dropdown on outside click or Escape.
  const menus = () => document.querySelectorAll('details.fcmt-lang[open]');
  document.addEventListener('click', (event) => { menus().forEach((d) => { if (!d.contains(event.target)) d.removeAttribute('open'); }); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') menus().forEach((d) => { d.removeAttribute('open'); d.querySelector('summary')?.focus(); }); });
})();
`}></script>}
