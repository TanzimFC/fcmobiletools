---
import fs from 'node:fs';
import path from 'node:path';

export interface Props { file: string; initialPage?: string; className?: string; }
const { file, initialPage = '', className = '' } = Astro.props;
const sourceName = file.replace(/\.html$/i, '').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase();
const base = path.join(process.cwd(), 'public', '_legacy', sourceName);
const body = fs.readFileSync(`${base}.html`, 'utf8');
const css = fs.readFileSync(`${base}.css`, 'utf8').replace(/<\/?style[^>]*>/gi, '');
const jsUrl = `/_legacy/${sourceName}.js`;
const kind = sourceName.startsWith('trivia-') ? 'trivia' : sourceName === 'legacy-football-centre' ? 'football-centre' : 'legacy';
---
<style is:global set:html={css}></style>
<div class:list={['legacy-app-host', `legacy-app-${kind}`, className]} data-legacy-app data-legacy-kind={kind} data-initial-page={initialPage}>
  <div class="legacy-app" set:html={body}></div>
</div>

<script is:inline define:vars={{ jsUrl, initialPage, kind }}>
  (() => {
    const host = document.querySelector('[data-legacy-app]');
    if (!host) return;

    if (kind === 'trivia') {
      host.querySelectorAll('nav, header, footer, .topbar, .tool-nav, .site-footer, [data-site-nav-placeholder], [data-site-footer-placeholder]').forEach((node) => node.remove());
    }

    const syncFootballPage = () => {
      if (kind !== 'football-centre') return;
      const requested = initialPage || location.hash.replace(/^#/, '') || 'dashboard';
      const target = requested === 'rewards' ? 'totw' : requested;
      host.querySelectorAll('section.page').forEach((page) => page.classList.toggle('active', page.id === target));
    };

    const modernizeFootball = () => {
      if (kind !== 'football-centre') return;
      const cards = [...(host.querySelector('#dashboard')?.querySelectorAll('.match-card') || [])];
      [['Fulham', 'Crystal Palace'], ['Arsenal', 'Chelsea']].forEach(([home, away], i) => {
        const names = cards[i]?.querySelectorAll('.team-name');
        if (names?.length >= 2) { names[0].textContent = home; names[1].textContent = away; }
      });
      const analysis = host.querySelector('#analysis');
      if (analysis && !analysis.querySelector('.fc-new-analysis')) {
        const panel = document.createElement('div');
        panel.className = 'fc-new-analysis';
        panel.innerHTML = '<div class="fc-kicker">MATCHDAY ANALYSIS</div><h2>Players to watch</h2><p>Quick player-focused notes for the current Football Centre fixtures.</p><div class="fc-player-grid"><article><b>Harry Wilson</b><span>Fulham · CAM</span></article><article><b>Jean-Philippe Mateta</b><span>Crystal Palace · ST</span></article><article><b>Bukayo Saka</b><span>Arsenal · RW</span></article><article><b>Cole Palmer</b><span>Chelsea · CAM</span></article></div>';
        analysis.appendChild(panel);
      }
      const totw = host.querySelector('#totw');
      if (totw && !totw.querySelector('.fc-totw-new')) {
        totw.innerHTML = '<div class="fc-modern-head"><div><span class="fc-kicker">FOOTBALL CENTRE</span><h1>Team of the Week</h1><p>Watch the latest FC Mobile Team of the Week update.</p></div></div><div class="fc-totw-new"><div class="fc-totw-video"><iframe src="https://www.youtube.com/embed/KvgulT3RtFE" title="FC Mobile Team of the Week" loading="lazy" allowfullscreen></iframe></div><div><h2>Weekly spotlight</h2><p>Keep up with the latest standout performers and community discussion.</p></div></div>';
      }
      syncFootballPage();
    };

    syncFootballPage();
    modernizeFootball();
    const script = document.createElement('script');
    script.src = jsUrl;
    script.onload = () => { modernizeFootball(); syncFootballPage(); };
    script.onerror = () => host.setAttribute('data-legacy-error', 'script');
    host.appendChild(script);
    if (kind === 'football-centre') window.addEventListener('hashchange', () => { syncFootballPage(); modernizeFootball(); });
  })();
</script>

<style is="global">
.legacy-app-host{width:100%;display:block;position:relative;isolation:isolate}.legacy-app{width:100%;min-width:0}.legacy-app-host .topbar,.legacy-app-host .site-nav,.legacy-app-host .tool-nav,.legacy-app-host nav.nav,.legacy-app-host .site-footer{display:none!important}.legacy-app-host .app{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:24px 0 44px}.legacy-app-trivia{max-width:1180px;margin:0 auto}.legacy-app-trivia .nav,.legacy-app-trivia nav.nav,.legacy-app-trivia header,.legacy-app-trivia footer{display:none!important}.legacy-app-trivia .page{width:min(1120px,calc(100% - 40px));margin:0 auto}.legacy-app-trivia .crumb{margin-top:26px}.legacy-app-trivia .footer{display:none!important}

/* Phase 2 bridge: keep legacy functionality, but make its public shell feel native. */
.legacy-app-legacy{color:var(--text)!important;background:transparent!important}.legacy-app-legacy .app{color:var(--text)!important}.legacy-app-legacy .card,.legacy-app-legacy .panel,.legacy-app-legacy .section,.legacy-app-legacy .tool-card{border-color:var(--border)!important;background:var(--surface)!important;color:var(--text)!important}.legacy-app-legacy button,.legacy-app-legacy input,.legacy-app-legacy select{font-family:var(--sans)}

.legacy-app-football-centre .page{display:none!important}.legacy-app-football-centre .page.active{display:block!important;visibility:visible!important;opacity:1!important}.legacy-app-football-centre{--fc-accent:#0b9aca;--fc-accent-strong:#087eae;--fc-accent-soft:#d8f1f7;color:var(--text);background:transparent}.legacy-app-football-centre .eyebrow,.legacy-app-football-centre .tab.active{color:var(--fc-accent)!important}.legacy-app-football-centre .progress-fill,.legacy-app-football-centre .fill{background:linear-gradient(90deg,var(--fc-accent-strong),var(--fc-accent))!important}.legacy-app-football-centre .card,.legacy-app-football-centre .coming,.legacy-app-football-centre .settings-card,.legacy-app-football-centre .stat{border-color:var(--border)!important;background:var(--surface)!important;color:var(--text)!important}.fc-modern-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-end;margin:5px 0 18px}.fc-modern-head h1{font-size:30px;margin:4px 0}.fc-kicker{font-size:9px;font-weight:950;letter-spacing:.14em;color:var(--fc-accent)}.fc-new-analysis{margin-top:16px;padding:18px;border:1px solid var(--border);background:var(--surface);border-radius:16px}.fc-new-analysis h2{margin:5px 0}.fc-new-analysis p{color:var(--muted);font-size:11px}.fc-player-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:14px}.fc-player-grid article{padding:13px;border:1px solid var(--border);background:var(--surface2);border-radius:11px}.fc-player-grid b{display:block}.fc-player-grid span{color:var(--muted);font-size:9px}.fc-totw-new{display:grid;grid-template-columns:1.35fr .65fr;gap:14px;padding:14px;border:1px solid var(--border);background:var(--surface);border-radius:16px}.fc-totw-video{aspect-ratio:16/9;overflow:hidden;border-radius:11px;background:#07131b}.fc-totw-video iframe{width:100%;height:100%;border:0}@media(max-width:720px){.legacy-app-host .app{width:calc(100% - 18px)}.legacy-app-trivia .page{width:calc(100% - 28px)}.fc-player-grid,.fc-totw-new{grid-template-columns:1fr}}
</style>
