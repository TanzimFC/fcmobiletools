---
import fs from 'node:fs';
import path from 'node:path';

export interface Props { file: string; initialPage?: string; className?: string; }
const { file, initialPage = '', className = '' } = Astro.props;
const sourceName = file.replace(/\.html$/i, '').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase();
const base = path.join(process.cwd(), 'public', '_legacy', sourceName);
const body = fs.readFileSync(`${base}.html`, 'utf8');
const css = fs.readFileSync(`${base}.css`, 'utf8');
const jsUrl = `/_legacy/${sourceName}.js`;
const kind = sourceName.startsWith('trivia-') ? 'trivia' : sourceName === 'legacy-football-centre' ? 'football-centre' : 'legacy';
---
<style is:global set:html={css}></style>

<div class:list={['legacy-app-host', `legacy-app-${kind}`, className]} data-legacy-app data-legacy-kind={kind} data-initial-page={initialPage}>
  <div class="legacy-app" set:html={body}></div>
</div>

{initialPage && <script is:inline define:vars={{ initialPage }}>
  (() => {
    const host = document.querySelector('[data-legacy-app]');
    if (!host) return;
    history.replaceState(null, '', `${location.pathname}${location.search}#${initialPage}`);
  })();
</script>}

<script is:inline define:vars={{ jsUrl, initialPage, kind }}>
  (() => {
    const host = document.querySelector('[data-legacy-app]');
    if (!host) return;

    if (kind === 'trivia') {
      document.documentElement.classList.add('trivia-route-page');
      document.body.classList.add('trivia-route-page');
    }

    const syncFootballPage = () => {
      if (kind !== 'football-centre') return;
      const requested = initialPage || location.hash.replace(/^#/, '') || 'dashboard';
      const target = requested === 'rewards' ? 'totw' : requested;
      const pages = [...host.querySelectorAll('main > section.page, section.page')];
      if (!pages.length) return;
      pages.forEach((page) => page.classList.toggle('active', page.id === target));
    };

    syncFootballPage();

    const script = document.createElement('script');
    script.src = jsUrl;
    script.onload = () => {
      syncFootballPage();
      if (kind === 'football-centre' && location.hash) history.replaceState(null, '', `${location.pathname}${location.search}`);
    };
    script.onerror = () => host.setAttribute('data-legacy-error', 'script');
    host.appendChild(script);

    if (kind === 'football-centre') window.addEventListener('hashchange', syncFootballPage);
  })();
</script>

<script is:inline>
  (() => {
    const host = document.querySelector('[data-legacy-app]');
    if (!host || host.dataset.legacyKind !== 'football-centre') return;
    const routes = {
      dashboard: '/football-centre', matches: '/football-centre/matches', analysis: '/football-centre/analysis',
      totw: '/football-centre/totw', rewards: '/football-centre/totw', history: '/football-centre/history', settings: '/football-centre/settings'
    };
    host.querySelectorAll('[data-page]').forEach((button) => button.addEventListener('click', (event) => {
      const route = routes[button.dataset.page];
      if (!route) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      location.assign(route);
    }, true));
  })();
</script>

<style is:global>
  .legacy-app-host{width:100%;display:block;position:relative;isolation:isolate;}
  .legacy-app{width:100%;min-width:0;}
  .legacy-app-host .topbar,
  .legacy-app-host .site-nav,
  .legacy-app-host .tool-nav,
  .legacy-app-host nav.nav,
  .legacy-app-host .site-footer{display:none!important;}
  .legacy-app-host .app{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:24px 0 44px;}
  .legacy-app-host .app>.site-footer{display:none!important;}

  /* Football Centre alone uses .page as a panel switcher. */
  .legacy-app-football-centre .page{display:none!important;}
  .legacy-app-football-centre .page.active{display:block!important;}
  .legacy-app-football-centre #settings .creator-card{display:none!important;}
  .legacy-app-football-centre .hero{padding:18px 20px!important;margin-bottom:12px!important;}
  .legacy-app-football-centre .hero:before{display:none!important;}
  .legacy-app-football-centre .score{font-size:clamp(36px,5vw,52px)!important;}
  .legacy-app-football-centre .scoreline{margin:2px 0 9px!important;}
  .legacy-app-football-centre .progress{height:10px!important;}

  /* Trivia is a standalone black page. Never inherit the homepage hero/background. */
  html.trivia-route-page, body.trivia-route-page{background:#050505!important;}
  .legacy-app-trivia{background:#050505;color:#f5f5f7;min-height:420px;}
  .legacy-app-trivia .page{display:block!important;background:#050505;}
  .legacy-app-trivia .hero,
  .legacy-app-trivia .hub-hero,
  .legacy-app-trivia .hub-hero-v2{background:#050505!important;background-image:none!important;}
  .legacy-app-trivia .hero::before,
  .legacy-app-trivia .hero::after,
  .legacy-app-trivia .hub-hero::after,
  .legacy-app-trivia .hub-hero-v2::after{display:none!important;}

  /* Colourful nation accents without using the homepage artwork. */
  .legacy-app-trivia .tc-beginner{--accent:#58a6ff;}
  .legacy-app-trivia .tc-medium{--accent:#42d392;}
  .legacy-app-trivia .tc-difficult{--accent:#f2c14e;}
  .legacy-app-trivia .country-name{color:#fff;}

  @media(max-width:720px){.legacy-app-host .app{width:calc(100% - 18px);padding-top:16px;}}
</style>
