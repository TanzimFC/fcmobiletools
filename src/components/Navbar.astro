/* Featured card */
.fcmt-feature,.fcmt-hero{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;overflow:hidden;padding:18px;border-radius:18px;border:1px solid rgba(76,201,255,.22);background:linear-gradient(160deg,rgba(76,201,255,.16),rgba(76,201,255,.03) 55%,rgba(8,16,24,.6));text-decoration:none;color:var(--text);transition:transform .25s cubic-bezier(.2,.8,.2,1),border-color .25s,box-shadow .25s}
