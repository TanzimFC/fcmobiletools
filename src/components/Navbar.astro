---
const groups = [
  {
    label: 'Tools',
    kicker: 'Calculators & utilities',
    links: [
      { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating' },
      { label: 'Training Calculator', href: '/training-calculator', meta: 'XP & fodder' },
      { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs' },
      { label: 'Investment Calculator', href: '/investment-calculator', meta: 'Market planning' }
    ]
  },
  {
    label: 'Live',
    kicker: 'FC Mobile hub',
    links: [
      { label: 'Events & Reset', href: '/reset-center', meta: 'Countdowns & schedules' },
      { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Current rewards' },
      { label: 'Football Centre', href: '/football-centre', meta: 'Matches & points' },
      { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers' },
      { label: 'FC Mobile 27 APK', href: '/fc-mobile-27', meta: 'Latest Android release' }
    ]
  }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
const groupIsActive = (group) => group.links.some((link) => isActive(link.href));
---

<header class="site-nav" data-site-nav>
  <div class="site-nav-inner">
    <a class="site-logo" href="/" aria-label="FCMOBILETOOLS home">
      <img src="/assets/images/logo.png" alt="FCMOBILETOOLS" />
    </a>

    <nav class="site-primary" aria-label="Primary navigation">
      <a class="site-link" href="/" class:list={{ active: currentPath === '/' }} aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>

      {groups.map((group) => (
        <div class="site-group" data-nav-group>
          <button
            class="site-dropdown-trigger"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            class:list={{ active: groupIsActive(group) }}
          >
            <span>{group.label}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3.5 4.5 2.5 2.5 2.5-2.5" /></svg>
          </button>

          <div class="site-dropdown" role="menu">
            <div class="site-dropdown-head">
              <span>{group.kicker}</span>
              <i aria-hidden="true"></i>
            </div>

            <div class="site-dropdown-links">
              {group.links.map((link) => (
                <a href={link.href} role="menuitem" class:list={{ active: isActive(link.href) }} aria-current={isActive(link.href) ? 'page' : undefined}>
                  <span>
                    <strong>{link.label}</strong>
                    <small>{link.meta}</small>
                  </span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <a class="site-link" href="/blog" class:list={{ active: isActive('/blog') }} aria-current={isActive('/blog') ? 'page' : undefined}>Articles</a>
      <a class="site-link" href="/creator" class:list={{ active: isActive('/creator') }} aria-current={isActive('/creator') ? 'page' : undefined}>Creator</a>

      <a class="site-cta" href="/redeem-codes" class:list={{ active: isActive('/redeem-codes') }} aria-current={isActive('/redeem-codes') ? 'page' : undefined}>
        <span class="site-cta-dot" aria-hidden="true"></span>
        <span>Redeem Codes</span>
      </a>
    </nav>

    <button class="site-menu" type="button" aria-expanded="false" aria-controls="site-mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="site-mobile-nav" class="site-mobile-nav" aria-label="Mobile navigation">
    <a class="mobile-link mobile-home" href="/" class:list={{ active: currentPath === '/' }}>Home</a>

    {groups.map((group) => (
      <div class="mobile-group">
        <div class="mobile-group-label">{group.label}</div>
        {group.links.map((link) => (
          <a class="mobile-link" href={link.href} class:list={{ active: isActive(link.href) }}>
            <span>{link.label}</span>
            <small>{link.meta}</small>
          </a>
        ))}
      </div>
    ))}

    <a class="mobile-link" href="/blog" class:list={{ active: isActive('/blog') }}>Articles</a>
    <a class="mobile-link" href="/creator" class:list={{ active: isActive('/creator') }}>Creator</a>
    <a class="mobile-cta" href="/redeem-codes" class:list={{ active: isActive('/redeem-codes') }}>
      <span class="site-cta-dot" aria-hidden="true"></span>
      Redeem Codes
    </a>
  </nav>
</header>

<style>
.site-nav{
  position:sticky;
  top:0;
  z-index:1000;
  isolation:isolate;
  padding:12px 0;
  border-bottom:1px solid rgba(171,217,235,.08);
  background:rgba(5,10,15,.84);
  backdrop-filter:blur(20px) saturate(140%);
  -webkit-backdrop-filter:blur(20px) saturate(140%);
  box-shadow:0 10px 34px rgba(0,0,0,.16);
  transition:padding .22s ease,border-color .22s ease,box-shadow .22s ease,background .22s ease;
}
.site-nav:after{
  content:"";
  position:absolute;
  left:0;
  right:0;
  bottom:-1px;
  height:1px;
  background:linear-gradient(90deg,transparent,#55c7f23b 18%,#55c7f27a 50%,#55c7f23b 82%,transparent);
  pointer-events:none;
}
.site-nav.is-scrolled{
  padding:8px 0;
  border-bottom-color:rgba(171,217,235,.12);
  background:rgba(5,10,15,.93);
  box-shadow:0 16px 42px rgba(0,0,0,.3);
}
.site-nav-inner{
  width:min(1280px,calc(100% - 34px));
  min-height:72px;
  margin:auto;
  display:flex;
  align-items:center;
  gap:30px;
}
.site-logo{
  display:flex;
  align-items:center;
  flex:0 0 auto;
  width:235px;
  transition:transform .2s ease,filter .2s ease;
}
.site-logo img{
  display:block;
  width:100%;
  height:58px;
  max-width:none;
  object-fit:contain;
  object-position:left center;
  filter:drop-shadow(0 10px 24px rgba(0,0,0,.5));
}
.site-logo:hover{
  transform:translateY(-1px);
  filter:brightness(1.06);
}
.site-primary{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:3px;
  flex:1;
  min-width:0;
}
.site-link,.site-dropdown-trigger,.site-cta{
  position:relative;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  min-height:42px;
  padding:9px 12px;
  border:1px solid transparent;
  border-radius:11px;
  background:transparent;
  color:#93a4af;
  font:700 11px var(--sans,Inter,system-ui,sans-serif);
  text-decoration:none;
  white-space:nowrap;
  transition:color .18s ease,background .18s ease,border-color .18s ease,transform .18s ease;
}
.site-link:hover,.site-link.active,.site-dropdown-trigger:hover,.site-dropdown-trigger.active{
  color:#f2fbff;
  background:rgba(255,255,255,.045);
  border-color:rgba(255,255,255,.07);
}
.site-link:after,.site-dropdown-trigger:after{
  content:"";
  position:absolute;
  left:12px;
  right:12px;
  bottom:4px;
  height:2px;
  border-radius:20px;
  background:linear-gradient(90deg,transparent,#55c7f2,transparent);
  transform:scaleX(0);
  transition:transform .18s ease;
}
.site-link:hover:after,.site-link.active:after,.site-dropdown-trigger:hover:after,.site-dropdown-trigger.active:after{
  transform:scaleX(1);
}
.site-dropdown-trigger{
  cursor:pointer;
}
.site-dropdown-trigger svg{
  width:13px;
  height:13px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.55;
  opacity:.56;
  transition:transform .18s ease,opacity .18s ease;
}
.site-group:hover .site-dropdown-trigger svg,.site-group.open .site-dropdown-trigger svg{
  transform:rotate(180deg);
  opacity:.9;
}
.site-dropdown{
  position:absolute;
  left:50%;
  top:calc(100% + 12px);
  width:320px;
  padding:11px;
  transform:translate(-50%,8px);
  border:1px solid rgba(102,164,190,.23);
  border-radius:17px;
  background:linear-gradient(145deg,rgba(13,24,32,.98),rgba(7,15,21,.98));
  box-shadow:0 28px 70px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.035);
  opacity:0;
  pointer-events:none;
  transition:opacity .16s ease,transform .16s ease;
}
.site-dropdown:before{
  content:"";
  position:absolute;
  top:-5px;
  left:50%;
  width:10px;
  height:10px;
  background:#0c1820;
  border-top:1px solid rgba(102,164,190,.23);
  border-left:1px solid rgba(102,164,190,.23);
  transform:translateX(-50%) rotate(45deg);
}
.site-group{position:relative}
.site-group:hover .site-dropdown,.site-group.open .site-dropdown{
  opacity:1;
  pointer-events:auto;
  transform:translate(-50%,0);
}
.site-dropdown-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:5px 8px 10px;
  border-bottom:1px solid rgba(255,255,255,.07);
  color:#66818f;
  font:800 8px var(--sans,Inter,system-ui,sans-serif);
  letter-spacing:.1em;
  text-transform:uppercase;
}
.site-dropdown-head i{
  width:24px;
  height:24px;
  border-radius:8px;
  border:1px solid rgba(85,199,242,.18);
  background:radial-gradient(circle at 30% 30%,rgba(85,199,242,.18),transparent 62%),#0b171e;
}
.site-dropdown-links{
  display:grid;
  gap:3px;
  padding-top:7px;
}
.site-dropdown-links a{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  min-height:58px;
  padding:9px 10px;
  border:1px solid transparent;
  border-radius:11px;
  color:#a0b1bb;
  text-decoration:none;
  transition:background .15s ease,border-color .15s ease,transform .15s ease,color .15s ease;
}
.site-dropdown-links a:hover,.site-dropdown-links a.active{
  color:#f1fbff;
  background:rgba(85,199,242,.06);
  border-color:rgba(85,199,242,.13);
}
.site-dropdown-links a:hover{transform:translateX(2px)}
.site-dropdown-links a span{
  display:grid;
  gap:3px;
}
.site-dropdown-links strong{
  font:700 10px var(--sans,Inter,system-ui,sans-serif);
}
.site-dropdown-links small{
  color:#607784;
  font:600 8px var(--sans,Inter,system-ui,sans-serif);
}
.site-dropdown-links svg{
  width:15px;
  height:15px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.4;
  opacity:.28;
}
.site-dropdown-links a:hover svg,.site-dropdown-links a.active svg{
  color:#78dcfb;
  opacity:.9;
}
.site-cta{
  margin-left:7px;
  padding:10px 14px;
  color:#bfefff;
  border-color:rgba(85,199,242,.22);
  background:linear-gradient(135deg,rgba(85,199,242,.14),rgba(85,199,242,.055));
  box-shadow:inset 0 1px rgba(255,255,255,.05),0 8px 24px rgba(0,0,0,.16);
}
.site-cta:hover,.site-cta.active{
  color:#ecfdff;
  border-color:rgba(85,199,242,.45);
  background:linear-gradient(135deg,rgba(85,199,242,.2),rgba(85,199,242,.08));
  transform:translateY(-1px);
}
.site-cta-dot{
  width:6px;
  height:6px;
  flex:0 0 6px;
  border-radius:50%;
  background:#65dfa0;
  box-shadow:0 0 0 4px rgba(101,223,160,.08);
}
.site-menu{
  display:none;
  flex:0 0 42px;
  width:42px;
  height:42px;
  padding:0;
  border:1px solid rgba(110,161,183,.22);
  border-radius:11px;
  background:#0a141b;
  color:#effcff;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:4px;
  cursor:pointer;
}
.site-menu span{
  width:17px;
  height:1.5px;
  border-radius:20px;
  background:currentColor;
  transition:transform .18s ease,opacity .18s ease;
}
.site-nav:has(.site-menu[aria-expanded="true"]) .site-menu span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.site-nav:has(.site-menu[aria-expanded="true"]) .site-menu span:nth-child(2){opacity:0}
.site-nav:has(.site-menu[aria-expanded="true"]) .site-menu span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}
.site-mobile-nav{display:none}
.mobile-link{
  display:flex;
  align-items:center;
  justify-content:space-between;
  min-height:47px;
  padding:11px 7px;
  border-top:1px solid rgba(255,255,255,.07);
  color:#a0b0b9;
  text-decoration:none;
  font:650 11px var(--sans,Inter,system-ui,sans-serif);
}
.mobile-link small{
  color:#607581;
  font:600 8px var(--sans,Inter,system-ui,sans-serif);
}
.mobile-link.active{color:#77daf9}
.mobile-home{border-top:0}
.mobile-group{
  margin-top:5px;
  padding-top:6px;
  border-top:1px solid rgba(255,255,255,.07);
}
.mobile-group-label{
  padding:6px 7px 7px;
  color:#5f7a88;
  font:800 8px var(--sans,Inter,system-ui,sans-serif);
  letter-spacing:.11em;
  text-transform:uppercase;
}
.mobile-cta{
  display:flex;
  align-items:center;
  gap:8px;
  min-height:47px;
  margin:10px 0 3px;
  padding:12px;
  border:1px solid rgba(85,199,242,.24);
  border-radius:12px;
  background:linear-gradient(135deg,rgba(85,199,242,.13),rgba(85,199,242,.05));
  color:#c4f1ff;
  text-decoration:none;
  font:700 11px var(--sans,Inter,system-ui,sans-serif);
}
.site-mobile-nav.open{
  display:block;
  width:min(100% - 24px,520px);
  margin:9px auto 0;
  padding:6px 13px 12px;
  border:1px solid rgba(103,157,181,.2);
  border-radius:17px;
  background:rgba(8,17,24,.98);
  box-shadow:0 25px 65px rgba(0,0,0,.45),inset 0 1px rgba(255,255,255,.03);
  animation:mobileNavIn .18s ease;
}
@keyframes mobileNavIn{
  from{opacity:0;transform:translateY(-5px)}
  to{opacity:1;transform:none}
}
@media(max-width:1180px){
  .site-nav-inner{gap:20px}
  .site-logo{width:215px}
  .site-logo img{height:54px}
  .site-primary{gap:1px}
  .site-link,.site-dropdown-trigger,.site-cta{padding-inline:9px}
}
@media(max-width:980px){
  .site-nav{padding:8px 0}
  .site-nav-inner{width:calc(100% - 20px);min-height:62px}
  .site-logo{width:205px}
  .site-logo img{height:52px}
  .site-primary{display:none}
  .site-menu{display:flex;margin-left:auto}
  .site-mobile-nav.open{width:calc(100% - 20px)}
}
@media(max-width:540px){
  .site-nav-inner{width:calc(100% - 14px);min-height:57px}
  .site-logo{width:184px}
  .site-logo img{height:48px}
  .site-menu{width:40px;height:40px;flex-basis:40px}
  .site-mobile-nav.open{width:calc(100% - 14px)}
}
@media(prefers-reduced-motion:reduce){
  .site-nav *, .site-nav *:before, .site-nav *:after{transition:none!important;animation:none!important}
}
</style>

<script>
const nav = document.querySelector('[data-site-nav]');
const menuButton = nav?.querySelector('.site-menu');
const mobile = nav?.querySelector('.site-mobile-nav');

const setGroupState = (group, open) => {
  const trigger = group.querySelector('.site-dropdown-trigger');
  group.classList.toggle('open', open);
  trigger?.setAttribute('aria-expanded', String(open));
};

nav?.querySelectorAll('[data-nav-group]').forEach((group) => {
  const trigger = group.querySelector('.site-dropdown-trigger');

  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = !group.classList.contains('open');
    nav.querySelectorAll('[data-nav-group]').forEach((other) => {
      if (other !== group) setGroupState(other, false);
    });
    setGroupState(group, open);
  });
});

document.addEventListener('click', (event) => {
  if (!nav?.contains(event.target)) {
    nav?.querySelectorAll('[data-nav-group]').forEach((group) => setGroupState(group, false));
  }
});

document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;

  nav?.querySelectorAll('[data-nav-group]').forEach((group) => setGroupState(group, false));

  if (mobile?.classList.contains('open')) {
    mobile.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open menu');
  }
});

menuButton?.addEventListener('click', () => {
  const open = mobile?.classList.toggle('open') ?? false;
  menuButton.setAttribute('aria-expanded', String(open));
  menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
});

mobile?.querySelectorAll('a').forEach((link) => {
  link.addEventListener('click', () => {
    mobile.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open menu');
  });
});

const updateScrolledState = () => nav?.classList.toggle('is-scrolled', window.scrollY > 10);
updateScrolledState();
window.addEventListener('scroll', updateScrolledState, { passive: true });
</script>
