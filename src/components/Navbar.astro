---
/**
 * FCMobiletools — Navbar
 * Premium redesign. Drop-in replacement: same route data, same behaviours
 * (mega menus, command palette, mobile sheet + dock), no props.
 *
 * Layout contract (unchanged): <header> is sticky + zero-height, the bar floats
 * over the page (~78px incl. margin), so no page needs new top padding.
 */
const current = Astro.url.pathname;
const isActive = (href) => href === '/' ? current === '/' : current === href || current.startsWith(href + '/');

const cta = {
  label: 'FC Mobile 27 Update',
  href: '/fc-mobile-27',
  meta: 'Season 27 · Sep 24',
  mark: '27',
  image: 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790218791/fc-mobile-tools/t0gwuzeytzlmk13pes8q.webp'
};

const navGroups = [
  { id: 'tools', label: 'Tools', blurb: 'Calculators and planners to build a stronger squad.', links: [
    { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating', icon: 'ovr' },
    { label: 'Training Calculator', href: '/training-calculator', meta: 'XP planner', icon: 'training' },
    { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs', icon: 'rank' },
    { label: 'Investment Calculator', href: '/investment-calculator', meta: 'Market planning', icon: 'investment' },
    { label: 'Gauntlet Planner', href: '/gauntlet-planner', meta: 'Squad rotation', icon: 'gauntlet' }
  ]},
  { id: 'live', label: 'Live', blurb: 'What is happening in FC Mobile right now.', links: [
    { label: 'Events', href: '/events', meta: 'Countdowns', icon: 'events' },
    { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Latest rewards', icon: 'codes' },
    { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers', icon: 'story' },
    { label: 'Football Centre', href: '/football-centre', meta: 'Live hub', icon: 'centre' }
  ]}
];

const allLinks = [
  { label: 'Home', href: '/', meta: 'Start here', icon: 'home' },
  { label: cta.label, href: cta.href, meta: cta.meta, icon: 'bolt' },
  ...navGroups.flatMap((g) => g.links.map((l) => ({ ...l, group: g.label }))),
  { label: 'Articles', href: '/blog', meta: 'News, leaks, guides', icon: 'articles' }
];

const groupActive = (g) => g.links.some((l) => isActive(l.href));

const icons = {
  home: '<path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9z"/>',
  ovr: '<path d="M12 3l8 4v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/>',
  training: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  rank: '<path d="M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.4 6.8 19.2l1-5.9L3.5 9.2l5.9-.8L12 3z"/>',
  investment: '<path d="M4 19V5M4 19h16"/><path d="M7 15l4-4 3 3 6-7"/>',
  gauntlet: '<path d="M5 4h14v6a7 7 0 01-14 0V4z"/><path d="M9 20h6M12 17v3"/>',
  events: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  codes: '<path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z"/>',
  story: '<path d="M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  centre: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/>',
  articles: '<path d="M5 4h11l3 3v13H5z"/><path d="M9 11h6M9 15h6M9 7h3"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M7 17L17 7M9 7h8v8"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>'
};
const ico = (name, size = 18, sw = 1.8) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block">${icons[name]}</svg>`;
---

<header class="fcmt" id="fcmt" data-scrolled="false">
  <div class="fcmt-bar" id="fcmtBar">

    <!-- Brand -->
    <a class="fcmt-brand" href="/" aria-label="FCMobiletools home">
      <span class="fcmt-logo"><img src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" /></span>
    </a>

    <!-- Desktop nav -->
    <nav class="fcmt-nav" id="fcmtNav" aria-label="Primary navigation">
      <span class="fcmt-glide" id="fcmtGlide" aria-hidden="true"></span>

      <a class:list={['fcmt-link', { active: isActive('/') }]} href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>

      {navGroups.map((g) => (
        <div class="fcmt-group" data-group={g.id}>
          <button class:list={['fcmt-link', 'fcmt-trigger', { active: groupActive(g) }]} type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`fcmt-mega-${g.id}`}>
            {g.label}
            <svg class="fcmt-chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div class="fcmt-mega" id={`fcmt-mega-${g.id}`} role="group" aria-label={g.label}>
            <div class="fcmt-mega-card">
              <div class="fcmt-mega-main">
                <div class="fcmt-mega-head">
                  <p class="fcmt-eyebrow">{g.label}</p>
                  <p class="fcmt-mega-blurb">{g.blurb}</p>
                </div>
                <div class="fcmt-mega-grid">
                  {g.links.map((l) => (
                    <a class:list={['fcmt-item', { active: isActive(l.href) }]} href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                      <span class="fcmt-ico" set:html={ico(l.icon, 18, 1.7)}></span>
                      <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.meta}</small></span>
                      <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
                    </a>
                  ))}
                </div>
              </div>

              <a class="fcmt-feature" href={cta.href}>
                <span class="fcmt-feature-mark" aria-hidden="true">{cta.mark}</span>
                <img class="fcmt-feature-art" src={cta.image} alt="" width="520" height="300" loading="eager" decoding="async" onerror="this.style.display='none'" />
                <span class="fcmt-feature-tag"><i></i>Most popular</span>
                <strong>{cta.label}</strong>
                <small>Season 27 changes, feature guide and official Android install.</small>
                <span class="fcmt-feature-cta">Open page <span set:html={ico('arrow', 14, 2.4)}></span></span>
              </a>
            </div>
          </div>
        </div>
      ))}

      <a class:list={['fcmt-link', { active: current.startsWith('/blog') }]} href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>Articles</a>
    </nav>

    <!-- Actions -->
    <div class="fcmt-actions">
      <button class="fcmt-search" id="fcmtSearchBtn" type="button" aria-label="Search pages" aria-haspopup="dialog">
        <span class="fcmt-search-icon" set:html={ico('search', 16, 2)}></span>
        <span class="fcmt-search-txt">Search</span>
        <kbd class="fcmt-kbd" id="fcmtKbd">Ctrl K</kbd>
      </button>

      <a class:list={['fcmt-cta', { active: isActive(cta.href) }]} href={cta.href}>
        <span class="fcmt-cta-ico" set:html={ico('bolt', 15, 2.2)}></span>
        <span class="fcmt-cta-txt">{cta.label}</span>
      </a>

      <button class="fcmt-burger" id="fcmtBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="fcmtSheet">
        <span set:html={ico('menu', 20, 2)}></span>
      </button>
    </div>

    <div class="fcmt-progress" id="fcmtProgress" aria-hidden="true"><i></i></div>
  </div>
</header>

<!-- Mobile bottom dock -->
<nav class="fcmt-dock" aria-label="Quick navigation">
  <a class:list={{ active: isActive('/') }} href="/" aria-current={isActive('/') ? 'page' : undefined}><span set:html={ico('home', 20)}></span><em>Home</em></a>
  <a class:list={{ active: isActive('/events') }} href="/events" aria-current={isActive('/events') ? 'page' : undefined}><span set:html={ico('events', 20)}></span><em>Events</em></a>
  <a class:list={['fcmt-dock-main', { active: isActive(cta.href) }]} href={cta.href} aria-label={cta.label}><span set:html={ico('bolt', 22, 2.2)}></span><em>Update</em></a>
  <a class:list={{ active: isActive('/redeem-codes') }} href="/redeem-codes" aria-current={isActive('/redeem-codes') ? 'page' : undefined}><span set:html={ico('codes', 20)}></span><em>Codes</em></a>
  <button type="button" id="fcmtDockMore" aria-label="More" aria-haspopup="dialog"><span set:html={ico('menu', 20)}></span><em>More</em></button>
</nav>

<!-- Full-screen mobile sheet -->
<div class="fcmt-sheet" id="fcmtSheet" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" inert>
  <div class="fcmt-sheet-inner" id="fcmtSheetInner">
    <div class="fcmt-sheet-head" id="fcmtSheetHead">
      <a class="fcmt-brand" href="/" aria-label="FCMobiletools home">
        <span class="fcmt-logo"><img src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" /></span>
      </a>
      <button class="fcmt-x" id="fcmtSheetClose" type="button" aria-label="Close menu"><span set:html={ico('close', 20, 2.2)}></span></button>
    </div>

    <a class="fcmt-hero" href={cta.href}>
      <span class="fcmt-feature-mark" aria-hidden="true">{cta.mark}</span>
      <img class="fcmt-feature-art" src={cta.image} alt="" width="720" height="360" loading="eager" decoding="async" onerror="this.style.display='none'" />
      <span class="fcmt-feature-tag"><i></i>Most popular</span>
      <strong>{cta.label}</strong>
      <small>Season 27 changes, feature guide and official Android install.</small>
      <span class="fcmt-hero-arrow" set:html={ico('arrow', 18, 2.2)}></span>
    </a>

    <div class="fcmt-sheet-scroll">
      {navGroups.map((g) => (
        <section class="fcmt-sec">
          <p class="fcmt-eyebrow">{g.label}</p>
          <div class="fcmt-sec-grid">
            {g.links.map((l) => (
              <a class:list={['fcmt-tile', { active: isActive(l.href) }]} href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                <span class="fcmt-ico" set:html={ico(l.icon, 18, 1.7)}></span>
                <strong>{l.label}</strong>
                <small>{l.meta}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
      <a class:list={['fcmt-wide', { active: current.startsWith('/blog') }]} href="/blog">
        <span class="fcmt-ico" set:html={ico('articles', 18, 1.7)}></span>
        <span class="fcmt-item-text"><strong>Articles</strong><small>News, leaks, guides</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <button class="fcmt-wide fcmt-wide-btn" id="fcmtSheetSearch" type="button">
        <span class="fcmt-ico" set:html={ico('search', 18, 1.7)}></span>
        <span class="fcmt-item-text"><strong>Search pages</strong><small>Jump anywhere</small></span>
      </button>
    </div>
  </div>
</div>

<!-- Command palette -->
<div class="fcmt-pal" id="fcmtPal" role="dialog" aria-modal="true" aria-label="Search pages" aria-hidden="true" inert>
  <div class="fcmt-pal-backdrop" id="fcmtPalBackdrop"></div>
  <div class="fcmt-pal-card">
    <div class="fcmt-pal-field">
      <span set:html={ico('search', 18, 2)}></span>
      <input id="fcmtPalInput" type="text" placeholder="Search tools, events, codes..." autocomplete="off" spellcheck="false" aria-label="Search pages" />
      <kbd class="fcmt-kbd">esc</kbd>
    </div>
    <ul class="fcmt-pal-list" id="fcmtPalList" role="listbox">
      {allLinks.map((l) => (
        <li role="option" data-label={l.label.toLowerCase()} data-meta={(l.meta + ' ' + (l.group || '')).toLowerCase()}>
          <a href={l.href}>
            <span class="fcmt-ico" set:html={ico(l.icon, 18, 1.7)}></span>
            <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.group ? l.group + ' · ' : ''}{l.meta}</small></span>
            <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="fcmt-pal-empty" id="fcmtPalEmpty" hidden>No matches. Try “codes”, “events” or “update”.</p>
    <div class="fcmt-pal-foot" aria-hidden="true">
      <span><kbd class="fcmt-kbd">↑</kbd><kbd class="fcmt-kbd">↓</kbd>Navigate</span>
      <span><kbd class="fcmt-kbd">↵</kbd>Open</span>
      <span><kbd class="fcmt-kbd">esc</kbd>Close</span>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const root = document.documentElement;
  const header = $('fcmt'), progress = $('fcmtProgress').firstElementChild;
  const nav = $('fcmtNav'), glide = $('fcmtGlide');
  const sheet = $('fcmtSheet'), sheetInner = $('fcmtSheetInner'), sheetHead = $('fcmtSheetHead');
  const burger = $('fcmtBurger'), sheetClose = $('fcmtSheetClose'), dockMore = $('fcmtDockMore'), sheetSearch = $('fcmtSheetSearch');
  const pal = $('fcmtPal'), palInput = $('fcmtPalInput'), palList = $('fcmtPalList'), palEmpty = $('fcmtPalEmpty'), palBackdrop = $('fcmtPalBackdrop'), searchBtn = $('fcmtSearchBtn');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* Show the right shortcut hint for the platform */
  const kbd = $('fcmtKbd');
  if (kbd && /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent)) kbd.textContent = '⌘K';

  /* ---------- Overlay helpers ---------- */
  let lastFocus = null;
  const lockScroll = (on) => root.classList.toggle('fcmt-lock', on);
  const openLayer = (el, focusEl) => {
    lastFocus = document.activeElement;
    el.removeAttribute('inert'); el.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => el.classList.add('open'));
    lockScroll(true);
    setTimeout(() => focusEl?.focus(), 60);
  };
  const closeLayer = (el, restore = true) => {
    el.classList.remove('open'); el.setAttribute('aria-hidden', 'true'); el.setAttribute('inert', '');
    if (!sheet.classList.contains('open') && !pal.classList.contains('open')) lockScroll(false);
    if (restore) lastFocus?.focus?.();
  };
  const trap = (el, e) => {
    if (e.key !== 'Tab' || !el.classList.contains('open')) return;
    const f = [...el.querySelectorAll('a[href],button:not([disabled]),input')].filter((n) => n.offsetParent !== null);
    if (!f.length) return;
    const a = f[0], z = f[f.length - 1];
    if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
    else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
  };

  /* ---------- Desktop mega menus ---------- */
  const groups = [...document.querySelectorAll('.fcmt-group')];
  let timer;
  const setGroup = (g, open) => {
    g.classList.toggle('open', open);
    g.querySelector('.fcmt-trigger').setAttribute('aria-expanded', String(open));
    header.classList.toggle('menu-open', groups.some((x) => x.classList.contains('open')));
  };
  const closeGroups = (except) => groups.forEach((g) => g !== except && setGroup(g, false));

  groups.forEach((g) => {
    const trig = g.querySelector('.fcmt-trigger');
    const items = [...g.querySelectorAll('.fcmt-item')];
    trig.addEventListener('click', () => { const o = !g.classList.contains('open'); closeGroups(g); setGroup(g, o); });
    if (canHover) {
      g.addEventListener('pointerenter', () => { clearTimeout(timer); closeGroups(g); setGroup(g, true); });
      g.addEventListener('pointerleave', () => { timer = setTimeout(() => setGroup(g, false), 200); });
    }
    trig.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); closeGroups(g); setGroup(g, true); items[0]?.focus(); } });
    items.forEach((it, i) => it.addEventListener('keydown', (e) => {
      const next = e.key === 'ArrowDown' || e.key === 'ArrowRight', prev = e.key === 'ArrowUp' || e.key === 'ArrowLeft';
      if (next) { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (prev) { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { setGroup(g, false); trig.focus(); }
    }));
    g.addEventListener('focusout', (e) => { if (!g.contains(e.relatedTarget)) setGroup(g, false); });
  });
  document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.fcmt-group')) closeGroups(); });

  /* ---------- Glide highlight ---------- */
  const links = [...nav.querySelectorAll(':scope > .fcmt-link, :scope > .fcmt-group > .fcmt-trigger')];
  const moveGlide = (el) => {
    if (!el) { glide.style.opacity = '0'; return; }
    const n = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
    glide.style.opacity = '1'; glide.style.width = r.width + 'px'; glide.style.transform = `translateX(${r.left - n.left}px)`;
  };
  if (canHover) { links.forEach((l) => l.addEventListener('pointerenter', () => moveGlide(l))); nav.addEventListener('pointerleave', () => moveGlide(null)); }

  /* ---------- Scroll ---------- */
  let ticking = false, lastY = scrollY;
  const onScroll = () => {
    const y = scrollY, max = document.documentElement.scrollHeight - innerHeight;
    header.dataset.scrolled = String(y > 12);
    progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
    if (Math.abs(y - lastY) > 24 && header.classList.contains('menu-open')) closeGroups();
    lastY = y; ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  /* ---------- Mobile sheet ---------- */
  const openSheet = () => { burger.setAttribute('aria-expanded', 'true'); openLayer(sheet, sheetClose); };
  const closeSheet = (restore = true) => { burger.setAttribute('aria-expanded', 'false'); closeLayer(sheet, restore); };
  burger.addEventListener('click', openSheet);
  dockMore?.addEventListener('click', openSheet);
  sheetClose.addEventListener('click', () => closeSheet());
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeSheet(false)));
  sheetSearch.addEventListener('click', () => { closeSheet(false); setTimeout(openPal, 180); });
  sheet.addEventListener('pointerdown', (e) => { if (e.target === sheet) closeSheet(); });

  /* Swipe the header down to dismiss */
  let sy = 0, dy = 0, dragging = false;
  sheetHead.addEventListener('touchstart', (e) => { sy = e.touches[0].clientY; dy = 0; dragging = true; sheetInner.style.transition = 'none'; }, { passive: true });
  sheetHead.addEventListener('touchmove', (e) => { if (!dragging) return; dy = Math.max(0, e.touches[0].clientY - sy); sheetInner.style.transform = `translateY(${dy}px)`; }, { passive: true });
  sheetHead.addEventListener('touchend', () => {
    if (!dragging) return; dragging = false; sheetInner.style.transition = '';
    if (dy > 90) { sheetInner.style.transform = 'translateY(100%)'; closeSheet(); setTimeout(() => { sheetInner.style.transform = ''; }, 460); }
    else sheetInner.style.transform = '';
    dy = 0;
  });

  /* ---------- Command palette ---------- */
  const rows = [...palList.querySelectorAll('li')];
  let sel = 0;
  const visible = () => rows.filter((r) => !r.hidden);
  const paint = () => { const v = visible(); v.forEach((r, i) => r.classList.toggle('sel', i === sel)); v[sel]?.scrollIntoView({ block: 'nearest' }); };
  const filter = () => {
    const q = palInput.value.trim().toLowerCase();
    rows.forEach((r) => { r.hidden = !!q && !(r.dataset.label.includes(q) || r.dataset.meta.includes(q)); });
    palEmpty.hidden = visible().length > 0; sel = 0; paint();
  };
  const openPal = () => { palInput.value = ''; filter(); openLayer(pal, palInput); };
  const closePal = () => closeLayer(pal);
  searchBtn.addEventListener('click', openPal);
  palBackdrop.addEventListener('click', closePal);
  palInput.addEventListener('input', filter);
  rows.forEach((r, i) => r.addEventListener('pointermove', () => { const v = visible(); const n = v.indexOf(r); if (n > -1 && n !== sel) { sel = n; paint(); } }));
  palList.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeLayer(pal, false)));
  palInput.addEventListener('keydown', (e) => {
    const v = visible();
    if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % Math.max(v.length, 1); paint(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + v.length) % Math.max(v.length, 1); paint(); }
    if (e.key === 'Enter' && v[sel]) { e.preventDefault(); v[sel].querySelector('a').click(); }
  });

  /* ---------- Global keys ---------- */
  document.addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
    if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); pal.classList.contains('open') ? closePal() : openPal(); }
    if (e.key === 'Escape') { if (pal.classList.contains('open')) closePal(); else if (sheet.classList.contains('open')) closeSheet(); closeGroups(); }
    trap(pal, e); trap(sheet, e);
  });

  /* Close sheet if resized to desktop */
  addEventListener('resize', () => { if (innerWidth > 980 && sheet.classList.contains('open')) closeSheet(false); moveGlide(null); });
})();
</script>

<style is:global>
/* Kill horizontal overflow at the source */
html,body{max-width:100%;overflow-x:clip}
html.fcmt-lock{overflow:hidden}
/* Keep the mobile dock from covering page content / footer */
@media(max-width:980px){body{padding-bottom:calc(96px + env(safe-area-inset-bottom,0))}}
</style>

<style>
/* =====================================================================
   Tokens (scoped to the navbar; inherit brand tokens from styles.css)
   ===================================================================== */
.fcmt{
  --n-cy:var(--primary,#4CC9FF);
  --n-cy-soft:rgba(76,201,255,.12);
  --n-line:rgba(255,255,255,.075);
  --n-ease:cubic-bezier(.22,.8,.22,1);
  --n-glass-top:rgba(23,38,55,.74);
  --n-glass-bot:rgba(10,19,29,.70);
  --n-panel-top:#15263a;
  --n-panel-bot:#0b1622;
}

/* =====================================================================
   Floating bar — grid-aligned, true-centred nav
   ===================================================================== */
.fcmt{position:sticky;top:0;z-index:1200;height:0;pointer-events:none;padding-top:env(safe-area-inset-top,0)}

/* page dim while a mega menu is open — focus without noise */
.fcmt::before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(120% 70% at 50% 0%,rgba(2,7,12,.55),rgba(2,7,12,.72));opacity:0;pointer-events:none;transition:opacity .28s ease}
.fcmt.menu-open::before{opacity:1}

.fcmt-bar{
  pointer-events:auto;position:relative;
  width:min(var(--content-width,1180px),calc(100% - 32px));height:64px;margin:12px auto 0;
  display:grid;grid-template-columns:1fr auto 1fr;align-items:center;column-gap:20px;padding:0 12px 0 16px;
  border-radius:20px;
  background:linear-gradient(180deg,var(--n-glass-top),var(--n-glass-bot));
  backdrop-filter:blur(28px) saturate(180%);-webkit-backdrop-filter:blur(28px) saturate(180%);
  box-shadow:
    0 1px 0 rgba(255,255,255,.09) inset,
    0 0 0 1px rgba(255,255,255,.06),
    0 1px 2px rgba(0,0,0,.35),
    0 14px 34px -10px rgba(0,0,0,.55),
    0 40px 80px -30px rgba(0,0,0,.6);
  transition:width .45s var(--n-ease),height .3s ease,margin .3s ease,background .3s ease,box-shadow .3s ease;
}
/* gradient hairline: bright top-left, cool bottom-right */
.fcmt-bar::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(125deg,rgba(130,222,255,.55),rgba(255,255,255,.04) 28%,rgba(255,255,255,.02) 70%,rgba(110,150,255,.32));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.7}
/* specular top edge */
.fcmt-bar::after{content:"";position:absolute;top:0;left:16%;right:16%;height:1px;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);opacity:.55}

.fcmt[data-scrolled="true"] .fcmt-bar{
  width:min(1096px,calc(100% - 40px));height:56px;margin-top:10px;
  background:linear-gradient(180deg,rgba(15,27,40,.92),rgba(8,16,24,.9));
  box-shadow:0 1px 0 rgba(255,255,255,.07) inset,0 0 0 1px rgba(255,255,255,.07),0 1px 2px rgba(0,0,0,.4),0 18px 44px -12px rgba(0,0,0,.7),0 44px 90px -30px rgba(0,0,0,.7);
}

/* =====================================================================
   Brand — cropped so the artwork fills the lockup (source PNG is ~60% padding)
   ===================================================================== */
.fcmt-brand{justify-self:start;display:flex;align-items:center;flex:none;text-decoration:none;border-radius:12px;padding:4px 6px 4px 0}
.fcmt-logo{--lh:44px;position:relative;display:block;flex:none;height:var(--lh);width:calc(var(--lh)*3.3333);overflow:hidden;transition:height .3s ease,width .3s ease,filter .3s ease;filter:drop-shadow(0 6px 14px rgba(76,201,255,.18))}
.fcmt-logo img{position:absolute;display:block;max-width:none;width:auto;height:calc(var(--lh)*1.97111);left:calc(var(--lh)*-.28889);top:calc(var(--lh)*-.42222);transition:height .3s ease,left .3s ease,top .3s ease}
.fcmt-brand:hover .fcmt-logo{filter:drop-shadow(0 6px 18px rgba(76,201,255,.38))}
.fcmt[data-scrolled="true"] .fcmt-logo{--lh:40px}

/* =====================================================================
   Desktop nav
   ===================================================================== */
.fcmt-nav{position:relative;justify-self:center;display:flex;align-items:center;gap:2px}
.fcmt-glide{position:absolute;left:0;top:50%;height:38px;margin-top:-19px;width:0;border-radius:11px;background:linear-gradient(180deg,rgba(255,255,255,.085),rgba(255,255,255,.035));box-shadow:0 0 0 1px rgba(255,255,255,.06) inset;opacity:0;pointer-events:none;transition:transform .34s var(--n-ease),width .34s var(--n-ease),opacity .2s ease}
.fcmt-link{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 15px;border:0;border-radius:11px;background:transparent;color:#9fb0c1;font:600 13.5px/1 var(--font-body);letter-spacing:-.005em;text-decoration:none;cursor:pointer;transition:color .18s ease}
.fcmt-link:hover,.fcmt-group.open>.fcmt-trigger,.fcmt-link.active{color:#fff}
/* active = cyan lamp resting on the bar's lower edge */
.fcmt-link.active::before{content:"";position:absolute;left:8px;right:8px;bottom:-12px;height:30px;border-radius:50%;background:radial-gradient(ellipse 60% 100% at 50% 100%,rgba(76,201,255,.2),transparent 72%);pointer-events:none;z-index:-1}
.fcmt-link.active::after{content:"";position:absolute;left:50%;bottom:-11px;width:24px;height:2px;margin-left:-12px;border-radius:99px;background:linear-gradient(90deg,transparent,var(--n-cy),transparent);box-shadow:0 0 12px 1px rgba(76,201,255,.75)}
.fcmt[data-scrolled="true"] .fcmt-link.active::before{bottom:-9px}
.fcmt[data-scrolled="true"] .fcmt-link.active::after{bottom:-8px}
.fcmt-chev{color:#6f8296;transition:transform .28s var(--n-ease),color .2s}
.fcmt-group{position:static}
.fcmt-group.open .fcmt-chev{transform:rotate(180deg);color:var(--n-cy)}

/* =====================================================================
   Mega menu — one consistent panel, centred under the bar
   ===================================================================== */
.fcmt-mega{
  position:absolute;left:50%;top:calc(100% - 12px);width:min(852px,100%);padding-top:24px;
  transform:translate(-50%,10px) scale(.985);transform-origin:top center;
  opacity:0;visibility:hidden;pointer-events:none;
  transition:opacity .2s ease,transform .3s var(--n-ease),visibility 0s linear .3s;
}
.fcmt-group.open .fcmt-mega{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0) scale(1);transition-delay:0s}
.fcmt-mega-card{
  display:grid;grid-template-columns:minmax(0,1fr) 296px;gap:10px;padding:10px;border-radius:26px;
  background:linear-gradient(180deg,var(--n-panel-top),var(--n-panel-bot));
  box-shadow:0 1px 0 rgba(255,255,255,.09) inset,0 0 0 1px rgba(255,255,255,.085),0 2px 4px rgba(0,0,0,.4),0 40px 90px -16px rgba(0,0,0,.8);
}
.fcmt-mega-main{padding:10px 6px 6px 10px;min-width:0}
.fcmt-mega-head{padding:0 8px 14px;margin-bottom:8px;border-bottom:1px solid var(--n-line)}
.fcmt-eyebrow{margin:0;color:var(--n-cy);font:800 10px/1 var(--font-body);letter-spacing:.22em;text-transform:uppercase}
.fcmt-mega-blurb{margin:9px 0 0;color:#8497aa;font:500 12.5px/1.45 var(--font-body)}
.fcmt-mega-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px}

.fcmt-item,.fcmt-wide{position:relative;display:flex;align-items:center;gap:12px;padding:10px;border:1px solid transparent;border-radius:16px;color:#a7b6c5;text-decoration:none;transition:background .18s,border-color .18s,color .18s,transform .2s var(--n-ease)}
.fcmt-item:hover,.fcmt-item:focus-visible,.fcmt-item.active{color:#fff;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));border-color:rgba(255,255,255,.08)}
.fcmt-item:hover{transform:translateY(-1px)}
.fcmt-ico{display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 1px 0 rgba(255,255,255,.08) inset,0 0 0 1px rgba(255,255,255,.07);color:#b9c8d6;transition:color .2s,background .2s,box-shadow .25s}
.fcmt-item:hover .fcmt-ico,.fcmt-item:focus-visible .fcmt-ico,.fcmt-item.active .fcmt-ico,.fcmt-tile:hover .fcmt-ico,.fcmt-tile.active .fcmt-ico,.fcmt-wide:hover .fcmt-ico,.fcmt-wide.active .fcmt-ico,.fcmt-pal-list li.sel .fcmt-ico{color:var(--n-cy);background:linear-gradient(180deg,rgba(76,201,255,.2),rgba(76,201,255,.07));box-shadow:0 1px 0 rgba(160,230,255,.25) inset,0 0 0 1px rgba(76,201,255,.3),0 6px 20px -4px rgba(76,201,255,.35)}
.fcmt-item-text{flex:1;min-width:0;text-align:left}
.fcmt-item-text strong,.fcmt-item-text small{display:block}
.fcmt-item-text strong{font:700 13.5px/1.25 var(--font-body);letter-spacing:-.005em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fcmt-item-text small{margin-top:3px;font:500 11.5px/1.2 var(--font-body);color:#6f8296}
.fcmt-go{flex:0 0 auto;color:#566a7d;opacity:0;transform:translate(-4px,4px);transition:opacity .2s,transform .25s var(--n-ease),color .2s}
.fcmt-item:hover .fcmt-go,.fcmt-item:focus-visible .fcmt-go,.fcmt-item.active .fcmt-go,.fcmt-wide:hover .fcmt-go{opacity:1;transform:none;color:var(--n-cy)}

/* Featured card */
.fcmt-feature,.fcmt-hero{position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;overflow:hidden;padding:20px;border-radius:19px;background:radial-gradient(120% 80% at 85% 0%,rgba(76,201,255,.5),transparent 60%),linear-gradient(160deg,#0f3b55,#0a1a28 60%,#08121c);box-shadow:0 0 0 1px rgba(76,201,255,.22) inset;text-decoration:none;color:#fff;transition:transform .3s var(--n-ease),box-shadow .3s}
.fcmt-feature{min-height:276px}
.fcmt-hero{min-height:148px;margin-bottom:6px}
.fcmt-feature:hover,.fcmt-hero:active{transform:translateY(-2px);box-shadow:0 0 0 1px rgba(76,201,255,.5) inset,0 24px 44px -16px rgba(76,201,255,.4)}
.fcmt-feature-mark{position:absolute;z-index:-3;right:-6px;top:-18px;font:700 150px/1 var(--font-display);letter-spacing:-.06em;color:transparent;-webkit-text-stroke:1.5px rgba(150,225,255,.28);user-select:none}
.fcmt-feature-art{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .8s var(--n-ease)}
.fcmt-feature:hover .fcmt-feature-art{transform:scale(1.045)}
.fcmt-feature::after,.fcmt-hero::after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,rgba(5,12,18,0) 0%,rgba(5,12,18,.12) 30%,rgba(5,12,18,.92) 100%);pointer-events:none}
.fcmt-feature-tag{display:inline-flex;align-items:center;gap:7px;align-self:flex-start;padding:6px 10px;border-radius:99px;background:rgba(4,16,24,.62);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 0 0 1px rgba(76,201,255,.3) inset;color:var(--n-cy);font:800 9.5px/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase}
.fcmt-feature-tag i{width:6px;height:6px;border-radius:50%;background:var(--n-cy);animation:fcmt-ping 2.2s infinite}
@keyframes fcmt-ping{0%{box-shadow:0 0 0 0 rgba(76,201,255,.6)}70%,100%{box-shadow:0 0 0 8px rgba(76,201,255,0)}}
.fcmt-feature strong,.fcmt-hero strong{margin-top:auto;font:700 19px/1.12 var(--font-display);letter-spacing:-.02em}
.fcmt-feature small,.fcmt-hero small{font:500 12px/1.45 var(--font-body);color:#9db0c2}
.fcmt-feature-cta{display:inline-flex;align-items:center;gap:6px;margin-top:8px;color:var(--n-cy);font:800 12px/1 var(--font-body)}
.fcmt-feature-cta span{transition:transform .25s var(--n-ease)}
.fcmt-feature:hover .fcmt-feature-cta span{transform:translate(2px,-2px)}

/* =====================================================================
   Actions
   ===================================================================== */
.fcmt-actions{justify-self:end;display:flex;align-items:center;gap:8px}
.fcmt-search{display:inline-flex;align-items:center;gap:9px;height:40px;padding:0 8px 0 12px;border:0;border-radius:12px;background:rgba(255,255,255,.04);box-shadow:0 0 0 1px rgba(255,255,255,.085) inset;color:#9fb0c1;font:600 12.5px/1 var(--font-body);cursor:pointer;transition:color .2s,background .2s,box-shadow .2s}
.fcmt-search:hover{color:#fff;background:rgba(255,255,255,.07);box-shadow:0 0 0 1px rgba(76,201,255,.35) inset,0 8px 24px -8px rgba(76,201,255,.25)}
.fcmt-search-icon{display:grid;place-items:center;color:#8da0b3}
.fcmt-search-txt{padding-right:10px}
.fcmt-kbd{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:7px;background:rgba(255,255,255,.06);box-shadow:0 1px 0 rgba(255,255,255,.08) inset,0 0 0 1px rgba(255,255,255,.1);color:#aebdcb;font:700 10.5px/1 var(--font-body);letter-spacing:.02em}

.fcmt-cta{position:relative;isolation:isolate;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px 0 12px;border-radius:12px;overflow:hidden;color:#03121b;text-decoration:none;white-space:nowrap;font:800 13px/1 var(--font-body);letter-spacing:-.005em;background:linear-gradient(180deg,#9ae8ff 0%,#4cc9ff 52%,#2fb1ea 100%);box-shadow:0 1px 0 rgba(255,255,255,.6) inset,0 -1px 0 rgba(0,70,110,.25) inset,0 8px 22px -6px rgba(76,201,255,.55);transition:transform .22s var(--n-ease),box-shadow .25s}
.fcmt-cta::after{content:"";position:absolute;z-index:-1;top:0;left:-70%;width:45%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent);transform:skewX(-20deg);transition:left .7s var(--n-ease)}
.fcmt-cta:hover{transform:translateY(-1px);box-shadow:0 1px 0 rgba(255,255,255,.65) inset,0 -1px 0 rgba(0,70,110,.25) inset,0 14px 30px -6px rgba(76,201,255,.75)}
.fcmt-cta:hover::after{left:130%}
.fcmt-cta:active{transform:scale(.97)}
.fcmt-cta-ico{display:grid;place-items:center;transition:transform .25s var(--n-ease)}
.fcmt-cta:hover .fcmt-cta-ico{transform:rotate(-12deg) scale(1.1)}

.fcmt-burger,.fcmt-x{display:none;place-items:center;width:44px;height:44px;border:0;border-radius:13px;background:rgba(255,255,255,.05);box-shadow:0 0 0 1px rgba(255,255,255,.09) inset;color:#fff;cursor:pointer;transition:background .2s,transform .15s;-webkit-tap-highlight-color:transparent}
.fcmt-burger:active,.fcmt-x:active{transform:scale(.93)}

/* Reading progress sits on the bar's bottom edge */
.fcmt-progress{position:absolute;left:22px;right:22px;bottom:-1px;height:2px;pointer-events:none;overflow:hidden;border-radius:99px}
.fcmt-progress i{position:absolute;inset:0;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,rgba(76,201,255,0),var(--n-cy) 30%,#b6f0ff);box-shadow:0 0 12px rgba(76,201,255,.7)}

/* =====================================================================
   Mobile dock
   ===================================================================== */
.fcmt-dock{display:none}

/* =====================================================================
   Full-screen sheet
   ===================================================================== */
.fcmt-sheet{position:fixed;inset:0;z-index:1500;visibility:hidden;opacity:0;background:rgba(3,9,14,.55);transition:opacity .28s ease,visibility 0s linear .36s}
.fcmt-sheet.open{visibility:visible;opacity:1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition-delay:0s}
.fcmt-sheet-inner{position:absolute;left:0;right:0;bottom:0;top:calc(env(safe-area-inset-top,0) + 10px);display:flex;flex-direction:column;padding:14px 16px calc(18px + env(safe-area-inset-bottom,0));border-radius:30px 30px 0 0;background:radial-gradient(90% 36% at 90% 0%,rgba(76,201,255,.14),transparent 70%),linear-gradient(180deg,#14233a,#08111a);box-shadow:0 1px 0 rgba(255,255,255,.1) inset,0 0 0 1px rgba(255,255,255,.07),0 -30px 90px rgba(0,0,0,.65);transform:translateY(100%);transition:transform .46s var(--n-ease)}
.fcmt-sheet.open .fcmt-sheet-inner{transform:translateY(0)}
.fcmt-sheet-inner::before{content:"";position:absolute;top:8px;left:50%;width:40px;height:4px;margin-left:-20px;border-radius:99px;background:rgba(255,255,255,.2)}
.fcmt-sheet-head{display:flex;align-items:center;justify-content:space-between;padding:14px 0 14px;touch-action:none}
.fcmt-sheet .fcmt-logo{--lh:40px}
.fcmt-x{display:grid}
.fcmt-hero-arrow{position:absolute;top:16px;right:16px;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:rgba(76,201,255,.16);box-shadow:0 0 0 1px rgba(76,201,255,.3) inset;color:var(--n-cy)}
.fcmt-sheet-scroll{flex:1;overflow-y:auto;overscroll-behavior:contain;padding-bottom:8px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.fcmt-sheet-scroll::-webkit-scrollbar{display:none}
.fcmt-sec{margin-top:6px}
.fcmt-sec .fcmt-eyebrow{padding:14px 4px 10px}
.fcmt-sec-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fcmt-tile{display:flex;flex-direction:column;gap:3px;padding:14px;border-radius:19px;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 0 0 1px rgba(255,255,255,.07);text-decoration:none;color:#a7b6c5;-webkit-tap-highlight-color:transparent;transition:background .2s,box-shadow .2s,transform .15s}
.fcmt-tile .fcmt-ico{margin-bottom:12px}
.fcmt-tile strong{font:700 13.5px/1.25 var(--font-body);color:#fff}
.fcmt-tile small{font:500 11.5px/1.25 var(--font-body);color:#6f8296}
.fcmt-tile:active{transform:scale(.97)}
.fcmt-tile:active,.fcmt-tile.active{background:linear-gradient(180deg,rgba(76,201,255,.13),rgba(76,201,255,.05));box-shadow:0 0 0 1px rgba(76,201,255,.3) inset}
.fcmt-wide{width:100%;margin-top:8px;padding:12px 14px;border:0;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 0 0 1px rgba(255,255,255,.07);text-align:left;font-family:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}
.fcmt-wide.active{box-shadow:0 0 0 1px rgba(76,201,255,.3) inset;background:rgba(76,201,255,.08)}
.fcmt-wide .fcmt-go{opacity:.6;transform:none}
.fcmt-sheet .fcmt-sec-grid>*,.fcmt-sheet .fcmt-hero,.fcmt-sheet .fcmt-wide{opacity:0;transform:translateY(14px);transition:opacity .35s ease,transform .5s var(--n-ease),background .2s,box-shadow .2s}
.fcmt-sheet.open .fcmt-sec-grid>*,.fcmt-sheet.open .fcmt-hero,.fcmt-sheet.open .fcmt-wide{opacity:1;transform:none}
.fcmt-sheet.open .fcmt-hero{transition-delay:.1s}
.fcmt-sheet.open .fcmt-sec:nth-child(1) .fcmt-sec-grid>*{transition-delay:.16s}
.fcmt-sheet.open .fcmt-sec:nth-child(2) .fcmt-sec-grid>*{transition-delay:.24s}
.fcmt-sheet.open .fcmt-wide{transition-delay:.3s}

/* =====================================================================
   Command palette
   ===================================================================== */
.fcmt-pal{position:fixed;inset:0;z-index:1600;display:grid;place-items:start center;padding:12vh 16px 16px;visibility:hidden;opacity:0;transition:opacity .2s ease,visibility 0s linear .2s}
.fcmt-pal.open{visibility:visible;opacity:1;transition-delay:0s}
.fcmt-pal-backdrop{position:absolute;inset:0;background:rgba(2,8,13,.66);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.fcmt-pal-card{position:relative;width:min(580px,100%);overflow:hidden;border-radius:24px;background:linear-gradient(180deg,#15263a,#0a1520);box-shadow:0 1px 0 rgba(255,255,255,.09) inset,0 0 0 1px rgba(255,255,255,.1),0 60px 120px -10px rgba(0,0,0,.85);transform:translateY(-10px) scale(.98);transition:transform .32s var(--n-ease)}
.fcmt-pal.open .fcmt-pal-card{transform:none}
.fcmt-pal-field{display:flex;align-items:center;gap:12px;padding:0 18px;height:62px;border-bottom:1px solid var(--n-line);color:#8da0b3}
.fcmt-pal-field input{flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;color:#fff;font:600 16px/1 var(--font-body)}
.fcmt-pal-field input::placeholder{color:#5a6e81}
.fcmt-pal-list{list-style:none;margin:0;padding:8px;max-height:min(50vh,404px);overflow-y:auto}
.fcmt-pal-list li{border-radius:15px}
.fcmt-pal-list li[hidden]{display:none}
.fcmt-pal-list a{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:15px;color:#a7b6c5;text-decoration:none}
.fcmt-pal-list li.sel a{background:linear-gradient(180deg,rgba(255,255,255,.065),rgba(255,255,255,.03));box-shadow:0 0 0 1px rgba(255,255,255,.07) inset;color:#fff}
.fcmt-pal-list li.sel .fcmt-go{opacity:1;transform:none;color:var(--n-cy)}
.fcmt-pal-empty{margin:0;padding:28px 16px 32px;text-align:center;color:#6f8296;font:600 13px/1.4 var(--font-body)}
.fcmt-pal-foot{display:flex;align-items:center;gap:18px;padding:11px 18px;border-top:1px solid var(--n-line);background:rgba(0,0,0,.18);color:#6f8296;font:600 11.5px/1 var(--font-body)}
.fcmt-pal-foot span{display:inline-flex;align-items:center;gap:6px}
.fcmt-pal-foot .fcmt-kbd{min-width:20px;height:20px;padding:0 5px}
@media(hover:none){.fcmt-pal-foot{display:none}}

/* Focus rings */
