---
const groups = [
  { label: 'Tools', links: [
    { label: 'Team OVR', href: '/team-ovr' },
    { label: 'Training Calculator', href: '/training-calculator' },
    { label: 'Rank Up Calculator', href: '/rank-up-calculator' },
  ] },
  { label: 'Explore', links: [
    { label: 'Football Centre', href: '/football-centre' },
    { label: "A Nation's Story", href: '/a-nations-story' },
    { label: 'Creator', href: '/creator' },
  ] },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
const groupIsActive = (group) => group.links.some((link) => isActive(link.href));
---
<header class="site-nav" data-site-nav>
  <div class="site-nav-inner">
    <a class="site-brand" href="/" aria-label="FC Mobile Tools home"><span>FC</span> FC Mobile Tools</a>
    <nav class="site-primary" aria-label="Primary navigation">
      <a href="/" class:list={{ active: currentPath === '/' }}>Home</a>
      {groups.map((group) => <div class="site-nav-group" data-nav-group>
        <button type="button" class:list={{ 'site-nav-trigger': true, active: groupIsActive(group) }} aria-expanded="false" aria-haspopup="true">{group.label}<span aria-hidden="true">⌄</span></button>
        <div class="site-nav-menu">
          {group.links.map((link) => <a href={link.href} class:list={{ active: isActive(link.href) }}><span>{link.label}</span><small aria-hidden="true">↗</small></a>)}
        </div>
      </div>)}
    </nav>
    <button class="site-menu" type="button" aria-expanded="false" aria-controls="site-mobile-nav" aria-label="Open menu"><span></span><span></span><span></span></button>
  </div>
  <nav id="site-mobile-nav" class="site-mobile-nav" aria-label="Mobile navigation">
    <a href="/" class:list={{ active: currentPath === '/' }}>Home</a>
    {groups.map((group) => <div class="site-mobile-group"><span>{group.label}</span>{group.links.map((link) => <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>)}</div>)}
  </nav>
</header>
<style>
.site-nav-group{position:relative}.site-nav-trigger{display:flex;align-items:center;gap:7px;border:1px solid transparent;background:transparent;color:var(--muted,#8e9bad);font:inherit;cursor:pointer;padding:8px 10px;border-radius:8px;transition:.18s}.site-nav-trigger span{font-size:11px;opacity:.55;transition:transform .18s}.site-nav-group:hover .site-nav-trigger,.site-nav-trigger:focus-visible,.site-nav-trigger.active{color:var(--text,#f5f7fb);background:var(--surface2,#121925);border-color:var(--border,#202a38)}.site-nav-group:hover .site-nav-trigger span,.site-nav-group.open .site-nav-trigger span{transform:rotate(180deg)}.site-nav-trigger.active{color:var(--blue,#55c7f2)}.site-nav-menu{position:absolute;top:calc(100% + 9px);left:50%;width:240px;transform:translate(-50%,-5px);padding:7px;border:1px solid var(--border,#202a38);border-radius:12px;background:var(--surface,#0d1118);box-shadow:0 18px 45px #0008;opacity:0;pointer-events:none;transition:.18s;z-index:50}.site-nav-group:hover .site-nav-menu,.site-nav-group.open .site-nav-menu{opacity:1;transform:translate(-50%,0);pointer-events:auto}.site-nav-menu a{display:flex!important;align-items:center;justify-content:space-between!important;gap:12px;padding:10px 11px;border-radius:8px;color:var(--muted,#8e9bad)!important;text-decoration:none;transition:.15s}.site-nav-menu a:hover,.site-nav-menu a.active{background:#55c7f214;color:var(--blue,#55c7f2)!important}.site-nav-menu small{font-size:11px;opacity:.45}.site-primary{display:flex;align-items:center;gap:2px}.site-primary>a,.site-nav-trigger{font-size:11px!important}.site-mobile-group{display:grid;gap:3px;padding:11px 0;border-top:1px solid var(--border,#202a38)}.site-mobile-group>span{padding:5px 10px;color:var(--muted,#8e9bad);font:900 8px var(--mono,monospace);letter-spacing:.13em;text-transform:uppercase}.site-mobile-group a{padding-left:18px!important}.site-menu{display:none;align-items:center;justify-content:center;flex-direction:column;gap:4px;width:38px;height:38px;padding:0;border:1px solid var(--border,#202a38);border-radius:9px;background:var(--surface2,#121925);color:var(--text,#f5f7fb);cursor:pointer}.site-menu span{display:block;width:15px;height:1.5px;background:currentColor;border-radius:2px;transition:.18s}.site-mobile-nav{display:none}.site-mobile-nav.open{display:grid}.site-mobile-nav>a{padding:12px 10px;border-top:1px solid var(--border,#202a38);color:var(--muted,#8e9bad);text-decoration:none;font-size:12px;font-weight:700}.site-mobile-nav>a.active,.site-mobile-group a.active{color:var(--blue,#55c7f2)}.site-mobile-group a{color:var(--muted,#8e9bad);text-decoration:none;font-size:12px}.site-mobile-nav>a:hover,.site-mobile-group a:hover{color:var(--text,#f5f7fb)}
@media(max-width:900px){.site-primary{display:none}.site-menu{display:flex}.site-nav-menu{display:none}}@media(min-width:901px){.site-mobile-nav{display:none!important}}@media(max-width:520px){.site-nav-inner{padding-inline:14px}.site-brand{font-size:12px}.site-mobile-nav{margin-inline:14px}.site-menu{width:36px;height:36px}}
</style>
<script>
const nav=document.querySelector('[data-site-nav]');const button=nav?.querySelector('.site-menu');const mobile=nav?.querySelector('.site-mobile-nav');button?.addEventListener('click',()=>{const open=mobile?.classList.toggle('open')??false;button?.setAttribute('aria-expanded',String(open));button?.setAttribute('aria-label',open?'Close menu':'Open menu')});nav?.querySelectorAll('[data-nav-group]').forEach(group=>{const trigger=group.querySelector('.site-nav-trigger');trigger?.addEventListener('click',()=>{const open=group.classList.toggle('open');trigger.setAttribute('aria-expanded',String(open));nav.querySelectorAll('[data-nav-group].open').forEach(other=>{if(other!==group){other.classList.remove('open');other.querySelector('.site-nav-trigger')?.setAttribute('aria-expanded','false')}})})});document.addEventListener('click',event=>{if(!nav?.contains(event.target))nav?.querySelectorAll('[data-nav-group].open').forEach(group=>group.classList.remove('open'))});
</script>
