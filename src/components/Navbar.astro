---
import { getLocaleFromPath, stripLocale, localizeHref, translator } from '../i18n/index.js';
import LanguageSwitcher from './LanguageSwitcher.astro';
import AccountMenu from './AccountMenu.astro';
const locale = getLocaleFromPath(Astro.url.pathname);
const tr = translator(locale);
// Active states compare English paths, so /bn/events/ highlights Events the same as /events/.
const current = stripLocale(Astro.url.pathname) === '/' ? '/' : stripLocale(Astro.url.pathname).replace(/\/$/, '');
const isActive = (href) => href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
// Internal links stay in the visitor's language when a translated page exists, else English.
const href = (h) => localizeHref(h, locale);
const item = (id, h, icon) => ({ id, label: tr(`nav.items.${id}.label`), meta: tr(`nav.items.${id}.meta`), href: h, icon });

const cta = { label: tr('nav.update.label'), href: '/fc-mobile-27', meta: tr('nav.update.meta'), blurb: tr('nav.update.blurb'), image: 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790218791/fc-mobile-tools/t0gwuzeytzlmk13pes8q.webp' };

const navGroups = [
  { id: 'tools', label: tr('nav.groups.tools'), links: [
    item('team-ovr', '/team-ovr', 'ovr'),
    item('playstyle', '/player/playstyle', 'playstyle'),
    item('playstyle-finder', '/player/playstyle-finder', 'playstyle'),
    item('training', '/training-calculator', 'training'),
    item('rank', '/rank-up-calculator', 'rank'),
    item('investment', '/investment-calculator', 'investment'),
    item('gauntlet', '/gauntlet-planner', 'gauntlet'),
    item('shards', '/shards-counter', 'story')
  ]},
  { id: 'live', label: tr('nav.groups.live'), links: [
    item('events', '/events', 'events'),
    item('codes', '/redeem-codes', 'codes'),
    item('centre', '/football-centre', 'centre'),
    item('tracker', '/captain-tracker', 'tracker'),
    item('trivia', '/trivia/', 'story')
  ]},
  { id: 'community', label: tr('nav.groups.community'), links: [
    item('tournaments', '/tournaments', 'tournaments'),
    item('leagues', '/leagues/', 'ovr'),
    item('giveaways', '/giveaways/', 'gift')
  ]}
];

// Strings the client-side account sync needs, already translated for this page.
const navClient = {
  account: tr('common.account'),
  login: tr('common.login'),
  myProfile: tr('common.myProfile'),
  myAccount: tr('common.myAccount'),
  accountProfile: tr('common.accountProfile'),
  accountMeta: tr('common.accountMeta'),
  profileMeta: tr('common.profileMeta'),
  levelShort: tr('common.levelShort'),
  levelLong: tr('common.levelLong'),
  signInAria: tr('common.signInAria'),
  openProfileAria: tr('common.openProfileAria'),
  profileHref: href('/profile/'),
  accountHref: href('/account/')
};

const articlesItem = item('articles', '/blog', 'articles');
const allLinks = [
  { label: tr('common.home'), href: '/', meta: tr('common.homeMeta'), icon: 'home' },
  { label: cta.label, href: cta.href, meta: cta.meta, icon: 'arrow' },
  ...navGroups.flatMap((g) => g.links.map((l) => ({ ...l, group: g.label }))),
  articlesItem
];

const groupActive = (g) => g.links.some((l) => isActive(l.href));

const icons = {
  home: '<path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9z"/>',
  ovr: '<path d="M12 3l8 4v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/>',
  training: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  playstyle: '<path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4L12 2z"/><path d="M19 15l1.1 2.9L23 19l-2.9 1.1L19 23l-1.1-2.9L15 19l2.9-1.1z"/>',
  rank: '<path d="M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.4 6.8 19.2l1-5.9L3.5 9.2l5.9-.8L12 3z"/>',
  investment: '<path d="M4 19V5M4 19h16"/><path d="M7 15l4-4 3 3 6-7"/>',
  gauntlet: '<path d="M5 4h14v6a7 7 0 01-14 0V4z"/><path d="M9 20h6M12 17v3"/>',
  events: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  codes: '<path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z"/>',
  story: '<path d="M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  tracker: '<path d="M4 19V5M4 19h16"/><path d="M8 15l3-3 3 2 5-6"/>',
  centre: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/>',
  articles: '<path d="M5 4h11l3 3v13H5z"/><path d="M9 11h6M9 15h6M9 7h3"/>',
  tournaments: '<path d="M7 3h10l-1 5a4 4 0 01-8 0L7 3z"/><path d="M7 6H4a4 4 0 004 4M17 6h3a4 4 0 01-4 4M10 12v4h4M9 20h6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  bell: '<path d="M6 8a6 6 0 0112 0c0 7 3 8 3 8H3s3-1 3-8"/><path d="M10.3 21a2 2 0 003.4 0"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M7 17L17 7M9 7h8v8"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v8a1 1 0 001 1h12a1 1 0 001-1v-8M7.5 8a2.5 2.5 0 110-5C11 3 12 8 12 8M16.5 8a2.5 2.5 0 100-5C13 3 12 8 12 8"/>'
};
const ico = (name, size = 18, sw = 1.8) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<a class="fcmt-skip" href="#content">{tr('common.skipToContent')}</a>

<header class="fcmt" id="fcmt" data-scrolled="false">
  <div class="fcmt-bar" id="fcmtBar">
    <span class="fcmt-progress" id="fcmtProgress" aria-hidden="true"><i></i></span>
    <!-- Brand -->
    <a class="fcmt-brand" href={href('/')} aria-label={tr('common.homeAria')}>
      <img class="fcmt-logo-img" src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" fetchpriority="low" />
    </a>

    <!-- Desktop nav -->
    <nav class="fcmt-nav" id="fcmtNav" aria-label={tr('common.primaryNav')}>
      <span class="fcmt-glide" id="fcmtGlide" aria-hidden="true"></span>

      <a class:list={['fcmt-link', { active: isActive('/') }]} href={href('/')} aria-current={isActive('/') ? 'page' : undefined}>{tr('common.home')}</a>

      {navGroups.map((g) => (
        <div class="fcmt-group" data-group={g.id}>
          <button class:list={['fcmt-link', 'fcmt-trigger', { active: groupActive(g) }]} type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`fcmt-mega-${g.id}`}>
            {g.label}
            <svg class="fcmt-chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div class="fcmt-mega" id={`fcmt-mega-${g.id}`} role="group" aria-label={g.label}>
            <div class="fcmt-mega-card">
              <div class="fcmt-mega-list">
                <p class="fcmt-eyebrow">{g.label}</p>
                {g.links.map((l) => (
                  <a class:list={['fcmt-item', { active: isActive(l.href) }]} href={href(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                    <span class="fcmt-ico" set:html={ico(l.icon)}></span>
                    <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.meta}</small></span>
                    <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
                  </a>
                ))}
              </div>

              <a class="fcmt-feature" href={href(cta.href)}>
                <img class="fcmt-feature-art" src={cta.image} alt="" width="520" height="300" loading="lazy" decoding="async" />
                <span class="fcmt-feature-glow" aria-hidden="true"></span>
                <span class="fcmt-feature-tag"><i></i>{tr('common.mostPopular')}</span>
                <strong>{cta.label}</strong>
                <small>{cta.blurb}</small>
                <span class="fcmt-feature-cta">{tr('common.openPage')} <span set:html={ico('arrow', 14, 2.4)}></span></span>
              </a>
            </div>
          </div>
        </div>
      ))}

      <a class:list={['fcmt-link', 'fcmt-gw', { active: current.startsWith('/giveaways') }]} href={href('/giveaways/')} aria-current={current.startsWith('/giveaways') ? 'page' : undefined}><span class="fcmt-gw-ico" set:html={ico('gift', 15, 2)}></span>{tr('nav.items.giveaways.label')}<em class="fcmt-gw-tag">{tr('common.free')}</em></a>
      <a class:list={['fcmt-link', { active: current.startsWith('/blog') }]} href={href('/blog')} aria-current={current.startsWith('/blog') ? 'page' : undefined}>{articlesItem.label}</a>
    </nav>

    <!-- Actions -->
    <div class="fcmt-actions">
      <a class="fcmt-account" id="fcmtNavAccount" href={href('/profile/')} aria-label={tr('common.openProfileAria')}>
        <span class="fcmt-acc-avatar" id="fcmtNavAvatar" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>
        </span>
        <span class="fcmt-acc-meta">
          <strong id="fcmtNavName">{tr('common.account')}</strong>
          <small id="fcmtNavLevel" hidden>Lv. 1</small>
        </span>
      </a>

      <LanguageSwitcher variant="bar" />

      <button class="fcmt-bell" id="fcPushBell" type="button" aria-label={tr('push.bell.aria')} title={tr('push.bell.title')} aria-haspopup="dialog" aria-expanded="false" data-state="idle">
        <span set:html={ico('bell', 18, 2)}></span><i class="fcmt-bell-dot" aria-hidden="true"></i>
      </button>

      <button class="fcmt-search" id="fcmtSearchBtn" type="button" aria-label={tr('common.search')} aria-haspopup="dialog">
        <span class="fcmt-search-icon" set:html={ico('search', 17, 2)}></span>
        <span class="fcmt-search-txt">{tr('common.searchPlaceholder')}</span>
        <kbd>/</kbd>
      </button>

      <div class="fcmt-acc-wrap" id="fcmtAccWrap">
      <a class:list={['fcmt-cta', 'fcmt-account-cta', { active: isActive('/profile/') || isActive('/account/') }]} id="fcmtNavAccountCta" href={href('/account/')} aria-label={tr('common.signInAria')}>
        <span class="fcmt-account-cta-avatar" id="fcmtNavAccountCtaAvatar" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>
        </span>
        <span class="fcmt-cta-txt" id="fcmtNavAccountCtaText">{tr('common.login')}</span>
        <svg class="fcmt-cta-chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </a>
        <AccountMenu />
      </div>

      <button class="fcmt-burger" id="fcmtBurger" type="button" aria-label={tr('common.openMenu')} aria-expanded="false" aria-controls="fcmtSheet">
        <span set:html={ico('menu', 20, 2)}></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile bottom tab bar -->
<nav class="fcmt-dock" aria-label={tr('common.quickNav')}>
  <a class:list={{ active: isActive('/') }} href={href('/')} aria-current={isActive('/') ? 'page' : undefined}><span set:html={ico('home', 20)}></span><em>{tr('common.home')}</em></a>
  <a class:list={{ active: isActive('/events') }} href={href('/events')} aria-current={isActive('/events') ? 'page' : undefined}><span set:html={ico('events', 20)}></span><em>{tr('common.events')}</em></a>
  <a class:list={['fcmt-dock-main', { active: isActive(cta.href) }]} href={href(cta.href)} aria-label={cta.label}><span set:html={ico('arrow', 22, 2)}></span><em>{tr('common.update')}</em></a>
  <a class:list={{ active: isActive('/redeem-codes') }} href={href('/redeem-codes')} aria-current={isActive('/redeem-codes') ? 'page' : undefined}><span set:html={ico('codes', 20)}></span><em>{tr('common.codes')}</em></a>
  <button type="button" id="fcmtDockMore" aria-label={tr('common.more')} aria-haspopup="dialog"><span set:html={ico('menu', 20)}></span><em>{tr('common.more')}</em></button>
</nav>

<!-- Full-screen mobile sheet -->
<div class="fcmt-sheet" id="fcmtSheet" role="dialog" aria-modal="true" aria-label={tr('common.siteMenu')} aria-hidden="true" inert>
  <div class="fcmt-sheet-inner">
    <div class="fcmt-sheet-head">
      <a class="fcmt-brand" href={href('/')} aria-label={tr('common.homeAria')}>
        <img class="fcmt-logo-img" src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" />
      </a>
      <button class="fcmt-x" id="fcmtSheetClose" type="button" aria-label={tr('common.closeMenu')}><span set:html={ico('close', 20, 2.2)}></span></button>
    </div>

    <a class="fcmt-hero" href={href(cta.href)}>
      <img class="fcmt-feature-art" src={cta.image} alt="" width="720" height="360" loading="lazy" decoding="async" />
      <span class="fcmt-feature-glow" aria-hidden="true"></span>
      <span class="fcmt-feature-tag"><i></i>{tr('common.mostPopular')}</span>
      <strong>{cta.label}</strong>
      <small>{cta.blurb}</small>
      <span class="fcmt-hero-arrow" set:html={ico('arrow', 18, 2.2)}></span>
    </a>
      <LanguageSwitcher variant="sheet" />

    <div class="fcmt-sheet-scroll">
      {navGroups.map((g) => (
        <section class="fcmt-sec">
          <p class="fcmt-eyebrow">{g.label}</p>
          <div class="fcmt-sec-grid">
            {g.links.map((l) => (
              <a class:list={['fcmt-tile', { active: isActive(l.href) }]} href={href(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                <span class="fcmt-ico" set:html={ico(l.icon)}></span>
                <strong>{l.label}</strong>
                <small>{l.meta}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
      <a class:list={['fcmt-wide', { active: isActive('/tournaments') }]} href={href('/tournaments')}>
        <span class="fcmt-ico" set:html={ico('tournaments')}></span>
        <span class="fcmt-item-text"><strong>{tr('nav.items.tournaments.label')}</strong><small>{tr('nav.items.tournaments.meta')}</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <a class:list={['fcmt-wide', 'fcmt-gw-wide', { active: current.startsWith('/giveaways') }]} href={href('/giveaways/')}>
        <span class="fcmt-ico" set:html={ico('gift')}></span>
        <span class="fcmt-item-text"><strong>{tr('nav.items.giveaways.label')} <em class="fcmt-gw-tag">{tr('common.free')}</em></strong><small>{tr('nav.giveawaysSheetMeta')}</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <a class:list={['fcmt-wide', { active: current.startsWith('/blog') }]} href={href('/blog')}>
        <span class="fcmt-ico" set:html={ico('articles')}></span>
        <span class="fcmt-item-text"><strong>{articlesItem.label}</strong><small>{articlesItem.meta}</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <a class="fcmt-wide fcmt-account-wide" id="fcmtSheetAccount" href={href('/profile/')}>
        <span class="fcmt-ico" id="fcmtSheetAvatar" set:html={ico('ovr')}></span>
        <span class="fcmt-item-text"><strong id="fcmtSheetName">{tr('common.accountProfile')}</strong><small id="fcmtSheetMeta">{tr('common.accountMeta')}</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <button class="fcmt-wide fcmt-wide-btn" id="fcmtSheetSearch" type="button">
        <span class="fcmt-ico" set:html={ico('search')}></span>
        <span class="fcmt-item-text"><strong>{tr('common.search')}</strong><small>{tr('common.jumpAnywhere')}</small></span>
      </button>
    </div>
  </div>
</div>

<!-- Command palette -->
<div class="fcmt-pal" id="fcmtPal" role="dialog" aria-modal="true" aria-label={tr('common.search')} aria-hidden="true" inert>
  <div class="fcmt-pal-backdrop" id="fcmtPalBackdrop"></div>
  <div class="fcmt-pal-card">
    <div class="fcmt-pal-field">
      <span set:html={ico('search', 18, 2)}></span>
      <input id="fcmtPalInput" type="text" placeholder={tr('common.searchPlaceholder')} autocomplete="off" spellcheck="false" aria-label={tr('common.search')} />
      <kbd>esc</kbd>
    </div>
    <ul class="fcmt-pal-list" id="fcmtPalList" role="listbox">
      {allLinks.map((l) => (
        <li role="option" data-label={l.label.toLowerCase()} data-meta={(l.meta + ' ' + (l.group || '')).toLowerCase()}>
          <a href={href(l.href)}>
            <span class="fcmt-ico" set:html={ico(l.icon)}></span>
            <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.group ? l.group + ' · ' : ''}{l.meta}</small></span>
            <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="fcmt-pal-empty" id="fcmtPalEmpty" hidden>{tr('common.noMatches')}</p>
  </div>
</div>

<script type="application/json" id="fcmt-nav-i18n" set:html={JSON.stringify(navClient).replace(/</g, '\\u003c')}></script>
<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const N = JSON.parse(document.getElementById('fcmt-nav-i18n').textContent);
  const root = document.documentElement;
  const header = $('fcmt');
  const nav = $('fcmtNav'), glide = $('fcmtGlide');
  const sheet = $('fcmtSheet'), burger = $('fcmtBurger'), sheetClose = $('fcmtSheetClose'), dockMore = $('fcmtDockMore'), sheetSearch = $('fcmtSheetSearch');
  const pal = $('fcmtPal'), palInput = $('fcmtPalInput'), palList = $('fcmtPalList'), palEmpty = $('fcmtPalEmpty'), palBackdrop = $('fcmtPalBackdrop'), searchBtn = $('fcmtSearchBtn');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Overlay helpers ---------- */
  let lastFocus = null;
  const lockScroll = (on) => root.classList.toggle('fcmt-lock', on);
  const openLayer = (el, focusEl) => {
    lastFocus = document.activeElement;
    el.removeAttribute('inert'); el.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => el.classList.add('open'));
    lockScroll(true);
    setTimeout(() => focusEl?.focus(), 60);
  };
  const closeLayer = (el, restore = true) => {
    el.classList.remove('open'); el.setAttribute('aria-hidden', 'true'); el.setAttribute('inert', '');
    if (!sheet.classList.contains('open') && !pal.classList.contains('open')) lockScroll(false);
    if (restore) lastFocus?.focus?.();
  };
  const trap = (el, e) => {
    if (e.key !== 'Tab' || !el.classList.contains('open')) return;
    const f = [...el.querySelectorAll('a[href],button:not([disabled]),input')].filter((n) => n.offsetParent !== null);
    if (!f.length) return;
    const a = f[0], z = f[f.length - 1];
    if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
    else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
  };

  /* ---------- Desktop mega menus ---------- */
  const groups = [...document.querySelectorAll('.fcmt-group')];
  let timer;
  const setGroup = (g, open) => { g.classList.toggle('open', open); g.querySelector('.fcmt-trigger').setAttribute('aria-expanded', String(open)); header.classList.toggle('menu-open', groups.some((x) => x.classList.contains('open'))); };
  const closeGroups = (except) => groups.forEach((g) => g !== except && setGroup(g, false));

  groups.forEach((g) => {
    const trig = g.querySelector('.fcmt-trigger');
    const items = [...g.querySelectorAll('.fcmt-item')];
    trig.addEventListener('click', () => { const o = !g.classList.contains('open'); closeGroups(g); setGroup(g, o); });
    if (canHover) {
      g.addEventListener('pointerenter', () => { clearTimeout(timer); closeGroups(g); setGroup(g, true); });
      g.addEventListener('pointerleave', () => { timer = setTimeout(() => setGroup(g, false), 160); });
    }
    trig.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); closeGroups(g); setGroup(g, true); items[0]?.focus(); } });
    items.forEach((it, i) => it.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { setGroup(g, false); trig.focus(); }
    }));
    g.addEventListener('focusout', (e) => { if (!g.contains(e.relatedTarget)) setGroup(g, false); });
  });
  document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.fcmt-group')) closeGroups(); });

  /* ---------- Glide highlight ---------- */
  const links = [...nav.querySelectorAll(':scope > .fcmt-link, :scope > .fcmt-group > .fcmt-trigger')];
  const moveGlide = (el) => {
    if (!el) { glide.style.opacity = '0'; return; }
    const n = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
    glide.style.opacity = '1'; glide.style.width = r.width + 'px'; glide.style.transform = `translateX(${r.left - n.left}px)`;
  };
  if (canHover) { links.forEach((l) => l.addEventListener('pointerenter', () => moveGlide(l))); nav.addEventListener('pointerleave', () => moveGlide(null)); }

  /* ---------- Scroll ---------- */
  let ticking = false;
  const onScroll = () => {
    const y = scrollY;
    header.dataset.scrolled = String(y > 12);
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  /* ---------- Mobile sheet ---------- */
  const openSheet = () => { burger.setAttribute('aria-expanded', 'true'); openLayer(sheet, sheetClose); };
  const closeSheet = (restore = true) => { burger.setAttribute('aria-expanded', 'false'); closeLayer(sheet, restore); };
  burger.addEventListener('click', openSheet);
  dockMore?.addEventListener('click', openSheet);
  sheetClose.addEventListener('click', () => closeSheet());
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeSheet(false)));
  sheetSearch.addEventListener('click', () => { closeSheet(false); setTimeout(openPal, 180); });

  /* ---------- Command palette ---------- */
  const rows = [...palList.querySelectorAll('li')];
  let sel = 0;
  const visible = () => rows.filter((r) => !r.hidden);
  const paint = () => { const v = visible(); v.forEach((r, i) => r.classList.toggle('sel', i === sel)); v[sel]?.scrollIntoView({ block: 'nearest' }); };
  const filter = () => {
    const q = palInput.value.trim().toLowerCase();
    rows.forEach((r) => { r.hidden = !!q && !(r.dataset.label.includes(q) || r.dataset.meta.includes(q)); });
    palEmpty.hidden = visible().length > 0; sel = 0; paint();
  };
  const openPal = () => { palInput.value = ''; filter(); openLayer(pal, palInput); };
  const closePal = () => closeLayer(pal);
  searchBtn.addEventListener('click', openPal);
  palBackdrop.addEventListener('click', closePal);
  palInput.addEventListener('input', filter);
  palList.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeLayer(pal, false)));
  palInput.addEventListener('keydown', (e) => {
    const v = visible();
    if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % Math.max(v.length, 1); paint(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + v.length) % Math.max(v.length, 1); paint(); }
    if (e.key === 'Enter' && v[sel]) { e.preventDefault(); v[sel].querySelector('a').click(); }
  });

  /* ---------- Global keys ---------- */
  document.addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
    if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); pal.classList.contains('open') ? closePal() : openPal(); }
    if (e.key === 'Escape') { if (pal.classList.contains('open')) closePal(); else if (sheet.classList.contains('open')) closeSheet(); closeGroups(); }
    trap(pal, e); trap(sheet, e);
  });

  /* Close sheet if resized to desktop */
  addEventListener('resize', () => { if (innerWidth > 980 && sheet.classList.contains('open')) closeSheet(false); moveGlide(null); });

  /* ---------- Compact Account Identity Indicator ---------- */
  const syncNavIdentity = () => {
    const navBtn = $('fcmtNavAccount');
    const navAvatar = $('fcmtNavAvatar');
    const navName = $('fcmtNavName');
    const ctaBtn = $('fcmtNavAccountCta');
    const ctaAvatar = $('fcmtNavAccountCtaAvatar');
    const ctaText = $('fcmtNavAccountCtaText');
    const navLevel = $('fcmtNavLevel');
    const sheetName = $('fcmtSheetName');
    const sheetMeta = $('fcmtSheetMeta');
    const sheetAccount = $('fcmtSheetAccount');
    const sheetAvatar = $('fcmtSheetAvatar');
    if (!navBtn || !navName) return;
    try {
      // This flag reflects Supabase's validated session, not merely the presence
      // of a possibly stale localStorage entry.
      const hasAuth = window.__FCMT_AUTHENTICATED === true;
      const raw = localStorage.getItem('fcmobiletools-identity-cache-v1');
      const identity = raw ? JSON.parse(raw) : null;
      if (hasAuth && identity && identity.username) {
        const display = String(identity.displayName || identity.username).slice(0, 16);
        const lv = Math.max(1, Number(identity.level) || 1);
        const initials = display.slice(0, 2).toUpperCase();
        navBtn.classList.add('is-authenticated');
        if (ctaBtn) {
          ctaBtn.href = N.profileHref;
          ctaBtn.setAttribute('aria-label', N.openProfileAria);
        }
        if (ctaText) ctaText.textContent = display;
        if (ctaAvatar) {
          if (identity.avatarUrl && /^https?:\/\//i.test(identity.avatarUrl)) {
            ctaAvatar.innerHTML = '';
            const img = document.createElement('img');
            img.src = identity.avatarUrl;
            img.alt = '';
            ctaAvatar.appendChild(img);
          } else {
            ctaAvatar.textContent = initials;
          }
        }
        navBtn.href = N.profileHref;
        navName.textContent = display;
        if (navLevel) {
          navLevel.textContent = N.levelShort.replace('{n}', lv);
          navLevel.hidden = false;
        }
        if (navAvatar) {
          if (identity.avatarUrl && /^https?:\/\//i.test(identity.avatarUrl)) {
            navAvatar.innerHTML = '';
            const img = document.createElement('img');
            img.src = identity.avatarUrl;
            img.alt = '';
            navAvatar.appendChild(img);
          } else {
            navAvatar.textContent = initials;
          }
        }
        if (sheetName) sheetName.textContent = display + ' · ' + N.levelLong.replace('{n}', lv);
        if (sheetMeta) sheetMeta.textContent = '@' + identity.username + ' · ' + Number(identity.xp || 0).toLocaleString() + ' XP';
        if (sheetAccount) sheetAccount.href = N.profileHref;
        if (sheetAvatar) sheetAvatar.textContent = initials;
      } else if (hasAuth) {
        // A user can have a valid session while profile details are still loading.
        // Never show a sign-in CTA for that authenticated state.
        navBtn.classList.add('is-authenticated');
        navBtn.href = N.profileHref;
        navName.textContent = N.myProfile;
        if (navLevel) navLevel.hidden = true;
        if (navAvatar) navAvatar.textContent = 'FC';
        if (ctaBtn) {
          ctaBtn.href = '/profile/';
          ctaBtn.setAttribute('aria-label', 'Open your FCMobiletools profile');
        }
        if (ctaText) ctaText.textContent = N.myProfile;
        if (ctaAvatar) ctaAvatar.textContent = 'FC';
        if (sheetAccount) sheetAccount.href = N.profileHref;
        if (sheetAvatar) sheetAvatar.textContent = 'FC';
        if (sheetName) sheetName.textContent = N.myAccount;
        if (sheetMeta) sheetMeta.textContent = N.profileMeta;
      } else {
        navBtn.classList.remove('is-authenticated');
        navBtn.href = N.accountHref;
        navName.textContent = N.account;
        if (navLevel) navLevel.hidden = true;
        if (navAvatar) navAvatar.textContent = 'FC';
        if (ctaBtn) {
          ctaBtn.href = N.accountHref;
          ctaBtn.setAttribute('aria-label', N.signInAria);
        }
        if (ctaText) ctaText.textContent = N.login;
        if (ctaAvatar) {
          ctaAvatar.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>';
        }
        if (sheetAccount) sheetAccount.href = N.accountHref;
        if (sheetAvatar) sheetAvatar.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>';
        if (sheetName) sheetName.textContent = N.accountProfile;
        if (sheetMeta) sheetMeta.textContent = N.accountMeta;
      }
    } catch {}
  };
  syncNavIdentity();
  window.addEventListener('fcmt:account-updated', syncNavIdentity);
  window.addEventListener('fcmt:nav-auth-state', syncNavIdentity);
  window.addEventListener('storage', syncNavIdentity);
})();
</script>

<script>
  import { accountAuth, accountApi, getCachedIdentity, setCachedIdentity, clearCachedIdentity } from '../lib/account-client.js';

  let authSyncVersion = 0;

  function publishAuthState(isAuthenticated) {
    window.__FCMT_AUTHENTICATED = Boolean(isAuthenticated);
    window.dispatchEvent(new Event('fcmt:nav-auth-state'));
  }

  async function hydrateIdentity(session, version) {
    if (!session?.user?.id || version !== authSyncVersion) return;
    try {
      const response = await accountApi('/api/account/me');
      const body = await response.json().catch(() => ({}));
      if (version !== authSyncVersion) return;
      if (response.ok && body?.account?.username) {
        setCachedIdentity(body.account);
      } else {
        // Keep the nav truthful even if profile details are temporarily unavailable.
        publishAuthState(true);
        console.warn('[FCMobiletools account] Session is active, but profile details could not be loaded.', response.status);
      }
    } catch (error) {
      if (version !== authSyncVersion) return;
      publishAuthState(true);
      console.warn('[FCMobiletools account] Could not refresh profile details.', error);
    }
  }

  function acceptAuthState(session, event = 'INITIAL_SESSION') {
    const version = ++authSyncVersion;
    const signedIn = Boolean(session?.user?.id);
    publishAuthState(signedIn);

    if (!signedIn) {
      clearCachedIdentity();
      return;
    }

    // Avoid showing the previous account's identity during an account switch.
    if (event === 'SIGNED_IN') clearCachedIdentity();

    // Do not call Supabase auth methods inside its own auth callback stack.
    queueMicrotask(() => { void hydrateIdentity(session, version); });
  }

  // Triggered by the account menu. onAuthStateChange below clears the cached identity.
  window.addEventListener('fcmt:sign-out', () => { accountAuth.auth.signOut().catch((error) => console.warn('[FCMobiletools account] Sign out failed.', error)); });

  accountAuth.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_OUT' || event === 'INITIAL_SESSION' || event === 'SIGNED_IN' ||
        event === 'TOKEN_REFRESHED' || event === 'USER_UPDATED') {
      acceptAuthState(session, event);
    }
  });

  accountAuth.auth.getSession().then(({ data, error }) => {
    if (error) {
      publishAuthState(false);
      return;
    }
    acceptAuthState(data?.session || null, 'SESSION_CHECK');
  }).catch(() => publishAuthState(false));
</script>

