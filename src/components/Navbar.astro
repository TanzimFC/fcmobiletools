---
const current = Astro.url.pathname;
const isActive = (href) => href === '/' ? current === '/' : current === href || current.startsWith(href + '/');

const navGroups = [
  { id: 'tools', label: 'Tools', links: [
    { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating', icon: 'ovr' },
    { label: 'Training Calculator', href: '/training-calculator', meta: 'XP planner', icon: 'training' },
    { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs', icon: 'rank' },
    { label: 'Gauntlet Planner', href: '/gauntlet-planner', meta: 'Squad rotation', icon: 'gauntlet' }
  ]},
  { id: 'live', label: 'Live', links: [
    { label: 'Events', href: '/events', meta: 'Countdowns', icon: 'events' },
    { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Latest rewards', icon: 'codes' },
    { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers', icon: 'story' }
  ]}
];

const groupActive = (group) => group.links.some((item) => isActive(item.href));

/* Inline icon paths (24x24, stroke-based) */
const icons = {
  ovr: '<path d="M12 3l8 4v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/>',
  training: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  rank: '<path d="M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.4 6.8 19.2l1-5.9L3.5 9.2l5.9-.8L12 3z"/>',
  gauntlet: '<path d="M5 4h14v6a7 7 0 01-14 0V4z"/><path d="M9 20h6M12 17v3"/>',
  events: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  codes: '<path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z"/>',
  story: '<path d="M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/><path d="M8 8h8M8 12h8M8 16h5"/>'
};
---

<header class="fcmt-header" id="fcmtHeader" data-scrolled="false" data-hidden="false">
  <div class="fcmt-progress" id="fcmtProgress" aria-hidden="true"></div>

  <div class="fcmt-header-inner wrap">
    <a class="fcmt-brand" href="/" aria-label="FCMobiletools home">
      <img src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" fetchpriority="high" />
    </a>

    <nav class="fcmt-nav" id="fcmtNav" aria-label="Primary navigation">
      <span class="fcmt-pill" id="fcmtPill" aria-hidden="true"></span>

      <a class:list={['fcmt-link', { active: isActive('/') }]} href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>

      {navGroups.map((group) => (
        <div class="fcmt-group" data-group={group.id}>
          <button
            class:list={['fcmt-link', 'fcmt-trigger', { active: groupActive(group) }]}
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls={`fcmt-panel-${group.id}`}
          >
            {group.label}
            <svg class="fcmt-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div class="fcmt-panel" id={`fcmt-panel-${group.id}`} role="group" aria-label={group.label}>
            <div class="fcmt-panel-inner">
              <p class="fcmt-panel-label">{group.label}</p>
              {group.links.map((item) => (
                <a class:list={['fcmt-item', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class="fcmt-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]}></svg>
                  </span>
                  <span class="fcmt-item-text"><strong>{item.label}</strong><small>{item.meta}</small></span>
                  <svg class="fcmt-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <a class:list={['fcmt-link', { active: current.startsWith('/blog') }]} href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>Articles</a>
    </nav>

    <button id="fcmtMenuBtn" class="fcmt-menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="fcmtDrawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="fcmtBackdrop" class="fcmt-backdrop" aria-hidden="true"></div>

  <aside id="fcmtDrawer" class="fcmt-drawer" aria-label="Mobile navigation" aria-hidden="true" inert>
    <div class="fcmt-drawer-head">
      <a class="fcmt-drawer-logo" href="/" aria-label="FCMobiletools home">
        <img src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" />
      </a>
      <button id="fcmtCloseBtn" class="fcmt-close" type="button" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav class="fcmt-drawer-body" aria-label="Mobile links">
      <a class:list={['fcmt-drow', { active: isActive('/') }]} href="/" aria-current={isActive('/') ? 'page' : undefined}>
        <span class="fcmt-drow-title">Home</span>
      </a>

      {navGroups.map((group) => (
        <section class="fcmt-acc" data-open={groupActive(group) ? 'true' : 'false'}>
          <button class="fcmt-acc-btn" type="button" aria-expanded={groupActive(group) ? 'true' : 'false'} aria-controls={`fcmt-acc-${group.id}`}>
            <span>{group.label}</span>
            <svg class="fcmt-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="fcmt-acc-body" id={`fcmt-acc-${group.id}`}>
            <div class="fcmt-acc-inner">
              {group.links.map((item) => (
                <a class:list={['fcmt-mrow', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span class="fcmt-ico">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]}></svg>
                  </span>
                  <span class="fcmt-item-text"><strong>{item.label}</strong><small>{item.meta}</small></span>
                  <svg class="fcmt-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))}

      <a class:list={['fcmt-drow', { active: current.startsWith('/blog') }]} href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>
        <span class="fcmt-drow-title">Articles</span>
      </a>
    </nav>
  </aside>
</header>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const header = $('fcmtHeader'), progress = $('fcmtProgress'), nav = $('fcmtNav'), pill = $('fcmtPill');
  const menuBtn = $('fcmtMenuBtn'), closeBtn = $('fcmtCloseBtn'), drawer = $('fcmtDrawer'), backdrop = $('fcmtBackdrop');
  const root = document.documentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Dropdowns ---------- */
  const groups = [...document.querySelectorAll('.fcmt-group')];
  let closeTimer;

  const setGroup = (group, open) => {
    group.classList.toggle('open', open);
    group.querySelector('.fcmt-trigger')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except) => groups.forEach((g) => { if (g !== except) setGroup(g, false); });

  groups.forEach((group) => {
    const trigger = group.querySelector('.fcmt-trigger');
    const items = [...group.querySelectorAll('.fcmt-item')];

    trigger.addEventListener('click', () => {
      const willOpen = !group.classList.contains('open');
      closeAll(group); setGroup(group, willOpen);
    });

    if (canHover) {
      group.addEventListener('pointerenter', () => { clearTimeout(closeTimer); closeAll(group); setGroup(group, true); });
      group.addEventListener('pointerleave', () => { closeTimer = setTimeout(() => setGroup(group, false), 140); });
    }

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); closeAll(group); setGroup(group, true); items[0]?.focus(); }
    });
    items.forEach((item, i) => item.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { setGroup(group, false); trigger.focus(); }
    }));
    group.addEventListener('focusout', (e) => { if (!group.contains(e.relatedTarget)) setGroup(group, false); });
  });

  document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.fcmt-group')) closeAll(); });

  /* ---------- Sliding pill highlight (desktop) ---------- */
  const links = [...nav.querySelectorAll(':scope > .fcmt-link, :scope > .fcmt-group > .fcmt-trigger')];
  const movePill = (el) => {
    if (!el) { pill.style.opacity = '0'; return; }
    const n = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
    pill.style.opacity = '1';
    pill.style.width = r.width + 'px';
    pill.style.transform = `translate(${r.left - n.left}px, -50%)`;
  };
  const activeLink = () => links.find((l) => l.classList.contains('active'));
  if (canHover) {
    links.forEach((l) => l.addEventListener('pointerenter', () => movePill(l)));
    nav.addEventListener('pointerleave', () => movePill(null));
  }

  /* ---------- Scroll: condense, auto-hide, progress ---------- */
  let lastY = window.scrollY, ticking = false;
  const onScroll = () => {
    const y = window.scrollY;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    header.dataset.scrolled = String(y > 8);
    progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;

    const drawerOpen = drawer.classList.contains('open');
    const anyOpen = groups.some((g) => g.classList.contains('open'));
    if (!drawerOpen && !anyOpen && window.innerWidth <= 980) {
      if (y > lastY + 6 && y > 140) header.dataset.hidden = 'true';
      else if (y < lastY - 6 || y < 140) header.dataset.hidden = 'false';
    } else header.dataset.hidden = 'false';
    lastY = y; ticking = false;
  };
  window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(onScroll); ticking = true; } }, { passive: true });
  onScroll();

  /* ---------- Mobile drawer ---------- */
  let lastFocus = null;
  const focusables = () => [...drawer.querySelectorAll('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null);

  const setOpen = (open) => {
    drawer.classList.toggle('open', open);
    backdrop.classList.toggle('open', open);
    drawer.setAttribute('aria-hidden', String(!open));
    backdrop.setAttribute('aria-hidden', String(!open));
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) { drawer.removeAttribute('inert'); lastFocus = document.activeElement; setTimeout(() => closeBtn.focus(), 60); }
    else { drawer.setAttribute('inert', ''); lastFocus?.focus?.(); }
    root.classList.toggle('fcmt-menu-open', open);
    header.dataset.hidden = 'false';
  };

  menuBtn.addEventListener('click', () => setOpen(!drawer.classList.contains('open')));
  closeBtn.addEventListener('click', () => setOpen(false));
  backdrop.addEventListener('click', () => setOpen(false));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { setOpen(false); closeAll(); }
    if (e.key === 'Tab' && drawer.classList.contains('open')) {
      const f = focusables(); if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  /* Accordion */
  drawer.querySelectorAll('.fcmt-acc').forEach((acc) => {
    const btn = acc.querySelector('.fcmt-acc-btn');
    btn.addEventListener('click', () => {
      const open = acc.dataset.open !== 'true';
      acc.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  /* Swipe right to close */
  let sx = 0, sy = 0, dx = 0, dragging = false;
  drawer.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; dx = 0; dragging = true; drawer.style.transition = 'none'; }, { passive: true });
  drawer.addEventListener('touchmove', (e) => {
    if (!dragging) return;
    const mx = e.touches[0].clientX - sx, my = e.touches[0].clientY - sy;
    if (Math.abs(my) > Math.abs(mx)) return;
    dx = Math.max(0, mx); drawer.style.transform = `translateX(${dx}px)`;
  }, { passive: true });
  drawer.addEventListener('touchend', () => {
    if (!dragging) return; dragging = false;
    drawer.style.transition = ''; drawer.style.transform = '';
    if (dx > 90) setOpen(false);
  });

  /* Close drawer if resized up to desktop */
  window.addEventListener('resize', () => { if (window.innerWidth > 980 && drawer.classList.contains('open')) setOpen(false); movePill(null); });
})();
</script>

<style>
/* ============ Header shell ============ */
.fcmt-header{
  --h: 68px;
  position:sticky;top:0;z-index:1200;
  background:linear-gradient(180deg,rgba(9,19,29,.82),rgba(7,16,24,.72));
  backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:0 1px 0 rgba(255,255,255,.03) inset;
  transition:transform .34s cubic-bezier(.2,.8,.2,1),background .25s ease,box-shadow .25s ease;
  padding-top:env(safe-area-inset-top,0);
}
.fcmt-header[data-scrolled="true"]{background:linear-gradient(180deg,rgba(8,17,26,.94),rgba(7,16,24,.88));box-shadow:0 12px 40px rgba(0,0,0,.34)}
.fcmt-header[data-hidden="true"]{transform:translateY(-100%)}
.fcmt-header-inner{min-height:var(--h);display:flex;align-items:center;gap:20px;transition:min-height .25s ease}
.fcmt-header[data-scrolled="true"] .fcmt-header-inner{min-height:60px}

.fcmt-progress{position:absolute;left:0;right:0;bottom:-1px;height:2px;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,transparent,var(--primary) 30%,#8fe3ff);box-shadow:0 0 14px rgba(76,201,255,.5);opacity:.9;pointer-events:none}

/* ============ Brand ============ */
.fcmt-brand{display:flex;align-items:center;width:210px;height:52px;flex:0 0 auto;border-radius:10px}
.fcmt-brand img{width:100%;height:100%;object-fit:contain;object-position:left center;filter:drop-shadow(0 6px 16px rgba(0,0,0,.35));transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.fcmt-brand:hover img{transform:translateY(-1px) scale(1.02)}
.fcmt-header[data-scrolled="true"] .fcmt-brand{height:46px}

/* ============ Desktop nav ============ */
.fcmt-nav{position:relative;display:flex;align-items:center;gap:2px;margin-left:auto;padding:5px;border:1px solid rgba(255,255,255,.06);border-radius:16px;background:rgba(255,255,255,.025)}
.fcmt-pill{position:absolute;left:0;top:50%;height:calc(100% - 10px);width:0;border-radius:11px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);opacity:0;pointer-events:none;transition:transform .28s cubic-bezier(.2,.8,.2,1),width .28s cubic-bezier(.2,.8,.2,1),opacity .2s ease;z-index:0}

.fcmt-link{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:0 15px;border:0;border-radius:11px;background:transparent;color:var(--muted);font:700 13.5px/1 var(--font-body);letter-spacing:.005em;text-decoration:none;cursor:pointer;transition:color .18s ease}
.fcmt-link:hover,.fcmt-group.open>.fcmt-trigger{color:var(--text)}
.fcmt-link.active{color:var(--text)}
.fcmt-link.active::after{content:"";position:absolute;left:50%;bottom:5px;width:16px;height:2px;margin-left:-8px;border-radius:99px;background:var(--primary);box-shadow:0 0 10px rgba(76,201,255,.55)}
.fcmt-link:focus-visible,.fcmt-item:focus-visible,.fcmt-menu:focus-visible,.fcmt-close:focus-visible,.fcmt-acc-btn:focus-visible,.fcmt-drow:focus-visible,.fcmt-mrow:focus-visible,.fcmt-brand:focus-visible,.fcmt-drawer-logo:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

.fcmt-group{position:relative}
.fcmt-chev{color:var(--muted-strong);transition:transform .22s cubic-bezier(.2,.8,.2,1)}
.fcmt-group.open .fcmt-chev{transform:rotate(180deg);color:var(--primary)}

/* ============ Dropdown panel ============ */
.fcmt-panel{position:absolute;top:100%;left:50%;width:322px;padding-top:14px;transform:translate(-50%,6px) scale(.985);transform-origin:top center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,transform .22s cubic-bezier(.2,.8,.2,1),visibility 0s linear .22s}
.fcmt-group.open .fcmt-panel{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0) scale(1);transition-delay:0s}
.fcmt-panel-inner{position:relative;padding:8px;border:1px solid rgba(255,255,255,.09);border-radius:20px;background:linear-gradient(180deg,rgba(18,31,45,.985),rgba(11,21,31,.985));box-shadow:0 30px 80px rgba(0,0,0,.55),0 2px 0 rgba(255,255,255,.04) inset}
.fcmt-panel-inner::before{content:"";position:absolute;top:-6px;left:50%;width:12px;height:12px;margin-left:-6px;transform:rotate(45deg);border-top:1px solid rgba(255,255,255,.09);border-left:1px solid rgba(255,255,255,.09);border-radius:3px 0 0 0;background:rgba(18,31,45,.985)}
.fcmt-panel-label{margin:0;padding:10px 12px 8px;color:var(--primary);font:800 10px/1 var(--font-body);letter-spacing:.18em;text-transform:uppercase}

.fcmt-item,.fcmt-mrow{position:relative;display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid transparent;border-radius:14px;color:var(--muted);text-decoration:none;transition:background .16s ease,border-color .16s ease,color .16s ease}
.fcmt-item:hover,.fcmt-item:focus-visible,.fcmt-item.active,.fcmt-mrow:hover,.fcmt-mrow.active{color:var(--text);background:rgba(76,201,255,.07);border-color:rgba(76,201,255,.13)}
.fcmt-ico{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:11px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.04);color:var(--muted-strong);transition:.18s ease}
.fcmt-item:hover .fcmt-ico,.fcmt-item.active .fcmt-ico,.fcmt-mrow:hover .fcmt-ico,.fcmt-mrow.active .fcmt-ico{color:var(--primary);background:rgba(76,201,255,.11);border-color:rgba(76,201,255,.22);box-shadow:0 0 18px rgba(76,201,255,.14)}
.fcmt-item-text{flex:1;min-width:0}
.fcmt-item-text strong,.fcmt-item-text small{display:block}
.fcmt-item-text strong{font:700 13.5px/1.25 var(--font-body)}
.fcmt-item-text small{margin-top:3px;font:500 11.5px/1.2 var(--font-body);color:#748596}
.fcmt-arrow{flex:0 0 auto;color:#5d7081;opacity:0;transform:translate(-4px,0);transition:.18s ease}
.fcmt-item:hover .fcmt-arrow,.fcmt-item:focus-visible .fcmt-arrow,.fcmt-mrow:hover .fcmt-arrow{opacity:1;transform:none;color:var(--primary)}
.fcmt-item.active .fcmt-arrow,.fcmt-mrow.active .fcmt-arrow{opacity:1;transform:none;color:var(--primary)}

/* ============ Hamburger ============ */
.fcmt-menu{display:none;position:relative;width:46px;height:46px;flex:0 0 46px;margin-left:auto;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;transition:background .18s ease,border-color .18s ease,transform .18s ease;-webkit-tap-highlight-color:transparent}
.fcmt-menu:active{transform:scale(.94)}
.fcmt-menu:hover{background:rgba(255,255,255,.07);border-color:rgba(76,201,255,.28)}
.fcmt-menu span{position:absolute;left:50%;width:18px;height:2px;margin-left:-9px;border-radius:99px;background:currentColor;transition:transform .28s cubic-bezier(.2,.8,.2,1),opacity .18s ease,width .2s ease}
.fcmt-menu span:nth-child(1){top:16px}
.fcmt-menu span:nth-child(2){top:22px;width:12px;margin-left:-9px;margin-left:-9px}
.fcmt-menu span:nth-child(3){top:28px}
.fcmt-menu[aria-expanded="true"] span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.fcmt-menu[aria-expanded="true"] span:nth-child(2){opacity:0;transform:translateX(8px)}
.fcmt-menu[aria-expanded="true"] span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

/* ============ Backdrop + Drawer ============ */
.fcmt-backdrop{position:fixed;inset:0;z-index:1290;background:rgba(2,8,13,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0;pointer-events:none;transition:opacity .28s ease}
.fcmt-backdrop.open{opacity:1;pointer-events:auto}

.fcmt-drawer{
  position:fixed;top:0;right:0;z-index:1300;width:min(400px,90vw);height:100dvh;
  display:flex;flex-direction:column;
