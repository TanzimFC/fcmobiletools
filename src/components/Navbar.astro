.fcmt-feature::after,.fcmt-hero::after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,rgba(5,12,18,.05) 0%,rgba(5,12,18,.18) 26%,rgba(5,12,18,.88) 100%);pointer-events:none}
