---
const groups = [
  {
    label: 'Tools',
    links: [
      { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating' },
      { label: 'Training Calculator', href: '/training-calculator', meta: 'XP & fodder' },
      { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs' },
      { label: 'Investment Calculator', href: '/investment-calculator', meta: 'Market planning' }
    ]
  },
  {
    label: 'Live',
    links: [
      { label: 'Events & Reset', href: '/events', meta: 'Countdowns & schedules' },
      { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Current rewards' },
      { label: 'Football Centre', href: '/football-centre', meta: 'Matches & points' },
      { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers' },
      { label: 'FC Mobile 27 APK', href: '/fc-mobile-27', meta: 'Latest Android release' }
    ]
  }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
const groupIsActive = (group) => group.links.some((link) => isActive(link.href));
---
<header class="site-nav" data-site-nav>
  <div class="site-nav-inner">
    <a class="site-logo" href="/" aria-label="FCMOBILETOOLS home">
      <img src="/assets/images/logo.png" alt="FCMOBILETOOLS" />
    </a>

    <nav class="site-primary" aria-label="Primary navigation">
      <a class="site-link" href="/" class:list={{ active: currentPath === '/' }}>Home</a>

      {groups.map((group) => (
        <div class="site-group" data-nav-group>
          <button class="site-dropdown-trigger" type="button" aria-expanded="false" aria-haspopup="true" class:list={{ active: groupIsActive(group) }}>
            <span>{group.label}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3.5 4.5 2.5 2.5 2.5-2.5" /></svg>
          </button>

          <div class="site-dropdown" role="menu">
            {group.links.map((link) => (
              <a href={link.href} role="menuitem" class:list={{ active: isActive(link.href) }}>
                <span>
                  <strong>{link.label}</strong>
                  <small>{link.meta}</small>
                </span>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </div>
      ))}

      <a class="site-link" href="/blog" class:list={{ active: isActive('/blog') }}>Articles</a>
      <a class="site-link" href="/creator" class:list={{ active: isActive('/creator') }}>Creator</a>

      <a class="site-cta" href="/redeem-codes" class:list={{ active: isActive('/redeem-codes') }}>
        <i aria-hidden="true"></i>
        <span>Redeem Codes</span>
      </a>
    </nav>

    <button class="site-menu" type="button" aria-expanded="false" aria-controls="site-mobile-nav" aria-label="Open menu"><span class="site-menu-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
  </div>

  <nav id="site-mobile-nav" class="site-mobile-nav" aria-label="Mobile navigation">
    <a href="/" class:list={{ active: currentPath === '/' }}>Home</a>

    {groups.map((group) => (
      <div class="site-mobile-group">
        <strong>{group.label.toUpperCase()}</strong>
        {group.links.map((link) => (
          <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>
        ))}
      </div>
    ))}

    <a href="/blog" class:list={{ active: isActive('/blog') }}>Articles</a>
    <a href="/creator" class:list={{ active: isActive('/creator') }}>Creator</a>
    <a class="mobile-code" href="/redeem-codes" class:list={{ active: isActive('/redeem-codes') }}>
      <i aria-hidden="true"></i><span>Redeem Codes</span>
    </a>
  </nav>
</header>

<script>
const nav = document.querySelector('[data-site-nav]');
const menuButton = nav?.querySelector('.site-menu');
const mobile = nav?.querySelector('.site-mobile-nav');

const setGroupState = (group, open) => {
  const trigger = group.querySelector('.site-dropdown-trigger');
  group.classList.toggle('open', open);
  trigger?.setAttribute('aria-expanded', String(open));
};

nav?.querySelectorAll('.site-group').forEach((group) => {
  const trigger = group.querySelector('.site-dropdown-trigger');
  trigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = !group.classList.contains('open');
    nav.querySelectorAll('.site-group').forEach((other) => {
      if (other !== group) setGroupState(other, false);
    });
    setGroupState(group, open);
  });
});

document.addEventListener('click', (event) => {
  if (!nav?.contains(event.target)) {
    nav?.querySelectorAll('.site-group').forEach((group) => setGroupState(group, false));
  }
});

document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  nav?.querySelectorAll('.site-group').forEach((group) => setGroupState(group, false));
  if (mobile?.classList.contains('open')) {
    mobile.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open menu');
  }
});

menuButton?.addEventListener('click', () => {
  const open = mobile?.classList.toggle('open') ?? false;
  menuButton.setAttribute('aria-expanded', String(open));
  menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
});

mobile?.querySelectorAll('a').forEach((link) => {
  link.addEventListener('click', () => {
    mobile.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open menu');
  });
});

const updateScrolledState = () => nav?.classList.toggle('is-scrolled', window.scrollY > 10);
updateScrolledState();
window.addEventListener('scroll', updateScrolledState, { passive: true });
</script>
