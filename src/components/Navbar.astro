---
const current = Astro.url.pathname;

const navGroups = [
  {
    label: 'Tools',
    links: [
      { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating' },
      { label: 'Training Calculator', href: '/training-calculator', meta: 'XP planner' },
      { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs' },
      { label: 'Gauntlet Planner', href: '/gauntlet-planner', meta: 'Squad rotation' }
    ]
  },
  {
    label: 'Live',
    links: [
      { label: 'Events', href: '/events', meta: 'Countdowns' },
      { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Latest rewards' },
      { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers' }
    ]
  }
];
---

<header class="site-nav-shell">
  <div class="site-nav wrap">
    <a class="brand" href="/">
      <img src="/assets/images/logo.png" alt="TanzimFC" />
    </a>

    <nav class="desktop-nav">
      <a class={current === '/' ? 'active' : ''} href="/">Home</a>

      {navGroups.map((group) => (
        <div class="dropdown">
          <button>{group.label}</button>

          <div class="menu">
            {group.links.map((item) => (
              <a href={item.href}>
                <div>
                  <strong>{item.label}</strong>
                  <small>{item.meta}</small>
                </div>
                <span>↗</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <a href="/blog">Articles</a>
    </nav>

    <button id="menuBtn" class="menu-btn" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobilePanel" class="mobile-panel">
    <div class="mobile-top">
      <img src="/assets/images/logo.png" alt="TanzimFC" />
      <button id="closeBtn">✕</button>
    </div>

    <a href="/">Home</a>

    <div class="mobile-group">
      <b>TOOLS</b>
      <a href="/team-ovr">Team OVR</a>
      <a href="/training-calculator">Training Calculator</a>
      <a href="/rank-up-calculator">Rank Up Calculator</a>
      <a href="/gauntlet-planner">Gauntlet Planner</a>
    </div>

    <div class="mobile-group">
      <b>LIVE</b>
      <a href="/events">Events</a>
      <a href="/redeem-codes">Redeem Codes</a>
      <a href="/a-nations-story">A Nation's Story</a>
    </div>

    <a href="/blog">Articles</a>
  </div>
</header>

<script is:inline>
const btn=document.getElementById('menuBtn');
const close=document.getElementById('closeBtn');
const panel=document.getElementById('mobilePanel');

btn?.addEventListener('click',()=>panel.classList.add('open'));
close?.addEventListener('click',()=>panel.classList.remove('open'));

document.addEventListener('click',(e)=>{
  if(panel.classList.contains('open') &&
    !panel.contains(e.target) &&
    !btn.contains(e.target)){
      panel.classList.remove('open');
  }
});
</script>

<style>
.site-nav-shell{
position:sticky;
top:0;
z-index:1000;
backdrop-filter:blur(18px);
background:rgba(7,16,24,.72);
border-bottom:1px solid rgba(255,255,255,.06);
}

.site-nav{
display:flex;
align-items:center;
justify-content:space-between;
height:84px;
}

.brand img{
height:52px;
width:auto;
display:block;
transition:.25s;
}

.brand:hover img{
transform:scale(1.03);
}

.desktop-nav{
display:flex;
align-items:center;
gap:22px;
}

.desktop-nav>a,
.dropdown>button{
background:none;
border:0;
color:#eaf5ff;
font:600 15px Inter,sans-serif;
cursor:pointer;
text-decoration:none;
position:relative;
}

.desktop-nav>a::after,
.dropdown>button::after{
content:"";
position:absolute;
left:0;
bottom:-8px;
width:0;
height:2px;
background:#4CC9FF;
transition:.25s;
}

.desktop-nav>a:hover::after,
.dropdown>button:hover::after,
.desktop-nav>a.active::after{
width:100%;
}

.dropdown{
position:relative;
}

.menu{
position:absolute;
top:54px;
left:50%;
transform:translateX(-50%) translateY(10px);
width:260px;
background:#101a27;
border:1px solid rgba(255,255,255,.08);
border-radius:18px;
padding:8px;
opacity:0;
pointer-events:none;
transition:.2s;
box-shadow:0 30px 80px rgba(0,0,0,.45);
}

.dropdown:hover .menu{
opacity:1;
pointer-events:auto;
transform:translateX(-50%) translateY(0);
}

.menu a{
display:flex;
justify-content:space-between;
align-items:center;
padding:12px;
border-radius:12px;
text-decoration:none;
color:white;
}

.menu a:hover{
background:rgba(76,201,255,.08);
}

.menu strong{
display:block;
font-size:14px;
}

.menu small{
color:#9fb1c2;
font-size:12px;
}

.menu-btn{
display:none;
width:46px;
height:46px;
border-radius:14px;
background:#111b29;
border:1px solid rgba(255,255,255,.08);
}

.menu-btn span{
display:block;
height:2px;
background:white;
margin:6px 10px;
}

.mobile-panel{
position:fixed;
top:0;
right:-100%;
width:min(360px,88vw);
height:100vh;
background:#071018;
padding:24px;
transition:.3s;
box-shadow:-20px 0 80px rgba(0,0,0,.45);
overflow:auto;
}

.mobile-panel.open{
right:0;
}

.mobile-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:24px;
}

.mobile-top img{
height:48px;
}

.mobile-top button{
background:none;
border:0;
color:white;
font-size:28px;
}

.mobile-panel>a,
.mobile-group a{
display:block;
padding:12px 0;
color:white;
text-decoration:none;
}

.mobile-group{
margin-top:22px;
}

.mobile-group b{
display:block;
margin-bottom:10px;
color:#4CC9FF;
font-size:12px;
letter-spacing:.15em;
}

@media(max-width:920px){
.desktop-nav{
display:none;
}

.menu-btn{
display:block;
}
}
</style>
