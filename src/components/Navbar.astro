.fcmt-nav+.fcmt-actions{margin-left:0}
.fcmt-bell{position:relative;display:grid;place-items:center;flex:0 0 42px;width:42px;height:42px;border:1px solid rgba(255,255,255,.09);border-radius:13px;background:rgba(255,255,255,.035);color:var(--muted-strong,#b7c4d1);cursor:pointer;transition:color .2s,background .2s,border-color .2s}
.fcmt-bell:hover{color:var(--text);background:rgba(255,255,255,.07);border-color:rgba(76,201,255,.3)}
.fcmt-bell[hidden]{display:none}
.fcmt-bell-dot{position:absolute;top:9px;right:10px;width:8px;height:8px;border-radius:50%;background:transparent}
.fcmt-bell[data-state="invite"]{color:#8fe3ff;border-color:rgba(76,201,255,.35)}
.fcmt-bell[data-state="invite"] .fcmt-bell-dot{background:#4cc9ff;box-shadow:0 0 0 0 rgba(76,201,255,.6);animation:fcmt-bell-pulse 2.2s ease-out infinite}
.fcmt-bell[data-state="on"] .fcmt-bell-dot{background:#47d16c;box-shadow:none}
@keyframes fcmt-bell-pulse{0%{box-shadow:0 0 0 0 rgba(76,201,255,.6)}70%,100%{box-shadow:0 0 0 9px rgba(76,201,255,0)}}
.fcmt-search{display:inline-flex;align-items:center;gap:10px;width:222px;height:42px;padding:0 9px 0 13px;border:1px solid rgba(255,255,255,.09);border-radius:13px;background:rgba(255,255,255,.035);color:var(--muted);font:600 12px/1 var(--font-body);cursor:pointer;transition:width .25s ease,color .2s ease,background .2s ease,border-color .2s ease,box-shadow .2s ease}
.fcmt-search:hover{color:var(--text);background:rgba(255,255,255,.06);border-color:rgba(76,201,255,.3);box-shadow:0 8px 24px rgba(0,0,0,.16)}
.fcmt-search-icon{display:grid;place-items:center;flex:0 0 auto;color:var(--muted-strong)}
.fcmt-search-txt{flex:1;min-width:0;padding-right:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
kbd{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:var(--muted-strong);font:700 12px/1 var(--font-body)}

.fcmt-cta{position:relative;isolation:isolate;display:inline-flex;align-items:center;gap:10px;height:42px;padding:0 18px 0 15px;border-radius:14px;overflow:hidden;color:#03131c;text-decoration:none;font:800 13px/1 var(--font-body);letter-spacing:-.005em;background:#8fe3ff;box-shadow:none;transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s}
.fcmt-cta::after{content:"";position:absolute;z-index:-1;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:fcmt-sheen 4.5s ease-in-out infinite}
@keyframes fcmt-sheen{0%,55%{left:-60%}100%{left:130%}}
.fcmt-cta:hover{transform:translateY(-1px);box-shadow:none}
.fcmt-cta:active{transform:scale(.97)}
.fcmt-pulse{position:relative;width:8px;height:8px;border-radius:50%;background:#04202f}
.fcmt-pulse::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1.5px solid rgba(4,32,47,.55);animation:fcmt-ring 1.8s ease-out infinite}
@keyframes fcmt-ring{from{transform:scale(.5);opacity:1}to{transform:scale(1.5);opacity:0}}

.fcmt-burger,.fcmt-x{display:none;place-items:center;width:44px;height:44px;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.045);color:var(--text);cursor:pointer;transition:.2s;-webkit-tap-highlight-color:transparent}
.fcmt-burger:active,.fcmt-x:active{transform:scale(.93)}

/* ================= Mobile dock ================= */
.fcmt-dock{display:none}

/* ================= Full-screen sheet ================= */
.fcmt-sheet{position:fixed;inset:0;z-index:1500;visibility:hidden;opacity:0;background:rgba(3,9,14,.5);backdrop-filter:blur(0);transition:opacity .28s ease,visibility 0s linear .32s,backdrop-filter .3s}
.fcmt-sheet.open{visibility:visible;opacity:1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition-delay:0s}
.fcmt-sheet-inner{position:absolute;left:0;right:0;bottom:0;top:calc(env(safe-area-inset-top,0) + 10px);display:flex;flex-direction:column;padding:14px 16px calc(18px + env(safe-area-inset-bottom,0));border-radius:28px 28px 0 0;border:1px solid rgba(255,255,255,.09);border-bottom:0;background:#111e2c;box-shadow:0 -30px 90px rgba(0,0,0,.6);transform:translateY(100%);transition:transform .42s cubic-bezier(.2,.8,.2,1)}
.fcmt-sheet.open .fcmt-sheet-inner{transform:translateY(0)}
.fcmt-sheet-inner::before{content:"";position:absolute;top:8px;left:50%;width:38px;height:4px;margin-left:-19px;border-radius:99px;background:rgba(255,255,255,.18)}
.fcmt-sheet-head{display:flex;align-items:center;justify-content:space-between;padding:12px 0 14px}
.fcmt-x{display:grid}
.fcmt-hero{min-height:132px;margin-bottom:6px}
.fcmt-hero-arrow{position:absolute;top:16px;right:16px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(76,201,255,.16);color:var(--primary)}
.fcmt-sheet-scroll{flex:1;overflow-y:auto;overscroll-behavior:contain;padding-bottom:8px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.fcmt-sheet-scroll::-webkit-scrollbar{display:none}
.fcmt-sec-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fcmt-tile{display:flex;flex-direction:column;gap:3px;padding:14px;border-radius:14px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.035);text-decoration:none;color:var(--muted);-webkit-tap-highlight-color:transparent;transition:.2s}
.fcmt-tile .fcmt-ico{margin-bottom:10px}
.fcmt-tile strong{font:700 13.5px/1.25 var(--font-body);color:var(--text)}
.fcmt-tile small{font:500 12px/1.25 var(--font-body);color:#748596}
.fcmt-tile:active,.fcmt-tile.active{background:rgba(76,201,255,.09);border-color:rgba(76,201,255,.25)}
.fcmt-wide{width:100%;margin-top:8px;padding:12px 14px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.035);text-align:left;font-family:inherit;cursor:pointer}
.fcmt-wide.active{border-color:rgba(76,201,255,.25);background:rgba(76,201,255,.08)}
.fcmt-wide .fcmt-go{opacity:.6;transform:none}
.fcmt-sheet .fcmt-sec-grid>*,.fcmt-sheet .fcmt-hero,.fcmt-sheet .fcmt-wide{opacity:0;transform:translateY(14px);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
.fcmt-sheet.open .fcmt-sec-grid>*,.fcmt-sheet.open .fcmt-hero,.fcmt-sheet.open .fcmt-wide{opacity:1;transform:none}
.fcmt-sheet.open .fcmt-hero{transition-delay:.12s}
.fcmt-sheet.open .fcmt-sec:nth-child(1) .fcmt-sec-grid>*{transition-delay:.18s}
.fcmt-sheet.open .fcmt-sec:nth-child(2) .fcmt-sec-grid>*{transition-delay:.26s}
.fcmt-sheet.open .fcmt-wide{transition-delay:.32s}

/* ================= Command palette ================= */
.fcmt-pal{position:fixed;inset:0;z-index:1600;display:grid;place-items:start center;padding:12vh 16px 16px;visibility:hidden;opacity:0;transition:opacity .2s ease,visibility 0s linear .2s}
.fcmt-pal.open{visibility:visible;opacity:1;transition-delay:0s}
.fcmt-pal-backdrop{position:absolute;inset:0;background:rgba(2,8,13,.62);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.fcmt-pal-card{position:relative;width:min(560px,100%);overflow:hidden;border-radius:14px;border:1px solid rgba(255,255,255,.11);background:rgba(20,34,49,.98);box-shadow:0 50px 120px -10px rgba(0,0,0,.8);transform:translateY(-10px) scale(.98);transition:transform .3s cubic-bezier(.2,.8,.2,1)}
.fcmt-pal.open .fcmt-pal-card{transform:none}
.fcmt-pal-field{display:flex;align-items:center;gap:12px;padding:0 16px;height:60px;border-bottom:1px solid rgba(255,255,255,.08);color:var(--muted-strong)}
.fcmt-pal-field input{flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;color:var(--text);font:600 16px/1 var(--font-body)}
.fcmt-pal-field input::placeholder{color:#5f7385}
.fcmt-pal-list{list-style:none;margin:0;padding:8px;max-height:min(52vh,420px);overflow-y:auto}
.fcmt-pal-list li{border-radius:14px}
.fcmt-pal-list li[hidden]{display:none}
.fcmt-pal-list a{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:14px;color:var(--muted);text-decoration:none}
.fcmt-pal-list li.sel a{background:rgba(76,201,255,.09);color:var(--text)}
.fcmt-pal-list li.sel .fcmt-go{opacity:1;transform:none;color:var(--primary)}
.fcmt-pal-empty{margin:0;padding:26px 16px 30px;text-align:center;color:#748596;font:600 13px/1.4 var(--font-body)}

/* Focus rings */
.fcmt-link:focus-visible,.fcmt-item:focus-visible,.fcmt-search:focus-visible,.fcmt-cta:focus-visible,.fcmt-burger:focus-visible,.fcmt-x:focus-visible,.fcmt-brand:focus-visible,.fcmt-tile:focus-visible,.fcmt-wide:focus-visible,.fcmt-dock a:focus-visible,.fcmt-dock button:focus-visible,.fcmt-feature:focus-visible,.fcmt-hero:focus-visible,.fcmt-pal-list a:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

/* ================= Responsive ================= */
@media(max-width:1120px){.fcmt-search{width:190px}.fcmt-search-txt{font-size:12px}.fcmt-link{padding:0 12px}.fcmt-bar{gap:12px}}
@media(max-width:1020px){.fcmt-search{width:178px}.fcmt-cta-txt{display:none}.fcmt-cta{padding:0 14px}}

@media(max-width:980px){
  .fcmt-bar{
    height:58px;
    margin-top:10px;
    width:calc(100% - 24px);
    border-radius:14px;
    justify-content:space-between;
    gap:0;
    padding:0 7px;
  }
  .fcmt[data-scrolled="true"] .fcmt-bar{width:calc(100% - 24px);height:54px}
  .fcmt-nav,.fcmt-cta{display:none}
  .fcmt-actions{display:contents}
  .fcmt-burger{order:1;display:grid;width:42px;height:42px;flex:0 0 42px}
  .fcmt-brand{order:2;position:absolute;left:50%;transform:translateX(-50%);padding:4px}
  .fcmt-logo-img{height:46px;max-width:140px}
  .fcmt-search{
    order:3;
    display:grid;
    place-items:center;
    width:42px;
    height:42px;
    flex:0 0 42px;
    padding:0;
    border-radius:13px;
  }
  .fcmt-search{margin-left:auto}
  .fcmt-bell{order:4;margin-left:6px}
  .fcmt-search-txt,.fcmt-search kbd{display:none}
  .fcmt-search-icon{color:var(--muted-strong)}

  /* Thumb-reach dock */
  .fcmt-dock{position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom,0));z-index:1250;transform:translateX(-50%);display:flex;align-items:center;gap:2px;width:min(420px,calc(100% - 24px));height:66px;padding:0 8px;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:rgba(20,34,49,.82);backdrop-filter:blur(26px) saturate(170%);-webkit-backdrop-filter:blur(26px) saturate(170%);box-shadow:0 20px 50px -8px rgba(0,0,0,.7)}
  .fcmt-dock a,.fcmt-dock button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;height:52px;border:0;border-radius:16px;background:transparent;color:#7d8fa0;font-family:inherit;text-decoration:none;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:color .2s,background .2s,transform .15s}
  .fcmt-dock em{font:700 12px/1 var(--font-body);font-style:normal;letter-spacing:.02em}
  .fcmt-dock a:active,.fcmt-dock button:active{transform:scale(.92)}
  .fcmt-dock a.active{color:var(--primary);background:rgba(76,201,255,.09)}
  .fcmt-dock .fcmt-dock-main{flex:0 0 58px;height:58px;margin:-18px 4px 0;border-radius:14px;color:#03131c;background:#8fe3ff;box-shadow:0 0 0 5px rgba(9,18,27,.9)}
  .fcmt-dock .fcmt-dock-main.active{color:#03131c;background:#8fe3ff}
  .fcmt-dock .fcmt-dock-main em{font-weight:800}

  /* Leave room so the dock never covers page content or the footer */
  body{padding-bottom:calc(92px + env(safe-area-inset-bottom,0))}
}
@media(max-width:380px){.fcmt-logo-img{height:44px;max-width:140px}.fcmt-sheet .fcmt-logo-img{height:44px;max-width:142px}.fcmt-sec-grid{gap:6px}.fcmt-tile{padding:12px}}

@media(prefers-reduced-motion:reduce){
  .fcmt *,.fcmt-sheet,.fcmt-sheet *,.fcmt-pal,.fcmt-pal *,.fcmt-dock,.fcmt-dock *{animation:none!important;transition-duration:.01ms!important;transition-delay:0s!important}
}
@media(forced-colors:active){.fcmt-bar,.fcmt-mega-card,.fcmt-sheet-inner,.fcmt-pal-card,.fcmt-dock{border:1px solid CanvasText}.fcmt-link.active::after{background:Highlight}}
</style>

<style is:global>
/* ============ Premium polish layer ============ */
/* Reading-progress hairline along the bottom edge of the bar */
.fcmt-progress{position:absolute;left:22px;right:22px;bottom:-1px;height:2px;border-radius:99px;overflow:hidden;pointer-events:none;opacity:0;transition:opacity .3s}
.fcmt[data-scrolled="true"] .fcmt-progress{opacity:1}
.fcmt-progress i{display:block;width:100%;height:100%;transform-origin:left center;transform:scaleX(var(--fcmt-p,0));background:linear-gradient(90deg,rgba(76,201,255,0),#4cc9ff 30%,#9a8cff);box-shadow:none}
/* Slow light sweep across the top edge of the bar */
.fcmt-bar::after{content:"";position:absolute;left:0;right:0;top:0;height:1px;border-radius:inherit;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55) 50%,transparent);background-size:42% 100%;background-repeat:no-repeat;background-position:-60% 0;animation:fcmtSheen 9s ease-in-out 1.5s infinite;opacity:.7}
@keyframes fcmtSheen{0%,70%{background-position:-60% 0}100%{background-position:160% 0}}
/* Cursor spotlight on menu items */
.fcmt-item,.fcmt-tile,.fcmt-wide{--mx:50%;--my:50%;overflow:hidden}
.fcmt-item::before,.fcmt-tile::before,.fcmt-wide::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;background:transparent;transition:opacity .25s}
.fcmt-item:hover::before,.fcmt-tile:hover::before,.fcmt-wide:hover::before{opacity:1}
.fcmt-item>*,.fcmt-tile>*,.fcmt-wide>*{position:relative}
/* Richer bar surface and search */
.fcmt-bar{background:rgba(22,37,54,.78)}
.fcmt-search{transition:border-color .2s,background .2s,box-shadow .2s,transform .2s cubic-bezier(.2,.8,.2,1)}
.fcmt-search:hover{border-color:rgba(76,201,255,.38);box-shadow:none;transform:translateY(-1px)}
.fcmt-cta{transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s,filter .2s}
.fcmt-cta:hover{transform:translateY(-1px);filter:brightness(1.05)}
/* Account card in the mobile menu */
.fcmt-account-wide{position:relative;border-color:rgba(76,201,255,.28)!important;background:rgba(76,201,255,.2)!important}
.fcmt-account-wide #fcmtSheetAvatar{border-radius:50%;box-shadow:0 0 0 2px rgba(76,201,255,.35)}
@media(prefers-reduced-motion:reduce){.fcmt-bar::after{animation:none}.fcmt-progress i{transition:none}}
</style>

<script is:inline>
(() => {
  const bar = document.getElementById('fcmt'), prog = document.getElementById('fcmtProgress');
  let tick = false;
  const update = () => {
    tick = false;
    if (!prog) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    prog.style.setProperty('--fcmt-p', max > 0 ? Math.min(1, Math.max(0, scrollY / max)).toFixed(4) : 0);
  };
  addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
  update();
  // Spotlight follows the cursor inside menu cards.
  if (bar && matchMedia('(hover:hover)').matches) {
    bar.addEventListener('pointermove', (e) => {
      const el = e.target.closest && e.target.closest('.fcmt-item,.fcmt-tile,.fcmt-wide');
      if (!el) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      el.style.setProperty('--my', (e.clientY - r.top) + 'px');
    }, { passive: true });
  }
})();
</script>
