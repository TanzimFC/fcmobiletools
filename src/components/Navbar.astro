kbd{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:var(--muted-strong);font:700 11px/1 var(--font-body)}

.fcmt-cta{position:relative;isolation:isolate;display:inline-flex;align-items:center;gap:10px;height:42px;padding:0 18px 0 15px;border-radius:14px;overflow:hidden;color:#03131c;text-decoration:none;font:800 13px/1 var(--font-body);letter-spacing:-.005em;background:linear-gradient(180deg,#8fe3ff,#4cc9ff 55%,#35b3ec);box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 10px 26px -6px rgba(76,201,255,.65);transition:transform .2s cubic-bezier(.2,.8,.2,1),box-shadow .2s}
.fcmt-cta::after{content:"";position:absolute;z-index:-1;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);animation:fcmt-sheen 4.5s ease-in-out infinite}
