/* ================= Mobile dock ================= */
.fcmt-dock{display:none}

/* ================= Full-screen sheet ================= */
.fcmt-sheet{position:fixed;inset:0;z-index:1500;visibility:hidden;opacity:0;background:rgba(3,9,14,.5);backdrop-filter:blur(0);transition:opacity .28s ease,visibility 0s linear .32s,backdrop-filter .3s}
.fcmt-sheet.open{visibility:visible;opacity:1;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition-delay:0s}
.fcmt-sheet-inner{position:absolute;left:0;right:0;bottom:0;top:calc(env(safe-area-inset-top,0) + 10px);display:flex;flex-direction:column;padding:14px 16px calc(18px + env(safe-area-inset-bottom,0));border-radius:28px 28px 0 0;border:1px solid rgba(255,255,255,.09);border-bottom:0;background:radial-gradient(90% 40% at 90% 0%,rgba(76,201,255,.12),transparent 70%),linear-gradient(180deg,#111e2c,#08111a);box-shadow:0 -30px 90px rgba(0,0,0,.6);transform:translateY(100%);transition:transform .42s cubic-bezier(.2,.8,.2,1)}
