.fcmt-mega-card{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:8px;width:min(560px,calc(100vw - 48px));padding:8px;border-radius:24px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(180deg,rgba(20,34,49,.97),rgba(10,19,28,.98));box-shadow:0 1px 0 rgba(255,255,255,.07) inset,0 40px 90px -10px rgba(0,0,0,.75)}
