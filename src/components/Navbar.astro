---
const current = Astro.url.pathname;
const isActive = (href) => href === '/' ? current === '/' : current === href || current.startsWith(href + '/');

const hasMark = true;

const cta = { label: 'FC Mobile 27 APK', href: '/fc-mobile-27', meta: 'Season 27 · Sep 24', image: 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790218791/fc-mobile-tools/t0gwuzeytzlmk13pes8q.webp' };

const navGroups = [
  { id: 'tools', label: 'Tools', links: [
    { label: 'Team OVR', href: '/team-ovr', meta: 'Squad rating', icon: 'ovr' },
    { label: 'Training Calculator', href: '/training-calculator', meta: 'XP planner', icon: 'training' },
    { label: 'Rank Up Calculator', href: '/rank-up-calculator', meta: 'Rank costs', icon: 'rank' },
    { label: 'Gauntlet Planner', href: '/gauntlet-planner', meta: 'Squad rotation', icon: 'gauntlet' }
  ]},
  { id: 'live', label: 'Live', links: [
    { label: 'Events', href: '/events', meta: 'Countdowns', icon: 'events' },
    { label: 'Redeem Codes', href: '/redeem-codes', meta: 'Latest rewards', icon: 'codes' },
    { label: "A Nation's Story", href: '/a-nations-story', meta: 'Event answers', icon: 'story' },
    { label: 'Football Centre', href: '/football-centre', meta: 'Live hub', icon: 'centre' }
  ]}
];

const allLinks = [
  { label: 'Home', href: '/', meta: 'Start here', icon: 'home' },
  { label: cta.label, href: cta.href, meta: cta.meta, icon: 'apk' },
  ...navGroups.flatMap((g) => g.links.map((l) => ({ ...l, group: g.label }))),
  { label: 'Articles', href: '/blog', meta: 'News, leaks, guides', icon: 'articles' }
];

const groupActive = (g) => g.links.some((l) => isActive(l.href));

const icons = {
  home: '<path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9z"/>',
  apk: '<path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>',
  ovr: '<path d="M12 3l8 4v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/>',
  training: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  rank: '<path d="M12 3l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.4 6.8 19.2l1-5.9L3.5 9.2l5.9-.8L12 3z"/>',
  gauntlet: '<path d="M5 4h14v6a7 7 0 01-14 0V4z"/><path d="M9 20h6M12 17v3"/>',
  events: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  codes: '<path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 110-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 100-5C13 2 12 7 12 7z"/>',
  story: '<path d="M4 5a2 2 0 012-2h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  centre: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/>',
  articles: '<path d="M5 4h11l3 3v13H5z"/><path d="M9 11h6M9 15h6M9 7h3"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M7 17L17 7M9 7h8v8"/>'
};
const ico = (name, size = 18, sw = 1.8) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<a class="fcmt-skip" href="#content">Skip to content</a>

<header class="fcmt" id="fcmt" data-scrolled="false">
  <div class="fcmt-bar" id="fcmtBar">
    <!-- Brand -->
    <a class="fcmt-brand" href="/" aria-label="FCMobiletools home">
      <img class="fcmt-logo-img" src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" fetchpriority="high" />
    </a>

    <!-- Desktop nav -->
    <nav class="fcmt-nav" id="fcmtNav" aria-label="Primary navigation">
      <span class="fcmt-glide" id="fcmtGlide" aria-hidden="true"></span>

      <a class:list={['fcmt-link', { active: isActive('/') }]} href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>

      {navGroups.map((g) => (
        <div class="fcmt-group" data-group={g.id}>
          <button class:list={['fcmt-link', 'fcmt-trigger', { active: groupActive(g) }]} type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`fcmt-mega-${g.id}`}>
            {g.label}
            <svg class="fcmt-chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div class="fcmt-mega" id={`fcmt-mega-${g.id}`} role="group" aria-label={g.label}>
            <div class="fcmt-mega-card">
              <div class="fcmt-mega-list">
                <p class="fcmt-eyebrow">{g.label}</p>
                {g.links.map((l) => (
                  <a class:list={['fcmt-item', { active: isActive(l.href) }]} href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                    <span class="fcmt-ico" set:html={ico(l.icon)}></span>
                    <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.meta}</small></span>
                    <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
                  </a>
                ))}
              </div>

              <a class="fcmt-feature" href={cta.href}>
                <img class="fcmt-feature-art" src={cta.image} alt="" width="520" height="300" loading="eager" decoding="async" />
                <span class="fcmt-feature-glow" aria-hidden="true"></span>
                <span class="fcmt-feature-tag"><i></i>Most popular</span>
                <strong>{cta.label}</strong>
                <small>Latest Season 27 download, changelog and install guide.</small>
                <span class="fcmt-feature-cta">Open page <span set:html={ico('arrow', 14, 2.4)}></span></span>
              </a>
            </div>
          </div>
        </div>
      ))}

      <a class:list={['fcmt-link', { active: current.startsWith('/blog') }]} href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>Articles</a>
    </nav>

    <!-- Actions -->
    <div class="fcmt-actions">
      <button class="fcmt-search" id="fcmtSearchBtn" type="button" aria-label="Search pages" aria-haspopup="dialog">
        <span class="fcmt-search-icon" set:html={ico('search', 17, 2)}></span>
        <span class="fcmt-search-txt">Search tools, events, codes...</span>
        <kbd>/</kbd>
      </button>

      <a class:list={['fcmt-cta', { active: isActive(cta.href) }]} href={cta.href}>
        <span class="fcmt-pulse" aria-hidden="true"></span>
        <span class="fcmt-cta-txt">{cta.label}</span>
      </a>

      <button class="fcmt-burger" id="fcmtBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="fcmtSheet">
        <span set:html={ico('menu', 20, 2)}></span>
      </button>
    </div>
  </div>
  <div class="fcmt-progress" id="fcmtProgress" aria-hidden="true"><i></i></div>
</header>

<!-- Mobile bottom tab bar -->
<nav class="fcmt-dock" aria-label="Quick navigation">
  <a class:list={{ active: isActive('/') }} href="/" aria-current={isActive('/') ? 'page' : undefined}><span set:html={ico('home', 20)}></span><em>Home</em></a>
  <a class:list={{ active: isActive('/events') }} href="/events" aria-current={isActive('/events') ? 'page' : undefined}><span set:html={ico('events', 20)}></span><em>Events</em></a>
  <a class:list={['fcmt-dock-main', { active: isActive(cta.href) }]} href={cta.href} aria-label={cta.label}><span set:html={ico('apk', 22, 2)}></span><em>APK</em></a>
  <a class:list={{ active: isActive('/redeem-codes') }} href="/redeem-codes" aria-current={isActive('/redeem-codes') ? 'page' : undefined}><span set:html={ico('codes', 20)}></span><em>Codes</em></a>
  <button type="button" id="fcmtDockMore" aria-label="More" aria-haspopup="dialog"><span set:html={ico('menu', 20)}></span><em>More</em></button>
</nav>

<!-- Full-screen mobile sheet -->
<div class="fcmt-sheet" id="fcmtSheet" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true" inert>
  <div class="fcmt-sheet-inner">
    <div class="fcmt-sheet-head">
      <a class="fcmt-brand" href="/" aria-label="FCMobiletools home">
        <img class="fcmt-logo-img" src="/assets/images/logo.png" alt="FCMobiletools" width="1774" height="887" decoding="async" />
      </a>
      <button class="fcmt-x" id="fcmtSheetClose" type="button" aria-label="Close menu"><span set:html={ico('close', 20, 2.2)}></span></button>
    </div>

    <a class="fcmt-hero" href={cta.href}>
      <img class="fcmt-feature-art" src={cta.image} alt="" width="720" height="360" loading="eager" decoding="async" />
      <span class="fcmt-feature-glow" aria-hidden="true"></span>
      <span class="fcmt-feature-tag"><i></i>Most popular</span>
      <strong>{cta.label}</strong>
      <small>Latest Season 27 download, changelog and install guide.</small>
      <span class="fcmt-hero-arrow" set:html={ico('arrow', 18, 2.2)}></span>
    </a>

    <div class="fcmt-sheet-scroll">
      {navGroups.map((g) => (
        <section class="fcmt-sec">
          <p class="fcmt-eyebrow">{g.label}</p>
          <div class="fcmt-sec-grid">
            {g.links.map((l) => (
              <a class:list={['fcmt-tile', { active: isActive(l.href) }]} href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                <span class="fcmt-ico" set:html={ico(l.icon)}></span>
                <strong>{l.label}</strong>
                <small>{l.meta}</small>
              </a>
            ))}
          </div>
        </section>
      ))}
      <a class:list={['fcmt-wide', { active: current.startsWith('/blog') }]} href="/blog">
        <span class="fcmt-ico" set:html={ico('articles')}></span>
        <span class="fcmt-item-text"><strong>Articles</strong><small>News, leaks, guides</small></span>
        <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
      </a>
      <button class="fcmt-wide fcmt-wide-btn" id="fcmtSheetSearch" type="button">
        <span class="fcmt-ico" set:html={ico('search')}></span>
        <span class="fcmt-item-text"><strong>Search pages</strong><small>Jump anywhere</small></span>
      </button>
    </div>
  </div>
</div>

<!-- Command palette -->
<div class="fcmt-pal" id="fcmtPal" role="dialog" aria-modal="true" aria-label="Search pages" aria-hidden="true" inert>
  <div class="fcmt-pal-backdrop" id="fcmtPalBackdrop"></div>
  <div class="fcmt-pal-card">
    <div class="fcmt-pal-field">
      <span set:html={ico('search', 18, 2)}></span>
      <input id="fcmtPalInput" type="text" placeholder="Search tools, events, codes..." autocomplete="off" spellcheck="false" aria-label="Search pages" />
      <kbd>esc</kbd>
    </div>
    <ul class="fcmt-pal-list" id="fcmtPalList" role="listbox">
      {allLinks.map((l) => (
        <li role="option" data-label={l.label.toLowerCase()} data-meta={(l.meta + ' ' + (l.group || '')).toLowerCase()}>
          <a href={l.href}>
            <span class="fcmt-ico" set:html={ico(l.icon)}></span>
            <span class="fcmt-item-text"><strong>{l.label}</strong><small>{l.group ? l.group + ' · ' : ''}{l.meta}</small></span>
            <span class="fcmt-go" set:html={ico('arrow', 14, 2.2)}></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="fcmt-pal-empty" id="fcmtPalEmpty" hidden>No matches. Try “codes”, “events” or “apk”.</p>
  </div>
</div>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const root = document.documentElement;
  const header = $('fcmt'), bar = $('fcmtBar'), progress = $('fcmtProgress').firstElementChild;
  const nav = $('fcmtNav'), glide = $('fcmtGlide');
  const sheet = $('fcmtSheet'), burger = $('fcmtBurger'), sheetClose = $('fcmtSheetClose'), dockMore = $('fcmtDockMore'), sheetSearch = $('fcmtSheetSearch');
  const pal = $('fcmtPal'), palInput = $('fcmtPalInput'), palList = $('fcmtPalList'), palEmpty = $('fcmtPalEmpty'), palBackdrop = $('fcmtPalBackdrop'), searchBtn = $('fcmtSearchBtn');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- Overlay helpers ---------- */
  let lastFocus = null;
  const lockScroll = (on) => root.classList.toggle('fcmt-lock', on);
  const openLayer = (el, focusEl) => {
    lastFocus = document.activeElement;
    el.removeAttribute('inert'); el.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => el.classList.add('open'));
    lockScroll(true);
    setTimeout(() => focusEl?.focus(), 60);
  };
  const closeLayer = (el, restore = true) => {
    el.classList.remove('open'); el.setAttribute('aria-hidden', 'true'); el.setAttribute('inert', '');
    if (!sheet.classList.contains('open') && !pal.classList.contains('open')) lockScroll(false);
    if (restore) lastFocus?.focus?.();
  };
  const trap = (el, e) => {
    if (e.key !== 'Tab' || !el.classList.contains('open')) return;
    const f = [...el.querySelectorAll('a[href],button:not([disabled]),input')].filter((n) => n.offsetParent !== null);
    if (!f.length) return;
    const a = f[0], z = f[f.length - 1];
    if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); }
    else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); }
  };

  /* ---------- Desktop mega menus ---------- */
  const groups = [...document.querySelectorAll('.fcmt-group')];
  let timer;
  const setGroup = (g, open) => { g.classList.toggle('open', open); g.querySelector('.fcmt-trigger').setAttribute('aria-expanded', String(open)); header.classList.toggle('menu-open', groups.some((x) => x.classList.contains('open'))); };
  const closeGroups = (except) => groups.forEach((g) => g !== except && setGroup(g, false));

  groups.forEach((g) => {
    const trig = g.querySelector('.fcmt-trigger');
    const items = [...g.querySelectorAll('.fcmt-item')];
    trig.addEventListener('click', () => { const o = !g.classList.contains('open'); closeGroups(g); setGroup(g, o); });
    if (canHover) {
      g.addEventListener('pointerenter', () => { clearTimeout(timer); closeGroups(g); setGroup(g, true); });
      g.addEventListener('pointerleave', () => { timer = setTimeout(() => setGroup(g, false), 160); });
    }
    trig.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); closeGroups(g); setGroup(g, true); items[0]?.focus(); } });
    items.forEach((it, i) => it.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { setGroup(g, false); trig.focus(); }
    }));
    g.addEventListener('focusout', (e) => { if (!g.contains(e.relatedTarget)) setGroup(g, false); });
  });
  document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.fcmt-group')) closeGroups(); });

  /* ---------- Glide highlight ---------- */
  const links = [...nav.querySelectorAll(':scope > .fcmt-link, :scope > .fcmt-group > .fcmt-trigger')];
  const moveGlide = (el) => {
    if (!el) { glide.style.opacity = '0'; return; }
    const n = nav.getBoundingClientRect(), r = el.getBoundingClientRect();
    glide.style.opacity = '1'; glide.style.width = r.width + 'px'; glide.style.transform = `translateX(${r.left - n.left}px)`;
  };
  if (canHover) { links.forEach((l) => l.addEventListener('pointerenter', () => moveGlide(l))); nav.addEventListener('pointerleave', () => moveGlide(null)); }

  /* ---------- Scroll ---------- */
  let ticking = false;
  const onScroll = () => {
    const y = scrollY, max = document.documentElement.scrollHeight - innerHeight;
    header.dataset.scrolled = String(y > 12);
    progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  /* ---------- Mobile sheet ---------- */
  const openSheet = () => { burger.setAttribute('aria-expanded', 'true'); openLayer(sheet, sheetClose); };
  const closeSheet = (restore = true) => { burger.setAttribute('aria-expanded', 'false'); closeLayer(sheet, restore); };
  burger.addEventListener('click', openSheet);
  dockMore?.addEventListener('click', openSheet);
  sheetClose.addEventListener('click', () => closeSheet());
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeSheet(false)));
  sheetSearch.addEventListener('click', () => { closeSheet(false); setTimeout(openPal, 180); });

  /* ---------- Command palette ---------- */
  const rows = [...palList.querySelectorAll('li')];
  let sel = 0;
  const visible = () => rows.filter((r) => !r.hidden);
  const paint = () => { const v = visible(); v.forEach((r, i) => r.classList.toggle('sel', i === sel)); v[sel]?.scrollIntoView({ block: 'nearest' }); };
  const filter = () => {
    const q = palInput.value.trim().toLowerCase();
    rows.forEach((r) => { r.hidden = !!q && !(r.dataset.label.includes(q) || r.dataset.meta.includes(q)); });
    palEmpty.hidden = visible().length > 0; sel = 0; paint();
  };
  const openPal = () => { palInput.value = ''; filter(); openLayer(pal, palInput); };
  const closePal = () => closeLayer(pal);
  searchBtn.addEventListener('click', openPal);
  palBackdrop.addEventListener('click', closePal);
  palInput.addEventListener('input', filter);
  palList.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeLayer(pal, false)));
  palInput.addEventListener('keydown', (e) => {
    const v = visible();
    if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % Math.max(v.length, 1); paint(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + v.length) % Math.max(v.length, 1); paint(); }
    if (e.key === 'Enter' && v[sel]) { e.preventDefault(); v[sel].querySelector('a').click(); }
  });

  /* ---------- Global keys ---------- */
  document.addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
    if ((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) { e.preventDefault(); pal.classList.contains('open') ? closePal() : openPal(); }
    if (e.key === 'Escape') { if (pal.classList.contains('open')) closePal(); else if (sheet.classList.contains('open')) closeSheet(); closeGroups(); }
    trap(pal, e); trap(sheet, e);
  });

  /* Close sheet if resized to desktop */
  addEventListener('resize', () => { if (innerWidth > 980 && sheet.classList.contains('open')) closeSheet(false); moveGlide(null); });
})();
</script>

<style is:global>
/* Kill horizontal overflow at the source (fixes the empty strip on the right) */
html,body{max-width:100%;overflow-x:clip}
html.fcmt-lock{overflow:hidden}
</style>

<style>
.fcmt-skip{position:fixed;left:14px;top:-60px;z-index:2000;padding:10px 16px;border-radius:12px;background:var(--primary);color:#04121b;font:800 13px/1 var(--font-body);text-decoration:none;transition:top .2s ease}
.fcmt-skip:focus{top:calc(12px + env(safe-area-inset-top,0))}

/* ================= Floating island ================= */
.fcmt{position:sticky;top:0;z-index:1200;height:0;pointer-events:none;padding-top:env(safe-area-inset-top,0)}
.fcmt-bar{
  pointer-events:auto;position:relative;margin:14px auto 0;width:min(1240px,calc(100% - 32px));height:64px;
  display:flex;align-items:center;gap:18px;padding:0 10px 0 12px;border-radius:22px;
  background:linear-gradient(180deg,rgba(20,34,49,.72),rgba(11,21,31,.66));
  border:1px solid rgba(255,255,255,.085);
  backdrop-filter:blur(26px) saturate(170%);-webkit-backdrop-filter:blur(26px) saturate(170%);
  box-shadow:0 1px 0 rgba(255,255,255,.07) inset,0 -1px 0 rgba(0,0,0,.25) inset,0 18px 50px -12px rgba(0,0,0,.55);
  transition:width .4s cubic-bezier(.2,.8,.2,1),margin .4s cubic-bezier(.2,.8,.2,1),height .3s ease,background .3s ease,border-color .3s ease,box-shadow .3s ease;
}
.fcmt-bar::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(120deg,rgba(76,201,255,.38),rgba(255,255,255,0) 32%,rgba(255,255,255,0) 68%,rgba(76,201,255,.22));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.55}
.fcmt[data-scrolled="true"] .fcmt-bar{width:min(1100px,calc(100% - 40px));height:58px;margin-top:10px;background:linear-gradient(180deg,rgba(14,25,37,.9),rgba(8,16,24,.86));border-color:rgba(255,255,255,.1);box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 24px 60px -14px rgba(0,0,0,.7)}

/* ================= Brand ================= */
.fcmt-brand{display:flex;align-items:center;justify-content:flex-start;flex:0 0 auto;text-decoration:none;border-radius:14px;padding:4px 7px;transition:background .2s ease}
.fcmt-brand:hover{background:rgba(255,255,255,.04)}
.fcmt-logo-img{display:block;width:126px;height:auto;max-height:44px;flex:0 0 auto;object-fit:contain;filter:drop-shadow(0 7px 16px rgba(76,201,255,.22))}
.fcmt-sheet .fcmt-logo-img{width:138px;max-height:48px}

/* ================= Desktop nav ================= */
.fcmt-nav{position:relative;display:flex;align-items:center;gap:2px;margin:0 auto}
.fcmt-glide{position:absolute;left:0;top:50%;height:38px;margin-top:-19px;width:0;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.04));border:1px solid rgba(255,255,255,.08);opacity:0;pointer-events:none;transition:transform .32s cubic-bezier(.2,.8,.2,1),width .32s cubic-bezier(.2,.8,.2,1),opacity .2s ease}
