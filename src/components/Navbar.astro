.fcmt-item:hover .fcmt-ico,.fcmt-item.active .fcmt-ico,.fcmt-tile:hover .fcmt-ico,.fcmt-tile.active .fcmt-ico,.fcmt-wide:hover .fcmt-ico,.fcmt-wide.active .fcmt-ico,.fcmt-pal-list li.sel .fcmt-ico{color:var(--primary);background:rgba(76,201,255,.12);border-color:rgba(76,201,255,.25);box-shadow:0 0 20px rgba(76,201,255,.16)}
.fcmt-ico svg{display:block}
