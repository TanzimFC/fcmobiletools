---
import { STARTING_POSITIONS, TEAM_BADGES, TEAM_OVR_RANK_MAX } from '../lib/teamOvr.js';
const coords = [[50,89],[17,73],[39,76],[61,76],[83,73],[32,53],[50,48],[68,53],[17,27],[50,19],[83,27]];
---
<div class="ovr-page" data-team-ovr>
  <header class="ovr-head"><div><span class="eyebrow">TANZIMFC TOOL / FC MOBILE</span><h1>Team OVR <em>Calculator</em></h1><p>Build your lineup and get the exact Team OVR from Base OVR, Rank and eligible Team Badges.</p></div><button data-reset class="ghost">Reset squad</button></header>
  <div class="ovr-grid">
    <main>
      <section class="panel squad-panel">
        <div class="section-head"><div><small>01</small><div><h2>Starting XI</h2><p>Enter the Base OVR shown on the card, not the ranked/displayed OVR.</p></div></div><b data-count>0 / 11</b></div>
        <div class="pitch"><img src="/assets/images/field.png" alt="Football pitch" />{STARTING_POSITIONS.map((pos,i)=><div class="marker" style={`--x:${coords[i][0]}%;--y:${coords[i][1]}%;`}><span>{pos}</span><strong data-pitch={i}>--</strong></div>)}</div>
        <div class="players">{STARTING_POSITIONS.map((pos,i)=><article class="player"><div class="pos"><small>{String(i+1).padStart(2,'0')}</small><b>{pos}</b></div><label>Base OVR<input data-base type="number" min="1" max="122" inputmode="numeric" placeholder="117" /></label><label>Rank<select data-rank>{[0,1,2,3,4,5].map(r=><option value={r}>{r}</option>)}</select></label></article>)}</div>
      </section>
      <section class="panel subs-panel"><div class="section-head"><div><small>02</small><div><h2>Substitutes <i>Optional</i></h2><p>Up to 7 substitutes. Every filled substitute is included and changes the divisor.</p></div></div><button class="add" data-add>+ Add substitute</button></div><div class="subs" data-subs><div class="empty">No substitutes added yet</div></div></section>
      <section class="panel"><div class="section-head"><div><small>03</small><div><h2>Team Badges</h2><p>Equip up to three badges. Only Team OVR bonuses are counted.</p></div></div><b class="slots">3 SLOTS</b></div><div class="badges">{[0,1,2].map(i=><label class="badge"><span>Slot {i+1}</span><select data-badge={i}><option value="">No badge</option>{TEAM_BADGES.map(b=><option value={b.id} disabled={b.status==='expired'}>{b.name}{b.status==='expired'?' · expired':''}</option>)}</select><select data-level={i}><option value="0">Level 0</option>{[1,2,3,4,5].map(l=><option value={l}>Level {l}</option>)}</select><b data-bonus={i}>+0 OVR</b></label>)}</div></section>
      <details class="panel how"><summary>How is my Team OVR calculated?</summary><div class="details"><div><span>Base OVR total</span><b data-detail-base>0</b></div><div><span>Squad size</span><b data-detail-size>0</b></div><div><span>Rank total</span><b data-detail-rank>0</b></div><div><span>Badge bonus</span><b data-detail-badge>+0</b></div></div><p>Team OVR = ceil(total Base OVR ÷ squad size) + ceil(total Rank ÷ squad size) + eligible Team OVR badge bonuses.</p><small>Base OVR and Rank averages round up separately. Training, Skill Points, attributes and displayed OVR do not count.</small></details>
    </main>
    <aside class="result" data-result><span>YOUR TEAM OVR</span><strong data-total>--</strong><p data-status>Complete your Starting XI to unlock the result.</p><div class="breakdown"><div><small>BASE</small><b data-base-avg>--</b></div><div><small>RANK</small><b data-rank-avg>--</b></div><div><small>BADGES</small><b data-badge-total>+0</b></div></div><code data-equation>11 players required</code></aside>
  </div>
</div>
<script>
  import { calculateTeamOVR } from '../lib/teamOvr.js';
  const root=document.querySelector('[data-team-ovr]');
  if(root){const rows=[...root.querySelectorAll('.player')], subs=root.querySelector('[data-subs]'), state={subCount:0};
    const read=()=>[...root.querySelectorAll('.player,.sub')].map(r=>({baseOVR:r.querySelector('[data-base]')?.value,rank:r.querySelector('[data-rank]')?.value})).filter(p=>p.baseOVR!=='');
    const badges=()=>[...root.querySelectorAll('[data-badge]')].map((s,i)=>({id:s.value,level:root.querySelector(`[data-level="${i}"]`)?.value||0})).filter(x=>x.id);
    function update(){const ps=read(),r=calculateTeamOVR({players:ps,badges:badges()});root.querySelector('[data-count]').textContent=`${ps.length} / 11`;root.querySelector('[data-total]').textContent=r.complete?r.teamOVR:'--';root.querySelector('[data-base-avg]').textContent=r.complete?r.baseAverage:'--';root.querySelector('[data-rank-avg]').textContent=r.complete?r.rankAverage:'--';root.querySelector('[data-badge-total]').textContent=`+${r.badgeBonus}`;root.querySelector('[data-detail-base]').textContent=r.baseTotal;root.querySelector('[data-detail-size]').textContent=r.squadSize;root.querySelector('[data-detail-rank]').textContent=r.rankTotal;root.querySelector('[data-detail-badge]').textContent=`+${r.badgeBonus}`;root.querySelector('[data-status]').textContent=r.complete?`${r.squadSize}-player squad · Live calculation`:`${Math.max(0,11-ps.length)} more player${ps.length===10?'':'s'} needed`;root.querySelector('[data-equation]').textContent=r.complete?`ceil(${r.baseTotal} ÷ ${r.squadSize}) + ceil(${r.rankTotal} ÷ ${r.squadSize}) + ${r.badgeBonus} = ${r.teamOVR}`:'Complete the Starting XI to unlock your result';rows.forEach((row,i)=>root.querySelector(`[data-pitch="${i}"]`).textContent=row.querySelector('[data-base]').value||'--');root.querySelectorAll('[data-badge]').forEach((s,i)=>{const l=Number(root.querySelector(`[data-level="${i}"]`).value);const b=TEAM_BADGES.find(x=>x.id===s.value);root.querySelector(`[data-bonus="${i}"]`).textContent=`+${b?.levels?.[l]||0} OVR`});}
    function addSub(){if(state.subCount>=7)return;state.subCount++;const n=state.subCount,r=document.createElement('article');r.className='player sub';r.innerHTML=`<div class="pos"><small>SUB</small><b>${n}</b></div><label>Base OVR<input data-base type="number" min="1" max="122" inputmode="numeric" placeholder="117" /></label><label>Rank<select data-rank>${[0,1,2,3,4,5].map(x=>`<option value="${x}">${x}</option>`).join('')}</select></label><button type="button" class="remove">×</button>`;subs.querySelector('.empty')?.remove();subs.appendChild(r);r.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',update));r.querySelector('.remove').addEventListener('click',()=>{r.remove();state.subCount--;[...subs.querySelectorAll('.sub')].forEach((x,i)=>x.querySelector('.pos b').textContent=i+1);if(!subs.children.length)subs.innerHTML='<div class="empty">No substitutes added yet</div>';update()});update();}
    rows.forEach(r=>r.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',update)));root.querySelectorAll('[data-badge],[data-level]').forEach(x=>x.addEventListener('change',update));root.querySelector('[data-add]').addEventListener('click',addSub);root.querySelector('[data-reset]').addEventListener('click',()=>{if(!confirm('Reset the squad and all badge selections?'))return;rows.forEach(r=>{r.querySelector('[data-base]').value='';r.querySelector('[data-rank]').value='0'});subs.innerHTML='<div class="empty">No substitutes added yet</div>';state.subCount=0;root.querySelectorAll('[data-badge]').forEach(x=>x.value='');root.querySelectorAll('[data-level]').forEach(x=>x.value='0');update()});update();}
</script>
<style>
.ovr-page{width:min(1240px,calc(100% - 32px));margin:auto;padding:58px 0 90px}.ovr-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:26px}.eyebrow{font:800 9px var(--mono);letter-spacing:.18em;color:var(--blue)}.ovr-head h1{font-size:clamp(44px,6vw,76px);line-height:.92;letter-spacing:-.065em;margin:14px 0}.ovr-head h1 em{color:var(--blue);font-style:normal}.ovr-head p{margin:0;color:#7890a1;max-width:680px;font-size:14px}.ghost,.add,.remove{border:1px solid #26465a;background:#0c1720;color:#e4f8ff;border-radius:10px;padding:11px 14px;font:800 9px var(--mono);cursor:pointer}.ghost:hover,.add:hover,.remove:hover{border-color:var(--blue);transform:translateY(-1px)}.ovr-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px}.panel,.result{border:1px solid #1d3342;background:linear-gradient(145deg,#0d151d,#091017);border-radius:20px;box-shadow:0 18px 55px #0003}.panel{padding:20px;margin-bottom:18px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:18px}.section-head>div{display:flex;gap:12px;align-items:flex-start}.section-head small,.slots{font:800 9px var(--mono);color:var(--blue);letter-spacing:.1em}.section-head h2{font-size:18px;margin:0}.section-head h2 i{font:700 8px var(--mono);color:#60788a;margin-left:7px}.section-head p{color:#71899a;font-size:10px;margin:4px 0 0}.section-head>b{font:800 10px var(--mono);color:#dff6ff;background:#10222e;padding:9px;border-radius:8px}.pitch{position:relative;max-width:700px;aspect-ratio:1/1.38;margin:23px auto;border-radius:16px;overflow:hidden;border:1px solid #35634f;background:#164b34}.pitch img{width:100%;height:100%;object-fit:cover;opacity:.9}.marker{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:50px;height:50px;border-radius:50%;display:grid;place-items:center;align-content:center;background:#07131be8;border:2px solid var(--blue);box-shadow:0 5px 18px #0009}.marker span{font:800 7px var(--mono);color:#bdeeff}.marker strong{font:900 13px var(--mono)}.players,.subs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.player{display:grid;grid-template-columns:55px minmax(0,1fr) 85px;gap:8px;align-items:end;padding:9px;border:1px solid #1b2e3b;background:#0a1118;border-radius:11px}.pos{display:flex;flex-direction:column;justify-content:center;align-self:stretch}.pos small{font:700 7px var(--mono);color:#5c7587}.pos b{font:900 12px var(--mono);color:#c8eaf7}.player label,.badge span{font:800 7px var(--mono);letter-spacing:.08em;color:#657d8e}.player input,.player select,.badge select{width:100%;height:38px;margin-top:5px;border:1px solid #253d4c;border-radius:8px;background:#0d1922;color:#effaff;padding:0 9px;font:800 11px var(--mono);outline:0}.player input:focus,.player select:focus,.badge select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55c7f218}.subs-panel .section-head{align-items:flex-start}.add{white-space:nowrap}.subs{margin-top:15px}.empty{grid-column:1/-1;padding:14px;text-align:center;border:1px dashed #213948;border-radius:10px;color:#526b7d;font-size:10px}.sub{grid-template-columns:45px minmax(0,1fr) 76px 30px}.remove{height:38px;padding:0;font-size:18px}.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:17px}.badge{display:block;padding:13px;border:1px solid #1b313f;background:#0a1219;border-radius:12px}.badge select{display:block}.badge>b{display:block;margin-top:7px;color:var(--blue);font:800 9px var(--mono)}.how summary{cursor:pointer;font-weight:850;font-size:14px}.details{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:17px 0}.details div{padding:11px;border:1px solid #182d3a;background:#091219;border-radius:9px}.details span{display:block;color:#60798b;font:700 7px var(--mono);text-transform:uppercase}.details b{display:block;margin-top:5px;font:900 15px var(--mono)}.how p{padding:13px;border-left:2px solid var(--blue);background:#091920;color:#b5d8e7;font-size:10px;line-height:1.7}.how>small{color:#637b8d;font-size:9px}.result{position:sticky;top:90px;padding:26px 20px;text-align:center;overflow:hidden}.result:before{content:"";position:absolute;width:180px;height:180px;left:50%;top:-120px;transform:translateX(-50%);background:#55c7f222;filter:blur(24px);border-radius:50%}.result>span{position:relative;color:var(--blue);font:800 9px var(--mono);letter-spacing:.18em}.result>strong{position:relative;display:block;font:900 84px/.95 var(--mono);letter-spacing:-.08em;margin:21px 0 12px;text-shadow:0 0 28px #55c7f244}.result>p{min-height:30px;color:#748d9e;font-size:10px}.breakdown{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #1d3341;margin-top:18px}.breakdown div{padding:13px 3px}.breakdown div+div{border-left:1px solid #1d3341}.breakdown small{display:block;color:#60788a;font:700 7px var(--mono)}.breakdown b{display:block;margin-top:5px;font:900 16px var(--mono)}.result code{display:block;margin-top:14px;color:#587184;font:700 8px/1.6 var(--mono);white-space:normal}.result[data-ready="true"]{border-color:#55c7f266}
@media(max-width:900px){.ovr-grid{grid-template-columns:1fr}.result{position:relative;top:auto;order:-1}.result>strong{font-size:72px}.ovr-head{align-items:flex-start}.details{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.ovr-page{width:calc(100% - 20px);padding:35px 0 60px}.ovr-head{flex-direction:column}.ovr-head h1{font-size:44px}.ghost{width:100%}.panel{padding:14px;border-radius:16px}.pitch{margin:18px auto}.marker{width:42px;height:42px}.marker span{font-size:6px}.marker strong{font-size:11px}.players,.subs,.badges{grid-template-columns:1fr}.player{grid-template-columns:50px minmax(0,1fr) 80px}.sub{grid-template-columns:45px minmax(0,1fr) 72px 30px}.add{width:100%}.subs-panel .section-head{flex-direction:column}.section-head{align-items:flex-start}.section-head>b{font-size:9px}.result{padding:22px 15px}.result>strong{font-size:66px}.details{grid-template-columns:1fr 1fr}}
</style>
