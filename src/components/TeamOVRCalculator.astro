---
import { STARTING_POSITIONS, TEAM_BADGES, TEAM_OVR_MAX_PLAYERS, TEAM_OVR_RANK_MAX } from '../lib/teamOvr.js';
---
<section class="ovr-tool" data-team-ovr>
  <div class="ovr-hero">
    <div>
      <p class="ovr-kicker">FC MOBILE TOOLS / CALCULATOR</p>
      <h1>Team OVR <span>Calculator</span></h1>
      <p class="ovr-lede">Build your squad, add Team Badges, and see your exact Team OVR update instantly.</p>
    </div>
    <button class="ovr-reset" type="button" data-reset>Reset Squad</button>
  </div>

  <div class="ovr-layout">
    <div class="ovr-main">
      <section class="ovr-card squad-card">
        <div class="card-head">
          <div><span class="step">01</span><div><h2>Your Squad</h2><p>Enter Base OVR and Rank for every player.</p></div></div>
          <strong data-count>0 / 11</strong>
        </div>

        <div class="pitch-wrap">
          <div class="pitch">
            <img src="/assets/images/field.png" alt="Football pitch" />
            <div class="pitch-lines"></div>
            {STARTING_POSITIONS.map((position, index) => <div class="pitch-player" style={`--x:${[50,16,39,61,84,32,50,68,16,50,84][index]}%;--y:${[90,73,76,76,73,53,48,53,27,19,27][index]}%;`} data-pitch-player={index + 1}><span>{position}</span><b data-pitch-ovr={index + 1}>--</b></div>)}
          </div>
        </div>

        <div class="player-list" data-starters>
          {STARTING_POSITIONS.map((position, index) => <article class="player-row" data-player={index + 1}>
            <div class="player-pos"><span>{String(index + 1).padStart(2, '0')}</span><b>{position}</b></div>
            <label>Base OVR<input data-base type="number" min="1" max="122" inputmode="numeric" placeholder="117" aria-label={`${position} Base OVR`} /></label>
            <label>Rank<select data-rank aria-label={`${position} Rank`}>{Array.from({ length: TEAM_OVR_RANK_MAX + 1 }, (_, rank) => <option value={rank}>{rank}</option>)}</select></label>
          </article>)}
        </div>

        <div class="subs-head"><div><span class="step">02</span><div><h2>Substitutes</h2><p>Optional. Added substitutes increase the divisor and are included in Team OVR.</p></div></div><button class="add-sub" type="button" data-add-sub>+ Add Substitute</button></div>
        <div class="sub-list" data-subs></div>
      </section>

      <section class="ovr-card badge-card">
        <div class="card-head"><div><span class="step">03</span><div><h2>Team Badges</h2><p>Equip up to three badges. Only explicit Team OVR bonuses count.</p></div></div><span class="badge-limit">3 SLOTS</span></div>
        <div class="badge-grid">
          {Array.from({ length: 3 }, (_, index) => <label class="badge-slot"><span>Slot {index + 1}</span><select data-badge={index}><option value="">No badge</option>{TEAM_BADGES.map((badge) => <option value={badge.id} disabled={badge.status === 'expired'}>{badge.name}{badge.status === 'expired' ? ' · expired' : ''}</option>)}</select><select data-badge-level={index} aria-label={`Badge ${index + 1} level`}><option value="0">Level 0</option>{[1,2,3,4,5].map((level) => <option value={level}>Level {level}</option>)}</select><small data-badge-bonus={index}>Team OVR +0</small></label>)}
        </div>
      </section>

      <details class="ovr-card explain-card" open>
        <summary>How is my Team OVR calculated?</summary>
        <div class="math-grid">
          <div><span>Total Base OVR</span><b data-detail-base>0</b></div><div><span>Squad size</span><b data-detail-size>0</b></div><div><span>Total Rank</span><b data-detail-rank>0</b></div><div><span>Badge bonus</span><b data-detail-badge>+0</b></div>
        </div>
        <p class="formula">Team OVR = <b>ceil(Base OVR ÷ squad size)</b> + <b>ceil(Rank ÷ squad size)</b> + <b>eligible Team OVR badge bonuses</b></p>
        <p class="note">Base OVR and Rank averages are rounded up separately. Training, Skill Points, player attributes, and displayed/ranked OVR are not used.</p>
      </details>
    </div>

    <aside class="ovr-result" data-result>
      <div class="result-glow"></div>
      <span class="result-label">YOUR TEAM OVR</span>
      <div class="result-number" data-total>--</div>
      <p data-status>Complete your Starting XI to calculate.</p>
      <div class="result-breakdown"><div><span>Base OVR</span><b data-base-average>--</b></div><div><span>Rank</span><b data-rank-average>--</b></div><div><span>Badges</span><b data-badge-total>+0</b></div></div>
      <div class="result-equation" data-equation>11 players required</div>
    </aside>
  </div>
</section>

<script>
  import { calculateTeamOVR, createEmptyBadges } from '../../lib/teamOvr.js';
  const root = document.querySelector('[data-team-ovr]');
  if (root) {
    const starters = [...root.querySelectorAll('[data-player]')];
    const subs = root.querySelector('[data-subs]');
    const state = { substitutes: 0, badges: createEmptyBadges() };
    const addSub = root.querySelector('[data-add-sub]');
    const count = root.querySelector('[data-count]');

    function renderSubstitute() {
      if (state.substitutes >= 7) return;
      state.substitutes += 1;
      const id = state.substitutes;
      const row = document.createElement('article');
      row.className = 'player-row substitute-row';
      row.dataset.subPlayer = String(id);
      row.innerHTML = `<div class="player-pos"><span>SUB</span><b>${id}</b></div><label>Base OVR<input data-base type="number" min="1" max="122" inputmode="numeric" placeholder="117" aria-label="Substitute ${id} Base OVR"></label><label>Rank<select data-rank aria-label="Substitute ${id} Rank"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label><button type="button" class="remove-sub" aria-label="Remove substitute ${id}">×</button>`;
      subs.appendChild(row);
      row.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', update));
      row.querySelector('.remove-sub').addEventListener('click', () => { row.remove(); state.substitutes -= 1; [...subs.children].forEach((item, i) => item.querySelector('.player-pos b').textContent = String(i + 1)); update(); });
      update();
    }

    function readPlayers() {
      return [...root.querySelectorAll('[data-player], [data-sub-player]')].map((row) => ({ baseOVR: row.querySelector('[data-base]')?.value, rank: row.querySelector('[data-rank]')?.value })).filter((p) => p.baseOVR !== '');
    }

    function readBadges() {
      return [...root.querySelectorAll('[data-badge]')].map((select, index) => ({ id: select.value, level: root.querySelector(`[data-badge-level="${index}"]`)?.value || 0 })).filter((b) => b.id);
    }

    function update() {
      const players = readPlayers();
      const badges = readBadges();
      const result = calculateTeamOVR({ players, badges });
      const startersComplete = [...root.querySelectorAll('[data-player]')].every((row) => row.querySelector('[data-base]')?.value);
      count.textContent = `${players.length} / 11`;
      root.querySelector('[data-total]').textContent = result.complete ? result.teamOVR : '--';
      root.querySelector('[data-base-average]').textContent = result.complete ? result.baseAverage : '--';
      root.querySelector('[data-rank-average]').textContent = result.complete ? result.rankAverage : '--';
      root.querySelector('[data-badge-total]').textContent = `+${result.badgeBonus}`;
      root.querySelector('[data-detail-base]').textContent = result.baseTotal;
      root.querySelector('[data-detail-size]').textContent = result.squadSize;
      root.querySelector('[data-detail-rank]').textContent = result.rankTotal;
      root.querySelector('[data-detail-badge]').textContent = `+${result.badgeBonus}`;
      root.querySelector('[data-status]').textContent = result.complete ? `${result.squadSize}-player squad · Live calculation` : `${Math.max(0, 11 - players.length)} more player${players.length === 10 ? '' : 's'} needed`;
      root.querySelector('[data-equation]').textContent = result.complete ? `ceil(${result.baseTotal} ÷ ${result.squadSize}) + ceil(${result.rankTotal} ÷ ${result.squadSize}) + ${result.badgeBonus} = ${result.teamOVR}` : 'Complete the Starting XI to unlock your result';
      starters.forEach((row, index) => { const value = row.querySelector('[data-base]')?.value; const marker = root.querySelector(`[data-pitch-ovr="${index + 1}"]`); if (marker) marker.textContent = value || '--'; });
      root.querySelectorAll('[data-badge]').forEach((select, index) => { const level = Number(root.querySelector(`[data-badge-level="${index}"]`)?.value || 0); const badge = TEAM_BADGES.find((item) => item.id === select.value); const bonus = badge?.levels?.[level] || 0; root.querySelector(`[data-badge-bonus="${index}"]`).textContent = `Team OVR +${bonus}`; });
      addSub.disabled = state.substitutes >= 7;
      addSub.textContent = state.substitutes >= 7 ? 'Maximum reached' : '+ Add Substitute';
      if (startersComplete) root.querySelector('[data-status]').textContent = result.complete ? `${result.squadSize}-player squad · Live calculation` : 'Check your player values';
    }

    starters.forEach((row) => row.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', update)));
    root.querySelectorAll('[data-badge],[data-badge-level]').forEach((el) => el.addEventListener('change', update));
    addSub.addEventListener('click', renderSubstitute);
    root.querySelector('[data-reset]').addEventListener('click', () => { if (!confirm('Reset the entire squad and all badge selections?')) return; starters.forEach((row) => { row.querySelector('[data-base]').value = ''; row.querySelector('[data-rank]').value = '0'; }); subs.innerHTML = ''; state.substitutes = 0; root.querySelectorAll('[data-badge]').forEach((el) => el.value = ''); root.querySelectorAll('[data-badge-level]').forEach((el) => el.value = '0'); update(); });
    update();
  }
</script>

<style>
.ovr-tool{width:min(1240px,calc(100% - 32px));margin:0 auto;padding:56px 0 90px;color:#eaf7ff}.ovr-hero{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.ovr-kicker,.step,.result-label,.badge-limit{font:800 10px/1 var(--mono);letter-spacing:.16em;color:var(--blue)}.ovr-hero h1{font-size:clamp(42px,6vw,72px);line-height:.94;letter-spacing:-.06em;margin:13px 0 15px}.ovr-hero h1 span{color:var(--blue)}.ovr-lede{max-width:650px;color:#8fa5b7;margin:0;font-size:14px}.ovr-reset,.add-sub{border:1px solid #25465b;background:#0d1720;color:#dff7ff;border-radius:11px;padding:12px 15px;font:800 10px var(--mono);cursor:pointer;transition:.18s}.ovr-reset:hover,.add-sub:hover:not(:disabled){border-color:var(--blue);background:#102536;transform:translateY(-1px)}.add-sub:disabled{opacity:.45;cursor:not-allowed}.ovr-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px;align-items:start}.ovr-main{min-width:0}.ovr-card,.ovr-result{border:1px solid #1d3242;background:linear-gradient(145deg,#0d151d,#091017);border-radius:20px;box-shadow:0 20px 60px #0003}.ovr-card{padding:22px;margin-bottom:18px}.card-head,.subs-head{display:flex;align-items:center;justify-content:space-between;gap:18px}.card-head>div,.subs-head>div{display:flex;gap:12px;align-items:flex-start}.card-head h2,.subs-head h2{font-size:18px;margin:0}.card-head p,.subs-head p{color:#71889a;font-size:11px;margin:4px 0 0}.card-head>strong{font:800 11px var(--mono);color:#dff7ff;background:#10222e;padding:9px 11px;border-radius:9px}.step{display:grid;place-items:center;width:27px;height:27px;border:1px solid #23485d;border-radius:8px;font-size:8px;letter-spacing:0}.pitch-wrap{max-width:690px;margin:24px auto}.pitch{position:relative;aspect-ratio:1/1.36;overflow:hidden;border-radius:16px;border:1px solid #315c4d;background:#194e35}.pitch>img{width:100%;height:100%;object-fit:cover;opacity:.88}.pitch-lines{position:absolute;inset:0;background:linear-gradient(#fff0 49.7%,#ffffff55 50%,#fff0 50.3%);pointer-events:none}.pitch-player{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:#0a1720e8;border:2px solid var(--blue);box-shadow:0 5px 20px #0008;display:grid;place-items:center;align-content:center;gap:1px;cursor:default}.pitch-player span{font:800 8px var(--mono);color:#bfeeff}.pitch-player b{font:900 14px var(--mono);color:#fff}.player-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.player-row{position:relative;display:grid;grid-template-columns:58px minmax(0,1fr) 92px;gap:8px;align-items:end;padding:10px;border:1px solid #1a2b38;border-radius:12px;background:#0a1118}.player-row:focus-within{border-color:#4dc8ef77;box-shadow:0 0 0 2px #4dc8ef12}.player-pos{align-self:stretch;display:flex;flex-direction:column;justify-content:center;gap:3px}.player-pos span{font:700 8px var(--mono);color:#5f778a}.player-pos b{font:900 12px var(--mono);color:#c9e9f6}.player-row label{font:700 8px var(--mono);color:#667e90;text-transform:uppercase;letter-spacing:.08em}.player-row input,.player-row select,.badge-slot select{width:100%;margin-top:5px;height:39px;border:1px solid #243b4b;border-radius:8px;background:#0e1922;color:#edfaff;padding:0 10px;font:800 12px var(--mono);outline:none}.player-row input:focus,.player-row select:focus,.badge-slot select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55c7f218}.player-row input::placeholder{color:#3e596b}.subs-head{margin:25px 0 13px;padding-top:22px;border-top:1px solid #182a36}.sub-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.sub-list:empty:after{content:'No substitutes added. Starting XI only.';grid-column:1/-1;color:#526a7b;font-size:11px;border:1px dashed #1d3545;border-radius:11px;padding:15px;text-align:center}.substitute-row{grid-template-columns:50px minmax(0,1fr) 80px 30px}.remove-sub{width:30px;height:39px;border:1px solid #263b48;background:#101a22;color:#91a9b9;border-radius:8px;cursor:pointer;font-size:18px}.remove-sub:hover{color:#fff;border-color:#6a8a9d}.badge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.badge-slot{display:block;padding:13px;border:1px solid #1a303e;border-radius:13px;background:#0a1219}.badge-slot>span{font:800 8px var(--mono);color:#688094;text-transform:uppercase;letter-spacing:.1em}.badge-slot small{display:block;color:var(--blue);font:800 9px var(--mono);margin-top:8px}.explain-card summary{cursor:pointer;font-weight:850;font-size:14px}.math-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.math-grid div{padding:12px;border-radius:10px;background:#0a1219;border:1px solid #182b38}.math-grid span{display:block;color:#637b8e;font:700 8px var(--mono);text-transform:uppercase}.math-grid b{display:block;margin-top:6px;font:900 15px var(--mono)}.formula{padding:14px;background:#0a1921;border-left:2px solid var(--blue);color:#b5d8e7;font-size:11px;line-height:1.7}.note{color:#657e90;font-size:10px;line-height:1.7;margin-bottom:0}.ovr-result{position:sticky;top:92px;padding:27px 22px;overflow:hidden;text-align:center}.result-glow{position:absolute;width:190px;height:190px;left:50%;top:-100px;transform:translateX(-50%);background:#55c7f222;filter:blur(25px);border-radius:50%}.result-label{position:relative}.result-number{position:relative;font:900 86px/.95 var(--mono);letter-spacing:-.08em;margin:22px 0 13px;color:#f4fbff;text-shadow:0 0 30px #55c7f255}.ovr-result>p{position:relative;color:#7890a1;font-size:10px;min-height:32px}.result-breakdown{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #1d3341;border-bottom:1px solid #1d3341;margin-top:20px}.result-breakdown div{padding:14px 4px}.result-breakdown div+div{border-left:1px solid #1d3341}.result-breakdown span{display:block;color:#62798b;font:700 7px var(--mono);text-transform:uppercase}.result-breakdown b{display:block;margin-top:5px;font:900 17px var(--mono)}.result-equation{margin-top:16px;color:#597184;font:700 8px/1.6 var(--mono)}
@media(max-width:900px){.ovr-layout{grid-template-columns:1fr}.ovr-result{position:relative;top:auto;order:-1}.result-number{font-size:72px}.ovr-result{display:grid;grid-template-columns:1fr 1.2fr;gap:4px 18px;text-align:left;align-items:center}.result-label{grid-column:1}.result-number{grid-column:1}.ovr-result>p{grid-column:2;grid-row:1/3}.result-breakdown{grid-column:1/-1}.result-equation{grid-column:1/-1;text-align:center}}
@media(max-width:620px){.ovr-tool{width:min(100% - 20px,1240px);padding:34px 0 60px}.ovr-hero{align-items:flex-start;flex-direction:column}.ovr-hero h1{font-size:43px}.ovr-reset{width:100%}.ovr-card{padding:15px;border-radius:16px}.card-head,.subs-head{align-items:flex-start}.card-head>strong{font-size:9px}.pitch-wrap{margin:18px auto}.pitch-player{width:43px;height:43px}.pitch-player span{font-size:7px}.pitch-player b{font-size:11px}.player-list,.sub-list{grid-template-columns:1fr}.player-row{grid-template-columns:52px minmax(0,1fr) 82px}.substitute-row{grid-template-columns:45px minmax(0,1fr) 76px 30px}.badge-grid{grid-template-columns:1fr}.math-grid{grid-template-columns:1fr 1fr}.ovr-result{grid-template-columns:1fr;text-align:center}.result-label,.result-number,.ovr-result>p,.result-breakdown,.result-equation{grid-column:auto;grid-row:auto}.result-number{font-size:70px;margin:15px 0 5px}.result-breakdown{width:100%}.subs-head{flex-direction:column}.add-sub{width:100%}}
</style>
