<script>
const root = document.querySelector('[data-fcx]');
if (root) {
  const KEY = 'tanzimfc-football-centre-v2';
  const defaults = { score: 0, matches: {}, history: [] };
  const load = () => { try { return { ...defaults, ...(JSON.parse(localStorage.getItem(KEY) || '{}')) }; } catch { return { ...defaults }; } };
  let state = load();
  const save = () => localStorage.setItem(KEY, JSON.stringify(state));
  const render = () => {
    const values = root.querySelectorAll('[data-score],[data-score-card]'); values.forEach(el => el.textContent = state.score.toLocaleString());
    const played = Object.keys(state.matches).length;
    root.querySelectorAll('[data-played],[data-played-card]').forEach(el => el.textContent = played);
    const pct = Math.min(100, Math.round(state.score / 40));
    root.querySelectorAll('[data-percent]').forEach(el => el.textContent = pct + '%');
    root.querySelectorAll('[data-progress]').forEach(el => el.style.width = pct + '%');
    root.querySelectorAll('[data-needed]').forEach(el => el.textContent = Math.max(0, 4000 - state.score).toLocaleString());
    const picks = Object.values(state.matches);
    const accuracy = picks.length ? Math.round((picks.filter(x => x === 'correct').length / picks.length) * 100) : 0;
    root.querySelectorAll('[data-accuracy]').forEach(el => el.textContent = accuracy + '%');
    root.querySelectorAll('[data-interactive-match]').forEach(card => { const value = state.matches[card.dataset.interactiveMatch]; card.querySelectorAll('[data-pick]').forEach(b => b.classList.toggle('selected', b.dataset.pick === value)); });
    if (root.dataset.page === 'history') {
      const list = root.querySelector('[data-history]'); const empty = root.querySelector('[data-empty-history]');
      list.innerHTML = state.history.map(item => `<div class="fcx-card fcx-copy" style="padding:13px"><div style="display:flex;justify-content:space-between;gap:10px"><strong>${item.fixture}</strong><b style="color:#55c7f8">${item.points > 0 ? '+' : ''}${item.points}</b></div><small style="color:#718697">Prediction: ${item.pick} · ${item.date}</small></div>`).join(''); empty.style.display = state.history.length ? 'none' : 'grid';
    }
  };
  root.querySelectorAll('[data-interactive-match]').forEach(card => card.querySelectorAll('[data-pick]').forEach(button => button.addEventListener('click', () => {
    const id = card.dataset.interactiveMatch; const pick = button.dataset.pick; const previous = state.matches[id];
    if (!previous) { state.score += 100; state.history.unshift({ fixture: id === 'fulham-palace' ? 'Fulham vs Crystal Palace' : 'Arsenal vs Chelsea', pick, points: 100, date: new Date().toLocaleDateString() }); }
    state.matches[id] = pick; save(); render();
  })));
  root.querySelector('[data-export]')?.addEventListener('click', () => { const blob = new Blob([JSON.stringify(state, null, 2)], { type:'application/json' }); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'football-centre-backup.json'; a.click(); URL.revokeObjectURL(a.href); });
  root.querySelector('[data-reset]')?.addEventListener('click', () => { if (confirm('Reset Football Centre progress?')) { state = { ...defaults, matches:{}, history:[] }; save(); render(); } });
  render();
}
</script>