---
const page = Astro.props.page ?? 'dashboard';
const nav = [['dashboard','Overview','/football-centre'],['matches','Matches','/football-centre/matches'],['rewards','Rewards','/football-centre/rewards'],['analysis','Analysis','/football-centre/analysis'],['history','History','/football-centre/history'],['settings','Settings','/football-centre/settings']];
---
<div class="fcx" data-fcx data-page={page}>
<div class="fcx-shell">
<header class="fcx-header"><div><span class="label">FC MOBILE · FOOTBALL CENTRE</span><h1>{page === 'dashboard' ? 'Overview' : page[0].toUpperCase()+page.slice(1)}</h1><p>Real Showdown tracking, points, rewards and event updates.</p></div><div class="balance"><span>AVAILABLE</span><b data-balance>0</b><small>PTS</small></div></header>
<nav class="tabs">{nav.map(([k,n,h])=><a class:active={page===k} href={h}>{n}</a>)}</nav>
{page==='dashboard' && <main class="page">
<section class="hero"><div><span class="label">SEPTEMBER 2026 · ACTIVE CYCLE</span><h2>Your Football Centre</h2><p>Make your prediction first. When the real result is recorded, the calculator awards points based on what actually happened.</p></div><div class="hero-score"><b data-balance>0</b><span>POINTS</span></div><div class="bar"><i data-progress></i></div><div class="meta"><span><b data-played>0</b> / 2 SHOWDOWNS RESOLVED</span><span><b data-earned>0</b> EARNED</span></div></section>
<section class="grid four"><article class="card"><span>Balance</span><b data-balance>0</b><small>available</small></article><article class="card"><span>Earned</span><b data-earned>0</b><small>this cycle</small></article><article class="card"><span>Spent</span><b data-spent>0</b><small>rewards</small></article><article class="card"><span>Accuracy</span><b data-accuracy>0%</b><small>resolved picks</small></article></section>
<section class="section-title"><div><span class="label">FIRST SHOWDOWN</span><h2>Choose your team</h2></div><span class="chip">PREDICTION → RESULT</span></section>
<section class="grid two"><div class="match"><div class="matchtop"><span>SHOWDOWN 01 · PREMIER LEAGUE</span><b>MAN UTD · MAN CITY</b></div><div class="teams"><div><img src="https://upload.wikimedia.org/wikipedia/commons/7/7a/Manchester_United_FC_crest.svg" alt="Manchester United crest"/><strong>Manchester United</strong></div><em>VS</em><div><img src="https://upload.wikimedia.org/wikipedia/commons/e/e0/Manchester_City_FC_badge.svg" alt="Manchester City crest"/><strong>Manchester City</strong></div></div><a class="open" href="/football-centre/matches">Make prediction →</a></div><div class="match"><div class="matchtop"><span>SHOWDOWN 02 · LIGUE 1</span><b>RENNES · MARSEILLE</b></div><div class="teams"><div><img src="https://upload.wikimedia.org/wikipedia/en/6/6d/Stade_Rennais_FC.svg" alt="Rennes crest"/><strong>Stade Rennais FC</strong></div><em>VS</em><div><img src="https://upload.wikimedia.org/wikipedia/commons/d/d8/Olympique_Marseille_logo.svg" alt="Olympique de Marseille crest"/><strong>Olympique de Marseille</strong></div></div><a class="open" href="/football-centre/matches">Make prediction →</a></div></section>
</main>}
{page==='matches' && <main class="page"><section class="section-title"><div><span class="label">MATCH CENTRE</span><h2>Predictions and results</h2><p>There are always two separate actions: choose your prediction, then record the actual result. Points are locked until the result is entered.</p></div></section><div class="match-list">
{[['mufc-mancity','Manchester United','Manchester City','https://upload.wikimedia.org/wikipedia/commons/7/7a/Manchester_United_FC_crest.svg','https://upload.wikimedia.org/wikipedia/commons/e/e0/Manchester_City_FC_badge.svg'],['rennes-marseille','Stade Rennais FC','Olympique de Marseille','https://upload.wikimedia.org/wikipedia/en/6/6d/Stade_Rennais_FC.svg','https://upload.wikimedia.org/wikipedia/commons/d/d8/Olympique_Marseille_logo.svg']].map(([id,home,away,hl,al],i)=><article class="match full" data-match={id}><div class="matchtop"><span>SHOWDOWN 0{i+1}</span><b data-status>AWAITING PREDICTION</b></div><div class="teams"><div><img src={hl} alt={`${home} crest`}/><strong>{home}</strong></div><em>VS</em><div><img src={al} alt={`${away} crest`}/><strong>{away}</strong></div></div><div class="step"><span>1</span><div><b>Make your prediction</b><small>Select who you think will win, or choose Draw.</small></div></div><div class="choices"><button data-pick="home">{home}</button><button data-pick="draw">Draw</button><button data-pick="away">{away}</button></div><div class="step"><span>2</span><div><b>Enter the actual result</b><small>Only after the real match is finished.</small></div></div><div class="results"><button data-result="home">{home} won</button><button data-result="draw">Draw</button><button data-result="away">{away} won</button><button data-result="not_played">Not played</button></div><div class="outcome" data-outcome>Select a prediction first.</div><div class="rules"><span>Played +100</span><span>Correct +500</span><span>Draw/lost prediction +100</span><span>World Class +20</span></div></article>)}
</div></main>}
{page==='rewards' && <main class="page"><section class="section-title"><div><span class="label">REWARD STORE</span><h2>Football Centre rewards</h2><p>Claims subtract from your balance and are recorded in the points ledger.</p></div></section><section class="reward-balance card"><span>AVAILABLE BALANCE</span><b data-balance>0</b><small>PTS</small></section><section class="grid two rewards">
{[['player','120–122 OVR Player','4,000','1×','fc_c2_IMG_FC_C02_04'],['draft','FC Draft Voucher','300','3×','fc_c2_IMG_FC_C02_05'],['gems','Gems','100','10×','fc_c2_IMG_FC_C02_06'],['rank','Rank Up Points','100','50×','fc_c2_IMG_FC_C02_07']].map(([id,name,cost,limit,img])=><article class="reward card"><div class="reward-art"><img src={`/assets/images/${img}.png`} alt="" onerror="this.style.display='none'"/><span>{id==='player'?'OVR':'FC'}</span></div><div><span class="label">REWARD</span><h3>{name}</h3><p>{cost} Football Centre Points · Limit {limit}</p></div><button data-reward={cost} data-reward-name={name} data-reward-limit={limit}>Claim reward</button></article>)}
</section></main>}
{page==='analysis' && <main class="page"><section class="section-title"><div><span class="label">MATCH ANALYSIS</span><h2>Think before you pick</h2><p class="warning">⚠ Pick at your own risk. Analysis is informational only, not a guarantee of the result. Football is unpredictable and no prediction here is certain.</p></div></section><section class="analysis"><div class="video"><iframe src="https://www.youtube.com/embed/KvgulT3RtFE" title="Football Centre update and TOTW timing" loading="lazy" allowfullscreen></iframe></div><div class="card"><span class="label">PLAYER FOCUS</span><h3>Form is not a guarantee</h3><p>Use player form, role, matchup and team context as signals only. A strong player can have a quiet game and an underdog can win.</p><div class="player-mini"><b>Bruno Fernandes</b><span>Manchester United · CAM</span></div><div class="player-mini"><b>Erling Haaland</b><span>Manchester City · ST</span></div><div class="player-mini"><b>Amine Gouiri</b><span>Rennes · ST</span></div><div class="player-mini"><b>Mason Greenwood</b><span>Marseille · RW</span></div></div></section></main>}
{page==='history' && <main class="page"><section class="section-title"><div><span class="label">POINT LEDGER</span><h2>History</h2><p>Earned points and spent points are kept separate.</p></div></section><section class="grid two"><article class="card"><span>September 2026</span><h3>Active cycle</h3><b data-earned>0</b><small>earned this cycle</small></article><article class="card"><span>Previous cycles</span><h3>Protected history</h3><p>Older cycles are kept separate from the current event.</p></article></section><article class="card ledger"><h3>Recent transactions</h3><div data-ledger><div class="empty">No transactions yet.</div></div></article></main>}
{page==='settings' && <main class="page"><section class="section-title"><div><span class="label">CONTROL CENTRE</span><h2>Settings</h2><p>Manage personal progress only. Event fixtures and reward rules are not editable here.</p></div></section><section class="grid two"><article class="card setting"><span class="label">STARTING BALANCE</span><h3>Points you already own</h3><p>Use this when a new cycle begins with points from an existing balance.</p><div class="row"><input data-starting type="number" min="0"/><button data-save-start>Save</button></div></article><article class="card setting"><span class="label">SCORING</span><h3>Current rules</h3><div class="rules vertical"><span>+100 Showdown played</span><span>+500 correct prediction</span><span>+100 draw/lost prediction</span><span>+20 World Class play</span></div></article><article class="card setting"><span class="label">BACKUP</span><h3>Protect your progress</h3><p>Export the complete local data set including predictions, results, claims and ledger.</p><div class="row"><button data-export>Export JSON</button><button data-reset class="danger">Reset</button></div></article></section></main>}
</div></div>
<script is:inline>
(()=>{const root=document.currentScript?.previousElementSibling;if(!root?.matches('[data-fcx]'))return;const KEY='tanzimfc_football_centre_v11';const base={version:11,cycleId:'2026-09',startingBalance:0,matches:{},ledger:[],claims:{}};const oldKey='tanzimfc_football_centre_v10';let state;try{state=JSON.parse(localStorage.getItem(KEY)||'null')}catch{}if(!state||state.version!==11){let old=null;try{old=JSON.parse(localStorage.getItem(oldKey)||'null')}catch{};state={...base,startingBalance:Number(old?.startingBalance)||0};}const save=()=>localStorage.setItem(KEY,JSON.stringify(state));const totals=()=>{const e=state.ledger.filter(x=>x.type==='earned').reduce((a,x)=>a+x.amount,0),s=state.ledger.filter(x=>x.type==='spent').reduce((a,x)=>a+x.amount,0);return{earned:e,spent:s,balance:state.startingBalance+e-s}};const tx=(type,amount,description)=>{state.ledger.push({id:crypto.randomUUID?.()||String(Date.now()),type,amount,description,date:new Date().toISOString()});save()};const render=()=>{const t=totals();root.querySelectorAll('[data-balance]').forEach(e=>e.textContent=t.balance.toLocaleString());root.querySelectorAll('[data-earned]').forEach(e=>e.textContent=t.earned.toLocaleString());root.querySelectorAll('[data-spent]').forEach(e=>e.textContent=t.spent.toLocaleString());const resolved=Object.values(state.matches).filter(m=>m.status==='resolved');root.querySelectorAll('[data-played]').forEach(e=>e.textContent=resolved.length);root.querySelectorAll('[data-progress]').forEach(e=>e.style.width=Math.min(100,resolved.length/2*100)+'%');const picks=resolved.filter(m=>m.prediction),correct=picks.filter(m=>m.prediction===m.result).length;root.querySelectorAll('[data-accuracy]').forEach(e=>e.textContent=picks.length?Math.round(correct/picks.length*100)+'%':'0%');root.querySelectorAll('[data-starting]').forEach(e=>e.value=state.startingBalance);const l=root.querySelector('[data-ledger]');if(l)l.innerHTML=state.ledger.length?state.ledger.slice().reverse().slice(0,12).map(x=>`<div class="ledger-row"><b class="${x.type}">${x.type==='earned'?'+':'−'}${x.amount}</b><span>${x.description}</span><small>${new Date(x.date).toLocaleDateString()}</small></div>`).join(''):'<div class="empty">No transactions yet.</div>';root.querySelectorAll('[data-match]').forEach(card=>{const m=state.matches[card.dataset.match];if(!m)return;card.querySelectorAll('[data-pick]').forEach(b=>b.classList.toggle('selected',b.dataset.pick===m.prediction));card.querySelectorAll('[data-result]').forEach(b=>b.classList.toggle('selected',b.dataset.result===m.result));const st=card.querySelector('[data-status]');if(st)st.textContent=!m.prediction?'AWAITING PREDICTION':m.status==='resolved'?'RESOLVED':'AWAITING RESULT';const o=card.querySelector('[data-outcome]');if(o){o.textContent=!m.prediction?'Select a prediction first.':!m.result?'Prediction saved. Enter the actual result after the match.':m.result==='not_played'?'Match not played. No points awarded.':m.prediction===m.result?'Correct prediction · points awarded.':'Prediction missed · consolation points awarded.'}})};root.querySelectorAll('[data-pick]').forEach(b=>b.addEventListener('click',()=>{const c=b.closest('[data-match]'),id=c?.dataset.match;if(!id)return;state.matches[id]={...(state.matches[id]||{}),prediction:b.dataset.pick,status:'predicted',result:null};save();render()}));root.querySelectorAll('[data-result]').forEach(b=>b.addEventListener('click',()=>{const c=b.closest('[data-match]'),id=c?.dataset.match,m=state.matches[id];if(!m?.prediction){alert('Choose your prediction first.');return}if(m.status==='resolved'){alert('This result is already recorded.');return}m.result=b.dataset.result;m.status='resolved';save();if(b.dataset.result!=='not_played'){tx('earned',100,`Showdown played · ${id}`);tx('earned',m.prediction===m.result?500:100,m.prediction===m.result?`Correct prediction · ${id}`:`Prediction missed · ${id}`);tx('earned',20,`World Class play · ${id}`)}render()}));root.querySelectorAll('[data-reward]').forEach(b=>b.addEventListener('click',()=>{const cost=Number(b.dataset.reward),name=b.dataset.rewardName,limit=Number(b.dataset.rewardLimit),count=Number(state.claims[name]||0);if(count>=limit){alert(`You reached the ${limit}× limit for ${name}.`);return}if(totals().balance<cost){alert('Not enough Football Centre points.');return}if(!confirm(`Claim ${name} for ${cost.toLocaleString()} points?`))return;state.claims[name]=count+1;tx('spent',cost,`Reward claimed · ${name} (${state.claims[name]}/${limit})`);const toast=document.createElement('div');toast.className='claim-toast';toast.innerHTML='<b>Reward claimed</b><span>Points deducted and claim saved.</span>';document.body.appendChild(toast);setTimeout(()=>toast.classList.add('show'),20);setTimeout(()=>toast.remove(),2400);render()}));root.querySelector('[data-save-start]')?.addEventListener('click',()=>{state.startingBalance=Math.max(0,Number(root.querySelector('[data-starting]')?.value)||0);save();render()});root.querySelector('[data-export]')?.addEventListener('click',()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));a.download=`football-centre-${state.cycleId}-backup.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)});root.querySelector('[data-reset]')?.addEventListener('click',()=>{if(confirm('Reset this browser’s Football Centre progress?')){state={...base};save();render()}});render()})();
</script>
<style>
.fcx{--bg:#06090d;--panel:#0c1117;--panel2:#111922;--line:#1d2933;--text:#f1f7fa;--muted:#8b9aa6;--blue:#61c7f5;--blue2:#2aa8e7;--green:#55d79a;--red:#ff7081;color:var(--text);background:radial-gradient(900px 450px at 0 0,#61c7f50b,transparent 60%),var(--bg);min-height:720px;padding:25px 0 60px;font:13px/1.5 Inter,system-ui,sans-serif}.fcx *{box-sizing:border-box}.fcx-shell{width:min(1180px,calc(100% - 28px));margin:auto}.fcx-header{display:flex;justify-content:space-between;align-items:center;gap:18px}.label{color:var(--blue);font-size:9px;font-weight:900;letter-spacing:.14em}.fcx h1{font-size:30px;margin:4px 0}.fcx h2{font-size:23px;margin:4px 0}.fcx p{color:var(--muted);font-size:10px;margin:4px 0}.balance{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:8px 12px;display:grid;grid-template-columns:auto auto;gap:2px 5px}.balance span{grid-column:1/-1;font-size:8px;color:var(--muted);letter-spacing:.12em}.balance b{font-size:18px}.balance small{color:var(--blue);font-weight:900}.tabs{display:flex;overflow:auto;border-bottom:1px solid var(--line);margin:20px 0;padding:0;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}.tabs a{padding:10px 13px;color:var(--muted);font-weight:800;font-size:10px;border-bottom:2px solid transparent;white-space:nowrap}.tabs a:hover,.tabs a.active{color:var(--blue);border-color:var(--blue);background:#61c7f508}.page{display:grid;gap:17px}.hero,.card,.match{border:1px solid var(--line);background:linear-gradient(145deg,#0e151c,#0a0f14);border-radius:16px}.hero{display:grid;grid-template-columns:1fr auto;gap:16px;padding:21px}.hero-score{text-align:right}.hero-score b{display:block;color:var(--blue);font-size:40px;line-height:1}.hero-score span{font-size:8px;color:var(--muted)}.bar{grid-column:1/-1;height:8px;background:#17222b;border-radius:99px;overflow:hidden}.bar i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--blue2),var(--blue));transition:.25s}.meta{grid-column:1/-1;display:flex;justify-content:space-between;color:var(--muted);font-size:8px}.grid{display:grid;gap:11px}.four{grid-template-columns:repeat(4,1fr)}.two{grid-template-columns:repeat(2,1fr)}.card{padding:15px}.card>span:not(.label){display:block;color:var(--muted);font-size:8px;text-transform:uppercase;letter-spacing:.1em}.card>b{display:block;font-size:24px;margin:5px 0}.card small{color:var(--muted);font-size:9px}.section-title{display:flex;justify-content:space-between;align-items:end;gap:12px}.chip{border:1px solid #61c7f544;color:var(--blue);padding:5px 8px;border-radius:99px;font-size:8px;font-weight:900}.match{padding:14px;transition:.18s}.match:hover,.card:hover{border-color:#61c7f566;background:#0f171f}.matchtop{display:flex;justify-content:space-between;color:var(--muted);font-size:8px;font-weight:900;letter-spacing:.07em}.matchtop b{color:var(--blue)}.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;padding:24px 3px;text-align:center}.teams div strong{display:block;font-size:12px;margin-top:7px}.teams img{width:58px;height:58px;object-fit:contain;display:block;margin:auto}.teams em{font-style:normal;color:#5c6c78;font-size:9px;font-weight:900}.open{display:block;text-align:center;border-top:1px solid var(--line);padding-top:10px;color:var(--blue);font-size:9px;font-weight:900}.match-list{display:grid;gap:12px}.full{padding:16px}.step{display:flex;gap:10px;align-items:center;border-top:1px solid var(--line);padding:12px 0 8px}.step>span{width:24px;height:24px;border:1px solid #61c7f555;color:var(--blue);border-radius:8px;display:grid;place-items:center;font-weight:900;font-size:9px}.step b{display:block;font-size:10px}.step small{color:var(--muted);font-size:8px}.choices,.results{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.results{grid-template-columns:repeat(4,1fr)}button{border:1px solid var(--line);background:#10171e;color:var(--text);padding:9px 7px;border-radius:9px;cursor:pointer;font-size:9px;font-weight:800}button:hover,button.selected{border-color:#61c7f577;background:#61c7f50d;color:var(--blue)}.outcome{margin-top:10px;padding:10px;border-radius:9px;background:#080d12;color:var(--muted);font-size:9px}.rules{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px;color:var(--muted);font-size:8px}.vertical{display:grid;gap:7px}.warning{border:1px solid #e8bd6244;background:#e8bd620b;color:#d9c18e!important;padding:11px;border-radius:10px}.analysis{display:grid;grid-template-columns:1.35fr .65fr;gap:12px}.video{aspect-ratio:16/9;border:1px solid var(--line);border-radius:15px;overflow:hidden;background:#000}.video iframe{width:100%;height:100%;border:0}.player-mini{padding:9px 0;border-top:1px solid var(--line)}.player-mini b,.player-mini span{display:block}.player-mini b{font-size:10px}.player-mini span{font-size:8px;color:var(--muted)}.reward-balance{display:flex;align-items:end;gap:7px}.reward-balance b{font-size:30px}.rewards{grid-template-columns:1fr 1fr}.reward{display:grid;grid-template-columns:90px 1fr auto;align-items:center;gap:14px}.reward-art{height:90px;border-radius:11px;background:#101b23;border:1px solid #61c7f533;display:grid;place-items:center;position:relative}.reward-art img{max-width:82px;max-height:82px;object-fit:contain}.reward-art span{font-size:18px;color:var(--blue);font-weight:950}.reward h3{margin:4px 0;font-size:13px}.reward p{font-size:9px}.ledger{padding:16px}.ledger-row{display:grid;grid-template-columns:75px 1fr auto;gap:8px;border-top:1px solid var(--line);padding:10px 0;font-size:9px}.ledger-row b.earned{color:var(--green)}.ledger-row b.spent{color:var(--red)}.ledger-row small{color:var(--muted)}.empty{padding:16px;text-align:center;color:var(--muted);font-size:9px}.row{display:flex;gap:7px;margin-top:10px}.row input{flex:1;min-width:0;background:#080d12;border:1px solid var(--line);color:var(--text);border-radius:9px;padding:9px}.danger{color:var(--red)}.claim-toast{position:fixed;right:22px;bottom:22px;z-index:9999;display:grid;gap:3px;padding:13px 16px;border:1px solid #61c7f566;background:#0d151c;color:var(--text);border-radius:12px;box-shadow:0 15px 40px #0008;transform:translateY(15px);opacity:0;transition:.25s}.claim-toast.show{transform:none;opacity:1}.claim-toast b{color:var(--blue);font-size:11px}.claim-toast span{color:var(--muted);font-size:9px}@media(max-width:800px){.four{grid-template-columns:repeat(2,1fr)}.analysis{grid-template-columns:1fr}.rewards{grid-template-columns:1fr}.reward{grid-template-columns:80px 1fr}.reward button{grid-column:1/-1}.hero{grid-template-columns:1fr}.hero-score{text-align:left}.two{grid-template-columns:1fr}.results{grid-template-columns:1fr 1fr}}@media(max-width:520px){.fcx{padding-top:15px}.fcx-shell{width:calc(100% - 18px)}.four{grid-template-columns:1fr 1fr}.teams{padding:17px 0}.teams img{width:45px;height:45px}.choices{grid-template-columns:1fr}.meta{gap:10px;flex-direction:column}.section-title{align-items:start}}
</style>