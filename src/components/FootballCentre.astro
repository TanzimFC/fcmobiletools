---
const page = Astro.props.page ?? 'dashboard';
const pages = [
  ['dashboard', 'Overview', '/football-centre'],
  ['matches', 'Matches', '/football-centre/matches'],
  ['players', 'Players', '/football-centre/players'],
  ['rewards', 'Rewards', '/football-centre/rewards'],
  ['analysis', 'Analysis', '/football-centre/analysis'],
  ['history', 'History', '/football-centre/history'],
  ['settings', 'Settings', '/football-centre/settings']
];
const titles = { dashboard: 'Overview', matches: 'Matches', players: 'Players', rewards: 'Rewards', analysis: 'Analysis', history: 'History', settings: 'Settings' };
---

<div class="fcx" data-fcx data-page={page}>
  <div class="fcx-shell">
    <header class="fcx-header">
      <div>
        <div class="fcx-kicker">FC MOBILE · FOOTBALL CENTRE</div>
        <h1>{titles[page] ?? 'Overview'}</h1>
        <p>Track Showdowns, predictions, points, players and monthly cycles.</p>
      </div>
      <div class="fcx-balance"><span>AVAILABLE</span><strong data-balance>0</strong><small>PTS</small></div>
    </header>

    <nav class="fcx-tabs" aria-label="Football Centre navigation">
      {pages.map(([key, label, href]) => <a class:active={page === key} href={href}>{label}</a>)}
    </nav>

    {page === 'dashboard' && <main class="fcx-page">
      <section class="fcx-hero">
        <div class="fcx-hero-copy"><span class="fcx-label">SEPTEMBER 2026 · ACTIVE CYCLE</span><h2>Football Centre progress</h2><p>Keep your current balance, monthly progress and next Showdown in one place.</p></div>
        <div class="fcx-big-number"><strong data-balance>0</strong><span>POINTS BALANCE</span></div>
        <div class="fcx-progress"><span data-progress></span></div>
        <div class="fcx-progress-meta"><span><b data-played>0</b> / <b data-total>8</b> SHOWDOWNS PLAYED</span><span><b data-cycle-earned>0</b> EARNED THIS CYCLE</span></div>
      </section>

      <section class="fcx-grid fcx-grid-4">
        <article class="fcx-card stat"><span>Balance</span><strong data-balance>0</strong><small>available points</small></article>
        <article class="fcx-card stat"><span>Earned</span><strong data-earned>0</strong><small>this cycle</small></article>
        <article class="fcx-card stat"><span>Spent</span><strong data-spent>0</strong><small>rewards claimed</small></article>
        <article class="fcx-card stat"><span>Accuracy</span><strong data-accuracy>0%</strong><small>predictions</small></article>
      </section>

      <section class="fcx-section-head"><div><span class="fcx-label">NEXT SHOWDOWN</span><h2>Matchday 1</h2></div><span class="fcx-chip">2 FIXTURES</span></section>
      <section class="fcx-grid fcx-grid-2">
        <article class="fcx-match"><div class="fcx-match-head"><span>SHOWDOWN 01</span><b>PLAYED</b></div><div class="fcx-teams"><div class="fcx-team"><div class="crest">FUL</div><strong>Fulham</strong><small>Craven Cottage</small></div><div class="fcx-vs">VS</div><div class="fcx-team"><div class="crest">CRY</div><strong>Crystal Palace</strong><small>Selhurst Park</small></div></div><div class="fcx-match-foot"><span>Premier League</span><span>+500 correct</span></div></article>
        <article class="fcx-match"><div class="fcx-match-head"><span>SHOWDOWN 02</span><b>PLAYED</b></div><div class="fcx-teams"><div class="fcx-team"><div class="crest">ARS</div><strong>Arsenal</strong><small>Emirates Stadium</small></div><div class="fcx-vs">VS</div><div class="fcx-team"><div class="crest">CHE</div><strong>Chelsea</strong><small>Stamford Bridge</small></div></div><div class="fcx-match-foot"><span>Premier League</span><span>+500 correct</span></div></article>
      </section>

      <section class="fcx-grid fcx-grid-3 quick"><a class="fcx-card feature" href="/football-centre/matches"><i>01</i><strong>Make a prediction</strong><small>Choose a side or draw and save it instantly.</small></a><a class="fcx-card feature" href="/football-centre/players"><i>XI</i><strong>Player board</strong><small>Browse the new player watchlist.</small></a><a class="fcx-card feature" href="/football-centre/rewards"><i>PTS</i><strong>Spend points</strong><small>Claim rewards without losing your history.</small></a></section>
    </main>}

    {page === 'matches' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">MATCH CENTRE · SEPTEMBER 2026</span><h2>Showdowns</h2><p>Predictions and results are saved locally. Cancelled or unplayed games never count as losses.</p></div><span class="fcx-chip">8 SLOTS</span></section>
      <div class="fcx-day-list">
        <article class="fcx-day open"><button class="fcx-day-toggle" type="button"><span><b>MATCHDAY 1</b><small>2 fixtures · current cycle</small></span><strong>2 / 2</strong></button><div class="fcx-day-body">
          <article class="fcx-match interactive" data-match="fulham-palace"><div class="fcx-match-head"><span>SHOWDOWN 01 · PREMIER LEAGUE</span><b data-status>PLAYED</b></div><div class="fcx-teams"><div class="fcx-team"><div class="crest">FUL</div><strong>Fulham</strong></div><div class="fcx-vs">VS</div><div class="fcx-team"><div class="crest">CRY</div><strong>Crystal Palace</strong></div></div><div class="fcx-picks"><button type="button" data-pick="home">Fulham</button><button type="button" data-pick="draw">Draw</button><button type="button" data-pick="away">Crystal Palace</button></div><div class="fcx-match-note"><span>Played: +100</span><span>Correct: +500</span><span>World Class: +20</span></div></article>
          <article class="fcx-match interactive" data-match="arsenal-chelsea"><div class="fcx-match-head"><span>SHOWDOWN 02 · PREMIER LEAGUE</span><b data-status>PLAYED</b></div><div class="fcx-teams"><div class="fcx-team"><div class="crest">ARS</div><strong>Arsenal</strong></div><div class="fcx-vs">VS</div><div class="fcx-team"><div class="crest">CHE</div><strong>Chelsea</strong></div></div><div class="fcx-picks"><button type="button" data-pick="home">Arsenal</button><button type="button" data-pick="draw">Draw</button><button type="button" data-pick="away">Chelsea</button></div><div class="fcx-match-note"><span>Played: +100</span><span>Correct: +500</span><span>World Class: +20</span></div></article>
        </div></article>
        <article class="fcx-day"><button class="fcx-day-toggle" type="button"><span><b>MATCHDAY 2</b><small>Fixtures can be added with the next event update.</small></span><strong>0 / 2</strong></button><div class="fcx-day-body"><div class="fcx-placeholder">Upcoming fixtures will appear here. No empty match cards, no fake results.</div></div></article>
        <article class="fcx-day"><button class="fcx-day-toggle" type="button"><span><b>MATCHDAY 3</b><small>Waiting for event fixture data.</small></span><strong>0 / 2</strong></button><div class="fcx-day-body"><div class="fcx-placeholder">This matchday stays out of the score until real fixtures are added.</div></div></article>
        <article class="fcx-day"><button class="fcx-day-toggle" type="button"><span><b>MATCHDAY 4</b><small>Upcoming cycle slot.</small></span><strong>0 / 2</strong></button><div class="fcx-day-body"><div class="fcx-placeholder">This matchday stays out of the score until real fixtures are added.</div></div></article>
      </div>
    </main>}

    {page === 'players' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">PLAYER WATCH</span><h2>New player board</h2><p>Six player profiles built for the current Showdown cycle.</p></div><span class="fcx-chip">6 PLAYERS</span></section>
      <section class="fcx-player-grid">
        {[
          ['Bukayo Saka','Arsenal','RW','91','MATCH WINNER'],['Cole Palmer','Chelsea','CAM','90','CREATOR'],['Harry Wilson','Fulham','CAM','89','DELIVERY'],['Jean-Philippe Mateta','Crystal Palace','ST','88','TARGET'],['Martin Ødegaard','Arsenal','CM','89','CONTROL'],['Eberechi Eze','Crystal Palace','CAM','87','PROGRESSOR']
        ].map(([name,club,pos,rating,tag]) => <article class="fcx-player"><div class="player-card"><span>{tag}</span><b>{rating}</b><i>{pos}</i><div class="player-face">{name.split(' ').map(n => n[0]).join('').slice(0,2)}</div></div><strong>{name}</strong><small>{club} · {pos}</small><div class="player-meter"><span style={`width:${Math.min(96, Number(rating) - 10)}%`}></span></div><p>Impact profile · {tag.toLowerCase()}</p></article>)}
      </section>
    </main>}

    {page === 'rewards' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">REWARD STORE</span><h2>Spend Football Centre points</h2><p>Every claim becomes a ledger transaction, so your balance and history stay correct.</p></div></section>
      <section class="fcx-reward-balance fcx-card"><span>AVAILABLE BALANCE</span><strong data-balance>0</strong><small>PTS</small></section>
      <section class="fcx-grid fcx-grid-3 rewards">
        {[['TOTW Player','2,500','Featured weekly player card'],['Premium Pack','1,000','High-value reward pack'],['Event Pack','500','Quick Football Centre reward']].map(([name,cost,desc]) => <article class="fcx-card reward"><div class="reward-art">XI</div><span class="fcx-label">FOOTBALL CENTRE</span><h3>{name}</h3><p>{desc}</p><div class="reward-bottom"><strong>{cost} PTS</strong><button type="button" data-reward={cost} data-reward-name={name}>Claim</button></div></article>)}
      </section>
    </main>}

    {page === 'analysis' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">MATCH INTELLIGENCE</span><h2>Player analysis</h2><p>Role-first analysis for the four teams in the opening Showdown.</p></div></section>
      <section class="fcx-analysis-grid"><article class="fcx-video"><iframe src="https://www.youtube.com/embed/KvgulT3RtFE" title="FC Mobile Football Centre analysis" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></article><article class="fcx-card analysis-copy"><span class="fcx-label">WEEKLY READ</span><h3>Who can change the match?</h3><p>Saka and Palmer bring the highest attacking ceiling. Wilson and Eze offer creative progression, while Mateta provides a direct target and Ødegaard controls the tempo.</p><div class="analysis-list"><div><b>ARS</b><span>Saka · Ødegaard</span></div><div><b>CHE</b><span>Palmer</span></div><div><b>FUL</b><span>Wilson</span></div><div><b>CRY</b><span>Mateta · Eze</span></div></div></article></section>
      <section class="fcx-grid fcx-grid-3"><article class="fcx-card feature"><i>01</i><strong>Form</strong><small>Look at recent influence before selecting a prediction.</small></article><article class="fcx-card feature"><i>02</i><strong>Role</strong><small>Compare the player's role with the opponent's weak zone.</small></article><article class="fcx-card feature"><i>03</i><strong>Impact</strong><small>Prioritise players who can decide the game state.</small></article></section>
    </main>}

    {page === 'history' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">CYCLE ARCHIVE</span><h2>History</h2><p>Monthly cycles stay separate. Starting balances, earned points and spending never overwrite old records.</p></div></section>
      <section class="fcx-history-grid"><article class="fcx-card cycle-card active"><div><span class="fcx-label">ACTIVE</span><h3>September 2026</h3><p>Current Football Centre cycle</p></div><strong data-cycle-earned>0</strong><small>earned this cycle</small></article><article class="fcx-card cycle-card"><div><span class="fcx-label">ARCHIVED</span><h3>August 2026</h3><p>Previous cycle · preserved locally</p></div><strong>—</strong><small>No imported data yet</small></article></section>
      <section class="fcx-card ledger"><div class="fcx-section-head"><div><span class="fcx-label">POINT LEDGER</span><h3>Recent activity</h3></div></div><div data-ledger><div class="fcx-placeholder">No point transactions yet.</div></div></section>
    </main>}

    {page === 'settings' && <main class="fcx-page">
      <section class="fcx-section-head"><div><span class="fcx-label">CONTROL CENTRE</span><h2>Settings</h2><p>Manage your starting balance, cycle data and backup without changing event rules.</p></div></section>
      <section class="fcx-settings-grid">
        <article class="fcx-card setting"><span class="fcx-label">STARTING BALANCE</span><h3>Current cycle balance</h3><p>Enter points you already own when a new Football Centre cycle starts.</p><div class="setting-row"><input data-starting type="number" min="0" step="1" placeholder="0"/><button type="button" data-save-start>Save balance</button></div></article>
        <article class="fcx-card setting"><span class="fcx-label">EVENT RULES</span><h3>Scoring</h3><div class="rule-grid"><div><b>+100</b><span>Played Showdown</span></div><div><b>+500</b><span>Correct prediction</span></div><div><b>+100</b><span>Draw / lost prediction</span></div><div><b>+20</b><span>World Class play</span></div></div></article>
        <article class="fcx-card setting"><span class="fcx-label">CYCLE STRUCTURE</span><h3>September 2026</h3><div class="cycle-list"><div><b>Matchday 1</b><span>Fulham vs Crystal Palace · Arsenal vs Chelsea</span></div><div><b>Matchday 2</b><span>Awaiting real fixture data</span></div><div><b>Matchday 3</b><span>Awaiting real fixture data</span></div><div><b>Matchday 4</b><span>Awaiting real fixture data</span></div></div></article>
        <article class="fcx-card setting"><span class="fcx-label">BACKUP</span><h3>Your data</h3><p>Export your local Football Centre data before moving browser or device.</p><div class="setting-row"><button type="button" data-export>Export JSON</button><button type="button" data-reset class="danger">Reset progress</button></div></article>
      </section>
    </main>}
  </div>
</div>

<script is:inline>
(() => {
  const root = document.currentScript?.previousElementSibling;
  if (!root?.matches('[data-fcx]')) return;
  const KEY = 'tanzimfc_football_centre_v10';
  const MATCHES = {
    'fulham-palace': { home:'Fulham', away:'Crystal Palace', result:'away' },
    'arsenal-chelsea': { home:'Arsenal', away:'Chelsea', result:'home' }
  };
  const defaultState = { version:10, cycleId:'2026-09', startingBalance:0, matches:{}, ledger:[], claimed:[] };
  const load = () => { try { const old = JSON.parse(localStorage.getItem(KEY)); return old && old.version === 10 ? old : migrate(old); } catch { return {...defaultState}; } };
  const migrate = (old) => {
    if (!old || typeof old !== 'object') return {...defaultState};
    const next = {...defaultState, startingBalance:Number(old.startingBalance)||0, matches:{}, ledger:[], claimed:[]};
    const days = Array.isArray(old.days) ? old.days : [];
    days.flatMap(d => Array.isArray(d.games) ? d.games : []).forEach((g,i) => {
      if (g.home && g.away) next.matches[`legacy-${i}`] = { prediction:g.pick || null, status:g.result ? 'played' : 'upcoming', result:g.result || null };
    });
    return next;
  };
  let state = load();
  const save = () => localStorage.setItem(KEY, JSON.stringify(state));
  const sum = () => {
    const earned = state.ledger.filter(x=>x.type==='earned').reduce((a,x)=>a+x.amount,0);
    const spent = state.ledger.filter(x=>x.type==='spent').reduce((a,x)=>a+x.amount,0);
    return { earned, spent, balance: state.startingBalance + earned - spent };
  };
  const addTx = (type, amount, description) => { state.ledger.push({id:Date.now()+'-'+Math.random().toString(36).slice(2), type, amount, description, date:new Date().toISOString()}); save(); };
  const render = () => {
    const totals = sum();
    root.querySelectorAll('[data-balance]').forEach(e=>e.textContent=totals.balance.toLocaleString());
    root.querySelectorAll('[data-earned], [data-cycle-earned]').forEach(e=>e.textContent=totals.earned.toLocaleString());
    root.querySelectorAll('[data-spent]').forEach(e=>e.textContent=totals.spent.toLocaleString());
    const played = Object.values(state.matches).filter(m=>m.status==='played').length;
    root.querySelectorAll('[data-played]').forEach(e=>e.textContent=played);
    root.querySelectorAll('[data-accuracy]').forEach(e=>{ const decided=Object.values(state.matches).filter(m=>m.status==='played'&&m.prediction); const correct=decided.filter(m=>m.prediction===m.result).length; e.textContent=decided.length?Math.round(correct/decided.length*100)+'%':'0%'; });
    root.querySelectorAll('[data-progress]').forEach(e=>e.style.width=Math.min(100,played/8*100)+'%');
    root.querySelectorAll('[data-starting]').forEach(e=>e.value=state.startingBalance||'');
    const ledger = root.querySelector('[data-ledger]');
    if (ledger) ledger.innerHTML = state.ledger.length ? state.ledger.slice().reverse().slice(0,8).map(x=>`<div class="ledger-row"><span class="${x.type}">${x.type==='earned'?'+':'−'}${x.amount.toLocaleString()}</span><b>${x.description}</b><small>${new Date(x.date).toLocaleDateString()}</small></div>`).join('') : '<div class="fcx-placeholder">No point transactions yet.</div>';
    root.querySelectorAll('[data-match]').forEach(card=>{ const id=card.dataset.match; const m=state.matches[id]; if(!m) return; const status=card.querySelector('[data-status]'); if(status) status.textContent=m.status==='played'?'PLAYED':'UPCOMING'; card.querySelectorAll('[data-pick]').forEach(b=>b.classList.toggle('selected',b.dataset.pick===m.prediction)); });
  };
  root.querySelectorAll('.fcx-day-toggle').forEach(btn=>btn.addEventListener('click',()=>btn.closest('.fcx-day')?.classList.toggle('open')));
  root.querySelectorAll('[data-pick]').forEach(btn=>btn.addEventListener('click',()=>{ const card=btn.closest('[data-match]'); if(!card) return; const id=card.dataset.match; const match=MATCHES[id]; state.matches[id]={prediction:btn.dataset.pick,status:'played',result:match.result}; const already=state.ledger.some(x=>x.description===`Played ${match.home} vs ${match.away}`); if(!already){addTx('earned',100,`Played ${match.home} vs ${match.away}`); if(btn.dataset.pick===match.result) addTx('earned',500,`Correct prediction · ${match.home} vs ${match.away}`); else addTx('earned',100,`Prediction bonus · ${match.home} vs ${match.away}`); addTx('earned',20,`World Class · ${match.home} vs ${match.away}`);} save(); render(); }));
  root.querySelectorAll('[data-reward]').forEach(btn=>btn.addEventListener('click',()=>{ const cost=Number(btn.dataset.reward); const name=btn.dataset.rewardName; if(sum().balance<cost){alert('Not enough Football Centre points.');return;} if(!confirm(`Claim ${name} for ${cost.toLocaleString()} points?`)) return; state.claimed.push({name,cost,date:new Date().toISOString()}); addTx('spent',cost,`Reward claimed · ${name}`); render(); }));
  root.querySelector('[data-save-start]')?.addEventListener('click',()=>{ const input=root.querySelector('[data-starting]'); state.startingBalance=Math.max(0,Number(input?.value)||0); save(); render(); });
  root.querySelector('[data-export]')?.addEventListener('click',()=>{ const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`football-centre-${state.cycleId}-backup.json`; a.click(); URL.revokeObjectURL(a.href); });
  root.querySelector('[data-reset]')?.addEventListener('click',()=>{ if(!confirm('Reset Football Centre progress for this browser?')) return; state={...defaultState}; save(); render(); });
  render();
})();
</script>

<style>
