-row{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:12px}.fcx-info-row>div{padding:14px;border:1px dashed #263847;border-radius:13px}.fcx-info-row strong,.fcx-info-row span{display:block}.fcx-info-row strong{font-size:11px}.fcx-info-row span{font-size:9px;color:#687d8d;margin-top:3px}.fcx-player-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.fcx-player{padding:15px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#101923,#0b1118);transition:.18s}.fcx-player:hover{border-color:#55c7f866;transform:translateY(-2px)}.fcx-player-top,.fcx-player-bottom{display:flex;justify-content:space-between;align-items:center}.fcx-player-top span{font-size:8px;color:#6f8494;font-weight:900;letter-spacing:.1em}.fcx-player-top b{font-size:20px;color:var(--blue)}.fcx-player-avatar{width:64px;height:64px;margin:12px 0;border-radius:17px;display:grid;place-items:center;background:linear-gradient(145deg,#18384a,#0c1720);border:1px solid #31576b;color:#bdeeff;font-size:17px;font-weight:950}.fcx-player>strong{display:block;font-size:14px}.fcx-player>small{display:block;color:#6d8191;font-size:9px;margin-top:2px}.fcx-player-bar{height:5px;background:#071017;border-radius:99px;margin:13px 0 9px;overflow:hidden}.fcx-player-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--blue2),var(--blue));border-radius:inherit}.fcx-player-bottom{font-size:8px;color:#617788}.fcx-player-bottom b{color:#9fb2c0}.fcx-analysis-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;margin-top:12px}.fcx-copy{padding:18px}.fcx-copy h3{margin:5px 0 7px;font-size:17px}.fcx-copy p{margin:0;color:#788b9a;font-size:10px;line-height:1.7}.fcx-totw-hero{padding:22px;display:flex;justify-content:space-between;align-items:end;gap:20px}.fcx-totw-hero h2{font-size:29px;letter-spacing:-.045em;margin:4px 0}.fcx-totw-hero p{margin:0;color:#758999;font-size:10px}.fcx-totw-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:12px;m