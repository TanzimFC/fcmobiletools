---
const page = Astro.props.page ?? 'dashboard';
const nav = [['dashboard','Overview','/football-centre'],['matches','Matches','/football-centre/matches'],['rewards','Rewards','/football-centre/rewards'],['analysis','Analysis','/football-centre/analysis'],['history','History','/football-centre/history'],['settings','Settings','/football-centre/settings']];
const clubs={
 mu:{name:'Manchester United Football Club',short:'Manchester United',logo:'https://thumb.wikimedia.org/wikipedia/en/thumb/7/7a/Manchester_United_FC_crest.svg/250px-Manchester_United_FC_crest.svg.png'},
 mc:{name:'Manchester City Football Club',short:'Manchester City',logo:'https://thumb.wikimedia.org/wikipedia/en/thumb/e/e0/Manchester_City_FC_badge.svg/250px-Manchester_City_FC_badge.svg.png'},
 ren:{name:'Stade Rennais Football Club',short:'Stade Rennais FC',logo:'https://thumb.wikimedia.org/wikipedia/en/thumb/6/6d/Stade_Rennais_FC.svg/250px-Stade_Rennais_FC.svg.png'},
 mar:{name:'Olympique de Marseille',short:'Olympique de Marseille',logo:'https://thumb.wikimedia.org/wikipedia/en/thumb/d/d8/Olympique_Marseille_logo.svg/250px-Olympique_Marseille_logo.svg.png'}
};
const matches=[{id:'mufc-mancity',home:clubs.mu,away:clubs.mc},{id:'rennes-marseille',home:clubs.ren,away:clubs.mar}];
---
<div class="fcx" data-fcx data-page={page}>
<div class="fcx-shell">
<header class="fcx-header"><div><span class="label">FC MOBILE · FOOTBALL CENTRE</span><h1>{page==='dashboard'?'Overview':page[0].toUpperCase()+page.slice(1)}</h1><p>Showdown predictions, match results, points, rewards and cycle history.</p></div><div class="balance"><span>AVAILABLE</span><b data-balance>0</b><small>PTS</small></div></header>
<nav class="tabs">{nav.map(([k,n,h])=><a class:active={page===k} href={h}>{n}</a>)}</nav>
{page==='dashboard' && <main class="page">
<section class="hero"><div><span class="label">SEPTEMBER 2026 · ACTIVE CYCLE</span><h2>Football Centre progress</h2><p>80 points are awarded for every played Showdown. World Class adds 20 only when you actually play that match at World Class difficulty. A correct prediction adds 400.</p></div><div class="hero-score"><b data-balance>0</b><span>POINTS BALANCE</span></div><div class="bar"><i data-progress></i></div><div class="meta"><span><b data-played>0</b> / 2 SHOWDOWNS PLAYED</span><span><b data-earned>0</b> EARNED THIS CYCLE</span></div></section>
<section class="grid four"><article class="card stat"><span>Balance</span><b data-balance>0</b><small>available points</small></article><article class="card stat"><span>Earned</span><b data-earned>0</b><small>cycle earnings</small></article><article class="card stat"><span>Spent</span><b data-spent>0</b><small>reward claims</small></article><article class="card stat"><span>Accuracy</span><b data-accuracy>0%</b><small>resolved predictions</small></article></section>
<section class="section-title"><div><span class="label">CURRENT SHOWDOWNS</span><h2>Pick before you play</h2></div><span class="chip">2 MATCHES</span></section>
<section class="grid two">{matches.map((m,i)=><article class="match"><div class="matchtop"><span>SHOWDOWN 0{i+1}</span><b data-dash-status={m.id}>UPCOMING</b></div><div class="teams"><div><img src={m.home.logo} alt={`${m.home.name} crest`}/><strong>{m.home.short}</strong></div><em>VS</em><div><img src={m.away.logo} alt={`${m.away.name} crest`}/><strong>{m.away.short}</strong></div></div><a class="open" href="/football-centre/matches">Open match →</a></article>)}</section>
<section class="grid three"><a class="card feature" href="/football-centre/matches"><span class="label">01</span><h3>Matches</h3><p>Make a team prediction, then record the real result.</p></a><a class="card feature" href="/football-centre/rewards"><span class="label">02</span><h3>Rewards</h3><p>Spend your stored Football Centre points.</p></a><a class="card feature" href="/football-centre/history"><span class="label">03</span><h3>History</h3><p>Review every match, prediction and points transaction.</p></a></section>
</main>}
{page==='matches' && <main class="page"><section class="section-title"><div><span class="label">MATCH CENTRE · SEPTEMBER 2026</span><h2>Showdowns</h2><p>FC Mobile prediction is team vs team only. Draw is a possible real result, not a prediction button. Choose a team first, then record the real result later.</p></div><span class="chip">80 + 20 + 400</span></section><div class="match-list">{matches.map((m,i)=><article class="match full" data-match={m.id}><div class="matchtop"><span>SHOWDOWN 0{i+1}</span><b data-status>AWAITING PREDICTION</b></div><div class="teams"><div><img src={m.home.logo} alt={`${m.home.name} crest`}/><strong>{m.home.name}</strong></div><em>VS</em><div><img src={m.away.logo} alt={`${m.away.name} crest`}/><strong>{m.away.name}</strong></div></div><div class="step"><span>1</span><div><b>Choose your team</b><small>There is no Draw prediction in FC Mobile Football Centre.</small></div></div><div class="choices"><button data-pick="home">{m.home.short}</button><button data-pick="away">{m.away.short}</button></div><div class="step"><span>2</span><div><b>Record the actual result</b><small>Draw is available here because it is a real match result.</small></div></div><div class="results"><button data-result="home">{m.home.short} won</button><button data-result="draw">Draw</button><button data-result="away">{m.away.short} won</button><button data-result="not_played">Not played</button></div><label class="world"><input type="checkbox" data-world/> I played this match on World Class difficulty</label><div class="outcome" data-outcome>Select your team first.</div><div class="rules"><span>Base played +80</span><span>World Class +20</span><span>Correct prediction +400</span><span>Wrong prediction +0</span><span>Draw result = loss points</span></div></article>)}</div></main>}
{page==='rewards' && <main class="page"><section class="section-title"><div><span class="label">REWARD STORE</span><h2>Spend Football Centre points</h2><p>Claims are deducted immediately from the same browser-local balance and cannot exceed their limits.</p></div></section><section class="reward-balance card"><span>AVAILABLE BALANCE</span><b data-balance>0</b><small>PTS</small></section><section class="grid two rewards">{[['player','120–122 OVR Player','4000','1','fc_c2_IMG_FC_C02_04'],['draft','FC Draft Voucher','300','3','fc_c2_IMG_FC_C02_05'],['gems','Gems','100','10','fc_c2_IMG_FC_C02_06'],['rank','Rank Up Points','100','50','fc_c2_IMG_FC_C02_07']].map(([id,name,cost,limit,img])=><article class="reward card"><div class="reward-art"><img src={`/assets/images/${img}.png`} alt=""/><span>{id==='player'?'OVR':id==='draft'?'DRAFT':id==='gems'?'GEMS':'RANK'}</span></div><div><span class="label">REWARD</span><h3>{name}</h3><p><b>{Number(cost).toLocaleString()} PTS</b> · limit {limit}×</p><small data-claim-count={name}>0 claimed</small></div><button data-reward={cost} data-reward-name={name} data-reward-limit={limit}>Claim reward</button></article>)}</section></main>}
{page==='analysis' && <main class="page"><section class="section-title"><div><span class="label">MATCH ANALYSIS</span><h2>Think before you pick</h2><p class="warning">⚠ Pick at your own risk. Analysis is informational only and is not a guarantee. Football is unpredictable. No prediction here is certain.</p></div></section><section class="analysis"><div class="video"><iframe src="https://www.youtube.com/embed/KvgulT3RtFE" title="Football Centre TOTW update" loading="lazy" allowfullscreen></iframe><span class="dev-video-tag" data-dev-video="totw-release-update">DEV VIDEO · TOTW RELEASE TIMING · UPDATE URL/ID HERE</span></div><div class="card"><span class="label">TOTW UPDATE</span><h3>Release timing video</h3><p>This video contains information about the expected timing of the TOTW release. The TOTW content shown or discussed may not be in the game yet. Check the Football Centre again when the official content is live.</p><div class="warning small">Do not treat the timing as a confirmed in-game release until the content is actually available.</div></div></section></main>}
{page==='history' && <main class="page"><section class="section-title"><div><span class="label">PROGRESS ARCHIVE</span><h2>History & ledger</h2><p>Every resolved match and reward transaction is kept locally. Spending never changes what you earned.</p></div></section><section class="grid four"><article class="card stat"><span>Total earned</span><b data-earned>0</b><small>all recorded earnings</small></article><article class="card stat"><span>Total spent</span><b data-spent>0</b><small>reward claims</small></article><article class="card stat"><span>Net balance</span><b data-balance>0</b><small>starting + earned − spent</small></article><article class="card stat"><span>Resolved</span><b data-played>0</b><small>played matches</small></article></section><section class="history-matches card"><div class="history-head"><h3>Match history</h3><span class="label">MATCH RECORDS</span></div><div data-match-history><div class="empty">No resolved matches yet.</div></div></section><section class="ledger card"><div class="history-head"><h3>Points ledger</h3><span class="label">IMMUTABLE TRANSACTIONS</span></div><div data-ledger><div class="empty">No transactions yet.</div></div></section></main>}
{page==='settings' && <main class="page"><section class="section-title"><div><span class="label">CONTROL CENTRE</span><h2>Settings & backup</h2><p>Your progress lives in this browser. Export it before changing devices or clearing site data.</p></div></section><section class="grid two"><article class="card setting"><span class="label">STARTING BALANCE</span><h3>Existing points</h3><p>Use this only if you are carrying an existing balance into the cycle.</p><div class="row"><input data-starting type="number" min="0"/><button data-save-start>Save</button></div></article><article class="card setting"><span class="label">SCORING</span><h3>Locked event rules</h3><div class="rules vertical"><span>+80 for every played match</span><span>+20 only for World Class difficulty</span><span>+400 correct prediction</span><span>Draw result counts as an incorrect prediction</span></div></article><article class="card setting"><span class="label">BACKUP</span><h3>Download or restore</h3><p>Download your complete Football Centre data, or import a previous JSON backup to restore your local progress.</p><div class="row"><button data-export>Download backup</button><label class="import"><input data-import type="file" accept="application/json,.json"/>Import backup</label></div></article></section></main>}
</div></div>
<script is:inline>
(()=>{const root=document.querySelector('[data-fcx]');if(!root)return;const KEY='tanzimfc_football_centre_v12';const LEGACY='tanzimfc_football_centre_v11';const base=()=>({version:12,cycleId:'2026-09',startingBalance:0,matches:{},ledger:[],claims:{}});let state;try{state=JSON.parse(localStorage.getItem(KEY)||'null')}catch{}if(!state||state.version!==12){let old=null;try{old=JSON.parse(localStorage.getItem(LEGACY)||'null')}catch{};state=base();if(old?.startingBalance)state.startingBalance=Number(old.startingBalance)||0;save()}function save(){localStorage.setItem(KEY,JSON.stringify(state))}function totals(){let earned=state.ledger.filter(x=>x.type==='earned').reduce((a,x)=>a+Number(x.amount||0),0);let spent=state.ledger.filter(x=>x.type==='spent').reduce((a,x)=>a+Number(x.amount||0),0);return{earned,spent,balance:Number(state.startingBalance||0)+earned-spent}}function tx(type,amount,description){state.ledger.push({id:(crypto.randomUUID?.()||`${Date.now()}-${Math.random()}`),type,amount:Number(amount),description,date:new Date().toISOString()});save()}function render(){const t=totals(),resolved=Object.values(state.matches).filter(m=>m.status==='resolved'),picked=resolved.filter(m=>m.prediction),correct=picked.filter(m=>m.prediction===m.result&&m.result!=='draw').length;root.querySelectorAll('[data-balance]').forEach(e=>e.textContent=t.balance.toLocaleString());root.querySelectorAll('[data-earned]').forEach(e=>e.textContent=t.earned.toLocaleString());root.querySelectorAll('[data-spent]').forEach(e=>e.textContent=t.spent.toLocaleString());root.querySelectorAll('[data-played]').forEach(e=>e.textContent=resolved.filter(m=>m.result!=='not_played').length);root.querySelectorAll('[data-progress]').forEach(e=>e.style.width=Math.min(100,resolved.filter(m=>m.result!=='not_played').length/2*100)+'%');root.querySelectorAll('[data-accuracy]').forEach(e=>e.textContent=picked.length?Math.round(correct/picked.length*100)+'%':'0%');root.querySelectorAll('[data-starting]').forEach(e=>e.value=state.startingBalance);root.querySelectorAll('[data-dash-status]').forEach(e=>{const m=state.matches[e.dataset.dashStatus];e.textContent=!m?.prediction?'UPCOMING':m.status==='resolved'?'RESOLVED':'PREDICTED'});root.querySelectorAll('[data-match]').forEach(card=>{const m=state.matches[card.dataset.match];card.querySelectorAll('[data-pick]').forEach(b=>b.classList.toggle('selected',b.dataset.pick===m?.prediction));card.querySelectorAll('[data-result]').forEach(b=>b.classList.toggle('selected',b.dataset.result===m?.result));if(card.querySelector('[data-world]'))card.querySelector('[data-world]').checked=!!m?.worldClass;const st=card.querySelector('[data-status]');if(st)st.textContent=!m?.prediction?'AWAITING PREDICTION':m.status==='resolved'?'RESOLVED':'AWAITING RESULT';const o=card.querySelector('[data-outcome]');if(o)o.textContent=!m?.prediction?'Select your team first.':m.status!=='resolved'?'Prediction saved. Record the real result after the match.':m.result==='not_played'?'Match not played. No points awarded.':m.prediction===m.result?'Correct prediction. +80 base +400 correct'+(m.worldClass?' +20 World Class.':''):m.result==='draw'?'Draw result. +80 base, no prediction bonus.':`Wrong prediction. +80 base${m.worldClass?' +20 World Class.':''}`});root.querySelectorAll('[data-claim-count]').forEach(e=>e.textContent=`${Number(state.claims[e.dataset.claimCount]||0)} claimed`);const ledger=root.querySelector('[data-ledger]');if(ledger)ledger.innerHTML=state.ledger.length?state.ledger.slice().reverse().map(x=>`<div class="ledger-row"><b class="${x.type}">${x.type==='earned'?'+':'−'}${Number(x.amount).toLocaleString()}</b><span>${x.description}</span><small>${new Date(x.date).toLocaleString()}</small></div>`).join(''):'<div class="empty">No transactions yet.</div>';const mh=root.querySelector('[data-match-history]');if(mh){const rows=Object.values(state.matches).filter(m=>m.status==='resolved').reverse();mh.innerHTML=rows.length?rows.map(m=>`<div class="history-row"><div><b>${m.id.replaceAll('-',' · ').toUpperCase()}</b><small>Prediction: ${m.prediction==='home'?'Home team':m.prediction==='away'?'Away team':'Unknown'} · Result: ${m.result}</small></div><strong>${m.pointsAwarded||0} PTS</strong></div>`).join(''):'<div class="empty">No resolved matches yet.</div>'}}
root.querySelectorAll('[data-pick]').forEach(b=>b.addEventListener('click',()=>{const c=b.closest('[data-match]');if(!c)return;const id=c.dataset.match;const m=state.matches[id]||{};if(m.status==='resolved'){alert('This match is already resolved.');return}state.matches[id]={...m,prediction:b.dataset.pick,status:'predicted',result:null,pointsAwarded:0};save();render()}));root.querySelectorAll('[data-world]').forEach(b=>b.addEventListener('change',()=>{const c=b.closest('[data-match]');if(!c)return;const id=c.dataset.match,m=state.matches[id];if(!m?.prediction){b.checked=false;alert('Choose your team first.');return}if(m.status==='resolved'){b.checked=!!m.worldClass;return}m.worldClass=b.checked;save();render()}));root.querySelectorAll('[data-result]').forEach(b=>b.addEventListener('click',()=>{const c=b.closest('[data-match]');if(!c)return;const id=c.dataset.match,m=state.matches[id];if(!m?.prediction){alert('Choose your team first.');return}if(m.status==='resolved'){alert('This result is already recorded.');return}m.result=b.dataset.result;m.status='resolved';let points=0;if(m.result!=='not_played'){points=80+(m.worldClass?20:0)+(m.prediction===m.result?400:0);tx('earned',points,`Showdown completed · ${id}`)}m.pointsAwarded=points;save();render()}));root.querySelectorAll('[data-reward]').forEach(b=>b.addEventListener('click',()=>{const cost=Number(b.dataset.reward),name=b.dataset.rewardName,limit=Number(b.dataset.rewardLimit),count=Number(state.claims[name]||0);if(count>=limit){alert(`You reached the ${limit}× limit for ${name}.`);return}if(totals().balance<cost){alert('Not enough Football Centre points.');return}if(!confirm(`Claim ${name} for ${cost.toLocaleString()} points?`))return;state.claims[name]=count+1;tx('spent',cost,`Reward claimed · ${name} (${state.claims[name]}/${limit})`);const toast=document.createElement('div');toast.className='claim-toast';toast.innerHTML='<b>Reward claimed</b><span>Points deducted from this browser.</span>';document.body.appendChild(toast);requestAnimationFrame(()=>toast.classList.add('show'));setTimeout(()=>toast.remove(),2600);render()}));root.querySelector('[data-save-start]')?.addEventListener('click',()=>{state.startingBalance=Math.max(0,Number(root.querySelector('[data-starting]')?.value)||0);save();render()});root.querySelector('[data-export]')?.addEventListener('click',()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`football-centre-${state.cycleId}-backup.json`;a.click();setTimeout(()=>URL.revokeObjectURL(url),500)});root.querySelector('[data-import]')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;try{const imported=JSON.parse(await file.text());if(!imported||typeof imported!=='object'||!imported.ledger||!imported.matches)throw new Error('Invalid backup');if(!confirm('Replace current local Football Centre progress with this backup?'))return;state={...base(),...imported,version:12,startingBalance:Number(imported.startingBalance)||0};save();render();alert('Backup restored successfully.')}catch(err){alert('Import failed. Please select a valid Football Centre JSON backup.')}e.target.value=''}) ;render()})();
</script>
<style>
.fcx{--bg:#06090d;--panel:#0c1117;--line:#1d2933;--text:#f1f7fa;--muted:#8b9aa6;--blue:#61c7f5;--blue2:#2aa8e7;--green:#55d79a;--red:#ff7081;color:var(--text);background:radial-gradient(900px 450px at 0 0,#61c7f50b,transparent 60%),var(--bg);min-height:720px;padding:25px 0 60px;font:13px/1.5 Inter,system-ui,sans-serif}.fcx *{box-sizing:border-box}.fcx-shell{width:min(1180px,calc(100% - 28px));margin:auto}.fcx-header{display:flex;justify-content:space-between;align-items:center;gap:18px}.label{color:var(--blue);font-size:9px;font-weight:900;letter-spacing:.14em}.fcx h1{font-size:30px;margin:4px 0}.fcx h2{font-size:23px;margin:4px 0}.fcx h3{font-size:14px;margin:5px 0}.fcx p{color:var(--muted);font-size:10px;margin:4px 0}.balance{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:8px 12px;display:grid;grid-template-columns:auto auto;gap:2px 5px}.balance span{grid-column:1/-1;font-size:8px;color:var(--muted);letter-spacing:.12em}.balance b{font-size:18px}.balance small{color:var(--blue);font-weight:900}.tabs{display:flex;overflow:auto;border-bottom:1px solid var(--line);margin:20px 0;padding:0;scrollbar-width:none}.tabs a{padding:10px 13px;color:var(--muted);font-weight:800;font-size:10px;border-bottom:2px solid transparent;white-space:nowrap}.tabs a:hover,.tabs a.active{color:var(--blue);border-color:var(--blue);background:#61c7f508}.page{display:grid;gap:17px}.hero,.card,.match{border:1px solid var(--line);background:linear-gradient(145deg,#0e151c,#0a0f14);border-radius:16px}.hero{display:grid;grid-template-columns:1fr auto;gap:16px;padding:21px}.hero-score{text-align:right}.hero-score b{display:block;color:var(--blue);font-size:40px;line-height:1}.hero-score span{font-size:8px;color:var(--muted)}.bar{grid-column:1/-1;height:10px;background:#17222b;border-radius:99px;overflow:hidden;border:1px solid #23313b}.bar i{display:block;width:0;height:100%;min-width:0;background:linear-gradient(90deg,var(--blue2),var(--blue));transition:width .3s 