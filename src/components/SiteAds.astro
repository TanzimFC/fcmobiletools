---
import { SITE_ADS } from '../config/siteAds.js';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const parts = pathname.split('/').filter(Boolean);
const reservedGiveawaySections = new Set(['enter', 'entry', 'claim', 'rules', 'safety', 'draw']);
const isGiveawayFlow = parts[0] === 'giveaways' && parts.slice(1).some((part) => reservedGiveawaySections.has(part));
const permanentlyExcluded = pathname === '/' ||
  isGiveawayFlow ||
  SITE_ADS.excludedPathPrefixes.some((prefix) => pathname === prefix || pathname.startsWith(prefix + '/'));
---

{SITE_ADS.enabled && !permanentlyExcluded && (
  <script define:vars={{ config: SITE_ADS }}>
    (() => {
      if (window.__FCMOBILETOOLS_SITE_ADS__) return;
      window.__FCMOBILETOOLS_SITE_ADS__ = true;

      const pending = new Map();

      const hasAdvertisingConsent = () => {
        const name = 'fcmobiletools_consent=';
        const row = document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith(name));
        if (!row) return false;
        try {
          const choice = JSON.parse(decodeURIComponent(row.slice(name.length)));
          return choice?.version === '1' && choice?.advertising === true;
        } catch {
          return false;
        }
      };

      const reserveVignetteSlot = () => {
        const key = 'fcmt:ads:last-vignette:v2';
        const capMinutes = Math.max(20, Math.min(240, Number(config.frequencyCapMinutes) || 30));
        const now = Date.now();
        try {
          const last = Number(localStorage.getItem(key) || 0);
          if (Number.isFinite(last) && last > 0 && now - last < capMinutes * 60 * 1000) return false;
          localStorage.setItem(key, String(now));
          return true;
        } catch {
          // Do not block the other formats when storage is disabled. Monetag's
          // own zone frequency controls should be used in that case.
          return true;
        }
      };

      const appendFormat = (format) => {
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;
        if (document.querySelector('script[data-fcmt-ad-format="' + format.key + '"]')) return;
        if (!document.head) return;

        if (format.key === 'vignette' && !reserveVignetteSlot()) return;

        const script = document.createElement('script');
        script.async = true;
        script.setAttribute('data-cfasync', 'false');
        script.setAttribute('data-fcmt-ad-format', format.key);

        if (format.key === 'vignette') {
          script.setAttribute('data-zone', format.settings.zone);
          script.src = format.settings.src;
        } else if (format.key === 'push') {
          script.src = format.settings.src + '?z=' + encodeURIComponent(format.settings.zone);
        } else if (format.key === 'inPagePush') {
          script.setAttribute('data-zone', format.settings.zone);
          script.src = format.settings.src;
        } else {
          return;
        }

        script.addEventListener('error', () => {
          document.documentElement.dataset.siteAdFormatError = format.key;
        }, { once: true });
        script.addEventListener('load', () => {
          document.documentElement.dataset.siteAdFormatLoaded = format.key;
        }, { once: true });
        // Monetag recommends placing tags in the document head. data-cfasync
        // lets the scripts bypass Cloudflare Rocket Loader.
        document.head.appendChild(script);
      };

      const scheduleFormat = (format) => {
        if (!format.settings?.enabled || !format.settings?.src || !format.settings?.zone) return;
        if (document.querySelector('script[data-fcmt-ad-format="' + format.key + '"]') || pending.has(format.key)) return;

        const delay = Math.max(5000, Math.min(300000, Number(format.settings.delayMs) || 30000));
        pending.set(format.key, window.setTimeout(() => {
          pending.delete(format.key);
          if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;
          appendFormat(format);
        }, delay));
      };

      const loadConfiguredAds = () => {
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;

        // These are independent ad formats; a single format must not suppress
        // the other two. Monetag's zone-level frequency controls handle delivery.
        scheduleFormat({ key: 'inPagePush', settings: config.inPagePush });
        scheduleFormat({ key: 'push', settings: config.push });
        // Vignette is the only overlay in this setup and has its own cooldown.
        scheduleFormat({ key: 'vignette', settings: config.vignette });
      };

      window.addEventListener('fcmobiletools:consent-updated', (event) => {
        if (event.detail?.advertising === true) {
          loadConfiguredAds();
          return;
        }
        if (document.querySelector('script[data-fcmt-ad-format]')) window.location.reload();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') loadConfiguredAds();
      });

      loadConfiguredAds();
    })();
  </script>
)}
