---
import { SITE_ADS } from '../config/siteAds.js';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isGiveawayPage = pathname === '/giveaways' || pathname.startsWith('/giveaways/');
const blockedByPrefix = SITE_ADS.excludedPathPrefixes.some((prefix) =>
  pathname === prefix || pathname.startsWith(prefix + '/')
);
const canRunGiveawayAds = isGiveawayPage && !blockedByPrefix;
---

{SITE_ADS.enabled && canRunGiveawayAds && SITE_ADS.vignette?.enabled && (
  <script define:vars={{ config: SITE_ADS }}>
    (() => {
      if (window.__FCMOBILETOOLS_SITE_ADS__) return;
      window.__FCMOBILETOOLS_SITE_ADS__ = true;

      const hasAdvertisingConsent = () => {
        const name = 'fcmobiletools_consent=';
        const row = document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith(name));
        if (!row) return false;
        try {
          const choice = JSON.parse(decodeURIComponent(row.slice(name.length)));
          return choice?.version === '1' && choice?.advertising === true;
        } catch {
          return false;
        }
      };

      const canShowVignette = () => {
        const key = 'fcmt:ads:last-vignette:v2';
        const capMinutes = Math.max(20, Math.min(240, Number(config.frequencyCapMinutes) || 30));
        try {
          const last = Number(localStorage.getItem(key) || 0);
          return !Number.isFinite(last) || last <= 0 || Date.now() - last >= capMinutes * 60 * 1000;
        } catch {
          return true;
        }
      };

      const appendVignette = () => {
        const format = config.vignette;
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;
        if (!format?.enabled || !format?.src || !format?.zone || !document.head) return;
        if (document.querySelector('script[data-fcmt-ad-format="vignette"]') || !canShowVignette()) return;

        const script = document.createElement('script');
        script.setAttribute('data-cfasync', 'false');
        script.setAttribute('data-fcmt-ad-format', 'vignette');
        script.setAttribute('data-zone', format.zone);
        script.async = true;
        script.src = format.src;
        script.addEventListener('load', () => {
          document.documentElement.dataset.siteAdFormatLoaded = 'vignette';
          try { localStorage.setItem('fcmt:ads:last-vignette:v2', String(Date.now())); } catch {}
        }, { once: true });
        script.addEventListener('error', () => {
          document.documentElement.dataset.siteAdFormatError = 'vignette';
          script.remove();
        }, { once: true });
        document.head.appendChild(script);
      };

      let timer = 0;
      const scheduleVignette = () => {
        window.clearTimeout(timer);
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;
        const delay = Math.max(5000, Math.min(300000, Number(config.vignette.delayMs) || 60000));
        timer = window.setTimeout(() => {
          if (typeof window.requestIdleCallback === 'function') {
            window.requestIdleCallback(appendVignette, { timeout: 2200 });
          } else {
            window.setTimeout(appendVignette, 250);
          }
        }, delay);
      };

      window.addEventListener('fcmobiletools:consent-updated', (event) => {
        if (event.detail?.advertising === true) {
          scheduleVignette();
        } else if (document.querySelector('script[data-fcmt-ad-format="vignette"]')) {
          window.location.reload();
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') scheduleVignette();
        else window.clearTimeout(timer);
      });

      scheduleVignette();
    })();
  </script>
)}
