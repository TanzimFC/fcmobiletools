---
import { SITE_ADS } from '../config/siteAds.js';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const parts = pathname.split('/').filter(Boolean);
const giveawayHub = pathname === '/giveaways';
const reservedSlugs = new Set(['enter', 'claim', 'rules', 'safety', 'draw']);
const giveawayDetail = parts.length === 2 && parts[0] === 'giveaways' && !reservedSlugs.has(parts[1]);
const eligibleGiveawayPage = giveawayHub || giveawayDetail;
const permanentlyExcluded = pathname === '/' ||
  SITE_ADS.excludedPathPrefixes.some((prefix) => pathname === prefix || pathname.startsWith(prefix + '/'));
const isExcluded = !eligibleGiveawayPage || permanentlyExcluded;
---

{SITE_ADS.enabled && !isExcluded && (
  <script define:vars={{ config: SITE_ADS }}>
    (() => {
      if (window.__FCMOBILETOOLS_SITE_ADS__) return;
      window.__FCMOBILETOOLS_SITE_ADS__ = true;

      const hasAdvertisingConsent = () => {
        const name = 'fcmobiletools_consent=';
        const row = document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith(name));
        if (!row) return false;
        try {
          const choice = JSON.parse(decodeURIComponent(row.slice(name.length)));
          return choice?.version === '1' && choice?.advertising === true;
        } catch {
          return false;
        }
      };

      const root = document.body || document.documentElement;
      if (!root) return;

      const appendFormat = (format) => {
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;
        const script = document.createElement('script');
        script.async = true;
        script.dataset.fcmtAdFormat = format.key;

        if (format.key === 'vignette') {
          script.dataset.zone = config.vignette.zone;
          script.src = config.vignette.src;
        } else if (format.key === 'push') {
          script.src = config.push.src + '?z=' + encodeURIComponent(config.push.zone);
          script.setAttribute('data-cfasync', 'false');
        } else if (format.key === 'inPagePush') {
          script.dataset.zone = config.inPagePush.zone;
          script.src = config.inPagePush.src;
        } else if (format.key === 'videoSlider') {
          script.settings = {};
          script.src = config.videoSlider.src;
          script.referrerPolicy = 'no-referrer-when-downgrade';
        } else {
          return;
        }

        document.documentElement.dataset.siteAdFormatLoaded = format.key;
        root.appendChild(script);
      };

      const loadConfiguredAds = () => {
        if (!hasAdvertisingConsent() || document.visibilityState !== 'visible') return;

        // Only one third-party format may load within the cooldown window.
        const formats = [
          { key: 'inPagePush', settings: config.inPagePush },
          { key: 'vignette', settings: config.vignette },
          { key: 'push', settings: config.push },
          { key: 'videoSlider', settings: config.videoSlider }
        ].filter((format) => format.settings?.enabled && format.settings?.src && format.settings?.zone);
        if (!formats.length) return;

        const lastKey = 'fcmt:ads:last-load:v1';
        const rotationKey = 'fcmt:ads:rotation:v1';
        const capMinutes = Math.max(20, Math.min(240, Number(config.frequencyCapMinutes) || 30));
        const now = Date.now();
        let lastLoad = 0;
        let rotation = 0;

        // Fail closed if browser storage is unavailable; don't bypass the frequency cap.
        try {
          lastLoad = Number(localStorage.getItem(lastKey) || 0);
          rotation = Number(localStorage.getItem(rotationKey) || 0);
        } catch {
          return;
        }
        if (Number.isFinite(lastLoad) && lastLoad > 0 && now - lastLoad < capMinutes * 60 * 1000) return;

        const index = Number.isFinite(rotation) ? Math.abs(Math.trunc(rotation)) % formats.length : 0;
        const selected = formats[index];

        try {
          // Reserve the cooldown before the delay to avoid races across open tabs.
          localStorage.setItem(lastKey, String(now));
          localStorage.setItem(rotationKey, String((index + 1) % formats.length));
        } catch {
          return;
        }

        window.setTimeout(() => {
          appendFormat(selected);
        }, Math.max(5000, Math.min(300000, Number(selected.settings.delayMs) || 30000)));
      };

      window.addEventListener('fcmobiletools:consent-updated', (event) => {
        if (event.detail?.advertising === true) {
          loadConfiguredAds();
          return;
        }
        if (document.documentElement.dataset.siteAdFormatLoaded) window.location.reload();
      });

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') loadConfiguredAds();
      });

      loadConfiguredAds();
    })();
  </script>
)}
