---
// Premium account menu shown from the navbar once a visitor is signed in. It reads the same
// identity cache the navbar already uses, so it adds no network requests. Signed-out visitors
// never see it: the Login button keeps going straight to the account page.
import { getLocaleFromPath, localizeHref, translator } from '../i18n/index.js';

const locale = getLocaleFromPath(Astro.url.pathname);
const tr = translator(locale);
const href = (h) => localizeHref(h, locale);

const ico = (d) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const links = [
  { id: 'profile', href: '/profile/', icon: ico('<circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/>') },
  { id: 'quests', href: '/missions/', icon: ico('<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>') },
  { id: 'achievements', href: '/achievements/', icon: ico('<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>') },
  { id: 'leaderboard', href: '/leaderboard/', icon: ico('<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>') },
  { id: 'rewards', href: '/rewards/', icon: ico('<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>') },
  { id: 'settings', href: '/settings/', icon: ico('<line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="2" x2="6" y1="14" y2="14"/><line x1="10" x2="14" y1="8" y2="8"/><line x1="18" x2="22" y1="16" y2="16"/>') },
  { id: 'surveys', href: '/surveys/', wide: true, icon: ico('<rect x="6" y="4" width="12" height="17" rx="2.5"/><path d="M9 4.5V3.8A1.3 1.3 0 0 1 10.3 2.5h3.4A1.3 1.3 0 0 1 15 3.8v.7M9.5 11h5M9.5 15h3"/>') }
];
---
<div class="fcmt-accmenu" id="fcmtAccMenu" data-nosnippet role="dialog" aria-label={tr('common.accountMenu.aria')} data-streak-fmt={tr('common.accountMenu.streakDays')} data-level-fmt={tr('common.levelLong')} hidden>
  <div class="fcmt-accm-card">
    <div class="fcmt-accm-ring" id="fcmtAccmRing" style="--p:8%">
      <span class="fcmt-accm-avatar" id="fcmtAccmAvatar">FC</span>
    </div>
    <div class="fcmt-accm-id">
      <p class="fcmt-accm-kicker">{tr('common.accountMenu.signedInAs')}</p>
      <strong id="fcmtAccmName">{tr('common.myAccount')}</strong>
      <small id="fcmtAccmUser"></small>
    </div>
    <span class="fcmt-accm-level" id="fcmtAccmLevel" hidden></span>
    <div class="fcmt-accm-bar" aria-hidden="true"><i id="fcmtAccmBar" style="width:8%"></i></div>
    <dl class="fcmt-accm-stats">
      <div><dt>{tr('common.accountMenu.xp')}</dt><dd id="fcmtAccmXp">0</dd></div>
      <div><dt>{tr('common.accountMenu.tokens')}</dt><dd id="fcmtAccmTokens">0</dd></div>
      <div><dt>{tr('common.accountMenu.streak')}</dt><dd id="fcmtAccmStreak">0</dd></div>
    </dl>
  </div>
  <nav class="fcmt-accm-grid" aria-label={tr('common.accountMenu.aria')}>
    {links.map((l) => (
      <a class:list={['fcmt-accm-link', { wide: l.wide }]} href={href(l.href)}>
        <span class="fcmt-accm-ico" set:html={l.icon}></span>
        <span class="fcmt-accm-text"><strong>{tr(`common.accountMenu.${l.id}`)}</strong><small>{tr(`common.accountMenu.${l.id}Meta`)}</small></span>
      </a>
    ))}
  </nav>
  <button class="fcmt-accm-out" id="fcmtAccmOut" type="button">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
    <span>{tr('common.accountMenu.signOut')}</span>
  </button>
</div>

<style is:global>
.fcmt-acc-wrap{position:relative;display:flex;align-items:center}
.fcmt-cta-chev{display:none;color:rgba(3,19,28,.7);transition:transform .28s cubic-bezier(.2,.8,.2,1)}
.fcmt-acc-wrap.has-menu .fcmt-cta-chev{display:block}
.fcmt-acc-wrap.has-menu.open .fcmt-cta-chev{transform:rotate(180deg)}
.fcmt-acc-wrap.has-menu .fcmt-cta{padding-right:13px}
.fcmt-accmenu{position:absolute;right:0;top:calc(100% + 14px);z-index:7;width:372px;max-width:calc(100vw - 32px);padding:10px;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:rgba(21,36,52,.975);box-shadow:0 44px 100px -14px rgba(0,0,0,.85);transform-origin:top right;overflow:hidden}
.fcmt-accmenu[hidden]{display:none}
.fcmt-acc-wrap.open .fcmt-accmenu{animation:fcmtAccIn .36s cubic-bezier(.2,.8,.2,1) both}
@keyframes fcmtAccIn{from{opacity:0;transform:translateY(-8px) scale(.97)}to{opacity:1;transform:none}}
.fcmt-accm-card{position:relative;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:6px 14px;padding:16px;border-radius:14px;border:1px solid rgba(76,201,255,.2);background:rgba(76,201,255,.2)}
.fcmt-accm-ring{position:relative;display:grid;place-items:center;width:62px;height:62px;border-radius:50%;background:conic-gradient(var(--primary) var(--p,8%),rgba(255,255,255,.1) 0);box-shadow:none;transition:background .5s}
.fcmt-accm-ring::before{content:"";position:absolute;inset:4px;border-radius:50%;background:#0b1620}
.fcmt-accm-avatar{position:relative;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;overflow:hidden;background:#4CC9FF;color:#04131c;font:800 16px/1 var(--font-display)}
.fcmt-accm-avatar img{width:100%;height:100%;object-fit:cover}
.fcmt-accm-id{min-width:0}
.fcmt-accm-kicker{margin:0 0 5px;color:var(--primary);font:800 12px/1 var(--font-body);letter-spacing:.02em;text-transform:none}
.fcmt-accm-id strong,.fcmt-accm-id small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fcmt-accm-id strong{color:#f5f9fc;font:800 16px/1.25 var(--font-display)}
.fcmt-accm-id small{margin-top:3px;color:#8497a8;font:600 12px/1.2 var(--font-body)}
.fcmt-accm-level{align-self:start;padding:6px 10px;border-radius:999px;background:#9fe9ff;color:#03131c;font:800 12px/1 var(--font-body);white-space:nowrap;box-shadow:none}
.fcmt-accm-bar{grid-column:1/-1;height:6px;margin-top:10px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}
.fcmt-accm-bar i{display:block;height:100%;border-radius:inherit;background:#4cc9ff;box-shadow:none;transition:width .6s cubic-bezier(.2,.8,.2,1)}
.fcmt-accm-stats{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:8px 0 0}
.fcmt-accm-stats div{padding:9px 10px;border-radius:13px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)}
.fcmt-accm-stats dt{color:#7b8d9e;font:700 12px/1 var(--font-body);letter-spacing:.02em;text-transform:none}
.fcmt-accm-stats dd{margin:6px 0 0;color:#f2f7fb;font:800 15px/1 var(--font-display)}
.fcmt-accm-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px}
.fcmt-accm-link{position:relative;display:flex;align-items:center;gap:9px;min-width:0;padding:8px;border-radius:15px;border:1px solid transparent;color:#aebcc9;text-decoration:none;transition:background .16s,border-color .16s,color .16s,transform .16s}
.fcmt-accm-link.wide{grid-column:1/-1}
.fcmt-accm-link:hover,.fcmt-accm-link:focus-visible{outline:none;color:#fff;background:rgba(76,201,255,.08);border-color:rgba(76,201,255,.22);transform:translateY(-1px)}
.fcmt-accm-ico{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:11px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:var(--muted-strong);transition:.2s}
.fcmt-accm-link:hover .fcmt-accm-ico{color:var(--primary);border-color:rgba(76,201,255,.3);background:rgba(76,201,255,.12)}
.fcmt-accm-text{min-width:0}
.fcmt-accm-text strong{display:block;overflow-wrap:anywhere}
.fcmt-accm-text small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.fcmt-accm-text strong{font:700 13px/1.25 var(--font-body)}
.fcmt-accm-text small{margin-top:2px;color:#6f8192;font:500 12px/1.2 var(--font-body)}
.fcmt-accm-out{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:8px;height:42px;border-radius:14px;border:1px solid rgba(255,122,122,.2);background:rgba(255,122,122,.06);color:#ff9d9d;font:700 13px/1 var(--font-body);cursor:pointer;transition:background .2s,border-color .2s,color .2s}
.fcmt-accm-out:hover{background:rgba(255,122,122,.13);border-color:rgba(255,122,122,.4);color:#ffc2c2}
.fcmt-accm-out:disabled{opacity:.6;cursor:progress}
@media(max-width:980px){.fcmt-acc-wrap{display:contents}.fcmt-accmenu{display:none!important}}
@media(prefers-reduced-motion:reduce){.fcmt-acc-wrap.open .fcmt-accmenu{animation:none}.fcmt-accm-bar i,.fcmt-accm-ring{transition:none}}
</style>

<script is:inline>
(() => {
  if (window.__fcmtAccMenuInit) return;
  window.__fcmtAccMenuInit = true;
  const $ = (id) => document.getElementById(id);
  const wrap = $('fcmtAccWrap'), menu = $('fcmtAccMenu'), cta = $('fcmtNavAccountCta');
  if (!wrap || !menu || !cta) return;
  const fmt = (text, vars) => String(text || '').replace(/\{(\w+)\}/g, (m, k) => (vars[k] != null ? vars[k] : m));
  const num = (n) => Number(n || 0).toLocaleString();
  const close = () => { wrap.classList.remove('open'); menu.hidden = true; cta.setAttribute('aria-expanded', 'false'); };
  const open = () => { fill(); wrap.classList.add('open'); menu.hidden = false; cta.setAttribute('aria-expanded', 'true'); };
  function fill() {
    let id = null;
    try { id = JSON.parse(localStorage.getItem('fcmobiletools-identity-cache-v1') || 'null'); } catch {}
    if (!id || !id.username) return;
    const display = String(id.displayName || id.username);
    const lv = Math.max(1, Number(id.level) || 1), xp = Math.max(0, Number(id.xp) || 0);
    // Same visual progression formula the account pages use.
    const step = lv * 250, base = Math.max(0, (lv - 1) * 200);
    const pct = xp === 0 ? 6 : Math.min(96, Math.max(8, Math.round(((Math.max(0, xp - base)) % step) / step * 100)));
    $('fcmtAccmName').textContent = display;
    $('fcmtAccmUser').textContent = '@' + id.username;
    const level = $('fcmtAccmLevel'); level.textContent = fmt(menu.dataset.levelFmt, { n: lv }); level.hidden = false;
    $('fcmtAccmXp').textContent = num(xp);
    $('fcmtAccmTokens').textContent = num(id.tokens);
    $('fcmtAccmStreak').textContent = fmt(menu.dataset.streakFmt, { n: num(id.currentStreak) });
    $('fcmtAccmRing').style.setProperty('--p', pct + '%');
    $('fcmtAccmBar').style.width = pct + '%';
    const av = $('fcmtAccmAvatar');
    if (id.avatarUrl && /^https?:\/\//i.test(id.avatarUrl)) { av.textContent = ''; const img = document.createElement('img'); img.src = id.avatarUrl; img.alt = ''; av.appendChild(img); }
    else { av.textContent = display.slice(0, 2).toUpperCase(); }
  }
  // The menu exists only for a validated signed-in session (same flag the navbar uses).
  const sync = () => { const on = window.__FCMT_AUTHENTICATED === true; wrap.classList.toggle('has-menu', on); cta.setAttribute('aria-haspopup', on ? 'menu' : 'false'); if (!on) close(); else if (wrap.classList.contains('open')) fill(); };
  cta.addEventListener('click', (e) => {
    if (!wrap.classList.contains('has-menu') || window.matchMedia('(max-width:980px)').matches) return;
    e.preventDefault();
    wrap.classList.contains('open') ? close() : open();
  });
  document.addEventListener('click', (e) => { if (wrap.classList.contains('open') && !wrap.contains(e.target)) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && wrap.classList.contains('open')) { close(); cta.focus(); } });
  $('fcmtAccmOut').addEventListener('click', (e) => { e.currentTarget.disabled = true; window.dispatchEvent(new Event('fcmt:sign-out')); setTimeout(close, 250); });
  ['fcmt:nav-auth-state', 'fcmt:account-updated', 'storage'].forEach((ev) => window.addEventListener(ev, sync));
  sync();
})();
</script>
