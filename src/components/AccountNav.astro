---
const { active = 'profile', sectionLabel = 'Profile' } = Astro.props;

const tabs = [
  { id: 'profile', label: 'Profile', href: '/profile/', icon: 'user' },
  { id: 'missions', label: 'Quests', href: '/missions/', icon: 'target' },
  { id: 'achievements', label: 'Achievements', href: '/achievements/', icon: 'trophy' },
  { id: 'leaderboard', label: 'Leaderboard', href: '/leaderboard/', icon: 'chart' },
  { id: 'rewards', label: 'Rewards', href: '/rewards/', icon: 'gift' },
  { id: 'settings', label: 'Settings', href: '/settings/', icon: 'sliders' }
];

const iconSvg = (name) => {
  switch (name) {
    case 'user':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>';
    case 'target':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>';
    case 'trophy':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>';
    case 'chart':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>';
    case 'gift':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>';
    case 'sliders':
      return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="2" x2="6" y1="14" y2="14"/><line x1="10" x2="14" y1="8" y2="8"/><line x1="18" x2="22" y1="16" y2="16"/></svg>';
    default:
      return '';
  }
};
---

<div class="acc-nav-shell" data-acc-nav>
  <div class="acc-nav-top">
    <nav class="acc-crumbs" aria-label="Breadcrumb">
      <a href="/">FCMOBILETOOLS</a>
      <span aria-hidden="true">/</span>
      <a href="/profile/">Account</a>
      <span aria-hidden="true">/</span>
      <strong>{sectionLabel}</strong>
    </nav>

    <div class="acc-mini-identity" id="accMiniIdentity">
      <a class="acc-mini-guest" href="/account/" id="accMiniGuest">
        <span class="acc-mini-dot"></span>
        <span>Optional account · <strong>Sign in or join →</strong></span>
      </a>
      <a class="acc-mini-user" href="/profile/" id="accMiniUser" hidden>
        <span class="acc-mini-avatar" id="accMiniAvatar">FC</span>
        <span class="acc-mini-name" id="accMiniName">@player</span>
        <span class="acc-mini-pill" id="accMiniLevel">Lv. 1</span>
        <span class="acc-mini-xp" id="accMiniXp">0 XP</span>
      </a>
    </div>
  </div>

  <nav class="acc-tabs" aria-label="Account sections">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class:list={['acc-tab', { active: active === tab.id }]}
        aria-current={active === tab.id ? 'page' : undefined}
      >
        <span class="acc-tab-ico" set:html={iconSvg(tab.icon)} />
        <span>{tab.label}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  import { accountAuth, accountApi, getCachedIdentity, setCachedIdentity } from '../lib/account-client.js';

  const guestEl = document.getElementById('accMiniGuest');
  const userEl = document.getElementById('accMiniUser');
  const avatarEl = document.getElementById('accMiniAvatar');
  const nameEl = document.getElementById('accMiniName');
  const levelEl = document.getElementById('accMiniLevel');
  const xpEl = document.getElementById('accMiniXp');

  function renderMiniIdentity(identity) {
    if (!guestEl || !userEl) return;
    if (!identity || !identity.username) {
      guestEl.hidden = false;
      userEl.hidden = true;
      return;
    }
    guestEl.hidden = true;
    userEl.hidden = false;
    const display = String(identity.displayName || identity.username);
    if (nameEl) nameEl.textContent = display;
    if (levelEl) levelEl.textContent = 'Lv. ' + Math.max(1, Number(identity.level) || 1);
    if (xpEl) xpEl.textContent = Number(identity.xp || 0).toLocaleString() + ' XP';
    if (avatarEl) {
      if (identity.avatarUrl && /^https?:\/\//i.test(identity.avatarUrl)) {
        avatarEl.innerHTML = '';
        const img = document.createElement('img');
        img.src = identity.avatarUrl;
        img.alt = '';
        avatarEl.appendChild(img);
      } else {
        avatarEl.textContent = display.slice(0, 2).toUpperCase();
      }
    }
  }

  async function initMiniIdentity() {
    const cached = getCachedIdentity();
    const { data } = await accountAuth.auth.getSession();
    if (!data?.session) {
      renderMiniIdentity(null);
      return;
    }
    if (cached) renderMiniIdentity(cached);
    // Refresh if cache is missing or older than 2 minutes
    if (!cached || Date.now() - Number(cached.updatedAt || 0) > 120000) {
      try {
        const res = await accountApi('/api/account/me');
        if (res.ok) {
          const body = await res.json();
          if (body?.account) {
            setCachedIdentity(body.account);
            renderMiniIdentity(getCachedIdentity());
          }
        }
      } catch {}
    }
  }

  initMiniIdentity();
  window.addEventListener('fcmt:account-updated', (e) => renderMiniIdentity(e.detail));
</script>

<style is:global>
  @keyframes accFadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes accShimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  @keyframes accPulseGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(76, 201, 255, 0.45); }
    50% { box-shadow: 0 0 0 6px rgba(76, 201, 255, 0); }
  }
  .acc-anim {
    animation: accFadeUp 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .acc-anim-d1 { animation-delay: 0.05s; }
  .acc-anim-d2 { animation-delay: 0.1s; }
  .acc-anim-d3 { animation-delay: 0.15s; }
  .acc-anim-d4 { animation-delay: 0.2s; }
  .acc-skel {
    border-radius: 14px;
    background: linear-gradient(90deg, rgba(22, 37, 54, 0.55) 25%, rgba(76, 201, 255, 0.12) 50%, rgba(22, 37, 54, 0.55) 75%);
    background-size: 200% 100%;
    animation: accShimmer 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .acc-anim, .acc-skel {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<style>
  .acc-nav-shell {
    width: 100%;
    margin-bottom: 26px;
    animation: accFadeUp 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .acc-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .acc-crumbs {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 12px/1 var(--font-body);
    color: #7e95a7;
  }
  .acc-crumbs a {
    color: #8ea5b6;
    text-decoration: none;
    transition: color 0.16s ease;
  }
  .acc-crumbs a:hover {
    color: #f5f8fb;
  }
  .acc-crumbs strong {
    color: #dbe8f0;
    font-weight: 700;
  }

  .acc-mini-guest,
  .acc-mini-user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(76, 201, 255, 0.18);
    background: rgba(15, 26, 38, 0.85);
    color: #b8ccd9;
    text-decoration: none;
    font: 600 12px/1 var(--font-body);
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .acc-mini-guest:hover,
  .acc-mini-user:hover {
    border-color: rgba(76, 201, 255, 0.42);
    background: rgba(22, 37, 54, 0.95);
    transform: translateY(-1px);
  }
  .acc-mini-guest strong {
    color: #4cc9ff;
    font-weight: 700;
  }
  .acc-mini-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cc9ff;
    box-shadow: 0 0 10px rgba(76, 201, 255, 0.8);
  }
  .acc-mini-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font: 800 10px/1 var(--font-display);
    overflow: hidden;
  }
  .acc-mini-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .acc-mini-name {
    color: #f5f8fb;
    font-weight: 700;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .acc-mini-pill {
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.14);
    border: 1px solid rgba(76, 201, 255, 0.28);
    color: #8ee0ff;
    font: 800 11px/1 var(--font-body);
  }
  .acc-mini-xp {
    color: #8ca3b5;
    font: 700 11.5px/1 var(--font-body);
  }

  .acc-tabs {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(15, 26, 38, 0.92), rgba(9, 17, 26, 0.92));
    box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.55);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .acc-tabs::-webkit-scrollbar {
    display: none;
  }
  .acc-tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border-radius: 11px;
    color: #93a8b8;
    text-decoration: none;
    font: 700 13px/1 var(--font-body);
    transition: color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .acc-tab:hover {
    color: #f5f8fb;
    background: rgba(255, 255, 255, 0.04);
  }
  .acc-tab.active {
    color: #f5f8fb;
    background: linear-gradient(135deg, rgba(76, 201, 255, 0.18), rgba(76, 201, 255, 0.07));
    box-shadow: inset 0 0 0 1px rgba(76, 201, 255, 0.34), 0 8px 20px -10px rgba(76, 201, 255, 0.35);
  }
  .acc-tab-ico {
    display: inline-flex;
    color: #67b9dc;
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .acc-tab.active .acc-tab-ico {
    color: #4cc9ff;
    transform: scale(1.06);
  }

  @media (max-width: 640px) {
    .acc-nav-shell {
      margin-bottom: 20px;
    }
    .acc-mini-xp {
      display: none;
    }
    .acc-tab {
      min-height: 40px;
      padding: 0 13px;
      font-size: 12.5px;
    }
  }
</style>
