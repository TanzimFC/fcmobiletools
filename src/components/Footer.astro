---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-glow"></div>
  <div class="wrap footer-grid">
    <div class="footer-brand"><a class="footer-logo" href="/"><img src="/assets/images/logo.png" alt="FCMOBILETOOLS" /></a><p>FC Mobile tools, live resources and useful articles built to help you play with less searching.</p><div class="footer-note">Fan-made • Not affiliated with EA or FC Mobile</div></div>
    <div class="footer-col"><b>TOOLS</b><a href="/team-ovr">Team OVR</a><a href="/training-calculator">Training Calculator</a><a href="/rank-up-calculator">Rank Up Calculator</a><a href="/investment-calculator">Investment Calculator</a></div>
    <div class="footer-col"><b>LIVE</b><a href="/reset-center">Events &amp; Reset</a><a href="/redeem-codes">Redeem Codes</a><a href="/football-centre">Football Centre</a><a href="/a-nations-story">A Nation's Story</a></div>
    <div class="footer-col"><b>ARTICLES</b><a href="/blog">All Articles</a><a href="/blog?type=updates">Updates</a><a href="/blog?type=leaks">Leaks</a><a href="/blog?type=guides">Guides</a><a href="/blog?type=analysis">Analysis</a><a href="/blog?type=reviews">Reviews</a></div>
    <div class="footer-col"><b>COMMUNITY</b><a href="/creator">Creators</a><a href="https://www.youtube.com/@tanzimfc" target="_blank" rel="noopener">YouTube</a><a href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener">Discord</a><a href="https://x.com/TanzimFC" target="_blank" rel="noopener">X</a></div>
  </div>
  <div class="footer-bottom wrap"><span>© {year} FCMOBILETOOLS</span><span><a href="/legal/privacy-policy">Privacy</a><a href="/legal/terms-of-use">Terms</a><a href="/legal/disclaimer">Disclaimer</a><a href="/legal/contact">Contact</a></span></div>
</footer>
<style>
.site-footer{position:relative;overflow:hidden;margin-top:70px;border-top:1px solid var(--border);background:#061018;padding:54px 0 18px}.footer-glow{position:absolute;width:500px;height:240px;left:-160px;top:-170px;border-radius:50%;background:radial-gradient(circle,#55c7f21c,transparent 68%);pointer-events:none}
.footer-grid{position:relative;width:min(1200px,calc(100% - 28px));margin:auto;display:grid;grid-template-columns:1.7fr repeat(4,1fr);gap:34px}.footer-logo img{width:168px;height:auto;display:block}.footer-brand p{max-width:330px;color:#7f93a1;font-size:10px;line-height:1.7;margin:15px 0 10px}.footer-note{color:#536b79;font:700 7px var(--mono);letter-spacing:.05em}
.footer-col{display:grid;align-content:start;gap:9px}.footer-col b{color:#4f6572;font:900 8px var(--mono);letter-spacing:.14em;margin-bottom:3px}.footer-col a{color:#8799a5;text-decoration:none;font:700 9px var(--mono);transition:.18s}.footer-col a:hover{color:#dff8ff;transform:translateX(2px)}
.footer-bottom{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:48px;padding-top:17px;border-top:1px solid #172630;color:#506775;font:700 7px var(--mono)}.footer-bottom a{color:inherit;text-decoration:none;margin-left:16px}.footer-bottom a:hover{color:#a9dff1}
@media(max-width:850px){.footer-grid{grid-template-columns:1.5fr 1fr 1fr}.footer-brand{grid-column:1/-1}.footer-grid{gap:24px}}
@media(max-width:520px){.footer-grid{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}.footer-bottom{font-size:6.5px}.footer-bottom span:last-child{display:grid;grid-template-columns:1fr 1fr;gap:7px}.footer-bottom a{margin:0}}
</style>
