---
import { formatCoins, formatCoinsExact } from '../lib/formatCoins.js';

const { player, href = `/player/${player?.slug}/`, image = player?.image || null } = Astro.props;
const initials = player?.name?.split(/\s+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase() || 'FC';
const sellPrice = player?.sell_price?.current_sell_price;
const sellPriceLabel = sellPrice != null ? formatCoins(sellPrice) : null;
const sellPriceExact = sellPrice != null ? formatCoinsExact(sellPrice) : null;
---
<a class="player-card-shell" href={href} data-player-card={player?.player_id}>
  <div class="player-card-art">
    <div class="player-card-fallback" aria-hidden="true">{initials}</div>
    {image && <img src={image} alt={`${player.name} ${player.ovr} OVR player card`} loading="lazy" decoding="async" onerror="this.remove()" />}
    <span class="player-card-ovr"><b>{player?.ovr ?? '—'}</b><small>OVR</small></span>
    <span class="player-card-position">{player?.position || '—'}</span>
    {sellPriceLabel && <span class="player-card-price" title={`${sellPriceExact} coins`}>◈ {sellPriceLabel}</span>}
    {player?.shard_cost && <span class="player-card-shards">✦ {Number(player.shard_cost.shard_cost).toLocaleString()} shards</span>}
  </div>
  <div class="player-card-copy"><h2>{player?.name || 'Player'}</h2><p>{player?.event || 'FC Mobile player'}</p></div>
</a>
