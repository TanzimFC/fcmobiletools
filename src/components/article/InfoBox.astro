---
const { label = 'Official', title = '', variant = 'info' } = Astro.props;
---
<aside class:list={['article-block','article-info',variant]} role="note">
  <div class="block-mark" aria-hidden="true"><span></span></div>
  <div class="block-content">
    <span class="block-label">{label}</span>
    {title ? <strong>{title}</strong> : null}
    <div class="block-body"><slot /></div>
  </div>
</aside>
<style>
.article-block{display:grid;grid-template-columns:4px minmax(0,1fr);gap:15px;margin:30px 0;padding:17px 19px;border:1px solid rgba(255,255,255,.08);border-radius:16px;background:linear-gradient(145deg,rgba(17,31,43,.94),rgba(9,18,27,.96));box-shadow:0 18px 55px rgba(0,0,0,.2)}
.block-mark{padding:2px 0;border-radius:999px;background:#4cc9ff}
.block-content{min-width:0;display:grid;gap:5px}
.block-label{font:800 8px/1 var(--font-body);letter-spacing:.12em;text-transform:uppercase;color:#7bcff0}
.block-content strong{font:700 16px/1.35 var(--font-display);color:#eef9fd}
.block-body{color:#aec0c8;font:400 13px/1.72 var(--font-body)}
.block-body :global(p){margin:0}
.article-info.official{border-color:rgba(76,201,255,.16)}
.article-info.official .block-mark{background:#4cc9ff}
.article-info.official .block-label{color:#72d6fb}
.article-info.warning{border-color:rgba(240,204,121,.2);background:linear-gradient(145deg,rgba(49,39,17,.58),rgba(22,18,10,.8))}
.article-info.warning .block-mark{background:#f0cc79}.article-info.warning .block-label{color:#f0cc79}
.article-info.danger{border-color:rgba(255,112,112,.18);background:linear-gradient(145deg,rgba(52,19,23,.56),rgba(24,11,14,.8))}
.article-info.danger .block-mark{background:#ff7070}.article-info.danger .block-label{color:#ff9696}
</style>