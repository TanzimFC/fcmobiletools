---
const { items = [] } = Astro.props;
---
<div class="article-timeline" aria-label="Timeline">
  {items.map((item,index)=>(
    <div class="timeline-item">
      <div class="timeline-rail" aria-hidden="true"><span></span></div>
      <div class="timeline-copy">
        <span class="timeline-step">{item.date ?? item.label ?? ('Step ' + (index + 1))}</span>
        {item.title ? <strong>{item.title}</strong> : null}
        {item.text ? <p>{item.text}</p> : null}
      </div>
    </div>
  ))}
</div>
<style>
.article-timeline{display:grid;margin:30px 0;padding:8px 0}
.timeline-item{display:grid;grid-template-columns:25px minmax(0,1fr);gap:12px;min-height:68px}
.timeline-rail{position:relative;display:flex;justify-content:center}.timeline-rail:after{content:"";position:absolute;top:12px;bottom:-12px;width:1px;background:rgba(76,201,255,.18)}.timeline-item:last-child .timeline-rail:after{display:none}
.timeline-rail span{position:relative;z-index:1;width:9px;height:9px;margin-top:9px;border:2px solid #4cc9ff;border-radius:50%;background:#071018;box-shadow:0 0 0 4px rgba(76,201,255,.06)}
.timeline-copy{padding-bottom:17px;display:grid;gap:4px}.timeline-step{font:800 7px/1 var(--font-body);letter-spacing:.13em;text-transform:uppercase;color:#69c9ea}.timeline-copy strong{font:700 15px/1.35 var(--font-display);color:#ecf8fb}.timeline-copy p{margin:0;color:#91a9b4;font:400 12px/1.7 var(--font-body)}
</style>