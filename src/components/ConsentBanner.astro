---
import { getLocaleFromPath, namespace } from '../i18n/index.js';
// The banner follows the page language. The legal pages it links to are English only.
const C = namespace(getLocaleFromPath(Astro.url.pathname), 'consent');
---

<div class="fcmt-consent" id="fcmtConsent" hidden data-consent-version="2">
  <div class="fcmt-consent-card" role="dialog" aria-labelledby="fcmtConsentTitle" aria-describedby="fcmtConsentText">
    <div class="fcmt-consent-head">
      <span class="fcmt-consent-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 7.9 7.5 9.5 4.4-1.6 7.5-4.9 7.5-9.5V6L12 3z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
      </span>
      <h2 id="fcmtConsentTitle">{C.title}</h2>
    </div>
    <p id="fcmtConsentText">{C.text}</p>
    <div class="fcmt-consent-actions">
      <button type="button" class="fcmt-consent-btn primary" data-consent="basic"><span>{C.continue}</span></button>
      <button type="button" class="fcmt-consent-btn secondary" data-consent="manage">{C.manage}</button>
    </div>
    <a class="fcmt-consent-policy" href="/legal/privacy-policy#privacy-choices">{C.policy}</a>
  </div>
</div>

<div class="fcmt-consent-modal" id="fcmtConsentModal" hidden>
  <div class="fcmt-consent-backdrop" data-consent-close></div>
  <div class="fcmt-consent-settings" role="dialog" aria-modal="true" aria-labelledby="fcmtSettingsTitle">
    <div class="fcmt-settings-head">
      <div>
        <h2 id="fcmtSettingsTitle">{C.settingsTitle}</h2>
        <p>{C.settingsLead}</p>
      </div>
      <button type="button" class="fcmt-settings-close" aria-label={C.closeAria} data-consent-close>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    <div class="fcmt-setting-list">
      <section class="fcmt-setting">
        <div>
          <strong>{C.essential}</strong>
          <p>{C.essentialText}</p>
        </div>
        <span class="fcmt-setting-status">{C.alwaysOn}</span>
      </section>

      <section class="fcmt-setting">
        <div>
          <strong>{C.analytics}</strong>
          <p>{C.analyticsText}</p>
        </div>
        <span class="fcmt-setting-status is-off">{C.disabled}</span>
      </section>

      <section class="fcmt-setting">
        <div>
          <strong>{C.advertising}</strong>
          <p>{C.advertisingText}</p>
        </div>
        <label class="fcmt-toggle">
          <input id="fcmtAdvertising" type="checkbox" />
          <span class="fcmt-track"></span>
          <em data-on={C.on} data-off={C.off}></em>
        </label>
      </section>
    </div>

    <div class="fcmt-settings-foot">
      <a href="/legal/cookie-policy#privacy-choices">{C.cookiePolicy}</a>
      <div>
        <button type="button" class="fcmt-consent-btn ghost" data-consent="basic">{C.basic}</button>
        <button type="button" class="fcmt-consent-btn primary" data-consent="save"><span>{C.save}</span></button>
      </div>
    </div>
  </div>
</div>

<style>
.fcmt-consent,
.fcmt-consent-modal{font-family:var(--font-body);--ease-out:cubic-bezier(.22,1,.36,1)}
.fcmt-consent[hidden],
.fcmt-consent-modal[hidden]{display:none!important}

/* ---------- Banner: a small card in the corner, one short slide-in, nothing looping ---------- */
.fcmt-consent{position:fixed;left:16px;bottom:16px;z-index:4900;width:min(400px,calc(100vw - 32px));pointer-events:none}
.fcmt-consent-card{pointer-events:auto;padding:18px;border-radius:var(--r-lg);border:1px solid var(--line-hi);background:linear-gradient(165deg,#15293d,#0b1824);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 24px 60px -18px rgba(0,0,0,.8);opacity:0;transform:translateY(18px);transition:opacity .3s ease,transform .4s var(--ease-out)}
.fcmt-consent.is-open .fcmt-consent-card{opacity:1;transform:none}
.fcmt-consent.is-closing .fcmt-consent-card{opacity:0;transform:translateY(12px);transition-duration:.22s}
.fcmt-consent-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.fcmt-consent-icon{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:var(--r-sm);color:var(--primary);background:var(--primary-soft);border:1px solid rgba(76,201,255,.25)}
.fcmt-consent h2{margin:0;font:700 16px/1.3 var(--font-body);letter-spacing:0;color:var(--text)}
.fcmt-consent p{margin:0;color:var(--muted-strong);font:500 14px/1.55 var(--font-body)}
.fcmt-consent-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.fcmt-consent-policy{display:inline-block;margin-top:12px;color:var(--muted);font:600 13px/1.3 var(--font-body);text-decoration:underline;text-decoration-color:rgba(255,255,255,.25);text-underline-offset:3px;transition:color .2s}
.fcmt-consent-policy:hover{color:var(--text)}

/* ---------- Buttons ---------- */
.fcmt-consent-btn{min-height:44px;padding:0 14px;border:1px solid var(--line-hi);border-radius:var(--r-md);background:rgba(255,255,255,.04);color:var(--text);font:700 14px/1 var(--font-body);cursor:pointer;transition:transform .2s var(--ease-out),border-color .2s,background .2s,box-shadow .25s}
.fcmt-consent-btn:hover{transform:translateY(-1px);border-color:rgba(76,201,255,.45);background:rgba(76,201,255,.09)}
.fcmt-consent-btn:active{transform:none}
.fcmt-consent-btn:focus-visible,.fcmt-settings-close:focus-visible{outline:2px solid var(--primary);outline-offset:3px}
.fcmt-consent-btn.primary{border-color:rgba(255,255,255,.3);background:linear-gradient(135deg,#9be8ff,#4cc9ff 55%,#2fb0ea);color:var(--primary-ink);box-shadow:0 1px 0 rgba(255,255,255,.45) inset,0 10px 24px -10px rgba(76,201,255,.65)}
.fcmt-consent-btn.primary:hover{background:linear-gradient(135deg,#b8f0ff,#6bd4ff 55%,#3dbcf5)}
.fcmt-consent-btn.ghost{background:transparent;color:var(--muted-strong)}

/* ---------- Settings dialog ---------- */
.fcmt-consent-modal{position:fixed;inset:0;z-index:4950;display:grid;place-items:center;padding:20px}
.fcmt-consent-backdrop{position:absolute;inset:0;background:rgba(2,8,13,.78);opacity:0;transition:opacity .25s ease}
.fcmt-consent-modal.is-open .fcmt-consent-backdrop{opacity:1}
.fcmt-consent-settings{position:relative;width:min(600px,100%);max-height:min(760px,calc(100vh - 40px));overflow:auto;padding:24px;border-radius:var(--r-lg);border:1px solid var(--line-hi);background:linear-gradient(180deg,#13263a,#0a1722);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 40px 100px rgba(0,0,0,.7);opacity:0;transform:translateY(18px);transition:opacity .25s ease,transform .4s var(--ease-out);overscroll-behavior:contain}
.fcmt-consent-modal.is-open .fcmt-consent-settings{opacity:1;transform:none}
.fcmt-settings-head{display:flex;gap:18px;justify-content:space-between}
.fcmt-settings-head h2{margin:0 0 6px;font:700 24px/1.15 var(--font-display);letter-spacing:-.02em;color:var(--text)}
.fcmt-settings-head p{margin:0;max-width:46ch;color:var(--muted);font:500 14px/1.55 var(--font-body)}
.fcmt-settings-close{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border:1px solid var(--line-soft);border-radius:var(--r-md);background:rgba(255,255,255,.04);color:var(--muted-strong);cursor:pointer;transition:background .2s,color .2s}
.fcmt-settings-close:hover{background:rgba(255,255,255,.1);color:var(--text)}
.fcmt-setting-list{display:grid;gap:10px;margin-top:20px}
.fcmt-setting{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 16px;border:1px solid var(--line-soft);border-radius:var(--r-md);background:rgba(255,255,255,.025);transition:border-color .25s,background .25s}
.fcmt-setting:has(input:checked){border-color:rgba(76,201,255,.32);background:rgba(76,201,255,.07)}
.fcmt-setting strong{display:block;color:var(--text);font:700 15px/1.3 var(--font-body)}
.fcmt-setting p{max-width:46ch;margin:4px 0 0;color:var(--muted);font:500 13.5px/1.5 var(--font-body)}
.fcmt-setting-status{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;padding:6px 11px;border-radius:999px;background:rgba(61,220,151,.1);color:#a8f3cf;font:700 12px/1 var(--font-body)}
.fcmt-setting-status::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.fcmt-setting-status.is-off{background:rgba(255,255,255,.06);color:var(--muted)}

/* Toggle */
.fcmt-toggle{position:relative;display:flex;align-items:center;gap:10px;flex:0 0 auto;cursor:pointer;color:var(--muted);font:700 13px/1 var(--font-body)}
.fcmt-toggle input{position:absolute;opacity:0;pointer-events:none}
.fcmt-toggle .fcmt-track{position:relative;width:50px;height:28px;border:1px solid var(--line-hi);border-radius:99px;background:#162a3d;transition:background .25s,border-color .25s}
.fcmt-toggle .fcmt-track::after{content:"";position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:#8da0b3;transition:transform .3s var(--ease-out),background .2s}
.fcmt-toggle input:checked+.fcmt-track{border-color:rgba(76,201,255,.55);background:rgba(76,201,255,.28)}
.fcmt-toggle input:checked+.fcmt-track::after{transform:translateX(22px);background:#dff6ff}
.fcmt-toggle input:focus-visible+.fcmt-track{outline:2px solid var(--primary);outline-offset:3px}
.fcmt-toggle em{min-width:24px;font-style:normal}
.fcmt-toggle em::after{content:attr(data-off)}
.fcmt-toggle input:checked~em{color:#bdeeff}
.fcmt-toggle input:checked~em::after{content:attr(data-on)}

.fcmt-settings-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px;padding-top:16px;border-top:1px solid var(--line-soft)}
.fcmt-settings-foot>a{color:var(--muted);font:600 13px/1.3 var(--font-body);text-decoration:underline;text-decoration-color:rgba(255,255,255,.25);text-underline-offset:3px}
.fcmt-settings-foot>a:hover{color:var(--text)}
.fcmt-settings-foot>div{display:flex;gap:8px}

html.fcmt-consent-lock,html.fcmt-consent-lock body{overflow:hidden!important}

/* ---------- Wide screens: a slim bar along the bottom instead of a card over the hero ---------- */
@media(min-width:900px){
  .fcmt-consent{left:50%;right:auto;bottom:20px;width:min(960px,calc(100vw - 48px));margin-left:max(-480px,calc(-50vw + 24px))}
  .fcmt-consent-card{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"head actions" "text actions" "policy actions";column-gap:28px;align-items:center;padding:16px 20px}
  .fcmt-consent-head{grid-area:head;margin:0 0 4px}
  .fcmt-consent p{grid-area:text}
  .fcmt-consent-policy{grid-area:policy;margin-top:8px}
  .fcmt-consent-actions{grid-area:actions;grid-template-columns:1fr;margin:0;width:200px}
}

/* ---------- Phones: sit above the bottom tab bar ---------- */
@media(max-width:980px){
  .fcmt-consent{left:12px;right:12px;width:auto;bottom:calc(12px + var(--dock-h,0px))}
}
@media(max-width:520px){
  .fcmt-consent-modal{align-items:end;padding:0}
  .fcmt-consent-settings{width:100%;max-height:88vh;padding:20px 18px 22px;border-radius:var(--r-lg) var(--r-lg) 0 0;transform:translateY(40px)}
  .fcmt-settings-head h2{font-size:21px}
  .fcmt-setting{align-items:flex-start;flex-direction:column;gap:12px}
  .fcmt-toggle{width:100%;justify-content:space-between;flex-direction:row-reverse}
  .fcmt-settings-foot{align-items:stretch;flex-direction:column-reverse}
  .fcmt-settings-foot>a{align-self:center}
  .fcmt-settings-foot>div{display:grid;grid-template-columns:1fr 1fr}
}
/* Never sit on top of the open menu or another dialog */
html:has(#fcmtSheet[aria-hidden="false"]) .fcmt-consent,
html:has(#fcmtPal[aria-hidden="false"]) .fcmt-consent{opacity:0;pointer-events:none;visibility:hidden}
@media(max-width:520px){
  .fcmt-consent-card{padding:14px}
  .fcmt-consent-head{margin-bottom:6px}
  .fcmt-consent-icon{flex-basis:28px;width:28px;height:28px}
  .fcmt-consent h2{font-size:15px}
  .fcmt-consent p{font-size:13px;line-height:1.5}
  .fcmt-consent-actions{margin-top:12px;gap:8px}
  .fcmt-consent-btn{min-height:42px;font-size:13.5px}
  .fcmt-consent-policy{margin-top:8px;font-size:12.5px}
}
@media(prefers-reduced-motion:reduce){
  .fcmt-consent-card,.fcmt-consent-settings,.fcmt-consent-backdrop{transition:opacity .15s ease!important;transform:none!important}
  .fcmt-toggle .fcmt-track::after{transition:none}
}
</style>

<script is:inline>
(() => {
  const root = document.documentElement;
  const banner = document.getElementById('fcmtConsent');
  const modal = document.getElementById('fcmtConsentModal');
  if (!banner || !modal) return;

  const panel = modal.querySelector('.fcmt-consent-settings');
  const COOKIE = 'fcmobiletools_consent';
  const VERSION = '2';
  const maxAge = 60 * 60 * 24 * 180;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const OUT = reduced ? 0 : 360;
  let lastFocus = null;

  const readCookie = () => {
    const row = document.cookie.split('; ').find((item) => item.startsWith(COOKIE + '='));
    if (!row) return null;
    try { return JSON.parse(decodeURIComponent(row.slice(COOKIE.length + 1))); } catch { return null; }
  };

  const writeCookie = (value) => {
    document.cookie = COOKIE + '=' + encodeURIComponent(JSON.stringify({
      version: VERSION,
      analytics: !!value.analytics,
      advertising: !!value.advertising,
      ts: new Date().toISOString()
    })) + '; Max-Age=' + maxAge + '; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
  };

  const showBanner = () => {
    if (readCookie()?.version === VERSION) return;
    banner.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('is-open')));
  };

  const hideBanner = () => {
    banner.classList.add('is-closing');
    banner.classList.remove('is-open');
    window.setTimeout(() => { banner.hidden = true; banner.classList.remove('is-closing'); }, OUT);
  };

  const openModal = () => {
    const current = readCookie() || { analytics: false, advertising: false };
    document.getElementById('fcmtAdvertising').checked = !!current.advertising;
    lastFocus = document.activeElement;
    modal.hidden = false;
    root.classList.add('fcmt-consent-lock');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      modal.classList.add('is-open');
      window.setTimeout(() => panel.querySelector('.fcmt-consent-btn.primary')?.focus({ preventScroll: true }), reduced ? 0 : 350);
    }));
  };

  const closeModal = (restoreFocus = true) => {
    if (modal.hidden) return;
    modal.classList.remove('is-open');
    root.classList.remove('fcmt-consent-lock');
    window.setTimeout(() => {
      modal.hidden = true;
      if (restoreFocus && lastFocus && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
    }, OUT);
  };

  const apply = (choice) => {
    // Analytics remains disabled. This choice controls optional ad-related storage and eligible
    // third-party requests, not house promotions or sponsor placements.
    const safeChoice = { analytics: false, advertising: !!choice.advertising };
    writeCookie(safeChoice);
    hideBanner();
    closeModal(false);
    window.dispatchEvent(new CustomEvent('fcmobiletools:consent-updated', { detail: safeChoice }));
  };

  banner.querySelector('[data-consent="basic"]')?.addEventListener('click', () => apply({ analytics: false, advertising: false }));
  banner.querySelector('[data-consent="manage"]')?.addEventListener('click', openModal);

  modal.querySelectorAll('[data-consent-close]').forEach((el) => el.addEventListener('click', () => closeModal()));
  modal.querySelector('[data-consent="basic"]')?.addEventListener('click', () => apply({ analytics: false, advertising: false }));
  modal.querySelector('[data-consent="save"]')?.addEventListener('click', () => apply({
    analytics: false,
    advertising: document.getElementById('fcmtAdvertising').checked
  }));

  document.addEventListener('keydown', (event) => {
    if (modal.hidden) return;
    if (event.key === 'Escape') { closeModal(); return; }
    if (event.key !== 'Tab') return;
    // Keep keyboard focus inside the open settings dialog
    const focusable = panel.querySelectorAll('a[href],button:not([disabled]),input:not([disabled])');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });

  window.FCMOBILETOOLS_OPEN_PRIVACY_CHOICES = () => {
    openModal();
    return true;
  };

  const existing = readCookie();
  if (existing?.version === VERSION) {
    // A saved choice is already applied. No analytics tag is enabled by this banner.
  } else {
    // Small delay so the banner arrives after the page has settled
    window.setTimeout(showBanner, reduced ? 0 : 700);
  }
})();
</script>
