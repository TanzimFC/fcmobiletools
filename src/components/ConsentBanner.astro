---
---

<div class="fcmt-consent" id="fcmtConsent" hidden data-consent-version="1">
  <div class="fcmt-consent-card" role="dialog" aria-labelledby="fcmtConsentTitle" aria-describedby="fcmtConsentText">
    <div class="fcmt-consent-glow" aria-hidden="true"></div>

    <div class="fcmt-consent-icon fcmt-r" style="--i:0" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" />
        <path d="M8.5 8.5v.01M16 15.5v.01M12 12v.01M11 17v.01M7 14v.01" />
      </svg>
    </div>

    <div class="fcmt-consent-copy">
      <h2 id="fcmtConsentTitle" class="fcmt-r" style="--i:1">Your privacy matters</h2>
      <p id="fcmtConsentText" class="fcmt-r" style="--i:2">We use cookies to keep FCMOBILETOOLS running, understand how the site is used, and support advertising. Accept all, reject the optional ones, or choose what you allow.</p>
      <a class="fcmt-consent-policy fcmt-r" style="--i:3" href="/legal/privacy-policy#privacy-choices">Read our privacy policy</a>
    </div>

    <div class="fcmt-consent-actions fcmt-r" style="--i:3">
      <button type="button" class="fcmt-consent-btn ghost" data-consent="reject">Reject non-essential</button>
      <button type="button" class="fcmt-consent-btn secondary" data-consent="manage">Manage choices</button>
      <button type="button" class="fcmt-consent-btn primary" data-consent="accept"><span>Accept all</span></button>
    </div>
  </div>
</div>

<div class="fcmt-consent-modal" id="fcmtConsentModal" hidden>
  <div class="fcmt-consent-backdrop" data-consent-close></div>
  <div class="fcmt-consent-settings" role="dialog" aria-modal="true" aria-labelledby="fcmtSettingsTitle">
    <div class="fcmt-settings-head">
      <div>
        <h2 id="fcmtSettingsTitle">Control your choices</h2>
        <p>Choose which optional technologies FCMOBILETOOLS can use. You can change this any time.</p>
      </div>
      <button type="button" class="fcmt-settings-close" aria-label="Close privacy settings" data-consent-close>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    <div class="fcmt-setting-list">
      <section class="fcmt-setting fcmt-r" style="--i:0">
        <div>
          <strong>Essential</strong>
          <p>Core site functionality, security, and remembering the preferences the site needs.</p>
        </div>
        <span class="fcmt-setting-status">Always on</span>
      </section>

      <section class="fcmt-setting fcmt-r" style="--i:1">
        <div>
          <strong>Analytics</strong>
          <p>Aggregate usage data that helps us improve pages, tools, and performance.</p>
        </div>
        <label class="fcmt-toggle">
          <input id="fcmtAnalytics" type="checkbox" />
          <span class="fcmt-track"></span>
          <em></em>
        </label>
      </section>

      <section class="fcmt-setting fcmt-r" style="--i:2">
        <div>
          <strong>Advertising</strong>
          <p>Lets advertising technologies run and show relevant ads where applicable.</p>
        </div>
        <label class="fcmt-toggle">
          <input id="fcmtAdvertising" type="checkbox" />
          <span class="fcmt-track"></span>
          <em></em>
        </label>
      </section>
    </div>

    <div class="fcmt-settings-foot fcmt-r" style="--i:3">
      <a href="/legal/cookie-policy#privacy-choices">Cookie policy</a>
      <div>
        <button type="button" class="fcmt-consent-btn ghost" data-consent="reject">Reject all</button>
        <button type="button" class="fcmt-consent-btn primary" data-consent="save"><span>Save choices</span></button>
      </div>
    </div>
  </div>
</div>

<style>
@property --fcmt-angle{syntax:'<angle>';inherits:false;initial-value:0deg}

.fcmt-consent,
.fcmt-consent-modal{font-family:var(--font-body);--ease-spring:cubic-bezier(.34,1.45,.5,1);--ease-out:cubic-bezier(.2,.8,.2,1)}
.fcmt-consent[hidden],
.fcmt-consent-modal[hidden]{display:none!important}

/* Staggered content reveal, driven by --i */
.fcmt-r{opacity:0;transform:translateY(10px);transition:opacity .45s ease,transform .55s var(--ease-out)}
.is-open .fcmt-r{opacity:1;transform:none;transition-delay:calc(var(--i,0) * 70ms + 160ms)}

/* ---------- Floating banner ---------- */
.fcmt-consent{position:fixed;left:16px;right:16px;bottom:18px;z-index:4900;pointer-events:none}
.fcmt-consent-card{position:relative;width:min(980px,100%);margin:0 auto;display:flex;align-items:center;gap:22px;padding:20px 22px;border-radius:26px;background:linear-gradient(140deg,rgba(20,36,52,.92),rgba(7,16,24,.96));box-shadow:0 30px 80px -10px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.07),0 1px 0 rgba(255,255,255,.09) inset;backdrop-filter:blur(26px) saturate(170%);-webkit-backdrop-filter:blur(26px) saturate(170%);pointer-events:auto;opacity:0;transform:translateY(56px) scale(.96);transition:transform .7s var(--ease-spring),opacity .35s ease}
.fcmt-consent.is-open .fcmt-consent-card{opacity:1;transform:none;animation:fcmt-float 7s ease-in-out 1.2s infinite}
.fcmt-consent.is-closing .fcmt-consent-card{opacity:0;transform:translateY(40px) scale(.97);animation:none;transition:transform .35s ease-in,opacity .28s ease}

/* One light sweep around the border on entrance, then it settles */
.fcmt-consent-card::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;background:conic-gradient(from var(--fcmt-angle),transparent 0 55%,rgba(76,201,255,.95) 75%,rgba(143,227,255,.9) 82%,transparent 92%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);pointer-events:none;opacity:0}
.fcmt-consent.is-open .fcmt-consent-card::before{animation:fcmt-sweep 5.4s .55s cubic-bezier(.4,0,.2,1) 1 forwards}

.fcmt-consent-glow{position:absolute;inset:auto 8% -46px 8%;height:70px;border-radius:50%;background:radial-gradient(closest-side,rgba(76,201,255,.34),transparent);filter:blur(22px);pointer-events:none;opacity:0;transition:opacity 1s .4s ease}
.fcmt-consent.is-open .fcmt-consent-glow{opacity:1}

.fcmt-consent-icon{position:relative;display:grid;place-items:center;flex:0 0 54px;width:54px;height:54px;border-radius:18px;color:#8fe3ff;background:linear-gradient(145deg,rgba(76,201,255,.2),rgba(76,201,255,.05));box-shadow:0 0 0 1px rgba(76,201,255,.24) inset,0 10px 28px rgba(76,201,255,.14)}
.fcmt-consent-icon::after{content:"";position:absolute;inset:-1px;border-radius:inherit;border:1px solid rgba(76,201,255,.45);opacity:0}
.fcmt-consent.is-open .fcmt-consent-icon::after{animation:fcmt-ping 1.8s 1s ease-out 2}
.fcmt-consent-icon svg{transition:transform .6s var(--ease-spring)}
.fcmt-consent.is-open .fcmt-consent-icon svg{animation:fcmt-wobble 1.1s .7s ease-in-out 1}

.fcmt-consent-copy{min-width:0;flex:1}
.fcmt-consent h2{margin:0 0 5px;font:800 clamp(19px,1.8vw,24px)/1.1 var(--font-display);letter-spacing:-.03em;color:var(--text)}
.fcmt-consent p{margin:0;max-width:56ch;color:#a9b9c8;font:500 12.5px/1.65 var(--font-body)}
.fcmt-consent-policy{display:inline-block;margin-top:8px;color:#7fdcff;font:700 11.5px/1.3 var(--font-body);text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;padding-bottom:2px;transition:background-size .3s var(--ease-out),color .2s}
.fcmt-consent-policy:hover,.fcmt-consent-policy:focus-visible{background-size:100% 1px;color:#b8ecff}

.fcmt-consent-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex:0 0 auto}

/* ---------- Buttons ---------- */
.fcmt-consent-btn{position:relative;overflow:hidden;min-height:44px;padding:0 16px;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:rgba(255,255,255,.04);color:var(--text);font:800 12px/1 var(--font-body);letter-spacing:.01em;cursor:pointer;transition:transform .25s var(--ease-spring),border-color .2s,background .2s,box-shadow .25s,color .2s}
.fcmt-consent-btn:hover{transform:translateY(-2px);border-color:rgba(76,201,255,.3);background:rgba(255,255,255,.075)}
.fcmt-consent-btn:active{transform:translateY(0) scale(.97);transition-duration:.08s}
.fcmt-consent-btn:focus-visible,.fcmt-settings-close:focus-visible{outline:2px solid var(--primary);outline-offset:3px}
.fcmt-consent-btn.primary{border-color:transparent;background:linear-gradient(135deg,#9be8ff,#4cc9ff 55%,#2fb0ea);color:#03131c;box-shadow:0 12px 30px -6px rgba(76,201,255,.45),0 1px 0 rgba(255,255,255,.5) inset}
.fcmt-consent-btn.primary:hover{box-shadow:0 18px 38px -6px rgba(76,201,255,.6),0 1px 0 rgba(255,255,255,.5) inset}
.fcmt-consent-btn.primary::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-120%);transition:transform .7s var(--ease-out)}
.fcmt-consent-btn.primary:hover::after{transform:translateX(120%)}
.fcmt-consent-btn.primary span{position:relative;z-index:1}
.fcmt-consent-btn.secondary{background:rgba(76,201,255,.09);border-color:rgba(76,201,255,.22)}
.fcmt-consent-btn.ghost{background:transparent;color:#aebdca}
.fcmt-consent-btn.ghost:hover{color:var(--text)}

/* ---------- Settings modal ---------- */
.fcmt-consent-modal{position:fixed;inset:0;z-index:4950;display:grid;place-items:center;padding:20px}
.fcmt-consent-backdrop{position:absolute;inset:0;background:radial-gradient(60% 50% at 50% 60%,rgba(20,60,90,.4),rgba(2,8,13,.8));backdrop-filter:blur(0);-webkit-backdrop-filter:blur(0);opacity:0;transition:opacity .35s ease,backdrop-filter .45s ease,-webkit-backdrop-filter .45s ease}
.fcmt-consent-modal.is-open .fcmt-consent-backdrop{opacity:1;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}

.fcmt-consent-settings{position:relative;width:min(660px,100%);max-height:min(780px,calc(100vh - 40px));overflow:auto;border-radius:28px;background:linear-gradient(180deg,#14263a,#08121b);box-shadow:0 50px 130px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.09),0 1px 0 rgba(255,255,255,.08) inset;padding:26px;opacity:0;transform:translateY(28px) scale(.95);transition:transform .6s var(--ease-spring),opacity .3s ease;overscroll-behavior:contain}
.fcmt-consent-modal.is-open .fcmt-consent-settings{opacity:1;transform:none}
.fcmt-consent-settings::before{content:"";position:absolute;left:12%;right:12%;top:-1px;height:1px;background:linear-gradient(90deg,transparent,rgba(76,201,255,.8),transparent)}

.fcmt-settings-head{display:flex;gap:20px;justify-content:space-between}
.fcmt-settings-head h2{margin:0 0 8px;font:800 30px/1 var(--font-display);letter-spacing:-.04em;color:var(--text)}
.fcmt-settings-head p{margin:0;color:#8ea0b1;font:500 12.5px/1.6 var(--font-body);max-width:46ch}
.fcmt-settings-close{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.035);color:#a6b5c3;cursor:pointer;transition:transform .35s var(--ease-spring),background .2s,color .2s}
.fcmt-settings-close:hover{transform:rotate(90deg);background:rgba(255,255,255,.08);color:var(--text)}

.fcmt-setting-list{display:grid;gap:10px;margin-top:24px}
.fcmt-setting{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:16px 18px;border:1px solid rgba(255,255,255,.07);border-radius:18px;background:rgba(255,255,255,.025);transition:border-color .3s,background .3s,transform .3s var(--ease-out)}
.fcmt-setting:has(input:checked){border-color:rgba(76,201,255,.28);background:linear-gradient(135deg,rgba(76,201,255,.09),rgba(76,201,255,.02))}
.fcmt-setting strong{display:block;color:var(--text);font:800 13.5px/1.2 var(--font-body)}
.fcmt-setting p{max-width:46ch;margin:6px 0 0;color:#7a8c9d;font:500 12px/1.55 var(--font-body)}
.fcmt-setting-status{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;padding:7px 11px;border-radius:99px;background:rgba(76,201,255,.1);color:#8fe3ff;font:800 11px/1 var(--font-body)}
.fcmt-setting-status::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}

/* Toggle */
.fcmt-toggle{position:relative;display:flex;align-items:center;gap:10px;flex:0 0 auto;cursor:pointer;color:#8293a3;font:700 11px/1 var(--font-body)}
.fcmt-toggle input{position:absolute;opacity:0;pointer-events:none}
.fcmt-toggle .fcmt-track{position:relative;width:52px;height:30px;border:1px solid rgba(255,255,255,.12);border-radius:99px;background:#182635;transition:background .3s,border-color .3s,box-shadow .3s}
.fcmt-toggle .fcmt-track::after{content:"";position:absolute;left:3px;top:3px;width:22px;height:22px;border-radius:50%;background:#7d8d9c;box-shadow:0 2px 6px rgba(0,0,0,.4);transition:transform .45s var(--ease-spring),background .25s,width .2s}
.fcmt-toggle:active .fcmt-track::after{width:27px}
.fcmt-toggle input:checked+.fcmt-track{border-color:rgba(76,201,255,.5);background:linear-gradient(135deg,rgba(76,201,255,.35),rgba(76,201,255,.15));box-shadow:0 0 18px rgba(76,201,255,.25)}
.fcmt-toggle input:checked+.fcmt-track::after{transform:translateX(22px);background:linear-gradient(135deg,#c2f1ff,#4cc9ff)}
.fcmt-toggle:active input:checked+.fcmt-track::after{transform:translateX(17px)}
.fcmt-toggle input:focus-visible+.fcmt-track{outline:2px solid var(--primary);outline-offset:3px}
.fcmt-toggle em{min-width:22px;font-style:normal;transition:color .2s}
.fcmt-toggle em::after{content:"Off"}
.fcmt-toggle input:checked~em{color:#8fe3ff}
.fcmt-toggle input:checked~em::after{content:"On"}

.fcmt-settings-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:20px;padding-top:18px;border-top:1px solid rgba(255,255,255,.075)}
.fcmt-settings-foot>a{color:#7fdcff;font:700 11.5px/1.3 var(--font-body);text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;padding-bottom:2px;transition:background-size .3s var(--ease-out)}
.fcmt-settings-foot>a:hover,.fcmt-settings-foot>a:focus-visible{background-size:100% 1px}
.fcmt-settings-foot>div{display:flex;gap:8px}

html.fcmt-consent-lock,html.fcmt-consent-lock body{overflow:hidden!important}

/* ---------- Keyframes ---------- */
@keyframes fcmt-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes fcmt-sweep{0%{--fcmt-angle:0deg;opacity:1}85%{opacity:1}100%{--fcmt-angle:360deg;opacity:.35}}
@keyframes fcmt-ping{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(1.5)}}
@keyframes fcmt-wobble{0%,100%{transform:rotate(0)}25%{transform:rotate(-14deg)}60%{transform:rotate(10deg)}}

/* ---------- Responsive ---------- */
@media(max-width:820px){
  .fcmt-consent{left:10px;right:10px;bottom:10px}
  .fcmt-consent-card{flex-wrap:wrap;align-items:flex-start;gap:14px 16px;padding:18px;border-radius:22px}
  .fcmt-consent-copy{flex:1 1 calc(100% - 72px)}
  .fcmt-consent-actions{display:grid;grid-template-columns:1fr 1fr;flex:1 1 100%;gap:8px}
  .fcmt-consent-btn{width:100%;min-height:46px}
  .fcmt-consent-btn.primary{grid-column:1/-1;order:-1}
}
@media(max-width:520px){
  .fcmt-consent-icon{flex-basis:46px;width:46px;height:46px;border-radius:15px}
  .fcmt-consent-copy{flex-basis:calc(100% - 62px)}
  .fcmt-consent p{font-size:12px;line-height:1.55}
  .fcmt-consent-modal{align-items:end;padding:0}
  .fcmt-consent-settings{width:100%;max-height:88vh;padding:20px 18px 22px;border-radius:26px 26px 0 0;transform:translateY(100%)}
  .fcmt-settings-head h2{font-size:25px}
  .fcmt-setting{align-items:flex-start;flex-direction:column;gap:14px}
  .fcmt-toggle{width:100%;justify-content:space-between;flex-direction:row-reverse}
  .fcmt-settings-foot{align-items:stretch;flex-direction:column-reverse}
  .fcmt-settings-foot>a{align-self:center}
  .fcmt-settings-foot>div{display:grid;grid-template-columns:1fr 1fr}
}

@media(prefers-reduced-motion:reduce){
  .fcmt-consent-card,.fcmt-consent-settings,.fcmt-r,.fcmt-consent-backdrop,.fcmt-consent-glow{transition:opacity .2s ease!important;transform:none!important;animation:none!important}
  .fcmt-consent-card::before,.fcmt-consent-icon::after,.fcmt-consent-icon svg,.fcmt-consent-btn.primary::after{animation:none!important}
  .fcmt-toggle .fcmt-track::after{transition:none}
}
</style>

<script is:inline>
(() => {
  const root = document.documentElement;
  const banner = document.getElementById('fcmtConsent');
  const modal = document.getElementById('fcmtConsentModal');
  if (!banner || !modal) return;

  const panel = modal.querySelector('.fcmt-consent-settings');
  const COOKIE = 'fcmobiletools_consent';
  const VERSION = '1';
  const maxAge = 60 * 60 * 24 * 180;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const OUT = reduced ? 0 : 360;
  let lastFocus = null;

  const readCookie = () => {
    const row = document.cookie.split('; ').find((item) => item.startsWith(COOKIE + '='));
    if (!row) return null;
    try { return JSON.parse(decodeURIComponent(row.slice(COOKIE.length + 1))); } catch { return null; }
  };

  const writeCookie = (value) => {
    document.cookie = COOKIE + '=' + encodeURIComponent(JSON.stringify({
      version: VERSION,
      analytics: !!value.analytics,
      advertising: !!value.advertising,
      ts: new Date().toISOString()
    })) + '; Max-Age=' + maxAge + '; Path=/; SameSite=Lax';
  };

  const updateGoogleConsent = ({ analytics, advertising }) => {
    if (typeof window.gtag !== 'function') return;
    window.gtag('consent', 'update', {
      analytics_storage: analytics ? 'granted' : 'denied',
      ad_storage: advertising ? 'granted' : 'denied',
      ad_user_data: advertising ? 'granted' : 'denied',
      ad_personalization: advertising ? 'granted' : 'denied'
    });
  };

  const showBanner = () => {
    if (readCookie()?.version === VERSION) return;
    banner.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => banner.classList.add('is-open')));
  };

  const hideBanner = () => {
    banner.classList.add('is-closing');
    banner.classList.remove('is-open');
    window.setTimeout(() => { banner.hidden = true; banner.classList.remove('is-closing'); }, OUT);
  };

  const openModal = () => {
    const current = readCookie() || { analytics: false, advertising: false };
    document.getElementById('fcmtAnalytics').checked = !!current.analytics;
    document.getElementById('fcmtAdvertising').checked = !!current.advertising;
    lastFocus = document.activeElement;
    modal.hidden = false;
    root.classList.add('fcmt-consent-lock');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      modal.classList.add('is-open');
      window.setTimeout(() => panel.querySelector('.fcmt-consent-btn.primary')?.focus({ preventScroll: true }), reduced ? 0 : 350);
    }));
  };

  const closeModal = (restoreFocus = true) => {
    if (modal.hidden) return;
    modal.classList.remove('is-open');
    root.classList.remove('fcmt-consent-lock');
    window.setTimeout(() => {
      modal.hidden = true;
      if (restoreFocus && lastFocus && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
    }, OUT);
  };

  const apply = (choice) => {
    writeCookie(choice);
    updateGoogleConsent(choice);
    hideBanner();
    closeModal(false);
  };

  banner.querySelector('[data-consent="accept"]')?.addEventListener('click', () => apply({ analytics: true, advertising: true }));
  banner.querySelector('[data-consent="reject"]')?.addEventListener('click', () => apply({ analytics: false, advertising: false }));
  banner.querySelector('[data-consent="manage"]')?.addEventListener('click', openModal);

  modal.querySelectorAll('[data-consent-close]').forEach((el) => el.addEventListener('click', () => closeModal()));
  modal.querySelector('[data-consent="reject"]')?.addEventListener('click', () => apply({ analytics: false, advertising: false }));
  modal.querySelector('[data-consent="save"]')?.addEventListener('click', () => apply({
    analytics: document.getElementById('fcmtAnalytics').checked,
    advertising: document.getElementById('fcmtAdvertising').checked
  }));

  document.addEventListener('keydown', (event) => {
    if (modal.hidden) return;
    if (event.key === 'Escape') { closeModal(); return; }
    if (event.key !== 'Tab') return;
    // Keep keyboard focus inside the open settings dialog
    const focusable = panel.querySelectorAll('a[href],button:not([disabled]),input:not([disabled])');
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });

  window.FCMOBILETOOLS_OPEN_PRIVACY_CHOICES = () => {
    openModal();
    return true;
  };

  const existing = readCookie();
  if (existing?.version === VERSION) {
    updateGoogleConsent(existing);
  } else {
    // Small delay so the banner arrives after the page has settled
    window.setTimeout(showBanner, reduced ? 0 : 700);
  }
})();
</script>
