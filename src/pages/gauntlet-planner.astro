---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'FC Mobile Gauntlet Mode Planner',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: 'Plan FC Mobile Gauntlet Mode squad rotations, appearance limits, match lineups and results in your browser.'
};
---

<BaseLayout
  title="FC Mobile Gauntlet Mode Planner | Squad Rotation Tool | FCMOBILETOOLS"
  description="Plan FC Mobile Gauntlet Mode squad rotations, appearance limits, match lineups and results with a free fan-made planner."
>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

<main class="gauntlet-page">
  <header class="page-hero">
    <div class="page-wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">FCMOBILETOOLS</a><span>›</span><span>Gauntlet Mode Planner</span>
      </nav>
      <div class="hero-grid">
        <div>
          <span class="eyebrow">FC MOBILE / GAUNTLET LAB</span>
          <h1>Gauntlet Mode <em>Planner</em></h1>
          <p>Plan your squad rotation before you play. Add your available players, set individual appearance limits, choose your matches and build a lineup plan you can keep updated as you go.</p>
          <div class="pills">
            <span>SQUAD ROTATION</span>
            <span>APPEARANCE LIMITS</span>
            <span>MATCH TRACKING</span>
            <span>BROWSER SAVED</span>
          </div>
        </div>
        <div class="hero-mark" aria-hidden="true">
          <strong>XI</strong>
          <small>GAUNTLET</small>
        </div>
      </div>
    </div>
  </header>

  <section class="tool-section page-wrap">
    <div class="gauntlet" data-gauntlet>
      <header class="intro">
        <span class="tool-eyebrow">FC MOBILE · GAUNTLET</span>
        <h2>Plan your squad rotation</h2>
        <p>Paste your players once. We’ll spread them across your matches and keep track of who is still available.</p>
      </header>

      <div class="progress" aria-label="Planner steps">
        <span class="step active" data-step-dot="1"><b>1</b> Add squad</span><i></i>
        <span class="step" data-step-dot="2"><b>2</b> Plan matches</span>
      </div>

      <div class="view" data-view="setup">
        <div class="setup-grid">
          <article class="box">
            <div class="box-title"><span class="number">01</span><div><h3>Paste your player cards</h3><p>One card per line. Add <code>GK:</code> before goalkeeper names.</p></div></div>
            <label class="sr" for="rosterInput">Player names</label>
            <textarea id="rosterInput" data-roster placeholder="GK: Alisson&#10;Virgil van Dijk | 5&#10;Rúben Dias | 3&#10;Theo Hernández | 1&#10;…" rows="10"></textarea>
            <div class="input-hint"><strong>Set each player’s count:</strong> <code>Van Dijk | 5</code> · <code>Dias | 3</code> · <code>Theo | 1</code>. A plain name uses your default. <code>GK: Alisson</code> always gets 1.</div>
            <button class="text-button" type="button" data-sample>Load a sample squad</button>
          </article>

          <article class="box settings">
            <div class="box-title"><span class="number">02</span><div><h3>Set your plan</h3><p>Player counts can be different. Enter the number shown for each card.</p></div></div>

            <label for="cap">Default for plain outfield names</label>
            <select id="cap" data-cap>
              <option value="1">1 appearance</option>
              <option value="2">2 appearances</option>
              <option value="3" selected>3 appearances</option>
              <option value="4">4 appearances</option>
              <option value="5">5 appearances</option>
            </select>
            <small>This is only a shortcut for names without a number. Add <code>| 1</code> or <code>| 5</code> to set a player’s own count. Check each value in game.</small>

            <label for="matchCount">Matches to plan</label>
            <select id="matchCount" data-count>
              <option>1</option><option>2</option><option selected>3</option><option>4</option>
              <option>5</option><option>6</option><option>7</option><option>8</option>
            </select>

            <div class="keeper-note"><strong>Goalkeepers: 1 appearance</strong><span>Every player marked <code>GK:</code> is limited to one match automatically. Add one available keeper per match.</span></div>
            <button class="button primary make-plan" type="button" data-build>Build my rotation <span aria-hidden="true">→</span></button>
            <p class="error" data-error role="alert"></p>
          </article>
        </div>
        <p class="privacy-note">Your squad stays in this browser and saves automatically.</p>
      </div>

      <div class="view hidden" data-view="planner">
        <div class="toolbar">
          <div><span class="tool-eyebrow">YOUR ROTATION</span><div class="summary" data-summary></div></div>
          <div class="toolbar-actions"><button class="button secondary" type="button" data-rebalance>Rebuild lineups</button><button class="button secondary" type="button" data-edit>← Edit squad</button></div>
        </div>

        <div class="notice" data-notice></div>
        <div class="match-list" data-matches></div>

        <details class="squad-details">
          <summary>See my squad and remaining appearances</summary>
          <div class="squad-list" data-squad-list></div>
        </details>

        <div class="bottom-actions">
          <button class="button secondary" type="button" data-export>Download backup</button>
          <label class="button secondary import-label">Restore backup<input type="file" accept="application/json" data-import /></label>
          <button class="button clear" type="button" data-clear>Clear saved plan</button>
        </div>

        <p class="fineprint">Fan-made planner. A win uses one appearance from each selected player, based on EA’s published Gauntlet description. Check in-game rules for ties, disconnects, or event-specific changes.</p>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="page-wrap prose">
      <div class="section-label">01 / HOW IT WORKS</div>
      <h2>Plan a Gauntlet rotation without keeping everything in your head</h2>
      <p>The Gauntlet Mode Planner is a fan-made FC Mobile squad management tool for players who want a simple record of who is available for each planned match. Enter your squad once, set the appearance limits you are working with, and let the planner build a starting rotation.</p>

      <div class="info-grid">
        <article>
          <span>01</span>
          <h3>Add your players</h3>
          <p>Enter one player per line. You can give a player an individual appearance limit with the <code>| number</code> format. Mark goalkeepers with <code>GK:</code> so the planner can reserve them for one match.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Choose your matches</h3>
          <p>Select how many matches you want to plan. The planner checks the available goalkeeper slots and outfield appearances before creating the rotation.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Review every XI</h3>
          <p>Generated lineups are a starting point. You can manually change selected players, mark substitutes who actually entered, and add a note for the round.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Record what happened</h3>
          <p>Record a win or loss after a match. Completed wins consume planned appearances and keep your remaining availability easier to follow.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="content-section alt">
    <div class="page-wrap prose">
      <div class="section-label">02 / PLAYER LIMITS</div>
      <h2>Different players can have different appearance counts</h2>
      <p>The planner accepts a default appearance count for ordinary outfield names, while allowing you to override that number for individual players.</p>
      <div class="example-card">
        <div><code>Virgil van Dijk | 5</code><span>Up to five planned appearances</span></div>
        <div><code>Rúben Dias | 3</code><span>Up to three planned appearances</span></div>
        <div><code>Theo Hernández | 1</code><span>One planned appearance</span></div>
        <div><code>GK: Alisson</code><span>Goalkeeper limited to one match</span></div>
      </div>
      <p class="small-note">The planner uses the values you enter. It does not automatically verify the current in-game availability of a player.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="page-wrap prose">
      <div class="section-label">03 / USING THE PLAN</div>
      <h2>Keep your plan useful while you play</h2>
      <div class="tips">
        <article><h3>Check the generated XI</h3><p>Before an important match, review the goalkeeper and ten outfield selections and make any changes that match your current squad and event requirements.</p></article>
        <article><h3>Mark substitutes who entered</h3><p>Only mark players who actually came on. Unused bench players are not counted as appearances by the planner.</p></article>
        <article><h3>Use round notes</h3><p>Add reminders for objectives, modifiers, traits, tactical ideas or anything else you want beside that match.</p></article>
        <article><h3>Back up your plan</h3><p>Download a JSON backup when you want a portable copy, then use Restore backup to bring it back into the planner.</p></article>
      </div>
    </div>
  </section>

  <section class="content-section alt">
    <div class="page-wrap prose">
      <div class="section-label">04 / IMPORTANT INFORMATION</div>
      <h2>What the planner can and cannot verify</h2>
      <p>This tool is designed for organization. It works from the player names, roles and appearance limits that you enter in the browser.</p>
      <div class="notice-card">
        <strong>Always verify the current in-game rules.</strong>
        <p>Event requirements, player availability, tie conditions, disconnect handling and other rules can change. Review FC Mobile before relying on a planned rotation for an important match.</p>
      </div>
      <p>The planner is independent and fan-made. FC Mobile, EA SPORTS FC Mobile, EA SPORTS and related marks belong to their respective owners. FCMOBILETOOLS is not affiliated with or endorsed by Electronic Arts.</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="page-wrap prose">
      <div class="section-label">05 / FAQ</div>
      <h2>FC Mobile Gauntlet Mode Planner FAQ</h2>
      <details open><summary>How many players do I need?</summary><p>A complete planned XI requires one goalkeeper and ten outfield players. The planner checks whether enough players and planned appearances are available before creating the requested rotation.</p></details>
      <details><summary>Can every player have a different appearance limit?</summary><p>Yes. Add a number after the name using the <code>|</code> format, such as <code>Player Name | 2</code>.</p></details>
      <details><summary>Can I change the generated lineup?</summary><p>Yes. The generated rotation is editable. Select or remove players from each XI and separately mark substitutes who entered.</p></details>
      <details><summary>Can I track wins and losses?</summary><p>Yes. Each planned match can be recorded as a win or loss, and completed wins update the planned appearance usage.</p></details>
      <details><summary>Does the planner save my squad?</summary><p>The current plan is saved in your browser using local storage. You can also export a JSON backup and restore it later.</p></details>
      <details><summary>Does using the planner connect to my FC Mobile account?</summary><p>No. This is a standalone website utility. It does not perform actions inside your FC Mobile account.</p></details>
      <details><summary>Will the planner always create the right lineup?</summary><p>The planner works from the information you enter. Review every generated XI and compare it with the current in-game requirements before playing.</p></details>
    </div>
  </section>
</main>

<script>
  const root = document.querySelector('[data-gauntlet]');
  if (root) {
    const KEY = 'fcmobiletools-gauntlet-rotation-v2';
    const $ = (s) => root.querySelector(s);
    const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const id = () => Math.random().toString(36).slice(2, 10);
    const blankMatch = (n) => ({id:id(),name:`Match ${n}`,selected:[],note:'',result:null,played:[],subs:[]});
    let state;
    try { state = JSON.parse(localStorage.getItem(KEY)); } catch {}
    if (!state || !Array.isArray(state.players) || !Array.isArray(state.matches)) state = {players:[],matches:[],history:[],cap:2,view:'setup'};

    const save = () => { localStorage.setItem(KEY, JSON.stringify(state)); render(); };
    const pBy = (pid) => state.players.find((p) => p.id === pid);
    const spentPending = (pid, except) => state.matches.filter((m) => !m.result && m.id !== except).reduce((n,m) => n + m.selected.filter((x) => x === pid).length + (m.subs||[]).filter((x) => x === pid).length, 0);
    const remaining = (p) => Math.max(0, p.limit - (p.used || 0));

    function parseRoster(text, cap) {
      const seen = new Map();
      return text.split(/[\n,;]+/).map((raw) => raw.trim()).filter(Boolean).map((raw) => {
        const countMatch = raw.match(/^(.*?)\s*\|\s*(\d+)\s*$/);
        const listedName = (countMatch ? countMatch[1] : raw).trim();
        const listedCount = countMatch ? Math.max(0, Math.min(99, Number(countMatch[2]))) : null;
        const gk = /^(?:GK\s*:\s*)/i.test(listedName) || /\(\s*GK\s*\)$/i.test(listedName) || /(?:\s[-|]\s*GK)$/i.test(listedName);
        const name = listedName.replace(/^(?:GK\s*:\s*)/i,'').replace(/\s*\(\s*GK\s*\)$/i,'').replace(/\s[-|]\s*GK$/i,'').trim();
        const key = name.toLocaleLowerCase();
        if (!name) return null;
        const copy=(seen.get(key)||0)+1;
        seen.set(key,copy);
        return {id:id(),name:copy>1?`${name} (copy ${copy})`:name,role:gk?'GK':'OUT',limit:gk?Math.min(1,listedCount===null?1:listedCount):(listedCount===null?cap:listedCount),used:0};
      }).filter(Boolean);
    }

    function autoBuild(count) {
      if (count === 0) return {matches:[]};
      const players = state.players;
      const keepers = players.filter((p) => p.role === 'GK' && remaining(p) > 0);
      if (keepers.length < count) return {error:`You need ${count} available goalkeeper${count===1?'':'s'} for ${count} matches. Add more keepers, or plan fewer matches.`};
      const outs = players.filter((p) => p.role !== 'GK');
      if (outs.length < 10) return {error:'Add at least 10 outfield players so every match can have a full XI.'};
      if (outs.reduce((sum,p) => sum + remaining(p),0) < count*10) return {error:`There are not enough outfield appearances to fill ${count} lineups. Add players or lower the matches to plan.`};
      const matches = [];
      for (let i=0;i<count;i++) {
        const keeper = keepers[i];
        let eligible = outs.filter((p) => (p.limit - (p.used||0) - matches.filter(m=>m.selected.includes(p.id)).length) > 0);
        eligible.sort((a,b) =>
          matches.filter(m=>m.selected.includes(a.id)).length - matches.filter(m=>m.selected.includes(b.id)).length ||
          remaining(b)-remaining(a) ||
          a.name.localeCompare(b.name)
        );
        const eleven = eligible.slice(0,10);
        if (eleven.length < 10) return {error:`Could only fill ${i} match${i===1?'':'es'}. Add more outfield players or increase their appearance limit.`};
        matches.push({...blankMatch(i+1),selected:[keeper.id,...eleven.map(p=>p.id)]});
      }
      return {matches};
    }

    function validXI(m) {
      const chosen=m.selected.map(pBy).filter(Boolean);
      return chosen.length===11 && chosen.filter(p=>p.role==='GK').length===1 && chosen.filter(p=>p.role!=='GK').length===10;
    }

    function render() {
      const setup = $('[data-view="setup"]');
      const planner = $('[data-view="planner"]');
      setup.classList.toggle('hidden',state.view==='planner');
      planner.classList.toggle('hidden',state.view!=='planner');
      root.querySelectorAll('[data-step-dot]').forEach((el)=>el.classList.toggle('active', Number(el.dataset.stepDot)===(state.view==='planner'?2:1)));
      if(state.view!=='planner') return;

      const wins=state.history.filter(x=>x.result==='win').length;
      const losses=state.history.length-wins;
      $('[data-summary]').textContent=`${state.players.length} players · ${wins} wins · ${losses} losses · ${state.matches.filter(m=>!m.result).length} to play`;

      let notice=$('[data-notice]');
      let keepers=state.players.filter(p=>p.role==='GK').length;
      notice.textContent=keepers<state.matches.length?`You have ${keepers} goalkeeper${keepers===1?'':'s'} for ${state.matches.length} planned matches. Add another keeper or reduce the match count to fill every lineup.`:'';
      notice.classList.toggle('show',!!notice.textContent);

      $('[data-matches]').innerHTML=state.matches.map((m,i)=>{
        const isDone=!!m.result;
        const selected=m.selected||[];
        const subs=m.subs||[];
        const pool=state.players.filter(p=>remaining(p)>0 || selected.includes(p.id) || subs.includes(p.id));
        const choices=pool.map(p=>{
          const reserved=spentPending(p.id,m.id);
          const canPick=remaining(p)>reserved || selected.includes(p.id);
          return `<label class="pick ${canPick?'':'off'}"><input type="checkbox" data-pick="${m.id}" data-id="${p.id}" ${selected.includes(p.id)?'checked':''} ${isDone||!canPick?'disabled':''}><span class="pname">${esc(p.name)}</span>${p.role==='GK'?'<span class="tag">GK · 1 match</span>':''}<span class="left">${remaining(p)} left</span></label>`;
        }).join('');
        const subChoices=pool.filter(p=>!selected.includes(p.id)).map(p=>{
          const reserved=spentPending(p.id,m.id);
          const canPick=remaining(p)>reserved || subs.includes(p.id);
          return `<label class="pick ${canPick?'':'off'}"><input type="checkbox" data-sub="${m.id}" data-id="${p.id}" ${subs.includes(p.id)?'checked':''} ${isDone||!canPick?'disabled':''}><span class="pname">${esc(p.name)}</span>${p.role==='GK'?'<span class="tag">GK · 1 match</span>':''}<span class="left">${remaining(p)} left</span></label>`;
        }).join('');

        return `<article class="match-card">
          <header class="match-head"><div><div class="match-heading">${esc(m.name||`Match ${i+1}`)}</div><div class="match-sub">${isDone?'Result saved':`${selected.length}/11 selected`}</div></div>${isDone?`<span class="result ${m.result==='loss'?'loss':''}">${m.result==='win'?'WIN':'LOSS'}</span>`:''}</header>
          <div class="match-body">
            <div><h4 class="pick-title">Choose your XI <span>· select exactly 1 GK and 10 outfield players</span></h4><div class="player-picks">${choices||'<span class="match-sub">No available players. Edit your squad or rebuild the rotation.</span>'}</div></div>
            <div class="sub-area"><details class="subs-toggle" ${subs.length?'open':''}><summary>${subs.length?`Substitutes who entered (${subs.length})`:'Add any substitutes who entered · optional'}</summary><div class="player-picks">${subChoices||'<span class="match-sub">No other players available.</span>'}</div><small class="sub-help">Only mark players who came on. Unused bench players are not counted.</small></details></div>
            <div class="round-note"><label for="note-${m.id}">Round objective / reminder</label><textarea id="note-${m.id}" data-note="${m.id}" placeholder="Optional: objective, trait, modifier…" ${isDone?'disabled':''}>${esc(m.note||'')}</textarea></div>
            <div class="match-foot">${isDone?`<small>Recorded players: ${m.played.map(x=>esc(x.name)).join(', ')}</small><button class="button secondary" data-undo="${m.id}">Undo result</button>`:`<small>Mark subs who entered before recording the result.</small><span class="toolbar-actions"><button class="button secondary" data-result="loss" data-match="${m.id}" ${!validXI(m)?'disabled':''}>Record loss</button><button class="button primary" data-result="win" data-match="${m.id}" ${!validXI(m)?'disabled':''}>Record win</button></span>`}</div>
          </div>
        </article>`;
      }).join('');

      $('[data-squad-list]').innerHTML=state.players.map(p=>`<div class="squad-item"><span>${esc(p.name)} ${p.role==='GK'?'· GK':''}</span><span>${remaining(p)} / ${p.limit} left</span></div>`).join('');

      root.querySelectorAll('[data-pick]').forEach(el=>el.onchange=()=>{
        const m=state.matches.find(x=>x.id===el.dataset.pick);
        if(!m)return;
        if(el.checked){
          if(m.selected.length>=11){el.checked=false;return;}
          m.selected.push(el.dataset.id);
          m.subs=(m.subs||[]).filter(x=>x!==el.dataset.id);
        }else m.selected=m.selected.filter(x=>x!==el.dataset.id);
        save();
      });

      root.querySelectorAll('[data-sub]').forEach(el=>el.onchange=()=>{
        const m=state.matches.find(x=>x.id===el.dataset.sub);
        if(!m)return;
        m.subs=m.subs||[];
        if(el.checked){
          if(!m.subs.includes(el.dataset.id))m.subs.push(el.dataset.id);
        }else m.subs=m.subs.filter(x=>x!==el.dataset.id);
        save();
      });

      root.querySelectorAll('[data-note]').forEach(el=>el.onchange=()=>{
        const m=state.matches.find(x=>x.id===el.dataset.note);
        if(m){m.note=el.value;save();}
      });

      root.querySelectorAll('[data-result]').forEach(el=>el.onclick=()=>record(el.dataset.match,el.dataset.result));
      root.querySelectorAll('[data-undo]').forEach(el=>el.onclick=()=>undo(el.dataset.undo));
    }

    function record(mid,result){
      const m=state.matches.find(x=>x.id===mid);
      if(!m||!validXI(m))return;
      const played=[...m.selected,...(m.subs||[])].map(pBy).filter(Boolean);
      if(result==='win'&&played.some(p=>remaining(p)<1))return;
      m.result=result;
      m.played=played.map(p=>({id:p.id,name:p.name}));
      if(result==='win')played.forEach(p=>p.used=(p.used||0)+1);
      state.history.push({matchId:m.id,name:m.name,result});
      save();
    }

    function undo(mid){
      const m=state.matches.find(x=>x.id===mid);
      if(!m||!m.result)return;
      if(m.result==='win')m.played.forEach(x=>{
        const p=pBy(x.id);
        if(p)p.used=Math.max(0,(p.used||0)-1);
      });
      state.history=state.history.filter(x=>x.matchId!==mid);
      m.result=null;
      m.played=[];
      save();
    }

    function build(){
      const players=parseRoster($('[data-roster]').value,Number($('[data-cap]').value));
      if(players.length<11){$('[data-error]').textContent=`Add at least 11 players (including a goalkeeper). We found ${players.length}.`;return;}
      if(!players.some(p=>p.role==='GK')){$('[data-error]').textContent='Mark your goalkeeper with “GK:” so the planner can reserve one appearance for them.';return;}
      if(state.history.length&&!confirm('Building a new rotation will clear the results already recorded in this plan. Continue?'))return;
      state.players=players;
      state.cap=Number($('[data-cap]').value);
      const result=autoBuild(Number($('[data-count]').value));
      if(result.error){$('[data-error]').textContent=result.error;return;}
      state.matches=result.matches;
      state.history=[];
      state.view='planner';
      $('[data-error]').textContent='';
      save();
    }

    $('[data-build]').onclick=build;
    $('[data-sample]').onclick=()=>{
      $('[data-roster]').value='GK: Alisson\nVirgil van Dijk | 5\nRúben Dias | 3\nWilliam Saliba\nTheo Hernández | 1\nAchraf Hakimi\nRodri\nJude Bellingham\nKevin De Bruyne\nKylian Mbappé\nErling Haaland\nGK: Courtois\nAntonio Rüdiger\nFederico Valverde\nBukayo Saka\nHarry Kane\nVinícius Júnior\nMartin Ødegaard\nDeclan Rice\nTrent Alexander-Arnold\nLautaro Martínez\nGK: Donnarumma\nNuno Mendes\nBernardo Silva\nPhil Foden\nRobert Lewandowski\nSon Heung-min\nRodrygo\nGK: Ederson';
    };
    $('[data-edit]').onclick=()=>{
      state.view='setup';
      $('[data-roster]').value=state.players.map(p=>`${p.role==='GK'?'GK: ':''}${p.name} | ${Math.max(0,p.limit-(p.used||0))}`).join('\n');
      $('[data-cap]').value=String(state.cap||3);
      save();
    };
    $('[data-rebalance]').onclick=()=>{
      const finished=state.matches.filter(m=>m.result);
      const pending=state.matches.filter(m=>!m.result);
      const result=autoBuild(pending.length);
      if(result.error){$('[data-notice]').textContent=result.error;$('[data-notice]').classList.add('show');return;}
      state.matches=[...finished,...result.matches];
      save();
    };
    $('[data-export]').onclick=()=>{
      const a=document.createElement('a');
      a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));
      a.download='gauntlet-plan.json';
      a.click();
      URL.revokeObjectURL(a.href);
    };
    $('[data-import]').onchange=async(e)=>{
      try{
        const x=JSON.parse(await e.target.files[0].text());
        if(!Array.isArray(x.players)||!Array.isArray(x.matches))throw Error();
        state=x;
        state.history=Array.isArray(x.history)?x.history:[];
        state.view='planner';
        save();
      }catch{
        $('[data-notice]').textContent='Could not read that backup file.';
        $('[data-notice]').classList.add('show');
      }
      e.target.value='';
    };
    $('[data-clear]').onclick=()=>{
      if(!confirm('Clear the saved squad, matches, and results from this browser?'))return;
      localStorage.removeItem(KEY);
      state={players:[],matches:[],history:[],cap:2,view:'setup'};
      $('[data-roster]').value='';
      render();
    };
    render();
  }
</script>
</main>
</BaseLayout>

