---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="FCMobiletools Account | Sign In or Create Account"
  description="Create or sign in to your FCMobiletools account for personal profile identity, XP progression, streaks, achievements and community features."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="auth-page">
    <div class="auth-ambient" aria-hidden="true">
      <i class="auth-orb auth-orb-a"></i>
      <i class="auth-orb auth-orb-b"></i>
    </div>

    <div class="auth-wrap">
      <div class="auth-topbar">
        <a class="auth-back" href="/">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back to FCMOBILETOOLS</span>
        </a>
        <div class="auth-quick-links">
          <a href="/leaderboard/">Community Leaderboard</a>
          <span aria-hidden="true">·</span>
          <a href="/events/">Live Events</a>
        </div>
      </div>

      <section class="auth-shell">
        <!-- Left showcase column -->
        <div class="auth-stage">
          <div class="stage-grid" aria-hidden="true"></div>
          <div class="stage-glow" aria-hidden="true"></div>

          <div class="stage-top">
            <span class="stage-kicker"><i class="pulse-dot"></i> FCMOBILETOOLS ACCOUNT</span>
            <h1>Your personal<br /><em>FC Mobile identity.</em></h1>
            <p class="stage-lede">
              Build your track record across calculators, events, tournaments and community contributions. Every public tool on FCMobiletools remains 100% open without an account.
            </p>
          </div>

          <!-- Live interactive preview card -->
          <div class="preview-card" aria-label="Example FCMobiletools profile card">
            <div class="preview-head">
              <div class="preview-avatar" id="previewAvatar">FC</div>
              <div class="preview-id">
                <div class="preview-title-row">
                  <strong id="previewDisplayName">Market Scout</strong>
                  <span class="preview-lvl">Level 12</span>
                </div>
                <span class="preview-handle" id="previewHandle">@fcmobile_pro</span>
              </div>
              <span class="preview-streak">🔥 8d Streak</span>
            </div>
            <div class="preview-xp">
              <div class="preview-xp-meta">
                <span>XP Progression</span>
                <strong>2,840 XP · 1,240 Tokens</strong>
              </div>
              <div class="preview-bar"><i></i></div>
            </div>
            <div class="preview-badges">
              <span>🏆 Tournament Debut</span>
              <span>📈 Market Watcher</span>
              <span>🔎 Verified Member</span>
            </div>
          </div>

          <div class="stage-pillars">
            <article>
              <b>01 · Identity &amp; Profile</b>
              <p>Custom @username, public/private visibility controls, titles and unlocked achievements.</p>
            </article>
            <article>
              <b>02 · Verified Progression</b>
              <p>Ledger-backed XP, streaks, configurable missions and tournament record integration.</p>
            </article>
            <article>
              <b>03 · Zero Forced Walls</b>
              <p>Calculators, redeem codes, events and guides never require registration to use.</p>
            </article>
          </div>
        </div>

        <!-- Right form panel -->
        <div class="auth-panel">
          <div class="panel-header">
            <div class="tab-switcher" role="tablist" aria-label="Account authentication mode">
              <span class="tab-pill-bg" id="tabPillBg" aria-hidden="true"></span>
              <button class="tab-btn active" id="loginTab" type="button" role="tab" aria-selected="true">
                Sign in
              </button>
              <button class="tab-btn" id="signupTab" type="button" role="tab" aria-selected="false">
                Create account
              </button>
            </div>
          </div>

          <!-- SIGN IN FORM -->
          <form id="loginForm" class="auth-form" novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">WELCOME BACK</span>
              <h2>Sign in to your account</h2>
              <p>Sign in with your existing email and password, or continue securely with Google.</p>
            </div>

            <button class="google-btn" type="button" id="googleLoginBtn">
              <span class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="#4285F4" d="M21.35 12.23c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.47 4.47 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
                  <path fill="#34A853" d="M12 21.78c2.64 0 4.86-.87 6.48-2.35l-3.14-2.45c-.87.58-1.98.92-3.34.92-2.56 0-4.73-1.73-5.51-4.05H3.25v2.53A9.79 9.79 0 0 0 12 21.78z"/>
                  <path fill="#FBBC05" d="M6.49 13.85A5.88 5.88 0 0 1 6.18 12c0-.64.11-1.26.31-1.85V7.62H3.25A9.78 9.78 0 0 0 2.22 12c0 1.58.38 3.08 1.03 4.38l3.24-2.53z"/>
                  <path fill="#EA4335" d="M12 6.09c1.43 0 2.72.49 3.74 1.46l2.8-2.8C16.85 3.17 14.64 2.22 12 2.22a9.79 9.79 0 0 0-8.75 5.4l3.24 2.53C7.27 7.82 9.44 6.09 12 6.09z"/>
                </svg>
              </span>
              <span>Continue with Google</span>
            </button>

            <div class="social-divider" aria-hidden="true"><span>or use email</span></div>
            </div>

            <div class="field">
              <label for="loginEmail">Email address</label>
              <div class="input-box">
                <input
                  id="loginEmail"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  placeholder="you@example.com"
                />
              </div>
            </div>

            <div class="field">
              <div class="field-label-row">
                <label for="loginPassword">Password</label>
                <button class="text-btn" type="button" id="resetBtn">Forgot password?</button>
              </div>
              <div class="input-box">
                <input
                  id="loginPassword"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  minlength="10"
                  placeholder="Enter your password"
                />
                <button class="pw-toggle" type="button" data-target="loginPassword" aria-label="Toggle password visibility">
                  Show
                </button>
              </div>
            </div>

            <button class="submit-btn" type="submit">
              <span>Sign in to Profile</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>

            <div class="form-message" id="loginMessage" role="alert" aria-live="polite" hidden></div>

            <div class="form-foot-note">
              <span>Don’t have an account yet?</span>
              <button type="button" class="text-btn" id="switchToSignup">Create a free account →</button>
            </div>
          </form>

          <!-- PASSWORD RECOVERY FORM -->
          <form id="recoveryForm" class="auth-form" hidden novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">ACCOUNT RECOVERY</span>
              <h2>Choose a new password</h2>
              <p>Your reset link is valid. Set a new password below, then sign in normally.</p>
            </div>

            <div class="field">
              <label for="recoveryPassword">New password <small>(min 10 characters)</small></label>
              <div class="input-box">
                <input id="recoveryPassword" type="password" autocomplete="new-password" minlength="10" required placeholder="At least 10 characters" />
                <button class="pw-toggle" type="button" data-target="recoveryPassword" aria-label="Toggle password visibility">Show</button>
              </div>
            </div>

            <div class="field">
              <label for="recoveryPasswordConfirm">Confirm new password</label>
              <div class="input-box">
                <input id="recoveryPasswordConfirm" type="password" autocomplete="new-password" minlength="10" required placeholder="Repeat your new password" />
                <button class="pw-toggle" type="button" data-target="recoveryPasswordConfirm" aria-label="Toggle password visibility">Show</button>
              </div>
            </div>

            <button class="submit-btn" type="submit">
              <span>Update Password</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>

            <div class="form-message" id="recoveryMessage" role="alert" aria-live="polite" hidden></div>

            <div class="form-foot-note">
              <span>Need to start over?</span>
              <button type="button" class="text-btn" id="recoveryToLogin">Back to sign in →</button>
            </div>
          </form>

          <!-- CREATE ACCOUNT FORM -->
          <form id="signupForm" class="auth-form" hidden novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">NEW ACCOUNT</span>
              <h2>Create your account</h2>
              <p>Email/password registration is temporarily paused while we move new account creation to Google sign-in.</p>
            </div>

            <div class="signup-pause">
              <div class="signup-pause-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M9 9l6 6M15 9l-6 6"></path>
                </svg>
              </div>
              <div>
                <strong>Email sign-up is temporarily unavailable</strong>
                <p>You can still sign in to an existing email/password account. For a new FCMobiletools account, use Google below.</p>
              </div>
            </div>

            <button class="google-btn" type="button" id="googleSignupBtn">
              <span class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="#4285F4" d="M21.35 12.23c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.47 4.47 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
                  <path fill="#34A853" d="M12 21.78c2.64 0 4.86-.87 6.48-2.35l-3.14-2.45c-.87.58-1.98.92-3.34.92-2.56 0-4.73-1.73-5.51-4.05H3.25v2.53A9.79 9.79 0 0 0 12 21.78z"/>
                  <path fill="#FBBC05" d="M6.49 13.85A5.88 5.88 0 0 1 6.18 12c0-.64.11-1.26.31-1.85V7.62H3.25A9.78 9.78 0 0 0 2.22 12c0 1.58.38 3.08 1.03 4.38l3.24-2.53z"/>
                  <path fill="#EA4335" d="M12 6.09c1.43 0 2.72.49 3.74 1.46l2.8-2.8C16.85 3.17 14.64 2.22 12 2.22a9.79 9.79 0 0 0-8.75 5.4l3.24 2.53C7.27 7.82 9.44 6.09 12 6.09z"/>
                </svg>
              </span>
              <span>Continue with Google</span>
            </button>

            <div class="form-message" id="signupMessage" role="alert" aria-live="polite" hidden></div>

            <div class="form-foot-note">
              <span>Already have an account?</span>
              <button type="button" class="text-btn" id="switchToLogin">Sign in instead →</button>
            </div>
          </form>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { accountAuth, getAuthRedirectUrl, validateSignupEmail } from '../../lib/account-client.js';

  const loginTab = document.getElementById('loginTab');
  const signupTab = document.getElementById('signupTab');
  const tabPillBg = document.getElementById('tabPillBg');
  const loginForm = document.getElementById('loginForm');
  const signupForm = document.getElementById('signupForm');
  const recoveryForm = document.getElementById('recoveryForm');
  const loginMessage = document.getElementById('loginMessage');
  const signupMessage = document.getElementById('signupMessage');
  const recoveryMessage = document.getElementById('recoveryMessage');

  const signupUsername = document.getElementById('signupUsername');
  const signupDisplayName = document.getElementById('signupDisplayName');
  const signupEmail = document.getElementById('signupEmail');
  const signupPassword = document.getElementById('signupPassword');
  const usernameHint = document.getElementById('usernameHint');
  const emailHint = document.getElementById('emailHint');
  const pwMeterBar = document.getElementById('pwMeterBar');
  const pwHint = document.getElementById('pwHint');

  const previewAvatar = document.getElementById('previewAvatar');
  const previewDisplayName = document.getElementById('previewDisplayName');
  const previewHandle = document.getElementById('previewHandle');

  function showTab(tab) {
    const isLogin = tab === 'login';
    loginTab.classList.toggle('active', isLogin);
    signupTab.classList.toggle('active', !isLogin);
    loginTab.setAttribute('aria-selected', isLogin ? 'true' : 'false');
    signupTab.setAttribute('aria-selected', !isLogin ? 'true' : 'false');
    if (tabPillBg) {
      tabPillBg.style.transform = isLogin ? 'translateX(0%)' : 'translateX(100%)';
    }
    loginForm.hidden = !isLogin;
    signupForm.hidden = isLogin;
    if (recoveryForm) recoveryForm.hidden = true;
    showMessage(loginMessage, '');
    showMessage(signupMessage, '');
    showMessage(recoveryMessage, '');
  }

  function showRecovery() {
    loginForm.hidden = true;
    signupForm.hidden = true;
    if (recoveryForm) recoveryForm.hidden = false;
    showMessage(loginMessage, '');
    showMessage(signupMessage, '');
    showMessage(recoveryMessage, '');
  }

  function showMessage(el, text, isError = false) {
    if (!el) return;
    if (!text) {
      el.hidden = true;
      el.textContent = '';
      el.className = 'form-message';
      return;
    }
    el.hidden = false;
    el.textContent = text;
    el.className = 'form-message ' + (isError ? 'is-error' : 'is-success');
  }

  function friendlyAuthError(error, fallback) {
    const raw = String(error?.message || error || '');
    if (/invalid api key|api key is invalid/i.test(raw)) {
      return 'The account service rejected its client key. This is a configuration issue, not an email or username error.';
    }
    if (/already registered|already exists|user already/i.test(raw)) {
      return 'That email is already registered. Switch to Sign in or reset your password.';
    }
    if (/duplicate|username.*taken|unique/i.test(raw)) {
      return 'That @username is already taken. Try a different username.';
    }
    if (/disposable|temporary|alias/i.test(raw)) {
      return raw;
    }
    if (/email.*invalid|invalid.*email/i.test(raw)) {
      return 'That email address does not look valid. Use a permanent email you control.';
    }
    if (/password/i.test(raw) && /weak|short|characters/i.test(raw)) {
      return 'Use a stronger password with at least 10 characters.';
    }
    if (/over_email_send_rate_limit|email rate limit exceeded/i.test(raw)) {
      return 'Email delivery is temporarily rate-limited after several account attempts. This is a service cooldown, not an email or username error. Wait for the cooldown to clear before trying again.';
    }
    if (/rate limit|too many requests/i.test(raw)) {
      return 'Too many account requests were made recently. Wait for the service cooldown to clear, then try again.';
    }
    if (/network|fetch/i.test(raw)) {
      return 'Could not reach the account service. Check your connection and try again.';
    }
    return fallback;
  }

  loginTab?.addEventListener('click', () => showTab('login'));
  signupTab?.addEventListener('click', () => showTab('signup'));
  document.getElementById('switchToSignup')?.addEventListener('click', () => showTab('signup'));
  document.getElementById('switchToLogin')?.addEventListener('click', () => showTab('login'));
  document.getElementById('recoveryToLogin')?.addEventListener('click', () => showTab('login'));

  async function continueWithGoogle(messageEl, button) {
    showMessage(messageEl, '');
    if (button) button.disabled = true;
    try {
      const result = await accountAuth.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: getAuthRedirectUrl()
        }
      });
      if (result.error) throw result.error;
    } catch (error) {
      showMessage(
        messageEl,
        friendlyAuthError(error, 'Google sign-in could not be started. Please try again.'),
        true
      );
      if (button) button.disabled = false;
    }
  }

  document.getElementById('googleLoginBtn')?.addEventListener('click', (event) => {
    continueWithGoogle(loginMessage, event.currentTarget);
  });
  document.getElementById('googleSignupBtn')?.addEventListener('click', (event) => {
    continueWithGoogle(signupMessage, event.currentTarget);
  });

  // Support ?mode=signup or #signup URL deep links
  const params = new URLSearchParams(location.search);
  if (params.get('mode') === 'signup' || location.hash === '#signup') {
    showTab('signup');
  }

  // Supabase verification links return Auth errors in the URL hash. Handle those
  // explicitly so an expired/used link does not leave the account screen looking broken.
  const authHash = new URLSearchParams(location.hash.replace(/^#/, ''));
  const authErrorCode = authHash.get('error_code');
  const authError = authHash.get('error');
  if (authErrorCode === 'otp_expired' || authError === 'access_denied') {
    showTab('signup');
    showMessage(
      signupMessage,
      authErrorCode === 'otp_expired'
        ? 'That verification link has expired or was already used. Start again with a fresh verification email.'
        : 'That verification link is no longer valid. Start again with a fresh verification email.',
      true
    );
    history.replaceState(null, document.title, location.pathname + location.search);
  }

  // Live preview card updates as user types username / display name
  function updateLivePreview() {
    const rawUser = String(signupUsername?.value || '').trim().toLowerCase();
    const rawDisplay = String(signupDisplayName?.value || '').trim();
    const handle = rawUser || 'fcmobile_pro';
    const display = rawDisplay || (rawUser ? rawUser : 'Market Scout');
    if (previewHandle) previewHandle.textContent = '@' + handle;
    if (previewDisplayName) previewDisplayName.textContent = display;
    if (previewAvatar) previewAvatar.textContent = display.slice(0, 2).toUpperCase();

    if (signupUsername && usernameHint) {
      if (!rawUser) {
        usernameHint.textContent = 'Lowercase letters, numbers, dots, underscores or hyphens.';
        usernameHint.className = 'field-hint';
      } else if (/^[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]$/.test(rawUser)) {
        usernameHint.textContent = `@${rawUser} looks valid.`;
        usernameHint.className = 'field-hint is-ok';
      } else {
        usernameHint.textContent = 'Use 3–24 lowercase letters, numbers, dots, underscores or hyphens (must start/end with letter or number).';
        usernameHint.className = 'field-hint is-warn';
      }
    }
  }
  signupUsername?.addEventListener('input', updateLivePreview);
  signupDisplayName?.addEventListener('input', updateLivePreview);

  // Live email validation feedback
  signupEmail?.addEventListener('input', () => {
    const val = signupEmail.value.trim();
    if (!val) {
      emailHint.textContent = 'No Gmail “+” aliases or temporary/disposable email domains.';
      emailHint.className = 'field-hint';
      signupEmail.removeAttribute('aria-invalid');
      return;
    }
    const check = validateSignupEmail(val);
    if (!check.valid) {
      emailHint.textContent = check.message;
      emailHint.className = 'field-hint is-warn';
      signupEmail.setAttribute('aria-invalid', 'true');
    } else {
      emailHint.textContent = 'Permanent email format looks good.';
      emailHint.className = 'field-hint is-ok';
      signupEmail.removeAttribute('aria-invalid');
    }
  });

  // Live password meter
  signupPassword?.addEventListener('input', () => {
    const pw = signupPassword.value || '';
    let score = 0;
    if (pw.length >= 10) score += 50;
    else score += Math.round((pw.length / 10) * 35);
    if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score += 20;
    if (/\d/.test(pw)) score += 15;
    if (/[^A-Za-z0-9]/.test(pw)) score += 15;
    score = Math.min(100, score);
    if (pwMeterBar) {
      pwMeterBar.style.width = score + '%';
      pwMeterBar.dataset.strength = pw.length < 10 ? 'weak' : score >= 80 ? 'strong' : 'good';
    }
    if (pwHint) {
      if (!pw) {
        pwHint.textContent = 'Use at least 10 characters with a mix of letters and numbers.';
        pwHint.className = 'field-hint';
      } else if (pw.length < 10) {
        pwHint.textContent = `${10 - pw.length} more character${10 - pw.length === 1 ? '' : 's'} needed (minimum 10).`;
        pwHint.className = 'field-hint is-warn';
      } else {
        pwHint.textContent = score >= 80 ? 'Strong password.' : 'Password meets length requirements.';
        pwHint.className = 'field-hint is-ok';
      }
    }
  });

  // Password visibility toggles
  document.querySelectorAll('.pw-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const input = document.getElementById(toggle.dataset.target);
      if (!input) return;
      const isVisible = input.type === 'text';
      input.type = isVisible ? 'password' : 'text';
      toggle.textContent = isVisible ? 'Show' : 'Hide';
    });
  });

  // Sign in submission
  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(loginMessage, '');
    if (!loginForm.checkValidity()) {
      loginForm.reportValidity();
      return;
    }
    const fd = new FormData(loginForm);
    const button = loginForm.querySelector('.submit-btn');
    button.disabled = true;
    try {
      const result = await accountAuth.auth.signInWithPassword({
        email: String(fd.get('email') || '').trim().toLowerCase(),
        password: String(fd.get('password') || '')
      });
      if (result.error) throw result.error;
      location.replace('/profile/');
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Email or password is incorrect.'), true);
    } finally {
      button.disabled = false;
    }
  });

  // New email/password registrations are intentionally disabled for now.
  // Resend signup verification email. Supabase keeps the response intentionally
  // non-enumerating, so a user can safely request a fresh message for an existing email.
  document.getElementById('resendVerificationBtn')?.addEventListener('click', async (event) => {
    const btn = event.currentTarget;
    const email = String(signupEmail?.value || '').trim().toLowerCase();
    if (!validateSignupEmail(email).valid) {
      showMessage(signupMessage, 'Enter the same permanent email address you used for this account.', true);
      signupEmail?.focus();
      return;
    }
    btn.disabled = true;
    try {
      const result = await accountAuth.auth.resend({
        type: 'signup',
        email,
        options: { emailRedirectTo: getAuthRedirectUrl() }
      });
      if (result.error) throw result.error;
      showMessage(signupMessage, 'A fresh verification email has been requested. Check your inbox and spam folder.', false);
    } catch (error) {
      showMessage(signupMessage, friendlyAuthError(error, 'Unable to resend the verification email right now. Please try again shortly.'), true);
    } finally {
      btn.disabled = false;
    }
  });

  // Password reset
  document.getElementById('resetBtn')?.addEventListener('click', async (event) => {
    showMessage(loginMessage, '');
    const emailInput = document.getElementById('loginEmail');
    const email = String(emailInput?.value || '').trim().toLowerCase();
    if (!email) {
      showMessage(loginMessage, 'Enter your email address above first, then click “Forgot password?”.', true);
      emailInput?.focus();
      return;
    }
    const btn = event.currentTarget;
    btn.disabled = true;
    try {
      const result = await accountAuth.auth.resetPasswordForEmail(email, {
        redirectTo: getAuthRedirectUrl()
      });
      if (result.error) throw result.error;
      showMessage(loginMessage, 'Password reset instructions have been sent. Check your inbox and spam folder.', false);
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Unable to send reset instructions right now.'), true);
    } finally {
      btn.disabled = false;
    }
  });

  // Supabase fires PASSWORD_RECOVERY after a valid recovery link creates a session.
  let recoveryActive = /(?:^|[&#])type=recovery(?:&|$)/i.test(location.hash);
  accountAuth.auth.onAuthStateChange((event) => {
    if (event === 'PASSWORD_RECOVERY') {
      recoveryActive = true;
      showRecovery();
    }
  });

  recoveryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(recoveryMessage, '');
    const password = String(document.getElementById('recoveryPassword')?.value || '');
    const confirm = String(document.getElementById('recoveryPasswordConfirm')?.value || '');
    if (password.length < 10) {
      showMessage(recoveryMessage, 'Use a password with at least 10 characters.', true);
      return;
    }
    if (password !== confirm) {
      showMessage(recoveryMessage, 'The two passwords do not match.', true);
      return;
    }
    const button = recoveryForm.querySelector('.submit-btn');
    button.disabled = true;
    try {
      const result = await accountAuth.auth.updateUser({ password });
      if (result.error) throw result.error;
      await accountAuth.auth.signOut();
      showMessage(recoveryMessage, 'Password updated successfully. You can now sign in with your new password.', false);
      recoveryForm.reset();
      recoveryActive = false;
      history.replaceState(null, document.title, location.pathname + location.search);
      setTimeout(() => showTab('login'), 900);
    } catch (error) {
      showMessage(recoveryMessage, friendlyAuthError(error, 'Unable to update your password. Request a fresh reset link and try again.'), true);
    } finally {
      button.disabled = false;
    }
  });

  accountAuth.auth.getSession().then((result) => {
    if (result.data?.session && recoveryActive) {
      showRecovery();
      return;
    }
    if (result.data?.session && !location.hash.includes('error=') && !location.search.includes('mode=recovery')) location.replace('/profile/');
  });
</script>

