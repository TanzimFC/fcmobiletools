---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/premium-auth.css';
---
<BaseLayout
  title="FCMobiletools Account | Sign In or Create Account"
  description="Create or sign in to your FCMobiletools account for personal profile identity, XP progression, streaks, achievements and community features."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="auth-page">
    <div class="auth-ambient" aria-hidden="true">
      <i class="auth-orb auth-orb-a"></i>
      <i class="auth-orb auth-orb-b"></i>
    </div>

    <div class="auth-wrap">
      <div class="auth-topbar">
        <a class="auth-back" href="/">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Back to FCMOBILETOOLS</span>
        </a>
        <div class="auth-quick-links">
          <a href="/leaderboard/">Community Leaderboard</a>
          <span aria-hidden="true">·</span>
          <a href="/events/">Live Events</a>
        </div>
      </div>

      <section class="auth-shell">
        <!-- Left showcase column -->
        <div class="auth-stage">
          <div class="stage-grid" aria-hidden="true"></div>
          <div class="stage-glow" aria-hidden="true"></div>

          <div class="stage-top">
            <span class="stage-kicker"><i class="pulse-dot"></i> FCMOBILETOOLS ACCOUNT</span>
            <h1>Your personal<br /><em>FC Mobile identity.</em></h1>
            <p class="stage-lede">
              Build your FC Mobile profile, keep a streak, finish daily Quests and earn Tokens. The main FCMobiletools tools stay open without an account.
            </p>
          </div>

          <!-- Live interactive preview card -->
          <div class="preview-card" aria-label="Example FCMobiletools profile card">
            <div class="preview-head">
              <div class="preview-avatar" id="previewAvatar">FC</div>
              <div class="preview-id">
                <div class="preview-title-row">
                  <strong id="previewDisplayName">Market Scout</strong>
                  <span class="preview-lvl">Level 12</span>
                </div>
                <span class="preview-handle" id="previewHandle">@fcmobile_pro</span>
              </div>
              <span class="preview-streak">🔥 8d Streak</span>
            </div>
            <div class="preview-xp">
              <div class="preview-xp-meta">
                <span>XP Progression</span>
                <strong>2,840 XP · 1,240 Tokens</strong>
              </div>
              <div class="preview-bar"><i></i></div>
            </div>
            <div class="preview-badges">
              <span>🔥 8-day streak</span>
              <span>📈 Market Watcher</span>
              <span>⚡ Quest Runner</span>
            </div>
          </div>

          <div class="stage-pillars">
            <article>
              <b>01 · Identity &amp; Profile</b>
              <p>Custom @username, public/private visibility controls, titles and unlocked achievements.</p>
            </article>
            <article>
              <b>02 · Verified Progression</b>
              <p>XP, streaks, daily Quests and reward history that stay tied to your account.</p>
            </article>
            <article>
              <b>03 · Zero Forced Walls</b>
              <p>Calculators, redeem codes, events and guides never require registration to use.</p>
            </article>
          </div>
        </div>

        <!-- Right form panel -->
        <div class="auth-panel">
          <div class="panel-header">
            <div class="tab-switcher" role="tablist" aria-label="Account authentication mode">
              <span class="tab-pill-bg" id="tabPillBg" aria-hidden="true"></span>
              <button class="tab-btn active" id="loginTab" type="button" role="tab" aria-selected="true">
                Sign in
              </button>
              <button class="tab-btn" id="signupTab" type="button" role="tab" aria-selected="false">
                Create account
              </button>
            </div>
          </div>

          <!-- SIGN IN FORM -->
          <form id="loginForm" class="auth-form" novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">WELCOME BACK</span>
              <h2>Sign in to your account</h2>
              <p>Existing FCMobiletools accounts can still sign in with email and password. Google sign-in is available too.</p>
            </div>

            <button class="google-btn" type="button" id="googleLoginBtn">
              <span class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="#4285F4" d="M21.35 12.23c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.47 4.47 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
                  <path fill="#34A853" d="M12 21.78c2.64 0 4.86-.87 6.48-2.35l-3.14-2.45c-.87.58-1.98.92-3.34.92-2.56 0-4.73-1.73-5.51-4.05H3.25v2.53A9.79 9.79 0 0 0 12 21.78z"/>
                  <path fill="#FBBC05" d="M6.49 13.85A5.88 5.88 0 0 1 6.18 12c0-.64.11-1.26.31-1.85V7.62H3.25A9.78 9.78 0 0 0 2.22 12c0 1.58.38 3.08 1.03 4.38l3.24-2.53z"/>
                  <path fill="#EA4335" d="M12 6.09c1.43 0 2.72.49 3.74 1.46l2.8-2.8C16.85 3.17 14.64 2.22 12 2.22a9.79 9.79 0 0 0-8.75 5.4l3.24 2.53C7.27 7.82 9.44 6.09 12 6.09z"/>
                </svg>
              </span>
              <span>Continue with Google</span>
            </button>

            <div class="social-divider" aria-hidden="true"><span>or use email</span></div>

            <div class="field">
              <label for="loginEmail">Email address</label>
              <div class="input-box">
                <input
                  id="loginEmail"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  placeholder="you@example.com"
                />
              </div>
            </div>

            <div class="field">
              <label for="loginPassword">Password</label>
              <div class="input-box">
                <input
                  id="loginPassword"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  placeholder="Enter your password"
                />
                <button class="pw-toggle" type="button" data-target="loginPassword" aria-label="Toggle password visibility">
                  Show
                </button>
              </div>
            </div>

            <button class="submit-btn" type="submit">
              <span>Sign in</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>

            <div class="form-message" id="loginMessage" role="alert" aria-live="polite" hidden></div>

            <div class="forgot-note">
              <strong>Forgot your password?</strong>
              <span>Password recovery is currently locked. Please contact us on <a href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener noreferrer">Discord</a> for help.</span>
            </div>

            <div class="form-foot-note">
              <span>Don’t have an account yet?</span>
              <button type="button" class="text-btn" id="switchToSignup">Create a free account →</button>
            </div>
          </form>

          <!-- GOOGLE ACCOUNT START -->
          <form id="signupForm" class="auth-form" hidden novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">NEW ACCOUNT</span>
              <h2>Create your account</h2>
              <p>New registrations start with Google. Then set up your player card and add a password for future email sign-in.</p>
            </div>

            <div class="signup-pause">
              <div class="signup-pause-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M9 9l6 6M15 9l-6 6"></path>
                </svg>
              </div>
              <div>
                <strong>Email sign-up is temporarily unavailable</strong>
                <p>Existing email/password accounts still work. New accounts are created through Google.</p>
              </div>
            </div>

            <button class="google-btn" type="button" id="googleSignupBtn">
              <span class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="#4285F4" d="M21.35 12.23c0-.79-.07-1.54-.22-2.27H12v4.3h5.24a4.47 4.47 0 0 1-1.94 2.94v2.45h3.14c1.84-1.69 2.91-4.18 2.91-7.42z"/>
                  <path fill="#34A853" d="M12 21.78c2.64 0 4.86-.87 6.48-2.35l-3.14-2.45c-.87.58-1.98.92-3.34.92-2.56 0-4.73-1.73-5.51-4.05H3.25v2.53A9.79 9.79 0 0 0 12 21.78z"/>
                  <path fill="#FBBC05" d="M6.49 13.85A5.88 5.88 0 0 1 6.18 12c0-.64.11-1.26.31-1.85V7.62H3.25A9.78 9.78 0 0 0 2.22 12c0 1.58.38 3.08 1.03 4.38l3.24-2.53z"/>
                  <path fill="#EA4335" d="M12 6.09c1.43 0 2.72.49 3.74 1.46l2.8-2.8C16.85 3.17 14.64 2.22 12 2.22a9.79 9.79 0 0 0-8.75 5.4l3.24 2.53C7.27 7.82 9.44 6.09 12 6.09z"/>
                </svg>
              </span>
              <span>Continue with Google</span>
            </button>

            <div class="form-message" id="signupMessage" role="alert" aria-live="polite" hidden></div>

            <div class="form-foot-note">
              <span>Already have an account?</span>
              <button type="button" class="text-btn" id="switchToLogin">Sign in instead →</button>
            </div>
          </form>

          <!-- GOOGLE ACCOUNT ONBOARDING -->
          <form id="onboardingForm" class="auth-form" hidden novalidate>
            <div class="form-intro">
              <span class="form-eyebrow">ONE LAST STEP</span>
              <h2>Build your FC Mobile profile</h2>
              <p>Your Google email is already verified. Add the in-game details used for your FCMobiletools identity and progression.</p>
            </div>

            <div class="verified-email-box">
              <span class="verified-badge">✓ VERIFIED</span>
              <div><small>GOOGLE EMAIL</small><strong id="onboardingEmail">Verified email</strong></div>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="onboardingUsername">Username <small>(3–24 chars)</small></label>
                <div class="input-box has-prefix"><span class="input-prefix" aria-hidden="true">@</span><input id="onboardingUsername" name="username" type="text" autocomplete="username" required minlength="3" maxlength="24" pattern="[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]" placeholder="yourname" /></div>
                <small class="field-hint" id="onboardingUsernameHint">Lowercase letters, numbers, dots, underscores or hyphens.</small>
              </div>
              <div class="field">
                <label for="onboardingDisplayName">Display name <small>(optional)</small></label>
                <div class="input-box"><input id="onboardingDisplayName" name="display_name" type="text" autocomplete="nickname" maxlength="80" placeholder="Your display name" /></div>
              </div>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="onboardingUid">FC Mobile UID</label>
                <div class="input-box"><input id="onboardingUid" required maxlength="32" placeholder="Your FC Mobile UID" /></div>
              </div>
              <div class="field">
                <label for="onboardingInGame">In-game username</label>
                <div class="input-box"><input id="onboardingInGame" required maxlength="40" placeholder="Your in-game name" /></div>
              </div>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="onboardingRegion">Region / Server</label>
                <div class="input-box"><input id="onboardingRegion" required maxlength="40" placeholder="e.g. Asia, Europe, NA" /></div>
              </div>
              <div class="field">
                <label for="onboardingDiscord">Discord Handle <small>(optional)</small></label>
                <div class="input-box"><input id="onboardingDiscord" maxlength="64" placeholder="Your Discord handle" /></div>
              </div>
            </div>

            <div class="field">
              <label>Your FC Mobile style <small>(optional)</small></label>
              <div class="onboard-tags" id="onboardingTags">
                
                  <label><input type="checkbox" value="Competitive H2H" /><span>Competitive H2H</span></label>
                
                  <label><input type="checkbox" value="VSA Grinder" /><span>VSA Grinder</span></label>
                
                  <label><input type="checkbox" value="Investor" /><span>Investor</span></label>
                
                  <label><input type="checkbox" value="Theme Team Builder" /><span>Theme Team Builder</span></label>
                
                  <label><input type="checkbox" value="Casual" /><span>Casual</span></label>
                
              </div>
            </div>

            <div class="field">
              <label for="onboardingPassword">Password <small>(min 10 characters)</small></label>
              <div class="input-box"><input id="onboardingPassword" name="password" type="password" autocomplete="new-password" required minlength="10" placeholder="Create a password" /><button class="pw-toggle" type="button" data-target="onboardingPassword">Show</button></div>
            </div>

            <div class="field">
              <label for="onboardingPasswordConfirm">Confirm password</label>
              <div class="input-box"><input id="onboardingPasswordConfirm" name="password_confirm" type="password" autocomplete="new-password" required minlength="10" placeholder="Enter the password again" /><button class="pw-toggle" type="button" data-target="onboardingPasswordConfirm">Show</button></div>
            </div>

            <div class="advisory-box">
              <div class="advisory-icon" aria-hidden="true">✓</div>
              <div><strong>Almost there.</strong><p>UID, in-game username and Region / Server are required to finish your profile. Discord and player style tags can be added later.</p></div>
            </div>

            <button class="submit-btn" type="submit">
              <span>Create FCMobiletools Account</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>

            <div class="form-message" id="onboardingMessage" role="alert" aria-live="polite" hidden></div>
          </form>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { accountAuth, accountApi } from '../../lib/account-client.js';

  const loginTab = document.getElementById('loginTab');
  const signupTab = document.getElementById('signupTab');
  const tabPillBg = document.getElementById('tabPillBg');
  const loginForm = document.getElementById('loginForm');
  const signupForm = document.getElementById('signupForm');
  const onboardingForm = document.getElementById('onboardingForm');
  const loginMessage = document.getElementById('loginMessage');
  const signupMessage = document.getElementById('signupMessage');
  const onboardingMessage = document.getElementById('onboardingMessage');

  const onboardingUsername = document.getElementById('onboardingUsername');
  const onboardingDisplayName = document.getElementById('onboardingDisplayName');
  const onboardingEmail = document.getElementById('onboardingEmail');
  const onboardingUsernameHint = document.getElementById('onboardingUsernameHint');
  const onboardingUid = document.getElementById('onboardingUid');
  const onboardingInGame = document.getElementById('onboardingInGame');
  const onboardingRegion = document.getElementById('onboardingRegion');
  const onboardingDiscord = document.getElementById('onboardingDiscord');
  const onboardingTags = document.getElementById('onboardingTags');

  function showTab(tab) {
    const isLogin = tab === 'login';
    loginTab?.classList.toggle('active', isLogin);
    signupTab?.classList.toggle('active', !isLogin);
    loginTab?.setAttribute('aria-selected', isLogin ? 'true' : 'false');
    signupTab?.setAttribute('aria-selected', !isLogin ? 'true' : 'false');
    if (tabPillBg) tabPillBg.style.transform = isLogin ? 'translateX(0%)' : 'translateX(100%)';
    if (loginForm) loginForm.hidden = !isLogin;
    if (signupForm) signupForm.hidden = isLogin;
    if (onboardingForm) onboardingForm.hidden = true;
    document.querySelector('.auth-shell')?.classList.remove('is-onboarding');
    showMessage(loginMessage, '');
    showMessage(signupMessage, '');
    showMessage(onboardingMessage, '');
  }

  function showOnboarding(account, user) {
    if (loginForm) loginForm.hidden = true;
    document.querySelector('.auth-shell')?.classList.add('is-onboarding');
    if (signupForm) signupForm.hidden = true;
    if (onboardingForm) onboardingForm.hidden = false;
    loginTab?.classList.remove('active');
    signupTab?.classList.add('active');
    loginTab?.setAttribute('aria-selected', 'false');
    signupTab?.setAttribute('aria-selected', 'true');
    if (tabPillBg) tabPillBg.style.transform = 'translateX(100%)';
    showMessage(loginMessage, '');
    showMessage(signupMessage, '');
    showMessage(onboardingMessage, '');

    const meta = user?.user_metadata || {};
    const suggestedName = String(meta.full_name || meta.name || '').trim();
    const suggestedUsername = String(account?.username || '').trim().toLowerCase();
    if (onboardingEmail) onboardingEmail.textContent = user?.email || 'Verified Google email';
    if (onboardingUsername && suggestedUsername) onboardingUsername.value = suggestedUsername;
    if (onboardingDisplayName && suggestedName) onboardingDisplayName.value = suggestedName;
    const gp = account?.gameProfile || {};
    if (onboardingUid) onboardingUid.value = gp.fcMobileUid || '';
    if (onboardingInGame) onboardingInGame.value = gp.inGameUsername || '';
    if (onboardingRegion) onboardingRegion.value = gp.regionServer || '';
    if (onboardingDiscord) onboardingDiscord.value = gp.discordHandle || '';
    if (onboardingTags && Array.isArray(gp.playerTags)) {
      onboardingTags.querySelectorAll('input').forEach(input => { input.checked = gp.playerTags.includes(input.value); });
    }
    onboardingUsername?.dispatchEvent(new Event('input'));
  }

  function showMessage(el, text, isError = false) {
    if (!el) return;
    if (!text) {
      el.hidden = true;
      el.textContent = '';
      el.className = 'form-message';
      return;
    }
    el.hidden = false;
    el.textContent = text;
    el.className = 'form-message ' + (isError ? 'is-error' : 'is-success');
  }

  function friendlyAuthError(error, fallback) {
    const raw = String(error?.message || error || '');
    if (/invalid login credentials|invalid_credentials|email or password/i.test(raw)) {
      return 'Email or password is incorrect. Check both and try again.';
    }
    if (/email not confirmed|email_not_confirmed/i.test(raw)) {
      return 'Please verify your email address before signing in. Check your inbox for the verification email.';
    }
    if (/too many requests|rate limit|over_request_rate_limit/i.test(raw)) {
      return 'Too many sign-in attempts. Wait a moment and try again.';
    }
    if (/invalid api key|api key is invalid/i.test(raw)) {
      return 'The account service rejected its client key. This is a configuration issue, not an email or username error.';
    }
    if (/already registered|already exists|user already/i.test(raw)) {
      return 'That email is already registered. Switch to Sign in.';
    }
    if (/duplicate|username.*taken|unique/i.test(raw)) {
      return 'That @username is already taken. Try a different username.';
    }
    if (/reserved|not allowed|inappropriate/i.test(raw)) {
      return 'That username or display name is reserved or not allowed. Choose a different name.';
    }
    if (/password/i.test(raw) && /weak|short|characters/i.test(raw)) {
      return 'Use a stronger password with at least 10 characters.';
    }
    if (/network|fetch/i.test(raw)) {
      return 'Could not reach the account service. Check your connection and try again.';
    }
    if (/provider.*not.*enabled|google.*not.*enabled/i.test(raw)) {
      return 'Google sign-in is not enabled yet. Please try again after the account service is configured.';
    }
    return fallback;
  }

  function validateUsername(value) {
    return /^[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]$/.test(String(value || '').trim().toLowerCase());
  }

  loginTab?.addEventListener('click', () => showTab('login'));
  signupTab?.addEventListener('click', () => showTab('signup'));
  document.getElementById('switchToSignup')?.addEventListener('click', () => showTab('signup'));
  document.getElementById('switchToLogin')?.addEventListener('click', () => showTab('login'));

  async function continueWithGoogle(messageEl, button, authMode = 'login') {
    showMessage(messageEl, '');
    if (button) button.disabled = true;
    try {
      const callback = new URL('https://fcmobiletools.online/account/');
      callback.searchParams.set('next', nextPath);
      if (authMode === 'signup') callback.searchParams.set('mode', 'signup');
      const result = await accountAuth.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: callback.toString() }
      });
      if (result.error) throw result.error;
    } catch (error) {
      showMessage(messageEl, friendlyAuthError(error, 'Google sign-in could not be started. Please try again.'), true);
      if (button) button.disabled = false;
    }
  }

  document.getElementById('googleLoginBtn')?.addEventListener('click', (event) => {
    continueWithGoogle(loginMessage, event.currentTarget, 'login');
  });
  document.getElementById('googleSignupBtn')?.addEventListener('click', (event) => {
    continueWithGoogle(signupMessage, event.currentTarget, 'signup');
  });

  // Email/password sign-in: this form previously had no submit handler.
  // Existing passwords are accepted as-is; the 10-character minimum applies
  // when setting a new password, not when signing in to an older account.
  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(loginMessage, '');

    const emailInput = document.getElementById('loginEmail');
    const passwordInput = document.getElementById('loginPassword');
    const email = String(emailInput?.value || '').trim().toLowerCase();
    const password = String(passwordInput?.value || '');

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMessage(loginMessage, 'Enter a valid email address.', true);
      emailInput?.focus();
      return;
    }
    if (!password) {
      showMessage(loginMessage, 'Enter your password.', true);
      passwordInput?.focus();
      return;
    }

    const button = loginForm.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const result = await accountAuth.auth.signInWithPassword({ email, password });
      if (result.error) throw result.error;

      const activeSession = result.data?.session;
      if (!activeSession) {
        const refreshed = await accountAuth.auth.getSession();
        if (!refreshed.data?.session) {
          throw new Error('Sign-in did not create an active session. Please try again.');
        }
      }

      // nextPath is restricted to a local same-origin path. If no explicit
      // target was supplied, it falls back to the page that opened Account.
      location.replace(nextPath);
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Sign-in failed. Check your details and try again.'), true);
    } finally {
      if (button) button.disabled = false;
    }
  });

  onboardingUsername?.addEventListener('input', () => {
    const value = String(onboardingUsername.value || '').trim().toLowerCase();
    onboardingUsername.value = value;
    if (!value) {
      onboardingUsernameHint.textContent = 'Lowercase letters, numbers, dots, underscores or hyphens.';
      onboardingUsernameHint.className = 'field-hint';
    } else if (validateUsername(value)) {
      onboardingUsernameHint.textContent = '@' + value + ' looks valid.';
      onboardingUsernameHint.className = 'field-hint is-ok';
    } else {
      onboardingUsernameHint.textContent = 'Use 3–24 lowercase letters, numbers, dots, underscores or hyphens and start/end with a letter or number.';
      onboardingUsernameHint.className = 'field-hint is-warn';
    }
  });

  onboardingForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(onboardingMessage, '');

    const username = String(onboardingUsername?.value || '').trim().toLowerCase();
    const displayName = String(onboardingDisplayName?.value || '').trim();
    const password = String(document.getElementById('onboardingPassword')?.value || '');
    const confirm = String(document.getElementById('onboardingPasswordConfirm')?.value || '');

    if (!validateUsername(username)) {
      showMessage(onboardingMessage, 'Username must be 3–24 characters using lowercase letters, numbers, dots, underscores or hyphens.', true);
      onboardingUsername?.focus();
      return;
    }
    if (displayName.length > 80) {
      showMessage(onboardingMessage, 'Display name must be 80 characters or fewer.', true);
      onboardingDisplayName?.focus();
      return;
    }
    if (password.length < 10) {
      showMessage(onboardingMessage, 'Use a password with at least 10 characters.', true);
      document.getElementById('onboardingPassword')?.focus();
      return;
    }
    if (password !== confirm) {
      showMessage(onboardingMessage, 'The two passwords do not match.', true);
      document.getElementById('onboardingPasswordConfirm')?.focus();
      return;
    }

    const fcUid = String(onboardingUid?.value || '').trim();
    const inGame = String(onboardingInGame?.value || '').trim();
    const region = String(onboardingRegion?.value || '').trim();
    const discord = String(onboardingDiscord?.value || '').trim();
    const playerTags = [...(onboardingTags?.querySelectorAll('input:checked') || [])].map(input => input.value);

    if (fcUid.length < 3 || fcUid.length > 32) {
      showMessage(onboardingMessage, 'Enter your FC Mobile UID.', true);
      onboardingUid?.focus();
      return;
    }
    if (!inGame || inGame.length > 40) {
      showMessage(onboardingMessage, 'Enter your in-game username.', true);
      onboardingInGame?.focus();
      return;
    }
    if (!region || region.length > 40) {
      showMessage(onboardingMessage, 'Enter your Region / Server.', true);
      onboardingRegion?.focus();
      return;
    }

    const button = onboardingForm.querySelector('.submit-btn');
    button.disabled = true;

    try {
      const userResult = await accountAuth.auth.updateUser({ password });
      if (userResult.error) throw userResult.error;

      const profileResult = await accountApi('/api/account/profile', {
        method: 'PUT',
        body: JSON.stringify({
          username,
          displayName,
          avatarUrl: '',
          completeOnboarding: false
        })
      });
      const profileBody = await profileResult.json().catch(() => ({}));
      if (!profileResult.ok) throw new Error(profileBody.error || 'Could not save your profile.');

      const gameResult = await accountApi('/api/account/game-profile', {
        method: 'PUT',
        body: JSON.stringify({
          fcMobileUid: fcUid,
          inGameUsername: inGame,
          regionServer: region,
          discordHandle: discord,
          playerTags
        })
      });
      const gameBody = await gameResult.json().catch(() => ({}));
      if (!gameResult.ok) throw new Error(gameBody.error || 'Could not save your FC Mobile profile.');

      onboardingForm.reset();
      location.replace(nextPath);
    } catch (error) {
      showMessage(onboardingMessage, friendlyAuthError(error, 'Could not finish your account setup. Please try again.'), true);
    } finally {
      button.disabled = false;
    }
  });

  const params = new URLSearchParams(location.search);

  function safeLocalReturnPath(value) {
    const raw = String(value || '').trim();
    if (!raw) return '';
    try {
      const target = new URL(raw, location.origin);
      if (target.origin !== location.origin) return '';
      if (!target.pathname.startsWith('/') || target.pathname.startsWith('//') || target.pathname.includes('\\')) return '';
      // Never redirect back into the auth page, which would create a loop.
      if (target.pathname === '/account' || target.pathname.startsWith('/account/')) return '';
      return target.pathname + target.search + target.hash;
    } catch {
      return '';
    }
  }

  const requestedNextPath = safeLocalReturnPath(params.get('next'));
  let storedNextPath = '';
  try {
    const stored = JSON.parse(sessionStorage.getItem('fcmt:account:return:v1') || 'null');
    sessionStorage.removeItem('fcmt:account:return:v1');
    if (stored && Number.isFinite(Number(stored.savedAt)) && Date.now() - Number(stored.savedAt) < 15 * 60 * 1000) {
      storedNextPath = safeLocalReturnPath(stored.path);
    }
  } catch {}
  let referrerNextPath = '';
  try {
    if (document.referrer) {
      const referrer = new URL(document.referrer);
      if (referrer.origin === location.origin) {
        referrerNextPath = safeLocalReturnPath(referrer.pathname + referrer.search + referrer.hash);
      }
    }
  } catch {}
  const nextPath = requestedNextPath || storedNextPath || referrerNextPath || '/profile/';

  if (params.get('mode') === 'signup' || location.hash === '#signup') showTab('signup');

  accountAuth.auth.getSession().then(async (result) => {
    const session = result.data?.session;
    if (!session) return;

    try {
      const [accountResult, userResult] = await Promise.all([
        accountApi('/api/account/me'),
        accountAuth.auth.getUser()
      ]);
      const body = await accountResult.json().catch(() => ({}));
      const user = userResult.data?.user || session.user;

      if (!accountResult.ok || !body?.account) {
        // A successful sign-in should not strand someone on the account page when
        // account details fail to load. Explicit return targets can still continue;
        // signup onboarding remains here so new users can finish setting up.
        if ((requestedNextPath || storedNextPath) && params.get('mode') !== 'signup') {
          location.replace(nextPath);
          return;
        }
        showMessage(loginMessage, body?.error || 'Could not load your account. Please try again.', true);
        return;
      }

      // Google account creation returns through this same route. Keep its intent
      // in the callback URL and show onboarding only for signup flows whose
      // required FC Mobile profile fields are not complete yet.
      const account = {
        ...body.account,
        gameProfile: body.gameProfile || body.account.gameProfile || {}
      };
      if (params.get('mode') === 'signup' && !account.gameProfile.complete) {
        showOnboarding(account, user);
        return;
      }

      location.replace(nextPath);
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Could not load your account. Please refresh and try again.'), true);
    }
  });
</script>

