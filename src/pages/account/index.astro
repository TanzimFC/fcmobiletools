---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="FCMobiletools Account" description="Create or sign in to your FCMobiletools account." robots="noindex,nofollow" googlebot="noindex,nofollow">
  <main class="account-page">
    <section class="account-shell">
      <div class="account-stage">
        <div class="stage-grid"></div>
        <div class="stage-orb"></div>
        <div class="stage-line stage-line-a"></div>
        <div class="stage-line stage-line-b"></div>
        <div class="stage-copy">
          <div class="eyebrow"><i></i> FCMOBILETOOLS ACCOUNT</div>
          <h1>Your FC Mobile<br><em>identity.</em></h1>
          <p>Keep your progression, profile and future community features connected. The tools themselves stay open to everyone.</p>
          <div class="stage-points">
            <div><b>01</b><span>Profile &amp; identity</span></div>
            <div><b>02</b><span>XP, Tokens &amp; achievements</span></div>
            <div><b>03</b><span>Community features as they launch</span></div>
          </div>
        </div>
        <div class="stage-footer"><span>NO FORCED REGISTRATION</span><span>FREE TO CREATE</span><span>SECURE EMAIL AUTH</span></div>
      </div>

      <div class="account-panel">
        <div class="panel-top">
          <a class="back-link" href="/" aria-label="Back to FCMobiletools">← <span>FCMobiletools</span></a>
          <span class="secure"><i></i> SECURE</span>
        </div>

        <div class="switcher" role="tablist" aria-label="Account actions">
          <button class="switch active" id="loginTab" type="button">Sign in</button>
          <button class="switch" id="signupTab" type="button">Create account</button>
        </div>

        <form id="loginForm" class="form" novalidate>
          <div class="form-heading">
            <span class="eyebrow">WELCOME BACK</span>
            <h2>Sign in</h2>
            <p>Use the email and password connected to your account.</p>
          </div>
          <label><span>Email</span><div class="input-wrap"><input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"></div></label>
          <label><span>Password</span><div class="input-wrap"><input name="password" type="password" autocomplete="current-password" required minlength="10" placeholder="Your password"><button class="password-toggle" type="button" data-target="loginForm">Show</button></div></label>
          <button class="primary-btn" type="submit"><span>Sign in</span><b>↗</b></button>
          <div class="form-row"><button class="link-btn" type="button" id="resetBtn">Forgot password?</button><span>Protected session</span></div>
          <p class="form-message" id="loginMessage" role="alert"></p>
        </form>

        <form id="signupForm" class="form" hidden novalidate>
          <div class="form-heading">
            <span class="eyebrow">NEW ACCOUNT</span>
            <h2>Create your account</h2>
            <p>Choose the username you want people to see around FCMobiletools.</p>
          </div>
          <div class="two-fields">
            <label><span>Username</span><div class="input-wrap"><input name="username" autocomplete="username" required minlength="3" maxlength="24" pattern="[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]" placeholder="yourname"></div></label>
            <label><span>Display name</span><div class="input-wrap"><input name="display_name" autocomplete="nickname" maxlength="80" placeholder="Optional"></div></label>
          </div>
          <label><span>Email</span><div class="input-wrap"><input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"></div></label>
          <label><span>Password</span><div class="input-wrap"><input name="password" type="password" autocomplete="new-password" required minlength="10" placeholder="At least 10 characters"><button class="password-toggle" type="button" data-target="signupForm">Show</button></div></label>
          <div class="email-note"><strong>Use an email you control.</strong><span>It may be needed for verification and account recovery.</span></div>
          <label class="check-row"><input name="agree" type="checkbox" required><span>I understand that my email may be used for verification and account recovery.</span></label>
          <button class="primary-btn" type="submit"><span>Create account</span><b>↗</b></button>
          <p class="form-message" id="signupMessage" role="alert"></p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { accountAuth } from '../../lib/account-client.js';

  const loginTab = document.querySelector('#loginTab');
  const signupTab = document.querySelector('#signupTab');
  const loginForm = document.querySelector('#loginForm');
  const signupForm = document.querySelector('#signupForm');
  const loginMessage = document.querySelector('#loginMessage');
  const signupMessage = document.querySelector('#signupMessage');

  function showTab(tab) {
    const login = tab === 'login';
    loginTab.classList.toggle('active', login);
    signupTab.classList.toggle('active', !login);
    loginForm.hidden = !login;
    signupForm.hidden = login;
    window.setTimeout(() => (login ? loginForm : signupForm).querySelector('input')?.focus(), 60);
  }

  function showMessage(el, text, error = false) {
    el.textContent = text || '';
    el.className = 'form-message' + (text ? (error ? ' error' : ' success') : '');
  }

  function friendlyAuthError(error, fallback) {
    const raw = String(error?.message || error || '');
    if (/invalid api key|api key is invalid/i.test(raw)) return 'The account service rejected its client key. This is a configuration problem, not an email or username error.';
    if (/already registered|already exists|user already/i.test(raw)) return 'That email is already registered. Try signing in instead.';
    if (/email.*invalid|invalid.*email/i.test(raw)) return 'That email address does not look valid.';
    if (/password/i.test(raw) && /weak|short|characters/i.test(raw)) return 'Use a stronger password with at least 10 characters.';
    if (/rate limit|too many requests/i.test(raw)) return 'Too many attempts. Give it a moment and try again.';
    if (/network|fetch/i.test(raw)) return 'We could not reach the account service. Check your connection and try again.';
    return fallback;
  }

  loginTab.addEventListener('click', () => showTab('login'));
  signupTab.addEventListener('click', () => showTab('signup'));

  document.querySelectorAll('.password-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const form = document.querySelector('#' + toggle.dataset.target);
      const input = form?.querySelector('input[type="password"],input[type="text"][data-password]');
      if (!input) return;
      const visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      if (!visible) input.dataset.password = 'true'; else input.removeAttribute('data-password');
      toggle.textContent = visible ? 'Show' : 'Hide';
    });
  });

  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(loginMessage);
    if (!loginForm.checkValidity()) { loginForm.reportValidity(); return; }
    const fd = new FormData(loginForm);
    const button = loginForm.querySelector('.primary-btn');
    button.disabled = true;
    try {
      const result = await accountAuth.auth.signInWithPassword({
        email: String(fd.get('email') || '').trim().toLowerCase(),
        password: String(fd.get('password') || '')
      });
      if (result.error) throw result.error;
      location.replace('/profile/');
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Email or password is incorrect.'), true);
    } finally { button.disabled = false; }
  });

  signupForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    showMessage(signupMessage);
    if (!signupForm.checkValidity()) { signupForm.reportValidity(); return; }

    const fd = new FormData(signupForm);
    const email = String(fd.get('email') || '').trim().toLowerCase();
    const local = email.split('@')[0] || '';
    const domain = (email.split('@')[1] || '').toLowerCase();
    if ((domain === 'gmail.com' || domain === 'googlemail.com') && local.includes('+')) {
      showMessage(signupMessage, 'Gmail “+” aliases are not accepted. Use your main Gmail address.', true);
      return;
    }

    const button = signupForm.querySelector('.primary-btn');
    button.disabled = true;
    try {
      const result = await accountAuth.auth.signUp({
        email,
        password: String(fd.get('password') || ''),
        options: {
          emailRedirectTo: new URL('/account/', location.origin).toString(),
          data: {
            username: String(fd.get('username') || '').trim().toLowerCase(),
            display_name: String(fd.get('display_name') || '').trim()
          }
        }
      });
      if (result.error) throw result.error;
      if (result.data?.session) {
        location.replace('/profile/');
        return;
      }
      showMessage(signupMessage, 'Account created. Check your email to confirm the address before using account-only features.', false);
      signupForm.reset();
    } catch (error) {
      showMessage(signupMessage, friendlyAuthError(error, 'We could not create that account. Check the email and username, then try again.'), true);
    } finally { button.disabled = false; }
  });

  document.querySelector('#resetBtn').addEventListener('click', async (event) => {
    showMessage(loginMessage);
    const email = String(loginForm.querySelector('[name="email"]').value || '').trim().toLowerCase();
    if (!email) { showMessage(loginMessage, 'Enter your email first, then choose “Forgot password?”.', true); return; }
    event.currentTarget.disabled = true;
    try {
      const result = await accountAuth.auth.resetPasswordForEmail(email, { redirectTo: new URL('/account/', location.origin).toString() });
      if (result.error) throw result.error;
      showMessage(loginMessage, 'Password reset instructions sent. Check your inbox and spam folder.');
    } catch (error) {
      showMessage(loginMessage, friendlyAuthError(error, 'Unable to send reset instructions.'), true);
    } finally { event.currentTarget.disabled = false; }
  });

  accountAuth.auth.getSession().then((result) => {
    if (result.data?.session) location.replace('/profile/');
  });
</script>

<style>
.account-page{min-height:calc(100vh - 80px);padding:34px 18px 96px;background:radial-gradient(900px 520px at 10% 20%,rgba(76,201,255,.055),transparent 70%)}
.account-shell{width:min(1220px,100%);min-height:760px;margin:auto;display:grid;grid-template-columns:1.08fr .92fr;border:1px solid rgba(255,255,255,.07);border-radius:30px;overflow:hidden;background:#071018;box-shadow:0 35px 100px rgba(0,0,0,.38)}
.account-stage{position:relative;min-height:760px;overflow:hidden;padding:76px 72px;background:linear-gradient(145deg,#0c1925,#071018 72%);border-right:1px solid rgba(255,255,255,.07)}
.stage-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(76,201,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.035) 1px,transparent 1px);background-size:46px 46px;mask-image:linear-gradient(180deg,#000,transparent 88%);opacity:.7}
.stage-orb{position:absolute;width:560px;height:560px;right:-240px;top:-160px;border-radius:50%;background:radial-gradient(circle,rgba(76,201,255,.18),rgba(76,201,255,.025) 48%,transparent 70%);filter:blur(2px)}
.stage-line{position:absolute;border:1px solid rgba(76,201,255,.14);border-radius:50%;width:440px;height:440px;right:-120px;top:80px}.stage-line-a{transform:rotate(16deg)}.stage-line-b{width:700px;height:700px;right:-250px;top:-40px;border-color:rgba(255,255,255,.045)}
.stage-copy{position:relative;z-index:2;max-width:600px;margin-top:54px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:#4cc9ff;font:800 10px/1 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase}.eyebrow i{width:6px;height:6px;border-radius:50%;background:#4cc9ff;box-shadow:0 0 16px rgba(76,201,255,.8)}
.stage-copy h1{margin:20px 0 18px;font:700 clamp(48px,5vw,76px)/.94 'Space Grotesk',sans-serif;letter-spacing:-.065em;color:#f5f8fb}.stage-copy h1 em{font-style:normal;color:#4cc9ff}
.stage-copy>p{max-width:500px;margin:0;color:#a7b4c3;font:500 16px/1.75 Inter,sans-serif}
.stage-points{display:grid;gap:12px;margin-top:44px}.stage-points div{display:flex;align-items:center;gap:14px}.stage-points b{width:34px;color:#4cc9ff;font:800 10px Inter,sans-serif;letter-spacing:.1em}.stage-points span{color:#d5e1e8;font:600 12px Inter,sans-serif}
.stage-footer{position:absolute;left:72px;right:72px;bottom:34px;display:flex;gap:22px;color:#64798a;font:800 8px Inter,sans-serif;letter-spacing:.13em}.stage-footer span+span{padding-left:22px;border-left:1px solid rgba(255,255,255,.08)}
.account-panel{position:relative;padding:30px 42px 38px;background:linear-gradient(180deg,#0d1a27,#09141d);display:flex;flex-direction:column;justify-content:center}
.panel-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}.back-link{color:#a7b4c3;text-decoration:none;font:700 11px Inter,sans-serif}.back-link:hover{color:#f5f8fb}.secure{display:inline-flex;align-items:center;gap:7px;color:#7890a1;font:800 8px Inter,sans-serif;letter-spacing:.13em}.secure i{width:6px;height:6px;border-radius:50%;background:#47d16c;box-shadow:0 0 12px rgba(71,209,108,.7)}
.switcher{display:grid;grid-template-columns:1fr 1fr;padding:4px;border:1px solid rgba(255,255,255,.07);border-radius:14px;background:#071018}.switch{height:40px;border:0;border-radius:10px;background:transparent;color:#738797;font:800 11px Inter,sans-serif;cursor:pointer}.switch.active{color:#f5f8fb;background:#162536;box-shadow:inset 0 0 0 1px rgba(76,201,255,.15)}
.form{display:grid;gap:14px;margin-top:28px}.form-heading{margin-bottom:4px}.form-heading h2{margin:9px 0 6px;color:#f5f8fb;font:700 30px/1 'Space Grotesk',sans-serif;letter-spacing:-.04em}.form-heading p{margin:0;color:#8498a8;font:500 11px/1.65 Inter,sans-serif}.form label>span{display:block;margin-bottom:7px;color:#dbe7ee;font:700 10px Inter,sans-serif}.input-wrap{position:relative}.form input{box-sizing:border-box;width:100%;height:46px;padding:0 13px;border:1px solid #263d4b;border-radius:11px;outline:0;background:#071018;color:#f5f8fb;font:600 12px Inter,sans-serif}.form input::placeholder{color:#526879}.form input:focus{border-color:#4cc9ff;box-shadow:0 0 0 4px rgba(76,201,255,.075)}.form input[aria-invalid=true],.form input:user-invalid{border-color:#ff827c}
.password-toggle{position:absolute;right:6px;top:6px;height:34px;padding:0 9px;border:0;border-radius:8px;background:#10202d;color:#7fa9bb;font:800 9px Inter,sans-serif;cursor:pointer}.two-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.primary-btn{display:flex;align-items:center;justify-content:space-between;width:100%;height:46px;padding:0 13px 0 16px;border:0;border-radius:12px;background:linear-gradient(135deg,#9fe6ff,#4cc9ff);color:#04121a;font:800 11px Inter,sans-serif;cursor:pointer;box-shadow:0 12px 30px -10px rgba(76,201,255,.55)}.primary-btn b{display:grid;place-items:center;width:25px;height:25px;border-radius:8px;background:rgba(3,20,29,.13);font-size:13px}.primary-btn:disabled{opacity:.55;cursor:wait}
.form-row{display:flex;align-items:center;justify-content:space-between}.link-btn{border:0;background:none;padding:0;color:#79d7ff;font:800 9px Inter,sans-serif;cursor:pointer}.form-row span{color:#536a7a;font:700 8px Inter,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.email-note{display:grid;gap:3px;padding:11px 12px;border:1px solid rgba(76,201,255,.12);border-radius:11px;background:rgba(76,201,255,.035)}.email-note strong{color:#bcecff;font:800 9px Inter,sans-serif}.email-note span{color:#718797;font:500 9px/1.45 Inter,sans-serif}.check-row{display:flex!important;gap:9px;align-items:flex-start}.check-row input{width:15px;height:15px;flex:0 0 15px;margin:1px 0 0;padding:0}.check-row span{margin:0!important;color:#728696!important;font:500 9px/1.45 Inter,sans-serif!important}
.form-message{min-height:17px;margin:0;color:#ff9b94;font:700 9px/1.5 Inter,sans-serif}.form-message.success{color:#7fe59a}
@media(max-width:900px){.account-shell{grid-template-columns:1fr;max-width:620px}.account-stage{min-height:400px;padding:44px 32px;border-right:0;border-bottom:1px solid rgba(255,255,255,.07)}.stage-copy{margin-top:30px}.stage-copy h1{font-size:52px}.stage-points{display:none}.stage-footer{left:32px;right:32px;bottom:24px;gap:12px}.stage-footer span+span{padding-left:12px}.account-panel{padding:28px 28px 34px;min-height:590px}}
@media(max-width:560px){.account-page{padding:12px 10px 72px}.account-shell{border-radius:22px}.account-stage{min-height:330px;padding:34px 24px}.stage-copy h1{font-size:43px}.stage-copy>p{font-size:13px}.stage-footer{left:24px;right:24px;font-size:7px;gap:8px}.stage-footer span+span{padding-left:8px}.account-panel{padding:22px 18px 28px}.two-fields{grid-template-columns:1fr}.form{margin-top:22px}}
</style>
