---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/giveaway.css';
---

<BaseLayout title="My giveaway entries and prizes" description="See the status of your giveaway entries and claim a prize you have won." robots="noindex,nofollow" googlebot="noindex,nofollow" noAds>
  <main class="gw-root" id="app">
    <div class="gw-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="gw-wrap gw-narrow">
      <div class="gw-eyebrow"><i></i> Your giveaways</div>
      <h1 class="gw-h1" style="font-size:clamp(28px,5vw,44px)">Entries and prizes</h1>
      <p class="gw-lede" style="margin-bottom:22px">Track every decision on your entries and claim any prize you have won.</p>
      <div class="gw-callout" style="margin-bottom:22px"><div><strong>Safety first.</strong> Your claim code is private. Send it only to our official handles: <span data-gw-handles></span> We will never ask for your password, card details or one-time codes. <a href="/giveaways/safety/" style="color:var(--gw-cyan)">Read the full guide</a>.</div></div>
      <div id="gwClaim"><div class="gw-skel" style="min-height:260px"></div></div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initClaim } from '../../scripts/giveaway-pages.js';
  initClaim();
</script>
