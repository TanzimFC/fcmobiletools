---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/giveaway.css';
import { loadPublicOne } from '../../../lib/giveawayPublic.js';
import { ssrSupabaseRest } from '../../../lib/leaguePublic.js';
import { emblem } from '../../../lib/giveawayArt.js';
import { FAQ, SITE_ORIGIN } from '../../../data/giveawayConfig.js';

// Rendered on demand so the title, prize and rules text are in the HTML for search engines.
// Live numbers, countdowns and your own entry status are filled in by the browser.
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
const slug = String(Astro.params.slug || '').toLowerCase();
let g = null;
let failed = false;
try { g = await loadPublicOne(env, ssrSupabaseRest, slug); } catch (e) { failed = true; console.error('[GIVEAWAY_PAGE]', e?.message); }
if (!g) { Astro.response.status = failed ? 503 : 404; Astro.response.headers.set('cache-control', 'no-store'); }
Astro.response.headers.set('cache-control', 'no-store, max-age=0, must-revalidate');
Astro.response.headers.set('cdn-cache-control', 'no-store');
Astro.response.headers.set('cloudflare-cdn-cache-control', 'no-store');

const title = g ? g.title + ' | FCMobiletools' : 'Giveaway not found';
const description = g
  ? g.title + ' on FCMobiletools. Reward: ' + g.prize.display + '. ' + g.prize.label + '. Free to enter with account-based verification and a public draw.'
  : 'This giveaway is not available. Browse current FC Mobile giveaways.';
const schema = g ? [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE_ORIGIN + '/giveaways/' + g.slug + '/', description },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
    { '@type': 'ListItem', position: 2, name: 'Giveaways', item: SITE_ORIGIN + '/giveaways/' },
    { '@type': 'ListItem', position: 3, name: g.title, item: SITE_ORIGIN + '/giveaways/' + g.slug + '/' } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }
] : [];
---

<BaseLayout title={title} description={description} robots={g ? undefined : 'noindex,follow'} googlebot={g ? undefined : 'noindex,follow'}>
  {schema.map((s) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')}></script>)}

  <main class="gw-root" id="app" data-slug={slug} style={g ? '--gw-accent:' + g.accent : ''}>
    <div class="gw-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="gw-wrap">
      {!g && (
        <div class="gw-empty" style="margin-top:40px"><strong>{failed ? 'Giveaways are temporarily unavailable' : 'Giveaway not found'}</strong>{failed ? 'Please try again in a moment.' : 'It may have been removed or the link is wrong.'}<br /><a class="gw-btn gw-btn-gold" style="margin-top:16px" href="/giveaways/">See all giveaways</a></div>
      )}
      {g && (<>
        <nav aria-label="Breadcrumb" class="gw-note" style="margin-bottom:18px"><a href="/giveaways/" style="color:var(--gw-cyan)">Giveaways</a> / {g.title}</nav>
        <header class="gw-dh gw-hero-detail">
          <div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"><span class="gw-pill" id="gwStatus">{g.status}</span><span class="gw-eyebrow">{g.kindLabel}</span></div>
            <h1 class="gw-h1" style="font-size:clamp(32px,5vw,54px)">{g.title}</h1>
            <p class="gw-lede">{g.tagline}</p>
            <div class="gw-detail-ribbon">
              <span class="gw-detail-chip"><span class="gw-status-dot"></span> Free entry</span>
              <span class="gw-detail-chip neutral">One person · one entry</span>
              <span class="gw-detail-chip neutral">No real cash value</span>
            </div>
            <div class="gw-bignum">{g.prize.display}</div>
            <div class="gw-note" style="font-size:13px;line-height:1.8">{g.prize.label} · <span id="gwWinnersN">{g.winners.total} {g.winners.total === 1 ? 'winner' : 'winners'}</span> · <b id="gwEntries" style="color:#fff">{g.stats.entries}</b> website entries</div>
            <div class="gw-count" id="gwCount" aria-live="off">
              {g.previewOnly && <div style="min-width:0;padding:12px 18px"><strong style="font-size:18px">Entry opens soon</strong><div class="gw-note" style="margin-top:4px">Preview only · in-game reward · no real cash value</div></div>}
            </div>
            <div class="gw-cta" id="gwCta"></div>
          </div>
          <div class={g.coverUrl ? 'gw-trophy has-cover' : 'gw-trophy'} aria-hidden="true" style={'--c:' + g.accent}>
            <span class="gw-spark" style="left:12%;top:18%"></span><span class="gw-spark" style="right:14%;top:30%;animation-delay:-1s"></span>
            {g.coverUrl ? <img class="gw-detail-cover" src={g.coverUrl} alt="" loading="eager" decoding="async" /> : <Fragment set:html={emblem(g.kind)} />}
          </div>
        </header>

        <div id="gwDyn">
          <section class="gw-sec" id="gwMe" aria-live="polite"></section>

          <div class="gw-trust-rail" aria-label="Giveaway assurances" style="margin-top:22px">
            <article class="gw-trust-mini"><div class="gw-side-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l4 4L19 6"/></svg></div><div><strong>Free to enter</strong><span>No purchase or ad interaction is required.</span></div></article>
            <article class="gw-trust-mini"><div class="gw-side-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 4v5c0 4-3 7-8 9-5-2-8-5-8-9V7z"/></svg></div><div><strong>Human review</strong><span>An administrator checks each submitted entry.</span></div></article>
            <article class="gw-trust-mini"><div class="gw-side-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg></div><div><strong>Private claims</strong><span>Only the winner and authorised admins can view the code.</span></div></article>
          </div>

          {g.description && <section class="gw-sec"><div class="gw-panel"><h3>About this giveaway</h3><p style="margin:0;white-space:pre-line">{g.description}</p></div></section>}

          <section class="gw-sec" aria-labelledby="reqH">
            <div class="gw-eyebrow">ENTRY CHECKLIST</div><h2 class="gw-h2" id="reqH" style="margin-top:9px">What you need to do</h2>
            <p class="gw-sub">Every step is free. You never need to watch, click or interact with an advertisement.</p>
            <ol class="gw-reqs" id="gwReqs">
              {g.requirements.map((r, i) => <li class="gw-req" data-req={r.id}><span class="ic">{i + 1}</span><div><h4>{r.label}</h4><p>{r.help}</p></div><span class="st"></span></li>)}
            </ol>
          </section>

          <section class="gw-sec" id="gwTrackWrap" aria-labelledby="trH">
            <div class="gw-eyebrow">COMMUNITY PROGRESS</div><h2 class="gw-h2" id="trH" style="margin-top:9px">Community milestones</h2>
            <p class="gw-sub" id="gwTrackNote">More entries unlock more winners.</p>
            <div class="gw-panel" id="gwTrack"></div>
          </section>

          <section class="gw-sec" id="gwResultsWrap" hidden aria-labelledby="resH">
            <h2 class="gw-h2" id="resH">Winners</h2>
            <p class="gw-sub">Confirmed by an admin and announced publicly.</p>
            <div id="gwResults"></div>
            <div style="margin-top:14px"><a class="gw-btn gw-btn-gold" href={'/giveaways/' + g.slug + '/draw/'}>Watch the draw</a></div>
          </section>

          <section class="gw-sec" id="gwFair" aria-labelledby="fairH">
            <div class="gw-panel">
              {g.announcedWinner ? <>
                <div class="gw-eyebrow">RESULT ANNOUNCED</div><h3 id="fairH" style="margin-top:9px">Winner announced</h3>
                <p>The winner and prize are listed above. Contact the official giveaway handle on this page to claim.</p>
              </> : <>
                <div class="gw-eyebrow">DRAW TRANSPARENCY</div><h3 id="fairH" style="margin-top:9px">Provably fair draw</h3>
                <p>Before entries opened we locked the draw by publishing a fingerprint of a secret seed. When the draw is done we reveal the seed and the frozen entry list, and you can re-run the whole draw in your browser. Every eligible person receives exactly one entry. There are no bonus tickets for daily activity, shares or referrals. The draw gives every eligible entry equal weight, then uses the published seed and frozen entry list to determine the order.</p>
                <div class="gw-note">Seed fingerprint (published before entries opened)</div>
                <div class="gw-mono" id="gwCommit"></div>
                <div id="gwHashRow" hidden><div class="gw-note" style="margin-top:12px">Entry list fingerprint (frozen at the draw)</div><div class="gw-mono" id="gwHash"></div></div>
                {g.fairness.seedRevealed && <div style="margin-top:16px"><button class="gw-btn gw-btn-gold" id="gwVerify">Verify this draw yourself</button><div id="gwVerifyOut"></div></div>}
              </>}
            </div>
          </section>

          <section class="gw-sec gw-faq" aria-labelledby="faqH">
            <h2 class="gw-h2" id="faqH">Questions, answered</h2>
            {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
            <p class="gw-note" style="margin-top:16px">Read the full <a href="/giveaways/rules/" style="color:var(--gw-cyan)">Giveaway Rules</a> and the <a href="/giveaways/safety/" style="color:var(--gw-cyan)">Claim Safety guide</a>. Official claim handles: <span data-gw-handles></span></p>
          </section>
        </div>
        <div class="gw-sticky" id="gwSticky"></div>
      </>)}
    </div>
  </main>
</BaseLayout>

<script>
  import { initDetail, initVerify } from '../../../scripts/giveaway-pages.js';
  initDetail();
  initVerify();
</script>
