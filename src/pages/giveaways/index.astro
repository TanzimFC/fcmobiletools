---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/giveaway.css';
import { emblem } from '../../lib/giveawayArt.js';
import { FAQ, SITE_ORIGIN, OFFICIAL_YOUTUBE } from '../../data/giveawayConfig.js';

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'FC Mobile giveaways', url: SITE_ORIGIN + '/giveaways/',
    description: 'Free-to-enter FC Mobile giveaways with verified winners, a provably fair draw and safe prize claiming.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
    { '@type': 'ListItem', position: 2, name: 'Giveaways', item: SITE_ORIGIN + '/giveaways/' } ] }
];
const steps = [
  ['Complete the steps', 'Finish your profile, one survey and one quest. We check these automatically, so there is nothing to upload.'],
  ['Join and subscribe', 'Join our Discord and subscribe to two channels. Upload a screenshot for each subscription.'],
  ['Get reviewed', 'Automated checks run instantly and an admin reviews every entry. Every decision has a reason and a timestamp.'],
  ['Win and claim safely', 'Winners are drawn publicly. You receive a secret claim code that only you and our admins can use.']
];
const trust = [
  ['Provably fair draw', 'We publish a fingerprint of the draw seed before entries open. After the draw you can re-run it yourself on the giveaway page.'],
  ['Secret claim code', 'Winners get a private code. Nobody can claim a prize without it, so impersonators cannot take your reward.'],
  ['Official handles only', 'Prizes are paid outside the website, but only after you message our official Discord or Instagram. We never DM first asking for money.'],
  ['Visible decisions', 'Approved, rejected or asked to fix a screenshot? You always see the reason and the time on your entry timeline.']
];
---

<BaseLayout
  title="FC Mobile Giveaways: Free to Enter, Verified Winners"
  description="Win prizes in free FC Mobile giveaways on FCMobiletools. Fair public draws, verified winners, and a secret claim code that keeps your prize safe."
>
  {schema.map((s) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(s)}></script>)}

  <main class="gw-root" id="app">
    <div class="gw-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="gw-wrap">
      <header class="gw-hero">
        <div>
          <div class="gw-eyebrow"><i></i> FCMobiletools Giveaways · Free to enter</div>
          <h1 class="gw-h1">Win real prizes. <em>Drawn in public.</em> Paid safely.</h1>
          <p class="gw-lede">Complete a few simple steps, upload your proof and you are in the draw. Every entry is reviewed by a person, every winner is picked by a draw you can verify yourself, and every prize is protected by a secret claim code.</p>
          <div class="gw-cta">
            <a class="gw-btn gw-btn-gold gw-btn-lg" href="#live">See live giveaways</a>
            <a class="gw-btn gw-btn-lg" href="/giveaways/safety/">How claiming stays safe</a>
          </div>
        </div>
        <div class="gw-trophy" aria-hidden="true">
          <span class="gw-spark" style="left:12%;top:18%"></span><span class="gw-spark" style="right:14%;top:30%;animation-delay:-1s"></span><span class="gw-spark" style="left:24%;bottom:16%;animation-delay:-2s"></span>
          <Fragment set:html={emblem('ballon_dor')} />
        </div>
      </header>

      <div class="gw-stats" aria-label="Giveaway statistics">
        <div class="gw-stat"><small>Live now</small><strong id="gwStatLive">0</strong></div>
        <div class="gw-stat" style="--c:var(--gw-cyan)"><small>Total entries</small><strong id="gwStatEntries">0</strong></div>
        <div class="gw-stat" style="--c:var(--gw-vi)"><small>Prize pool live</small><strong id="gwStatPool">$0</strong></div>
        <div class="gw-stat" style="--c:var(--gw-ok)"><small>Paid to winners</small><strong id="gwStatPaid">$0</strong></div>
      </div>

      <div id="gwBanner" style="margin-top:28px"></div>

      <section class="gw-sec" id="live" aria-labelledby="liveH">
        <h2 class="gw-h2" id="liveH">Giveaways</h2>
        <p class="gw-sub">Browse freely. You need a free account to enter, so we can check your profile, survey and quest and keep prizes safe.</p>
        <div class="gw-grid" id="gwGrid"></div>
      </section>

      <section class="gw-sec" aria-labelledby="howH">
        <h2 class="gw-h2" id="howH">How it works</h2>
        <p class="gw-sub">Four steps from sign in to prize. It takes about ten minutes.</p>
        <div class="gw-cols">
          {steps.map(([t, p], i) => <div class="gw-step"><b>{i + 1}</b><h4>{t}</h4><p>{p}</p></div>)}
        </div>
      </section>

      <section class="gw-sec" aria-labelledby="trustH">
        <h2 class="gw-h2" id="trustH">Built so nobody can steal your prize</h2>
        <p class="gw-sub">Giveaway scams are common. These protections are built into every giveaway we run.</p>
        <div class="gw-cols">
          {trust.map(([t, p]) => (
            <div class="gw-trust">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              <div><h4>{t}</h4><p>{p}</p></div>
            </div>
          ))}
        </div>
      </section>

      <section class="gw-sec" aria-labelledby="winH">
        <h2 class="gw-h2" id="winH">Winners hall</h2>
        <p class="gw-sub">Paid winners appear here with a masked name. Real people, real payouts.</p>
        <div id="gwWall"></div>
      </section>

      <section class="gw-sec" aria-labelledby="supH">
        <div class="gw-panel">
          <h3 id="supH">Support the channels behind the giveaways</h3>
          <p>Subscribing is one of the entry steps, and it is also how you hear about the next giveaway first.</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            {OFFICIAL_YOUTUBE.map((c) => <a class="gw-btn" href={c.url} target="_blank" rel="noopener noreferrer">{c.name} on YouTube</a>)}
            <a class="gw-btn" data-gw-discord hidden target="_blank" rel="noopener noreferrer">Join our Discord</a>
          </div>
          <p class="gw-note" style="margin-top:14px">Official claim handles: <span data-gw-handles></span></p>
        </div>
      </section>

      <section class="gw-sec gw-faq" aria-labelledby="faqH">
        <h2 class="gw-h2" id="faqH">Questions, answered</h2>
        <p class="gw-sub">Read the full <a href="/giveaways/rules/" style="color:var(--gw-cyan)">Giveaway Rules</a> for every detail.</p>
        {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </section>

      <p class="gw-note" style="margin-top:40px">FCMobiletools giveaways are run independently. They are not sponsored, endorsed or administered by EA, Apple, Google, YouTube, Discord or Instagram.</p>
    </div>
  </main>
</BaseLayout>

<script>
  import { initHub } from '../../scripts/giveaway-pages.js';
  initHub();
</script>
