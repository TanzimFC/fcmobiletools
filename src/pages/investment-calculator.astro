---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_MARKET_TAX } from '../lib/fcMobileInvestment.js';
import { formatCoins, formatCoinsExact, parseCoinsInput } from '../lib/formatCoins.js';
import { getLocaleFromPath, namespace } from '../i18n/index.js';

// One component serves English at /investment-calculator/ and the translated copies under /bn/, /pt-br/, /id/.
const locale = getLocaleFromPath(Astro.url.pathname);
const T = namespace(locale, 'investment');
const title = T.meta.title;
const description = T.meta.description;
---

<BaseLayout title={title} description={description}>
  <script type="application/json" id="inv-i18n" is:inline set:html={JSON.stringify(T.ui).replace(/</g, '\\u003c')}></script>
  <main class="investment-page">
    <section class="investment-hero">
      <div class="investment-orbit orbit-a" aria-hidden="true"></div>
      <div class="investment-orbit orbit-b" aria-hidden="true"></div>
      <div class="wrap hero-wrap">
        <div class="hero-copy">
          <div class="hero-kicker"><span>{T.hero.kicker}</span><i>{T.hero.badge}</i></div>
          <h1>{T.hero.h1a}<em>{T.hero.h1em}</em>{T.hero.h1b ? <><br />{T.hero.h1b}</> : null}</h1>
          <p>{T.hero.lede}</p>
          <div class="hero-points"><span><b>{T.hero.pointTaxB}</b> {T.hero.pointTax}</span><span><b>{T.hero.pointNetB}</b> {T.hero.pointNet}</span><span><b>{T.hero.pointLiveB}</b> {T.hero.pointLive}</span></div>
        </div>
        <div class="hero-metric" aria-label={T.hero.metricAria}>
          <small>{T.hero.netReturn}</small><strong id="heroProfit">+0</strong><span id="heroRoi">0.0% ROI</span>
          <div class="metric-line"><i></i></div>
          <label>{T.hero.breakEven} <b id="heroBreakEven">0</b></label>
        </div>
      </div>
    </section>

    <section class="wrap calculator-section" aria-labelledby="calculator-title">
      <div class="calculator-shell">
        <div class="calc-top">
          <div><span class="eyebrow">{T.calc.eyebrow}</span><h2 id="calculator-title">{T.calc.title}</h2><p>{T.calc.lead}</p></div>
          <div class="tax-chip"><span>{T.calc.taxChip}</span><b id="taxBadge">10%</b></div>
        </div>
        <div class="calc-body">
          <div class="inputs-panel">
            <div class="field-grid">
              <label><span>{T.calc.buy} <small>{T.calc.perCard}</small></span><div class="input-wrap"><b>◈</b><input id="buyPrice" type="text" inputmode="decimal" autocomplete="off" value="1M" placeholder="1M" aria-describedby="coin-input-help" /></div></label>
              <label><span>{T.calc.sell} <small>{T.calc.perCard}</small></span><div class="input-wrap"><b>◈</b><input id="sellPrice" type="text" inputmode="decimal" autocomplete="off" value="1.25M" placeholder="1.25M" aria-describedby="coin-input-help" /></div></label>
              <label><span>{T.calc.qty} <small>{T.calc.cards}</small></span><div class="input-wrap"><b>×</b><input id="quantity" type="number" min="1" step="1" value="1" inputmode="numeric" /></div></label>
              <label><span>{T.calc.tax} <small>{T.calc.percent}</small></span><div class="input-wrap"><b>%</b><input id="taxRate" type="number" min="0" max="100" step="0.1" value={DEFAULT_MARKET_TAX} inputmode="decimal" /></div></label>
            </div>
            <div class="target-row"><div><span>{T.calc.targetQ}</span><p id="coin-input-help">{T.calc.targetHelp}</p></div><div class="target-input"><b>◈</b><input id="targetProfit" type="text" inputmode="decimal" autocomplete="off" value="250K" placeholder="250K" aria-describedby="coin-input-help" /><span>{T.calc.coins}</span></div></div>
          </div>

          <div class="result-panel">
            <div class="result-label">{T.result.label}</div>
            <div class="result-profit" id="profit">+250K</div>
            <div class="result-sub"><span set:html={T.result.afterTax.replace('{rate}', '<b id="taxRateInline">10%</b>')}></span><span id="statusPill" class="positive">{T.result.pill}</span></div>
            <div class="result-stats">
              <div><small>{T.result.totalCost}</small><b id="totalCost">1M</b></div>
              <div><small>{T.result.netSale}</small><b id="netSale">1.13M</b></div>
              <div><small>{T.result.taxPaid}</small><b id="taxAmount">125K</b></div>
              <div><small>{T.result.roi}</small><b id="roi">25.0%</b></div>
            </div>
          </div>
        </div>
        <div class="calc-footer"><span>{T.result.formula}</span><button id="reset" type="button">{T.result.reset}</button></div>
      </div>
    </section>

    <section class="wrap insight-section">
      <div class="insight-grid">
        <article class="insight-card break-even"><div class="insight-head"><span>{T.insight.breakEven}</span><i>01</i></div><strong id="breakEven">1.11M</strong><p>{T.insight.breakEvenText}</p><div class="micro"><span>{T.insight.breakEvenMove}</span><b id="breakEvenMove">+11.1%</b></div></article>
        <article class="insight-card target"><div class="insight-head"><span>{T.insight.target}</span><i>02</i></div><strong id="targetSell">1.39M</strong><p>{T.insight.targetText}</p><div class="micro"><span>{T.insight.yourTarget}</span><b id="targetValue">250,000</b></div></article>
        <article class="insight-card exposure"><div class="insight-head"><span>{T.insight.exposure}</span><i>03</i></div><strong id="exposure">1M</strong><p>{T.insight.exposureText}</p><div class="micro"><span>{T.insight.quantity}</span><b id="quantityValue">1 CARD</b></div></article>
      </div>
    </section>

    <section class="wrap explain-section">
      <div class="section-intro"><span class="eyebrow">{T.explain.eyebrow}</span><h2>{T.explain.h2a}<br /><em>{T.explain.h2em}</em></h2><p>{T.explain.text}</p></div>
      <div class="flow">
        <div class="flow-step"><b>01</b><span>{T.explain.flow[0].s}</span><strong id="flowBuy">1M</strong><small>{T.explain.flow[0].d}</small></div>
        <i>→</i><div class="flow-step tax"><b>02</b><span>{T.explain.flow[1].s}</span><strong id="flowSell">1.25M</strong><small>{T.explain.flow[1].d}</small></div>
        <i>→</i><div class="flow-step net"><b>03</b><span>{T.explain.flow[2].s}</span><strong id="flowNet">1.13M</strong><small>{T.explain.flow[2].d}</small></div>
        <i>→</i><div class="flow-step profit"><b>04</b><span>{T.explain.flow[3].s}</span><strong id="flowProfit">+125K</strong><small>{T.explain.flow[3].d}</small></div>
      </div>
    </section>

    <section class="reference-section">
      <div class="wrap reference-wrap">
        <div><span class="eyebrow">{T.reference.eyebrow}</span><h2>{T.reference.title}</h2><p>{T.reference.lead}</p></div>
        <div class="reference-list">
          <div><b>{T.reference.items[0].b}</b><span id="refMultiplier">1.111×</span><small>{T.reference.items[0].d}</small></div>
          <div><b>{T.reference.items[1].b}</b><span id="margin">11.1%</span><small>{T.reference.items[1].d}</small></div>
          <div><b>{T.reference.items[2].b}</b><span id="priceMove">+25.0%</span><small>{T.reference.items[2].d}</small></div>
        </div>
      </div>
    </section>

    <section class="wrap faq-section">
      <div><span class="eyebrow">{T.faq.eyebrow}</span><h2>{T.faq.title}</h2></div>
      <div class="faq-list">
        {T.faq.items.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>
  </main>

<script>
import { calculateInvestment, DEFAULT_MARKET_TAX } from '../lib/fcMobileInvestment.js';
// These were only imported for the server-side frontmatter before, so the browser threw a ReferenceError and the calculator never ran.
import { formatCoins, formatCoinsExact, parseCoinsInput } from '../lib/formatCoins.js';
const $ = (id) => document.getElementById(id);
const U = JSON.parse(document.getElementById('inv-i18n').textContent);
const fill = (text, n) => text.replace('{n}', n);
const fmt = (n) => formatCoins(n);
const exact = (n) => formatCoinsExact(n);
const money = (n) => `${n < 0 ? '-' : ''}${fmt(Math.abs(n))}`;
const setCoinOutput = (id, value) => {
  const el = $(id);
  if (!el) return;
  el.textContent = fmt(value);
  el.title = `${exact(value)} coins`;
};
const fields = ['buyPrice','sellPrice','quantity','taxRate','targetProfit'].map($);
function render(){
  const d = calculateInvestment({
    buyPrice: parseCoinsInput($('buyPrice').value),
    sellPrice: parseCoinsInput($('sellPrice').value),
    quantity: $('quantity').value,
    taxRate: $('taxRate').value,
    targetProfit: parseCoinsInput($('targetProfit').value)
  });
  // money() already prefixes a minus sign for negatives, so adding another produced "--1.65M".
  const signed = d.profit >= 0 ? `+${money(d.profit)}` : money(d.profit);
  $('profit').textContent = signed;
  $('profit').title = `${d.profit < 0 ? '-' : ''}${exact(Math.abs(d.profit))} coins`;
  $('heroProfit').textContent = signed;
  $('heroProfit').title = `${d.profit < 0 ? '-' : ''}${exact(Math.abs(d.profit))} coins`;
  $('heroRoi').textContent = fill(U.roi, d.roi.toFixed(1));
  setCoinOutput('totalCost', d.totalCost);
  setCoinOutput('netSale', d.netSale);
  setCoinOutput('taxAmount', d.taxAmount);
  $('roi').textContent = `${d.roi.toFixed(1)}%`;
  $('taxBadge').textContent = `${d.taxRate}%`;
  $('taxRateInline').textContent = `${d.taxRate}%`;
  setCoinOutput('breakEven', d.breakEvenSell);
  setCoinOutput('heroBreakEven', d.breakEvenSell);
  setCoinOutput('targetSell', d.targetSell);
  setCoinOutput('targetValue', d.targetProfit);
  setCoinOutput('exposure', d.totalCost);
  $('quantityValue').textContent = fill(d.quantity === 1 ? U.qtyOne : U.qtyMany, d.quantity.toLocaleString('en-US'));
  const breakMove = d.buy > 0 ? ((d.breakEvenSell / d.buy - 1) * 100) : 0;
  $('breakEvenMove').textContent = `+${breakMove.toFixed(1)}%`;
  setCoinOutput('flowBuy', d.totalCost);
  setCoinOutput('flowSell', d.grossSale);
  setCoinOutput('flowNet', d.netSale);
  $('flowProfit').textContent = signed;
  $('flowProfit').title = `${d.profit < 0 ? '-' : ''}${exact(Math.abs(d.profit))} coins`;
  $('refMultiplier').textContent = d.buy > 0 ? `${(d.breakEvenSell / d.buy).toFixed(3)}×` : '—';
  $('margin').textContent = `${d.margin.toFixed(1)}%`;
  $('priceMove').textContent = `${d.priceChange >= 0 ? '+' : ''}${d.priceChange.toFixed(1)}%`;
  $('statusPill').textContent = d.profit > 0 ? U.status.profit : d.profit < 0 ? U.status.loss : U.status.even;
  $('statusPill').className = d.profit > 0 ? 'positive' : d.profit < 0 ? 'negative' : 'neutral';
  $('profit').classList.toggle('loss', d.profit < 0);
  $('heroProfit').classList.toggle('loss', d.profit < 0);
}
fields.forEach((field) => field.addEventListener('input', render));
['buyPrice','sellPrice','targetProfit'].forEach((id) => $(id).addEventListener('blur', (event) => {
  const raw = event.target.value.trim();
  if (!raw) return;
  const parsed = parseCoinsInput(raw);
  if (parsed > 0) event.target.value = formatCoins(parsed);
}));
$('reset').addEventListener('click', () => {
  $('buyPrice').value='1M';
  $('sellPrice').value='1.25M';
  $('quantity').value='1';
  $('taxRate').value=String(DEFAULT_MARKET_TAX);
  $('targetProfit').value='250K';
  render();
});
render();
</script>

<style>
.investment-page{--bg:#05080d;--panel:#0a1119;--panel2:#0d1822;--line:#20313e;--text:#f4fbff;--muted:#8195a3;--cyan:#3fd5ff;--blue:#5b7cff;--green:#4de0a4;--red:#ff6879;background:var(--bg);color:var(--text);overflow:hidden;font-family:var(--sans,system-ui,sans-serif)}
.investment-page .wrap{width:min(1180px,calc(100% - 36px));margin:auto}.eyebrow{font:900 9px var(--mono,monospace);letter-spacing:.16em;color:var(--cyan)}
.investment-hero{position:relative;min-height:610px;display:flex;align-items:center;border-bottom:1px solid var(--line);background:radial-gradient(circle at 70% 35%,#3fd5ff12,transparent 30%),radial-gradient(circle at 92% 80%,#5b7cff12,transparent 32%)}.hero-wrap{display:grid;grid-template-columns:minmax(0,1.3fr) 360px;gap:70px;align-items:center;padding:100px 0 85px}.hero-copy{position:relative;z-index:2}.hero-kicker{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font:900 9px var(--mono)}.hero-kicker span{color:var(--cyan);letter-spacing:.16em}.hero-kicker i{font-style:normal;color:#718692;border:1px solid var(--line);padding:7px 9px;border-radius:999px}.hero-copy h1{margin:18px 0 20px;font-size:clamp(52px,7.4vw,92px);line-height:.88;letter-spacing:-.07em}.hero-copy h1 em{font-style:normal;color:var(--cyan)}.hero-copy>p{max-width:650px;color:#95a8b5;font-size:14px;line-height:1.8;margin:0}.hero-points{display:flex;flex-wrap:wrap;gap:18px;margin-top:30px;color:#728894;font:800 8px var(--mono)}.hero-points b{color:#dff7ff;margin-right:4px}.hero-metric{position:relative;padding:30px;border:1px solid #294252;border-radius:26px;background:linear-gradient(145deg,#0d1a24cc,#071017e8);box-shadow:0 30px 100px #0008;backdrop-filter:blur(14px)}.hero-metric small{font:900 8px var(--mono);letter-spacing:.15em;color:#718894}.hero-metric strong{display:block;margin:10px 0 4px;font:900 clamp(40px,5vw,60px) var(--mono);letter-spacing:-.08em;color:var(--green)}.hero-metric strong.loss{color:var(--red)}.hero-metric>span{font:800 10px var(--mono);color:#8ba0ad}.metric-line{height:5px;background:#ffffff0b;border-radius:99px;margin:28px 0}.metric-line i{display:block;width:72%;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan))}.hero-metric label{display:flex;justify-content:space-between;font:800 8px var(--mono);color:#687e8b}.hero-metric label b{color:#dff7ff}
.investment-orbit{position:absolute;border:1px solid #3fd5ff14;border-radius:50%;pointer-events:none}.orbit-a{width:680px;height:680px;right:-240px;top:-90px}.orbit-b{width:380px;height:380px;right:-90px;top:60px;border-color:#5b7cff14}
.calculator-section{padding:65px 0 35px}.calculator-shell{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:linear-gradient(145deg,#0b141d,#071018);box-shadow:0 25px 80px #0005}.calc-top{display:flex;justify-content:space-between;gap:20px;padding:30px;border-bottom:1px solid var(--line)}.calc-top h2{margin:8px 0 5px;font-size:29px;letter-spacing:-.05em}.calc-top p{margin:0;color:var(--muted);font-size:10px}.tax-chip{align-self:start;display:grid;gap:5px;min-width:95px;padding:11px 13px;border:1px solid #3fd5ff2b;border-radius:11px;background:#3fd5ff08}.tax-chip span{font:900 7px var(--mono);color:#698492}.tax-chip b{font:900 18px var(--mono);color:var(--cyan)}.calc-body{display:grid;grid-template-columns:1.15fr .85fr}.inputs-panel{padding:28px;border-right:1px solid var(--line)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field-grid label{display:grid;gap:8px}.field-grid label>span{font:900 8px var(--mono);color:#91a6b2;letter-spacing:.1em}.field-grid small{font-size:7px;color:#526c79}.input-wrap{display:flex;align-items:center;border:1px solid #263b49;border-radius:11px;background:#060d14;overflow:hidden}.input-wrap b{padding-left:13px;color:#527487;font:900 12px var(--mono)}.input-wrap input,.target-input input{width:100%;border:0;outline:0;background:transparent;color:#f4fbff;padding:14px 12px;font:800 13px var(--mono);min-width:0}.target-row{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:16px;padding:15px;border:1px solid #ffffff0c;border-radius:12px;background:#ffffff04}.target-row>div:first-child span{font:900 8px var(--mono);color:#9bb1bc}.target-row p{margin:5px 0 0;color:#647c89;font-size:9px}.target-input{display:flex;align-items:center;min-width:210px;border:1px solid #293e4c;border-radius:10px;background:#050b11}.target-input b{padding-left:11px;color:#527487}.target-input span{padding-right:11px;color:#59717e;font:800 8px var(--mono)}.result-panel{padding:30px;background:radial-gradient(circle at 80% 10%,#3fd5ff0b,transparent 35%)}.result-label{font:900 8px var(--mono);letter-spacing:.14em;color:#78909c}.result-profit{font:900 clamp(42px,5vw,64px) var(--mono);letter-spacing:-.08em;color:var(--green);margin:9px 0 4px}.result-profit.loss{color:var(--red)}.result-sub{display:flex;justify-content:space-between;align-items:center;color:#6f8793;font:800 8px var(--mono)}.result-sub b{color:#c8dce5}.result-sub .positive,.result-sub .negative,.result-sub .neutral{padding:6px 8px;border-radius:999px}.positive{color:var(--green);background:#4de0a40e;border:1px solid #4de0a420}.negative{color:var(--red);background:#ff68790e;border:1px solid #ff687920}.neutral{color:#f0c76c;background:#f0c76c0e;border:1px solid #f0c76c20}.result-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:28px}.result-stats div{padding:13px;border:1px solid #ffffff0c;border-radius:10px;background:#ffffff04}.result-stats small{display:block;font:900 7px var(--mono);color:#607985}.result-stats b{display:block;margin-top:7px;font:900 13px var(--mono)}.calc-footer{display:flex;justify-content:space-between;align-items:center;padding:15px 28px;border-top:1px solid var(--line);color:#5e7683;font:800 7px var(--mono)}.calc-footer button{border:0;background:transparent;color:#8099a5;font:900 7px var(--mono);cursor:pointer}.calc-footer button:hover{color:var(--cyan)}
.insight-section{padding:30px 0 75px}.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.insight-card{padding:23px;border:1px solid var(--line);border-radius:18px;background:var(--panel)}.insight-head{display:flex;justify-content:space-between;font:900 8px var(--mono);color:#6e8793}.insight-head i{font-style:normal;color:#46616f}.insight-card>strong{display:block;margin:25px 0 7px;font:900 clamp(27px,4vw,42px) var(--mono);letter-spacing:-.07em;color:#eef9fc}.insight-card p{margin:0;color:#708591;font-size:10px;line-height:1.65;min-height:33px}.micro{display:flex;justify-content:space-between;margin-top:23px;padding-top:13px;border-top:1px solid #ffffff0b;font:800 7px var(--mono);color:#607985}.micro b{color:var(--cyan)}
.explain-section{display:grid;grid-template-columns:300px 1fr;gap:70px;padding:70px 0 90px;border-top:1px solid var(--line)}.section-intro h2{font-size:42px;line-height:.94;letter-spacing:-.06em;margin:12px 0 15px}.section-intro h2 em{font-style:normal;color:var(--cyan)}.section-intro p{margin:0;color:var(--muted);font-size:11px;line-height:1.75}.flow{display:grid;grid-template-columns:1fr 22px 1fr 22px 1fr 22px 1fr;align-items:center;gap:9px}.flow>i{font-style:normal;color:#38505e;text-align:center}.flow-step{min-height:175px;padding:17px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.flow-step>b{font:900 8px var(--mono);color:#4c6875}.flow-step>span{display:block;margin-top:24px;font:900 7px var(--mono);letter-spacing:.12em;color:#68818e}.flow-step strong{display:block;margin-top:8px;font:900 19px var(--mono);letter-spacing:-.06em}.flow-step small{display:block;margin-top:10px;color:#637b88;font-size:8px;line-height:1.5}.flow-step.net strong{color:var(--cyan)}.flow-step.profit strong{color:var(--green)}.flow-step.tax strong{color:#c9d9e0}
.reference-section{background:#071018;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.reference-wrap{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;padding:75px 0}.reference-wrap h2{font-size:39px;letter-spacing:-.06em;margin:10px 0 8px}.reference-wrap>div:first-child p{margin:0;color:var(--muted);font-size:10px;line-height:1.7}.reference-list{border-top:1px solid #ffffff0c}.reference-list>div{display:grid;grid-template-columns:1fr auto;gap:10px;padding:18px 0;border-bottom:1px solid #ffffff0c}.reference-list b{font-size:12px}.reference-list span{font:900 18px var(--mono);color:var(--cyan)}.reference-list small{grid-column:1/-1;color:#687f8b;font-size:9px;line-height:1.5}
.faq-section{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;padding:80px 0 100px}.faq-section h2{font-size:36px;line-height:1;letter-spacing:-.06em;margin:10px 0}.faq-list{border-top:1px solid var(--line)}.faq-list details{padding:18px 0;border-bottom:1px solid var(--line)}.faq-list summary{cursor:pointer;font-weight:800;font-size:12px}.faq-list p{margin:10px 0 0;color:var(--muted);font-size:10px;line-height:1.7}
@media(max-width:900px){.hero-wrap,.calc-body,.explain-section,.reference-wrap,.faq-section{grid-template-columns:1fr}.hero-metric{max-width:420px}.inputs-panel{border-right:0;border-bottom:1px solid var(--line)}.insight-grid{grid-template-columns:1fr}.flow{grid-template-columns:1fr}.flow>i{transform:rotate(90deg);margin:-4px 0}.flow-step{min-height:auto}.reference-wrap,.faq-section,.explain-section{gap:35px}}@media(max-width:620px){.investment-page .wrap{width:calc(100% - 26px)}.hero-wrap{padding:75px 0}.hero-copy h1{font-size:clamp(47px,14vw,70px)}.field-grid{grid-template-columns:1fr}.target-row{align-items:stretch;flex-direction:column}.target-input{min-width:0}.calc-top,.calc-footer{align-items:flex-start;flex-direction:column}.result-panel{padding:25px}.hero-points{gap:10px}.investment-orbit{opacity:.5}.reference-wrap h2,.faq-section h2{font-size:31px}}
</style>

<style is:global>
/* Bengali needs larger sizes than the tiny uppercase Latin labels this page uses, and a calmer hero heading. */
html[lang="bn"] .investment-page .hero-copy h1{font-size:clamp(36px,5vw,64px)!important;line-height:1.3!important}
html[lang="bn"] .investment-page .hero-points span,
html[lang="bn"] .investment-page .hero-points b,
html[lang="bn"] .investment-page .hero-kicker,
html[lang="bn"] .investment-page .eyebrow,
html[lang="bn"] .investment-page .hero-metric small,
html[lang="bn"] .investment-page .hero-metric label,
html[lang="bn"] .investment-page .result-label,
