---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/tournament-premium.css';
import { DISCORD_URL } from '../data/tournamentConfig.js';
---
<BaseLayout title="Match Center" description="Your FC Mobile tournament match room: chat, schedule, upload proof and confirm results." robots="noindex,follow">
  <main class="tp"><div class="tp-pitch" aria-hidden="true"><svg viewBox="0 0 600 400" fill="none" stroke="currentColor" stroke-width="2"><circle cx="420" cy="200" r="150" /><path d="M420 -20V420" /></svg></div><div class="tp-wrap">
    <header class="tp-hero center" style="padding-bottom:20px">
      <span class="tp-eyebrow" data-in><i></i>Match Center</span>
      <h1 class="tp-title" style="font-size:clamp(40px,7vw,80px)!important">Your match day</h1>
      <p class="tp-lede">Agree a time, play, upload proof. Your opponent confirms and the bracket moves.</p>
    </header>
    <section class="tp-glass" style="max-width:560px;margin:0 auto 40px"><div class="in-c">
      <h3 style="font-size:20px;margin-bottom:6px">Claim your seat</h3>
      <p style="color:#9bacbd;font-size:14px;margin:0 0 14px">Use the player tag you registered with. Your Discord and UID are shown only to your opponent.</p>
      <div style="display:grid;gap:10px"><input class="tp-input" id="tag" placeholder="Registered player tag"><input class="tp-input" id="dc" placeholder="Discord username"><input class="tp-input" id="uid" placeholder="In-game UID">
      <button class="tp-btn sm" id="claim">Claim seat</button><small id="claimMsg" style="color:#8b9bad"></small></div></div></section>
    <div id="list" class="tp-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))"></div>
    <p style="text-align:center;margin-top:36px;color:#8b9bad">Stuck? <a href={DISCORD_URL} style="color:var(--cyan)">Ask an admin on Discord</a></p>
  </div></main>
</BaseLayout>
<script>
  import { initFx } from '../lib/tournamentFx.js';
  const $ = (s: string) => document.querySelector(s) as HTMLElement & HTMLInputElement;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const api = async (p: string, body?: unknown) => { const r = await fetch('/api/match-center/' + p, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : {}); const d = await r.json().catch(() => ({})); if (!r.ok) throw new Error(d.error || 'Something went wrong'); return d; };
  const step = (m: any) => { const r = m.report; return r?.status === 'disputed' ? 3 : r?.status === 'escalated' ? 3 : r ? 2 : m.messages.length ? 1 : 0; };
  const labels = ['Meet', 'Play', 'Proof sent', 'Confirmed'];
  function card(m: any) {
    const r = m.report, s = step(m), mine = r && r.reporter_player_id === m.meId;
    const rail = labels.map((l, i) => `<li class="${i <= s ? 'on' : ''}"><i></i>${l}</li>`).join('');
    const msgs = m.messages.map((x: any) => `<p class="${x.sender_player_id === m.meId ? 'me' : ''}">${x.kind === 'schedule' ? '🗓 ' : ''}${esc(x.body)}</p>`).join('') || '<p class="hint">No messages yet. Say hi and pick a time.</p>';
    let action = `<details><summary class="tp-btn sm">Report result</summary><div class="rep"><div class="sc"><input class="tp-input" type="number" min="0" placeholder="You" data-me><b>–</b><input class="tp-input" type="number" min="0" placeholder="Opp." data-opp></div><input type="file" accept="image/*" data-file><button class="tp-btn sm" data-send>Submit with screenshot</button></div></details>`;
    if (r?.status === 'pending') action = mine ? `<span class="tp-pill upcoming"><i></i>Waiting for ${esc(m.opponent.name)} to confirm</span>` : `<div class="rep"><a href="${esc(r.screenshot_url)}" target="_blank" rel="noopener"><img src="${esc(r.screenshot_url)}" alt="Match proof" loading="lazy"></a><p>Reported score: <b>${r.player1_score}–${r.player2_score}</b></p><div style="display:flex;gap:8px"><button class="tp-btn sm" data-confirm>Confirm</button><button class="tp-btn sm ghost" data-dispute>Dispute</button></div></div>`;
    if (r && ['disputed', 'escalated'].includes(r.status)) action = `<span class="tp-pill warn"><i></i>Admin reviewing the evidence</span>`;
    return `<article class="tp-glass" data-match="${m.id}" data-report="${r?.id || ''}"><div class="in-c">
      <small style="color:#8b9bad">${esc(m.tournament?.name)} · Round ${m.round_number}</small>
      <h3 style="font-size:26px;margin:8px 0 14px">vs ${esc(m.opponent.name)}</h3>
      <div class="chips2">${m.opponent.discord ? `<button data-copy="${esc(m.opponent.discord)}">Discord ${esc(m.opponent.discord)}</button>` : ''}${m.opponent.uid ? `<button data-copy="${esc(m.opponent.uid)}">UID ${esc(m.opponent.uid)}</button>` : '<span class="hint">Opponent has not shared Discord/UID yet.</span>'}</div>
      <ol class="rail">${rail}</ol><div class="chat">${msgs}</div>
      <div class="send"><input class="tp-input" placeholder="Message or propose a time" data-msg><button class="tp-btn sm ghost" data-say>Send</button></div>
      <div style="margin-top:16px">${action}</div><small class="err" style="color:#ff7a8a"></small></div></article>`;
  }
  async function load() {
    try {
      const { matches } = await api('mine');
      $('#list').innerHTML = matches.length ? matches.map(card).join('') : '<div class="tp-glass" style="grid-column:1/-1"><div class="in-c" style="text-align:center;padding:48px"><h3>No active matches</h3><p style="color:#9bacbd">When your next fixture is ready it appears here.</p></div></div>';
      initFx($('#list') as any);
    } catch (e: any) { $('#list').innerHTML = `<p style="text-align:center;color:#9bacbd;grid-column:1/-1">${esc(e.message)}</p>`; }
  }
  $('#claim').onclick = async () => { try { await api('claim', { playerTag: $('#tag').value, discord: $('#dc').value, uid: $('#uid').value }); $('#claimMsg').textContent = 'Seat claimed.'; load(); } catch (e: any) { $('#claimMsg').textContent = e.message; } };
  $('#list').addEventListener('click', async (ev) => {
    const t = ev.target as HTMLElement, c = t.closest('article') as HTMLElement | null; if (!c) return;
    const err = c.querySelector('.err') as HTMLElement, matchId = Number(c.dataset.match), reportId = Number(c.dataset.report);
    try {
      if (t.dataset.copy) { await navigator.clipboard.writeText(t.dataset.copy); t.textContent = 'Copied ✓'; return; }
      if (t.hasAttribute('data-say')) { const i = c.querySelector('[data-msg]') as HTMLInputElement; const text = i.value.trim(); if (!text) return; await api('message', { matchId, body: text, kind: /\d{1,2}(:\d{2})?\s?(am|pm)|today|tomorrow|tonight/i.test(text) ? 'schedule' : 'chat' }); load(); }
      if (t.hasAttribute('data-send')) {
        const f = (c.querySelector('[data-file]') as HTMLInputElement).files?.[0]; if (!f) throw new Error('Choose your screenshot.');
        t.textContent = 'Uploading…'; const fd = new FormData(); fd.append('file', f); fd.append('permanent', 'true');
        const up = await (await fetch('/api/account/image-upload', { method: 'POST', body: fd })).json(); const link = up.url || up.imageUrl || up.data?.url;
        if (!link) throw new Error(up.error || 'Upload failed.');
        await api('report', { matchId, myScore: (c.querySelector('[data-me]') as HTMLInputElement).value, oppScore: (c.querySelector('[data-opp]') as HTMLInputElement).value, screenshotUrl: link }); load();
      }
      if (t.hasAttribute('data-confirm')) { await api('respond', { reportId, action: 'confirm' }); load(); }
      if (t.hasAttribute('data-dispute')) { const note = prompt('What is wrong with the reported score?') || ''; await api('respond', { reportId, action: 'dispute', note }); load(); }
    } catch (e: any) { err.textContent = e.message; (t as HTMLButtonElement).textContent = t.textContent === 'Uploading…' ? 'Submit with screenshot' : t.textContent; }
  });
  load();
</script>
<style is:global>
  .tp .rail{display:flex;justify-content:space-between;margin:18px 0;padding:0;list-style:none;position:relative}
  .tp .rail::before{content:"";position:absolute;left:8px;right:8px;top:6px;height:2px;background:rgba(255,255,255,.1)}
  .tp .rail li{position:relative;display:grid;justify-items:center;gap:8px;font-size:12px;color:#6f8294;letter-spacing:.04em}
  .tp .rail li i{width:14px;height:14px;border-radius:50%;background:#0b1320;border:2px solid #2a3a4d;transition:.5s}
  .tp .rail li.on{color:#f4f7fb}.tp .rail li.on i{background:var(--cyan);border-color:var(--cyan)}
  .tp .chat{max-height:150px;overflow:auto;display:grid;gap:6px;padding:12px;border-radius:14px;background:rgba(0,0,0,.25);font-size:14px}
  .tp .chat p{margin:0;padding:8px 12px;border-radius:12px;background:rgba(255,255,255,.06);max-width:85%}.tp .chat p.me{justify-self:end;background:rgba(76,201,255,.16)}
  .tp .hint{color:#6f8294;font-size:13px}.tp .send{display:flex;gap:8px;margin-top:10px}
  .tp .chips2{display:flex;gap:8px;flex-wrap:wrap}.tp .chips2 button{padding:8px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:#cfdae4;font:600 12.5px Inter;cursor:pointer}
  .tp .rep{display:grid;gap:10px;margin-top:12px}.tp .rep img{width:100%;border-radius:14px;border:1px solid rgba(255,255,255,.1)}
  .tp .sc{display:flex;gap:10px;align-items:center}.tp summary{list-style:none;cursor:pointer;width:max-content}
</style>
