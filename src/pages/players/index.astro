---
import BaseLayout from '../../layouts/BaseLayout.astro';
import filters from '../../data/playerFilterMetadata.json';
const positions = ['All positions', ...filters.positions];
const events = ['All events', ...filters.events];
---
<BaseLayout title="FC Mobile Player Database" description="Search FC Mobile players by name, position, OVR and event. Browse player cards and dated Star Shard requirements.">
  <main class="players-page" data-player-page>
    <section class="players-heading">
      <p class="players-eyebrow">FCMOBILETOOLS · DATABASE</p>
      <h1>Player database</h1>
      <p>Search cards, compare ratings, and check dated Star Shard requirements.</p>
    </section>
    <form class="player-filters" id="player-filters">
      <label class="player-search"><span>Search</span><input id="player-search" type="search" placeholder="Player name…" autocomplete="off" /></label>
      <label><span>Position</span><select id="position">{positions.map((value, index) => <option value={index ? value : ''}>{value}</option>)}</select></label>
      <label><span>Club</span><select id="club"><option value="">All clubs</option></select></label>
      <label><span>League</span><select id="league"><option value="">All leagues</option></select></label>
      <label><span>Nation</span><select id="nation"><option value="">All nations</option></select></label>
      <label><span>Event</span><select id="event">{events.map((value, index) => <option value={index ? value : ''}>{value}</option>)}</select></label>
      <label><span>Minimum OVR</span><input id="min-ovr" type="number" min="1" max="150" placeholder="Any" /></label>
      <label><span>Maximum OVR</span><input id="max-ovr" type="number" min="1" max="150" placeholder="Any" /></label>
      <label><span>Sort</span><select id="sort"><option value="ovr-desc">OVR: high to low</option><option value="ovr-asc">OVR: low to high</option><option value="name-asc">Name: A to Z</option><option value="name-desc">Name: Z to A</option></select></label>
      <button class="player-filter-submit" type="submit">Apply filters</button>
    </form>
    <div class="player-results-head"><strong id="player-count">Loading players…</strong><span>48 cards per page</span></div>
    <div class="player-grid" id="player-grid" aria-live="polite"></div>
    <div class="player-empty" id="player-empty" hidden>No players match these filters.</div>
    <nav class="player-pagination" aria-label="Player database pages"><button type="button" id="player-prev" disabled>← Previous</button><span id="player-page-label">Page 1</span><button type="button" id="player-next" disabled>Next →</button></nav>
    <p class="player-data-note">Star Shard requirements are source observations dated September 16, 2026. Coin sell-price observations will appear when a verified market source is connected. <a href="https://fcmobilesquad.com/star-signings-players" rel="nofollow">Shard data source</a>.</p>
  </main>
</BaseLayout>

<style is:global>
.players-page,.player-detail{width:min(1220px,calc(100% - 36px));margin:0 auto;padding:54px 0 90px;color:#eaf6fb}.players-heading{margin:0 auto 28px;max-width:760px;text-align:center}.players-eyebrow{font:700 11px/1.2 ui-monospace,monospace;letter-spacing:.18em;color:#5cd4ff}.players-heading h1{margin:12px 0;font-size:clamp(34px,6vw,60px);letter-spacing:-.055em}.players-heading>p:last-child{color:#98acb8;font-size:15px}.player-filters{display:grid;grid-template-columns:2fr repeat(2,minmax(130px,1fr)) repeat(2,minmax(110px,.7fr)) minmax(170px,1fr) auto;gap:10px;align-items:end;padding:16px;border:1px solid #203744;border-radius:18px;background:linear-gradient(140deg,#101c25,#0b131a);box-shadow:0 14px 38px #0003}.player-filters label{display:grid;gap:7px;min-width:0}.player-filters label span{font-size:11px;font-weight:700;color:#8ca3b0}.player-filters input,.player-filters select{min-width:0;width:100%;height:42px;padding:0 12px;border:1px solid #29404d;border-radius:10px;background:#091219;color:#eef8fc;font:500 13px inherit}.player-filter-submit,.player-pagination button{height:42px;padding:0 16px;border:1px solid #47c9f7;border-radius:10px;background:#48c4ed;color:#05131b;font-weight:800;cursor:pointer}.player-results-head{display:flex;justify-content:space-between;align-items:center;margin:26px 2px 13px;color:#9bb1bd;font-size:13px}.player-results-head strong{color:#eff9fc;font-size:14px}.player-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.player-card-shell{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid #203945;border-radius:17px;background:#0a1218;color:inherit;text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s}.player-card-shell:hover{transform:translateY(-3px);border-color:#55cef6;box-shadow:0 15px 34px #0005}.player-card-art{position:relative;isolation:isolate;display:block;min-height:260px;overflow:hidden;padding:12px;background:radial-gradient(ellipse at 50% 55%,#5bd8f53b,transparent 44%),linear-gradient(145deg,#142f3c 0%,#0c1a23 54%,#091119 100%)}.player-card-art:before{content:"";position:absolute;inset:6px;border:1px solid var(--card-accent);clip-path:polygon(0 0,78% 0,100% 18%,100% 100%,0 100%);opacity:.72;pointer-events:none}.player-card-art:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 15px,#ffffff08 16px,#ffffff08 17px,transparent 18px 31px);pointer-events:none}.player-card-tier-standard{--card-accent:#62d8f4}.player-card-tier-elite{--card-accent:#a8a7ff;background:radial-gradient(ellipse at 50% 55%,#9275ff4d,transparent 45%),linear-gradient(145deg,#29254b,#11172a 56%,#0a101a)}.player-card-tier-legend{--card-accent:#ffe095;background:radial-gradient(ellipse at 50% 55%,#ffc45b45,transparent 46%),linear-gradient(145deg,#55452a,#211b16 56%,#0d1117)}.player-card-topline,.player-card-footline{position:absolute;z-index:3;left:16px;right:16px;display:flex;justify-content:space-between;align-items:center;color:var(--card-accent);font:700 8px/1.2 ui-monospace,monospace;letter-spacing:.11em}.player-card-topline{top:16px}.player-card-edition{color:#c3d0d6;font-size:7px}.player-card-rating{position:absolute;z-index:4;left:17px;top:39px;display:grid;text-align:center;color:#f8fbfc}.player-card-rating b{font:800 25px/1 system-ui}.player-card-rating small{font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.15em;color:var(--card-accent)}.player-card-rating strong{margin-top:4px;font:800 10px/1 system-ui;color:#fff}.player-card-emblem{position:absolute;z-index:2;right:17px;top:39px;color:var(--card-accent);font:900 11px/1 system-ui;letter-spacing:-.05em}.player-card-portrait{position:absolute;z-index:1;inset:67px 14px 52px;display:grid;place-items:center}.player-card-monogram{display:grid;place-items:center;width:104px;aspect-ratio:1;border-radius:50%;border:1px solid var(--card-accent);background:radial-gradient(circle at 50% 38%,#ffffff20,transparent 60%),linear-gradient(145deg,#dcecf01c,#60747e08);color:#f2fbfe;font:800 31px/1 system-ui;letter-spacing:-.06em;text-shadow:0 5px 19px #0008;box-shadow:0 0 42px #62d8f426}.player-card-image{position:absolute;inset:0;width:100%;height:100%;max-width:100%;object-fit:contain;filter:drop-shadow(0 12px 17px #0009)}.player-card-identity{position:absolute;z-index:4;left:16px;right:16px;bottom:30px;display:grid;gap:4px;text-align:center;text-shadow:0 2px 10px #000}.player-card-identity strong{overflow:hidden;color:#fff;font:800 15px/1.1 system-ui;letter-spacing:-.035em;text-overflow:ellipsis;white-space:nowrap}.player-card-identity span{overflow:hidden;color:var(--card-accent);font:700 8px/1.2 ui-monospace,monospace;letter-spacing:.06em;text-overflow:ellipsis;white-space:nowrap}.player-card-footline{bottom:13px;color:#9bb0bb;font-size:6px}.player-card-shards{position:absolute;z-index:5;right:9px;bottom:9px;display:flex;align-items:center;gap:4px;padding:5px 7px;border:1px solid #f0d27755;border-radius:999px;background:#09151be8;color:#ffe28f;font-size:8px;font-weight:800}.player-card-shards img{width:12px;height:12px;object-fit:contain}.player-card-copy{padding:12px 13px 14px}.player-card-copy h2{overflow:hidden;margin:0;color:#f1f9fc;font-size:14px;text-overflow:ellipsis;white-space:nowrap}.player-card-copy p{overflow:hidden;margin:5px 0 0;color:#8ea5b2;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.player-empty{padding:45px 15px;text-align:center;color:#9db2bd;border:1px dashed #34505e;border-radius:16px}.player-pagination{display:flex;justify-content:center;align-items:center;gap:17px;margin:28px 0 18px;color:#a8bdc7;font-size:13px}.player-pagination button{background:transparent;color:#cceefa}.player-pagination button:disabled{opacity:.4;cursor:not-allowed}.player-data-note{margin:20px auto 0;max-width:820px;text-align:center;color:#849aa6;font-size:11px;line-height:1.7}.player-data-note a{color:#77dfff}.player-detail-head{display:grid;grid-template-columns:minmax(210px,320px) 1fr;gap:30px;align-items:center;margin-bottom:30px;padding:28px;border:1px solid #24404e;border-radius:22px;background:radial-gradient(ellipse at 14% 15%,#51d1ff19,transparent 43%),linear-gradient(145deg,#11212b,#0a1218)}.player-detail-art{display:grid;place-items:center;position:relative;min-height:300px}.player-detail-art img{max-width:100%;height:300px;object-fit:contain;filter:drop-shadow(0 18px 25px #0009)}.player-detail-title .players-eyebrow{margin:0}.player-detail-title h1{margin:12px 0;font-size:clamp(32px,5vw,54px);letter-spacing:-.05em}.player-detail-title p{color:#a8bbc5;line-height:1.8}.player-info-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.player-info-pills span{padding:8px 11px;border:1px solid #2d4a59;border-radius:999px;background:#0a171f;color:#b9d9e5;font-size:11px}.player-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.player-panel{padding:21px;border:1px solid #223a47;border-radius:17px;background:#0e1920}.player-panel h2{margin:0 0 14px;font-size:17px}.player-stat-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.player-stat-item{display:flex;justify-content:space-between;gap:12px;padding:10px;border-radius:9px;background:#081117;color:#99aeba;font-size:12px}.player-stat-item b{color:#e3f5fa}.player-source{margin-top:12px;color:#8299a5;font-size:11px}.player-source a{color:#74dafa}.player-live-price{color:#fff0bb}.player-rank-list{display:flex;gap:7px;flex-wrap:wrap}.player-rank-list span{padding:7px 10px;border:1px solid #2a4553;border-radius:9px;color:#bdd4de;font-size:11px}.player-loading{color:#91a8b3}.player-abilities{display:flex;gap:10px;flex-wrap:wrap}.player-ability{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #28414e;border-radius:11px;color:#c9dce4;font-size:12px}.player-ability img{width:28px;height:28px;object-fit:contain}.player-related{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.player-back-link{display:inline-block;margin-bottom:19px;color:#75dafa;text-decoration:none;font-size:13px}.player-loading-card{height:280px;border-radius:16px;background:linear-gradient(100deg,#101d25,#172831,#101d25);background-size:200% 100%;animation:player-shimmer 1.5s infinite}@keyframes player-shimmer{to{background-position:-200% 0}}@media(max-width:1050px){.player-filters{grid-template-columns:repeat(4,minmax(0,1fr))}.player-search{grid-column:span 2}.player-grid,.player-related{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:700px){.players-page,.player-detail{width:min(100% - 24px,580px);padding:34px 0 65px}.player-filters{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px}.player-search{grid-column:span 2}.player-filter-submit{grid-column:span 2}.player-grid,.player-related{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.player-card-art{min-height:176px}.player-card-art img{height:160px}.player-detail-head{grid-template-columns:1fr;gap:6px;padding:18px}.player-detail-art{min-height:240px}.player-detail-art img{height:235px}.player-detail-grid{grid-template-columns:1fr}.player-results-head span{font-size:11px}.player-card-copy{padding:10px}.player-card-copy h2{font-size:12px}}
</style>

<script>
import { renderPlayerCard as card } from '../../lib/playerCard.js';
const grid = document.querySelector('#player-grid');
const form = document.querySelector('#player-filters');
const count = document.querySelector('#player-count');
const empty = document.querySelector('#player-empty');
const pageLabel = document.querySelector('#player-page-label');
const previous = document.querySelector('#player-prev');
const next = document.querySelector('#player-next');
const pageSize = 48;
let page = 0;
let latestRequest = 0;
const escapeHtml = (value = '') => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
async function loadPlayers() {
  const requestId = ++latestRequest;
  const params = new URLSearchParams({ limit: String(pageSize), offset: String(page * pageSize), sort: document.querySelector('#sort').value });
  const q = document.querySelector('#player-search').value.trim();
  const position = document.querySelector('#position').value;
  const event = document.querySelector('#event').value;
  const club = document.querySelector('#club').value;
  const league = document.querySelector('#league').value;
  const nation = document.querySelector('#nation').value;
  const min = document.querySelector('#min-ovr').value;
  const max = document.querySelector('#max-ovr').value;
  if (q) params.set('q', q);
  if (position) params.set('position', position);
  if (event) params.set('event', event);
  if (club) params.set('club', club);
  if (league) params.set('league', league);
  if (nation) params.set('nation', nation);
  if (min) params.set('minOvr', min);
  if (max) params.set('maxOvr', max);
  count.textContent = 'Loading players…';
  try {
    const response = await fetch(`/api/players?${params}`);
    const data = await response.json();
    if (requestId !== latestRequest) return;
    if (!response.ok) throw new Error(data.error || 'Unable to load the player database.');
    grid.innerHTML = data.players.map(card).join('');
    empty.hidden = data.players.length > 0;
    count.textContent = `${Number(data.total).toLocaleString()} players`;
    pageLabel.textContent = `Page ${page + 1}`;
    previous.disabled = page === 0;
    next.disabled = (page + 1) * pageSize >= data.total;
  } catch (error) {
    if (requestId !== latestRequest) return;
    grid.innerHTML = '';
    empty.hidden = false;
    empty.textContent = error.message;
    count.textContent = 'Player data unavailable';
  }
}
form.addEventListener('submit', (event) => { event.preventDefault(); page = 0; loadPlayers(); });
document.querySelector('#player-search').addEventListener('input', () => { clearTimeout(window.playerSearchTimer); window.playerSearchTimer = setTimeout(() => { page = 0; loadPlayers(); }, 250); });
previous.addEventListener('click', () => { if (page > 0) { page--; loadPlayers(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
next.addEventListener('click', () => { page++; loadPlayers(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
async function loadFilterOptions() {
  try {
    const response = await fetch('/api/players/filters');
    if (!response.ok) return;
    const data = await response.json();
    for (const [key, label] of [['club', 'All clubs'], ['league', 'All leagues'], ['nation', 'All nations']]) {
      const select = document.querySelector('#' + key);
      for (const value of data[key + 's'] || []) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.append(option);
      }
    }
  } catch { /* Facets can load later without blocking the player list. */ }
}
loadFilterOptions().finally(loadPlayers);
</script>
