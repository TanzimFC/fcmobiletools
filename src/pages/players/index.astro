---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="FC Mobile Players Database | FCMOBILETOOLS"
  description="Browse the FC Mobile player database by player, OVR, position and event, then open full stats, PlayStyles and progression details."
>
  <main class="players-page">
    <div class="players-shell">
      <header class="catalog-hero">
        <div class="hero-copy">
          <span class="kicker">FC MOBILE / PLAYER DATABASE</span>
          <h1>Find the <em>player.</em></h1>
          <p>Search the live catalog, compare OVR and open a complete player profile with attributes, PlayStyles, rank progression and training tools.</p>
        </div>
        <div class="hero-stat">
          <span>LIVE CATALOG</span>
          <strong>FC</strong>
          <b>PLAYER DATA</b>
        </div>
      </header>

      <section class="catalog-bar" aria-label="Player filters">
        <div class="search-box">
          <span>SEARCH</span>
          <input id="search" type="search" placeholder="Player name..." autocomplete="off" />
        </div>
        <label>
          <span>POSITION</span>
          <select id="position"><option value="">All positions</option></select>
        </label>
        <label>
          <span>EVENT</span>
          <select id="event"><option value="">All events</option></select>
        </label>
        <label>
          <span>SORT</span>
          <select id="sort">
            <option value="ovr-desc">Highest OVR</option>
            <option value="ovr-asc">Lowest OVR</option>
            <option value="name-asc">Name A-Z</option>
            <option value="name-desc">Name Z-A</option>
          </select>
        </label>
      </section>

      <div class="catalog-meta">
        <div id="status">Loading players…</div>
        <span>48 players / page</span>
      </div>

      <section id="grid" class="grid" aria-live="polite"></section>

      <nav class="pager" aria-label="Player pages">
        <button id="prev" type="button" disabled>Previous</button>
        <strong id="pageLabel">Page 1</strong>
        <button id="next" type="button" disabled>Next</button>
      </nav>
    </div>
  </main>

  <script>
    const PAGE_SIZE = 48;
    let page = 0;
    let timer;

    const $ = (id) => document.getElementById(id);
    const grid = $('grid');
    const status = $('status');
    const search = $('search');
    const position = $('position');
    const event = $('event');
    const sort = $('sort');
    const prev = $('prev');
    const next = $('next');
    const pageLabel = $('pageLabel');

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, (m) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
      }[m]));
    }

    function queryUrl() {
      const params = new URLSearchParams({
        limit: String(PAGE_SIZE),
        offset: String(page * PAGE_SIZE),
        sort: sort.value
      });
      if (search.value.trim()) params.set('q', search.value.trim());
      if (position.value) params.set('position', position.value);
      if (event.value) params.set('event', event.value);
      return '/api/players?' + params.toString();
    }

    function playerCard(player) {
      const bg = player.cardBackground
        ? '<img class="thumb-bg" src="' + esc(player.cardBackground) + '" alt="" loading="lazy" decoding="async">'
        : '';
      const render = player.playerImage
        ? '<img class="thumb-render" src="' + esc(player.playerImage) + '" alt="" loading="lazy" decoding="async">'
        : '<div class="thumb-fallback">' + esc((player.name || 'FC').slice(0, 2).toUpperCase()) + '</div>';
      const club = player.clubLogo
        ? '<img class="thumb-club" src="' + esc(player.clubLogo) + '" alt="" loading="lazy" decoding="async">'
        : '';

      return '<a class="player-card" href="/player/' + encodeURIComponent(player.slug) + '/">' +
        '<div class="thumb">' +
          bg +
          '<div class="thumb-shade"></div>' +
          render +
          '<div class="thumb-rating"><strong>' + esc(player.ovr ?? '—') + '</strong><span>' + esc(player.position || '—') + '</span></div>' +
          club +
          '<div class="thumb-bottom"><strong>' + esc(player.name) + '</strong><span>' + esc(player.event || 'FC Mobile') + '</span></div>' +
        '</div>' +
        '<div class="card-foot"><span>' + esc(player.nation || 'Nation not listed') + '</span><b>' + esc(player.position || '—') + '</b></div>' +
      '</a>';
    }

    async function getJson(url) {
      const response = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Player database request failed (' + response.status + ').');
      return response.json();
    }

    async function loadFilters() {
      try {
        const data = await getJson('/api/players/filters');
        for (const value of data.positions || []) {
          position.insertAdjacentHTML('beforeend', '<option value="' + esc(value) + '">' + esc(value) + '</option>');
        }
        for (const value of data.events || []) {
          event.insertAdjacentHTML('beforeend', '<option value="' + esc(value) + '">' + esc(value) + '</option>');
        }
      } catch (error) {
        console.warn('Player filters unavailable', error);
      }
    }

    async function load() {
      status.textContent = 'Loading players…';
      grid.innerHTML = '<div class="loading-state">Refreshing player catalog…</div>';

      try {
        const data = await getJson(queryUrl());
        const players = Array.isArray(data.players) ? data.players : [];
        const total = Number(data.pagination?.total || players.length);

        if (!players.length) {
          grid.innerHTML = '<div class="empty-state"><strong>No players found.</strong><span>Try a different name, position or event.</span></div>';
          status.textContent = 'No players match those filters.';
        } else {
          grid.innerHTML = players.map(playerCard).join('');
          const first = page * PAGE_SIZE + 1;
          const last = first + players.length - 1;
          status.textContent = 'Showing ' + first + '–' + last + ' of ' + total.toLocaleString() + ' players';
        }

        prev.disabled = page === 0;
        next.disabled = !data.pagination?.has_more;
        pageLabel.textContent = 'Page ' + (page + 1);
      } catch (error) {
        console.error(error);
        grid.innerHTML = '<div class="empty-state error"><strong>Player database unavailable.</strong><span>Please retry in a moment.</span></div>';
        status.textContent = 'Player database is temporarily unavailable.';
        prev.disabled = true;
        next.disabled = true;
      }
    }

    function reloadSoon() {
      clearTimeout(timer);
      timer = setTimeout(() => { page = 0; load(); }, 250);
    }

    search.addEventListener('input', reloadSoon);
    position.addEventListener('change', () => { page = 0; load(); });
    event.addEventListener('change', () => { page = 0; load(); });
    sort.addEventListener('change', () => { page = 0; load(); });
    prev.addEventListener('click', () => { if (page > 0) { page -= 1; load(); } });
    next.addEventListener('click', () => { if (!next.disabled) { page += 1; load(); } });

    loadFilters().finally(load);
  </script>

  <style>
    .players-page{
      --bg:#071018;--deep:#050c14;--surface:#0F1A26;--surface-2:#162536;
      --line:rgba(255,255,255,.08);--cyan:#4CC9FF;--cyan-2:#63D4FF;
      min-height:100vh;color:#F5F8FB;
      background:
        radial-gradient(920px 540px at 88% 2%,rgba(76,201,255,.10),transparent 62%),
        radial-gradient(760px 500px at 4% 24%,rgba(76,201,255,.045),transparent 65%),
        linear-gradient(180deg,var(--bg),var(--deep));
      padding-bottom:90px;
    }
    .players-shell{width:min(1220px,calc(100% - 34px));margin:0 auto}
    .catalog-hero{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:50px;align-items:center;padding:68px 0 44px}
    .kicker{display:inline-block;color:var(--cyan);font:800 9px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.16em}
    .hero-copy h1{margin:16px 0 16px;font:800 clamp(56px,8vw,92px)/.86 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.075em}
    .hero-copy h1 em{font-style:normal;color:var(--cyan)}
    .hero-copy p{max-width:700px;margin:0;color:#A7B4C3;font:500 14px/1.8 Inter,system-ui,sans-serif}
    .hero-stat{position:relative;min-height:210px;display:grid;place-items:center;align-content:center;border:1px solid rgba(76,201,255,.16);border-radius:27px;background:radial-gradient(circle at 50% 44%,rgba(76,201,255,.14),transparent 42%),linear-gradient(150deg,#10283A,#08141F);overflow:hidden;box-shadow:0 28px 80px rgba(0,0,0,.32)}
    .hero-stat::before{content:"";position:absolute;width:190px;height:190px;border:1px solid rgba(76,201,255,.10);border-radius:50%;box-shadow:0 0 0 27px rgba(76,201,255,.017)}
    .hero-stat span,.hero-stat b{position:relative;z-index:1;color:#6D93A7;font:800 7px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.16em}
    .hero-stat strong{position:relative;z-index:1;margin:10px 0 5px;color:var(--cyan);font:900 78px/.78 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.10em;text-shadow:0 0 30px rgba(76,201,255,.15)}
    .catalog-bar{display:grid;grid-template-columns:minmax(0,2fr) repeat(3,1fr);gap:9px;padding:14px;border:1px solid rgba(76,201,255,.12);border-radius:21px;background:rgba(10,24,36,.82);backdrop-filter:blur(12px);box-shadow:0 18px 50px rgba(0,0,0,.18)}
    .catalog-bar label,.search-box{min-width:0;display:grid;gap:7px;padding:11px 12px;border:1px solid var(--line);border-radius:15px;background:#0B1722}
    .catalog-bar span{color:#5F7C8F;font:800 7px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.13em}
    .catalog-bar input,.catalog-bar select{width:100%;min-width:0;height:42px;border:1px solid #203C4E;border-radius:11px;background:#07131E;color:#F5F8FB;padding:0 12px;outline:0;font:700 11px Inter,system-ui,sans-serif}
    .catalog-bar input:focus,.catalog-bar select:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(76,201,255,.08)}
    .catalog-meta{display:flex;justify-content:space-between;gap:12px;padding:17px 2px 13px;color:#8097A7;font:700 9px/1 Inter,system-ui,sans-serif}
    .catalog-meta>span{color:#516E80;text-transform:uppercase;letter-spacing:.12em}
    .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .player-card{display:block;min-width:0;overflow:hidden;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:20px;background:#0B1620;box-shadow:0 16px 38px rgba(0,0,0,.18);transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}
    .player-card:hover{transform:translateY(-4px);border-color:rgba(76,201,255,.30);box-shadow:0 25px 60px rgba(0,0,0,.30),0 0 35px rgba(76,201,255,.06)}
    .thumb{position:relative;aspect-ratio:5/6;overflow:hidden;background:linear-gradient(160deg,#142A3A,#07131D);isolation:isolate}
    .thumb-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-3}
    .thumb-shade{position:absolute;inset:0;background:radial-gradient(circle at 55% 38%,rgba(255,255,255,.06),transparent 38%),linear-gradient(180deg,rgba(0,0,0,.02) 20%,rgba(0,0,0,.56) 100%);z-index:-2}
    .thumb-render{position:absolute;left:20%;top:9%;width:78%;height:77%;object-fit:contain;object-position:center center;filter:drop-shadow(0 18px 22px rgba(0,0,0,.60));z-index:2}
    .thumb-fallback{position:absolute;inset:0;display:grid;place-items:center;color:rgba(191,242,255,.45);font:900 58px/1 "Space Grotesk",system-ui,sans-serif;z-index:1}
    .thumb-rating{position:absolute;left:8%;top:9%;z-index:4;display:grid;gap:4px}
    .thumb-rating strong{font:900 35px/.78 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.08em;color:#F7FCFF;text-shadow:0 3px 15px rgba(0,0,0,.45)}
    .thumb-rating span{color:#BCEFFF;font:900 8px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.18em}
    .thumb-club{position:absolute;right:8%;bottom:8%;z-index:5;width:29px;height:29px;padding:6px;object-fit:contain;border:1px solid rgba(255,255,255,.11);border-radius:9px;background:rgba(4,11,17,.28)}
    .thumb-bottom{position:absolute;left:8%;right:8%;bottom:7%;z-index:5;display:grid;gap:4px;padding-right:36px}
    .thumb-bottom strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#F7FCFF;font:900 16px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.02em;text-shadow:0 2px 13px rgba(0,0,0,.4)}
    .thumb-bottom span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:rgba(224,244,252,.68);font:700 8px/1 Inter,system-ui,sans-serif}
    .card-foot{display:flex;justify-content:space-between;gap:10px;padding:11px 13px 13px;border-top:1px solid var(--line);color:#6D8494;font-size:9px}
    .card-foot b{color:#B4D5E0}
    .pager{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:28px}
    .pager button{min-width:110px;height:42px;border:1px solid var(--line);border-radius:12px;background:#0F1A26;color:#D7E7EE;font:800 9px/1 "Space Grotesk",system-ui,sans-serif;cursor:pointer}
    .pager button:hover:not(:disabled){border-color:rgba(76,201,255,.28)}
    .pager button:disabled{opacity:.4;cursor:not-allowed}
    .pager strong{min-width:70px;text-align:center;color:#86A3B2;font:800 9px/1 "Space Grotesk",system-ui,sans-serif}
    .loading-state,.empty-state{grid-column:1/-1;min-height:220px;display:grid;place-items:center;align-content:center;gap:7px;border:1px dashed rgba(76,201,255,.14);border-radius:20px;background:rgba(76,201,255,.018);color:#6F8798;font-size:11px}
    .empty-state strong{color:#BBD6E1;font-size:15px}
    .empty-state.error{border-color:rgba(255,110,110,.16)}
    @media(max-width:1000px){.catalog-hero{grid-template-columns:1fr}.hero-stat{display:none}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.catalog-bar{grid-template-columns:2fr 1fr 1fr}}
    @media(max-width:720px){.players-shell{width:min(100% - 22px,1220px)}.catalog-hero{padding:45px 0 30px}.catalog-bar{grid-template-columns:1fr 1fr}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:480px){.catalog-bar{grid-template-columns:1fr}.catalog-meta{align-items:flex-start;flex-direction:column}.hero-copy h1{font-size:54px}.grid{gap:9px}.thumb-bottom strong{font-size:14px}.thumb-rating strong{font-size:30px}}
    @media(prefers-reduced-motion:reduce){.player-card{transition:none}}
  </style>
</BaseLayout>
