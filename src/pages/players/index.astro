---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FC Mobile Players | FCMobiletools</title>
    <meta name="description" content="Browse the FCMobiletools FC Mobile player database with OVR, positions, events, clubs and detailed player pages." />
  </head>
  <body>
    <main class="players-shell">
      <header class="hero">
        <p class="eyebrow">FC MOBILE DATABASE</p>
        <h1>Players</h1>
        <p class="sub">Search the live FC Mobile catalog by player, OVR, position or event.</p>
      </header>

      <section class="controls" aria-label="Player filters">
        <input id="search" type="search" placeholder="Search player name..." autocomplete="off" />
        <select id="position"><option value="">All positions</option></select>
        <select id="event"><option value="">All events</option></select>
        <select id="sort">
          <option value="ovr-desc">Highest OVR</option>
          <option value="ovr-asc">Lowest OVR</option>
          <option value="name-asc">Name A-Z</option>
          <option value="name-desc">Name Z-A</option>
        </select>
      </section>

      <div id="status" class="status">Loading players…</div>
      <section id="grid" class="grid" aria-live="polite"></section>

      <nav class="pager" aria-label="Player pages">
        <button id="prev" type="button" disabled>Previous</button>
        <span id="pageLabel">Page 1</span>
        <button id="next" type="button" disabled>Next</button>
      </nav>
    </main>

    <script>
      const PAGE_SIZE = 48;
      let page = 0;
      let timer;

      const $ = (id) => document.getElementById(id);
      const grid = $('grid');
      const status = $('status');
      const search = $('search');
      const position = $('position');
      const event = $('event');
      const sort = $('sort');
      const prev = $('prev');
      const next = $('next');
      const pageLabel = $('pageLabel');

      function esc(value) {
        return String(value ?? '').replace(/[&<>"']/g, (m) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        }[m]));
      }

      function queryUrl() {
        const params = new URLSearchParams({
          limit: String(PAGE_SIZE),
          offset: String(page * PAGE_SIZE),
          sort: sort.value
        });

        if (search.value.trim()) params.set('q', search.value.trim());
        if (position.value) params.set('position', position.value);
        if (event.value) params.set('event', event.value);

        return '/api/players?' + params.toString();
      }

      function playerCard(player) {
        const bg = player.cardBackground
          ? '<img class="thumb-bg" src="' + esc(player.cardBackground) + '" alt="" loading="lazy" decoding="async">'
          : '';
        const render = player.playerImage
          ? '<img class="thumb-render" src="' + esc(player.playerImage) + '" alt="" loading="lazy" decoding="async">'
          : '<div class="thumb-fallback">FC</div>';

        return '<a class="card" href="/player/' + encodeURIComponent(player.slug) + '/">' +
          '<div class="thumb">' + bg + render + '</div>' +
          '<div class="card-copy">' +
            '<div class="ovr">' + esc(player.ovr ?? '—') + '</div>' +
            '<div class="name">' + esc(player.name) + '</div>' +
            '<div class="meta">' + esc(player.position || '—') + ' · ' + esc(player.event || 'Unknown event') + '</div>' +
            '<div class="meta">' + esc(player.club || 'Unknown club') + ' · ' + esc(player.nation || 'Unknown nation') + '</div>' +
          '</div>' +
        '</a>';
      }

      async function getJson(url) {
        const response = await fetch(url, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Player database request failed (' + response.status + ').');
        return response.json();
      }

      async function loadFilters() {
        try {
          const data = await getJson('/api/players/filters');
          for (const value of data.positions || []) {
            position.insertAdjacentHTML('beforeend', '<option value="' + esc(value) + '">' + esc(value) + '</option>');
          }
          for (const value of data.events || []) {
            event.insertAdjacentHTML('beforeend', '<option value="' + esc(value) + '">' + esc(value) + '</option>');
          }
        } catch (error) {
          console.warn('Player filters unavailable', error);
        }
      }

      async function load() {
        status.textContent = 'Loading players…';
        grid.innerHTML = '';

        try {
          const data = await getJson(queryUrl());
          const players = Array.isArray(data.players) ? data.players : [];
          const total = Number(data.pagination?.total || players.length);

          if (!players.length) {
            status.textContent = 'No players match those filters.';
          } else {
            grid.innerHTML = players.map(playerCard).join('');
            const first = page * PAGE_SIZE + 1;
            const last = first + players.length - 1;
            status.textContent = 'Showing ' + first + '–' + last + ' of ' + total.toLocaleString() + ' players';
          }

          prev.disabled = page === 0;
          next.disabled = !data.pagination?.has_more;
          pageLabel.textContent = 'Page ' + (page + 1);
        } catch (error) {
          console.error(error);
          status.textContent = 'Player database is temporarily unavailable.';
          prev.disabled = true;
          next.disabled = true;
        }
      }

      function reloadSoon() {
        clearTimeout(timer);
        timer = setTimeout(() => {
          page = 0;
          load();
        }, 250);
      }

      search.addEventListener('input', reloadSoon);
      position.addEventListener('change', () => { page = 0; load(); });
      event.addEventListener('change', () => { page = 0; load(); });
      sort.addEventListener('change', () => { page = 0; load(); });
      prev.addEventListener('click', () => { if (page > 0) { page -= 1; load(); } });
      next.addEventListener('click', () => { page += 1; load(); });

      loadFilters().finally(load);
    </script>

    <style>
      :global(body) { margin:0; background:#071018; color:#F5F8FB; font-family:Inter,system-ui,sans-serif; }
      .players-shell { width:min(1180px,calc(100% - 32px)); margin:0 auto; padding:56px 0 80px; }
      .eyebrow { margin:0 0 8px; color:#4CC9FF; font-size:12px; font-weight:800; letter-spacing:.16em; }
      h1 { margin:0; font:700 clamp(38px,6vw,64px)/1 Space Grotesk,system-ui,sans-serif; letter-spacing:-.04em; }
      .sub { color:#A7B4C3; max-width:680px; line-height:1.6; }
      .controls { display:grid; grid-template-columns:2fr 1fr 1.3fr 1.2fr; gap:10px; margin:30px 0 18px; }
      input,select,button { width:100%; box-sizing:border-box; border:1px solid rgba(255,255,255,.08); background:#0F1A26; color:#F5F8FB; border-radius:12px; padding:13px 14px; font:inherit; }
      input:focus,select:focus { outline:none; border-color:#4CC9FF; box-shadow:0 0 0 3px rgba(76,201,255,.1); }
      .status { color:#A7B4C3; min-height:24px; margin-bottom:16px; }
      .grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
      .card { display:block; overflow:hidden; text-decoration:none; color:inherit; border:1px solid rgba(255,255,255,.08); background:#0F1A26; border-radius:18px; min-height:285px; transition:transform .16s ease,border-color .16s ease; }
      .card:hover { transform:translateY(-3px); border-color:#4CC9FF; }
      .thumb { position:relative; height:175px; overflow:hidden; background:linear-gradient(180deg,#142536,#09121B); }
      .thumb-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
      .thumb-render { position:absolute; inset:5px 12px 0; width:calc(100% - 24px); height:100%; object-fit:contain; object-position:center bottom; filter:drop-shadow(0 14px 18px rgba(0,0,0,.55)); }
      .thumb-fallback { height:100%; display:grid; place-items:center; color:#4CC9FF; font-weight:900; font-size:36px; letter-spacing:.08em; }
      .card-copy { padding:12px 14px 16px; }
      .ovr { color:#4CC9FF; font-size:25px; font-weight:900; }
      .name { margin-top:4px; font-size:18px; font-weight:800; }
      .meta { color:#A7B4C3; font-size:13px; margin-top:6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
      .pager { display:flex; align-items:center; justify-content:center; gap:18px; margin-top:28px; }
      .pager button { width:auto; min-width:110px; cursor:pointer; }
      .pager button:disabled { opacity:.45; cursor:not-allowed; }
      .pager button:not(:disabled):hover { border-color:#4CC9FF; }
      @media(max-width:900px){ .grid{grid-template-columns:repeat(3,minmax(0,1fr));}.controls{grid-template-columns:1fr 1fr;} }
      @media(max-width:620px){ .grid{grid-template-columns:repeat(2,minmax(0,1fr));}.controls{grid-template-columns:1fr;}.players-shell{width:min(100% - 20px,1180px);padding-top:32px;} }
    </style>
  </body>
</html>
