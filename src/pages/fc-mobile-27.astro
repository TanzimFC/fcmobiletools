---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FC_MOBILE_27 } from '../data/fcMobile27.js';

const current = FC_MOBILE_27.releases[0];
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev').href;
const siteUrl = new URL('/', Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev').href;
const pageTitle = 'FC Mobile 27 APK Download — September 24, 2026 Latest Version';
const pageDescription = 'Download the latest FC Mobile 27 APK for Android. Updated September 24, 2026 for Season 27 with the current download link, update details, changelog, installation guide and FAQ.';
const gameLogo = FC_MOBILE_27.logoUrl;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  datePublished: current.releaseDate,
  dateModified: FC_MOBILE_27.lastUpdated,
  inLanguage: 'en',
  isPartOf: { '@id': siteUrl + '#website' },
  about: { '@type': 'VideoGame', name: 'EA SPORTS FC Mobile 27' },
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
  mainEntity: { '@id': canonical + '#software' }
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': canonical + '#software',
  name: 'FC Mobile 27',
  alternateName: ['EA SPORTS FC Mobile 27', 'FC Mobile 27 APK', 'EA FC Mobile 27'],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Android',
  softwareVersion: current.version,
  releaseNotes: current.changelog.join('. ') + '.',
  dateModified: current.releaseDate,
  isAccessibleForFree: true,
  downloadUrl: current.downloadUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'FCMOBILETOOLS', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'FC Mobile 27 APK', item: canonical }
  ]
};

const faqItems = [
  {
    q: 'What is the latest FC Mobile 27 APK version?',
    a: 'This page currently lists FC Mobile 27 Season 27, updated September 24, 2026. The page uses the current release entry maintained in FCMOBILETOOLS release data.'
  },
  {
    q: 'When was FC Mobile 27 updated?',
    a: 'The Season 27 update is dated September 24, 2026. EA announced the new FC Mobile 27 season update for that date.'
  },
  {
    q: 'What is new in the FC Mobile 27 update?',
    a: 'EA has announced updated squads, new kits, gameplay innovations and a third-anniversary celebration for the new season. EA has also published deep dives covering Game Plans and Gauntlet Mode.'
  },
  {
    q: 'Can I download FC Mobile 27 APK on Android?',
    a: 'This page provides an external Android APK download link. The file is not hosted by FCMOBILETOOLS, so verify the source, file and permissions before installing.'
  },
  {
    q: 'Is FC Mobile 27 an official EA game?',
    a: 'EA SPORTS FC Mobile is an EA game. FCMOBILETOOLS is an independent fan-made website and is not operated by EA.'
  },
  {
    q: 'How do I install FC Mobile 27 APK?',
    a: 'Download the APK, allow your browser or file manager to install apps from that source when Android requests it, then open the downloaded file and follow the installation steps. Back up important game data before replacing an existing installation.'
  },
  {
    q: 'Will this FC Mobile 27 APK download link be updated?',
    a: 'Yes. New releases can be added through the FCMOBILETOOLS admin release manager, allowing the public download card and release history to use the newest entry.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={gameLogo} type="website">
<meta name="keywords" content="FC Mobile 27 APK, FC Mobile 27 download, FC Mobile 27 APK download, FC Mobile 27 latest version, FC Mobile 27 Android APK, FC Mobile 27 September 24 2026 update, FC Mobile 27 Season 27, FC Mobile 27 update, EA SPORTS FC Mobile 27 APK, FC Mobile 27 latest APK" />
