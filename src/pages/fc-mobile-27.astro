<script>
  const page = document.querySelector('[data-page]');
  const revealItems = document.querySelectorAll('.reveal');
  const copyButton = document.querySelector('[data-copy-url]');
  const copyStatus = document.querySelector('[data-copy-status]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  revealItems.forEach((item) => observer.observe(item));

  copyButton?.addEventListener('click', async () => {
    const url = copyButton.getAttribute('data-copy-url') || '';
    try {
      await navigator.clipboard.writeText(url);
      copyStatus.textContent = 'Download link copied';
      copyButton.classList.add('copied');
      setTimeout(() => {
        copyStatus.textContent = '';
        copyButton.classList.remove('copied');
      }, 2200);
    } catch {
      copyStatus.textContent = 'Copy is unavailable in this browser';
    }
  });

  let frame = 0;
  page?.addEventListener('pointermove', (event) => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      const x = (event.clientX / window.innerWidth - 0.5) * 2;
      const y = (event.clientY / window.innerHeight - 0.5) * 2;
      page.style.setProperty('--mx', x.toFixed(3));
      page.style.setProperty('--my', y.toFixed(3));
    });
  }, { passive: true });
</script>
</BaseLayout>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap');

.apk-page{
  --display:'Space Grotesk',system-ui,sans-serif;
  --body:'DM Sans',system-ui,sans-serif;
  --mono2:'Space Mono',ui-monospace,monospace;
  --mx:0;
  --my:0;
  position:relative;overflow:hidden;min-height:100vh;padding-bottom:80px;
  background:
    radial-gradient(800px 520px at calc(18% + var(--mx) * 2%) calc(8% + var(--my) * 2%),#55c7f215,transparent 62%),
    radial-gradient(900px 600px at calc(86% - var(--mx) * 2%) calc(18% - var(--my) * 2%),#48d98a0d,transparent 64%),
    var(--bg);
  color:var(--text);
  font-family:var(--body);
}
.apk-page *{box-sizing:border-box}
.apk-page a,.apk-page button{font-family:var(--body)}
.wrap{width:min(1140px,calc(100% - 32px));margin:auto;position:relative}
.ambient{position:absolute;border-radius:50%;filter:blur(70px);pointer-events:none;opacity:.48}
.ambient-one{width:280px;height:280px;left:-90px;top:360px;background:#55c7f21c}
.ambient-two{width:340px;height:340px;right:-130px;top:1080px;background:#48d98a12}
.scanline{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 0%,#ffffff021 50%,transparent 100%);background-size:100% 6px;opacity:.35}
.hero{padding:72px 0 52px;text-align:center}
.hero-copy{max-width:900px;margin:auto}
.eyebrow{display:inline-flex;gap:9px;align-items:center;padding:7px 11px;border:1px solid #284350;border-radius:999px;background:#07141bd8;color:#83b1c0;font:700 8px var(--mono2);letter-spacing:.12em;box-shadow:0 14px 50px #0004}
.live-dot{width:6px;height:6px;border-radius:50%;background:#61e4a0;box-shadow:0 0 0 5px #61e4a011,0 0 18px #61e4a0;animation:pulse 1.8s ease-in-out infinite}
.logo-orbit{position:relative;width:148px;height:148px;margin:28px auto 12px;display:grid;place-items:center}
.logo-glow{position:absolute;width:100px;height:100px;border-radius:50%;background:#55c7f23b;filter:blur(32px);animation:glowPulse 3.2s ease-in-out infinite}
.game-logo{position:relative;z-index:3;width:112px;height:112px;object-fit:contain;filter:drop-shadow(0 18px 40px #0009);animation:logoFloat 5s ease-in-out infinite}
.orbit{position:absolute;border:1px solid #55c7f229;border-radius:50%;transform:rotateX(68deg);animation:orbitSpin 10s linear infinite}
.orbit-one{inset:3px}.orbit-two{inset:18px;border-color:#48d98a1f;animation-duration:14s;animation-direction:reverse}
.release-line{display:flex;justify-content:center;align-items:center;gap:10px;color:#66818f;font:700 7px var(--mono2);letter-spacing:.12em}
.release-line strong{color:#82dfff}.release-line i{width:3px;height:3px;border-radius:50%;background:#405966}
.hero h1{font:700 clamp(44px,7vw,82px)/.9 var(--display);letter-spacing:-.065em;margin:18px 0 18px}
.hero h1 em{font-style:normal;color:var(--blue)}
.lead{max-width:760px;margin:0 auto;color:#93a8b4;font-size:13px;line-height:1.85}
.hero-actions{display:flex;justify-content:center;gap:9px;align-items:center;margin-top:28px;flex-wrap:wrap}
.download{display:flex;align-items:center;gap:11px;min-width:330px;padding:13px 14px 13px 12px;border:1px solid #5cccf1;border-radius:12px;background:linear-gradient(135deg,#55c7f2,#1e9dd1);color:#03131b;text-decoration:none;box-shadow:0 18px 55px #55c7f225;transition:.22s;position:relative;overflow:hidden}
.download:before{content:"";position:absolute;inset:-80% -40%;background:linear-gradient(115deg,transparent 35%,#fff8 50%,transparent 65%);transform:translateX(-65%) rotate(7deg);transition:.55s}
.download:hover:before{transform:translateX(65%) rotate(7deg)}
.download:hover{transform:translateY(-3px);box-shadow:0 25px 65px #55c7f23c}
.download-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:#03131b18;font:900 17px var(--mono2)}
.download>span:not(.download-icon){display:grid;text-align:left;gap:2px;flex:1;position:relative}
.download small{font:700 6px var(--mono2);letter-spacing:.1em;opacity:.66}.download strong{font:700 11px var(--display);letter-spacing:-.01em}.download>b{font:900 13px var(--mono2);position:relative}
.secondary-action{padding:12px 15px;border:1px solid #28424f;border-radius:11px;color:#94b6c4;text-decoration:none;font:700 8px var(--mono2);transition:.2s}
.secondary-action:hover{border-color:#55c7f2;color:#e6faff;transform:translateY(-2px)}
.micro-note{display:flex;justify-content:center;align-items:center;gap:6px;margin-top:13px;color:#5e7783;font:700 7px var(--mono2);letter-spacing:.04em}
.micro-note span{width:5px;height:5px;border-radius:50%;background:#708891}
.quick-facts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding-bottom:15px}
.quick-facts article{padding:14px;border:1px solid var(--border);border-radius:12px;background:#091218cc;box-shadow:0 16px 45px #0004;transition:.22s}
.quick-facts article:hover{transform:translateY(-4px);border-color:#315365}
.quick-facts span,.download-meta span,.feature-card small,.sources span{display:block;color:#5b7886;font:800 7px var(--mono2);letter-spacing:.11em}
.quick-facts strong{display:block;margin:5px 0 2px;font:700 12px var(--display);color:#eaf8fc}.quick-facts small{color:#748e9a;font-size:8px}
.section{padding:64px 0;border-top:1px solid #172a34}
.section-marker{color:var(--blue);font:800 7px var(--mono2);letter-spacing:.15em}
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin:10px 0 24px}
.kicker{color:#668493;font:800 7px var(--mono2);letter-spacing:.12em;margin:0 0 8px}
.section h2{font:700 clamp(30px,4.2vw,50px)/.96 var(--display);letter-spacing:-.055em;margin:0}
.heading-copy{max-width:420px;color:#8197a4;font-size:10px;line-height:1.75;margin:0}
.feature-layout{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}
.feature-card{grid-column:span 2;min-height:185px;padding:18px;border:1px solid var(--border);border-radius:14px;background:linear-gradient(145deg,#0b151b,#091116);position:relative;overflow:hidden;transition:.25s;transform-style:preserve-3d}
.feature-card.large{grid-column:span 2;min-height:215px;background:linear-gradient(145deg,#0b1e29,#081219);border-color:#29495a}
.feature-card:after{content:"";position:absolute;inset:auto -35px -60px;width:170px;height:170px;border-radius:50%;background:#55c7f211;filter:blur(30px)}
.feature-card:hover{transform:perspective(800px) translateY(-7px) rotateX(2deg) rotateY(calc(var(--mx) * 2deg));border-color:#34586b;box-shadow:0 24px 60px #0006}
.feature-number{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#55c7f20e;color:var(--blue);font:800 7px var(--mono2)}
