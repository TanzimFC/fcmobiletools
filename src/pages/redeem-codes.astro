.section-heading h2,.archive-heading h2,.content-grid h2,.seo-copy h2{margin:6px 0 5px;font:700 clamp(25px,3vw,34px)/1.1 var(--display);letter-spacing:-.045em}
.section-heading p,.archive-heading p,.info-card>p,.seo-copy p{margin:0;color:var(--muted);font-size:11px;line-height:1.75}
