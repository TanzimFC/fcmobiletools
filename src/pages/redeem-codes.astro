@media(max-width:480px){
  .hero{padding-top:34px}.hero-copy h1{font-size:42px}.hero-lede{font-size:13px}.hero-actions{flex-direction:column}.btn{width:100%}.hero-points{display:grid}.hero-points span{width:max-content}.hero-art{min-height:360px}.art-frame{padding:9px;border-radius:22px}.art-top{font-size:7px}.art-bottom{grid-template-columns:1fr 1fr 1fr}.art-bottom div{padding:7px}.art-bottom strong{font-size:10px}.stats-strip{grid-template-columns:1fr}.stats-strip article{padding:14px}.live-grid{grid-template-columns:1fr}.live-section,.archive,.info-card,.seo-copy{padding:18px;border-radius:18px}.live-card{min-height:245px}.archive-count,.archive-link{width:100%}.pagination{gap:12px}.pagination span{white-space:nowrap}
