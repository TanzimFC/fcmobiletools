.table-row{display:grid;grid-template-columns:1.25fr 1.5fr .8fr .8fr .85fr .5fr;gap:10px;align-items:center;min-height:63px;padding:10px 13px;border:1px solid #172832;border-radius:13px;background:#0a1116;color:#92a3ae;font:600 9px var(--mono)}.table-row:hover{border-color:#274352;background:#0c151b}
.table-code{display:flex;align-items:center;gap:8px;min-width:0}.table-code code{overflow:hidden;text-overflow:ellipsis;color:#e9f8fd;font:700 11px var(--mono)}.table-code button{padding:5px 6px;border:1px solid #223845;border-radius:7px;background:#0b151b;color:#83a0ad;font:700 7px var(--mono);cursor:pointer}.table-code button:hover{color:#d8f6ff;border-color:#3b7187}
.table-reward strong{display:block;color:#d4e1e7;font:700 9px var(--sans)}.table-reward span{display:block;margin-top:2px;color:#607887;font-size:8px}.row-open{color:var(--cyan);font:700 8px var(--mono);text-decoration:none}.row-open:hover{text-decoration:underline;text-underline-offset:3px}
.pagination{display:flex;justify-content:space-between;align-items:center;margin-top:17px}.pagination a{color:#93acb8;font:700 8px var(--mono);text-decoration:none}.pagination a:hover{color:#def8ff}.pagination a.disabled{pointer-events:none;opacity:.3}.pagination span{color:#5f7786;font:700 8px var(--mono)}

.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.info-card{padding:24px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,#0f171ddf,#0a1015dc);box-shadow:0 20px 55px #0005}.accent-card{background:linear-gradient(145deg,#0d1720,#0b1219 60%,#0f1d2a);border-color:#244659}
.steps{display:grid;gap:9px;margin-top:19px}.steps div{display:grid;grid-template-columns:42px 1fr;gap:10px;align-items:center;padding:10px 0;border-top:1px solid #1d2b34}.steps div:first-child{border-top:0;padding-top:0}.steps strong{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;border:1px solid #255066;background:#0b1a22;color:var(--cyan);font:700 8px var(--mono)}.steps p{margin:0;color:#9aabb5;font-size:10px;line-height:1.6}
.link-grid{display:grid;gap:8px;margin-top:18px}.link-grid a{padding:12px;border:1px solid #203847;border-radius:12px;background:#091319;text-decoration:none}.link-grid a:hover{border-color:#3d6e83;background:#0b1920}.link-grid b{display:block;color:#d9eef5;font-size:10px}.link-grid span{display:block;margin-top:3px;color:#68818e;font-size:8px}

.seo-copy{max-width:860px;margin:20px 0 0;padding:27px;border:1px solid #1a2932;border-radius:22px;background:linear-gradient(180deg,#0b1319cc,#080e13aa)}
.seo-copy h2{max-width:650px}.seo-copy p{max-width:760px;margin-top:11px}
.empty{grid-column:1/-1;padding:35px;text-align:center;border:1px dashed #2a3d48;border-radius:15px;background:#09111899}.empty strong{display:block;color:#d8eaf1;font:700 13px var(--display)}.empty span{display:block;margin-top:5px;color:#718692;font-size:10px}
.footer-line{display:flex;justify-content:space-between;gap:15px;margin-top:21px;color:#4f6572;font:700 7px var(--mono);letter-spacing:.12em}
.toast{position:fixed;left:50%;bottom:22px;z-index:100;transform:translate(-50%,20px);opacity:0;pointer-events:none;padding:10px 13px;border:1px solid #2d5669;border-radius:11px;background:#0b171ef2;color:#dff7ff;box-shadow:0 20px 50px #0008;font:700 8px var(--mono);transition:.2s ease}.toast.show{opacity:1;transform:translate(-50%,0)}

@keyframes spin{to{transform:rotate(360deg)}}

@media(max-width:1050px){
  .hero{grid-template-columns:1fr;min-height:auto;padding-top:50px}.hero-copy{max-width:820px}.hero-art{min-height:530px}.stats-strip{grid-template-columns:repeat(2,1fr)}.live-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:760px){
  .codes-wrap{width:calc(100% - 24px)}.hero-copy h1{font-size:48px}.hero-art{min-height:430px}.art-frame{width:94%}.orb-one{width:390px;height:390px}.orb-two{width:285px;height:285px}.badge-one{right:-3px}.badge-two{left:-4px}.stats-strip{grid-template-columns:1fr 1fr}.section-heading,.archive-heading{align-items:flex-start;flex-direction:column}.controls{align-items:stretch;flex-direction:column}.search{max-width:none}.filters{width:100%}.filters button{flex:1}.table-head{display:none}.table-row{grid-template-columns:1fr 1fr;gap:9px;padding:13px}.table-row>*:nth-child(2){grid-column:2}.table-row>*:nth-child(3),.table-row>*:nth-child(4){font-size:8px}.table-row>*:nth-child(5){justify-self:start}.table-row>*:nth-child(6){justify-self:end}.content-grid{grid-template-columns:1fr}.footer-line{flex-direction:column;gap:6px}
