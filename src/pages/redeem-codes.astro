---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REDEEM_CODES, REDEEM_STATUS } from '../data/redeemCodes.js';

const pageSize = 30;
const url = Astro.url;
const query = (url.searchParams.get('q') || '').trim();
const filter = ['all', 'active', 'expired', 'scheduled'].includes(url.searchParams.get('status')) ? url.searchParams.get('status') : 'all';
const matches = REDEEM_CODES.filter((item) => {
  const text = `${item.code} ${item.reward} ${item.region || ''} ${item.notes || ''}`.toLowerCase();
  return (!query || text.includes(query.toLowerCase())) && (filter === 'all' || item.status === filter);
});
const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
const requestedPage = Number(url.searchParams.get('page') || 1);
const currentPage = Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages);
const pageItems = matches.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const activeCodes = REDEEM_CODES.filter((item) => item.status === 'active');
const expiredCodes = REDEEM_CODES.filter((item) => item.status === 'expired');
const scheduledCodes = REDEEM_CODES.filter((item) => item.status === 'scheduled');
const lastUpdated = REDEEM_CODES.reduce((latest, item) => item.lastVerified > latest ? item.lastVerified : latest, '');
const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Unknown';
const statusInfo = (status) => REDEEM_STATUS[status] ?? REDEEM_STATUS.unknown;
const pageUrl = (page) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (filter !== 'all') params.set('status', filter);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return `/redeem-codes${qs ? `?${qs}` : ''}`;
};
const activeCodesJson = JSON.stringify(activeCodes.map((item) => item.code));
---
<BaseLayout title="FC Mobile Redeem Codes" description="Find, search, copy and redeem FC Mobile codes with a fast live archive.">
<section class="redeem-page">
  <div class="ambient ambient-a"></div><div class="ambient ambient-b"></div><div class="ambient ambient-c"></div>
  <div class="redeem-wrap">
    <header class="hero-shell">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> TANZIMFC CODE VAULT <span class="live-pill"><i></i> LIVE TRACKING</span></div>
        <h1>Codes worth <span>checking</span><br />rewards worth claiming</h1>
        <p class="hero-lede">A polished place to find the latest FC Mobile redeem codes, verify their status, copy them instantly, and jump straight into the official EA redemption flow.</p>
        <div class="hero-actions">
          <button class="hero-btn hero-btn-main" type="button" id="copyActive">Copy active codes <span>↗</span></button>
          <a class="hero-btn hero-btn-soft" href="https://redeem.fcm.ea.com/" target="_blank" rel="noopener noreferrer">Open EA redemption</a>
        </div>
        <div class="hero-metrics"><div><strong>{activeCodes.length}</strong><span>active now</span></div><div><strong>{REDEEM_CODES.length}</strong><span>codes tracked</span></div><div><strong>{scheduledCodes.length}</strong><span>scheduled</span></div></div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="hero-card-main">
          <div class="mini-top"><span>DROP STATUS</span><span class="mini-live"><i></i> ACTIVE</span></div>
          <div class="hero-symbol">FC</div><div class="hero-symbol-copy"><b>CODE VAULT</b><small>{activeCodes.length ? 'Live records ready' : 'No active codes right now'}</small></div>
          <div class="hero-scan"><span></span><span></span><span></span><span></span><span></span><span></span></div>
        </div>
        <div class="float-card float-one"><span>XP</span><b>+1K</b></div><div class="float-card float-two"><span>GEMS</span><b>FREE</b></div><div class="float-card float-three"><span>DROP</span><b>LIVE</b></div>
      </div>
    </header>

    <section class="feature-strip">
      <article class="feature-tile feature-violet"><span class="feature-no">01</span><div><b>Verified status</b><p>See what is active before you copy</p></div></article>
      <article class="feature-tile feature-lime"><span class="feature-no">02</span><div><b>One tap copy</b><p>Grab a code without touching the keyboard</p></div></article>
      <article class="feature-tile feature-coral"><span class="feature-no">03</span><div><b>Official route</b><p>Go directly to EA after copying</p></div></article>
      <article class="feature-tile feature-amber"><span class="feature-no">04</span><div><b>Search history</b><p>Keep expired records easy to find</p></div></article>
    </section>

    <section class="live-section" id="live">
      <div class="section-head"><div><div class="section-kicker">NOW ACTIVE</div><h2>Ready to redeem</h2><p>These records are currently marked active in the TanzimFC database</p></div><div class="verified-card"><span class="verified-dot"></span><div><b>Last verified</b><small>{fmtDate(lastUpdated)}</small></div></div></div>
      <div class="live-grid">
        {activeCodes.length ? activeCodes.map((item, index) => { const status = statusInfo(item.status); return <article class={`live-card ${index % 3 === 1 ? 'tone-purple' : index % 3 === 2 ? 'tone-orange' : ''}`}>
          <div class="live-card-glow"></div><div class="live-card-top"><span class="live-index">{String(index + 1).padStart(2, '0')}</span><span class={`status ${status.className}`}><i></i>{status.label}</span></div>
          <code>{item.code}</code><h3>{item.reward}</h3><p>Released {fmtDate(item.releaseDate)} <span>•</span> {item.region || 'Global'} <span>•</span> checked {fmtDate(item.lastVerified)}</p>
          <div class="live-card-actions"><button type="button" class="copy-btn" data-copy={item.code}>Copy code <b>⌘</b></button><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">Redeem <span>↗</span></a></div>
        </article>; }) : <div class="empty-state"><strong>No active codes right now</strong><span>Check the archive below for scheduled or historical records</span></div>}
      </div>
    </section>

    <section class="archive-shell" id="archive">
      <div class="archive-topline"><div><div class="section-kicker">THE ARCHIVE</div><h2>Every code in one place</h2><p>{matches.length} matching records · {pageSize} per page</p></div><div class="archive-count"><strong>{expiredCodes.length}</strong><span>historical codes kept searchable</span></div></div>
      <form class="control-bar" method="get" action="/redeem-codes">
        <label class="search-box"><span>⌕</span><input name="q" value={query} placeholder="Search code, reward, region or note" autocomplete="off" /></label>
        <div class="filter-group">{[['all','All'],['active','Active'],['scheduled','Scheduled'],['expired','Expired']].map(([value,label]) => <button class:chosen={filter === value} name="status" value={value} type="submit">{label}</button>)}</div>
      </form>
      <div class="archive-table">
        <div class="table-head"><span>CODE</span><span>REWARD</span><span>RELEASED</span><span>UPDATED</span><span>STATUS</span><span></span></div>
        {pageItems.length ? pageItems.map((item) => { const status = statusInfo(item.status); return <article class="table-row">
          <div class="table-code"><code>{item.code}</code><button type="button" data-copy={item.code} aria-label={`Copy ${item.code}`}>Copy</button></div>
          <div class="table-reward"><strong>{item.reward}</strong><span>{item.region || 'Global'}</span></div><div>{fmtDate(item.releaseDate)}</div><div>{fmtDate(item.lastVerified)}</div>
          <div><span class={`status ${status.className}`}><i></i>{status.label}</span></div><div><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">Open ↗</a></div>
        </article>; }) : <div class="empty-state"><strong>No codes match this view</strong><span>Try a different search or status filter</span></div>}
      </div>
      <div class="pagination"><a class:disabled={currentPage===1} href={currentPage>1?pageUrl(currentPage-1):'#'}>← Previous</a><span>{String(currentPage).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}</span><a class:disabled={currentPage===totalPages} href={currentPage<totalPages?pageUrl(currentPage+1):'#'}>Next →</a></div>
    </section>

    <section class="bottom-grid">
      <article class="local-card"><div class="card-kicker">LOCAL MEMORY</div><h2>Recently copied</h2><p>Your browser can keep a tiny local list of the last codes you copied</p><div class="recent-list" id="recentList"><span class="recent-empty">Nothing copied yet</span></div></article>
      <article class="how-card"><div class="how-icon">✦</div><div><div class="card-kicker">HOW IT WORKS</div><h2>Copy → open EA → redeem</h2><p>Use a live code, sign in on the official EA destination, paste the code, and submit it there</p><a href="https://redeem.fcm.ea.com/" target="_blank" rel="noopener noreferrer">Open official redemption <span>↗</span></a></div></article>
    </section>
    <footer class="page-foot"><span>TANZIMFC / FC MOBILE TOOLS</span><span>DATA IS BASED ON THE CURRENT CODE DATABASE</span><span>{fmtDate(lastUpdated)}</span></footer>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</section>
<script define:vars={{ activeCodesJson }}>
const activeCodes = JSON.parse(activeCodesJson);
const toast = document.getElementById('toast');
const recentList = document.getElementById('recentList');
const recentKey = 'tanzimfc-redeem-recent-v2';
const showToast = (message, tone = 'ok') => { toast.textContent = message; toast.dataset.tone = tone; toast.classList.add('show'); window.clearTimeout(window.__redeemToast); window.__redeemToast = window.setTimeout(() => toast.classList.remove('show'), 2200); };
const readRecent = () => { try { return JSON.parse(localStorage.getItem(recentKey) || '[]').slice(0, 5); } catch { return []; } };
const renderRecent = () => { const items = readRecent(); recentList.innerHTML = items.length ? items.map(code => `<button type="button" data-recent="${code}">${code}<span>↗</span></button>`).join('') : '<span class="recent-empty">Nothing copied yet</span>'; recentList.querySelectorAll('[data-recent]').forEach(btn => btn.addEventListener('click', () => copyCode(btn.dataset.recent))); };
const saveRecent = code => { const items = [code, ...readRecent().filter(item => item !== code)].slice(0, 5); try { localStorage.setItem(recentKey, JSON.stringify(items)); } catch {} renderRecent(); };
const copyCode = async code => { try { await navigator.clipboard.writeText(code); saveRecent(code); showToast(`${code} copied to clipboard`); } catch { showToast('Clipboard access is unavailable', 'bad'); } };
document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', () => copyCode(button.dataset.copy)));
document.getElementById('copyActive')?.addEventListener('click', () => activeCodes.length ? copyCode(activeCodes.join('\n')) : showToast('No active codes to copy', 'bad'));
renderRecent();
</script>
</BaseLayout>

