.feature-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0 0 22px}.feature-tile{min-height:96px;padding:17px;border:1px solid var(--line);border-radius:17px;background:#0e1215;display:flex;gap:12px;align-items:flex-start;position:relative;overflow:hidden}.feature-tile:after{content:"";position:absolute;width:90px;height:90px;border-radius:50%;right:-35px;top:-40px;filter:blur(22px);opacity:.16;background:currentColor}.feature-no{font:700 9px var(--mono);color:currentColor}.feature-tile b{font:700 12px var(--display)}.feature-tile p{margin:4px 0 0;color:#77807c;font-size:9px;line-height:1.6}.feature-violet{color:var(--lav)}.feature-lime{color:var(--lime)}.feature-coral{color:var(--coral)}.feature-amber{color:var(--amber)}
