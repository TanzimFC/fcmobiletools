---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { redeemFaq, EA_REDEEM_URL, redeemJsonLd, safeScriptJson } from '../lib/redeem.js';
import { getLocaleFromPath, localizeHref, namespace, translator } from '../i18n/index.js';
import { pushIcon } from '../lib/pushIcons.js';

// One page component serves English at /redeem-codes/ and the translated copies under /bn/, /pt-br/, /id/.
const locale = getLocaleFromPath(Astro.url.pathname);
const tr = translator(locale);
const T = namespace(locale, 'redeem');
const faq = redeemFaq(locale);
const P = namespace(locale, 'push');
const R = P.redeemCard;
const href = (h) => localizeHref(h, locale);

const origin = (Astro.site ?? new URL('https://fcmobiletools.online')).origin;
const socialImage = 'https://res.cloudinary.com/b0qikv7n/image/upload/f_auto,q_auto,w_1200/v1789655014/fc-mobile-tools/clmgprc6viqdrp4zhdfj.png';

// The deployed Worker injects live data into #rx-bootstrap and #rx-ld on every
// request. These build-time values are what you see in `astro dev`.
const structuredData = safeScriptJson(redeemJsonLd([], origin, undefined, locale));
const devFallback = import.meta.env.DEV
  ? safeScriptJson({ codes: REDEEM_CODES, serverDate: new Date().toISOString().slice(0, 10), updatedAt: null })
  : null;

const steps = T.how.steps.map((step, i) => ({ n: String(i + 1).padStart(2, '0'), t: step.t, d: step.d }));

const toolLinks = ['/events/', '/team-ovr/', '/rank-up-calculator/', '/football-centre/'];
const tools = T.how.tools.map((tool, i) => ({ t: tool.t, d: tool.d, h: href(toolLinks[i]) }));
---
<BaseLayout
  title={T.meta.title}
  description={T.meta.description}
  image={socialImage}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&display=swap" />

  <main class="rx" data-rx>
    <div class="rx-bg" aria-hidden="true"><i class="rx-orb rx-orb-a"></i><i class="rx-orb rx-orb-b"></i><i class="rx-gridlines"></i></div>

    <div class="rx-wrap">
      <!-- ───────────── Hero ───────────── -->
      <header class="rx-hero">
        <div class="rx-hero-copy">
          <p class="rx-eyebrow">
            <span class="rx-sync" data-rx-sync-dot data-state="live"><i></i></span>
            <span data-rx-sync-text>{T.hero.connecting}</span>
          </p>
          <h1 class="rx-h1">{T.hero.titleLead} <span class="rx-grad">{T.hero.titleGrad}</span></h1>
          <p class="rx-lede">{T.hero.lede}</p>

          <div class="rx-cta">
            <a class="rx-btn rx-btn-primary rx-btn-lg" href="#codes"><span>{T.hero.ctaLive}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
            <a class="rx-btn rx-btn-ghost rx-btn-lg" href={EA_REDEEM_URL} target="_blank" rel="noopener noreferrer"><span>{T.hero.ctaEa}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
          </div>


          <section class="rx-alert" data-rx-alert data-state="off" aria-labelledby="rx-alert-h">
            <div class="rx-alert-bell" aria-hidden="true"><span set:html={pushIcon('bell', 24, 2)}></span><i></i></div>
            <div class="rx-alert-copy">
              <p class="rx-alert-kicker">{R.kicker}</p>
              <h2 id="rx-alert-h" class="rx-alert-title">{R.title}</h2>
              <p class="rx-alert-body" data-rx-alert-body>{R.body}</p>
              <ul class="rx-alert-facts" data-rx-alert-facts></ul>
            </div>
            <div class="rx-alert-action">
              <label class="rx-alert-toggle">
                <input type="checkbox" data-rx-alert-toggle />
                <span class="rx-alert-switch" aria-hidden="true"></span>
                <span class="rx-alert-toggle-text" data-rx-alert-label>{R.toggle}</span>
              </label>
              <button type="button" class="rx-btn rx-btn-primary rx-alert-cta" data-rx-alert-cta><span>{R.turnOn}</span></button>
              <p class="rx-alert-status" data-rx-alert-status role="status" aria-live="polite"></p>
              <button type="button" class="rx-alert-manage" data-rx-alert-manage hidden>{R.manage}</button>
            </div>
          </section>

          <dl class="rx-stats">
            <div><dt>{T.hero.statActive}</dt><dd data-rx-stat="active">–</dd></div>
            <div><dt>{T.hero.statUpcoming}</dt><dd data-rx-stat="upcoming">–</dd></div>
            <div><dt>{T.hero.statTotal}</dt><dd data-rx-stat="total">–</dd></div>
          </dl>
        </div>

        <div class="rx-stage" data-rx-stage>
          <i class="rx-halo" aria-hidden="true"></i>
          <div class="rx-ticket" data-rx-ticket data-state="loading">
            <div class="rx-skel rx-skel-line" style="width:46%"></div>
            <div class="rx-skel rx-skel-code"></div>
            <div class="rx-skel rx-skel-line" style="width:70%"></div>
          </div>
        </div>
      </header>

      <!-- ───────────── Live codes ───────────── -->
      <section class="rx-section" id="codes" aria-labelledby="rx-live-h">
        <div class="rx-sec-head">
          <div>
            <p class="rx-kicker">{T.live.kicker}</p>
            <h2 id="rx-live-h" class="rx-h2">{T.live.title}</h2>
            <p class="rx-sub">{T.live.sub}</p>
          </div>
          <span class="rx-count-pill" data-rx-active-count>{T.live.activePill.replace('{n}', '–')}</span>
        </div>
        <div class="rx-strip" data-rx-strip hidden></div>
        <div class="rx-cards" data-rx-active aria-live="polite">
          <div class="rx-card rx-card-skel"><div class="rx-skel rx-skel-line" style="width:40%"></div><div class="rx-skel rx-skel-code"></div><div class="rx-skel rx-skel-line" style="width:75%"></div><div class="rx-skel rx-skel-btn"></div></div>
          <div class="rx-card rx-card-skel"><div class="rx-skel rx-skel-line" style="width:40%"></div><div class="rx-skel rx-skel-code"></div><div class="rx-skel rx-skel-line" style="width:75%"></div><div class="rx-skel rx-skel-btn"></div></div>
          <div class="rx-card rx-card-skel"><div class="rx-skel rx-skel-line" style="width:40%"></div><div class="rx-skel rx-skel-code"></div><div class="rx-skel rx-skel-line" style="width:75%"></div><div class="rx-skel rx-skel-btn"></div></div>
        </div>
        <noscript><p class="rx-noscript">{T.live.noscriptPre}<a href={EA_REDEEM_URL}>{T.live.noscriptLink}</a>{T.live.noscriptPost}</p></noscript>
      </section>

      <section class="rx-section rx-upcoming" data-rx-upcoming hidden aria-labelledby="rx-soon-h">
        <div class="rx-sec-head">
          <div>
            <p class="rx-kicker">{T.soon.kicker}</p>
            <h2 id="rx-soon-h" class="rx-h2">{T.soon.title}</h2>
            <p class="rx-sub">{T.soon.sub}</p>
          </div>
        </div>
        <div class="rx-soon-list" data-rx-upcoming-list></div>
      </section>

      <!-- ───────────── Archive ───────────── -->
      <section class="rx-section" id="archive" aria-labelledby="rx-arch-h">
        <div class="rx-sec-head">
          <div>
            <p class="rx-kicker">{T.archive.kicker}</p>
            <h2 id="rx-arch-h" class="rx-h2">{T.archive.title}</h2>
            <p class="rx-sub">{T.archive.sub}</p>
          </div>
        </div>

        <div class="rx-controls">
          <label class="rx-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" data-rx-search placeholder={T.archive.searchPlaceholder} autocomplete="off" spellcheck="false" aria-label={T.archive.searchAria} />
            <button type="button" class="rx-clear" data-rx-clear hidden aria-label={T.archive.clearAria}>×</button>
          </label>
          <div class="rx-tabs" role="tablist" aria-label={T.archive.statusAria} data-rx-status></div>
          <label class="rx-sort">
            <span class="rx-vh">{T.archive.sortLabel}</span>
            <select data-rx-sort aria-label={T.archive.sortAria}>
              <option value="new">{T.archive.sortNew}</option>
              <option value="old">{T.archive.sortOld}</option>
              <option value="az">{T.archive.sortAz}</option>
            </select>
          </label>
        </div>
        <div class="rx-types" data-rx-types aria-label={T.archive.typesAria}></div>

        <div class="rx-table" data-rx-list></div>
        <div class="rx-more">
          <span class="rx-count" data-rx-count></span>
          <button type="button" class="rx-btn rx-btn-soft" data-rx-more hidden><span>{T.archive.showMoreInitial}</span></button>
        </div>
      </section>

      <!-- ───────────── How it works ───────────── -->
      <section class="rx-section" id="how" aria-labelledby="rx-how-h">
        <div class="rx-sec-head">
          <div>
            <p class="rx-kicker">{T.how.kicker}</p>
            <h2 id="rx-how-h" class="rx-h2">{T.how.title}</h2>
          </div>
        </div>
        <ol class="rx-steps">
          {steps.map((s) => (
            <li class="rx-step"><span class="rx-step-n">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>

        <div class="rx-two">
          <div class="rx-panel">
            <p class="rx-kicker">{T.how.troubleKicker}</p>
            <ul class="rx-checks">
              {T.how.checks.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="rx-panel">
            <p class="rx-kicker">{T.how.toolsKicker}</p>
            <div class="rx-tools">
              {tools.map((t) => (
                <a href={t.h} class="rx-tool"><b>{t.t}</b><span>{t.d}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ───────────── FAQ ───────────── -->
      <section class="rx-section" aria-labelledby="rx-faq-h">
        <div class="rx-sec-head">
          <div>
            <p class="rx-kicker">{T.faq.kicker}</p>
            <h2 id="rx-faq-h" class="rx-h2">{T.faq.title}</h2>
          </div>
        </div>
        <div class="rx-faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="rx-about">
        <h2 class="rx-h3">{T.about.title}</h2>
        <p>{T.about.p1}</p>
        <p>{T.about.p2}</p>
      </section>
    </div>


    <button type="button" class="rx-alert-sticky" data-rx-alert-sticky hidden aria-label={R.stickyCta}>
      <span set:html={pushIcon('bell', 18, 2)}></span><b>{R.stickyCta}</b>
    </button>
    <div class="rx-toast" data-rx-toast role="status" aria-live="polite"></div>
  </main>

  <script type="application/ld+json" id="rx-ld" is:inline set:html={structuredData}></script>
  <script type="application/json" id="rx-i18n" is:inline set:html={safeScriptJson({ locale: tr.locale, htmlLang: locale, activePill: T.live.activePill, activePillOne: T.live.activePillOne, ui: T.ui })}></script>
  <script type="application/json" id="rx-alert-i18n" is:inline set:html={safeScriptJson({ card: R, states: P.states, panel: P.panel })}></script>
  <script type="application/json" id="rx-bootstrap" is:inline>null</script>
  {devFallback && <script type="application/json" id="rx-fallback" is:inline set:html={devFallback}></script>}
  <script>import '../scripts/redeem-page.js';</script>
  <script>import '../scripts/push-redeem.js';</script>
</BaseLayout>

<style is:global>
/* Translated headings can be longer than the English one, so allow them to wrap. */
html:not([lang="en"]) .rx-grad{ white-space:normal; }
/* ============================================================
   Redeem codes — one stylesheet, built on the site's tokens.
   Everything is prefixed .rx so nothing leaks into other pages.
   ============================================================ */
.rx{
  --rx-ink:#F5F8FB; --rx-ink-2:#B7C4D1; --rx-ink-3:#7E92A5;
  --rx-line:rgba(255,255,255,.08); --rx-line-2:rgba(255,255,255,.15);
  --rx-glass:linear-gradient(155deg,rgba(24,40,58,.74),rgba(12,22,33,.82));
  --rx-cyan:#4CC9FF; --rx-cyan-2:#9CE4FF; --rx-green:#47D16C; --rx-amber:#FFBD59; --rx-red:#FF7A7A; --rx-violet:#8C9BFF;
  --rx-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  position:relative; isolation:isolate; overflow:clip;
  color:var(--rx-ink); font-family:var(--font-body,'Instrument Sans Variable',system-ui,sans-serif);
  padding:0 0 calc(72px + env(safe-area-inset-bottom,0));
}
@media(max-width:980px){ .rx{ padding-bottom:calc(120px + env(safe-area-inset-bottom,0)); } }
.rx *,.rx *::before,.rx *::after{ box-sizing:border-box; }
.rx button{ font-family:inherit; cursor:pointer; }
.rx :focus-visible{ outline:2px solid var(--rx-cyan); outline-offset:3px; border-radius:var(--r-md); }
.rx-vh{ position:absolute!important; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
.rx-wrap{ width:min(1180px,calc(100% - 32px)); margin-inline:auto; }


/* ── redeem alert card: the one place codes are discussed, so it is the loudest ask on the page ── */
.rx-alert{ position:relative; display:grid; grid-template-columns:auto minmax(0,1fr); gap:6px 16px; margin:26px 0 0; padding:18px; border:1px solid rgba(76,201,255,.34); border-radius:var(--r-lg); background:linear-gradient(140deg,rgba(76,201,255,.14),rgba(14,26,38,.86) 55%); box-shadow:0 18px 50px -20px rgba(76,201,255,.55); overflow:hidden; max-width:560px; }
.rx-alert::before{ content:""; position:absolute; inset:0; border-radius:inherit; padding:1px; background:linear-gradient(120deg,rgba(143,227,255,.9),transparent 35%,transparent 65%,rgba(140,155,255,.7)); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.55; pointer-events:none; animation:rx-alert-glow 4.5s ease-in-out infinite; }
@keyframes rx-alert-glow{ 0%,100%{opacity:.35} 50%{opacity:.85} }
.rx-alert-bell{ position:relative; display:grid; place-items:center; width:52px; height:52px; border-radius:var(--r-lg); color:#06202c; background:linear-gradient(135deg,#a3eaff,#4cc9ff); box-shadow:0 10px 26px -6px rgba(76,201,255,.8); }
.rx-alert-bell span{ display:grid; transform-origin:50% 6px; animation:rx-bell-ring 3.4s ease-in-out infinite; }
.rx-alert-bell i{ position:absolute; top:-3px; right:-3px; width:14px; height:14px; border-radius:50%; background:#ff6b6b; border:2px solid #0d1a25; animation:rx-bell-ping 2.2s ease-out infinite; }
.rx-alert[data-state="on"] .rx-alert-bell i{ background:#47d16c; animation:none; }
@keyframes rx-bell-ring{ 0%,62%,100%{transform:rotate(0)} 67%{transform:rotate(15deg)} 73%{transform:rotate(-13deg)} 79%{transform:rotate(9deg)} 85%{transform:rotate(-5deg)} 91%{transform:rotate(0)} }
@keyframes rx-bell-ping{ 0%{box-shadow:0 0 0 0 rgba(255,107,107,.7)} 70%,100%{box-shadow:0 0 0 10px rgba(255,107,107,0)} }
.rx-alert-copy{ min-width:0; }
.rx-alert-kicker{ margin:0; color:var(--rx-cyan-2); font:800 11px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.14em; text-transform:uppercase; }
.rx-alert-title{ margin:6px 0 0; font:700 21px/1.15 var(--font-display,'Archivo Variable',sans-serif); letter-spacing:-.025em; }
.rx-alert-body{ margin:8px 0 0; color:var(--rx-ink-2); font-size:14px; line-height:1.55; }
.rx-alert-facts{ display:flex; flex-wrap:wrap; gap:6px; margin:11px 0 0; padding:0; list-style:none; }
.rx-alert-facts li{ padding:5px 10px; border:1px solid var(--rx-line-2); border-radius:99px; background:rgba(255,255,255,.04); color:var(--rx-ink-2); font:700 11.5px/1.2 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-alert-action{ grid-column:1 / -1; display:grid; gap:10px; margin-top:8px; padding-top:14px; border-top:1px solid var(--rx-line); }
.rx-alert-toggle{ display:flex; align-items:center; gap:12px; cursor:pointer; font:700 14px/1.2 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-alert-toggle input{ position:absolute; width:1px; height:1px; opacity:0; }
.rx-alert-switch{ position:relative; flex:0 0 52px; width:52px; height:30px; border:1px solid rgba(255,255,255,.18); border-radius:99px; background:#1a2a39; transition:background .2s,border-color .2s; }
.rx-alert-switch::after{ content:""; position:absolute; left:3px; top:3px; width:22px; height:22px; border-radius:50%; background:#8394a4; transition:transform .22s,background .2s; }
.rx-alert-toggle input:checked~.rx-alert-switch{ border-color:rgba(71,209,108,.6); background:rgba(71,209,108,.28); }
.rx-alert-toggle input:checked~.rx-alert-switch::after{ transform:translateX(22px); background:#6fe892; }
.rx-alert-toggle input:focus-visible~.rx-alert-switch{ outline:2px solid var(--rx-cyan); outline-offset:3px; }
.rx-alert-toggle input:disabled~.rx-alert-switch{ opacity:.55; }
.rx-alert-cta{ width:100%; }
.rx-alert[data-state="on"] .rx-alert-cta{ display:none; }
.rx-alert[data-state="blocked"] .rx-alert-toggle{ display:none; }
.rx-alert-status{ margin:0; min-height:0; color:var(--rx-ink-3); font-size:12.5px; line-height:1.5; }
.rx-alert-status:empty{ display:none; }
.rx-alert-status[data-tone="good"]{ color:#8ce9a8; }
.rx-alert-status[data-tone="bad"]{ color:#ffb0a8; }
.rx-alert-manage{ justify-self:start; padding:2px 0; border:0; background:none; color:#8fb7cc; font:700 12px/1.2 var(--font-body,'Instrument Sans Variable',sans-serif); cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
.rx-alert-manage[hidden]{ display:none; }
.rx-alert-sticky{ position:fixed; z-index:1200; right:14px; bottom:calc(92px + env(safe-area-inset-bottom,0px)); display:none; align-items:center; gap:9px; min-height:46px; padding:0 18px 0 14px; border:1px solid rgba(143,227,255,.5); border-radius:99px; color:#04121b; background:linear-gradient(135deg,#a3eaff,#4cc9ff); box-shadow:0 14px 34px -8px rgba(76,201,255,.85); font:800 13px/1 var(--font-body,'Instrument Sans Variable',sans-serif); cursor:pointer; animation:rx-sticky-in .35s ease both; }
.rx-alert-sticky.is-on{ display:inline-flex; }
@keyframes rx-sticky-in{ from{ opacity:0; transform:translateY(12px) } to{ opacity:1; transform:none } }
@media(min-width:981px){ .rx-alert-sticky{ bottom:24px; } .rx-alert{ max-width:none; } }
@media(prefers-reduced-motion:reduce){ .rx-alert::before,.rx-alert-bell span,.rx-alert-bell i,.rx-alert-sticky{ animation:none!important; } }

/* ── ambient background ── */
.rx-bg{ position:absolute; inset:0; z-index:-1; pointer-events:none; overflow:hidden; }
.rx-orb{ position:absolute; border-radius:50%; filter:blur(90px); opacity:.5; }
.rx-orb-a{ width:620px; height:620px; top:-180px; right:-160px; background:radial-gradient(circle,rgba(76,201,255,.42),transparent 68%); }
.rx-orb-b{ width:560px; height:560px; top:520px; left:-240px; background:radial-gradient(circle,rgba(140,155,255,.26),transparent 68%); }
.rx-gridlines{ position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px); background-size:56px 56px; -webkit-mask-image:linear-gradient(180deg,#000 0,transparent 62%); mask-image:linear-gradient(180deg,#000 0,transparent 62%); }

/* ── type ── */
.rx-h1{ margin:0; font:700 clamp(38px,5.6vw,70px)/1 var(--font-display,'Archivo Variable',sans-serif); letter-spacing:-.05em; text-wrap:balance; }
.rx-grad{ white-space:nowrap; background:linear-gradient(100deg,#fff 0%,var(--rx-cyan-2) 38%,var(--rx-cyan) 62%,var(--rx-violet) 100%); -webkit-background-clip:text; background-clip:text; color:transparent; }
.rx-h2{ margin:4px 0 0; font:700 clamp(26px,3.4vw,38px)/1.1 var(--font-display,'Archivo Variable',sans-serif); letter-spacing:-.035em; }
.rx-h3{ margin:0 0 10px; font:700 20px/1.2 var(--font-display,'Archivo Variable',sans-serif); letter-spacing:-.02em; }
.rx-lede{ margin:20px 0 0; max-width:520px; color:var(--rx-ink-2); font-size:clamp(16px,1.5vw,18px); line-height:1.65; }
.rx-kicker{ margin:0; color:var(--rx-cyan); font:700 12px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.14em; text-transform:uppercase; }
.rx-sub{ margin:10px 0 0; color:var(--rx-ink-3); font-size:15px; line-height:1.6; max-width:560px; }

/* ── buttons ── */
.rx-btn{ display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:44px; padding:0 18px; border:1px solid transparent; border-radius:var(--r-md); font:700 14px/1 var(--font-body,'Instrument Sans Variable',sans-serif); text-decoration:none; white-space:nowrap; transition:transform .18s ease,box-shadow .2s ease,background .2s ease,border-color .2s ease,color .2s ease; -webkit-tap-highlight-color:transparent; }
.rx-btn:active{ transform:scale(.97); }
.rx-btn-lg{ min-height:52px; padding:0 24px; font-size:15px; border-radius:var(--r-md); }
.rx-btn-primary{ color:#04121b; background:linear-gradient(135deg,#8FE3FF 0%,#4CC9FF 55%,#35B6F0 100%); box-shadow:0 10px 30px -8px rgba(76,201,255,.65),inset 0 1px 0 rgba(255,255,255,.45); }
.rx-btn-primary:hover{ transform:translateY(-2px); box-shadow:0 16px 38px -8px rgba(76,201,255,.8),inset 0 1px 0 rgba(255,255,255,.55); }
.rx-btn-ghost{ color:var(--rx-ink); background:rgba(255,255,255,.04); border-color:var(--rx-line-2); }
.rx-btn-ghost:hover{ background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.28); transform:translateY(-2px); }
.rx-btn-soft{ color:var(--rx-cyan-2); background:rgba(76,201,255,.09); border-color:rgba(76,201,255,.22); }
.rx-btn-soft:hover{ background:rgba(76,201,255,.16); border-color:rgba(76,201,255,.45); }
.rx-btn.is-copied{ color:#06210f; background:var(--rx-green); border-color:var(--rx-green); }

/* ============================ HERO ============================ */
.rx-hero{ display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); gap:clamp(24px,5vw,72px); align-items:center; padding:clamp(108px,15vh,148px) 0 clamp(40px,6vw,72px); }
.rx-eyebrow{ display:inline-flex; align-items:center; gap:10px; margin:0 0 22px; padding:7px 14px 7px 11px; border:1px solid var(--rx-line-2); border-radius:999px; background:rgba(255,255,255,.04); color:var(--rx-ink-2); font:600 13px/1 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-sync{ position:relative; display:inline-grid; place-items:center; width:10px; height:10px; }
.rx-sync i{ width:8px; height:8px; border-radius:50%; background:var(--rx-green); box-shadow:0 0 0 0 rgba(71,209,108,.55); animation:rx-pulse 2s ease-out infinite; }
.rx-sync[data-state="off"] i{ background:var(--rx-amber); animation:none; }
.rx-cta{ display:flex; flex-wrap:wrap; gap:12px; margin-top:32px; }
.rx-stats{ display:flex; gap:clamp(20px,4vw,44px); margin:40px 0 0; padding-top:26px; border-top:1px solid var(--rx-line); }
.rx-stats div{ min-width:0; }
.rx-stats dt{ color:var(--rx-ink-3); font:600 12px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.08em; text-transform:uppercase; }
.rx-stats dd{ margin:9px 0 0; font:700 clamp(30px,4vw,42px)/1 var(--font-display,'Archivo Variable',sans-serif); letter-spacing:-.04em; font-variant-numeric:tabular-nums; }

/* ── hero ticket ── */
.rx-stage{ --rx:0deg; --ry:0deg; --mx:50%; position:relative; display:grid; place-items:center; padding:20px; perspective:1100px; }
.rx-halo{ position:absolute; inset:6% 4%; border-radius:50%; background:radial-gradient(circle,rgba(76,201,255,.34),rgba(140,155,255,.14) 45%,transparent 70%); filter:blur(34px); animation:rx-breathe 6s ease-in-out infinite; }
.rx-ticket{
  --notch:16px; --notch-y:67%;
  position:relative; width:min(430px,100%); padding:26px 28px 24px;
  background:
    radial-gradient(120% 80% at 0% 0%,rgba(76,201,255,.2),transparent 55%),
    radial-gradient(90% 70% at 100% 100%,rgba(140,155,255,.18),transparent 60%),
    linear-gradient(160deg,#1c3249 0%,#10202f 55%,#0b1722 100%);
  border-radius:var(--r-lg); box-shadow:inset 0 1px 0 rgba(255,255,255,.16),inset 0 0 0 1px rgba(255,255,255,.06),0 40px 80px -30px rgba(0,0,0,.8);
  transform:rotateX(var(--rx)) rotateY(var(--ry)); transform-style:preserve-3d; transition:transform .25s cubic-bezier(.2,.8,.2,1);
  -webkit-mask:radial-gradient(circle var(--notch) at 0 var(--notch-y),#0000 calc(var(--notch) - .5px),#000 var(--notch)) left/51% 100% no-repeat,radial-gradient(circle var(--notch) at 100% var(--notch-y),#0000 calc(var(--notch) - .5px),#000 var(--notch)) right/51% 100% no-repeat;
  mask:radial-gradient(circle var(--notch) at 0 var(--notch-y),#0000 calc(var(--notch) - .5px),#000 var(--notch)) left/51% 100% no-repeat,radial-gradient(circle var(--notch) at 100% var(--notch-y),#0000 calc(var(--notch) - .5px),#000 var(--notch)) right/51% 100% no-repeat;
  animation:rx-float 7s ease-in-out infinite;
}
.rx-ticket::after{ content:""; position:absolute; inset:0; border-radius:inherit; pointer-events:none; mix-blend-mode:screen; background:linear-gradient(112deg,transparent 28%,rgba(255,255,255,.09) 42%,rgba(156,228,255,.2) 50%,rgba(140,155,255,.13) 58%,transparent 72%); background-size:260% 100%; background-position:var(--mx) 0; animation:rx-sheen 6s ease-in-out infinite; }
.rx-ticket[data-state="loading"]{ min-height:340px; display:grid; align-content:center; gap:20px; -webkit-mask:none; mask:none; }
.rx-ticket-top{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
.rx-ticket-brand{ display:inline-flex; align-items:center; gap:8px; color:var(--rx-ink-2); font:700 11.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.14em; }
.rx-ticket-brand svg{ color:var(--rx-cyan); }
.rx-ticket-live{ display:inline-flex; align-items:center; gap:7px; padding:6px 10px; border-radius:999px; background:rgba(71,209,108,.12); color:var(--rx-green); font:800 10.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.12em; }
.rx-ticket-live i{ width:6px; height:6px; border-radius:50%; background:currentColor; animation:rx-blink 1.6s ease-in-out infinite; }
.rx-ticket-idle{ background:rgba(255,189,89,.12); color:var(--rx-amber); }
.rx-ticket-label{ margin:34px 0 10px; color:var(--rx-ink-3); font:700 11.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.2em; }
.rx-ticket-code{
  display:block; width:100%; padding:0; border:0; background:none; text-align:left; color:#fff;
  font:800 clamp(18px,calc(330px / (var(--len,8) * .62)),40px)/1.1 var(--rx-mono); letter-spacing:.03em; overflow-wrap:anywhere;
  text-shadow:0 0 28px rgba(76,201,255,.5),0 2px 0 rgba(0,0,0,.3); transition:transform .2s ease,text-shadow .2s ease;
}
button.rx-ticket-code:hover{ text-shadow:0 0 38px rgba(76,201,255,.85),0 2px 0 rgba(0,0,0,.3); transform:translateX(2px); }
.rx-ticket-code-ghost{ color:rgba(255,255,255,.28); text-shadow:none; }
.rx-ticket-rewards{ display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; min-height:34px; }
.rx-ticket-perf{ position:absolute; left:26px; right:26px; top:var(--notch-y); border-top:2px dashed rgba(255,255,255,.16); }
.rx-ticket-foot{ display:grid; grid-template-columns:auto 1fr auto; align-items:end; gap:22px; margin-top:calc(33% - 34px); padding-top:34px; }
.rx-ticket-foot small{ display:block; color:var(--rx-ink-3); font:600 10.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.14em; text-transform:uppercase; }
.rx-ticket-foot b{ display:block; margin-top:7px; font:700 14px/1.2 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-ticket-bars{ width:92px; height:30px; color:rgba(255,255,255,.55); }
.rx-ticket-bars svg{ width:100%; height:100%; display:block; }
.rx-ticket-foot-idle{ display:block; margin-top:calc(33% - 34px); }
.rx-ticket-foot-idle p{ margin:0; color:var(--rx-ink-3); font-size:14px; line-height:1.55; }
.rx-ticket-tap{ position:absolute; right:22px; top:22px; display:none; }
.rx-tone-urgent{ color:var(--rx-amber); } .rx-tone-soon{ color:#FFD89A; } .rx-tone-calm{ color:inherit; }

/* ── chips ── */
.rx-chip{ display:inline-flex; align-items:center; gap:7px; max-width:100%; padding:7px 11px; border:1px solid rgba(255,255,255,.1); border-radius:999px; background:rgba(255,255,255,.05); color:#DCE8F1; font:600 13px/1.2 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-chip svg{ flex:none; }
.rx-chip span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.rx-chip-gems{ color:#8FE3FF; border-color:rgba(143,227,255,.28); background:rgba(76,201,255,.1); }
.rx-chip-coins{ color:#FFD98A; border-color:rgba(255,217,138,.28); background:rgba(255,189,89,.1); }
.rx-chip-rankup{ color:#C5CCFF; border-color:rgba(140,155,255,.3); background:rgba(140,155,255,.12); }
.rx-chip-shards{ color:#FFE08F; border-color:rgba(255,224,143,.26); background:rgba(255,208,80,.09); }
.rx-chip-voucher{ color:#8CF0B4; border-color:rgba(71,209,108,.3); background:rgba(71,209,108,.1); }
.rx-chip-player{ color:#FFB4D6; border-color:rgba(255,150,200,.28); background:rgba(255,120,180,.09); }
.rx-chip-pack{ color:#FFC79A; border-color:rgba(255,160,100,.28); background:rgba(255,140,80,.09); }
.rx-chip-more{ color:var(--rx-ink-3); }

/* ── status pills ── */
.rx-pill{ display:inline-flex; align-items:center; gap:7px; padding:6px 11px; border-radius:999px; font:700 12px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.02em; }
.rx-pill i{ width:7px; height:7px; border-radius:50%; background:currentColor; }
.rx-pill-active{ color:var(--rx-green); background:rgba(71,209,108,.12); }
.rx-pill-active i{ animation:rx-blink 1.8s ease-in-out infinite; }
.rx-pill-scheduled{ color:var(--rx-amber); background:rgba(255,189,89,.12); }
.rx-pill-expired{ color:var(--rx-ink-3); background:rgba(255,255,255,.06); }

/* ============================ SECTIONS ============================ */
.rx-section{ padding:clamp(28px,4.5vw,52px) 0 0; scroll-margin-top:96px; }
.rx-sec-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:26px; }
.rx-count-pill{ flex:none; padding:9px 15px; border:1px solid rgba(71,209,108,.3); border-radius:999px; background:rgba(71,209,108,.09); color:var(--rx-green); font:700 13px/1 var(--font-body,'Instrument Sans Variable',sans-serif); }

/* ── active cards ── */
.rx-cards{ display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr)); gap:18px; }
.rx-card{
  position:relative; display:flex; flex-direction:column; gap:16px; padding:22px; border-radius:var(--r-lg); border:1px solid var(--rx-line);
  background:var(--rx-glass); box-shadow:0 24px 50px -28px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.06);
  transition:transform .25s cubic-bezier(.2,.8,.2,1),border-color .25s ease,box-shadow .25s ease;
  animation:rx-rise .6s cubic-bezier(.2,.8,.2,1) both; animation-delay:calc(var(--i,0) * 70ms);
}
.rx-card::before{ content:""; position:absolute; inset:0; border-radius:inherit; padding:1px; pointer-events:none; opacity:0; transition:opacity .3s ease; background:linear-gradient(150deg,rgba(143,227,255,.7),rgba(140,155,255,.15) 40%,transparent 70%); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; }
.rx-card:hover{ transform:translateY(-4px); border-color:rgba(76,201,255,.2); box-shadow:0 34px 60px -28px rgba(0,0,0,.9),0 0 50px -22px rgba(76,201,255,.45),inset 0 1px 0 rgba(255,255,255,.08); }
.rx-card:hover::before,.rx-card-new::before{ opacity:1; }
.rx-card-top{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
.rx-card-tags{ display:flex; align-items:center; gap:8px; min-width:0; }
.rx-tag{ padding:6px 10px; border-radius:var(--r-sm); font:700 11px/1 var(--font-body,'Instrument Sans Variable',sans-serif); letter-spacing:.08em; text-transform:uppercase; }
.rx-tag-new{ color:#1b1200; background:linear-gradient(135deg,#FFE29A,#FFBD59); box-shadow:0 6px 18px -6px rgba(255,189,89,.7); }
.rx-tag-region{ color:var(--rx-ink-3); background:rgba(255,255,255,.06); }
.rx-coupon{
  position:relative; display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; padding:16px 16px 16px 18px; border-radius:var(--r-lg);
  border:1.5px dashed rgba(76,201,255,.38); background:linear-gradient(135deg,rgba(76,201,255,.1),rgba(76,201,255,.03)); color:#fff; text-align:left;
  transition:background .2s ease,border-color .2s ease,transform .15s ease;
}
.rx-coupon:hover{ background:linear-gradient(135deg,rgba(76,201,255,.18),rgba(76,201,255,.06)); border-color:rgba(76,201,255,.7); }
.rx-coupon:active{ transform:scale(.985); }
.rx-coupon-code{ min-width:0; font:800 clamp(18px,calc(270px / (var(--len,8) * .62)),27px)/1.15 var(--rx-mono); letter-spacing:.04em; overflow-wrap:anywhere; }
.rx-coupon-icon{ flex:none; display:grid; place-items:center; width:38px; height:38px; border-radius:var(--r-md); color:var(--rx-cyan); background:rgba(76,201,255,.14); transition:background .2s,color .2s; }
.rx-coupon:hover .rx-coupon-icon{ background:var(--rx-cyan); color:#04121b; }
.rx-coupon.is-copied{ border-color:var(--rx-green); background:rgba(71,209,108,.13); }
.rx-coupon.is-copied .rx-coupon-icon{ background:var(--rx-green); color:#06210f; }
.rx-card-rewards{ display:flex; flex-wrap:wrap; gap:8px; }
.rx-card-note{ margin:-4px 0 0; color:var(--rx-ink-3); font-size:13.5px; line-height:1.5; }
.rx-card-meta{ display:flex; flex-wrap:wrap; gap:8px 16px; color:var(--rx-ink-3); font:500 13px/1.3 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-meta{ display:inline-flex; align-items:center; gap:6px; }
.rx-card-actions{ display:grid; grid-template-columns:1fr 1.25fr; gap:10px; margin-top:auto; }
.rx-card-actions .rx-btn{ min-height:48px; }
.rx-flash{ animation:rx-flash 2.4s ease-out 1; }

/* ── community feedback, ticks, "new for you" ── */
.rx-card-tags{ flex-wrap:wrap; row-gap:6px; }
.rx-card-top .rx-tag{ white-space:nowrap; }
.rx-tag-foryou{ color:#06202c; background:linear-gradient(135deg,#a3eaff,#4cc9ff); box-shadow:0 6px 18px -6px rgba(76,201,255,.7); }
.rx-tag-ok{ display:inline-flex; align-items:center; gap:5px; color:var(--rx-green); background:rgba(71,209,108,.12); }
.rx-pill-warn{ color:var(--rx-amber); background:rgba(255,189,89,.13); }
.rx-pill-warn i{ animation:rx-blink 1.8s ease-in-out infinite; }
.rx-card.is-static{ animation:none; }

.rx-banner{ display:grid; gap:3px; padding:11px 13px; border:1px solid rgba(255,189,89,.35); border-radius:var(--r-md); background:linear-gradient(135deg,rgba(255,189,89,.14),rgba(255,189,89,.04)); color:var(--rx-amber); font:600 13px/1.4 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-banner span{ color:var(--rx-ink-2); font-weight:500; }
.rx-card-flag{ border-color:rgba(255,189,89,.28); }

.rx-feedback{ display:grid; gap:10px; padding:13px; border:1px solid var(--rx-line); border-radius:var(--r-md); background:rgba(255,255,255,.03); transition:opacity .2s; }
.rx-feedback.is-busy{ opacity:.72; pointer-events:none; }
.rx-fb-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
.rx-fb-q{ color:var(--rx-ink-2); font:600 13px/1.3 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-fb-note{ margin:0; color:var(--rx-ink-3); font:500 12.5px/1.45 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-fb-warn{ margin:0; padding:8px 10px; border-radius:var(--r-sm); color:var(--rx-amber); background:rgba(255,189,89,.1); font:600 12.5px/1.4 var(--font-body,'Instrument Sans Variable',sans-serif); }

.rx-tick{ display:inline-flex; align-items:center; gap:8px; min-height:36px; padding:0 13px 0 9px; border:1px solid var(--rx-line-2); border-radius:999px; background:transparent; color:var(--rx-ink-2); font:600 12.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); transition:color .2s,border-color .2s,background .2s,transform .15s; -webkit-tap-highlight-color:transparent; }
.rx-tick:hover{ border-color:rgba(71,209,108,.5); color:var(--rx-green); }
.rx-tick:active{ transform:scale(.96); }
.rx-tick-box{ display:grid; place-items:center; width:19px; height:19px; border-radius:6px; border:1.5px solid currentColor; }
.rx-tick-box svg{ opacity:0; transform:scale(.5); transition:opacity .15s,transform .2s cubic-bezier(.2,.8,.2,1); }
.rx-tick.is-on{ color:var(--rx-green); border-color:rgba(71,209,108,.55); background:rgba(71,209,108,.1); }
.rx-tick.is-on .rx-tick-box{ background:var(--rx-green); border-color:var(--rx-green); color:#06210f; }
.rx-tick.is-on .rx-tick-box svg{ opacity:1; transform:none; }

.rx-vote-btns{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.rx-vbtn{ display:flex; align-items:center; justify-content:center; gap:7px; min-height:46px; padding:0 10px; border:1px solid var(--rx-line-2); border-radius:var(--r-md); background:rgba(255,255,255,.04); color:var(--rx-ink); font:700 13.5px/1.1 var(--font-body,'Instrument Sans Variable',sans-serif); transition:background .2s,border-color .2s,color .2s,transform .15s; -webkit-tap-highlight-color:transparent; }
.rx-vbtn:active{ transform:scale(.97); }
.rx-vbtn span{ white-space:nowrap; }
@media(max-width:480px){ .rx-feedback .rx-vbtn svg{ display:none; } }
.rx-vbtn b{ min-width:1.4em; padding:2px 6px; border-radius:999px; background:rgba(255,255,255,.08); color:var(--rx-ink-2); font:700 12px/1.2 var(--rx-mono); text-align:center; font-variant-numeric:tabular-nums; }
.rx-vbtn-ok:hover{ border-color:rgba(71,209,108,.55); background:rgba(71,209,108,.1); color:var(--rx-green); }
.rx-vbtn-bad:hover{ border-color:rgba(255,122,122,.55); background:rgba(255,122,122,.1); color:var(--rx-red); }
.rx-feedback[data-mine="worked"] .rx-vbtn-ok{ color:#06210f; background:var(--rx-green); border-color:var(--rx-green); }
.rx-feedback[data-mine="worked"] .rx-vbtn-ok b{ background:rgba(6,33,15,.2); color:#06210f; }
.rx-feedback[data-mine="failed"] .rx-vbtn-bad{ color:#2a0808; background:var(--rx-red); border-color:var(--rx-red); }
.rx-feedback[data-mine="failed"] .rx-vbtn-bad b{ background:rgba(42,8,8,.2); color:#2a0808; }
.rx-vfix{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; color:var(--rx-ink-3); font:500 12.5px/1.3 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-vfix button{ min-height:32px; padding:0 11px; border:1px solid var(--rx-line-2); border-radius:999px; background:rgba(255,255,255,.05); color:var(--rx-ink-2); font:600 12.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-vfix button:hover{ border-color:var(--rx-cyan); color:var(--rx-cyan-2); }

/* A code I already redeemed: dimmed but still copyable, and the tick stays easy to undo. */
.rx-card.is-done .rx-coupon,.rx-card.is-done .rx-card-rewards,.rx-card.is-done .rx-card-note,.rx-card.is-done .rx-card-meta,.rx-card.is-done .rx-card-top{ opacity:.5; }
.rx-card.is-done .rx-coupon{ filter:saturate(.25); border-color:rgba(255,255,255,.18); }
.rx-card.is-done::before{ opacity:0; }
.rx-row.is-done{ opacity:.6; }
.rx-row.is-done code{ text-decoration:line-through; text-decoration-color:rgba(71,209,108,.7); }
.rx-mini-tick.is-on{ color:#06210f; background:var(--rx-green); border-color:var(--rx-green); }

/* strip: new since last visit + progress */
.rx-strip{ display:flex; flex-wrap:wrap; align-items:center; gap:10px 14px; margin:-6px 0 20px; }
.rx-strip[hidden]{ display:none; }
.rx-strip-new{ display:inline-flex; align-items:center; gap:9px; min-height:42px; padding:0 8px 0 14px; border:1px solid rgba(255,189,89,.45); border-radius:999px; background:linear-gradient(135deg,rgba(255,189,89,.2),rgba(255,189,89,.06)); color:#FFD68A; font:700 13.5px/1 var(--font-body,'Instrument Sans Variable',sans-serif); box-shadow:0 10px 28px -14px rgba(255,189,89,.8); }
.rx-strip-new em{ padding:7px 11px; border-radius:999px; background:var(--rx-amber); color:#1b1200; font-style:normal; font-size:12px; }
.rx-strip-prog{ display:inline-flex; align-items:center; gap:10px; min-height:42px; padding:0 8px 0 14px; border:1px solid var(--rx-line-2); border-radius:999px; background:rgba(255,255,255,.04); color:var(--rx-ink-2); font:600 13px/1 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-strip-prog small{ color:var(--rx-ink-3); font-size:12.5px; font-weight:500; }
.rx-strip-bar{ width:54px; height:6px; border-radius:99px; background:rgba(255,255,255,.1); overflow:hidden; }
.rx-strip-bar i{ display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#47D16C,#9CE4FF); transition:width .35s ease; }
.rx-strip-prog button{ min-height:30px; padding:0 11px; border:0; border-radius:999px; background:rgba(255,255,255,.08); color:var(--rx-ink-2); font:600 12px/1 var(--font-body,'Instrument Sans Variable',sans-serif); }
.rx-strip-row{ display:flex; align-items:center; gap:8px; max-width:100%; }
.rx-strip-new{ min-width:0; }
.rx-strip-x{ flex:none; width:34px; height:34px; border:0; border-radius:50%; background:rgba(255,255,255,.07); color:var(--rx-ink-2); font-size:19px; line-height:1; }

/* "How did it go?" prompt after copying a code and coming back */
