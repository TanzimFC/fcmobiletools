</style>
<script>
for (const button of document.querySelectorAll('[data-copy]')) button.addEventListener('click', async () => { const code=button.dataset.copy; try { await navigator.clipboard.writeText(code); } catch { const area=document.createElement('textarea'); area.value=code; document.body.appendChild(area); area.select(); document.execCommand('copy'); area.remove(); } const old=button.innerHTML; button.innerHTML='<span>Copied ✓</span>'; setTimeout(()=>button.innerHTML=old,1400); });
</script>
