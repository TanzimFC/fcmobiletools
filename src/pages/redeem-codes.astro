<style is="global">
.codes-page .hero-object-main{animation:redeem-hero-float 5.5s ease-in-out infinite;will-change:transform}
.codes-page .live-card{--mx:50%;--my:50%;--rx:0deg;--ry:0deg;transform:perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(0);transition:transform .22s cubic-bezier(.2,.8,.2,1),border-color .22s ease,box-shadow .22s ease;animation:redeem-card-in .65s cubic-bezier(.2,.8,.2,1) both;animation-delay:var(--delay,0ms)}
.codes-page .live-card::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.9;background:radial-gradient(220px 180px at var(--mx) var(--my),#56d6ff18,transparent 65%);transition:opacity .2s ease}
.codes-page .live-card:hover{border-color:#3f7792;box-shadow:0 24px 70px #0008,0 0 35px #56d6ff0d}
.codes-page .live-card code{position:relative;display:block;width:100%;padding:13px 14px;margin-top:27px;border:1px solid #234354;border-radius:13px;background:linear-gradient(100deg,#07131a,#0b1820);box-shadow:inset 0 1px #ffffff06;overflow:hidden}
.codes-page .live-card code::after{content:"";position:absolute;top:0;bottom:0;left:-35%;width:22%;background:linear-gradient(90deg,transparent,#ffffff14,transparent);transform:skewX(-18deg);animation:redeem-scan 3.8s ease-in-out infinite}
.codes-page .card-actions button,.codes-page .card-actions a{flex:1;position:relative;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
.codes-page .card-actions button:hover{transform:translateY(-2px);box-shadow:0 10px 25px #0006}
.codes-page .card-actions a:hover{transform:translateY(-2px);box-shadow:0 10px 28px #56d6ff18}
.codes-page .copy-code.pulse{animation:copy-pulse .4s ease}
.codes-page .stats-strip article{transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
.codes-page .stats-strip article:hover{transform:translateY(-4px);border-color:#35647b;box-shadow:0 18px 45px #0007}
.codes-page .archive-table .table-row{transition:transform .18s ease,border-color .18s ease,background .18s ease}
.codes-page .archive-table .table-row:hover{transform:translateX(3px)}
@keyframes redeem-hero-float{0%,100%{transform:translateY(-50%) translate3d(0,0,0) rotate(0deg)}50%{transform:translateY(calc(-50% - 10px)) translate3d(0,0,0) rotate(-1deg)}}
@keyframes redeem-card-in{from{opacity:0;transform:perspective(900px) rotateX(5deg) translateY(18px) scale(.985)}to{opacity:1;transform:perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)) translateY(0) scale(1)}}
@keyframes redeem-scan{0%,55%{left:-35%}80%,100%{left:120%}}
@keyframes copy-pulse{50%{transform:scale(.96);box-shadow:0 0 0 5px #56d6ff12}}
