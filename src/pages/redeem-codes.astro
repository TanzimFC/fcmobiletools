.card-actions button{border:1px solid #2b4656;background:#0b151c;color:#bfd5df;cursor:pointer}.card-actions button:hover{border-color:#56d6ff66;background:#0e1b24}.card-actions button span{color:var(--cyan)}
.card-actions a{border:1px solid #5ad5ff;background:var(--cyan);color:#06131b}.card-actions a span{font-size:11px}

.archive{margin-top:22px}.archive-count,.archive-link{padding:10px 12px;border:1px solid #1f3541;border-radius:12px;background:#0a1218}.archive-count strong{display:block;color:var(--cyan);font:800 17px var(--display)}.archive-count span{display:block;margin-top:2px;color:#718795;font-size:8px}.archive-link{color:#b9d9e7;font:700 8px var(--mono);text-decoration:none}.archive-link span{color:var(--cyan)}
