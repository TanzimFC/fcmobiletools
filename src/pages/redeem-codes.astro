<script is="inline">
(() => {
  const input = document.getElementById('redeem-search');
  const rows = Array.from(document.querySelectorAll('[data-redeem-row]'));
  const count = document.getElementById('redeem-count');
  if (!input || !rows.length) return;

  const apply = () => {
    const query = (input.value || '').trim().toLowerCase();
    const words = query.split(/\s+/).filter(Boolean);
    let visible = 0;
    rows.forEach((row) => {
      const hay = (row.dataset.search || '').toLowerCase();
      const show = words.every((word) => hay.includes(word));
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = query ? visible : rows.length;
  };

  input.addEventListener('input', apply);
  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      input.focus();
    }
  });
  apply();
})();
</script>
