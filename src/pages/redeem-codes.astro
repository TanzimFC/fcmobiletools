---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REDEEM_CODES, REDEEM_STATUS } from '../data/redeemCodes.js';

const pageSize = 30;
const url = Astro.url;
const query = (url.searchParams.get('q') || '').trim();
const filter = ['all', 'active', 'expired'].includes(url.searchParams.get('status')) ? url.searchParams.get('status') : 'all';
const matches = REDEEM_CODES.filter((item) => {
  const text = `${item.code} ${item.reward} ${item.region || ''}`.toLowerCase();
  return (!query || text.includes(query.toLowerCase())) && (filter === 'all' || item.status === filter);
});
const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
const requestedPage = Number(url.searchParams.get('page') || 1);
const currentPage = Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages);
const pageItems = matches.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const activeCodes = REDEEM_CODES.filter((item) => item.status === 'active');
const expiredCodes = REDEEM_CODES.filter((item) => item.status === 'expired');
const lastUpdated = REDEEM_CODES.reduce((latest, item) => item.lastVerified > latest ? item.lastVerified : latest, '');
const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : 'Unknown';
const statusInfo = (status) => REDEEM_STATUS[status] ?? REDEEM_STATUS.unknown;
const pageUrl = (page) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (filter !== 'all') params.set('status', filter);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return `/redeem-codes${qs ? `?${qs}` : ''}`;
};
---
<BaseLayout title="FC Mobile Redeem Codes" description="Find, search, copy and redeem FC Mobile codes.">
<section class="codes-page">
  <div class="codes-wrap">
    <header class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span></span> TANZIMFC / REDEEM DATABASE</div>
        <div class="hero-kicker">DAILY DROP · VERIFY · COPY · REDEEM</div>
        <h1>Redeem <em>the code.</em><br />Claim the reward.</h1>
        <p>One clean place for the latest FC Mobile codes, their status, and the official EA redemption destination.</p>
        <div class="hero-chips">
          <span><i class="live-dot"></i>{activeCodes.length} active now</span>
          <span>{REDEEM_CODES.length} codes tracked</span>
          <span>EA redemption link</span>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><div class="orbit-core"><strong>FC</strong><small>CODE<br />DROP</small></div>
        <div class="orbit-tag tag-one">XP</div><div class="orbit-tag tag-two">GEMS</div><div class="orbit-tag tag-three">COINS</div>
      </div>
    </header>

    <section class="active-zone">
      <div class="section-heading">
        <div><div class="section-index">01 / LIVE</div><h2>Working right now</h2><p>These are the codes currently marked active in the database.</p></div>
        <div class="verified"><i></i><span><b>Last verified</b><small>{fmtDate(lastUpdated)}</small></span></div>
      </div>
      {activeCodes.length ? activeCodes.map((item) => {
        const status = statusInfo(item.status);
        return <article class="active-card">
          <div class="accent-bar"></div>
          <div class="active-main">
            <div class="code-row"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div>
            <h3>{item.reward}</h3>
            <p>Released {fmtDate(item.releaseDate)} <span>•</span> Region {item.region} <span>•</span> Updated {fmtDate(item.lastVerified)}</p>
          </div>
          <div class="buttons">
            <button type="button" data-copy={item.code}><span>Copy</span><b>⌘ C</b></button>
            <a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">Redeem <span>↗</span></a>
          </div>
        </article>;
      }) : <div class="empty">No active codes are verified right now.</div>}
    </section>

    <section class="archive">
      <div class="section-heading archive-heading">
        <div><div class="section-index">02 / LIBRARY</div><h2>The code archive</h2><p>{matches.length} matching records · 30 visible per page</p></div>
        <div class="archive-note"><span>STATUS</span><b>Historical records stay searchable.</b></div>
      </div>
      <form class="controls" method="get" action="/redeem-codes">
        <label class="search"><span>⌕</span><input name="q" value={query} placeholder="Search code, reward or region" autocomplete="off" /></label>
        <div class="filters">{[['all','All'],['active','Active'],['expired','Expired']].map(([value,label]) => <button class:chosen={filter===value} name="status" value={value} type="submit">{label}</button>)}</div>
      </form>
      <div class="rows">
        {pageItems.length ? pageItems.map((item) => {
          const status = statusInfo(item.status);
          return <article class="row">
            <div class="row-code"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div>
            <div class="reward"><small>REWARD</small><b>{item.reward}</b></div>
            <div class="date"><small>RELEASED</small><b>{fmtDate(item.releaseDate)}</b></div>
            <div class="date"><small>UPDATED</small><b>{fmtDate(item.lastVerified)}</b></div>
            <div class="row-actions"><button type="button" data-copy={item.code}>Copy</button><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">Redeem ↗</a></div>
          </article>;
        }) : <div class="empty">No codes match your search.</div>}
      </div>
      <div class="pagination"><a class:disabled={currentPage===1} href={currentPage>1?pageUrl(currentPage-1):'#'}>← Previous</a><span>Page {currentPage} / {totalPages}</span><a class:disabled={currentPage===totalPages} href={currentPage<totalPages?pageUrl(currentPage+1):'#'}>Next →</a></div>
    </section>

    <section class="stats">
      <div class="stat-card stat-purple"><small>ARCHIVED</small><b>{REDEEM_CODES.length}</b><span>codes tracked</span></div>
      <div class="stat-card stat-green"><small>ACTIVE</small><b>{activeCodes.length}</b><span>ready to use</span></div>
      <div class="stat-card stat-orange"><small>EXPIRED</small><b>{expiredCodes.length}</b><span>kept for history</span></div>
      <div class="stat-card stat-pink"><small>DESTINATION</small><b>EA</b><span>official redemption</span></div>
    </section>

    <section class="note"><div class="note-icon">✦</div><div><b>How to use this page</b><p>Copy a working code, open the official EA redemption page, sign in, and paste the code. Statuses are based on the records maintained in the TanzimFC database.</p></div></section>
  </div>
</section>
</BaseLayout>
