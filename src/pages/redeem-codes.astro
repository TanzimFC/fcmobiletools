.filters{display:flex;gap:4px;flex-wrap:wrap}.filters button{min-height:38px;padding:0 11px;border-radius:9px;border:1px solid #1c2d38;background:#0b141a;color:#7c909d;font:700 8px var(--mono);cursor:pointer}.filters button:hover,.filters button.chosen{border-color:#3c7189;color:#d8f4ff;background:#0d1a22}
