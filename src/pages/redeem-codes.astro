.stats-strip b{display:block;margin-top:2px;color:#d4e0e5;font-size:10px}.stats-strip small{display:block;margin-top:3px;color:#647b8b;font-size:9px;line-height:1.45}

.live-section,.archive{margin-top:18px;padding:25px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(180deg,#0d151bdc,#091016dc);box-shadow:0 24px 70px #0006}
