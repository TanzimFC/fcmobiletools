---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REDEEM_CODES, REDEEM_STATUS } from '../data/redeemCodes.js';

const pageSize = 30;
const url = Astro.url;
const query = (url.searchParams.get('q') || '').trim();
const filter = ['all', 'active', 'expired'].includes(url.searchParams.get('status')) ? url.searchParams.get('status') : 'all';
const matches = REDEEM_CODES.filter((item) => {
  const text = `${item.code} ${item.reward} ${item.region || ''}`.toLowerCase();
  return (!query || text.includes(query.toLowerCase())) && (filter === 'all' || item.status === filter);
});
const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
const requestedPage = Number(url.searchParams.get('page') || 1);
const currentPage = Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages);
const pageItems = matches.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const activeCodes = REDEEM_CODES.filter((item) => item.status === 'active');
const expiredCodes = REDEEM_CODES.filter((item) => item.status === 'expired');
const lastUpdated = REDEEM_CODES.reduce((latest, item) => item.lastVerified > latest ? item.lastVerified : latest, '');
const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : 'Unknown';
const statusInfo = (status) => REDEEM_STATUS[status] ?? REDEEM_STATUS.unknown;
const pageUrl = (page) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (filter !== 'all') params.set('status', filter);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return `/redeem-codes${qs ? `?${qs}` : ''}`;
};
---
<BaseLayout title="FC Mobile Redeem Codes" description="Find, search, copy and redeem FC Mobile codes.">
<section class="codes-page"><div class="codes-wrap">
<header class="hero"><div><div class="eyebrow">TANZIMFC / REDEEM DATABASE</div><h1>FC Mobile <span>Redeem Codes</span></h1><p>Find a working code, check its status, copy it, then redeem it on EA's official page.</p></div><div class="updated"><i></i><div><strong>Last updated</strong><small>{fmtDate(lastUpdated)}</small></div></div></header>
<section class="active-box"><div class="section-top"><div><small>01 / ACTIVE NOW</small><h2>Working Codes</h2></div><b>{activeCodes.length} ACTIVE</b></div>{activeCodes.length ? activeCodes.map((item) => { const status=statusInfo(item.status); return <article class="active-card"><div><div class="code-row"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div><h3>{item.reward}</h3><p>Released {fmtDate(item.releaseDate)} · Region {item.region} · Last updated {fmtDate(item.lastVerified)}</p></div><div class="buttons"><button type="button" data-copy={item.code}>COPY CODE</button><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">REDEEM ↗</a></div></article>; }) : <p class="empty">No active codes are verified right now.</p>}</section>
<section class="archive"><div class="section-top archive-head"><div><small>02 / ARCHIVE</small><h2>Code Database</h2><p>{matches.length} matching codes · 30 per page</p></div></div>
<form class="controls" method="get" action="/redeem-codes"><label class="search"><span>⌕</span><input name="q" value={query} placeholder="Search code or reward" autocomplete="off"/></label><div class="filters">{[['all','All'],['active','Active'],['expired','Expired']].map(([value,label]) => <button class:chosen={filter===value} name="status" value={value} type="submit">{label}</button>)}</div></form>
<div class="rows">{pageItems.length ? pageItems.map((item) => { const status=statusInfo(item.status); return <article class="row"><div class="row-code"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div><div class="reward">{item.reward}</div><div class="date"><small>Released</small><b>{fmtDate(item.releaseDate)}</b></div><div class="date"><small>Updated</small><b>{fmtDate(item.lastVerified)}</b></div><div class="row-actions"><button type="button" data-copy={item.code}>Copy</button><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">Redeem ↗</a></div></article>; }) : <div class="empty">No codes match your search.</div>}</div>
<div class="pagination"><a class:disabled={currentPage===1} href={currentPage>1?pageUrl(currentPage-1):'#'}>← Previous</a><span>Page {currentPage} of {totalPages}</span><a class:disabled={currentPage===totalPages} href={currentPage<totalPages?pageUrl(currentPage+1):'#'}>Next →</a></div>
</section>
<section class="stats"><div><b>{REDEEM_CODES.length}</b><span>Codes archived</span></div><div><b>{activeCodes.length}</b><span>Active</span></div><div><b>{expiredCodes.length}</b><span>Expired</span></div><div><b>EA</b><span>Official destination</span></div></section>
<section class="note"><b>Database rules</b><p>Expired codes are never deleted. Active codes are kept first, while the archive is paginated so only 30 records are loaded into the visible list at a time.</p></section>
</div></section>
</BaseLayout>
<style>
.codes-page{padding:50px 0 80px}.codes-wrap{width:min(1120px,calc(100% - 30px));margin:auto}.hero{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:28px}.eyebrow,.section-top small{font:800 9px var(--mono);letter-spacing:.14em;color:var(--blue)}h1{font-size:clamp(42px,6vw,70px);line-height:.94;letter-spacing:-.055em;margin:12px 0}h1 span{color:var(--blue)}.hero p,.archive-head p{color:var(--muted);font-size:12px;line-height:1.6;margin:0}.hero p{max-width:650px}.updated{display:flex;gap:10px;align-items:center;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--surface);white-space:nowrap}.updated i{width:8px;height:8px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px var(--blue3)}.updated strong,.updated small{display:block}.updated strong{font-size:9px}.updated small{font:700 8px var(--mono);color:var(--muted);margin-top:3px}.active-box,.archive{border:1px solid var(--border);border-radius:18px;background:var(--surface);padding:20px;margin-bottom:18px}.section-top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:15px}.section-top h2{font-size:24px;margin:4px 0}.section-top>b{font:900 8px var(--mono);color:var(--blue);background:var(--blue3);padding:8px 10px;border-radius:7px}.active-card{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px;border:1px solid color-mix(in srgb,var(--blue) 40%,var(--border));border-radius:14px;background:var(--surface2)}.code-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.code-row code,.row-code code{font:900 20px var(--mono);letter-spacing:.04em}.active-card h3{font-size:16px;margin:9px 0 7px}.active-card p{font:700 8px var(--mono);color:var(--muted);margin:0}.status{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:6px;font:800 7px var(--mono);text-transform:uppercase}.status i{width:5px;height:5px;border-radius:50%;background:currentColor}.status.active{color:var(--blue);background:var(--blue3)}.status.reported{color:#c99125;background:#c9912518}.status.expired,.status.unknown{color:var(--muted);background:var(--surface)}.buttons,.row-actions{display:flex;gap:7px}.buttons button,.buttons a,.row-actions button,.row-actions a{height:38px;padding:0 12px;border-radius:8px;font:900 8px var(--mono);display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.buttons button,.row-actions button{border:1px solid var(--blue);background:transparent;color:var(--blue)}.buttons a{border:1px solid var(--blue);background:var(--blue);color:#07131b}.controls{display:flex;gap:8px;justify-content:space-between;align-items:center;margin-bottom:12px}.search{height:40px;display:flex;align-items:center;gap:6px;width:270px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);padding:0 10px}.search span{color:var(--muted);font-size:17px}.search input{border:0;outline:0;background:transparent;color:var(--text);width:100%;font:700 9px var(--mono)}.filters{display:flex;gap:7px}.filters button{height:40px;border:1px solid var(--border);border-radius:9px;background:transparent;color:var(--muted);font:800 8px var(--mono);padding:0 12px;cursor:pointer}.filters button.chosen,.filters button:hover{border-color:var(--blue);background:var(--blue3);color:var(--blue)}.rows{border-top:1px solid var(--border)}.row{display:grid;grid-template-columns:1.05fr 1.35fr .7fr .7fr auto;align-items:center;gap:13px;padding:12px 3px;border-bottom:1px solid var(--border)}.row-code code{font-size:12px;display:block;overflow:hidden;text-overflow:ellipsis}.row-code .status{margin-top:5px}.reward{font-size:10px}.date small,.date b{display:block}.date small{font:700 7px var(--mono);color:var(--muted);text-transform:uppercase}.date b{font:800 8px var(--mono);margin-top:3px}.row-actions button,.row-actions a{height:30px;border:1px solid var(--border);color:var(--muted);background:transparent}.pagination{display:flex;justify-content:center;align-items:center;gap:12px;padding-top:17px}.pagination a{padding:9px 12px;border:1px solid var(--border);border-radius:8px;color:var(--text);text-decoration:none;font:800 8px var(--mono)}.pagination a:hover:not(.disabled){border-color:var(--blue);color:var(--blue);background:var(--blue3)}.pagination a.disabled{opacity:.35;pointer-events:none}.pagination span{font:800 8px var(--mono);color:var(--muted);min-width:90px;text-align:center}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:18px;background:var(--surface)}.stats div{padding:16px;border-right:1px solid var(--border)}.stats div:last-child{border:0}.stats b,.stats span{display:block}.stats b{font:900 20px var(--mono)}.stats span{font-size:9px;color:var(--muted);margin-top:4px}.note{padding:16px 18px;border:1px solid var(--border);border-radius:13px;background:var(--surface2)}.note b{font-size:11px}.note p{font-size:10px;color:var(--muted);line-height:1.7;margin:5px 0 0}.empty{padding:25px;text-align:center;color:var(--muted);font-size:10px}
@media(max-width:800px){.hero{display:block}.updated{width:max-content;margin-top:15px}.controls{display:block}.search{width:100%;margin-bottom:8px}.filters button{flex:1}.filters{width:100%}.row{grid-template-columns:1fr 1.2fr auto}.date{display:none}.row-actions{justify-content:end}}
@media(max-width:580px){.codes-page{padding-top:28px}.codes-wrap{width:calc(100% - 18px)}.active-box,.archive{padding:14px}.active-card{display:block}.buttons{margin-top:14px}.buttons button,.buttons a{flex:1}.stats{grid-template-columns:1fr 1fr}.stats div:nth-child(2){border-right:0}.stats div:nth-child(3),.stats div:nth-child(4){border-top:1px solid var(--border)}}
</style>
<script>
for (const button of document.querySelectorAll('[data-copy]')) button.addEventListener('click', async () => { const code=button.dataset.copy; try { await navigator.clipboard.writeText(code); } catch { const area=document.createElement('textarea'); area.value=code; document.body.appendChild(area); area.select(); document.execCommand('copy'); area.remove(); } const old=button.textContent; button.textContent='✓ Copied'; setTimeout(()=>button.textContent=old,1400); });
</script>
