---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REDEEM_CODES, REDEEM_STATUS } from '../data/redeemCodes.js';
const activeCodes = REDEEM_CODES.filter((item) => item.status === 'active');
const expiredCodes = REDEEM_CODES.filter((item) => item.status === 'expired');
const reportedCodes = REDEEM_CODES.filter((item) => item.status === 'recentlyReported');
const unknownCodes = REDEEM_CODES.filter((item) => item.status === 'unknown');
const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : 'Unknown';
const fmtStatus = (status) => REDEEM_STATUS[status] ?? REDEEM_STATUS.unknown;
---
<BaseLayout title="FC Mobile Redeem Codes" description="Find the latest FC Mobile redeem codes, check their status, copy them instantly, and redeem them on EA's official site.">
<section class="codes-page">
  <div class="codes-wrap">
    <header class="codes-hero">
      <div>
        <div class="eyebrow">TANZIMFC / REDEEM DATABASE</div>
        <h1>FC Mobile <span>Redeem Codes</span></h1>
        <p>Find the latest FC Mobile redeem codes, check their status, copy them instantly, and redeem them on EA's official site.</p>
      </div>
      <div class="fresh"><span class="fresh-dot"></span><div><strong>Freshness first</strong><small>Database updated Sep 12, 2026</small></div></div>
    </header>

    <section class="active-section" aria-labelledby="active-title">
      <div class="section-head"><div><div class="section-kicker">01 / RIGHT NOW</div><h2 id="active-title">Active Codes</h2><p>These are the codes currently marked as working.</p></div><b class="count">{activeCodes.length} ACTIVE</b></div>
      <div class="active-list">
        {activeCodes.map((item) => {
          const status = fmtStatus(item.status);
          return <article class="code-card active-card" data-code-card data-code={item.code} data-status={item.status} data-region={item.region}>
            <div class="code-main">
              <div class="code-line"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div>
              <h3>{item.reward}</h3>
              <div class="meta"><span>Released <b>{fmtDate(item.releaseDate)}</b></span><span>Expires <b>{fmtDate(item.expiryDate)}</b></span><span>Region <b>{item.region}</b></span><span>Last verified <b>{fmtDate(item.lastVerified)}</b></span></div>
            </div>
            <div class="actions"><button class="copy-btn" type="button" data-copy={item.code}>COPY CODE</button><a class="redeem-btn" href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer">REDEEM <span>↗</span></a></div>
          </article>;
        })}
      </div>
    </section>

    <section class="tools-section">
      <div class="tools-head"><div><div class="section-kicker">02 / DATABASE</div><h2>Code Archive</h2><p>Search the full history without losing the current active code.</p></div><div class="filters"><label class="search"><span>⌕</span><input id="code-search" type="search" placeholder="Search code or reward" autocomplete="off"/></label><button class="filter active" type="button" data-filter="all">All</button><button class="filter" type="button" data-filter="expired">Expired</button></div></div>
      <div class="archive-list" id="archive-list">
        {REDEEM_CODES.map((item) => {
          const status = fmtStatus(item.status);
          return <article class:list={['archive-row', item.status === 'active' ? 'is-active' : '']} data-archive-item data-code={item.code} data-status={item.status}>
            <div class="archive-code"><code>{item.code}</code><span class={`status ${status.className}`}><i></i>{status.label}</span></div>
            <div class="archive-reward">{item.reward}</div>
            <div class="archive-date"><span>Released</span><b>{fmtDate(item.releaseDate)}</b></div>
            <div class="archive-date"><span>Expired</span><b>{fmtDate(item.expiryDate)}</b></div>
            <div class="archive-actions"><button class="mini-copy" type="button" data-copy={item.code} aria-label={`Copy ${item.code}`}>Copy</button><a href={`https://redeem.fcm.ea.com/?redeemCode=${encodeURIComponent(item.code)}`} target="_blank" rel="noopener noreferrer" aria-label={`Redeem ${item.code}`}>Redeem ↗</a></div>
          </article>;
        })}
      </div>
      <div class="no-results" id="no-results" hidden>No matching codes found.</div>
    </section>

    <section class="trust-grid">
      <div><strong>{REDEEM_CODES.length}</strong><span>Codes archived</span></div>
      <div><strong>{activeCodes.length}</strong><span>Active now</span></div>
      <div><strong>{expiredCodes.length}</strong><span>Expired</span></div>
      <div><strong>EA</strong><span>Official redeem destination</span></div>
    </section>

    <section class="note"><strong>How status works</strong><p>Active means the code is currently believed to work. Recently Reported is reserved for a newly discovered code that still needs verification. Expired is used when a code is confirmed or known to be expired. Unknown means its current status cannot be confidently determined. Expiration dates stay blank when no reliable date is known.</p></section>
  </div>
</section>
</BaseLayout>
<style>
.codes-page{padding:48px 0 80px}.codes-wrap{width:min(1120px,calc(100% - 30px));margin:auto}.codes-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:28px}.eyebrow,.section-kicker{font:800 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.codes-hero h1{font-size:clamp(40px,6vw,68px);line-height:.94;letter-spacing:-.055em;margin:12px 0}.codes-hero h1 span{color:var(--blue)}.codes-hero p{max-width:680px;margin:0;color:var(--muted);font-size:14px;line-height:1.6}.fresh{display:flex;align-items:center;gap:10px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--surface);white-space:nowrap}.fresh-dot{width:8px;height:8px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px var(--blue3)}.fresh strong,.fresh small{display:block}.fresh strong{font-size:10px}.fresh small{font:700 8px var(--mono);color:var(--muted);margin-top:3px}.active-section,.tools-section{border:1px solid var(--border);border-radius:18px;background:var(--surface);padding:20px;margin-bottom:18px}.section-head,.tools-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:16px}.section-head h2,.tools-head h2{font-size:24px;margin:4px 0 3px}.section-head p,.tools-head p{font-size:10px;color:var(--muted);margin:0}.count{font:800 8px var(--mono);color:var(--blue);background:var(--blue3);padding:8px 10px;border-radius:8px}.code-card{border:1px solid var(--border);border-radius:15px;background:var(--surface2);padding:18px;display:flex;align-items:center;justify-content:space-between;gap:20px}.code-card.active-card{border-color:color-mix(in srgb,var(--blue) 45%,var(--border))}.code-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.code-line code,.archive-code code{font:900 22px var(--mono);letter-spacing:.05em;color:var(--text)}.status{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;border-radius:6px;font:800 7px var(--mono);text-transform:uppercase;letter-spacing:.04em}.status i{width:5px;height:5px;border-radius:50%;display:block;background:currentColor}.status.active{color:var(--blue);background:var(--blue3)}.status.reported{color:#c99125;background:#c9912518}.status.expired{color:var(--muted);background:var(--surface)}.status.unknown{color:var(--muted);background:var(--surface)}.code-main h3{font-size:16px;margin:10px 0 12px}.meta{display:flex;flex-wrap:wrap;gap:8px 18px}.meta span{font:700 8px var(--mono);color:var(--muted)}.meta b{color:var(--text);font-weight:800}.actions{display:flex;gap:8px;flex:0 0 auto}.actions button,.actions a{height:42px;padding:0 15px;border-radius:9px;font:900 9px var(--mono);display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.copy-btn{border:1px solid var(--blue);background:transparent;color:var(--blue)}.copy-btn:hover{background:var(--blue3)}.redeem-btn{border:1px solid var(--blue);background:var(--blue);color:#07131b}.tools-head{align-items:flex-end}.filters{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.search{display:flex;align-items:center;width:220px;height:38px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);padding:0 9px;gap:6px}.search span{font-size:17px;color:var(--muted)}.search input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font:700 9px var(--mono)}.filter{height:38px;padding:0 11px;border:1px solid var(--border);border-radius:9px;background:transparent;color:var(--muted);font:800 8px var(--mono);cursor:pointer}.filter.active,.filter:hover{border-color:var(--blue);color:var(--blue);background:var(--blue3)}.archive-list{display:flex;flex-direction:column;border-top:1px solid var(--border)}.archive-row{display:grid;grid-template-columns:1.1fr 1.5fr .8fr .8fr auto;align-items:center;gap:14px;padding:13px 3px;border-bottom:1px solid var(--border)}.archive-row.is-active{background:linear-gradient(90deg,var(--blue3),transparent);margin:0 -10px;padding-inline:10px;border-radius:9px}.archive-code{min-width:0}.archive-code code{font-size:12px;display:block;overflow:hidden;text-overflow:ellipsis}.archive-code .status{margin-top:5px}.archive-reward{font-size:10px;line-height:1.4}.archive-date span{display:block;font:700 7px var(--mono);color:var(--muted);text-transform:uppercase}.archive-date b{font:800 8px var(--mono);display:block;margin-top:3px}.archive-actions{display:flex;gap:6px}.archive-actions button,.archive-actions a{height:30px;padding:0 8px;border:1px solid var(--border);border-radius:7px;background:transparent;color:var(--muted);font:800 7px var(--mono);text-decoration:none;cursor:pointer}.archive-actions button:hover,.archive-actions a:hover{border-color:var(--blue);color:var(--blue)}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border);border-radius:15px;background:var(--surface);overflow:hidden;margin-bottom:18px}.trust-grid div{padding:17px;border-right:1px solid var(--border)}.trust-grid div:last-child{border-right:0}.trust-grid strong,.trust-grid span{display:block}.trust-grid strong{font:900 20px var(--mono)}.trust-grid span{font-size:9px;color:var(--muted);margin-top:4px}.note{padding:16px 18px;border:1px solid var(--border);border-radius:13px;background:var(--surface2)}.note strong{font-size:11px}.note p{font-size:10px;line-height:1.7;color:var(--muted);margin:6px 0 0}.no-results{padding:30px;text-align:center;color:var(--muted);font-size:10px}
@media(max-width:820px){.codes-hero{display:block}.fresh{width:max-content;margin-top:16px}.tools-head{display:block}.filters{margin-top:14px}.search{flex:1;min-width:180px}.archive-row{grid-template-columns:1fr 1.2fr auto}.archive-date{display:none}.archive-actions{justify-content:flex-end}}
@media(max-width:620px){.codes-page{padding-top:28px}.codes-wrap{width:calc(100% - 18px)}.codes-hero h1{font-size:42px}.active-section,.tools-section{padding:14px}.section-head{align-items:flex-start}.code-card{display:block;padding:15px}.code-line code{font-size:18px}.code-card h3{font-size:14px}.actions{margin-top:15px}.actions button,.actions a{flex:1}.meta{display:grid;grid-template-columns:1fr 1fr;gap:8px}.filters{display:grid;grid-template-columns:1fr 1fr 1fr}.search{grid-column:1/-1;width:auto}.filter{width:100%}.archive-row{grid-template-columns:1fr auto;gap:7px 10px;padding:12px 2px}.archive-reward{grid-column:1/-1;grid-row:2;color:var(--muted)}.archive-actions{grid-column:2;grid-row:1}.archive-code{grid-column:1;grid-row:1}.trust-grid{grid-template-columns:1fr 1fr}.trust-grid div{border-bottom:1px solid var(--border)}.trust-grid div:nth-child(2){border-right:0}.trust-grid div:nth-child(3){border-bottom:0}.trust-grid div:nth-child(4){border-right:0;border-bottom:0}}
</style>
<script>
const redeemPage = document.querySelector('.codes-page');
if (redeemPage) {
  const filters = [...redeemPage.querySelectorAll('[data-filter]')];
  const search = redeemPage.querySelector('#code-search');
  const rows = [...redeemPage.querySelectorAll('[data-archive-item]')];
  const empty = redeemPage.querySelector('#no-results');
  let activeFilter = 'all';
  const apply = () => {
    const query = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matchesFilter = activeFilter === 'all' || row.dataset.status === activeFilter;
      const haystack = `${row.dataset.code} ${row.textContent}`.toLowerCase();
      const matchesSearch = !query || haystack.includes(query);
      const show = matchesFilter && matchesSearch;
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  };
  filters.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.filter;
    filters.forEach((item) => item.classList.toggle('active', item === button));
    apply();
  }));
  search?.addEventListener('input', apply);
  redeemPage.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
    const code = button.dataset.copy;
    try {
      await navigator.clipboard.writeText(code);
      const original = button.textContent;
      button.textContent = '✓ Copied';
      setTimeout(() => { button.textContent = original; }, 1400);
    } catch {
      const area = document.createElement('textarea');
      area.value = code;
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      area.remove();
      const original = button.textContent;
      button.textContent = '✓ Copied';
      setTimeout(() => { button.textContent = original; }, 1400);
    }
  }));
}
</script>
