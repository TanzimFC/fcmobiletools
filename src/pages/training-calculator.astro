<main>
  <section class="pagehead">
    <div class="pagehead-bg"></div>
    <div class="pagehead-grid"></div>
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb"><a href="index.html">FC Mobile Tools</a><span class="sep">/</span>Training Calculator</nav>
      <h1>FC Mobile Training Calculator</h1>
      <p class="lead">Pick where your player is now and where you want them to be. We'll tell you the exact Training XP and card count it takes — no guessing, no melting cards you didn't need to.</p>
    </div>
  </section>

  <section class="calc-shell">
    <div class="wrap">
      <div class="calc-card">

        <div class="steps">
          <div class="step">
            <label for="curLevel"><span class="step-num">1</span>Current Training Level</label>
            <select id="curLevel"></select>
            <small class="help">Check the player's card in your club — the Training Level is shown under their stats.</small>
          </div>
          <div class="step">
            <label for="tgtLevel"><span class="step-num">2</span>Target Training Level</label>
            <select id="tgtLevel"></select>
            <small class="help">Training caps out at Level 30 for every player, regardless of Rank.</small>
          </div>
          <div class="step">
            <label for="sourceCard"><span class="step-num">3</span>Card you're using as XP</label>
            <select id="sourceCard">
              <option value="100">47–59 OVR (Bronze) — 100 XP</option>
              <option value="120">60–69 OVR (Silver) — 120 XP</option>
              <option value="160">70–74 OVR — 160 XP</option>
              <option value="200">75–79 OVR — 200 XP</option>
              <option value="250" selected>80–84 OVR — 250 XP</option>
              <option value="300">85–89 OVR — 300 XP</option>
              <option value="400">90 OVR — 400 XP</option>
              <option value="500">91 OVR — 500 XP</option>
              <option value="600">92 OVR — 600 XP</option>
              <option value="700">93 OVR — 700 XP</option>
              <option value="800">94 OVR — 800 XP</option>
              <option value="1000">95+ OVR — 1,000 XP</option>
            </select>
            <small class="help">Bronze and Silver cards give the best coin-to-XP value if you're stocking up.</small>
          </div>
        </div>

        <div class="warn" id="rangeWarn">⚠ Target level needs to be higher than the current level — pick a higher Step 2 value.</div>

        <div class="summary">
          <div class="eyebrow">YOUR ANSWER</div>
          <p id="summarySentence">Choose your levels above to see the result.</p>
        </div>

        <div class="result-stats">
          <div class="rstat"><span>Total TXP needed</span><b class="blue" id="statTotalXp">0</b></div>
          <div class="rstat"><span>Cards needed</span><b id="statCards">0</b></div>
          <div class="rstat"><span>Levels gained</span><b id="statLevels">0</b></div>
          <div class="rstat"><span>Leftover XP</span><b class="amber" id="statLeftover">0</b></div>
        </div>

        <div class="progress-label"><span id="progLabelLeft">0 XP</span><span id="progLabelRight">0%</span></div>
        <div class="progress-track"><div class="progress-fill" id="progFill"></div></div>

        <details class="toggle-advanced" id="advWrap">
          <summary><span class="chev">▶</span> Advanced: see the per-level breakdown, or work backwards from XP you already have</summary>
          <div class="advanced-body">
            <div class="bd-scroll">
              <table class="bd-table">
                <thead><tr><th>Level</th><th>TXP required</th><th>Running total</th></tr></thead>
