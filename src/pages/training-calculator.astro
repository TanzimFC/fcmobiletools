---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FODDER_XP, TRAINING_LEVEL_XP } from '../data/trainingCalculator.js';
---
<BaseLayout title="FC Mobile Training Calculator" description="Calculate FC Mobile training XP and fodder cards needed for each training level">
<div class="training-page"><div class="wrap">
<header class="hero"><div><span>FC MOBILE TOOLS</span><h1>Training Calculator</h1><p>Calculate the XP and fodder needed to reach your target training level</p></div></header>
<section class="box setup"><div class="heading"><div><small>01</small><h2>Training setup</h2></div></div><div class="fields"><label>Current Level<select id="current">{TRAINING_LEVEL_XP.map(item=><option value={item.level}>{item.level}</option>)}</select></label><label>Target Level<select id="target">{TRAINING_LEVEL_XP.map(item=><option value={item.level} selected={item.level===30}>{item.level}</option>)}</select></label><label>Training Fodder<select id="fodder">{FODDER_XP.map(item=><option value={item.id} selected={item.id==='60-69'}>{item.label} · {item.xp} XP</option>)}</select></label></div><div class="quick"><span>Quick target</span><button data-add="1">+1</button><button data-add="5">+5</button><button data-add="10">+10</button><button id="max">MAX</button></div></section>
<section id="result" class="box requirement"></section>
<section class="box fodder"><div class="heading"><div><small>03</small><h2>Fodder count</h2></div><span id="selectedSummary"></span></div><div id="counter"></div></section>
<details class="box rules"><summary>How training XP is calculated</summary><p>Required XP is the cumulative XP at the target level minus the cumulative XP at the current level. Fodder cards are rounded up so the supplied XP reaches the requirement.</p></details>
</div></div>
</BaseLayout>
<style>
.training-page{--blue:#59cdf7;--ink:#eaf9ff;--muted:#7f9ba8;--line:#193d4d;min-height:100vh;background:radial-gradient(circle at 85% 0,rgba(69,199,246,.16),transparent 32%),#07131b;color:var(--ink);padding:42px 18px 80px}.wrap{max-width:1050px;margin:auto}.hero{padding:15px 0 30px}.hero span,.heading small{font:900 9px ui-monospace,monospace;letter-spacing:.15em;color:#66d8ff}.hero h1{font-size:clamp(43px,7vw,70px);line-height:.9;letter-spacing:-.06em;margin:10px 0 12px}.hero p{margin:0;color:var(--muted);font-size:14px}.box{border:1px solid var(--line);border-radius:20px;background:#0b1c26;box-shadow:0 15px 45px #00000024;padding:22px;margin-bottom:14px}.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.heading>div{display:flex;align-items:center;gap:10px}.heading h2{margin:0;font-size:19px}.heading>span{font:800 8px ui-monospace,monospace;color:#7593a0}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}label{display:grid;gap:7px;color:#a9c1cc;font:900 9px ui-monospace,monospace}select{width:100%;box-sizing:border-box;padding:13px 11px;border:1px solid #264957;border-radius:11px;background:#07151e;color:#eefaff;font:800 12px ui-monospace,monospace;outline:0}select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #59cdf71c}.quick{display:flex;align-items:center;gap:7px;margin-top:14px;color:#718e9b;font:800 8px ui-monospace,monospace}.quick button{border:1px solid #264957;background:#0d2531;color:#bdeaff;border-radius:8px;padding:7px 11px;font:900 8px ui-monospace,monospace;cursor:pointer}.requirement{padding:0;overflow:hidden;background:#0a1b25}.requirement-head{padding:24px 25px 20px;border-bottom:1px solid #193d4d}.requirement-title{font-size:12px;color:#72d9ff;font:900 10px ui-monospace,monospace;letter-spacing:.13em;text-transform:uppercase}.requirement-main{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-top:7px}.xp{font:900 clamp(50px,8vw,82px) ui-monospace,monospace;line-height:.86;letter-spacing:-.07em}.xp small{font-size:14px;color:#79a0ad;letter-spacing:0}.requirement-path{font:800 11px ui-monospace,monospace;color:#8ca8b3}.requirement-grid{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #193d4d}.metric{padding:18px 20px;border-right:1px solid #193d4d}.metric:last-child{border-right:0}.metric span{display:block;color:#688694;font:800 8px ui-monospace,monospace;letter-spacing:.08em;margin-bottom:7px}.metric strong{display:block;font:900 24px ui-monospace,monospace;color:#f0fbff}.metric small{display:block;color:#668390;font-size:8px;margin-top:4px}.progress-wrap{padding:18px 20px;background:#081720}.progress-head{display:flex;justify-content:space-between;color:#76929d;font:800 8px ui-monospace,monospace}.progress-head strong{color:#d8f6ff}.progress{height:9px;background:#132f3b;border-radius:99px;overflow:hidden;margin-top:9px}.progress i{display:block;height:100%;background:linear-gradient(90deg,#38b7ea,#73ddff);border-radius:inherit}.fodder-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.fodder-row{display:grid;grid-template-columns:105px 1fr 75px;align-items:center;gap:10px;padding:13px;border:1px solid #193d4d;border-radius:13px;background:#081720}.fodder-row.selected{border-color:#59cdf7;background:#0b2430}.range{display:flex;align-items:center;gap:8px;font:900 11px ui-monospace,monospace;color:#e8f9ff}.tick{width:18px;height:18px;flex:0 0 18px;border-radius:50%;display:grid;place-items:center;background:#59cdf7;color:#06202a;font:1000 11px Arial}.xpbar{height:9px;background:#102b37;border-radius:99px;overflow:hidden}.xpbar i{display:block;height:100%;background:#377d96;border-radius:inherit}.selected .xpbar i{background:#59cdf7}.count{text-align:right}.count strong{display:block;font:900 18px ui-monospace,monospace;color:#f1fbff}.count small{display:block;color:#6e8b97;font-size:7px}.rules summary{cursor:pointer;font:900 9px ui-monospace,monospace;color:#83dfff}.rules p{color:#839faa;font-size:10px;line-height:1.7;margin-bottom:0}@media(max-width:700px){.training-page{padding:25px 13px 60px}.box{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.requirement-main{display:block}.requirement-path{margin-top:15px}.requirement-grid{grid-template-columns:1fr}.metric{border-right:0;border-bottom:1px solid #193d4d}.metric:last-child{border-bottom:0}.fodder-grid{grid-template-columns:1fr}.fodder-row{grid-template-columns:88px 1fr 60px}}
</style>
<script>
import { calculateTraining } from '../lib/trainingCalculator.js';
import { FODDER_XP } from '../data/trainingCalculator.js';
const current=document.querySelector('#current'),target=document.querySelector('#target'),fodder=document.querySelector('#fodder'),result=document.querySelector('#result'),counter=document.querySelector('#counter'),summary=document.querySelector('#selectedSummary');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);const compact=n=>n>=1e9?`${(n/1e9).toFixed(1)}B`:n>=1e6?`${(n/1e6).toFixed(1)}M`:n>=1e3?`${(n/1e3).toFixed(1)}K`:String(n);
function render(){const d=calculateTraining({currentLevel:current.value,targetLevel:target.value,fodderId:fodder.value,pricePerCard:0});if(!d.valid){result.innerHTML='<div class="requirement-head"><div class="requirement-title">Training requirement</div><div class="xp">0 <small>XP</small></div></div>';counter.innerHTML='';return}const progress=Math.min(100,Math.max(0,d.progress));result.innerHTML=`<div class="requirement-head"><div class="requirement-title">Training requirement</div><div class="requirement-main"><div><div class="xp">${compact(d.requiredXP)} <small>XP</small></div><div style="color:#648592;font:800 9px ui-monospace,monospace;margin-top:6px">${fmt(d.requiredXP)} XP required</div></div><div class="requirement-path">Level ${d.currentLevel} → Level ${d.targetLevel}</div></div></div><div class="requirement-grid"><div class="metric"><span>CARDS NEEDED</span><strong>${fmt(d.playersRequired)}</strong><small>${d.fodder.label} OVR fodder</small></div><div class="metric"><span>XP SUPPLIED</span><strong>${compact(d.xpProvided)}</strong><small>${fmt(d.xpProvided)} XP</small></div><div class="metric"><span>EXTRA XP</span><strong>${compact(d.excessXP)}</strong><small>${fmt(d.excessXP)} XP over target</small></div></div><div class="progress-wrap"><div class="progress-head"><span>Training progress</span><strong>${Math.round(progress)}%</strong></div><div class="progress"><i style="width:${progress}%"></i></div></div>`;summary.innerHTML=`${d.fodder.label} · ${fmt(d.fodder.xp)} XP / card`;const max=Math.max(...FODDER_XP.map(x=>Math.ceil(d.requiredXP/x.xp)));counter.innerHTML=`<div class="fodder-grid">${FODDER_XP.map(x=>{const n=Math.ceil(d.requiredXP/x.xp),selected=x.id===fodder.value;return `<div class="fodder-row ${selected?'selected':''}"><div class="range">${selected?'<span class="tick">✓</span>':''}${x.label}</div><div class="xpbar"><i style="width:${Math.max(3,n/max*100)}%"></i></div><div class="count"><strong>${fmt(n)}</strong><small>CARDS · ${fmt(n*x.xp)} XP</small></div></div>`}).join('')}</div>`}
[current,target,fodder].forEach(x=>x.addEventListener('input',render));document.querySelectorAll('[data-add]').forEach(b=>b.addEventListener('click',()=>{target.value=String(Math.min(30,Number(current.value)+Number(b.dataset.add)));render()}));document.querySelector('#max').addEventListener('click',()=>{target.value='30';render()});render();
</script>