.training-page .guide-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start;min-height:170px;padding:20px;border:1px solid var(--line-soft);border-radius:20px;background:linear-gradient(145deg,#0b2238,#081827);overflow:hidden;transition:border-color .25s,transform .25s,box-shadow .25s}
.training-page .guide-card::after{content:"";position:absolute;width:150px;height:150px;right:-70px;bottom:-80px;border-radius:50%;background:rgba(76,201,255,.09);filter:blur(24px)}
