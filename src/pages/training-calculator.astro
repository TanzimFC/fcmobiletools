---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FODDER_XP, TRAINING_LEVEL_XP } from '../data/trainingCalculator.js';
---
<BaseLayout title="FC Mobile Training Calculator" description="Calculate FC Mobile training XP and fodder cards needed for each training level">
<div class="training-page">
  <section class="training-hero">
    <div><span class="eyebrow">FC MOBILE TOOLS</span><h1>Training Calculator</h1><p>Plan your training XP and see exactly how many fodder cards you need</p></div>
    <div class="verified-badge"><span></span> Working data set</div>
  </section>
  <main class="training-shell">
    <section class="calculator-card setup-card">
      <div class="section-heading"><div><span class="step">01</span><h2>Training setup</h2></div><p>Choose your current level, target and fodder</p></div>
      <div class="fields">
        <label>Current Training Level<select id="currentLevel">{TRAINING_LEVEL_XP.map(item=><option value={item.level}>{item.level}</option>)}</select></label>
        <label>Target Training Level<select id="targetLevel">{TRAINING_LEVEL_XP.map(item=><option value={item.level} selected={item.level===30}>{item.level}</option>)}</select></label>
        <label>Training Fodder<select id="fodder">{FODDER_XP.map(item=><option value={item.id} selected={item.id==='60-69'}>{item.label} · {item.xp} XP</option>)}</select></label>
      </div>
      <div class="shortcuts"><span>Quick target</span><button data-add="1">+1</button><button data-add="5">+5</button><button data-add="10">+10</button><button id="max">MAX</button></div>
    </section>

    <section id="result" class="requirement-card" aria-live="polite"></section>

    <section class="calculator-card fodder-card">
      <div class="section-heading"><div><span class="step">02</span><h2>Fodder counter</h2></div><p>Every OVR range compared against your training requirement</p></div>
      <div class="counter-summary">
        <div><span>XP required</span><strong id="counter-target">160K</strong><small id="counter-target-full">(160,000 XP)</small></div>
        <div><span>Selected fodder</span><strong id="counter-selected">60–69 OVR</strong><small id="counter-selected-xp">120 XP / card</small></div>
      </div>
      <div class="fodder-table-wrap"><table class="fodder-table"><thead><tr><th>OVR range</th><th>XP / card</th><th>Cards needed</th><th>XP provided</th><th>Excess XP</th></tr></thead><tbody id="fodderCounter"></tbody></table></div>
    </section>

    <section class="calculator-card info-card"><details><summary>How the calculator works</summary><p>Required XP is the cumulative XP at the target level minus the cumulative XP at the current level. Cards needed are rounded up so the supplied XP reaches the requirement.</p><p class="notice">Rank training limits are not enforced yet because verified Rank → maximum Training Level values are not configured</p></details></section>
  </main>
</div>
</BaseLayout>

<style>
.training-page{min-height:100vh;background:radial-gradient(circle at 85% 0%,rgba(75,190,255,.16),transparent 35%),#07111a;color:#eaf7ff;padding:48px 20px 80px}.training-hero,.training-shell{max-width:1080px;margin:auto}.training-hero{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:30px 0 38px}.eyebrow,.step{font-size:11px;letter-spacing:.16em;font-weight:800;color:#6ed8ff}.training-hero h1{font-size:clamp(38px,6vw,64px);line-height:1;margin:10px 0 12px}.training-hero p{margin:0;color:#91a9b8;font-size:16px}.verified-badge{border:1px solid #214052;background:#0c1c27;padding:10px 14px;border-radius:999px;color:#9eb6c4;font-size:12px}.verified-badge span{display:inline-block;width:7px;height:7px;border-radius:50%;background:#62d5ff;margin-right:8px}.training-shell{display:grid;gap:18px}.calculator-card,.requirement-card{background:rgba(10,25,35,.92);border:1px solid #193746;border-radius:22px;box-shadow:0 18px 50px rgba(0,0,0,.22)}.calculator-card{padding:26px}.section-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.section-heading>div{display:flex;align-items:center;gap:12px}.section-heading h2{font-size:20px;margin:0}.section-heading p{margin:0;color:#75909e;font-size:13px}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}label{display:grid;gap:8px;font-size:12px;color:#a9c0cc;font-weight:700}select{width:100%;box-sizing:border-box;background:#081722;border:1px solid #244452;color:#effaff;border-radius:12px;padding:13px 12px;font:inherit;outline:none}select:focus{border-color:#58cfff;box-shadow:0 0 0 3px rgba(88,207,255,.1)}.shortcuts{display:flex;align-items:center;gap:8px;margin-top:18px;color:#6f8b99;font-size:12px}.shortcuts button{border:1px solid #244452;background:#0b202d;color:#bceaff;border-radius:9px;padding:8px 12px;cursor:pointer}.requirement-card{padding:26px;background:linear-gradient(145deg,#0b2533 0%,#08151e 62%);overflow:hidden;position:relative}.requirement-card:before{content:"";position:absolute;width:320px;height:320px;border:1px solid rgba(89,205,249,.12);border-radius:50%;right:-150px;top:-190px;box-shadow:0 0 0 55px rgba(89,205,249,.025),0 0 0 110px rgba(89,205,249,.02)}.requirement-top{position:relative;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start}.requirement-kicker{color:#6ed8ff;font-size:11px;text-transform:uppercase;letter-spacing:.15em;font-weight:900}.requirement-title{font-size:13px;color:#8da8b6;margin-top:6px}.xp-display{display:flex;align-items:baseline;gap:10px;margin:7px 0 4px}.xp-display strong{font-size:clamp(48px,8vw,78px);line-height:.95;letter-spacing:-.045em}.xp-display span{font-size:15px;color:#72909e;font-weight:800}.xp-full{font-size:12px;color:#587481}.level-track{position:relative;margin-top:26px;padding:17px 18px 16px;border:1px solid #193f4e;background:rgba(5,17,24,.56);border-radius:17px}.level-track-head{display:flex;justify-content:space-between;gap:15px;font-size:11px;color:#7694a2}.level-track-head strong{color:#d9f6ff}.track{height:10px;background:#102a36;border-radius:99px;margin:11px 0;overflow:hidden}.track i{display:block;height:100%;background:linear-gradient(90deg,#3eb5e7,#70dcff);border-radius:inherit;transition:width .2s}.track-labels{display:flex;justify-content:space-between;color:#52707d;font-size:10px}.requirement-side{min-width:210px;border:1px solid #235163;background:#071922;border-radius:18px;padding:17px}.side-label{display:block;color:#63818e;font-size:10px;text-transform:uppercase;letter-spacing:.09em}.side-fodder{font-size:17px;font-weight:900;margin:5px 0;color:#e9fbff}.side-xp{font-size:11px;color:#74a0af}.tick-fodder{display:flex;align-items:center;gap:7px;color:#a9eaff;font-size:11px;font-weight:800}.light-tick{display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:50%;background:#5bd3ff;color:#06202a;font-size:11px;font-weight:1000;box-shadow:0 0 12px rgba(91,211,255,.2)}.requirement-grid{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.requirement-stat{background:rgba(6,20,28,.82);border:1px solid #193b48;border-radius:14px;padding:14px 15px}.requirement-stat .stat-label{display:block;color:#607f8c;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px}.requirement-stat strong{display:block;font-size:20px;color:#f0fbff}.requirement-stat small{display:block;color:#5d7c89;font-size:9px;margin-top:3px}.fodder-card{padding-bottom:24px}.counter-summary{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}.counter-summary>div{background:#081923;border:1px solid #193744;border-radius:15px;padding:15px 16px}.counter-summary span{display:block;color:#66818e;font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px}.counter-summary strong{display:inline-block;font-size:20px}.counter-summary small{display:block;color:#73909e;font-size:10px;margin-top:3px}.fodder-table-wrap{overflow-x:auto;border:1px solid #193744;border-radius:16px}.fodder-table{width:100%;border-collapse:collapse;min-width:690px}.fodder-table th{padding:12px 14px;background:#0b202b;color:#6f8b99;font-size:10px;text-transform:uppercase;letter-spacing:.08em;text-align:left}.fodder-table td{padding:13px 14px;border-top:1px solid #173541;color:#c8dbe3;font-size:12px}.fodder-table tbody tr{background:#081923;transition:background .15s}.fodder-table tbody tr:hover{background:#0b202b}.fodder-table tbody tr.selected-row{background:#0a2632}.fodder-table tbody tr.selected-row td:first-child{box-shadow:inset 3px 0 #59cdf9}.fodder-table td strong{font-size:14px;color:#f0fbff}.xp-cell{color:#8fdcff!important;font-weight:800}.cards-cell{font-weight:900;color:#f0fbff!important}.table-bar{height:5px;width:100%;margin-top:6px;background:#102733;border-radius:99px;overflow:hidden}.table-bar i{display:block;height:100%;background:#347f9d;border-radius:inherit}.selected-row .table-bar i{background:#59cdf9}.info-card summary{cursor:pointer;font-weight:800}.info-card p{color:#86a0ad;line-height:1.65}.notice{padding:12px 14px;background:#0c202b;border:1px solid #204250;border-radius:12px;color:#8fc9df!important}@media(max-width:760px){.training-page{padding:25px 14px 60px}.training-hero{display:block}.calculator-card,.requirement-card{padding:19px;border-radius:17px}.section-heading{display:block}.section-heading p{margin-top:8px}.fields{grid-template-columns:1fr 1fr}.requirement-top{grid-template-columns:1fr}.requirement-side{min-width:0}.requirement-grid{grid-template-columns:1fr 1fr}.counter-summary{grid-template-columns:1fr 1fr}}@media(max-width:460px){.fields{grid-template-columns:1fr}.requirement-grid{grid-template-columns:1fr}.counter-summary{grid-template-columns:1fr}}
</style>

<script>
import { calculateTraining } from '../lib/trainingCalculator.js';
import { FODDER_XP } from '../data/trainingCalculator.js';
const current=document.querySelector('#currentLevel'),target=document.querySelector('#targetLevel'),fodder=document.querySelector('#fodder'),result=document.querySelector('#result'),counter=document.querySelector('#fodderCounter'),counterTarget=document.querySelector('#counter-target'),counterTargetFull=document.querySelector('#counter-target-full'),counterSelected=document.querySelector('#counter-selected'),counterSelectedXp=document.querySelector('#counter-selected-xp');
const format=n=>new Intl.NumberFormat('en-US').format(n);
const compact=n=>{if(n>=1000000000)return `${(n/1000000000).toFixed(n%1000000000?1:0)}B`;if(n>=1000000)return `${(n/1000000).toFixed(n%1000000?1:0)}M`;if(n>=1000)return `${(n/1000).toFixed(n%1000?1:0)}K`;return String(n)};
function render(){
 const data=calculateTraining({currentLevel:current.value,targetLevel:target.value,fodderId:fodder.value,pricePerCard:0});
 if(!data.valid){result.innerHTML=`<div class="requirement-kicker">Training requirement</div><div class="xp-display"><strong>0</strong><span>XP</span></div>`;counter.innerHTML='';return}
 const currentXP=data.requiredXP===0?0:data.requiredXP-(data.xpProvided-data.excessXP);
 const currentCumulative=Math.max(0, data.requiredXP===0 ? 0 : Number(data.requiredXP) + (Number(data.currentLevel)===Number(data.targetLevel)?0:0));
 const progress=Math.min(100,Math.max(0,data.progress));
 result.innerHTML=`<div class="requirement-top"><div><div class="requirement-kicker">Training requirement</div><div class="requirement-title">XP needed to move from Level ${data.currentLevel} to Level ${data.targetLevel}</div><div class="xp-display"><strong>${compact(data.requiredXP)}</strong><span>XP</span></div><div class="xp-full">${format(data.requiredXP)} XP total required</div><div class="level-track"><div class="level-track-head"><span>Training progress</span><strong>${Math.round(progress)}%</strong></div><div class="track"><i style="width:${progress}%"></i></div><div class="track-labels"><span>Level ${data.currentLevel}</span><span>Level ${data.targetLevel}</span></div></div></div><aside class="requirement-side"><span class="side-label">Using</span><div class="side-fodder">${data.fodder.label}</div><div class="side-xp">${format(data.fodder.xp)} XP per card</div><div class="tick-fodder"><span class="light-tick">✓</span> Selected fodder</div></aside></div><div class="requirement-grid"><div class="requirement-stat"><span class="stat-label">Cards needed</span><strong>${format(data.playersRequired)}</strong><small>fodder cards</small></div><div class="requirement-stat"><span class="stat-label">XP supplied</span><strong>${compact(data.xpProvided)}</strong><small>(${format(data.xpProvided)} XP)</small></div><div class="requirement-stat"><span class="stat-label">Extra XP</span><strong>${compact(data.excessXP)}</strong><small>(${format(data.excessXP)} XP)</small></div></div>`;
 counterTarget.textContent=compact(data.requiredXP);counterTargetFull.textContent=`(${format(data.requiredXP)} XP)`;counterSelected.textContent=data.fodder.label;counterSelectedXp.textContent=`${format(data.fodder.xp)} XP / card`;
 const maxCards=Math.max(...FODDER_XP.map(item=>Math.ceil(data.requiredXP/item.xp)));
 counter.innerHTML=FODDER_XP.map(item=>{const players=Math.ceil(data.requiredXP/item.xp),provided=players*item.xp,excess=provided-data.requiredXP,selected=item.id===fodder.value;return `<tr class="${selected?'selected-row':''}"><td><strong>${item.label}</strong>${selected?'<div class="tick-fodder"><span class="light-tick">✓</span> Selected</div>':''}</td><td class="xp-cell">${format(item.xp)} XP</td><td class="cards-cell">${format(players)}<div class="table-bar"><i style="width:${Math.max(2,(players/maxCards)*100)}%"></i></div></td><td>${format(provided)} XP</td><td>${format(excess)} XP</td></tr>`}).join('');
}
[current,target,fodder].forEach(el=>el.addEventListener('input',render));document.querySelectorAll('[data-add]').forEach(button=>button.addEventListener('click',()=>{target.value=String(Math.min(30,Number(current.value)+Number(button.dataset.add)));render()}));document.querySelector('#max').addEventListener('click',()=>{target.value='30';render()});render();
</script>
