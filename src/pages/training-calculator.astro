.training-page .calculator-shell::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),#e6fbff,var(--cyan),transparent);background-size:220% 100%;animation:sweep 5s linear infinite;opacity:.9}
@keyframes sweep{from{background-position:120% 0}to{background-position:-120% 0}}
.training-page .label{color:var(--cyan);font:600 13px/1 var(--sans);letter-spacing:.02em}
.training-page .planner-head{display:flex;justify-content:space-between;gap:20px;padding:30px;border-bottom:1px solid var(--line)}
.training-page .planner-head h2,.training-page .section-title h2,.training-page .faq h2{margin:10px 0 8px;color:var(--text);font:700 clamp(26px,3.4vw,34px)/1.05 var(--display);letter-spacing:-.04em}
.training-page .planner-head p,.training-page .section-title p{margin:0;color:var(--muted);font:400 14px/1.6 var(--sans)}
.training-page .max{align-self:flex-start;padding:10px 14px;border:1px solid rgba(76,201,255,.2);border-radius:999px;background:rgba(76,201,255,.06);color:var(--cyan);font:600 12px/1 var(--sans);white-space:nowrap}

/* Presets */
.training-page .presets{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:20px 30px 0}
.training-page .presets span{margin-right:6px;color:var(--dim);font:500 13px/1 var(--sans)}
.training-page .presets button{min-height:36px;padding:0 14px;border:1px solid var(--line-soft);border-radius:999px;background:rgba(9,29,47,.8);color:#bfe6f6;font:600 13px/1 var(--sans);cursor:pointer;transition:border-color .2s,background .2s,color .2s,transform .15s}
.training-page .presets button:hover{border-color:rgba(76,201,255,.5);background:rgba(76,201,255,.1);color:#fff}
.training-page .presets button:active{transform:scale(.96)}
.training-page .presets button:focus-visible,.training-page select:focus-visible,.training-page summary:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}

/* Fields */
.training-page .fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:16px 30px 12px}
.training-page .field{display:grid;gap:4px;padding:16px 16px 14px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:linear-gradient(145deg,#0b2238,#091b2e);transition:border-color .2s,box-shadow .2s}
.training-page .field:hover,.training-page .field:focus-within{border-color:rgba(76,201,255,.34);box-shadow:0 14px 36px rgba(0,0,0,.2)}
.training-page .field .cap{color:var(--dim);font:500 12px/1 var(--sans)}
.training-page .field .name{color:#e5f5fb;font:600 15px/1.2 var(--display);letter-spacing:-.01em;margin-bottom:8px}
.training-page .select{position:relative;display:block}
.training-page .select::after{content:"";position:absolute;right:16px;top:50%;width:8px;height:8px;margin-top:-6px;border-right:2px solid var(--cyan);border-bottom:2px solid var(--cyan);transform:rotate(45deg);pointer-events:none;transition:transform .2s}
.training-page .select:focus-within::after{transform:rotate(225deg);margin-top:-2px}
.training-page select{appearance:none;-webkit-appearance:none;width:100%;min-height:50px;padding:0 40px 0 14px;border:1px solid #21445a;border-radius:var(--r-md);background:#061522;color:var(--text);font:600 14px/1 var(--sans);cursor:pointer;transition:border-color .2s,box-shadow .2s}
.training-page select:hover{border-color:#2b607b}
.training-page select:focus{border-color:var(--cyan);box-shadow:0 0 0 4px rgba(76,201,255,.1)}
.training-page select option{background:#061522;color:#f2f8fc}
.training-page .error{margin:0 30px 12px;padding:12px 14px;border:1px solid rgba(255,140,120,.3);border-radius:var(--r-md);background:rgba(255,120,100,.07);color:#ffb4a6;font:500 13px/1.5 var(--sans)}

/* Results */
.training-page .summary-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.4fr);gap:12px;padding:6px 30px 2px}
.training-page .xp-summary,.training-page .metric-grid article{border:1px solid var(--line);border-radius:var(--r-lg);background:linear-gradient(150deg,#0b2943,#071a2b)}
.training-page .xp-summary{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:230px;padding:26px;overflow:hidden}
.training-page [data-spot]::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;background:radial-gradient(380px circle at var(--mx,50%) var(--my,50%),rgba(76,201,255,.15),transparent 62%)}
.training-page [data-spot]:hover::before{opacity:1}
.training-page .xs-main{position:relative;min-width:0}
.training-page .xp-summary small,.training-page .metric-grid small{color:#79a9bc;font:500 13px/1 var(--sans)}
.training-page .xp-summary strong{display:block;margin:12px 0 10px;color:var(--text);font:700 clamp(46px,5.6vw,76px)/.9 var(--display);letter-spacing:-.07em;font-variant-numeric:tabular-nums;text-shadow:0 0 40px rgba(76,201,255,.14)}
.training-page .xp-summary p{margin:0;color:var(--muted);font:400 13px/1.5 var(--sans)}
.training-page .summary-route{display:flex;align-items:center;gap:10px;margin-top:18px;color:#8ea9b9;font:600 12px/1 var(--sans)}
.training-page .summary-route i{width:46px;height:1px;background:linear-gradient(90deg,#29475a,var(--cyan))}
.training-page .gauge{position:relative;flex:none;width:128px;height:128px}
.training-page .gauge svg{width:100%;height:100%;overflow:visible}
.training-page .g-track{fill:none;stroke:rgba(150,210,235,.12);stroke-width:7}
.training-page .g-arc{fill:none;stroke:url(#gg);stroke-width:7;stroke-linecap:round;stroke-dasharray:100 100;stroke-dashoffset:100;filter:drop-shadow(0 0 6px rgba(76,201,255,.55));transition:stroke-dashoffset 1.1s cubic-bezier(.2,.75,.2,1)}
.training-page .gauge b{position:absolute;inset:0;display:grid;place-items:center;color:var(--ice);font:700 24px/1 var(--display);letter-spacing:-.04em}
.training-page .metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.training-page .metric-grid article{padding:20px;background:linear-gradient(145deg,#091f33,#071726);transition:border-color .2s,transform .2s}
.training-page .metric-grid article:hover{border-color:rgba(76,201,255,.3);transform:translateY(-2px)}
.training-page .metric-grid b{display:block;margin:12px 0 6px;color:#edfaff;font:700 clamp(26px,3vw,34px)/1 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.training-page .metric-grid span{color:#5f8196;font:400 12px/1 var(--sans)}

/* Progress + ladder */
.training-page .progress-card{margin:12px 30px 0;padding:18px 20px 20px;border:1px solid var(--line);border-radius:var(--r-lg);background:#071725}
.training-page .progress-meta{display:flex;justify-content:space-between;align-items:center;color:#7c98ab;font:600 12px/1 var(--sans)}
.training-page .progress-meta b{color:var(--cyan);font:700 14px/1 var(--display)}
.training-page .progress-track{height:8px;margin-top:12px;border-radius:999px;background:#102839;overflow:hidden}
.training-page .progress-track i{position:relative;display:block;width:0;height:100%;border-radius:inherit;background:linear-gradient(90deg,#238fc8,var(--cyan));box-shadow:0 0 16px rgba(76,201,255,.3);transition:width 1s cubic-bezier(.2,.75,.2,1);overflow:hidden}
.training-page .progress-track i::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.45) 50%,transparent 70%);transform:translateX(-100%);animation:glint 3.2s ease-in-out infinite}
@keyframes glint{60%,100%{transform:translateX(100%)}}
.training-page .ladder{display:grid;grid-template-columns:repeat(31,minmax(0,1fr));align-items:end;gap:4px;height:64px;margin-top:20px}
.training-page .ladder i{height:var(--h);border-radius:4px 4px 2px 2px;background:#10293b;transition:background .5s,box-shadow .5s,transform .5s}
.training-page .ladder i.on{background:linear-gradient(180deg,#5fd3ff,#1f7fb6);box-shadow:0 0 12px rgba(76,201,255,.25)}
.training-page .ladder i.end{background:linear-gradient(180deg,#fff,var(--cyan));box-shadow:0 0 18px rgba(76,201,255,.8);transform:scaleY(1.1);transform-origin:bottom}

/* Fodder guide */
.training-page .fodder-guide{margin:14px 30px 0;padding:22px;border:1px solid rgba(76,201,255,.16);border-radius:var(--r-lg);background:radial-gradient(520px 220px at 0% 0%,rgba(76,201,255,.06),transparent 65%),linear-gradient(150deg,#091c2e,#061522)}
.training-page .guide-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;padding-bottom:20px;border-bottom:1px solid var(--line-soft)}
.training-page .guide-head h3{margin:10px 0 8px;color:#e8f7fd;font:700 24px/1.05 var(--display);letter-spacing:-.04em}
.training-page .guide-head p{max-width:640px;margin:0;color:#7f9db0;font:400 14px/1.6 var(--sans)}
.training-page .guide-live{display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 12px;border:1px solid rgba(76,201,255,.16);border-radius:999px;color:#78a0b6;font:600 12px/1 var(--sans);white-space:nowrap}
.training-page .guide-live i{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px rgba(76,201,255,.9);animation:blink 2s ease-in-out infinite}
@keyframes blink{50%{opacity:.35}}
.training-page .guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}
.training-page .guide-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start;min-height:170px;padding:20px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:linear-gradient(145deg,#0b2238,#081827);overflow:hidden;transition:border-color .25s,transform .25s,box-shadow .25s}
.training-page .guide-card::after{content:"";position:absolute;width:150px;height:150px;right:-70px;bottom:-80px;border-radius:50%;background:rgba(76,201,255,.09);filter:blur(24px)}
.training-page .guide-card:hover{transform:translateY(-3px);border-color:rgba(76,201,255,.3);box-shadow:0 16px 40px rgba(0,0,0,.22)}
.training-page .guide-kicker{display:block;color:#6e9bb2;font:600 12px/1 var(--sans)}
.training-page .guide-copy h4{margin:10px 0 8px;color:#eaf8fd;font:700 22px/1.05 var(--display);letter-spacing:-.03em}
.training-page .guide-copy p{margin:0;color:#85a3b5;font:400 14px/1.65 var(--sans)}
.training-page .guide-copy p strong{color:#bdecff;font-weight:600}
.training-page .guide-stat{position:relative;z-index:1;min-width:84px;padding:12px 10px;border:1px solid rgba(76,201,255,.14);border-radius:var(--r-md);background:rgba(76,201,255,.05);text-align:center}
.training-page .guide-stat b{display:block;color:var(--cyan);font:700 24px/1 var(--display);letter-spacing:-.03em}
.training-page .guide-stat span{display:block;margin-top:7px;color:#5f8196;font:500 11px/1.2 var(--sans)}
.training-page .guide-note{display:flex;align-items:center;gap:14px;margin-top:12px;padding:14px 16px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:#071725}
.training-page .guide-note>span{display:grid;place-items:center;flex:0 0 32px;height:32px;border:1px solid rgba(76,201,255,.18);border-radius:var(--r-md);color:var(--cyan);font:600 16px/1 var(--sans);animation:spin 8s linear infinite}
.training-page .guide-note p{flex:1;margin:0;color:#7f9db0;font:400 13px/1.6 var(--sans)}
.training-page .guide-note p strong{color:#bdecff;font-weight:600}
.training-page .guide-note>b{color:#78a0b6;font:600 12px/1 var(--sans);white-space:nowrap}

/* Level breakdown */
.training-page .break{margin-top:24px;border-top:1px solid var(--line)}
.training-page .break-title{padding:28px 30px 16px}
.training-page .break-title h3{margin:10px 0 6px;color:#e6f5fb;font:700 24px/1.05 var(--display);letter-spacing:-.04em}
.training-page .break-title p{margin:0;color:#7f9db0;font:400 14px/1.5 var(--sans)}
.training-page .level-cards{display:grid;gap:8px;padding:0 30px 30px}
.training-page .level-card{border:1px solid var(--line-soft);border-radius:var(--r-lg);background:#081827;overflow:hidden;animation:cardIn .5s cubic-bezier(.2,.75,.2,1) both;animation-delay:calc(var(--i,0) * 35ms);transition:border-color .2s,background .2s}
@keyframes cardIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.training-page .level-card:hover{border-color:rgba(76,201,255,.24)}
.training-page .level-card[open]{border-color:rgba(76,201,255,.28);background:#0a1c2c}
.training-page .level-card summary{display:grid;grid-template-columns:minmax(0,1fr) auto 24px;gap:14px;align-items:center;padding:16px 18px;cursor:pointer;list-style:none}
.training-page .level-card summary::-webkit-details-marker{display:none}
.training-page .lc-title{display:block;min-width:0}
.training-page .lc-title b{display:block;color:#e7f6fb;font:600 15px/1.2 var(--display)}
.training-page .lc-title small{display:block;margin-top:5px;color:#6c8ea2;font:400 12px/1 var(--sans)}
.training-page .lc-bar{display:block;height:3px;margin-top:11px;border-radius:99px;background:#112a3c;overflow:hidden}
.training-page .lc-bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#238fc8,var(--cyan))}
.training-page .level-card summary strong{color:var(--cyan);font:700 14px/1 var(--display);font-variant-numeric:tabular-nums}
.training-page .lc-plus{font-style:normal;color:#6c8ea2;font-size:22px;line-height:1;text-align:center;transition:transform .25s,color .25s}
.training-page .level-card[open] .lc-plus{transform:rotate(45deg);color:var(--cyan)}
.training-page .level-detail{display:grid;grid-template-columns:1fr auto;gap:10px 14px;padding:14px 18px 18px;border-top:1px solid var(--line-soft);color:#7f9db0;font:400 13px/1.3 var(--sans)}
.training-page .level-detail b{color:#e6f6fb;font:700 13px/1.3 var(--display)}
.training-page .empty-breakdown{padding:20px;border:1px dashed var(--line);border-radius:var(--r-md);color:var(--muted);font:400 14px/1.5 var(--sans)}

/* Reference */
.training-page .reference{position:relative;z-index:1;padding:76px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(76,201,255,.025),transparent 24%),#06121f}
.training-page .section-title{margin-bottom:26px}
.training-page .reference-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;align-items:start}
.training-page .ref-card{border:1px solid var(--line);border-radius:var(--r-lg);background:linear-gradient(155deg,#0a1b2d,#061321);overflow:hidden}
.training-page .ref-card h3{margin:0;padding:20px 22px;border-bottom:1px solid var(--line);color:#e6f6fb;font:700 18px/1 var(--display);letter-spacing:-.02em}
.training-page .scroll{max-height:560px;overflow:auto}
.training-page table{width:100%;border-collapse:collapse;min-width:520px}
.training-page th{position:sticky;top:0;z-index:1;padding:12px 22px;background:#08182a;color:#6d8ea3;font:600 12px/1 var(--sans);text-align:left;border-bottom:1px solid var(--line-soft)}
.training-page td{padding:13px 22px;border-top:1px solid var(--line-soft);color:#cfe3ed;font:500 13px/1 var(--sans);text-align:left;font-variant-numeric:tabular-nums;transition:background .3s,color .3s}
.training-page tbody tr:hover td{background:rgba(76,201,255,.04)}
.training-page tbody tr.in-route td{background:rgba(76,201,255,.07);color:#eaf9ff}
.training-page tbody tr.in-route td:first-child{box-shadow:inset 3px 0 0 var(--cyan)}
.training-page .fodder-grid{display:grid;gap:8px;padding:16px}
.training-page .fodder-grid div{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border:1px solid var(--line-soft);border-radius:var(--r-md);background:#081a2a;transition:border-color .3s,background .3s}
.training-page .fodder-grid span{color:#86a3b5;font:500 13px/1 var(--sans)}
.training-page .fodder-grid b{color:var(--cyan);font:700 13px/1 var(--display)}
.training-page .fodder-grid div.sel{border-color:rgba(76,201,255,.5);background:rgba(76,201,255,.09);box-shadow:0 0 24px rgba(76,201,255,.1)}
.training-page .fodder-grid div.sel span{color:#fff}

/* FAQ */
.training-page .faq{position:relative;z-index:1;padding:72px 0 84px}
.training-page .faq details{border-top:1px solid var(--line-soft);padding:0}
.training-page .faq details:last-child{border-bottom:1px solid var(--line-soft)}
.training-page .faq summary{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 0;color:#e5f5fb;font:600 16px/1.3 var(--display);cursor:pointer;list-style:none}
.training-page .faq summary::-webkit-details-marker{display:none}
.training-page .faq summary::after{content:"+";color:#6c8ea2;font:400 24px/1 var(--sans);transition:transform .25s,color .25s}
.training-page .faq details[open] summary::after{transform:rotate(45deg);color:var(--cyan)}
.training-page .faq p{max-width:720px;margin:0;padding:0 0 22px;color:#86a3b5;font:400 15px/1.7 var(--sans)}

/* Tabs and actions */
.training-page .shell-bar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px 24px;border-bottom:1px solid var(--line)}
.training-page .tabs{position:relative;display:inline-flex;padding:4px;border:1px solid var(--line);border-radius:999px;background:#071725}
.training-page .tab-ink{position:absolute;left:0;top:4px;bottom:4px;width:0;border:1px solid rgba(76,201,255,.34);border-radius:999px;background:linear-gradient(135deg,#14425f,#0d2c44);box-shadow:0 0 24px rgba(76,201,255,.16);transition:transform .5s cubic-bezier(.3,.8,.2,1),width .5s cubic-bezier(.3,.8,.2,1)}
.training-page .tab{position:relative;z-index:1;display:inline-flex;align-items:center;gap:9px;min-height:42px;padding:0 20px;border:0;border-radius:999px;background:transparent;color:var(--muted);font:600 14px/1 var(--sans);cursor:pointer;transition:color .25s}
.training-page .tab:hover{color:#dff5ff}
.training-page .tab[aria-selected="true"]{color:#fff}
.training-page .tab:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.training-page .tab-token{width:24px;height:24px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(76,201,255,.4))}
.training-page .bar-actions{display:flex;gap:8px}
.training-page .ghost{min-height:38px;padding:0 15px;border:1px solid var(--line-soft);border-radius:999px;background:rgba(9,29,47,.8);color:#bfe6f6;font:600 13px/1 var(--sans);cursor:pointer;transition:border-color .2s,background .2s,color .2s,transform .15s}
.training-page .ghost:hover{border-color:rgba(76,201,255,.5);background:rgba(76,201,255,.1);color:#fff}
.training-page .ghost:active{transform:scale(.96)}
.training-page .ghost.ok{border-color:rgba(110,230,170,.6);color:#9df0c6}
.training-page .ghost:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.training-page .panel:not([hidden]){animation:panelIn .55s cubic-bezier(.2,.75,.2,1) both}
@keyframes panelIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* Bronze Fodder planner */
.training-page .bronze{margin:14px 30px 0;padding:22px;border:1px solid rgba(76,201,255,.16);border-radius:var(--r-lg);background:radial-gradient(480px 200px at 100% 0%,rgba(76,201,255,.06),transparent 65%),linear-gradient(150deg,#091c2e,#061522)}
.training-page .bz-head h3{margin:10px 0 8px;color:#e8f7fd;font:700 24px/1.05 var(--display);letter-spacing:-.04em}
.training-page .bz-head p{max-width:680px;margin:0;color:#7f9db0;font:400 14px/1.6 var(--sans)}
.training-page .bz-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:18px}
.training-page .bz-grid article{padding:16px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:#071725;transition:border-color .2s,transform .2s}
.training-page .bz-grid article:hover{border-color:rgba(76,201,255,.3);transform:translateY(-2px)}
.training-page .bz-grid small{display:block;color:#79a9bc;font:500 12px/1.3 var(--sans)}
.training-page .bz-grid b{display:block;margin:10px 0 6px;color:#edfaff;font:700 clamp(22px,2.6vw,30px)/1 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.training-page .bz-grid span{color:#5f8196;font:400 12px/1 var(--sans)}
.training-page .bz-note{margin:14px 0 0;color:#7f9db0;font:400 13px/1.5 var(--sans)}

/* Training Transfer */
.training-page .tx-intro .intro-main{display:flex;align-items:center;gap:22px}
.training-page .tx-intro p{max-width:640px}
.training-page .token-wrap{position:relative;flex:none;display:grid;place-items:center;width:104px;height:104px}
.training-page .token-wrap::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,rgba(76,201,255,0),rgba(76,201,255,.55),rgba(76,201,255,0) 60%);-webkit-mask:radial-gradient(circle,transparent 60%,#000 62%);mask:radial-gradient(circle,transparent 60%,#000 62%);animation:spin 6s linear infinite}
.training-page .token-wrap::after{content:"";position:absolute;inset:14px;border-radius:50%;background:radial-gradient(circle,rgba(76,201,255,.18),transparent 70%)}
.training-page .token{position:relative;z-index:1;width:82px;height:82px;object-fit:contain;filter:drop-shadow(0 10px 22px rgba(76,201,255,.38));animation:floaty 5s ease-in-out infinite}
.training-page .tx-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:20px 30px 6px}
.training-page .tx-card{padding:22px;border:1px solid var(--line);border-radius:var(--r-lg);background:linear-gradient(150deg,#0a2236,#071a2b)}
.training-page .tx-card h3{margin:0 0 6px;color:#e8f7fd;font:700 21px/1.1 var(--display);letter-spacing:-.04em}
.training-page .tx-sub{margin:0 0 16px;color:#7f9db0;font:400 13px/1.55 var(--sans)}
.training-page .fields.fields-3,.training-page .fields.fields-2{padding:0;gap:10px}
.training-page .fields.fields-2{grid-template-columns:repeat(2,minmax(0,1fr))}
