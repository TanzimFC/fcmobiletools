---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';
const fmt = (n) => Number(n).toLocaleString();
const nextXp = (i) => i < MAX_TRAINING_LEVEL ? `${fmt(TRAINING_LEVELS[i + 1] - TRAINING_LEVELS[i])} XP` : 'MAX';
const maxXp = TRAINING_LEVELS[MAX_TRAINING_LEVEL];
---
<BaseLayout title="FC Mobile Training Calculator | XP Calculator | FCMOBILETOOLS" description="Calculate FC Mobile Training XP, cards required, excess XP and every Training Level from 0 to 30 with a complete reference table.">
<main class="training-page">
<div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>

<header class="hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Training Calculator</span></nav>
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><i></i>FC Mobile Training Lab</span>
        <h1>
          <span class="rise" style="--d:0s"><span>Training</span></span>
          <span class="rise" style="--d:.12s"><span><em>Calculator</em></span></span>
        </h1>
        <p class="lede">Work out the exact XP needed to reach any Training Level, how many cards it takes and how much XP is left over.</p>
        <div class="hero-stats">
          <div><b>{MAX_TRAINING_LEVEL}</b><span>Training levels</span></div>
          <div><b>{fmt(maxXp)}</b><span>XP to max out</span></div>
          <div><b>{FODDER.length}</b><span>Fodder tiers</span></div>
        </div>
      </div>
      <div class="hero-mark" id="heroMark" aria-hidden="true">
        <div class="hm-ring hm-r1"></div>
        <div class="hm-ring hm-r2"></div>
        <div class="hm-orbit"><i></i></div>
        <div class="hm-orbit hm-orbit-2"><i></i></div>
        <strong>XP</strong>
        <small>Training</small>
        <span class="hm-chip hm-c1">Level {MAX_TRAINING_LEVEL} max</span>
        <span class="hm-chip hm-c2">{FODDER.length} fodder tiers</span>
      </div>
    </div>
  </div>
</header>

<section class="wrap section">
<div class="calculator-shell">
  <div class="planner-head">
    <div>
      <span class="label">XP planner</span>
      <h2>Build your training plan</h2>
      <p>Pick a start level, a target level and a fodder card. Results update as you change them.</p>
    </div>
    <b class="max">Max level {MAX_TRAINING_LEVEL}</b>
  </div>

  <div class="presets" role="group" aria-label="Quick targets">
    <span>Quick set</span>
    <button type="button" data-preset="10">Level 0 to 10</button>
    <button type="button" data-preset="20">Level 0 to 20</button>
    <button type="button" data-preset="30">Level 0 to 30</button>
    <button type="button" data-preset="next">Next level</button>
  </div>

  <div class="fields">
    <label class="field"><span class="cap">Start</span><span class="name">Current Level</span><span class="select"><select id="currentLevel">{TRAINING_LEVELS.map((_, i) => <option value={i}>Level {i}</option>)}</select></span></label>
    <label class="field"><span class="cap">Goal</span><span class="name">Target Level</span><span class="select"><select id="targetLevel">{TRAINING_LEVELS.map((_, i) => <option value={i}>Level {i}</option>)}</select></span></label>
    <label class="field"><span class="cap">Cards</span><span class="name">Fodder OVR</span><span class="select"><select id="fodderId">{FODDER.map((f) => <option value={f.id}>{f.label}: {fmt(f.xp)} XP</option>)}</select></span></label>
  </div>

  <div id="error" class="error" role="alert" hidden></div>

  <div class="summary-grid">
    <article class="xp-summary" data-spot>
      <div class="xs-main">
        <small>XP required</small>
        <strong id="required">0</strong>
        <p id="summary">Choose your levels</p>
        <div class="summary-route"><span id="summaryFrom">Level 0</span><i></i><span id="summaryTo">Level 30</span></div>
      </div>
      <div class="gauge" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><linearGradient id="gg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2b8cff"/><stop offset="1" stop-color="#8be3ff"/></linearGradient></defs>
          <circle class="g-track" cx="60" cy="60" r="52" />
          <circle id="gaugeArc" class="g-arc" cx="60" cy="60" r="52" pathLength="100" transform="rotate(-90 60 60)" />
        </svg>
        <b id="gaugePct">0%</b>
      </div>
    </article>
    <div class="metric-grid">
      <article><small>Required players</small><b id="cards">0</b><span>Cards</span></article>
      <article><small>XP per card</small><b id="perCard">0</b><span>Selected fodder</span></article>
      <article><small>Levels gained</small><b id="gained">0</b><span>Selected route</span></article>
      <article><small>Excess XP</small><b id="extra">0</b><span>After training</span></article>
    </div>
  </div>

  <div class="progress-card">
    <div class="progress-meta"><span id="from">Level 0</span><b id="pct">0%</b><span id="to">Level 30</span></div>
    <div class="progress-track"><i id="fill"></i></div>
    <div id="ladder" class="ladder" aria-hidden="true"></div>
  </div>

  <section class="fodder-guide" aria-label="Training fodder guide">
    <div class="guide-head">
      <div>
        <span class="label">Training fodder guide</span>
        <h3>How to build your training stock</h3>
        <p>Use the calculator for the exact XP requirement, then use the route below to keep your club supplied with training cards.</p>
      </div>
      <span class="guide-live"><i></i>Daily route</span>
    </div>
    <div class="guide-grid">
      <article class="guide-card recommended">
        <div class="guide-copy">
          <span class="guide-kicker">Direct fodder pick</span>
          <h4>60–69 OVR</h4>
          <p><strong>120 XP per card</strong> makes 60–69 OVR a strong everyday choice when you want a quick, straightforward training loop with a modest card cost.</p>
        </div>
        <div class="guide-stat"><b>120</b><span>XP per card</span></div>
      </article>
      <article class="guide-card exchange">
        <div class="guide-copy">
          <span class="guide-kicker">Bronze exchange</span>
          <h4>30 Bronze Players</h4>
          <p><strong>Bronze = 69 OVR or below.</strong> Use the player exchange to obtain 30 Bronze players for <strong>1,000,000 Coins</strong>, then feed those cards into training.</p>
        </div>
        <div class="guide-stat"><b>20×</b><span>Daily limit</span></div>
      </article>
    </div>
    <div class="guide-note"><span>↻</span><p><strong>Daily refresh:</strong> the exchange resets each day. At the 20-exchange limit, that is up to <strong>600 Bronze players per day</strong> for a maximum exchange spend of <strong>20,000,000 Coins</strong>.</p><b>20 × 1M Coins</b></div>
  </section>

  <div class="break">
    <div class="break-title"><span class="label">Level breakdown</span><h3>Expandable training levels</h3><p>Open a level to see the XP added and the cumulative total.</p></div>
    <div id="breakdown" class="level-cards"></div>
  </div>
</div>
</section>

<section class="reference">
  <div class="wrap">
    <div class="section-title"><span class="label">Reference data</span><h2>FC Mobile Training XP table</h2><p>All 31 levels and every fodder value. Levels inside your selected route are highlighted.</p></div>
    <div class="reference-grid">
      <div class="ref-card"><h3>XP by Training Level</h3><div class="scroll"><table><thead><tr><th>Level</th><th>Total XP</th><th>XP to next</th></tr></thead><tbody>{TRAINING_LEVELS.map((xp, i) => <tr data-level-row={i}><td>Level {i}</td><td>{fmt(xp)} XP</td><td>{nextXp(i)}</td></tr>)}</tbody></table></div></div>
      <div class="ref-card"><h3>Fodder XP Values</h3><div class="fodder-grid">{FODDER.map((f) => <div data-fodder={f.id}><span>{f.label}</span><b>{fmt(f.xp)} XP</b></div>)}</div></div>
    </div>
  </div>
</section>

<section class="faq">
  <div class="wrap">
    <span class="label">FAQ</span>
    <h2>FC Mobile Training Calculator FAQ</h2>
    <details open><summary>How much XP do I need?</summary><p>The calculator subtracts the stored cumulative XP of the current level from the target level.</p></details>
    <details><summary>How are cards calculated?</summary><p>Required XP is divided by the selected fodder XP and rounded up to a whole card.</p></details>
    <details><summary>What is the highest Training Level?</summary><p>Training goes up to Level {MAX_TRAINING_LEVEL}. Maxing a player from Level 0 takes {fmt(maxXp)} XP in total.</p></details>
  </div>
</section>
</main>

<script>
import { calculateTraining } from '../lib/fcMobileTraining.js';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';

const page = document.querySelector('.training-page');
page?.classList.add('js');
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const $ = (id) => document.getElementById(id);
const fmt = (n) => Number(n).toLocaleString();
const current = $('currentLevel');
const target = $('targetLevel');
const fodder = $('fodderId');
current.value = '0';
target.value = String(MAX_TRAINING_LEVEL);
fodder.value = FODDER[FODDER.length - 1].id;

/* Animated number counter: tweens from the last shown value to the new one */
const counters = new WeakMap();
function tween(el, to) {
  to = Number(to);
  const prev = counters.get(el);
  if (prev && prev.raf) cancelAnimationFrame(prev.raf);
  const from = prev ? prev.value : 0;
  if (reduce || from === to) {
    el.textContent = fmt(to);
    counters.set(el, { value: to, raf: 0 });
    return;
  }
  const state = { value: from, raf: 0 };
  counters.set(el, state);
  const start = performance.now();
  const dur = 750;
  const step = (now) => {
    const t = Math.min(1, (now - start) / dur);
    const e = 1 - Math.pow(1 - t, 4);
    state.value = t < 1 ? Math.round(from + (to - from) * e) : to;
    el.textContent = fmt(state.value);
    if (t < 1) state.raf = requestAnimationFrame(step);
  };
  state.raf = requestAnimationFrame(step);
}

/* Level ladder: one bar per level, lit across the selected route */
const ladder = $('ladder');
ladder.innerHTML = TRAINING_LEVELS.map((_, i) => `<i style="--h:${Math.round(26 + (i / MAX_TRAINING_LEVEL) * 74)}%"></i>`).join('');
const bars = Array.from(ladder.children);
const rows = Array.from(document.querySelectorAll('[data-level-row]'));
const fodderItems = Array.from(document.querySelectorAll('[data-fodder]'));

function render() {
  const d = calculateTraining({ currentLevel: current.value, targetLevel: target.value, fodderId: fodder.value });
  if (!d.valid) {
    $('error').hidden = false;
    $('error').textContent = d.error;
    return;
  }
  $('error').hidden = true;
  tween($('required'), d.requiredXP);
  tween($('cards'), d.cards);
  tween($('perCard'), d.fodder.xp);
  tween($('extra'), d.extraXP);
  tween($('gained'), d.targetLevel - d.currentLevel);
  $('summary').textContent = `Level ${d.currentLevel} to Level ${d.targetLevel} using ${d.fodder.label}`;
  $('summaryFrom').textContent = `Level ${d.currentLevel}`;
  $('summaryTo').textContent = `Level ${d.targetLevel}`;
  $('from').textContent = `Level ${d.currentLevel}`;
  $('to').textContent = `Level ${d.targetLevel}`;
  const pct = Math.round(d.targetLevel / MAX_TRAINING_LEVEL * 100);
  $('pct').textContent = `${pct}%`;
  $('gaugePct').textContent = `${pct}%`;
  $('fill').style.width = `${pct}%`;
  $('gaugeArc').style.strokeDashoffset = String(100 - pct);

  bars.forEach((bar, i) => {
    const on = i >= d.currentLevel && i <= d.targetLevel;
    bar.classList.toggle('on', on);
    bar.classList.toggle('end', i === d.currentLevel || i === d.targetLevel);
    bar.style.transitionDelay = reduce ? '0s' : `${Math.abs(i - d.currentLevel) * 12}ms`;
  });
  rows.forEach((row) => {
    const lv = Number(row.dataset.levelRow);
    row.classList.toggle('in-route', lv >= d.currentLevel && lv <= d.targetLevel);
  });
  fodderItems.forEach((item) => item.classList.toggle('sel', item.dataset.fodder === String(fodder.value)));

  const steps = [];
  for (let i = d.currentLevel; i < d.targetLevel; i++) steps.push(TRAINING_LEVELS[i + 1] - TRAINING_LEVELS[i]);
  const biggest = Math.max(1, ...steps);
  const html = [];
  steps.forEach((step, n) => {
    const i = d.currentLevel + n;
    const w = Math.max(4, Math.round(step / biggest * 100));
    html.push(`<details class="level-card" style="--i:${Math.min(n, 14)}" ${n === 0 ? 'open' : ''}><summary><span class="lc-title"><b>Level ${i} to ${i + 1}</b><small>${fmt(step)} XP added</small><em class="lc-bar"><i style="width:${w}%"></i></em></span><strong>${fmt(TRAINING_LEVELS[i + 1])} XP</strong><i class="lc-plus">+</i></summary><div class="level-detail"><span>Required for this step</span><b>${fmt(step)} XP</b><span>Cumulative XP</span><b>${fmt(TRAINING_LEVELS[i + 1])} XP</b></div></details>`);
  });
  $('breakdown').innerHTML = html.join('') || '<div class="empty-breakdown">No XP required. Pick a target level above your current level.</div>';
}

[current, target, fodder].forEach((e) => e.addEventListener('change', render));

document.querySelectorAll('[data-preset]').forEach((btn) => {
  btn.addEventListener('click', () => {
    const p = btn.dataset.preset;
    if (p === 'next') target.value = String(Math.min(MAX_TRAINING_LEVEL, Number(current.value) + 1));
    else { current.value = '0'; target.value = p; }
    render();
  });
});

/* Light follows the pointer on the result card */
page?.addEventListener('pointermove', (e) => {
  const card = e.target.closest ? e.target.closest('[data-spot]') : null;
  if (!card) return;
  const r = card.getBoundingClientRect();
  card.style.setProperty('--mx', `${e.clientX - r.left}px`);
  card.style.setProperty('--my', `${e.clientY - r.top}px`);
}, { passive: true });

/* Hero emblem tilts toward the pointer */
const mark = $('heroMark');
if (mark && !reduce && window.matchMedia('(hover: hover)').matches) {
  const hero = mark.closest('.hero');
  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    mark.style.setProperty('--rx', `${(-y * 10).toFixed(2)}deg`);
    mark.style.setProperty('--ry', `${(x * 14).toFixed(2)}deg`);
  }, { passive: true });
  hero.addEventListener('pointerleave', () => {
    mark.style.setProperty('--rx', '0deg');
    mark.style.setProperty('--ry', '0deg');
  });
}

render();
</script>

<style is:global>
.training-page{
  --bg:#050d17;--deep:#030912;--surface:#0a1a2b;--surface2:#0c2136;
  --line:rgba(98,168,206,.2);--line-soft:rgba(98,168,206,.11);
  --text:#f2f8fc;--muted:#8aa7b9;--dim:#5d7d92;--cyan:#4cc9ff;--ice:#d8f6ff;
  --display:'Space Grotesk',system-ui,sans-serif;--sans:'Inter',system-ui,sans-serif;
  position:relative;overflow-x:clip;color:var(--text);font-family:var(--sans);padding-bottom:24px;
  background:radial-gradient(900px 560px at 6% 0%,rgba(76,201,255,.10),transparent 64%),radial-gradient(800px 520px at 100% 22%,rgba(76,201,255,.06),transparent 68%),linear-gradient(180deg,var(--bg),var(--deep));
}
.training-page *{box-sizing:border-box}
.training-page .wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}

/* Ambient light */
.training-page .ambient{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.training-page .ambient i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;will-change:transform}
.training-page .ambient i:nth-child(1){width:420px;height:420px;left:-120px;top:120px;background:rgba(76,201,255,.13);animation:drift1 18s ease-in-out infinite alternate}
.training-page .ambient i:nth-child(2){width:360px;height:360px;right:-100px;top:520px;background:rgba(43,140,255,.12);animation:drift2 22s ease-in-out infinite alternate}
.training-page .ambient i:nth-child(3){width:300px;height:300px;left:40%;top:1300px;background:rgba(76,201,255,.07);animation:drift1 26s ease-in-out infinite alternate-reverse}
@keyframes drift1{to{transform:translate(90px,70px) scale(1.12)}}
@keyframes drift2{to{transform:translate(-80px,-60px) scale(1.15)}}

/* Hero */
.training-page .hero{position:relative;z-index:1;border-bottom:1px solid var(--line);overflow:hidden}
.training-page .hero::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.5;background-image:linear-gradient(rgba(76,201,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.05) 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(100deg,#000 0%,#000 40%,transparent 85%)}
.training-page .hero>.wrap{position:relative;padding:30px 0 68px}
.training-page .crumbs{display:flex;gap:10px;margin-bottom:64px;color:var(--dim);font:600 12px/1 var(--sans)}
.training-page .crumbs a{color:var(--cyan);text-decoration:none}
.training-page .crumbs a:hover{text-decoration:underline}
.training-page .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:72px;align-items:center}
.training-page .eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--cyan);font:600 13px/1 var(--sans);letter-spacing:.02em}
.training-page .eyebrow i{width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 rgba(76,201,255,.6);animation:ping 2.4s ease-out infinite}
@keyframes ping{70%,100%{box-shadow:0 0 0 12px rgba(76,201,255,0)}}
.training-page h1{margin:18px 0 20px;color:var(--text);font:700 clamp(56px,8.4vw,108px)/.9 var(--display);letter-spacing:-.06em}
.training-page .rise{display:block;overflow:hidden;padding:.04em 0 .12em}
.training-page .rise>span{display:block}
.training-page .js .rise>span{animation:rise 1s cubic-bezier(.2,.75,.2,1) both;animation-delay:calc(.55s + var(--d,0s))}
@keyframes rise{from{transform:translateY(112%)}to{transform:none}}
.training-page h1 em{font-style:normal;background:linear-gradient(100deg,#2b8cff 10%,#4cc9ff 35%,#e6fbff 50%,#4cc9ff 65%,#2b8cff 90%);background-size:240% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 6s linear infinite}
@keyframes shine{from{background-position:100% 0}to{background-position:-140% 0}}
.training-page .lede{max-width:560px;margin:0;color:var(--muted);font:400 17px/1.65 var(--sans)}
.training-page .js .lede,.training-page .js .hero-stats,.training-page .js .hero-mark,.training-page .js .crumbs,.training-page .js .eyebrow{animation:fadeIn .9s ease both}
.training-page .js .crumbs{animation-delay:.4s}
.training-page .js .eyebrow{animation-delay:.5s}
.training-page .js .lede{animation-delay:1s}
.training-page .js .hero-stats{animation-delay:1.15s}
.training-page .js .hero-mark{animation-delay:.8s;animation-duration:1.3s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.training-page .hero-stats{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.training-page .hero-stats div{min-width:132px;padding:14px 18px;border:1px solid var(--line-soft);border-radius:16px;background:rgba(8,26,42,.6);backdrop-filter:blur(8px)}
.training-page .hero-stats b{display:block;font:700 24px/1 var(--display);letter-spacing:-.03em;color:var(--ice)}
.training-page .hero-stats span{display:block;margin-top:7px;color:var(--dim);font:500 12px/1 var(--sans)}

/* Hero emblem */
.training-page .hero-mark{--rx:0deg;--ry:0deg;position:relative;display:grid;place-items:center;align-content:center;width:100%;aspect-ratio:1;border:1px solid rgba(76,201,255,.18);border-radius:34px;background:radial-gradient(circle at 50% 50%,rgba(76,201,255,.16),transparent 46%),linear-gradient(155deg,#0b253b,#061523 75%);box-shadow:0 30px 90px rgba(0,0,0,.4),0 0 90px rgba(76,201,255,.07),inset 0 1px 0 rgba(255,255,255,.04);transform:perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));transition:transform .25s ease-out;overflow:hidden}
.training-page .hm-ring{position:absolute;border-radius:50%}
.training-page .hm-r1{width:76%;aspect-ratio:1;border:1px dashed rgba(76,201,255,.22);animation:spin 40s linear infinite}
.training-page .hm-r2{width:54%;aspect-ratio:1;border:1px solid rgba(76,201,255,.14);box-shadow:0 0 0 22px rgba(76,201,255,.02),0 0 60px rgba(76,201,255,.08) inset}
.training-page .hm-orbit{position:absolute;width:76%;aspect-ratio:1;animation:spin 9s linear infinite}
.training-page .hm-orbit i{position:absolute;top:-5px;left:50%;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:var(--cyan);box-shadow:0 0 18px 3px rgba(76,201,255,.8)}
.training-page .hm-orbit-2{width:54%;animation-duration:14s;animation-direction:reverse}
.training-page .hm-orbit-2 i{width:7px;height:7px;margin-left:-3.5px;top:-3.5px;background:#bff0ff;box-shadow:0 0 14px 2px rgba(190,240,255,.7)}
@keyframes spin{to{transform:rotate(360deg)}}
.training-page .hero-mark strong{position:relative;z-index:2;color:var(--cyan);font:700 96px/.85 var(--display);letter-spacing:-.09em;text-shadow:0 0 36px rgba(76,201,255,.3);animation:glow 4s ease-in-out infinite alternate}
@keyframes glow{to{text-shadow:0 0 60px rgba(76,201,255,.55)}}
.training-page .hero-mark small{position:relative;z-index:2;margin-top:12px;color:#a7dff4;font:600 12px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase}
.training-page .hm-chip{position:absolute;z-index:3;padding:8px 12px;border:1px solid rgba(76,201,255,.2);border-radius:999px;background:rgba(6,22,36,.85);color:#bfeaff;font:600 11px/1 var(--sans);backdrop-filter:blur(6px);animation:floaty 6s ease-in-out infinite}
.training-page .hm-c1{left:18px;top:26px}
.training-page .hm-c2{right:18px;bottom:28px;animation-delay:-3s}
@keyframes floaty{50%{transform:translateY(-8px)}}

/* Shell */
.training-page .section{position:relative;z-index:1;padding:44px 0 72px}
.training-page .calculator-shell{position:relative;border:1px solid var(--line);border-radius:30px;background:linear-gradient(160deg,rgba(10,27,45,.96),rgba(5,16,28,.98));box-shadow:0 40px 110px rgba(0,0,0,.38),0 0 120px rgba(76,201,255,.04);overflow:clip}
.training-page .calculator-shell::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),#e6fbff,var(--cyan),transparent);background-size:220% 100%;animation:sweep 5s linear infinite;opacity:.9}
