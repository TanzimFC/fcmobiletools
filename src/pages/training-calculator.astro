<script>
const TXP = {1:100,2:150,3:200,4:250,5:300,6:600,7:800,8:1000,9:1200,10:1400,
  11:1800,12:2200,13:2600,14:3000,15:3400,16:4000,17:4600,18:5200,19:5800,20:6400,
  21:7000,22:8000,23:9000,24:10000,25:11000,26:12000,27:13000,28:14000,29:15000,30:16000};
const MAX_LEVEL = 30;
const CUM = {0:0};
for(let i=1;i<=MAX_LEVEL;i++){ CUM[i] = CUM[i-1] + TXP[i]; }

function fmt(n){ return Math.round(n).toLocaleString('en-US'); }
function xpForRange(from,to){ let s=0; for(let i=from+1;i<=to;i++) s+=TXP[i]; return s; }
function maxLevelFromXp(from, xp){
  let level=from, remaining=xp;
  while(level<MAX_LEVEL && remaining>=TXP[level+1]){ remaining-=TXP[level+1]; level++; }
  return {level, remaining};
}

const curLevel=document.getElementById('curLevel'), tgtLevel=document.getElementById('tgtLevel');
const sourceCard=document.getElementById('sourceCard');
const rangeWarn=document.getElementById('rangeWarn');
const summarySentence=document.getElementById('summarySentence');
const statTotalXp=document.getElementById('statTotalXp'), statCards=document.getElementById('statCards');
const statLevels=document.getElementById('statLevels'), statLeftover=document.getElementById('statLeftover');
const progFill=document.getElementById('progFill'), progLabelLeft=document.getElementById('progLabelLeft'), progLabelRight=document.getElementById('progLabelRight');
const breakdownBody=document.getElementById('breakdownBody');
const haveXp=document.getElementById('haveXp'), haveFrom=document.getElementById('haveFrom'), reverseOut=document.getElementById('reverseOut');

for(let i=0;i<=MAX_LEVEL-1;i++){
  const o=document.createElement('option'); o.value=i; o.textContent='Level '+i; curLevel.appendChild(o);
}
curLevel.value = 0;
for(let i=1;i<=MAX_LEVEL;i++){
  const o=document.createElement('option'); o.value=i; o.textContent='Level '+i; tgtLevel.appendChild(o);
}
tgtLevel.value = MAX_LEVEL;
for(let i=0;i<MAX_LEVEL;i++){
  const o=document.createElement('option'); o.value=i; o.textContent='Level '+i; haveFrom.appendChild(o);
}

const fullTxpTable=document.getElementById('fullTxpTable');
for(let i=1;i<=MAX_LEVEL;i++){
  const tr=document.createElement('tr'); tr.innerHTML=`<td>${i}</td><td class="xp">${fmt(TXP[i])}</td>`; fullTxpTable.appendChild(tr);
}
const XP_BANDS=[['47–59 (Bronze)',100],['60–69 (Silver)',120],['70–74',160],['75–79',200],['80–84',250],['85–89',300],['90',400],['91',500],['92',600],['93',700],['94',800],['95+',1000]];
const xpValueTable=document.getElementById('xpValueTable');
XP_BANDS.forEach(([band,xp])=>{
  const tr=document.createElement('tr'); tr.innerHTML=`<td>${band} OVR</td><td class="xp">${fmt(xp)} XP</td>`; xpValueTable.appendChild(tr);
});

function render(){
  const cardXp = Number(sourceCard.value);
  let from = Number(curLevel.value), to = Number(tgtLevel.value);

  if(to<=from){
    rangeWarn.classList.add('show');
    summarySentence.textContent = 'Pick a target level higher than your current level to see the result.';
    statTotalXp.textContent='0'; statCards.textContent='0'; statLevels.textContent='0'; statLeftover.textContent='0';
    progFill.style.width='0%'; progLabelLeft.textContent='0 XP'; progLabelRight.textContent='0%';
    breakdownBody.innerHTML = '<tr><td colspan="3" style="color:var(--muted)">Set a valid range to see the breakdown.</td></tr>';
    return;
  }
  rangeWarn.classList.remove('show');

  const totalXp = xpForRange(from,to);
  const cards = cardXp>0 ? Math.ceil(totalXp/cardXp) : 0;
  const suppliedXp = cards*cardXp;
  const leftover = Math.max(0, suppliedXp-totalXp);

  summarySentence.innerHTML = `To go from <b>Level ${from}</b> to <b>Level ${to}</b>, you need <b class="green">${fmt(totalXp)} TXP</b> — about <b>${fmt(cards)} cards</b> at ${fmt(cardXp)} XP each.`;
  statTotalXp.textContent = fmt(totalXp);
  statCards.textContent = fmt(cards);
  statLevels.textContent = (to-from);
  statLeftover.textContent = fmt(leftover);

  progFill.style.width='100%';
  progLabelLeft.textContent = `${fmt(totalXp)} XP required`;
  progLabelRight.textContent = '100%';

  breakdownBody.innerHTML='';
  for(let i=from+1;i<=to;i++){
    const tr=document.createElement('tr');
    tr.innerHTML=`<td class="cur">${i}</td><td>${fmt(TXP[i])}</td><td>${fmt(CUM[i]-CUM[from])}</td>`;
    breakdownBody.appendChild(tr);
  }
}

function renderReverse(){
  const from = Number(haveFrom.value);
  const xp = Math.max(0, Number(haveXp.value)||0);
  if(!haveXp.value){ reverseOut.textContent='Enter an XP amount to see the highest level it reaches.'; return; }
  const {level, remaining} = maxLevelFromXp(from, xp);
  if(level>=MAX_LEVEL){
    reverseOut.innerHTML = `<b>${fmt(xp)} TXP</b> from Level ${from} gets you to the <b>Level 30 cap</b>, with ${fmt(remaining)} XP spare.`;
  } else {
    reverseOut.innerHTML = `<b>${fmt(xp)} TXP</b> from Level ${from} gets you to <b>Level ${level}</b>, with ${fmt(remaining)} XP left toward Level ${level+1} (needs ${fmt(TXP[level+1])}).`;
  }
}

curLevel.addEventListener('change',()=>{
  if(Number(tgtLevel.value)<=Number(curLevel.value)){
    const next = Math.min(MAX_LEVEL, Number(curLevel.value)+1);
    tgtLevel.value = next;
  }
  render();
});
tgtLevel.addEventListener('change', render);
sourceCard.addEventListener('change', render);
haveXp.addEventListener('input', renderReverse);
haveFrom.addEventListener('change', renderReverse);

render();
renderReverse();

const FAQS = [
  ["Does training increase a player's OVR in FC Mobile?", "No. Training only improves a player's individual stats and gameplay. To raise a player's OVR (and Team OVR), you need to Rank Up the player using Rank Up Points instead."],
  ["What is the maximum Training Level in FC Mobile?", "The current Training Level cap is 30. Reaching level 30 no longer requires ranking up every 5 levels like in older seasons — you can train straight through to the cap."],
  ["What gives the best value when training a player?", "Bronze and Silver OVR cards (roughly 47–69 OVR) give the best coin-to-XP ratio, since XP value per card rises much slower than the coin cost of higher OVR cards. Most experienced players keep a stock of low OVR cards specifically for training."],
  ["Do TOTY or event cards cost more to train?", "No. TOTY or event status does not by itself make a player cost more TXP to train. The required TXP is based on the applicable training requirement for the player and level."],
  ["Can I move Training XP from one player to another?", "Yes, using Training Transfer. It moves the XP stored on one player onto another, but a 10% transfer loss applies, so the receiving player only gets 90% of the XP that was moved."]
];
const faqList=document.getElementById('faqList');
FAQS.forEach(([q,a])=>{
  const item=document.createElement('div'); item.className='faq-item';
  item.innerHTML = `<button class="faq-q" type="button"><span>${q}</span><span class="plus">+</span></button><div class="faq-a"><p>${a}</p></div>`;
  faqList.appendChild(item);
});
faqList.addEventListener('click', (e)=>{
  const btn = e.target.closest('.faq-q');
  if(!btn) return;
  const item = btn.closest('.faq-item');
  const ans = item.querySelector('.faq-a');
  const isOpen = item.classList.contains('open');
  faqList.querySelectorAll('.faq-item.open').forEach(el=>{ el.classList.remove('open'); el.querySelector('.faq-a').style.maxHeight=null; });
  if(!isOpen){ item.classList.add('open'); ans.style.maxHeight = ans.scrollHeight+'px'; }
});
</script>
