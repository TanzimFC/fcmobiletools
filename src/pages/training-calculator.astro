---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FODDER, TRAINING_LEVELS } from '../data/fcMobileTraining.js';
---
<BaseLayout title="FC Mobile Training Calculator" description="Calculate Training XP and the player cards needed to train an FC Mobile player to any level">
<main class="page"><div class="wrap">
<header class="hero"><div><span>FC MOBILE 26</span><h1>Training Calculator</h1><p>Find the XP and player cards needed for your target Training Level</p></div></header>
<section class="card setup"><div class="label">TRAINING</div><div class="fields"><label>Current Level<select id="current">{TRAINING_LEVELS.map((_,i)=><option value={i}>{i}</option>)}</select></label><label>Target Level<select id="target">{TRAINING_LEVELS.map((_,i)=><option value={i} selected={i===30}>{i}</option>)}</select></label><label>Fodder<select id="fodder">{FODDER.map(item=><option value={item.id} selected={item.id==='60-69'}>{item.label} · {item.xp} XP</option>)}</select></label></div></section>
<section id="requirement" class="requirement"></section>
<section class="card level-chart"><div class="section-head"><div><div class="label">TXP REQUIRED PER LEVEL</div><h2>Training XP by level</h2></div><span>Full values</span></div><div id="levels-grid"></div></section>
<section class="card"><div class="section-head"><div><div class="label">FODDER COUNT</div><h2>Cards needed by OVR</h2></div></div><div id="grid"></div></section>
</div></main>
</BaseLayout>
<style>
.page{--blue:#59cdf7;--ink:#eaf9ff;--muted:#7d99a5;--line:#193d4c;min-height:100vh;background:radial-gradient(circle at 90% 0,#103c4d,transparent 30%),#07131b;color:var(--ink);padding:40px 16px 80px}.wrap{max-width:1040px;margin:auto}.hero{padding:12px 0 30px}.hero span,.label{font:900 9px ui-monospace,monospace;letter-spacing:.15em;color:#69d9ff}.hero h1{font-size:clamp(42px,7vw,70px);letter-spacing:-.065em;line-height:.9;margin:9px 0 12px}.hero p{margin:0;color:var(--muted);font-size:14px}.card,.requirement{border:1px solid var(--line);border-radius:20px;background:#0b1c26;box-shadow:0 15px 45px #0005;padding:22px;margin-bottom:14px}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-top:16px}label{display:grid;gap:7px;color:#a9c1ca;font:900 9px ui-monospace,monospace}select{width:100%;box-sizing:border-box;padding:13px 11px;border:1px solid #294b58;border-radius:10px;background:#07151e;color:#eefaff;font:800 12px ui-monospace,monospace;outline:0}select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #59cdf71c}.requirement{padding:0;overflow:hidden}.req-head{padding:24px;border-bottom:1px solid var(--line)}.req-title{color:#6fdcff;font:900 10px ui-monospace,monospace;letter-spacing:.13em}.req-main{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-top:8px}.xp{font:900 clamp(50px,8vw,84px) ui-monospace,monospace;letter-spacing:-.075em;line-height:.86}.xp small{font-size:14px;color:#83a6b2;letter-spacing:0}.levels{font:900 11px ui-monospace,monospace;color:#9bb7c0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.metric{padding:20px;border-right:1px solid var(--line)}.metric:last-child{border-right:0}.metric span{display:block;color:#6c8b98;font:900 8px ui-monospace,monospace;letter-spacing:.08em;margin-bottom:7px}.metric strong{font:900 27px ui-monospace,monospace}.metric small{display:block;color:#6f8d98;font-size:8px;margin-top:4px}.progress-wrap{padding:18px 20px;background:#081720}.progress-top{display:flex;justify-content:space-between;color:#75929d;font:800 8px ui-monospace,monospace}.progress{height:9px;background:#14303b;border-radius:99px;overflow:hidden;margin-top:9px}.progress i{display:block;height:100%;background:#59cdf7;border-radius:inherit}.section-head{display:flex;justify-content:space-between;align-items:end}.section-head h2{margin:6px 0 18px;font-size:19px}.section-head>span{font:800 8px ui-monospace,monospace;color:#8bb1be}.level-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.level-item{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:12px;background:#081720;padding:12px 14px}.level-item.active{border-color:#3aaed7;background:#0a2530}.level-number{display:flex;align-items:center;gap:9px;font:900 11px ui-monospace,monospace}.level-dot{width:24px;height:24px;border-radius:8px;background:#102d38;color:#77d9fa;display:grid;place-items:center;font-size:8px}.level-item.active .level-dot{background:var(--blue);color:#06212b}.level-xp{text-align:right;font:900 13px ui-monospace,monospace}.level-xp small{display:block;color:#668592;font:700 7px ui-monospace,monospace;margin-top:3px}.fodder-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.fodder-row{display:grid;grid-template-columns:125px 1fr 80px;align-items:center;gap:10px;border:1px solid var(--line);border-radius:13px;background:#081720;padding:13px}.fodder-row.selected{border-color:var(--blue);background:#0a2530}.range{display:flex;align-items:center;gap:7px;font:900 11px ui-monospace,monospace;white-space:nowrap}.answer-check{width:18px;height:18px;flex:0 0 18px;border-radius:50%;display:grid;place-items:center;background:#59cdf7;color:#05212b;font:1000 11px Arial;box-shadow:0 0 0 3px #59cdf714}.bar{height:8px;background:#102b36;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:#367c95;border-radius:inherit}.selected .bar i{background:var(--blue)}.count{text-align:right}.count strong{display:block;font:900 18px ui-monospace,monospace}.count small{display:block;color:#6f8b96;font-size:7px;margin-top:2px}@media(max-width:700px){.page{padding:25px 13px 60px}.card,.requirement{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.req-main{display:block}.levels{margin-top:14px}.metrics{grid-template-columns:1fr}.metric{border-right:0;border-bottom:1px solid var(--line)}.metric:last-child{border-bottom:0}.level-grid,.fodder-grid{grid-template-columns:1fr}.fodder-row{grid-template-columns:95px 1fr 62px}}
</style>
<script>
import { calculateTraining } from '../lib/fcMobileTraining.js';
import { FODDER, TRAINING_LEVELS } from '../data/fcMobileTraining.js';
const current=document.querySelector('#current'),target=document.querySelector('#target'),fodder=document.querySelector('#fodder'),requirement=document.querySelector('#requirement'),grid=document.querySelector('#grid'),levelsGrid=document.querySelector('#levels-grid');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);const compact=n=>n>=1000000?`${(n/1000000).toFixed(n%1000000?1:0)}M`:n>=1000?`${(n/1000).toFixed(n%1000?1:0)}K`:String(n);
levelsGrid.innerHTML=`<div class="level-grid">${TRAINING_LEVELS.map((xp,i)=>`<div class="level-item" data-level="${i}"><div class="level-number"><span class="level-dot">${i}</span><span>Level ${i}</span></div><div class="level-xp">${fmt(xp)}<small>TXP</small></div></div>`).join('')}</div>`;
function render(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c);const d=calculateTraining({currentLevel:current.value,targetLevel:target.value,fodderId:fodder.value});if(!d.valid)return;const progress=d.targetXP?Math.round(d.currentXP/d.targetXP*100):100;requirement.innerHTML=`<div class="req-head"><div class="req-title">TRAINING REQUIREMENT</div><div class="req-main"><div><div class="xp">${compact(d.requiredXP)} <small>XP</small></div><div style="color:#6d8b97;font:800 9px ui-monospace,monospace;margin-top:7px">${fmt(d.requiredXP)} XP required</div></div><div class="levels">Level ${d.currentLevel} → Level ${d.targetLevel}</div></div></div><div class="metrics"><div class="metric"><span>CARDS NEEDED</span><strong>${fmt(d.cards)}</strong><small>${d.fodder.label}</small></div><div class="metric"><span>XP SUPPLIED</span><strong>${compact(d.suppliedXP)}</strong><small>${fmt(d.suppliedXP)} XP</small></div><div class="metric"><span>EXTRA XP</span><strong>${compact(d.extraXP)}</strong><small>${fmt(d.extraXP)} XP</small></div></div><div class="progress-wrap"><div class="progress-top"><span>Current XP progress</span><strong>${progress}%</strong></div><div class="progress"><i style="width:${progress}%"></i></div></div>`;document.querySelectorAll('.level-item').forEach(el=>el.classList.toggle('active',Number(el.dataset.level)===d.targetLevel));const max=Math.max(1,...FODDER.map(x=>Math.ceil(d.requiredXP/x.xp)));grid.innerHTML=`<div class="fodder-grid">${FODDER.map(x=>{const cards=d.requiredXP?Math.ceil(d.requiredXP/x.xp):0;const active=x.id===d.fodder.id;return `<div class="fodder-row ${active?'selected':''}"><div class="range">${active?'<span class="answer-check">✓</span>':''}${x.label}</div><div class="bar"><i style="width:${Math.max(cards?3:0,cards/max*100)}%"></i></div><div class="count"><strong>${fmt(cards)}</strong><small>CARDS</small></div></div>`}).join('')}</div>`}
[current,target,fodder].forEach(x=>x.addEventListener('input',render));render();
</script>