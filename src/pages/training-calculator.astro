---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FC Mobile Training Calculator" description="Free FC Mobile Training Calculator. Calculate the exact TXP and player cards needed for every Training Level">
<section class="pagehead"><div class="pagehead-bg"></div><div class="pagehead-grid"></div><div class="wrap"><nav class="crumb" aria-label="Breadcrumb"><a href="/">FC Mobile Tools</a><span>/</span>Training Calculator</nav><h1>FC Mobile Training Calculator</h1><p class="lead">Pick your current level, target level and training card to see the exact TXP and cards needed</p></div></section>
<section class="calc-shell"><div class="wrap">
<div class="calc-card">
<div class="steps">
<div class="step"><label for="curLevel"><b>1</b>Current Training Level</label><select id="curLevel"></select><small>Choose the player's current Training Level</small></div>
<div class="step"><label for="tgtLevel"><b>2</b>Target Training Level</label><select id="tgtLevel"></select><small>Training currently caps at Level 30</small></div>
<div class="step"><label for="sourceCard"><b>3</b>Card you're using as XP</label><select id="sourceCard"></select><small>Choose the OVR range of your training cards</small></div>
</div>
<div class="warn" id="rangeWarn">Target level needs to be higher than the current level</div>
<div class="summary"><div class="eyebrow">YOUR ANSWER</div><p id="summarySentence">Choose your levels above to see the result</p></div>
<div class="result-stats"><div class="rstat"><span>Total TXP needed</span><b class="blue" id="statTotalXp">0</b></div><div class="rstat"><span>Cards needed</span><b id="statCards">0</b></div><div class="rstat"><span>Levels gained</span><b id="statLevels">0</b></div><div class="rstat"><span>Leftover XP</span><b class="amber" id="statLeftover">0</b></div></div>
<div class="progress-track"><div class="progress-fill" id="progFill"></div></div><div class="progress-label"><span id="progLabelLeft">0 XP</span><span id="progLabelRight">0%</span></div>
<details class="advanced"><summary><span>▶</span> Advanced breakdown and reverse XP check</summary><div class="advanced-body"><div class="bd-table-wrap"><table><thead><tr><th>Level</th><th>TXP required</th><th>Running total</th></tr></thead><tbody id="breakdownBody"></tbody></table></div><div class="reverse-row"><label>I already have this much TXP<input type="number" id="haveXp" min="0" step="100" placeholder="e.g. 10000"></label><label>Starting from level<select id="haveFrom"></select></label></div><p id="reverseOut">Enter an XP amount to see the highest level it reaches</p></div></details>
</div>
<section class="card"><div class="section-head"><div><div class="label">FODDER COUNT</div><h2>Cards needed by OVR</h2></div></div><div id="grid"></div></section>
<section class="card"><div class="section-head"><div><div class="label">TXP REQUIRED PER LEVEL</div><h2>Training XP by level</h2></div><span>Full values</span></div><div class="ref-grid"><div class="ref-panel"><h3>TXP per training level</h3><p>Level 1 through Level 30</p><table class="ref-table"><thead><tr><th>Level</th><th>TXP</th></tr></thead><tbody id="fullTxpTable"></tbody></table></div><div class="ref-panel"><h3>Card XP value by OVR</h3><p>XP value for each training card</p><table class="ref-table"><thead><tr><th>OVR band</th><th>XP value</th></tr></thead><tbody id="xpValueTable"></tbody></table></div></div></section>
<section class="content"><div class="csec"><h2>What Training actually does in FC Mobile</h2><p>Training improves an individual player's in-game stats and gameplay. It is separate from Rank Up, which raises a player's OVR</p><p>Other player cards are used as Training XP. The calculator adds every level between the current and target levels</p></div><div class="csec"><h2>Training vs Rank Up</h2><table class="compare"><thead><tr><th></th><th>Training</th><th>Rank Up</th></tr></thead><tbody><tr><td>Currency</td><td>Player cards as TXP</td><td>Rank Up Points</td></tr><tr><td>Raises OVR</td><td>No</td><td>Yes</td></tr><tr><td>Improves stats</td><td>Yes</td><td>Indirectly</td></tr><tr><td>Cap</td><td>Level 30</td><td>5 ranks</td></tr></tbody></table></div><div class="csec"><h2>Frequently asked questions</h2><div id="faqList"></div></div></section>
</div></section>
</BaseLayout>
<style>
:global(:root){--bg:#050b12;--surface:#0d141c;--surface2:#121b26;--border:#20303e;--text:#f3f8fc;--muted:#8695a3;--blue:#38bdf8;--blue-light:#7dd3fc;--green:#48d98a;--amber:#f5b942;--mono:'JetBrains Mono',ui-monospace,monospace;--sans:'Inter',system-ui,sans-serif}.pagehead,.calc-shell{background:var(--bg);color:var(--text)}.pagehead{position:relative;overflow:hidden;padding:48px 0 36px;isolation:isolate}.pagehead-bg{position:absolute;inset:0;z-index:-2;background:radial-gradient(ellipse 900px 460px at 14% 0%,#38bdf82a,transparent 60%),radial-gradient(ellipse 700px 420px at 92% 10%,#48d98a1c,transparent 62%),var(--bg)}.pagehead-grid{position:absolute;inset:0;z-index:-1;opacity:.3;background-image:linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:44px 44px}.wrap{width:min(1100px,calc(100% - 40px));margin:auto}.crumb{font:11px var(--mono);color:var(--muted);margin-bottom:16px}.crumb a{color:var(--blue-light)}.crumb span{margin:0 7px;opacity:.5}.pagehead h1{font-size:clamp(30px,4.2vw,44px);line-height:1.05;letter-spacing:-.03em;margin:0 0 12px;font-weight:900}.lead{font-size:15px;color:var(--muted);max-width:640px;margin:0}.calc-shell{padding:8px 0 70px}.calc-card,.card{border:1px solid var(--border);border-radius:22px;background:linear-gradient(160deg,#101720,#0b1119);overflow:hidden}.calc-card{padding:8px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:22px 22px 0}.step{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px}.step label{display:flex;align-items:center;font-size:12.5px;font-weight:700;margin-bottom:10px}.step label b{width:20px;height:20px;border-radius:6px;background:#38bdf81a;color:var(--blue-light);display:grid;place-items:center;font:700 10px var(--mono);margin-right:8px}.step select,.reverse-row input,.reverse-row select{width:100%;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:10px;padding:11px 12px;font:700 14px var(--sans)}.step small{display:block;margin-top:8px;color:var(--muted);font-size:11px}.warn{display:none;margin:14px 22px 0;padding:11px 14px;border-radius:10px;border:1px solid #6b3a1f;background:#3a220f66;color:#ffd7a8;font-size:12px}.warn.show{display:block}.summary{margin:20px 22px 0;padding:20px 22px;border-radius:16px;border:1px solid #255d42;background:linear-gradient(135deg,#0d1a14,#0d141c)}.eyebrow,.label{font:700 10px var(--mono);letter-spacing:.08em;color:var(--blue-light)}.summary .eyebrow{color:#9ff5c4;margin-bottom:10px}.summary p{margin:0;font-size:17px;font-weight:600;line-height:1.55}.summary p b{color:var(--blue-light)}.summary p b.green{color:var(--green)}.result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 22px 0}.rstat{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:13px 14px}.rstat span{display:block;font:600 9px var(--mono);color:var(--muted);text-transform:uppercase}.rstat b{display:block;margin-top:6px;font:800 18px var(--mono)}.rstat .blue{color:var(--blue-light)}.rstat .amber{color:var(--amber)}.progress-track{height:8px;border-radius:99px;background:var(--surface2);border:1px solid var(--border);overflow:hidden;margin:16px 22px 6px}.progress-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--green));border-radius:99px;transition:width .25s}.progress-label{display:flex;justify-content:space-between;color:var(--muted);font:10px var(--mono);margin:0 22px 18px}.advanced{margin:4px 22px 0}.advanced summary{cursor:pointer;color:var(--blue-light);font-size:12px;font-weight:700;padding:10px 0;list-style:none}.advanced summary::-webkit-details-marker{display:none}.advanced summary span{display:inline-block;transition:.2s}.advanced[open] summary span{transform:rotate(90deg)}.advanced-body{padding:4px 0 22px}.bd-table-wrap{border:1px solid var(--border);border-radius:10px;overflow:hidden}.advanced table{width:100%;border-collapse:collapse;font-size:12px}.advanced th{color:var(--muted);font:700 9px var(--mono);text-align:left;padding:9px 10px;border-bottom:1px solid var(--border);text-transform:uppercase}.advanced td{padding:8px 10px;border-bottom:1px solid #ffffff0d}.advanced td:first-child{color:var(--green)}.reverse-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.reverse-row label{display:grid;gap:8px;color:var(--text);font-size:12px;font-weight:700}.reverse-out{color:var(--muted);font-size:13px}.card{padding:22px;margin-top:14px}.section-head{display:flex;justify-content:space-between;align-items:end}.section-head h2{margin:6px 0 18px;font-size:19px}.section-head>span{font:800 8px var(--mono);color:#8bb1be}.fodder-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.fodder-row{display:grid;grid-template-columns:125px 1fr 80px;align-items:center;gap:10px;border:1px solid var(--border);border-radius:13px;background:#081720;padding:13px}.fodder-row.selected{border-color:var(--blue);background:#0a2530}.range{display:flex;align-items:center;gap:7px;font:900 11px var(--mono);white-space:nowrap}.answer-check{width:18px;height:18px;flex:0 0 18px;border-radius:50%;display:grid;place-items:center;background:#59cdf7;color:#05212b;font:1000 11px Arial;box-shadow:0 0 0 3px #59cdf714}.bar{height:8px;background:#102b36;border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:#367c95;border-radius:inherit}.selected .bar i{background:var(--blue)}.count{text-align:right}.count strong{display:block;font:900 18px var(--mono)}.count small{color:#6f8b96;font-size:7px}.ref-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.ref-panel{border-radius:16px;border:1px solid var(--border);background:var(--surface);padding:20px}.ref-panel h3{font-size:14px;margin:0 0 4px}.ref-panel p{font-size:12px;color:var(--muted);margin:0 0 14px}.ref-table{width:100%;border-collapse:collapse;font-size:12.5px}.ref-table th{background:#0d141c;text-align:left;color:var(--muted);font:700 9px var(--mono);padding:9px 12px;border-bottom:1px solid var(--border);text-transform:uppercase}.ref-table td{padding:8px 12px;border-bottom:1px solid #ffffff0d;font-weight:600}.ref-table tr:last-child td{border-bottom:0}.ref-table td.xp{color:var(--blue-light);font-family:var(--mono)}.content{padding:44px 0 10px}.csec{margin-bottom:44px}.csec h2{font-size:clamp(20px,2.6vw,26px);margin:0 0 12px}.csec p,.csec li{color:#c3ccd4;font-size:14.5px;line-height:1.75}.csec p{margin:0 0 12px}.compare{width:100%;border-collapse:collapse;font-size:13px;border:1px solid var(--border)}.compare th{background:var(--surface);color:var(--blue-light);padding:12px;text-align:left;font:700 10px var(--mono)}.compare td{padding:12px;border-top:1px solid var(--border);color:#c3ccd4}.compare td:first-child{color:var(--text);font-weight:800}.faq-item{border-bottom:1px solid var(--border)}.faq-item:first-child{border-top:1px solid var(--border)}.faq-q{width:100%;display:flex;justify-content:space-between;gap:16px;background:none;border:0;color:var(--text);text-align:left;padding:18px 2px;font-size:14px;font-weight:700}.faq-q .plus{color:var(--blue-light);font:16px var(--mono);transition:.2s}.faq-item.open .plus{transform:rotate(45deg)}.faq-a{max-height:0;overflow:hidden;transition:max-height .25s}.faq-a p{color:#c3ccd4;font-size:13.5px;line-height:1.7;padding:0 2px 18px;margin:0}@media(max-width:760px){.steps,.ref-grid,.fodder-grid{grid-template-columns:1fr}.result-stats{grid-template-columns:1fr 1fr}.reverse-row{grid-template-columns:1fr}}@media(max-width:560px){.wrap{width:calc(100% - 28px)}.pagehead{padding-top:32px}.pagehead h1{font-size:34px}.card{padding:18px}.steps{padding:16px 12px 0}.summary,.result-stats{margin-left:12px;margin-right:12px}.progress-track,.progress-label{margin-left:12px;margin-right:12px}.advanced{margin-left:12px;margin-right:12px}.fodder-row{grid-template-columns:95px 1fr 62px}.fodder-row .range{font-size:10px}.ref-panel{padding:15px}}
</style>
<script>
const MAX=30,fmt=n=>Math.round(n).toLocaleString('en-US'),cur=document.getElementById('curLevel'),tgt=document.getElementById('tgtLevel'),card=document.getElementById('sourceCard'),warn=document.getElementById('rangeWarn'),summary=document.getElementById('summarySentence'),totalEl=document.getElementById('statTotalXp'),cardsEl=document.getElementById('statCards'),levelsEl=document.getElementById('statLevels'),leftEl=document.getElementById('statLeftover'),fill=document.getElementById('progFill'),progLeft=document.getElementById('progLabelLeft'),progRight=document.getElementById('progLabelRight'),breakdown=document.getElementById('breakdownBody'),haveXp=document.getElementById('haveXp'),haveFrom=document.getElementById('haveFrom'),reverseOut=document.getElementById('reverseOut'),grid=document.getElementById('grid');
const TXP={1:100,2:150,3:200,4:250,5:300,6:600,7:800,8:1000,9:1200,10:1400,11:1800,12:2200,13:2600,14:3000,15:3400,16:4000,17:4600,18:5200,19:5800,20:6400,21:7000,22:8000,23:9000,24:10000,25:11000,26:12000,27:13000,28:14000,29:15000,30:16000};
const XP_BANDS=[['47–59',100],['60–69',120],['70–74',160],['75–79',200],['80–84',250],['85–89',300],['90',400],['91',500],['92',600],['93',700],['94',800],['95+',1000]];
const CUM={0:0};for(let i=1;i<=MAX;i++)CUM[i]=CUM[i-1]+TXP[i];
const xpForRange=(from,to)=>{let s=0;for(let i=from+1;i<=to;i++)s+=TXP[i];return s};
const maxLevelFromXp=(from,xp)=>{let level=from,remaining=xp;while(level<MAX&&remaining>=TXP[level+1]){remaining-=TXP[level+1];level++}return{level,remaining}};
for(let i=0;i<MAX;i++){cur.add(new Option('Level '+i,i));haveFrom.add(new Option('Level '+i,i))}for(let i=1;i<=MAX;i++)tgt.add(new Option('Level '+i,i));XP_BANDS.forEach(([band,xp])=>card.add(new Option(`${band} OVR — ${fmt(xp)} XP`,xp)));
cur.value='0';tgt.value='30';card.value='250';
const fullTxpTable=document.getElementById('fullTxpTable');for(let i=1;i<=MAX;i++)fullTxpTable.insertAdjacentHTML('beforeend',`<tr><td>${i}</td><td class="xp">${fmt(TXP[i])} XP</td></tr>`);
const xpValueTable=document.getElementById('xpValueTable');XP_BANDS.forEach(([band,xp])=>xpValueTable.insertAdjacentHTML('beforeend',`<tr><td>${band} OVR</td><td class="xp">${fmt(xp)} XP</td></tr>`));
function render(){const cardXp=Number(card.value),from=Number(cur.value),to=Number(tgt.value);if(to<=from){warn.classList.add('show');summary.textContent='Pick a target level higher than your current level to see the result';totalEl.textContent=cardsEl.textContent=levelsEl.textContent=leftEl.textContent='0';fill.style.width='0%';progLeft.textContent='0 XP';progRight.textContent='0%';breakdown.innerHTML='<tr><td colspan="3" style="color:var(--muted)">Set a valid range to see the breakdown</td></tr>';grid.innerHTML='';return}warn.classList.remove('show');const total=xpForRange(from,to),cards=Math.ceil(total/cardXp),supplied=cards*cardXp,left=Math.max(0,supplied-total);summary.innerHTML=`To go from <b>Level ${from}</b> to <b>Level ${to}</b>, you need <b class="green">${fmt(total)} TXP</b> — about <b>${fmt(cards)} cards</b> at ${fmt(cardXp)} XP each`;totalEl.textContent=fmt(total);cardsEl.textContent=fmt(cards);levelsEl.textContent=to-from;leftEl.textContent=fmt(left);fill.style.width='100%';progLeft.textContent=`${fmt(total)} XP required`;progRight.textContent='100%';breakdown.innerHTML='';for(let i=from+1;i<=to;i++)breakdown.insertAdjacentHTML('beforeend',`<tr><td>${i}</td><td>${fmt(TXP[i])}</td><td>${fmt(CUM[i]-CUM[from])}</td></tr>`);grid.innerHTML='<div class="fodder-grid">'+XP_BANDS.map(([band,xp])=>{const count=Math.ceil(total/xp),selected=xp===cardXp;return `<div class="fodder-row ${selected?'selected':''}"><div class="range">${selected?'<span class="answer-check">✓</span>':''}<span>${band} OVR</span></div><div class="bar"><i style="width:${Math.min(100,xp/10)}%"></i></div><div class="count"><strong>${fmt(count)}</strong><small>CARDS</small></div></div>`}).join('')+'</div>'}
function renderReverse(){const from=Number(haveFrom.value),xp=Math.max(0,Number(haveXp.value)||0);if(!haveXp.value){reverseOut.textContent='Enter an XP amount to see the highest level it reaches';return}const d=maxLevelFromXp(from,xp);reverseOut.innerHTML=d.level>=MAX?`<b>${fmt(xp)} TXP</b> from Level ${from} gets you to the <b>Level 30 cap</b>, with ${fmt(d.remaining)} XP spare`:`<b>${fmt(xp)} TXP</b> from Level ${from} gets you to <b>Level ${d.level}</b>, with ${fmt(d.remaining)} XP left toward Level ${d.level+1} (needs ${fmt(TXP[d.level+1])})`}
cur.addEventListener('change',()=>{if(Number(tgt.value)<=Number(cur.value))tgt.value=String(Math.min(MAX,Number(cur.value)+1));render()});tgt.addEventListener('change',render);card.addEventListener('change',render);haveXp.addEventListener('input',renderReverse);haveFrom.addEventListener('change',renderReverse);render();renderReverse();
const FAQS=[["Does training increase a player's OVR in FC Mobile?","No. Training improves a player's individual stats and gameplay. Rank Up is the system used to raise a player's OVR"],["What is the maximum Training Level in FC Mobile?","The current Training Level cap is 30"],["What gives the best value when training a player?","Bronze and Silver OVR cards can be useful as low-cost training fodder. Higher OVR cards give more XP per card"],["Do TOTY or event cards cost more to train?","No. A card does not require more TXP simply because it is a TOTY or event card. Use the training requirement shown for the player in-game"],["Can I move Training XP from one player to another?","Yes, using Training Transfer. A 10% transfer loss applies, so the receiving player gets 90% of the transferred XP"]];
const faqList=document.getElementById('faqList');FAQS.forEach(([q,a])=>{const item=document.createElement('div');item.className='faq-item';item.innerHTML=`<button class="faq-q" type="button"><span>${q}</span><span class="plus">+</span></button><div class="faq-a"><p>${a}</p></div>`;faqList.appendChild(item)});faqList.addEventListener('click',e=>{const btn=e.target.closest('.faq-q');if(!btn)return;const item=btn.closest('.faq-item'),ans=item.querySelector('.faq-a'),open=item.classList.contains('open');faqList.querySelectorAll('.faq-item.open').forEach(el=>{el.classList.remove('open');el.querySelector('.faq-a').style.maxHeight=null});if(!open){item.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px'}});
</script>