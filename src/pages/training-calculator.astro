/* Premium Training Calculator presentation layer — calculation/data code remains untouched. */
.training-page{
  --bg:#06111e;
  --deep:#040b14;
  --surface:#091a2b;
  --surface-2:#0b2035;
  --surface-3:#0d2941;
  --line:rgba(98,168,206,.19);
  --line-soft:rgba(98,168,206,.10);
  --text:#f2f8fc;
  --muted:#89a6b8;
  --dim:#58788d;
  --cyan:#4CC9FF;
  background:
    radial-gradient(900px 580px at 6% 0%,rgba(76,201,255,.10),transparent 64%),
    radial-gradient(850px 520px at 100% 18%,rgba(76,201,255,.065),transparent 68%),
    linear-gradient(180deg,var(--bg) 0%,var(--deep) 100%) !important;
  color:var(--text) !important;
}
.training-page .hero{
  position:relative;
  isolation:isolate;
  border-bottom:1px solid var(--line) !important;
  background:linear-gradient(90deg,rgba(76,201,255,.035),transparent 34%),linear-gradient(180deg,rgba(6,17,30,.15),rgba(4,11,20,.55)) !important;
  overflow:hidden;
}
.training-page .hero::before{
  content:"";
  position:absolute;
  width:560px;height:560px;right:-210px;top:-320px;
  border:1px solid rgba(76,201,255,.12);
  border-radius:50%;
  box-shadow:0 0 0 70px rgba(76,201,255,.018),0 0 0 140px rgba(76,201,255,.012);
}
.training-page .hero::after{
  content:"";
  position:absolute;inset:0;pointer-events:none;opacity:.20;
  background-image:linear-gradient(rgba(76,201,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.045) 1px,transparent 1px);
  background-size:52px 52px;
  mask-image:linear-gradient(90deg,#000 0%,#000 62%,transparent 100%);
}
.training-page .hero>.wrap{position:relative;z-index:1;padding:30px 0 62px !important}
.training-page .hero nav{
  margin-bottom:62px !important;
  color:#56778b !important;
  font:800 8px/1 var(--mono) !important;
  letter-spacing:.12em;
}
.training-page .hero nav a{color:var(--cyan) !important}
.training-page .hero-grid{grid-template-columns:minmax(0,1fr) 300px !important;gap:72px !important}
.training-page h1{
  margin:16px 0 18px !important;
  color:var(--text) !important;
  font:800 clamp(56px,8vw,94px)/.86 var(--mono) !important;
  letter-spacing:-.075em !important;
  text-shadow:0 0 30px rgba(76,201,255,.08);
}
.training-page h1 em{color:var(--cyan) !important}
.training-page .hero p{color:var(--muted) !important;font-size:14px !important;line-height:1.8 !important}
.training-page .pills{gap:9px !important;margin-top:25px !important}
.training-page .pills span{
  min-height:31px !important;padding:0 11px !important;
  border:1px solid var(--line-soft) !important;
  background:rgba(7,24,40,.72) !important;
  color:#66869a !important;
  font:800 7px/1 var(--mono) !important;
  letter-spacing:.12em;
}
.training-page .hero-mark{
  position:relative;
  min-height:300px !important;
  border:1px solid rgba(76,201,255,.16) !important;
  border-radius:30px !important;
  background:radial-gradient(circle at center,rgba(76,201,255,.13),transparent 37%),linear-gradient(155deg,#0b253b,#071725 72%) !important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 30px 90px rgba(0,0,0,.34),0 0 80px rgba(76,201,255,.055) !important;
  overflow:hidden;
}
.training-page .hero-mark::before{
  content:"";
  position:absolute;width:220px;height:220px;
  border:1px solid rgba(76,201,255,.10);border-radius:50%;
  box-shadow:0 0 0 24px rgba(76,201,255,.018),0 0 0 48px rgba(76,201,255,.012);
}
.training-page .hero-mark::after{
  content:"";
  position:absolute;inset:22px;
  border:1px solid rgba(76,201,255,.055);
  border-radius:23px;
  background-image:linear-gradient(rgba(76,201,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.022) 1px,transparent 1px);
  background-size:18px 18px;
  mask-image:radial-gradient(circle,#000 12%,transparent 74%);
}
.training-page .hero-mark strong{
  position:relative;z-index:2;
  color:var(--cyan) !important;
  font:900 88px/.86 var(--mono) !important;
  letter-spacing:-.10em;
  text-shadow:0 0 28px rgba(76,201,255,.16);
}
.training-page .hero-mark small{
  position:absolute;z-index:3;bottom:35px;
  color:#a7dff4 !important;
  font:800 7px/1 var(--mono) !important;
  letter-spacing:.2em;
}

.training-page .calculator-shell{
  border:1px solid var(--line) !important;
  border-radius:30px !important;
  background:linear-gradient(160deg,rgba(9,25,42,.97),rgba(5,16,28,.98)) !important;
  box-shadow:0 35px 100px rgba(0,0,0,.30) !important;
}
.training-page .calculator-shell::before{background:linear-gradient(90deg,transparent,var(--cyan),transparent) !important}
.training-page .planner-head{
  padding:28px 30px !important;
  border-bottom:1px solid var(--line) !important;
}
.training-page .planner-head h2,
.training-page .section-title h2{
  color:var(--text) !important;
  font:800 31px/1 var(--mono) !important;
  letter-spacing:-.05em;
}
.training-page .planner-head p,
.training-page .section-title p{color:var(--muted) !important}
.training-page .max{
  border:1px solid rgba(76,201,255,.17) !important;
  background:rgba(76,201,255,.055) !important;
  color:var(--cyan) !important;
  border-radius:999px !important;
}

.training-page .fields{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:10px !important;
  padding:20px 30px 10px !important;
}
.training-page .fields label{
  gap:8px !important;
  padding:16px !important;
  border:1px solid var(--line-soft) !important;
  border-radius:19px !important;
  background:linear-gradient(145deg,#0b2238,#091b2e) !important;
  color:#d9edf5 !important;
  font:800 9px/1 var(--mono) !important;
  transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease;
}
.training-page .fields label:hover{
  transform:translateY(-2px);
  border-color:rgba(76,201,255,.28) !important;
  box-shadow:0 14px 34px rgba(0,0,0,.16);
}
.training-page .fields label::before{
  content:"TRAINING INPUT";
  display:block;
  color:#557489;
  font:800 6px/1 var(--mono);
  letter-spacing:.14em;
}
.training-page .fields select{
  appearance:none;
  -webkit-appearance:none;
  min-height:50px !important;
  padding:0 14px !important;
  margin-top:3px !important;
  border:1px solid #21445a !important;
  border-radius:13px !important;
  background:#061522 !important;
  color:var(--text) !important;
  font:800 11px/1 var(--mono) !important;
  outline:0;
  cursor:pointer;
