.training-page .guide-head p{max-width:640px;margin:0;color:#7f9db0;font:400 14px/1.6 var(--sans)}
.training-page .guide-live{display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 12px;border:1px solid rgba(76,201,255,.16);border-radius:999px;color:#78a0b6;font:600 12px/1 var(--sans);white-space:nowrap}
