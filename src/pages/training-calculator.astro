---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL, TRAINING_TRANSFER_RATE } from '../data/fcMobileTraining.js';
---
<BaseLayout title="FC Mobile Training Calculator | XP & Cards Needed | FCMOBILETOOLS" description="Calculate FC Mobile Training XP, cards needed, excess XP and training progress from any level to 30. Compare fodder card XP values and plan upgrades instantly.">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebApplication","name":"FC Mobile Training Calculator","url":"https://tanzimfc.fcmobiletools.workers.dev/training-calculator","applicationCategory":"UtilitiesApplication","operatingSystem":"Any","description":"Calculate FC Mobile Training XP, cards required, excess XP and training progress.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@type":"Organization","name":"FCMOBILETOOLS"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"FC Mobile Tools","item":"https://tanzimfc.fcmobiletools.workers.dev/"},{"@type":"ListItem","position":2,"name":"Training Calculator","item":"https://tanzimfc.fcmobiletools.workers.dev/training-calculator"}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much XP do I need to train a player in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"The XP required depends on the player's current Training Level and target Training Level. Use the FC Mobile Training Calculator to calculate the exact XP difference."}},{"@type":"Question","name":"What is the maximum Training Level in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"The current training table used by this calculator has a maximum Training Level of 30."}},{"@type":"Question","name":"How many cards do I need for training in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"Choose your fodder card OVR range and the calculator divides the required XP by that card's XP value, rounding up to a whole number of cards."}},{"@type":"Question","name":"Does training increase OVR in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"Training improves player stats but does not increase the player's OVR. Rank Up is the system used to increase OVR."}},{"@type":"Question","name":"How much XP is retained during Training Transfer?","acceptedAnswer":{"@type":"Answer","text":"The current calculator uses a 90% Training Transfer rate, meaning 10% of stored XP is lost during the transfer."}}]}
</script>
<main class="training-page">
<section class="hero"><div class="hero-grid"></div><div class="hero-glow hero-glow-a"></div><div class="hero-glow hero-glow-b"></div><div class="wrap"><nav class="crumb" aria-label="Breadcrumb"><a href="/">FC Mobile Tools</a><span>/</span>Training Calculator</nav><div class="hero-layout"><div><div class="eyebrow"><i></i> FC MOBILE TOOLS / CALCULATOR 05</div><h1>Training <span>Calculator</span></h1><p class="hero-copy">Build a precise training plan. Calculate XP required, fodder cards, excess XP and the exact path from your current level to 30.</p><div class="hero-tags"><span>XP PLANNER</span><span>LEVEL 0 → 30</span><span>FREE</span></div></div><div class="hero-visual" aria-hidden="true"><div class="visual-ring ring-one"></div><div class="visual-ring ring-two"></div><div class="xp-core"><strong>XP</strong><span>TRAIN</span></div><div class="float-card fc-one">LVL <b>30</b></div><div class="float-card fc-two">+XP <b>PLAN</b></div></div></div></div></section>
<section class="workspace"><div class="wrap"><div class="calculator"><div class="calc-top"><div><span class="section-label">TRAINING PLAN</span><h2>Set your target</h2><p>Choose where the player starts, where they finish and which fodder you use</p></div><div class="cap"><span>MAX</span><strong>30</strong><small>LEVEL</small></div></div><div class="inputs"><label><span><b>01</b> Current Level</span><select id="currentLevel" aria-label="Current Training Level"></select><small>Player's current training level</small></label><label><span><b>02</b> Target Level</span><select id="targetLevel" aria-label="Target Training Level"></select><small>Level you want to reach</small></label><label><span><b>03</b> Fodder OVR</span><select id="fodderId" aria-label="Fodder Card OVR"></select><small>XP value per training card</small></label></div><div class="alert" id="alert" hidden></div><div class="result-grid"><div class="main-result"><span class="result-label">XP REQUIRED</span><div class="big-number" id="xpRequired">0</div><div class="result-note" id="planText">Select your training plan above</div></div><div class="metric"><span>CARDS NEEDED</span><strong id="cardsNeeded">0</strong><small id="cardText">—</small></div><div class="metric"><span>XP PER CARD</span><strong id="xpPerCard">0</strong><small>training value</small></div><div class="metric"><span>EXCESS XP</span><strong id="extraXP">0</strong><small>left after training</small></div><div class="metric"><span>LEVELS GAINED</span><strong id="levelsGained">0</strong><small id="levelText">—</small></div></div><div class="progress-wrap"><div class="progress-head"><span id="progressFrom">LEVEL 0</span><strong id="progressPct">0%</strong><span id="progressTo">LEVEL 30</span></div><div class="progress"><div id="progressFill"></div><i id="progressMarker"></i></div></div><div class="breakdown-head"><div><span class="section-label">PRECISION VIEW</span><h3>Training breakdown</h3></div><button id="toggleBreakdown" type="button">SHOW BREAKDOWN <span>+</span></button></div><div class="breakdown" id="breakdown" hidden><div class="breakdown-summary"><span>Each level cost</span><strong id="breakdownTotal">0 XP</strong></div><div class="table-scroll"><table><thead><tr><th>LEVEL</th><th>XP FOR LEVEL</th><th>CUMULATIVE XP</th></tr></thead><tbody id="breakdownTable"></tbody></table></div></div></div><div class="lower-grid"><section class="panel reverse-panel"><div class="panel-icon">↗</div><span class="section-label">REVERSE PLANNER</span><h2>How far can my XP take me?</h2><p>Enter a starting level and XP budget to find the highest level you can reach</p><div class="reverse-fields"><label>Starting Level<select id="reverseStart"></select></label><label>Available XP<input id="xpBudget" type="number" min="0" step="100" placeholder="10000"></label></div><div class="reverse-result" id="reverseOut">Enter your XP budget to calculate a target</div></section><section class="panel transfer-panel"><div class="panel-icon">↔</div><span class="section-label">TRANSFER CHECK</span><h2>Training Transfer</h2><p>See how much stored XP arrives after the current transfer rate</p><label>Source Training Level<select id="transferLevel"></select></label><div class="transfer-stats"><div><span>STORED XP</span><strong id="sourceXP">0</strong></div><div><span>RECEIVED XP</span><strong id="receivedXP">0</strong></div><div><span>XP LOST</span><strong id="lostXP">0</strong></div></div></section></div></div></section>
<section class="reference-section"><div class="wrap"><div class="section-intro"><span class="section-label">REFERENCE DATA</span><h2>FC Mobile training XP table</h2><p>Quick reference for the XP required at every training level and the XP value of common fodder ranges</p></div><div class="ref-grid"><div class="ref-card"><div class="ref-head"><div><h3>XP by training level</h3><span>Level 0 through 30</span></div><b>30 LEVELS</b></div><div class="table-scroll"><table><thead><tr><th>LEVEL</th><th>TOTAL XP</th><th>XP TO NEXT</th></tr></thead><tbody id="fullTable"></tbody></table></div></div><div class="ref-card"><div class="ref-head"><div><h3>Fodder XP values</h3><span>XP gained per card</span></div><b>FODDER</b></div><div class="fodder-list" id="fodderList"></div></div></div></div></section>
<section class="seo-section"><div class="wrap narrow"><span class="section-label">FC MOBILE TRAINING GUIDE</span><h2>Plan player training with exact XP numbers</h2><div class="prose"><p>The FCMOBILETOOLS Training Calculator turns the game's training table into a fast planning tool. Pick a current level, target level and fodder OVR range to see the XP required and the number of cards needed.</p><p>The calculator rounds cards up to the next whole card because training cards cannot be used fractionally. Any XP supplied above the exact requirement is shown as excess XP so you can see the real training outcome.</p><p>Training Level and Rank Up are separate systems. Training improves player stats, while Rank Up increases the player's OVR. Use the <a href="/rank-up-calculator">Rank Up Calculator</a> when you are planning OVR upgrades.</p></div><div class="faq" id="faqList"></div></div></section>
</main>
<style>
:root{--bg:#05080d;--panel:#0b1119;--panel2:#101923;--line:#1d2b39;--text:#f3f8fc;--muted:#7f92a2;--cyan:#39c6ff;--cyan2:#0ea5e9;--blue:#4778ff;--red:#ff4d5e;--mono:'IBM Plex Mono',ui-monospace,monospace;--sans:'Manrope',Inter,system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:var(--cyan);text-decoration:none}button,input,select{font:inherit}button{cursor:pointer}::selection{background:var(--cyan);color:#031018}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.narrow{width:min(860px,100%)}.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);padding:30px 0 50px;isolation:isolate}.hero-grid{position:absolute;inset:0;z-index:-2;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:46px 46px;opacity:.025}.hero:after{content:'';position:absolute;inset:0;z-index:-3;background:radial-gradient(ellipse 650px 420px at 18% 5%,#0ea5e91c,transparent 70%),radial-gradient(ellipse 500px 360px at 88% 25%,#4778ff12,transparent 70%)}.hero-glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.14;z-index:-1}.hero-glow-a{width:260px;height:260px;background:var(--cyan);left:-100px;top:80px}.hero-glow-b{width:220px;height:220px;background:var(--blue);right:4%;top:80px}.crumb{display:flex;gap:9px;align-items:center;font:700 10px var(--mono);color:#66798a;margin-bottom:42px}.crumb a{color:var(--cyan)}.hero-layout{display:grid;grid-template-columns:1fr 360px;gap:60px;align-items:center}.eyebrow,.section-label{font:800 9px var(--mono);letter-spacing:.16em;color:var(--cyan)}.eyebrow i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px #ff4d5e15;margin-right:8px;animation:beep 1.7s infinite}.hero h1{font-size:clamp(54px,7vw,88px);line-height:.92;letter-spacing:-.07em;margin:14px 0 18px;font-weight:900}.hero h1 span{display:block;background:linear-gradient(105deg,#fff 5%,var(--cyan) 72%);-webkit-background-clip:text;background-clip:text;color:transparent}.hero-copy{max-width:650px;color:#8fa2b1;font-size:15px;line-height:1.75;margin:0}.hero-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.hero-tags span{border:1px solid var(--line);background:#0a1119aa;border-radius:7px;padding:7px 10px;color:#8295a5;font:700 8px var(--mono)}.hero-visual{height:310px;position:relative;display:grid;place-items:center}.visual-ring{position:absolute;border:1px solid #39c6ff24;border-radius:50%;animation:spin 18s linear infinite}.ring-one{width:250px;height:250px}.ring-two{width:175px;height:175px;border-style:dashed;animation-direction:reverse;animation-duration:12s}.xp-core{width:118px;height:118px;border-radius:30px;border:1px solid #39c6ff55;background:linear-gradient(145deg,#102532,#08121b);box-shadow:0 0 60px #39c6ff18,inset 0 0 30px #39c6ff0c;display:grid;place-items:center;align-content:center;position:relative;z-index:2;transform:rotate(-6deg)}.xp-core strong{font:900 43px var(--mono);letter-spacing:-.08em;color:#eafaff}.xp-core span{font:800 7px var(--mono);letter-spacing:.2em;color:var(--cyan)}.float-card{position:absolute;border:1px solid var(--line);background:#0b131ccc;backdrop-filter:blur(12px);border-radius:10px;padding:9px 11px;font:700 8px var(--mono);color:#6f8595;z-index:3}.float-card b{display:block;color:#eef8ff;font-size:13px;margin-top:2px}.fc-one{right:8px;top:54px;transform:rotate(7deg)}.fc-two{left:8px;bottom:55px;transform:rotate(-6deg)}.workspace{padding:42px 0 70px}.calculator{border:1px solid var(--line);background:linear-gradient(145deg,#0c141d,#080e15);border-radius:24px;box-shadow:0 30px 100px #00000050;overflow:hidden}.calc-top{display:flex;justify-content:space-between;gap:20px;padding:28px 30px;border-bottom:1px solid var(--line)}.calc-top h2{font-size:25px;letter-spacing:-.035em;margin:7px 0 5px}.calc-top p{font-size:12px;color:var(--muted);margin:0}.cap{min-width:82px;text-align:center;border:1px solid #39c6ff2a;background:#39c6ff08;padding:10px;border-radius:11px;display:grid;align-content:center}.cap span,.cap small{font:700 7px var(--mono);color:#67808f;letter-spacing:.12em}.cap strong{font:900 25px var(--mono);color:var(--cyan)}.inputs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:22px 30px}.inputs label,.reverse-fields label,.transfer-panel>label{display:grid;gap:8px;color:#8799a8;font:800 9px var(--mono)}.inputs label span{color:#e5edf2;font-size:10px}.inputs label span b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#39c6ff12;color:var(--cyan);font-size:8px;margin-right:7px}.inputs small{color:#556a79;font:600 8px var(--sans)}select,input{width:100%;border:1px solid #263746;background:#080f16;color:#eef7fb;border-radius:10px;padding:13px 12px;outline:none;font:800 11px var(--mono);transition:border-color .18s,box-shadow .18s}.inputs select{height:47px}select:focus,input:focus{border-color:#39c6ff77;box-shadow:0 0 0 3px #39c6ff0c}.alert{margin:0 30px 18px;padding:11px 13px;border:1px solid #ff4d5e33;background:#ff4d5e09;color:#ff9ca6;border-radius:9px;font-size:11px}.result-grid{display:grid;grid-template-columns:1.7fr repeat(4,1fr);gap:1px;margin:0 30px;background:var(--line);border:1px solid var(--line);border-radius:15px;overflow:hidden}.result-grid>*{background:#0a1119;padding:20px}.main-result{min-height:142px}.result-label{font:800 8px var(--mono);letter-spacing:.15em;color:#6f8595}.big-number{font:900 clamp(36px,5vw,56px) var(--mono);letter-spacing:-.07em;line-height:1.05;margin:9px 0 5px;background:linear-gradient(100deg,#fff,var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}.result-note{color:#6f8493;font-size:9px}.metric span{display:block;font:800 7px var(--mono);letter-spacing:.1em;color:#657b8b;margin-bottom:10px}.metric strong{display:block;font:900 20px var(--mono);color:#eef8fc}.metric small{display:block;color:#526777;font-size:8px;margin-top:5px}.progress-wrap{padding:22px 30px}.progress-head{display:grid;grid-template-columns:1fr auto 1fr;font:800 8px var(--mono);color:#647989}.progress-head strong{text-align:center;color:var(--cyan)}.progress-head span:last-child{text-align:right}.progress{height:8px;border-radius:99px;background:#18232e;position:relative;margin-top:10px;overflow:visible}.progress>div{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan));box-shadow:0 0 20px #39c6ff44;transition:width .3s}.progress i{position:absolute;top:50%;width:14px;height:14px;border:2px solid #071018;background:var(--cyan);border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 4px #39c6ff1a;transition:left .3s}.breakdown-head{border-top:1px solid var(--line);padding:20px 30px;display:flex;justify-content:space-between;align-items:center}.breakdown-head h3{margin:6px 0 0;font-size:17px}.breakdown-head button{border:1px solid var(--line);background:#0b141d;color:#8ea1af;padding:9px 12px;border-radius:8px;font:800 8px var(--mono)}.breakdown-head button span{color:var(--cyan);margin-left:6px}.breakdown{border-top:1px solid var(--line);padding:18px 30px 28px}.breakdown-summary{display:flex;justify-content:space-between;color:#647a8a;font-size:9px;margin-bottom:10px}.breakdown-summary strong{font:900 11px var(--mono);color:#dcebf2}.table-scroll{overflow:auto}.table-scroll table{width:100%;border-collapse:collapse;min-width:420px;font:700 9px var(--mono)}th{color:#587080;font-size:7px;letter-spacing:.08em;text-align:left;padding:10px;border-bottom:1px solid var(--line)}td{padding:10px;border-bottom:1px solid #15222d;color:#a9bbc6}td:last-child,th:last-child{text-align:right}.lower-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:14px}.panel{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:23px}.panel-icon{width:34px;height:34px;border-radius:9px;border:1px solid #39c6ff28;background:#39c6ff09;display:grid;place-items:center;color:var(--cyan);font:900 15px var(--mono);margin-bottom:18px}.panel h2{font-size:19px;letter-spacing:-.03em;margin:7px 0}.panel p{color:#718595;font-size:10px;line-height:1.65;margin:0 0 17px}.reverse-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px}.reverse-result{margin-top:12px;padding:14px;border-radius:10px;background:#08131a;border:1px solid #1a3341;color:#79909e;font-size:9px}.reverse-result strong{color:var(--cyan);font:900 20px var(--mono);display:block;margin-top:5px}.transfer-panel>label{margin-top:16px}.transfer-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.transfer-stats div{padding:11px;background:#081018;border:1px solid #192833;border-radius:9px}.transfer-stats span{display:block;font:700 6px var(--mono);color:#566c7b}.transfer-stats strong{display:block;font:900 13px var(--mono);margin-top:5px}.reference-section{padding:75px 0;border-top:1px solid var(--line);background:#070c12}.section-intro{max-width:650px;margin-bottom:24px}.section-intro h2,.seo-section h2{font-size:clamp(28px,4vw,40px);letter-spacing:-.045em;margin:9px 0}.section-intro p{color:#718494;font-size:12px}.ref-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:14px}.ref-card{border:1px solid var(--line);background:#0b121a;border-radius:18px;overflow:hidden}.ref-head{padding:20px;display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line)}.ref-head h3{margin:0;font-size:15px}.ref-head span{font-size:9px;color:#617585}.ref-head>b{font:800 7px var(--mono);color:#5c7382;border:1px solid var(--line);padding:7px 8px;border-radius:6px;height:max-content}.ref-card .table-scroll{padding:0 15px 12px}.ref-card table{font-size:9px}.fodder-list{padding:12px}.fodder-row{display:grid;grid-template-columns:1fr auto;gap:15px;padding:13px 9px;border-bottom:1px solid #15212c;align-items:center}.fodder-row:last-child{border:0}.fodder-row span{font-size:10px;color:#d0dde4}.fodder-row small{display:block;color:#566d7c;font-size:8px;margin-top:2px}.fodder-row strong{font:900 12px var(--mono);color:var(--cyan)}.seo-section{padding:75px 0}.prose{color:#8395a3;font-size:12px;line-height:1.85}.prose p{margin:0 0 16px}.faq{margin-top:28px;border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-q{width:100%;display:flex;justify-content:space-between;text-align:left;border:0;background:none;color:#e5eef3;padding:16px 0;font-weight:800;font-size:11px}.faq-q span{color:var(--cyan);font-family:var(--mono)}.faq-a{display:none;color:#718493;font-size:10px;line-height:1.75;padding:0 20px 16px 0}.faq-item.open .faq-a{display:block}@keyframes beep{0%,72%,100%{box-shadow:0 0 0 5px #ff4d5e15}76%{box-shadow:0 0 0 9px #ff4d5e00}80%{box-shadow:0 0 0 5px #ff4d5e15}}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:900px){.hero-layout{grid-template-columns:1fr}.hero-visual{display:none}.result-grid{grid-template-columns:1.5fr 1fr 1fr}.result-grid .metric:last-child{grid-column:span 2}.lower-grid,.ref-grid{grid-template-columns:1fr}.inputs{grid-template-columns:1fr}.hero h1{font-size:clamp(50px,12vw,76px)}}@media(max-width:600px){.wrap{width:min(100% - 26px,1120px)}.hero{padding:22px 0 38px}.crumb{margin-bottom:30px}.calc-top{padding:22px 18px}.cap{display:none}.inputs,.progress-wrap,.breakdown-head,.breakdown{padding-left:18px;padding-right:18px}.result-grid{margin:0 18px;grid-template-columns:1fr 1fr}.main-result{grid-column:1/-1}.result-grid .metric:last-child{grid-column:auto}.big-number{font-size:43px}.lower-grid{margin-top:10px}.panel{padding:19px}.reverse-fields{grid-template-columns:1fr}.transfer-stats{grid-template-columns:1fr}.reference-section,.seo-section{padding:55px 0}.ref-head{align-items:flex-start}.hero-tags span{font-size:7px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
<script>
import { calculateTraining, calculateTransfer } from '../lib/fcMobileTraining.js';
const current=document.querySelector('#currentLevel'),target=document.querySelector('#targetLevel'),fodder=document.querySelector('#fodderId'),fmt=n=>new Intl.NumberFormat('en-US').format(n);
const xpRequired=document.querySelector('#xpRequired'),cardsNeeded=document.querySelector('#cardsNeeded'),xpPerCard=document.querySelector('#xpPerCard'),extraXP=document.querySelector('#extraXP'),levelsGained=document.querySelector('#levelsGained'),planText=document.querySelector('#planText'),cardText=document.querySelector('#cardText'),levelText=document.querySelector('#levelText'),progressFill=document.querySelector('#progressFill'),progressMarker=document.querySelector('#progressMarker'),progressFrom=document.querySelector('#progressFrom'),progressTo=document.querySelector('#progressTo'),progressPct=document.querySelector('#progressPct'),alertBox=document.querySelector('#alert'),breakdownTable=document.querySelector('#breakdownTable'),breakdownTotal=document.querySelector('#breakdownTotal');
const reverseStart=document.querySelector('#reverseStart'),xpBudget=document.querySelector('#xpBudget'),reverseOut=document.querySelector('#reverseOut'),transferLevel=document.querySelector('#transferLevel'),sourceXP=document.querySelector('#sourceXP'),receivedXP=document.querySelector('#receivedXP'),lostXP=document.querySelector('#lostXP');
for(let i=0;i<=MAX_TRAINING_LEVEL;i++){current.insertAdjacentHTML('beforeend',`<option value="${i}">Level ${i}</option>`);target.insertAdjacentHTML('beforeend',`<option value="${i}">Level ${i}</option>`);reverseStart.insertAdjacentHTML('beforeend',`<option value="${i}">Level ${i}</option>`);transferLevel.insertAdjacentHTML('beforeend',`<option value="${i}">Level ${i}</option>`)}FODDER.forEach((f,i)=>fodder.insertAdjacentHTML('beforeend',`<option value="${f.id}" ${i===0?'selected':''}>${f.label} · ${fmt(f.xp)} XP</option>`));current.value='10';target.value='20';reverseStart.value='10';transferLevel.value='20';
function render(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c);const d=calculateTraining({currentLevel:current.value,targetLevel:target.value,fodderId:fodder.value});if(!d.valid){alertBox.hidden=false;alertBox.textContent=d.error;return}alertBox.hidden=true;xpRequired.textContent=fmt(d.requiredXP);cardsNeeded.textContent=fmt(d.cards);xpPerCard.textContent=fmt(d.fodder.xp);extraXP.textContent=fmt(d.extraXP);levelsGained.textContent=fmt(d.targetLevel-d.currentLevel);planText.textContent=`Level ${d.currentLevel} → ${d.targetLevel} using ${d.fodder.label}`;cardText.textContent=`${d.fodder.label} cards`;levelText.textContent=`${d.currentLevel} → ${d.targetLevel}`;progressFrom.textContent=`LEVEL ${d.currentLevel}`;progressTo.textContent=`LEVEL ${d.targetLevel}`;const pct=d.currentLevel===d.targetLevel?0:((d.targetLevel-d.currentLevel)/(MAX_TRAINING_LEVEL-d.currentLevel))*100;progressFill.style.width=`${Math.min(100,pct)}%`;progressMarker.style.left=`${Math.min(100,pct)}%`;progressPct.textContent=`${Math.round(pct)}%`;breakdownTotal.textContent=fmt(d.requiredXP)+' XP';breakdownTable.innerHTML='';for(let level=d.currentLevel+1;level<=d.targetLevel;level++){const cost=TRAINING_LEVELS[level]-TRAINING_LEVELS[level-1];breakdownTable.insertAdjacentHTML('beforeend',`<tr><td>Level ${level}</td><td>${fmt(cost)} XP</td><td>${fmt(TRAINING_LEVELS[level]-TRAINING_LEVELS[d.currentLevel])} XP</td></tr>`)}}
function reverse(){const start=Number(reverseStart.value),budget=Number(xpBudget.value);if(!Number.isFinite(budget)||budget<0){reverseOut.textContent='Enter a valid XP budget';return}const available=TRAINING_LEVELS[start]+budget;let level=start;while(level<MAX_TRAINING_LEVEL&&TRAINING_LEVELS[level+1]<=available)level++;const spent=TRAINING_LEVELS[level]-TRAINING_LEVELS[start];reverseOut.innerHTML=`<span>You can reach</span><strong>Level ${level}</strong><span>${fmt(spent)} XP used · ${fmt(available-spent)} XP remaining</span>`}
function transfer(){const d=calculateTransfer(transferLevel.value);sourceXP.textContent=fmt(d.sourceXP);receivedXP.textContent=fmt(d.receivedXP);lostXP.textContent=fmt(d.lostXP)}[current,target,fodder].forEach(x=>x.addEventListener('change',render));[reverseStart,xpBudget].forEach(x=>x.addEventListener('input',reverse));transferLevel.addEventListener('change',transfer);render();reverse();transfer();
document.querySelector('#toggleBreakdown').addEventListener('click',e=>{const box=document.querySelector('#breakdown');box.hidden=!box.hidden;e.currentTarget.innerHTML=box.hidden?'SHOW BREAKDOWN <span>+</span>':'HIDE BREAKDOWN <span>−</span>'});document.querySelector('#fullTable').innerHTML=TRAINING_LEVELS.map((v,i)=>`<tr><td>${i}</td><td>${fmt(v)} XP</td><td>${i<MAX_TRAINING_LEVEL?fmt(TRAINING_LEVELS[i+1]-v):'—'}</td></tr>`).join('');document.querySelector('#fodderList').innerHTML=FODDER.map(f=>`<div class="fodder-row"><div><span>${f.label}</span><small>Training card value</small></div><strong>${fmt(f.xp)} XP</strong></div>`).join('');
const faqs=[['How much XP do I need to train a player in FC Mobile?','The required XP is the difference between the total XP at your target level and the total XP already stored at your current level.'],['What is the maximum Training Level?','This calculator uses the current training table with a Level 30 cap.'],['How are cards needed calculated?','Required XP is divided by the selected fodder card XP value and rounded up to the next whole card.'],['Does training increase player OVR?','No. Training improves player stats. Rank Up is used to increase player OVR.'],['How does Training Transfer work?','The current transfer rate is 90%, so 10% of stored XP is lost during transfer.']];document.querySelector('#faqList').innerHTML=faqs.map((f,i)=>`<div class="faq-item ${i===0?'open':''}"><button class="faq-q" type="button">${f[0]}<span>+</span></button><div class="faq-a">${f[1]}</div></div>`).join('');document.querySelectorAll('.faq-q').forEach(b=>b.addEventListener('click',()=>{const item=b.parentElement;item.classList.toggle('open');b.querySelector('span').textContent=item.classList.contains('open')?'−':'+'}));
</script>
</BaseLayout>