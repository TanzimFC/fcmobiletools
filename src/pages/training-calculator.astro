.training-page .g-track{fill:none;stroke:rgba(150,210,235,.12);stroke-width:7}
.training-page .g-arc{fill:none;stroke:url(#gg);stroke-width:7;stroke-linecap:round;stroke-dasharray:100 100;stroke-dashoffset:100;filter:drop-shadow(0 0 6px rgba(76,201,255,.55));transition:stroke-dashoffset 1.1s cubic-bezier(.2,.75,.2,1)}
