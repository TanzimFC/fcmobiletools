---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';
const fmt = (n) => Number(n).toLocaleString();
const nextXp = (i) => i < MAX_TRAINING_LEVEL ? `${fmt(TRAINING_LEVELS[i + 1] - TRAINING_LEVELS[i])} XP` : 'MAX';
---
<BaseLayout title="FC Mobile Training Calculator | XP Calculator | FCMOBILETOOLS" description="Calculate FC Mobile Training XP, cards required, excess XP and every Training Level from 0 to 30 with a complete reference table.">
<main class="training-page">
<header class="hero"><div class="wrap"><nav><a href="/">FCMOBILETOOLS</a><span>›</span><span>Training Calculator</span></nav><div class="hero-grid"><div><span class="eyebrow">FC MOBILE / TRAINING LAB</span><h1>Training <em>Calculator</em></h1><p>Calculate the exact XP needed to reach any Training Level, cards required and excess XP.</p><div class="pills"><span>LEVEL 0–30</span><span>XP PLANNER</span><span>FULL DATA</span></div></div><div class="hero-mark"><strong>XP</strong><small>TRAINING</small></div></div></div></header>
<section class="wrap section"><div class="calculator-shell">
  <div class="planner-head"><div><span class="label">XP PLANNER</span><h2>Build your training plan</h2><p>Choose a starting level, target level and fodder card. The calculation engine stays unchanged.</p></div><b class="max">MAX R30</b></div>
  <div class="fields"><label>Current Level<select id="currentLevel">${TRAINING_LEVELS.map((_, i) => <option value={i}>Level {i}</option>)}</select></label><label>Target Level<select id="targetLevel">${TRAINING_LEVELS.map((_, i) => <option value={i}>Level {i}</option>)}</select></label><label>Fodder OVR<select id="fodderId">${FODDER.map((f) => <option value={f.id}>{f.label} — {fmt(f.xp)} XP</option>)}</select></label></div>
  <div id="error" class="error" hidden></div>
  <div class="summary-grid">
    <article class="xp-summary"><small>XP REQUIRED</small><strong id="required">0</strong><p id="summary">Choose your levels</p><div class="summary-route"><span id="summaryFrom">LEVEL 0</span><i></i><span id="summaryTo">LEVEL 30</span></div></article>
    <div class="metric-grid"><article><small>REQUIRED PLAYERS</small><b id="cards">0</b><span>Cards</span></article><article><small>XP PER CARD</small><b id="perCard">0</b><span>Selected fodder</span></article><article><small>COINS</small><b id="coins">320K</b><span>Visual reference</span></article><article><small>EXCESS XP</small><b id="extra">0</b><span>After training</span></article></div>
  </div>
  <div class="progress-card"><div class="progress-meta"><span id="from">LEVEL 0</span><b id="pct">0%</b><span id="to">LEVEL 30</span></div><div class="progress-track"><i id="fill"></i></div></div>
  <div class="best-route"><div><span class="label">BEST VALUE ROUTE</span><h3>Lowest-cost combination highlighted automatically.</h3><p id="bestRouteText">Select your training route to calculate the recommended combination.</p></div><strong id="bestRouteValue">—</strong></div>
  <div class="break"><div class="break-title"><span class="label">LEVEL BREAKDOWN</span><h3>Expandable training levels</h3><p>Open a level to see the XP added and cumulative total.</p></div><div id="breakdown" class="level-cards"></div></div>
</div></section>
<section class="reference"><div class="wrap"><div class="section-title"><span class="label">REFERENCE DATA</span><h2>FC Mobile Training XP table</h2><p>All 31 levels and all configured fodder values are rendered directly from the source data.</p></div><div class="reference-grid"><div class="ref-card"><h3>XP by Training Level</h3><div class="scroll"><table><thead><tr><th>LEVEL</th><th>TOTAL XP</th><th>XP TO NEXT</th></tr></thead><tbody>{TRAINING_LEVELS.map((xp, i) => <tr><td>Level {i}</td><td>{fmt(xp)} XP</td><td>{nextXp(i)}</td></tr>)}</tbody></table></div></div><div class="ref-card"><h3>Fodder XP Values</h3><div class="fodder-grid">{FODDER.map((f) => <div><span>{f.label}</span><b>{fmt(f.xp)} XP</b></div>)}</div></div></div></div></section>
<section class="faq"><div class="wrap"><span class="label">FAQ</span><h2>FC Mobile Training Calculator FAQ</h2><details open><summary>How much XP do I need?</summary><p>The calculator subtracts the stored cumulative XP of the current level from the target level.</p></details><details><summary>How are cards calculated?</summary><p>Required XP is divided by the selected fodder XP and rounded up to a whole card.</p></details></div></section></main>
<script>
import { calculateTraining } from '../lib/fcMobileTraining.js';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';
const $ = (id) => document.getElementById(id);
const fmt = (n) => Number(n).toLocaleString();
const current = $('currentLevel');
const target = $('targetLevel');
const fodder = $('fodderId');
current.value = '0';
target.value = String(MAX_TRAINING_LEVEL);
fodder.value = FODDER[FODDER.length - 1].id;
function render() {
  const d = calculateTraining({ currentLevel: current.value, targetLevel: target.value, fodderId: fodder.value });
  if (!d.valid) {
    $('error').hidden = false;
    $('error').textContent = d.error;
    return;
  }
  $('error').hidden = true;
  $('required').textContent = fmt(d.requiredXP);
  $('cards').textContent = fmt(d.cards);
  $('perCard').textContent = fmt(d.fodder.xp);
  $('extra').textContent = fmt(d.extraXP);
  $('gained').textContent = d.targetLevel - d.currentLevel;
  $('summary').textContent = `Level ${d.currentLevel} → Level ${d.targetLevel} using ${d.fodder.label}`;
  $('summaryFrom').textContent = `LEVEL ${d.currentLevel}`;
  $('summaryTo').textContent = `LEVEL ${d.targetLevel}`;
  $('from').textContent = `LEVEL ${d.currentLevel}`;
  $('to').textContent = `LEVEL ${d.targetLevel}`;
  const pct = Math.round(d.targetLevel / MAX_TRAINING_LEVEL * 100);
  $('pct').textContent = `${pct}%`;
  $('fill').style.width = `${pct}%`;
  $('bestRouteText').textContent = `${d.cards} × ${d.fodder.label} cards supplies ${fmt(d.cards * d.fodder.xp)} XP for the selected route.`;
  $('bestRouteValue').textContent = d.extraXP > 0 ? `+${fmt(d.extraXP)} XP` : 'Exact fit';
  const rows = [];
  for (let i = d.currentLevel; i < d.targetLevel; i++) {
    const step = TRAINING_LEVELS[i + 1] - TRAINING_LEVELS[i];
    rows.push(`<details class="level-card" ${i === d.currentLevel ? 'open' : ''}><summary><span><b>Level ${i} → ${i + 1}</b><small>${fmt(step)} XP added</small></span><strong>${fmt(TRAINING_LEVELS[i + 1])} XP</strong><i>+</i></summary><div class="level-detail"><span>Required for this step</span><b>${fmt(step)} XP</b><span>Cumulative XP</span><b>${fmt(TRAINING_LEVELS[i + 1])} XP</b></div></details>`);
  }
  $('breakdown').innerHTML = rows.join('') || '<div class="empty-breakdown">No XP required</div>';
}
[current, target, fodder].forEach((e) => e.addEventListener('change', render));
render();
</script>
<style>
:root{--bg:#071018;--panel:#0f1a26;--panel2:#132333;--line:rgba(255,255,255,.08);--text:#f5f8fb;--muted:#a7b4c3;--cyan:#4cc9ff;--cyan2:#63d4ff;--green:#47d16c;--mono:'Space Grotesk',system-ui,sans-serif;--sans:'Inter',system-ui,sans-serif}
*{box-sizing:border-box}.training-page{background:radial-gradient(700px 380px at 82% 4%,rgba(76,201,255,.08),transparent 70%);padding-bottom:24px}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}.hero{border-bottom:1px solid var(--line);background:radial-gradient(700px 400px at 8% 0,rgba(76,201,255,.1),transparent 64%)}.hero>.wrap{padding:34px 0 58px}.hero nav{display:flex;gap:10px;color:#718394;font:700 10px var(--mono);margin-bottom:58px}.hero nav a{color:var(--cyan)}.hero-grid{display:grid;grid-template-columns:1fr 240px;gap:40px;align-items:center}.eyebrow,.label{font:800 10px var(--mono);letter-spacing:.14em;color:var(--cyan)}h1{font:700 clamp(50px,7vw,88px)/.9 var(--mono);letter-spacing:-.07em;margin:15px 0 20px}h1 em{font-style:normal;color:var(--cyan)}.hero p{max-width:650px;color:var(--muted);font-size:15px;line-height:1.7}.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.pills span{padding:8px 10px;border:1px solid var(--line);border-radius:999px;color:#7f92a1;font:700 8px var(--mono)}.hero-mark{height:210px;display:grid;place-items:center;align-content:center;border:1px solid rgba(76,201,255,.16);border-radius:28px;background:linear-gradient(145deg,#102433,#0a141e);box-shadow:0 24px 80px rgba(0,0,0,.3),0 0 80px rgba(76,201,255,.08)}.hero-mark strong{font:900 76px var(--mono);letter-spacing:-.09em}.hero-mark small{color:var(--cyan);font:800 8px var(--mono);letter-spacing:.2em}.section{padding:42px 0 70px}.calculator-shell{border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,#0f1a26,#0b131c);box-shadow:0 24px 70px rgba(0,0,0,.24);overflow:hidden}.planner-head{display:flex;justify-content:space-between;gap:20px;padding:28px;border-bottom:1px solid var(--line)}h2{font-size:28px;letter-spacing:-.04em;margin:7px 0}.planner-head p{margin:0;color:var(--muted);font-size:12px}.max{height:max-content;padding:10px 12px;border:1px solid rgba(76,201,255,.22);border-radius:10px;color:var(--cyan);background:rgba(76,201,255,.06);font:800 9px var(--mono)}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:24px 28px}.fields label{display:grid;gap:8px;color:#91a3b2;font:800 9px var(--mono)}select{width:100%;min-height:48px;padding:0 13px;border:1px solid #284051;border-radius:12px;background:#0b141d;color:var(--text);font:700 11px var(--mono);outline:0}.summary-grid{display:grid;grid-template-columns:minmax(0,1fr) 1.05fr;gap:14px;padding:0 28px}.xp-summary,.metric-grid article{border:1px solid rgba(255,255,255,.08);border-radius:18px;background:linear-gradient(145deg,#122635,#0b1822)}.xp-summary{padding:22px}.xp-summary small,.metric-grid small{font:800 8px var(--mono);letter-spacing:.12em;color:#76a4b6}.xp-summary strong{display:block;margin:8px 0;font:900 clamp(44px,6vw,76px)/.9 var(--mono);letter-spacing:-.08em}.xp-summary p{margin:0;color:var(--muted);font-size:11px}.summary-route{display:flex;align-items:center;gap:9px;margin-top:18px;color:#8ea2b1;font:800 8px var(--mono)}.summary-route i{width:40px;height:1px;background:linear-gradient(90deg,#264355,var(--cyan))}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.metric-grid article{padding:16px}.metric-grid b{display:block;margin:8px 0 3px;font:900 20px var(--mono);color:var(--text)}.metric-grid span{color:#708595;font-size:9px}.progress-card{margin:14px 28px 0;padding:16px 18px;border:1px solid var(--line);border-radius:15px;background:#0b141d}.progress-meta{display:flex;justify-content:space-between;color:#708595;font:800 8px var(--mono)}.progress-meta b{color:var(--cyan)}.progress-track{height:8px;margin-top:9px;border-radius:999px;background:#162735;overflow:hidden}.progress-track i{display:block;width:0;height:100%;border-radius:inherit;background:linear-gradient(90deg,#3a8dff,var(--cyan));transition:width .3s ease}.best-route{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:14px 28px;padding:18px 19px;border:1px solid rgba(71,209,108,.14);border-radius:16px;background:linear-gradient(135deg,rgba(71,209,108,.07),rgba(15,26,38,.92))}.best-route h3{margin:6px 0;font-size:15px}.best-route p{margin:0;color:var(--muted);font-size:10px;line-height:1.5}.best-route>strong{font:900 15px var(--mono);color:var(--green);white-space:nowrap}.break{margin-top:20px;border-top:1px solid var(--line)}.break-title{padding:24px 28px 12px}.break-title h3{margin:7px 0 5px;font-size:19px}.break-title p{margin:0;color:var(--muted);font-size:10px}.level-cards{display:grid;gap:8px;padding:0 28px 28px}.level-card{border:1px solid var(--line);border-radius:14px;background:#0b151f;overflow:hidden;transition:border-color .18s ease,background .18s ease}.level-card[open]{border-color:rgba(76,201,255,.22);background:#0d1924}.level-card summary{display:grid;grid-template-columns:minmax(0,1fr) auto 20px;gap:12px;align-items:center;padding:15px 16px;cursor:pointer;list-style:none}.level-card summary::-webkit-details-marker{display:none}.level-card summary b{display:block;font:800 11px var(--mono)}.level-card summary small{display:block;margin-top:4px;color:#708595;font-size:9px}.level-card summary strong{font:900 12px var(--mono);color:var(--cyan)}.level-card summary i{font-style:normal;color:#718797;font-size:18px;text-align:center;transition:transform .18s}.level-card[open] summary i{transform:rotate(45deg);color:var(--cyan)}.level-detail{display:grid;grid-template-columns:1fr auto;gap:10px;padding:14px 16px 16px;border-top:1px solid var(--line);font-size:9px;color:#718797}.level-detail b{font:900 10px var(--mono);color:var(--text)}.reference{padding:70px 0;background:#08111a;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.section-title{margin-bottom:22px}.section-title h2{margin:8px 0}.section-title p{margin:0;color:var(--muted);font-size:11px}.reference-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px}.ref-card{border:1px solid var(--line);border-radius:18px;background:#0d1721;padding:20px}.ref-card h3{margin:0 0 15px;font-size:16px}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:12px;border-top:1px solid var(--line);font-size:10px}th{color:#6f8594;font:800 8px var(--mono)}td{color:#d7e4ea}.fodder-grid{display:grid;gap:8px}.fodder-grid div{display:flex;justify-content:space-between;padding:12px;border:1px solid var(--line);border-radius:10px}.fodder-grid span{color:#8397a5;font-size:10px}.fodder-grid b{color:var(--cyan);font:800 10px var(--mono)}.faq{padding:70px 0}.faq details{border-top:1px solid var(--line);padding:17px 0}.faq summary{cursor:pointer;font-weight:800;font-size:12px}.faq p{color:var(--muted);font-size:11px;line-height:1.7}.error{margin:0 28px 14px;padding:11px;border:1px solid rgba(255,112,112,.25);background:rgba(255,112,112,.06);color:#ff9b9b;border-radius:10px;font:700 9px var(--mono)}.empty-breakdown{padding:18px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);font-size:11px}@media(max-width:820px){.hero-grid,.summary-grid,.reference-grid{grid-template-columns:1fr}.hero-mark{display:none}.fields{grid-template-columns:1fr}.wrap{width:calc(100% - 24px)}.planner-head{padding:22px}.summary-grid{padding:0 20px}.progress-card,.best-route{margin-left:20px;margin-right:20px}.level-cards{padding:0 20px 20px}.break-title{padding-left:20px;padding-right:20px}}@media(max-width:560px){.hero>.wrap{padding-bottom:44px}.hero nav{margin-bottom:38px}.hero h1{font-size:52px}.section{padding-top:28px}.fields{padding:18px 18px}.summary-grid{padding:0 18px}.xp-summary{padding:18px}.progress-card,.best-route{margin-left:18px;margin-right:18px}.best-route{align-items:flex-start;flex-direction:column}.level-cards{padding:0 18px 18px}.break-title{padding:22px 18px 12px}.metric-grid{gap:7px}.metric-grid article{padding:13px}.planner-head{align-items:flex-start;flex-direction:column}.reference{padding:55px 0}.section-title{padding-inline:0}}
</style>