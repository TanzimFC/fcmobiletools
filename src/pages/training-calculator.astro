.training-page .field .name{color:#e5f5fb;font:600 15px/1.2 var(--display);letter-spacing:-.01em;margin-bottom:8px}
.training-page .select{position:relative;display:block}
.training-page .select::after{content:"";position:absolute;right:16px;top:50%;width:8px;height:8px;margin-top:-6px;border-right:2px solid var(--cyan);border-bottom:2px solid var(--cyan);transform:rotate(45deg);pointer-events:none;transition:transform .2s}
.training-page .select:focus-within::after{transform:rotate(225deg);margin-top:-2px}
.training-page select{appearance:none;-webkit-appearance:none;width:100%;min-height:50px;padding:0 40px 0 14px;border:1px solid #21445a;border-radius:13px;background:#061522;color:var(--text);font:600 14px/1 var(--sans);cursor:pointer;transition:border-color .2s,box-shadow .2s}
