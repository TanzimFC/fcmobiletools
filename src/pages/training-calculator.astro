/* Reference */
.training-page .reference{position:relative;z-index:1;padding:76px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(76,201,255,.025),transparent 24%),#06121f}
