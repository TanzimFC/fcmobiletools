                <label for="haveXp">I already have this much TXP</label>
                <input type="number" id="haveXp" min="0" step="100" placeholder="e.g. 10000">
              </div>
              <div class="field">
                <label for="haveFrom">Starting from level</label>
                <select id="haveFrom"></select>
              </div>
            </div>
