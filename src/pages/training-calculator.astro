.training-page .max{align-self:flex-start;padding:10px 14px;border:1px solid rgba(76,201,255,.2);border-radius:999px;background:rgba(76,201,255,.06);color:var(--cyan);font:600 12px/1 var(--sans);white-space:nowrap}

/* Presets */
.training-page .presets{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:20px 30px 0}
