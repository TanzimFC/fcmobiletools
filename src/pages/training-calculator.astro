---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL, TRAINING_TRANSFER_RATE } from '../data/fcMobileTraining.js';
---
<BaseLayout title="FC Mobile Training Calculator | XP Calculator & Training Cost | FCMOBILETOOLS" description="FC Mobile Training Calculator to calculate exact XP, cards needed, excess XP and training costs from Level 0 to 30. Compare fodder XP values and plan training instantly.">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"FC Mobile Training Calculator","applicationCategory":"UtilitiesApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"description":"Calculate FC Mobile training XP, cards needed and training progress."}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much XP do I need to train a player in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"XP required depends on the current and target Training Level. Select both levels in the FC Mobile Training Calculator for the exact amount."}},{"@type":"Question","name":"What is the maximum Training Level in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"This calculator uses Training Level 30 as the maximum level in its current training data."}},{"@type":"Question","name":"How many cards do I need for FC Mobile training?","acceptedAnswer":{"@type":"Answer","text":"Choose a fodder OVR range and the calculator converts the required XP into the number of cards needed, rounding up to a whole card."}}]}</script>
<main class="tool-page training-page">
  <header class="hero"><div class="hero-grid"></div><div class="wrap hero-inner"><nav><a href="/">FCMOBILETOOLS</a><span>›</span><span>Training Calculator</span></nav><div class="hero-content"><div><div class="eyebrow"><i></i> FC MOBILE / TRAINING LAB</div><h1>Training <em>Calculator</em></h1><p>Turn your training goal into an exact XP plan. See cards required, excess XP and the full route to your target level.</p><div class="hero-pills"><span>XP PLANNER</span><span>LEVEL 0–30</span><span>LIVE CALCULATOR</span></div></div><div class="hero-art"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="core"><b>XP</b><small>TRAIN</small></div><div class="art-chip chip-a">LEVEL <b>30</b></div><div class="art-chip chip-b">+ XP <b>PLAN</b></div></div></div></div></header>
  <section class="wrap tool-wrap"><div class="tool-card"><div class="tool-head"><div><span class="label">TRAINING PLANNER</span><h2>Build your upgrade</h2><p>Pick the current level, target level and fodder card range</p></div><div class="max-badge"><small>MAX</small><b>30</b><span>LEVEL</span></div></div><div class="input-grid"><label><span><b>01</b> Current level</span><select id="currentLevel"></select><small>Where your player is now</small></label><label><span><b>02</b> Target level</span><select id="targetLevel"></select><small>Where you want to finish</small></label><label><span><b>03</b> Fodder OVR</span><select id="fodderId"></select><small>XP gained from each card</small></label></div><div id="alert" class="alert" hidden></div><div class="result"><div class="result-main"><span>XP REQUIRED</span><strong id="xpRequired">0</strong><p id="planText">Choose a training target</p></div><div class="result-stats"><div><small>CARDS NEEDED</small><b id="cardsNeeded">0</b><span id="cardText">—</span></div><div><small>XP PER CARD</small><b id="xpPerCard">0</b><span>training value</span></div><div><small>EXCESS XP</small><b id="extraXP">0</b><span>after training</span></div><div><small>LEVELS GAINED</small><b id="levelsGained">0</b><span id="levelText">—</span></div></div></div><div class="progress-box"><div><span id="progressFrom">LEVEL 0</span><b id="progressPct">0%</b><span id="progressTo">LEVEL 30</span></div><div class="progress"><i id="progressFill"></i></div></div><div class="break-head"><div><span class="label">PRECISION VIEW</span><h3>Level-by-level XP</h3></div><button id="toggleBreakdown" type="button">VIEW BREAKDOWN <b>+</b></button></div><div id="breakdown" hidden><div class="break-summary"><span>Training XP for selected route</span><b id="breakdownTotal">0 XP</b></div><div class="scroll"><table><thead><tr><th>LEVEL</th><th>XP TO LEVEL</th><th>TOTAL XP</th></tr></thead><tbody id="breakdownTable"></tbody></table></div></div></div><div class="utility-grid"><section class="utility"><div class="utility-top"><span class="utility-icon">↗</span><span class="label">REVERSE PLANNER</span></div><h2>How far can my XP take me?</h2><p>Enter an XP budget and find the highest Training Level you can reach.</p><div class="mini-grid"><label>Starting level<select id="reverseStart"></select></label><label>Available XP<input id="xpBudget" type="number" min="0" step="100" placeholder="10000"></label></div><div id="reverseOut" class="mini-result">Enter an XP budget to calculate a target</div></section><section class="utility"><div class="utility-top"><span class="utility-icon">↔</span><span class="label">TRANSFER CHECK</span></div><h2>Training Transfer</h2><p>Check the XP received when transferring stored training XP.</p><label class="full-label">Source level<select id="transferLevel"></select></label><div class="transfer"><div><small>STORED</small><b id="sourceXP">0</b></div><div><small>RECEIVED</small><b id="receivedXP">0</b></div><div><small>LOST</small><b id="lostXP">0</b></div></div></section></div></section>
  <section class="reference"><div class="wrap"><div class="section-title"><span class="label">REFERENCE DATA</span><h2>FC Mobile training XP table</h2><p>Every level and common fodder XP value in one clean reference.</p></div><div class="ref-grid"><div class="ref-card"><div class="ref-card-head"><div><h3>XP by level</h3><span>Level 0 through 30</span></div><b>30 LEVELS</b></div><div class="scroll"><table><thead><tr><th>LEVEL</th><th>TOTAL XP</th><th>TO NEXT</th></tr></thead><tbody id="fullTable"></tbody></table></div></div><div class="ref-card"><div class="ref-card-head"><div><h3>Fodder XP</h3><span>XP per training card</span></div><b>XP</b></div><div id="fodderList" class="fodder-list"></div></div></div></div></section>
  <section class="faq-section"><div class="wrap narrow"><span class="label">FAQ</span><h2>FC Mobile Training Calculator FAQ</h2><div class="faq-list"><details open><summary>How much XP do I need to train a player?</summary><p>The exact XP depends on your current and target Training Level. Use the planner above to calculate the difference instantly.</p></details><details><summary>What does XP mean in FC Mobile training?</summary><p>XP is the training experience used to increase a player's Training Level. This calculator uses XP terminology throughout.</p></details><details><summary>How are cards needed calculated?</summary><p>The required XP is divided by the XP value of the selected fodder range and rounded up because cards are whole items.</p></details><details><summary>Does training increase player OVR?</summary><p>Training improves player attributes. Rank Up is the separate system used for OVR increases.</p></details></div></div></section>
</main>
<style>
:root{--bg:#05080d;--panel:#0b121b;--panel2:#101a25;--line:#203040;--text:#f5fbff;--muted:#8093a3;--cyan:#36c9ff;--blue:#4b7dff;--red:#ff4d5e;--mono:'IBM Plex Mono',monospace;--sans:'Manrope',system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans)}a{text-decoration:none;color:inherit}.wrap{width:min(1180px,calc(100% - 44px));margin:auto}.narrow{max-width:880px}.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(circle at 20% 0,#36c9ff16,transparent 34%),radial-gradient(circle at 88% 40%,#4b7dff12,transparent 34%)}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;opacity:.025}.hero-inner{position:relative;padding:28px 0 58px}.hero nav{display:flex;gap:10px;color:#617687;font:700 9px var(--mono);margin-bottom:54px}.hero nav a{color:var(--cyan)}.hero-content{display:grid;grid-template-columns:1fr 390px;gap:70px;align-items:center}.eyebrow,.label{font:800 9px var(--mono);letter-spacing:.16em;color:var(--cyan)}.eyebrow i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px #ff4d5e15;animation:beep 1.5s infinite}.hero h1{font-size:clamp(54px,8vw,94px);line-height:.9;letter-spacing:-.075em;margin:14px 0 20px;font-weight:900}.hero h1 em{font-style:normal;background:linear-gradient(100deg,#fff,var(--cyan));background-clip:text;color:transparent}.hero p{max-width:670px;color:#8da1b0;font-size:15px;line-height:1.75}.hero-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}.hero-pills span{padding:8px 10px;border:1px solid var(--line);background:#09111a;border-radius:7px;color:#718596;font:700 8px var(--mono)}.hero-art{height:310px;position:relative;display:grid;place-items:center}.orbit{position:absolute;border:1px solid #36c9ff28;border-radius:50%;animation:spin 18s linear infinite}.orbit-a{width:270px;height:270px}.orbit-b{width:190px;height:190px;border-style:dashed;animation-direction:reverse;animation-duration:11s}.core{width:126px;height:126px;display:grid;place-items:center;align-content:center;border-radius:32px;transform:rotate(-7deg);background:linear-gradient(145deg,#122938,#071018);border:1px solid #36c9ff55;box-shadow:0 0 70px #36c9ff1c}.core b{font:900 46px var(--mono);letter-spacing:-.1em}.core small{font:800 7px var(--mono);letter-spacing:.2em;color:var(--cyan)}.art-chip{position:absolute;padding:10px 12px;border:1px solid var(--line);background:#0c151fd9;backdrop-filter:blur(12px);border-radius:10px;color:#718697;font:700 8px var(--mono)}.art-chip b{display:block;color:#f4fbff;font-size:14px;margin-top:2px}.chip-a{right:10px;top:45px;transform:rotate(7deg)}.chip-b{left:10px;bottom:45px;transform:rotate(-6deg)}.tool-wrap{padding:44px 0 70px}.tool-card{background:linear-gradient(145deg,#0c151f,#080e15);border:1px solid var(--line);border-radius:26px;box-shadow:0 30px 100px #00000055;overflow:hidden}.tool-head{display:flex;justify-content:space-between;padding:30px;border-bottom:1px solid var(--line)}.tool-head h2,.utility h2,.section-title h2,.faq-section h2{font-size:26px;letter-spacing:-.04em;margin:7px 0 6px}.tool-head p,.utility p,.section-title p{color:var(--muted);font-size:12px;margin:0}.max-badge{min-width:86px;text-align:center;border:1px solid #36c9ff32;background:#36c9ff08;border-radius:12px;padding:9px}.max-badge small,.max-badge span{display:block;font:700 7px var(--mono);color:#61798a}.max-badge b{display:block;font:900 26px var(--mono);color:var(--cyan)}.input-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:24px 30px}.input-grid label,.mini-grid label,.full-label{display:grid;gap:8px;font:800 9px var(--mono);color:#8094a4}.input-grid label>span{color:#eaf4f8;font-size:10px}.input-grid label b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#36c9ff12;color:var(--cyan);margin-right:7px}.input-grid small{font:600 8px var(--sans);color:#536979}select,input{width:100%;border:1px solid #293b4b;background:#070e15;color:#f0f7fa;border-radius:11px;padding:14px 12px;outline:none;font:700 11px var(--mono)}select:focus,input:focus{border-color:#36c9ff;box-shadow:0 0 0 3px #36c9ff13}.result{margin:0 30px;border:1px solid #36c9ff24;background:linear-gradient(135deg,#0e2532,#09141d);border-radius:18px;padding:22px;display:grid;grid-template-columns:1.05fr 1fr;gap:20px}.result-main>span,.result-stats small,.transfer small{font:800 8px var(--mono);letter-spacing:.12em;color:#6e9aab}.result-main strong{display:block;font:900 clamp(48px,7vw,76px) var(--mono);letter-spacing:-.08em;line-height:.95;color:#f4fcff;margin:8px 0}.result-main p{font:700 9px var(--mono);color:#8eaebb;margin:0}.result-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.result-stats>div,.transfer>div{border:1px solid #ffffff10;background:#ffffff06;border-radius:11px;padding:13px}.result-stats b,.transfer b{display:block;font:900 16px var(--mono);margin-top:7px}.result-stats span{font:600 8px var(--sans);color:#647b8a}.progress-box{padding:25px 30px}.progress-box>div:first-child{display:flex;justify-content:space-between;font:800 8px var(--mono);color:#6e8492}.progress-box b{color:var(--cyan)}.progress{height:7px;background:#14212c;border-radius:99px;margin-top:9px;overflow:hidden}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:99px;transition:width .35s ease}.break-head{display:flex;justify-content:space-between;align-items:end;padding:0 30px 18px}.break-head h3{margin:6px 0 0;font-size:18px}.break-head button{border:1px solid var(--line);background:#0c151e;color:#8ba0ae;border-radius:9px;padding:9px 11px;font:800 8px var(--mono)}.break-summary{display:flex;justify-content:space-between;padding:14px 30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font:700 9px var(--mono);color:#708695}.break-summary b{color:var(--cyan)}.scroll{overflow:auto}.tool-card table,.ref-card table{width:100%;border-collapse:collapse;font:700 9px var(--mono)}th,td{padding:11px 13px;border-bottom:1px solid var(--line);text-align:left}th{font-size:7px;color:#617888}.utility-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.utility{border:1px solid var(--line);background:#0a1119;border-radius:18px;padding:22px}.utility-top{display:flex;gap:10px;align-items:center}.utility-icon{width:31px;height:31px;display:grid;place-items:center;border:1px solid #36c9ff28;background:#36c9ff0a;color:var(--cyan);border-radius:8px}.utility h2{font-size:20px;margin-top:16px}.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.mini-result{margin-top:12px;padding:13px;border-radius:10px;background:#071018;border:1px solid var(--line);font:700 9px var(--mono);color:#91a6b4}.full-label{margin-top:18px}.transfer{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}.reference{border-top:1px solid var(--line);padding:75px 0;background:#070c12}.section-title{margin-bottom:26px}.ref-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.ref-card{border:1px solid var(--line);background:#0b121a;border-radius:18px;overflow:hidden}.ref-card-head{display:flex;justify-content:space-between;padding:20px;border-bottom:1px solid var(--line)}.ref-card-head h3{margin:0;font-size:16px}.ref-card-head span{display:block;color:#657a89;font-size:9px;margin-top:4px}.ref-card-head>b{height:max-content;padding:6px 8px;border:1px solid #36c9ff20;border-radius:6px;color:var(--cyan);font:800 7px var(--mono)}.fodder-list{padding:10px 20px}.fodder-row{display:grid;grid-template-columns:1fr auto;align-items:center;padding:13px 0;border-bottom:1px solid var(--line);font:800 9px var(--mono)}.fodder-row:last-child{border:0}.fodder-row span{color:#7f93a1}.fodder-row b{color:var(--cyan)}.faq-section{padding:80px 0}.faq-section h2{font-size:34px;margin-bottom:25px}.faq-list{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line);padding:19px 0}summary{cursor:pointer;list-style:none;font-weight:800;font-size:13px;display:flex;justify-content:space-between}summary::-webkit-details-marker{display:none}summary:after{content:'+';color:var(--cyan);font:700 18px var(--mono)}details[open] summary:after{content:'−'}details p{color:#7f93a1;font-size:11px;line-height:1.75;max-width:760px;margin:12px 0 0}@keyframes spin{to{transform:rotate(360deg)}}@keyframes beep{0%,70%,100%{opacity:1;box-shadow:0 0 0 5px #ff4d5e12}75%{opacity:.45;box-shadow:0 0 0 9px #ff4d5e00}}@media(max-width:850px){.hero-content{grid-template-columns:1fr}.hero-art{height:250px}.input-grid,.utility-grid,.ref-grid{grid-template-columns:1fr}.result{grid-template-columns:1fr}}@media(max-width:560px){.wrap{width:min(100% - 26px,1180px)}.hero-inner{padding-top:22px}.hero nav{margin-bottom:38px}.hero h1{font-size:52px}.tool-head,.input-grid,.progress-box,.break-head{padding-left:18px;padding-right:18px}.result{margin:0 18px;padding:17px}.result-stats{gap:6px}.utility{padding:18px}.mini-grid{grid-template-columns:1fr}.hero-art{height:220px}.orbit-a{width:200px;height:200px}.orbit-b{width:140px;height:140px}.core{width:100px;height:100px}.core b{font-size:36px}.chip-a{right:0}.chip-b{left:0}}
</style>
<script>
import { calculateTraining, calculateTransfer } from '../lib/fcMobileTraining.js';
const levels={current:document.querySelector('#currentLevel'),target:document.querySelector('#targetLevel'),fodder:document.querySelector('#fodderId'),reverse:document.querySelector('#reverseStart'),transfer:document.querySelector('#transferLevel')};
const $=id=>document.querySelector(id),fmt=n=>new Intl.NumberFormat('en-US').format(n); const labels=['Base','Level 1','Level 2','Level 3','Level 4','Level 5','Level 6','Level 7','Level 8','Level 9','Level 10','Level 11','Level 12','Level 13','Level 14','Level 15','Level 16','Level 17','Level 18','Level 19','Level 20','Level 21','Level 22','Level 23','Level 24','Level 25','Level 26','Level 27','Level 28','Level 29','Level 30'];
for(let i=0;i<=MAX_TRAINING_LEVEL;i++){levels.current.add(new Option(labels[i],i));levels.target.add(new Option(labels[i],i));levels.reverse.add(new Option(labels[i],i));levels.transfer.add(new Option(labels[i],i))} levels.target.value='30'; levels.fodder.innerHTML=FODDER.map(f=>`<option value="${f.id}">${f.label} — ${fmt(f.xp)} XP</option>`).join(''); levels.current.value='0'; levels.reverse.value='0'; levels.transfer.value='0'; levels.fodder.value='95+';
function render(){const d=calculateTraining({currentLevel:levels.current.value,targetLevel:levels.target.value,fodderId:levels.fodder.value}); if(!d.valid){$('#alert').hidden=false;$('#alert').textContent=d.error;return} $('#alert').hidden=true;$('#xpRequired').textContent=fmt(d.requiredXP);$('#cardsNeeded').textContent=fmt(d.cards);$('#xpPerCard').textContent=fmt(d.fodder.xp);$('#extraXP').textContent=fmt(d.extraXP);$('#levelsGained').textContent=String(d.targetLevel-d.currentLevel);$('#planText').textContent=`Level ${d.currentLevel} → Level ${d.targetLevel} · ${d.fodder.label} fodder` ;$('#cardText').textContent=`${d.fodder.label}`;$('#levelText').textContent=`${d.currentLevel} → ${d.targetLevel}`;$('#progressFrom').textContent=`LEVEL ${d.currentLevel}`;$('#progressTo').textContent=`LEVEL ${d.targetLevel}`;const pct=d.targetLevel?Math.round(d.currentLevel/d.targetLevel*100):100;$('#progressPct').textContent=`${pct}%`;$('#progressFill').style.width=`${pct}%`;$('#breakdownTotal').textContent=`${fmt(d.requiredXP)} XP`;$('#breakdownTable').innerHTML=TRAINING_LEVELS.slice(d.currentLevel+1,d.targetLevel+1).map((total,i)=>{const level=d.currentLevel+i+1;return `<tr><td>LEVEL ${level}</td><td>${fmt(total-TRAINING_LEVELS[level-1])} XP</td><td>${fmt(total)} XP</td></tr>`}).join('');}
function refs(){ $('#fullTable').innerHTML=TRAINING_LEVELS.map((v,i)=>`<tr><td>Level ${i}</td><td>${fmt(v)} XP</td><td>${i<30?fmt(TRAINING_LEVELS[i+1]-v)+' XP':'—'}</td></tr>`).join('');$('#fodderList').innerHTML=FODDER.map(f=>`<div class="fodder-row"><span>${f.label}</span><b>${fmt(f.xp)} XP</b></div>`).join('') }
function reverse(){const s=Number(levels.reverse.value),budget=Number($('#xpBudget').value||0),target=Math.max(s,Math.min(MAX_TRAINING_LEVEL,TRAINING_LEVELS.findIndex(v=>v>TRAINING_LEVELS[s]+budget)-1));$('#reverseOut').textContent=`Level ${s} → Level ${target} · ${fmt(Math.max(0,TRAINING_LEVELS[target]-TRAINING_LEVELS[s]))} XP used · ${fmt(Math.max(0,budget-(TRAINING_LEVELS[target]-TRAINING_LEVELS[s])))} XP left`}
function transfer(){const d=calculateTransfer(levels.transfer.value);if(!d.valid)return;$('#sourceXP').textContent=fmt(d.sourceXP);$('#receivedXP').textContent=fmt(d.receivedXP);$('#lostXP').textContent=fmt(d.lostXP)}
[...Object.values(levels),$('#xpBudget')].forEach(x=>x.addEventListener('input',()=>{render();reverse();transfer()}));$('#toggleBreakdown').onclick=()=>{const b=$('#breakdown');b.hidden=!b.hidden;$('#toggleBreakdown').innerHTML=b.hidden?'VIEW BREAKDOWN <b>+</b>':'HIDE BREAKDOWN <b>−</b>'};render();refs();reverse();transfer();
</script>
