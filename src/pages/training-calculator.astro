---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';
const fmt=(n)=>Number(n).toLocaleString();
---
<BaseLayout title="FC Mobile Training Calculator | XP Calculator | FCMOBILETOOLS" description="Calculate FC Mobile Training XP, cards required, excess XP and every Training Level from 0 to 30 with a complete reference table.">
<main class="training-page">
<header class="hero"><div class="wrap"><nav><a href="/">FCMOBILETOOLS</a><span>›</span><span>Training Calculator</span></nav><div class="hero-grid"><div><span class="eyebrow">FC MOBILE / TRAINING LAB</span><h1>Training <em>Calculator</em></h1><p>Calculate the exact XP needed to reach any Training Level, cards required and excess XP.</p><div class="pills"><span>LEVEL 0–30</span><span>XP PLANNER</span><span>FULL DATA</span></div></div><div class="hero-mark"><strong>XP</strong><small>TRAINING</small></div></div></div></header>
<section class="wrap section"><div class="card"><div class="head"><div><span class="label">XP PLANNER</span><h2>Build your training plan</h2><p>Dropdowns use the real training data source</p></div><b class="max">MAX R30</b></div><div class="fields"><label>Current Level<select id="currentLevel">{TRAINING_LEVELS.map((_,i)=><option value={i}>Level {i}</option>)}</select></label><label>Target Level<select id="targetLevel">{TRAINING_LEVELS.map((_,i)=><option value={i}>Level {i}</option>)}</select></label><label>Fodder OVR<select id="fodderId">{FODDER.map((f)=><option value={f.id}>{f.label} — {fmt(f.xp)} XP</option>)}</select></label></div><div id="error" class="error" hidden></div><div class="result"><div><small>XP REQUIRED</small><strong id="required">0</strong><p id="summary">Choose your levels</p></div><div class="stats"><div><small>CARDS NEEDED</small><b id="cards">0</b></div><div><small>XP PER CARD</small><b id="perCard">0</b></div><div><small>EXCESS XP</small><b id="extra">0</b></div><div><small>LEVELS GAINED</small><b id="gained">0</b></div></div></div><div class="progress"><div><span id="from">LEVEL 0</span><b id="pct">0%</b><span id="to">LEVEL 30</span></div><i id="fill"></i></div><div class="break"><div class="break-title"><span class="label">SELECTED ROUTE</span><h3>Level-by-level XP</h3></div><div class="scroll"><table><thead><tr><th>LEVEL</th><th>XP TO NEXT</th><th>TOTAL XP</th></tr></thead><tbody id="breakdown"></tbody></table></div></div></div></section>
<section class="reference"><div class="wrap"><div class="section-title"><span class="label">REFERENCE DATA</span><h2>FC Mobile Training XP table</h2><p>All 31 levels and all configured fodder values are rendered directly from the source data.</p></div><div class="reference-grid"><div class="ref-card"><h3>XP by Training Level</h3><div class="scroll"><table><thead><tr><th>LEVEL</th><th>TOTAL XP</th><th>XP TO NEXT</th></tr></thead><tbody>{TRAINING_LEVELS.map((xp,i)=><tr><td>Level {i}</td><td>{fmt(xp)} XP</td><td>{i<MAX_TRAINING_LEVEL ? `${fmt(TRAINING_LEVELS[i+1]-xp)} XP` : 'MAX'}</td></tr>)}</tbody></table></div></div><div class="ref-card"><h3>Fodder XP Values</h3><div class="fodder-grid">{FODDER.map((f)=><div><span>{f.label}</span><b>{fmt(f.xp)} XP</b></div>)}</div></div></div></div></section>
<section class="faq"><div class="wrap"><span class="label">FAQ</span><h2>FC Mobile Training Calculator FAQ</h2><details open><summary>How much XP do I need?</summary><p>The calculator subtracts the stored cumulative XP of the current level from the target level.</p></details><details><summary>How are cards calculated?</summary><p>Required XP is divided by the selected fodder XP and rounded up to a whole card.</p></details></div></section></main>
<script>
import { calculateTraining } from '../lib/fcMobileTraining.js';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../data/fcMobileTraining.js';
const $=(id)=>document.getElementById(id); const fmt=(n)=>Number(n).toLocaleString();
const current=$('currentLevel'),target=$('targetLevel'),fodder=$('fodderId'); current.value='0'; target.value=String(MAX_TRAINING_LEVEL); fodder.value=FODDER[FODDER.length-1].id;
function render(){const d=calculateTraining({currentLevel:current.value,targetLevel:target.value,fodderId:fodder.value});if(!d.valid){$('error').hidden=false;$('error').textContent=d.error;return;}$('error').hidden=true;$('required').textContent=fmt(d.requiredXP);$('cards').textContent=fmt(d.cards);$('perCard').textContent=fmt(d.fodder.xp);$('extra').textContent=fmt(d.extraXP);$('gained').textContent=d.targetLevel-d.currentLevel;$('summary').textContent=`Level ${d.currentLevel} → Level ${d.targetLevel} using ${d.fodder.label}`;$('from').textContent=`LEVEL ${d.currentLevel}`;$('to').textContent=`LEVEL ${d.targetLevel}`;const pct=Math.round(d.targetLevel/MAX_TRAINING_LEVEL*100);$('pct').textContent=`${pct}%`;$('fill').style.width=`${pct}%`;const rows=[];for(let i=d.currentLevel;i<d.targetLevel;i++)rows.push(`<tr><td>Level ${i} → ${i+1}</td><td>${fmt(TRAINING_LEVELS[i+1]-TRAINING_LEVELS[i])} XP</td><td>${fmt(TRAINING_LEVELS[i+1])} XP</td></tr>`);$('breakdown').innerHTML=rows.join('')||'<tr><td colspan="3">No XP required</td></tr>';}
[current,target,fodder].forEach((e)=>e.addEventListener('change',render));render();
</script>
<style>
:root{--bg:#05080d;--panel:#0b121b;--line:#213342;--text:#f5fbff;--muted:#8195a5;--cyan:#36c9ff;--blue:#4b7dff;--mono:'IBM Plex Mono',monospace;--sans:'Manrope',system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans)}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}.hero{border-bottom:1px solid var(--line);background:radial-gradient(circle at 10% 0,#36c9ff15,transparent 35%),radial-gradient(circle at 90% 50%,#4b7dff12,transparent 35%)}.hero>.wrap{padding:28px 0 60px}.hero nav{display:flex;gap:10px;color:#607484;font:700 9px var(--mono);margin-bottom:58px}.hero nav a{color:var(--cyan)}.hero-grid{display:grid;grid-template-columns:1fr 260px;gap:50px;align-items:center}.eyebrow,.label{font:800 9px var(--mono);letter-spacing:.16em;color:var(--cyan)}h1{font-size:clamp(54px,8vw,96px);line-height:.88;letter-spacing:-.08em;margin:15px 0 22px}h1 em{font-style:normal;background:linear-gradient(100deg,#fff,var(--cyan));background-clip:text;color:transparent}.hero p{max-width:680px;color:#8ea1b0;font-size:15px;line-height:1.75}.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:25px}.pills span{padding:8px 10px;border:1px solid var(--line);border-radius:7px;color:#718696;font:700 8px var(--mono)}.hero-mark{height:220px;display:grid;place-items:center;align-content:center;border:1px solid #36c9ff28;border-radius:38px;background:linear-gradient(145deg,#102331,#071018);box-shadow:0 0 90px #36c9ff12}.hero-mark strong{font:900 82px var(--mono);letter-spacing:-.1em}.hero-mark small{color:var(--cyan);font:800 8px var(--mono);letter-spacing:.2em}.section{padding:45px 0 70px}.card,.ref-card{border:1px solid var(--line);background:linear-gradient(145deg,#0c151f,#080e15);border-radius:24px;overflow:hidden}.head{display:flex;justify-content:space-between;padding:28px;border-bottom:1px solid var(--line)}h2{font-size:27px;letter-spacing:-.05em;margin:7px 0}.head p,.section-title p{margin:0;color:var(--muted);font-size:11px}.max{color:var(--cyan);border:1px solid #36c9ff30;background:#36c9ff08;padding:10px 12px;border-radius:9px;font:900 9px var(--mono);height:max-content}.fields{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:24px 28px}.fields label{display:grid;gap:8px;color:#90a3b1;font:800 9px var(--mono)}select{width:100%;padding:14px;border-radius:11px;border:1px solid #293b4b;background:#070e15;color:#f5fbff;font:700 11px var(--mono)}.result{margin:0 28px;border:1px solid #36c9ff25;border-radius:17px;background:linear-gradient(135deg,#0e2532,#09141d);padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.result small,.stats small{font:800 8px var(--mono);color:#6e9aab;letter-spacing:.12em}.result strong{display:block;font:900 clamp(46px,7vw,76px) var(--mono);letter-spacing:-.08em;margin:8px 0}.result p{font:700 9px var(--mono);color:#8ca8b5}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stats div{padding:14px;border:1px solid #ffffff10;background:#ffffff06;border-radius:10px}.stats b{display:block;margin-top:7px;font:900 17px var(--mono)}.progress{padding:25px 28px}.progress>div{display:flex;justify-content:space-between;color:#708491;font:800 8px var(--mono)}.progress b{color:var(--cyan)}.progress>i{display:block;height:7px;width:0;margin-top:9px;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan))}.break{border-top:1px solid var(--line)}.break-title{padding:24px 28px 15px}.break-title h3{margin:7px 0 0}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:13px 16px;border-top:1px solid #1b2a35;font-size:10px}th{color:#68808e;font:800 8px var(--mono)}td{color:#d7e5eb}.reference{padding:70px 0;background:#070c12;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.section-title{margin-bottom:22px}.reference-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:14px}.ref-card{padding:22px}.ref-card h3{margin:0 0 17px;font-size:17px}.fodder-grid{display:grid;gap:8px}.fodder-grid div{display:flex;justify-content:space-between;padding:13px;border:1px solid #ffffff0d;border-radius:10px}.fodder-grid span{font-size:10px;color:#8397a5}.fodder-grid b{font:800 11px var(--mono);color:var(--cyan)}.faq{padding:70px 0}.faq h2{margin-bottom:22px}.faq details{border-top:1px solid var(--line);padding:17px 0}.faq summary{cursor:pointer;font-weight:800;font-size:12px}.faq p{color:var(--muted);font-size:11px;line-height:1.7}.error{margin:0 28px 15px;padding:11px;border:1px solid #ff4d5e35;background:#ff4d5e0d;color:#ff9ca5;border-radius:9px;font:700 9px var(--mono)}@media(max-width:800px){.hero-grid,.reference-grid,.result{grid-template-columns:1fr}.hero-mark{display:none}.fields{grid-template-columns:1fr}.wrap{width:calc(100% - 28px)}}
</style>