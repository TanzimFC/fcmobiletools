---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FODDER_XP, TRAINING_LEVEL_XP, RANK_TRAINING_LIMITS } from '../data/trainingCalculator.js';
---

<BaseLayout title="FC Mobile Training Calculator" description="Calculate FC Mobile training XP, fodder cards, excess XP and estimated coin cost.">
  <div class="training-page">
    <section class="training-hero">
      <div>
        <span class="eyebrow">FC MOBILE TOOLS</span>
        <h1>Training Calculator</h1>
        <p>Calculate exactly how much training XP and fodder you need to reach your target level.</p>
      </div>
      <div class="verified-badge"><span></span> Working data set</div>
    </section>

    <main class="training-shell">
      <section class="calculator-card">
        <div class="section-heading">
          <div><span class="step">01</span><h2>Training setup</h2></div>
          <p>Choose your current level, target and fodder.</p>
        </div>

        <div class="fields">
          <label>Current Training Level<select id="currentLevel">{TRAINING_LEVEL_XP.map((item) => <option value={item.level}>{item.level}</option>)}</select></label>
          <label>Target Training Level<select id="targetLevel">{TRAINING_LEVEL_XP.map((item) => <option value={item.level} selected={item.level === 30}>{item.level}</option>)}</select></label>
          <label>Training Fodder<select id="fodder">{FODDER_XP.map((item) => <option value={item.id} selected={item.id === '60-69'}>{item.label} · {item.xp} XP</option>)}</select></label>
          <label>Price per Player <span class="optional">optional</span><input id="price" type="number" min="0" step="1" inputmode="numeric" placeholder="e.g. 1000" /></label>
        </div>

        <div class="shortcuts"><span>Quick target</span><button data-add="1">+1</button><button data-add="5">+5</button><button data-add="10">+10</button><button id="max">MAX</button></div>
      </section>

      <section id="result" class="result-card" aria-live="polite"></section>

      <section class="calculator-card comparison-card">
        <div class="section-heading"><div><span class="step">02</span><h2>Fodder comparison</h2></div><p>Compare the XP and economics of every configured fodder bracket.</p></div>
        <div id="comparison"></div>
      </section>

      <section class="calculator-card info-card">
        <details>
          <summary>How the calculator works</summary>
          <p>Required XP is cumulative XP at the target level minus cumulative XP at the current level. Cards required are rounded up so the supplied XP always reaches the target.</p>
          <p>Estimated cost is only calculated when you enter a price per card. Cost per XP compares the price of a fodder card with the XP it provides.</p>
          <p class="notice">Rank training limits are not enforced yet because the current verified Rank → maximum Training Level values are not configured.</p>
        </details>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
.training-page{min-height:100vh;background:radial-gradient(circle at 85% 0%,rgba(75,190,255,.16),transparent 35%),#07111a;color:#eaf7ff;padding:48px 20px 80px}.training-hero,.training-shell{max-width:1080px;margin:auto}.training-hero{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:30px 0 38px}.eyebrow,.step{font-size:11px;letter-spacing:.16em;font-weight:800;color:#6ed8ff}.training-hero h1{font-size:clamp(38px,6vw,64px);line-height:1;margin:10px 0 12px}.training-hero p{margin:0;color:#91a9b8;font-size:16px}.verified-badge{border:1px solid #214052;background:#0c1c27;padding:10px 14px;border-radius:999px;color:#9eb6c4;font-size:12px;white-space:nowrap}.verified-badge span{display:inline-block;width:7px;height:7px;border-radius:50%;background:#62d5ff;margin-right:8px}.training-shell{display:grid;gap:18px}.calculator-card,.result-card{background:rgba(10,25,35,.9);border:1px solid #193746;border-radius:22px;box-shadow:0 18px 50px rgba(0,0,0,.22)}.calculator-card{padding:26px}.section-heading{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.section-heading>div{display:flex;align-items:center;gap:12px}.section-heading h2{font-size:20px;margin:0}.section-heading p{margin:0;color:#75909e;font-size:13px}.step{letter-spacing:.08em}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}label{display:grid;gap:8px;font-size:12px;color:#a9c0cc;font-weight:700}select,input{width:100%;box-sizing:border-box;background:#081722;border:1px solid #244452;color:#effaff;border-radius:12px;padding:13px 12px;font:inherit;outline:none}select:focus,input:focus{border-color:#58cfff;box-shadow:0 0 0 3px rgba(88,207,255,.1)}.optional{font-weight:500;color:#59717e;margin-left:4px}.shortcuts{display:flex;align-items:center;gap:8px;margin-top:18px;color:#6f8b99;font-size:12px}.shortcuts button{border:1px solid #244452;background:#0b202d;color:#bceaff;border-radius:9px;padding:8px 12px;cursor:pointer}.shortcuts button:hover{border-color:#58cfff;color:#fff}.result-card{padding:28px;background:linear-gradient(135deg,#0b2330,#08151e)}.result-top{display:flex;justify-content:space-between;gap:25px;align-items:center}.result-label{font-size:12px;color:#7595a4;text-transform:uppercase;letter-spacing:.13em;font-weight:800}.result-big{font-size:clamp(40px,6vw,62px);font-weight:900;margin:4px 0}.result-big small{font-size:16px;color:#78929f;font-weight:700}.result-path{color:#84a0ae}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:25px}.metric{background:#081923;border:1px solid #193744;border-radius:14px;padding:15px}.metric span{display:block;color:#66818e;font-size:11px;margin-bottom:7px}.metric strong{font-size:18px}.progress{height:8px;background:#102733;border-radius:99px;overflow:hidden;margin-top:22px}.progress i{display:block;height:100%;background:#59cdf9;border-radius:inherit;transition:width .2s}.comparison-card{overflow:hidden}.compare-table{width:100%;border-collapse:collapse;font-size:13px}.compare-table th{text-align:left;color:#66818e;font-size:10px;text-transform:uppercase;letter-spacing:.08em}.compare-table td,.compare-table th{padding:13px 8px;border-bottom:1px solid #173440}.compare-table tr:last-child td{border-bottom:0}.compare-table .selected{color:#6ed8ff;font-weight:800}.muted{color:#5f7885}.info-card summary{cursor:pointer;font-weight:800}.info-card p{color:#86a0ad;line-height:1.65}.notice{padding:12px 14px;background:#0c202b;border:1px solid #204250;border-radius:12px;color:#8fc9df!important}@media(max-width:760px){.training-page{padding:25px 14px 60px}.training-hero{display:block;padding:20px 0 25px}.verified-badge{display:inline-block;margin-top:18px}.calculator-card,.result-card{padding:19px;border-radius:17px}.section-heading{display:block}.section-heading p{margin-top:8px}.fields{grid-template-columns:1fr 1fr}.metrics{grid-template-columns:1fr 1fr}.metric:last-child{grid-column:1/-1}.result-top{display:block}.compare-table{font-size:12px}.compare-table th:nth-child(4),.compare-table td:nth-child(4){display:none}}@media(max-width:460px){.fields{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.shortcuts{flex-wrap:wrap}}
</style>

<script>
  import { calculateTraining, compareFodder } from '../lib/trainingCalculator.js';

  const current = document.querySelector('#currentLevel');
  const target = document.querySelector('#targetLevel');
  const fodder = document.querySelector('#fodder');
  const price = document.querySelector('#price');
  const result = document.querySelector('#result');
  const comparison = document.querySelector('#comparison');
  const format = (n) => new Intl.NumberFormat('en-US').format(n);
  const money = (n) => `${format(n)} coins`;

  function render() {
    const data = calculateTraining({ currentLevel: current.value, targetLevel: target.value, fodderId: fodder.value, pricePerCard: price.value });
    if (!data.valid) { result.innerHTML = `<div class="result-label">Check your setup</div><div class="result-big">${data.error}</div>`; comparison.innerHTML=''; return; }
    result.innerHTML = `<div class="result-top"><div><div class="result-label">Training requirement</div><div class="result-big">${format(data.requiredXP)} <small>XP</small></div><div class="result-path">Level ${data.currentLevel} → Level ${data.targetLevel}</div></div><div class="result-label">${data.fodder.label}<br>${format(data.fodder.xp)} XP / player</div></div><div class="progress"><i style="width:${Math.min(100,data.progress)}%"></i></div><div class="metrics"><div class="metric"><span>Players required</span><strong>${format(data.playersRequired)}</strong></div><div class="metric"><span>XP provided</span><strong>${format(data.xpProvided)}</strong></div><div class="metric"><span>Excess XP</span><strong>${format(data.excessXP)}</strong></div><div class="metric"><span>Price / player</span><strong>${data.estimatedCost == null ? 'Not set' : money(Number(price.value))}</strong></div><div class="metric"><span>Estimated cost</span><strong>${data.estimatedCost == null ? 'Not set' : money(data.estimatedCost)}</strong></div></div>`;
    const rows = compareFodder({ currentLevel: current.value, targetLevel: target.value, prices: {} });
    comparison.innerHTML = `<table class="compare-table"><thead><tr><th>Fodder</th><th>XP/card</th><th>Cards needed</th><th>Cost / XP</th></tr></thead><tbody>${rows.map((row) => `<tr class="${row.id===fodder.value?'selected':''}"><td>${row.label}${row.id===fodder.value?' · Selected':''}</td><td>${format(row.xp)}</td><td>${format(row.playersRequired)}</td><td class="muted">Enter prices above</td></tr>`).join('')}</tbody></table>`;
  }

  [current,target,fodder,price].forEach((el) => el.addEventListener('input', render));
  document.querySelectorAll('[data-add]').forEach((button) => button.addEventListener('click', () => { target.value = String(Math.min(30, Number(current.value) + Number(button.dataset.add))); render(); }));
  document.querySelector('#max').addEventListener('click', () => { target.value = '30'; render(); });
  render();
</script>
