.training-page .error{margin:0 30px 12px;padding:12px 14px;border:1px solid rgba(255,140,120,.3);border-radius:12px;background:rgba(255,120,100,.07);color:#ffb4a6;font:500 13px/1.5 var(--sans)}

/* Results */
.training-page .summary-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.4fr);gap:12px;padding:6px 30px 2px}
