---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PLAYSTYLE_POSITIONS } from '../../data/playstyleFinder.js';
---

<BaseLayout
  title="FC Mobile PlayStyle Finder | FCMOBILETOOLS"
  description="Answer a short position-aware survey to find the best FC Mobile PlayStyle match for your player's role."
  canonical="/player/playstyle-finder/"
>
  <main class="psf-page">
    <section class="psf-hero">
      <div class="psf-shell">
        <nav class="psf-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/player/playstyle/">PlayStyle Guide</a><span aria-hidden="true">/</span><strong>Finder</strong>
        </nav>
        <p class="psf-kicker"><span></span> FC MOBILE / PLAYSTYLE BUILDER</p>
        <h1>Find your fit.<br /><em>Build for the role.</em></h1>
        <p class="psf-lede">Tell us where the player plays, how you use them, and what they need to do better. Get role-aware recommendations built from the actual PlayStyle guide.</p>
        <div class="psf-hero-links">
          <a href="/player/playstyle/">Browse every PlayStyle <span aria-hidden="true">↗</span></a>
          <span>3 questions <i></i> UP TO 2 MATCHES</span>
        </div>
      </div>
    </section>

    <section class="psf-shell psf-builder" aria-label="PlayStyle survey">
      <div class="psf-builder-main">
        <div class="psf-progress-card">
          <div class="psf-progress-meta"><span id="psfStepMeta">STEP 01 OF 03</span><span>POSITION / JOB / PLAYER TYPE</span></div>
          <div class="psf-progress-track" aria-hidden="true"><span id="psfProgressFill"></span></div>
          <div class="psf-stepper" aria-label="Survey progress">
            <span class="psf-step-chip is-active" data-step-chip="1"><b>01</b> Position</span>
            <span class="psf-step-chip" data-step-chip="2"><b>02</b> Main job</span>
            <span class="psf-step-chip" data-step-chip="3"><b>03</b> Player type</span>
          </div>
        </div>

        <section class="psf-survey-card">
          <div class="psf-question" data-step-panel="1">
            <div class="psf-question-head">
              <span class="psf-question-number">QUESTION 01</span>
              <h2>Where does this player play?</h2>
              <p>Choose the position you are building for. We’ll use it to weigh the recommendations.</p>
            </div>
            <div class="psf-position-grid" id="psfPositionGrid">
              {PLAYSTYLE_POSITIONS.map((position) => (
                <button type="button" class="psf-position-card" data-position={position.code} aria-pressed="false">
                  <span class="psf-position-code">{position.code}</span>
                  <span class="psf-position-name">{position.label}</span>
                  <span class="psf-position-mark" aria-hidden="true">↗</span>
                </button>
              ))}
            </div>
          </div>

          <div class="psf-question" data-step-panel="2" hidden>
            <div class="psf-question-head">
              <span class="psf-question-number">QUESTION 02</span>
              <h2 id="psfGoalTitle">What job should this player do better?</h2>
              <p>Pick the action that would make the biggest difference in your matches.</p>
            </div>
            <div class="psf-choice-grid" id="psfGoalOptions" aria-label="Main job choices"></div>
            <p class="psf-question-foot">Choose one main job. The second recommendation can complement it.</p>
          </div>

          <div class="psf-question" data-step-panel="3" hidden>
            <div class="psf-question-head">
              <span class="psf-question-number">QUESTION 03</span>
              <h2>What kind of player do you want?</h2>
              <p>Choose the approach that best describes how you use this position.</p>
            </div>
            <div class="psf-choice-grid" id="psfProfileOptions" aria-label="Player type choices"></div>
            <p class="psf-question-foot">This preference helps separate a direct match from a useful alternative.</p>
          </div>

          <div class="psf-survey-footer">
            <button class="psf-back-button" id="psfBack" type="button" hidden><span aria-hidden="true">←</span> Back</button>
            <p class="psf-survey-status" id="psfSurveyStatus" role="status" aria-live="polite">Choose a position to start.</p>
            <button class="psf-next-button" id="psfNext" type="button" disabled>Continue <span aria-hidden="true">→</span></button>
          </div>
        </section>
      </div>

      <aside class="psf-summary-card" aria-label="Your survey answers">
        <div class="psf-summary-heading">
          <span class="psf-summary-mark" aria-hidden="true">FC</span>
          <div><span class="psf-overline">YOUR BUILD</span><h2>Match profile</h2></div>
        </div>
        <div class="psf-summary-line"><span>Position</span><strong id="psfSummaryPosition">Not selected</strong></div>
        <div class="psf-summary-line"><span>Main job</span><strong id="psfSummaryGoal">Not selected</strong></div>
        <div class="psf-summary-line"><span>Player type</span><strong id="psfSummaryProfile">Not selected</strong></div>
        <div class="psf-summary-rule"></div>
        <p class="psf-summary-copy" id="psfSummaryCopy">Your answers will shape the two results. A defensive role can favour tackling styles; a forward role can favour movement and finishing.</p>
        <a class="psf-guide-link" href="/player/playstyle/">Read the PlayStyle guide <span aria-hidden="true">↗</span></a>
        <button class="psf-clear-button" id="psfReset" type="button">Start over</button>
      </aside>
    </section>

    <section class="psf-shell psf-results" id="psfResults" aria-labelledby="psfResultsTitle" hidden>
      <div class="psf-results-heading">
        <div>
          <span class="psf-question-number" id="psfResultsKicker">YOUR MATCHES</span>
          <h2 id="psfResultsTitle">Two PlayStyles for your build.</h2>
          <p id="psfResultsIntroText">Ranked from your position, main job and player type. Compare each level before you decide.</p>
        </div>
        <button class="psf-edit-button" id="psfEditAnswers" type="button">Edit answers <span aria-hidden="true">↗</span></button>
      </div>
      <div class="psf-result-grid" id="psfResultGrid"></div>
      <p class="psf-results-note">The order reflects your answers and the PlayStyle descriptions in the guide. It is a role-based recommendation, not a promise of match results.</p>
    </section>
  </main>

  <script>
    import { PLAYSTYLES } from '../../data/playstyles.js';
    import {
      PLAYSTYLE_GOALS,
      PLAYSTYLE_POSITIONS,
      getPlaystyleGoalsForPosition,
      getPlaystyleProfileChoices,
      getPlaystyleRecommendations
    } from '../../data/playstyleFinder.js';

    (() => {
      const root = document.querySelector('.psf-page');
      if (!root) return;

      const state = { step: 1, position: '', goalId: '', profileId: '' };
      const panels = Array.from(root.querySelectorAll('[data-step-panel]'));
      const nextButton = root.querySelector('#psfNext');
      const backButton = root.querySelector('#psfBack');
      const status = root.querySelector('#psfSurveyStatus');
      const progressFill = root.querySelector('#psfProgressFill');
      const stepMeta = root.querySelector('#psfStepMeta');
      const results = root.querySelector('#psfResults');
      const resultGrid = root.querySelector('#psfResultGrid');

      const positionInfo = () => PLAYSTYLE_POSITIONS.find((item) => item.code === state.position);
      const goalInfo = () => PLAYSTYLE_GOALS.find((item) => item.id === state.goalId);
      const profileInfo = () => getPlaystyleProfileChoices(state.position).find((item) => item.id === state.profileId);

      function makeElement(tag, className, text) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      }

      function renderChoices(container, choices, type, selectedId) {
        container.replaceChildren();
        choices.forEach((choice, index) => {
          const button = makeElement('button', 'psf-choice' + (choice.id === selectedId ? ' is-active' : ''));
          button.type = 'button';
          button.dataset.choiceType = type;
          button.dataset.choiceValue = choice.id;
          button.setAttribute('aria-pressed', String(choice.id === selectedId));

          const number = makeElement('span', 'psf-choice-index', String(index + 1).padStart(2, '0'));
          const copy = makeElement('span', 'psf-choice-copy');
          copy.append(makeElement('strong', '', choice.label));
          copy.append(makeElement('small', '', choice.hint));
          const mark = makeElement('span', 'psf-choice-mark', '↗');
          mark.setAttribute('aria-hidden', 'true');
          button.append(number, copy, mark);
          container.append(button);
        });
      }

      function renderOptions() {
        if (!state.position) return;
        const goalTitle = root.querySelector('#psfGoalTitle');
        const selectedPosition = positionInfo();
        goalTitle.textContent = 'What should your ' + selectedPosition.label.toLowerCase() + ' do better?';
        renderChoices(
          root.querySelector('#psfGoalOptions'),
          getPlaystyleGoalsForPosition(state.position),
          'goal',
          state.goalId
        );
        renderChoices(
          root.querySelector('#psfProfileOptions'),
          getPlaystyleProfileChoices(state.position),
          'profile',
          state.profileId
        );
      }

      function renderSummary() {
        const position = positionInfo();
        const goal = goalInfo();
        const profile = profileInfo();
        root.querySelector('#psfSummaryPosition').textContent = position ? position.label + ' (' + position.code + ')' : 'Not selected';
        root.querySelector('#psfSummaryGoal').textContent = goal ? goal.label : 'Not selected';
        root.querySelector('#psfSummaryProfile').textContent = profile ? profile.label : 'Not selected';

        let summary = 'Your answers will shape the two results. A defensive role can favour tackling styles; a forward role can favour movement and finishing.';
        if (position && !goal) summary = position.label + ' selected. Next, choose the job you need from this player.';
        if (position && goal && !profile) summary = 'Main job saved. Pick the player type that fits the way you use this position.';
        if (position && goal && profile) summary = 'Profile ready. The results will balance your chosen job, preferred player type and position fit.';
        root.querySelector('#psfSummaryCopy').textContent = summary;

        if (state.step === 1) {
          status.textContent = position ? 'Position selected. Continue to choose the main job.' : 'Choose a position to start.';
        } else if (state.step === 2) {
          status.textContent = goal ? 'Main job selected. Continue to choose a player type.' : 'Choose the main job for this position.';
        } else {
          status.textContent = profile ? 'Ready. Find your two PlayStyles.' : 'Choose the player type that fits your game.';
        }
      }

      function renderStep() {
        panels.forEach((panel) => { panel.hidden = Number(panel.dataset.stepPanel) !== state.step; });
        root.querySelectorAll('[data-step-chip]').forEach((chip) => {
          const number = Number(chip.dataset.stepChip);
          chip.classList.toggle('is-active', number === state.step);
          chip.classList.toggle('is-complete', number < state.step);
          if (number === state.step) chip.setAttribute('aria-current', 'step');
          else chip.removeAttribute('aria-current');
        });
        stepMeta.textContent = 'STEP ' + String(state.step).padStart(2, '0') + ' OF 03';
        progressFill.style.width = (state.step / 3 * 100) + '%';
        backButton.hidden = state.step === 1;
        nextButton.replaceChildren(
          makeElement('span', '', state.step === 3 ? 'Find my two matches' : 'Continue'),
          makeElement('span', '', state.step === 3 ? '↗' : '→')
        );
        nextButton.disabled = state.step === 1 ? !state.position : state.step === 2 ? !state.goalId : !state.profileId;
        if (state.position) renderOptions();
        renderSummary();
      }

      function iconForLevel(style, level) {
        const tier = style.noBaseIcon ? (level === 3 ? 2 : 1) : level - 1;
        return '/assets/images/playstyle/playstyle_64_PLAYSTYLE_' + style.icon + '_' + tier + '.png';
      }

      function buildRecommendationCard(style, index) {
        const card = makeElement('article', 'psf-result-card');
        card.dataset.styleName = style.name;

        const top = makeElement('div', 'psf-result-top');
        top.append(makeElement('span', 'psf-result-index', 'MATCH 0' + (index + 1)));
        top.append(makeElement('span', 'psf-result-rank', index === 0 ? 'BEST FIT' : 'ALTERNATIVE'));
        card.append(top);

        const head = makeElement('div', 'psf-result-head');
        const icon = makeElement('img', 'psf-result-icon');
        icon.src = iconForLevel(style, 1);
        icon.width = 64;
        icon.height = 64;
        icon.alt = style.name + ' PlayStyle icon';
        icon.loading = 'lazy';
        icon.decoding = 'async';
        const title = makeElement('div', 'psf-result-title');
        title.append(makeElement('span', 'psf-result-category', style.category));
        title.append(makeElement('h3', '', style.name));
        head.append(icon, title);
        card.append(head);

        card.append(makeElement('p', 'psf-result-summary', style.summary));

        const why = makeElement('div', 'psf-result-why');
        why.append(makeElement('span', 'psf-overline', 'WHY IT FITS'));
        why.append(makeElement('p', '', style.reason));
        card.append(why);

        const tags = makeElement('div', 'psf-result-tags');
        style.matchTags.forEach((tagText) => tags.append(makeElement('span', 'psf-result-tag', tagText)));
        card.append(tags);

        const levelHeader = makeElement('div', 'psf-level-header');
        levelHeader.append(makeElement('span', '', 'PLAYSTYLE LEVEL'));
        const activeLevelLabel = makeElement('strong', '', 'Level 1');
        levelHeader.append(activeLevelLabel);
        card.append(levelHeader);

        const levelTabs = makeElement('div', 'psf-level-tabs');
        levelTabs.setAttribute('role', 'group');
        levelTabs.setAttribute('aria-label', 'Choose ' + style.name + ' level');
        [1, 2, 3].forEach((level) => {
          const button = makeElement('button', 'psf-level-button' + (level === 1 ? ' is-active' : ''), level === 3 ? '★ Level 3' : 'Level ' + level);
          button.type = 'button';
          button.dataset.level = String(level);
          button.setAttribute('aria-pressed', String(level === 1));
          levelTabs.append(button);
        });
        card.append(levelTabs);

        const levelCopy = makeElement('p', 'psf-level-copy', style.levels[0]);
        card.append(levelCopy);
        card._playstyleData = style;
        card._activeLevelLabel = activeLevelLabel;
        card._levelCopy = levelCopy;
        return card;
      }

      function renderResults() {
        const recommendations = getPlaystyleRecommendations({
          position: state.position,
          goalId: state.goalId,
          profileId: state.profileId
        });
        resultGrid.replaceChildren();
        recommendations.forEach((style, index) => resultGrid.append(buildRecommendationCard(style, index)));
        const expectedCount = state.position === 'GK' ? 1 : 2;
        resultGrid.classList.toggle('is-single', recommendations.length === 1);
        results.hidden = recommendations.length !== expectedCount;
        root.querySelector('#psfResultsKicker').textContent = state.position === 'GK' ? 'YOUR GOALKEEPER MATCH' : 'YOUR TWO MATCHES';
        root.querySelector('#psfResultsTitle').textContent = state.position === 'GK' ? 'One PlayStyle for your goalkeeper.' : 'Two PlayStyles for your build.';
        root.querySelector('#psfResultsIntroText').textContent = state.position === 'GK'
          ? 'Goalkeepers have one PlayStyle slot in this finder. Here is the best fit for how you use your keeper.'
          : 'Ranked from your position, main job and player type. Compare each level before you decide.';
        if (recommendations.length !== expectedCount) {
          status.textContent = 'We could not build a complete match. Go back and choose another answer.';
          return;
        }
        window.dispatchEvent(new CustomEvent('fcmobiletools:tool-activity', {
          detail: { entityId: 'playstyle-finder', durationMs: 3000 }
        }));
        results.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start'
        });
      }

      root.addEventListener('click', (event) => {
        const positionButton = event.target.closest('[data-position]');
        if (positionButton) {
          const nextPosition = positionButton.dataset.position;
          if (nextPosition !== state.position) {
            state.position = nextPosition;
            state.goalId = '';
            state.profileId = '';
            results.hidden = true;
          }
          root.querySelectorAll('[data-position]').forEach((button) => {
            const active = button.dataset.position === state.position;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          renderStep();
          return;
        }

        const choiceButton = event.target.closest('[data-choice-type]');
        if (choiceButton) {
          if (choiceButton.dataset.choiceType === 'goal') {
            state.goalId = choiceButton.dataset.choiceValue;
            state.profileId = '';
            results.hidden = true;
          } else {
            state.profileId = choiceButton.dataset.choiceValue;
            results.hidden = true;
          }
          renderOptions();
          renderSummary();
          renderStep();
          return;
        }

        const levelButton = event.target.closest('.psf-level-button');
        if (levelButton) {
          const card = levelButton.closest('.psf-result-card');
          const style = card && card._playstyleData;
          if (!style) return;
          const level = Number(levelButton.dataset.level);
          card.querySelectorAll('.psf-level-button').forEach((button) => {
            const active = button === levelButton;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          card.querySelector('.psf-result-icon').src = iconForLevel(style, level);
          card._activeLevelLabel.textContent = level === 3 ? '★ Level 3' : 'Level ' + level;
          card._levelCopy.textContent = style.levels[level - 1];
          return;
        }

        if (event.target.closest('#psfNext')) {
          if (state.step === 1 && state.position) {
            state.step = 2;
            renderStep();
          } else if (state.step === 2 && state.goalId) {
            state.step = 3;
            renderStep();
          } else if (state.step === 3 && state.profileId) {
            renderResults();
          }
          return;
        }

        if (event.target.closest('#psfBack')) {
          state.step = Math.max(1, state.step - 1);
          renderStep();
          return;
        }

        if (event.target.closest('#psfReset')) {
          state.step = 1;
          state.position = '';
          state.goalId = '';
          state.profileId = '';
          results.hidden = true;
          root.querySelectorAll('[data-position]').forEach((button) => {
            button.classList.remove('is-active');
            button.setAttribute('aria-pressed', 'false');
          });
          renderStep();
          return;
        }

        if (event.target.closest('#psfEditAnswers')) {
          results.hidden = true;
          state.step = 1;
          renderStep();
        }
      });

      renderStep();
    })();
  </script>

  <style is:global>
    .psf-page {
      --psf-bg: #071018;
      --psf-panel: #0f1a26;
      --psf-raised: #142536;
      --psf-line: rgba(255,255,255,.09);
      --psf-text: #f5f8fb;
      --psf-muted: #a7b4c3;
      --psf-blue: #4cc9ff;
      --psf-green: #47d16c;
      color: var(--psf-text);
      background: var(--psf-bg);
      min-height: 70vh;
      overflow: clip;
    }
    .psf-shell { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
    .psf-hero {
      padding: 24px 0 34px;
      border-bottom: 1px solid var(--psf-line);
      background: radial-gradient(ellipse at 74% 0%, rgba(76,201,255,.13), transparent 43%), linear-gradient(180deg,#0b1723,#071018);
    }
    .psf-crumbs { display:flex; flex-wrap:wrap; align-items:center; gap:9px; color:#718697; font:600 11px/1.5 var(--font-body,Inter,sans-serif); }
    .psf-crumbs a { color:#a7b8c6; text-decoration:none; }
    .psf-crumbs a:hover { color:var(--psf-blue); }
    .psf-crumbs strong { color:#eef7fb; font-weight:600; }
    .psf-kicker,.psf-question-number,.psf-overline { display:flex; align-items:center; gap:8px; color:var(--psf-blue); font:800 10px/1.4 var(--font-body,Inter,sans-serif); letter-spacing:.13em; text-transform:uppercase; }
    .psf-kicker { margin:30px 0 11px; }
    .psf-kicker span { width:6px; height:6px; border-radius:50%; background:var(--psf-blue); box-shadow:0 0 11px rgba(76,201,255,.5); }
    .psf-hero h1 { margin:0; font:700 clamp(40px,5.4vw,64px)/1.02 var(--font-heading,"Space Grotesk",sans-serif); letter-spacing:-.055em; }
    .psf-hero h1 em { color:var(--psf-blue); font-style:normal; }
    .psf-lede { max-width:620px; margin:15px 0 0; color:var(--psf-muted); font:400 14px/1.8 var(--font-body,Inter,sans-serif); }
    .psf-hero-links { display:flex; flex-wrap:wrap; align-items:center; gap:17px; margin-top:19px; font:700 11px/1.5 var(--font-body,Inter,sans-serif); }
    .psf-hero-links a { display:inline-flex; gap:10px; align-items:center; color:#e5f1f8; text-decoration:none; }
    .psf-hero-links a span { color:var(--psf-blue); }
    .psf-hero-links > span { display:inline-flex; align-items:center; gap:8px; color:#7f94a3; font-size:10px; font-weight:600; }
    .psf-hero-links i { width:3px; height:3px; border-radius:50%; background:var(--psf-blue); }
    .psf-builder { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(260px,.75fr); gap:17px; align-items:start; padding-top:24px; }
    .psf-builder-main { min-width:0; }
    .psf-progress-card,.psf-survey-card,.psf-summary-card,.psf-result-card {
      border:1px solid var(--psf-line);
      border-radius:13px;
      background:linear-gradient(155deg,rgba(16,30,43,.98),rgba(9,19,29,.98));
    }
    .psf-progress-card { padding:15px 19px 13px; }
    .psf-progress-meta { display:flex; justify-content:space-between; gap:12px; color:#718697; font:800 9px/1.4 var(--font-body,Inter,sans-serif); letter-spacing:.11em; }
    .psf-progress-meta span:first-child { color:var(--psf-blue); }
    .psf-progress-track { height:3px; margin-top:12px; border-radius:99px; background:rgba(255,255,255,.07); overflow:hidden; }
    .psf-progress-track span { display:block; width:33.333%; height:100%; border-radius:inherit; background:var(--psf-blue); transition:width .22s ease; }
    .psf-stepper { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:12px; }
    .psf-step-chip { display:flex; align-items:center; gap:7px; color:#6f8494; font:700 10px/1.4 var(--font-body,Inter,sans-serif); }
    .psf-step-chip b { display:grid; place-items:center; width:22px; height:22px; border:1px solid rgba(255,255,255,.1); border-radius:6px; color:#95a8b5; font-size:9px; }
    .psf-step-chip.is-active { color:#eef8ff; }
    .psf-step-chip.is-active b { border-color:rgba(76,201,255,.42); color:#06131c; background:var(--psf-blue); }
    .psf-step-chip.is-complete b { border-color:rgba(71,209,108,.4); color:#07150b; background:var(--psf-green); }
    .psf-survey-card { margin-top:12px; padding:23px; }
    .psf-question[hidden],.psf-results[hidden] { display:none; }
    .psf-question-head { margin-bottom:20px; }
    .psf-question-number { font-size:9px; }
    .psf-question-head h2,.psf-summary-card h2,.psf-results-heading h2 { margin:9px 0 0; font:700 clamp(22px,2.6vw,29px)/1.13 var(--font-heading,"Space Grotesk",sans-serif); letter-spacing:-.04em; }
    .psf-question-head p,.psf-results-heading p { max-width:600px; margin:9px 0 0; color:var(--psf-muted); font:400 12px/1.7 var(--font-body,Inter,sans-serif); }
    .psf-position-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
    .psf-position-card {
      position:relative; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; gap:6px;
      min-height:94px; padding:12px; border:1px solid rgba(255,255,255,.08); border-radius:9px;
      color:var(--psf-text); text-align:left; background:rgba(255,255,255,.018); cursor:pointer;
      transition:border-color .18s,background .18s,transform .18s;
