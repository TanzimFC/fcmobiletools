---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PLAYSTYLES } from '../../data/playstyles.js';
import { PLAYSTYLE_POSITIONS } from '../../data/playstyleFinder.js';
import '../../styles/playstyle-finder.css';

const iconPath = (name, tier = 2) => {
  const style = PLAYSTYLES.find((item) => item.name === name);
  return '/assets/images/playstyle/playstyle_64_PLAYSTYLE_' + style.icon + '_' + tier + '.png';
};

const orbit = [
  { name: 'Rapid', x: '6%', y: '10%', d: 1.4, delay: '0s', c: 'rgba(76,201,255,.6)' },
  { name: 'Finesse Shot', x: '62%', y: '2%', d: -1, delay: '-1.2s', c: 'rgba(246,196,83,.55)' },
  { name: 'Tiki Taka', x: '78%', y: '38%', d: 1.8, delay: '-2.4s', c: 'rgba(154,140,255,.6)' },
  { name: 'Anticipate', x: '14%', y: '58%', d: -1.6, delay: '-3.1s', c: 'rgba(92,240,180,.5)' },
  { name: 'Trickster', x: '52%', y: '70%', d: 1.2, delay: '-4s', c: 'rgba(255,122,156,.5)' },
  { name: 'Deflector', x: '36%', y: '30%', d: -2, delay: '-1.8s', c: 'rgba(76,201,255,.5)' }
].map((item) => ({ ...item, src: iconPath(item.name) }));

/* Pitch lines are authored once (landscape, 100 x 64) and rotated for portrait (64 x 100). */
const lines = [
  [[2, 2], [98, 2], [98, 62], [2, 62], [2, 2]],
  [[50, 2], [50, 62]],
  [[2, 14], [18, 14], [18, 50], [2, 50]],
  [[2, 24], [7, 24], [7, 40], [2, 40]],
  [[98, 14], [82, 14], [82, 50], [98, 50]],
  [[98, 24], [93, 24], [93, 40], [98, 40]]
];
const toPath = (pts, portrait) => pts.map(([x, y], i) => (i ? 'L' : 'M') + (portrait ? y : x) + ' ' + (portrait ? 100 - x : y)).join(' ');
const circleAt = (x, y, portrait) => (portrait ? { cx: y, cy: 100 - x } : { cx: x, cy: y });
const spots = [[12, 32], [88, 32], [50, 32]];

const positions = PLAYSTYLE_POSITIONS.map((position, index) => ({
  ...position,
  index,
  px: position.y,
  py: 100 - position.x
}));

const faqs = [
  {
    q: 'How does the finder decide?',
    a: 'Every answer adds points to hidden play traits such as pace, reading the play, strength or curled shots. Each PlayStyle has its own trait profile, so the finder compares how you play with what each PlayStyle actually improves. Your position and what the community is running are weighed lightly on top.'
  },
  {
    q: 'Why only two PlayStyles (and one for goalkeepers)?',
    a: 'The finder is built to give you a focused pair that cover different moments of a match instead of a long list. Goalkeepers only have two PlayStyles to choose from, so they get a single best fit plus a runner-up.'
  },
  {
    q: 'What does the match percentage mean?',
    a: 'It shows how strongly your answers point at that PlayStyle once position fit and community meta are included. A higher number means more of your answers agree. It is a role-based recommendation, not a promise of match results.'
  },
  {
    q: 'Does it cover the new FC Mobile 27 PlayStyles?',
    a: 'Yes. Incisive Through, Driven Lob Through, Slide Tackle and Dead Ball, the four PlayStyles that arrived with FC Mobile 27, are all in the matching pool alongside the rest of the guide.'
  },
  {
    q: 'Can I share my result?',
    a: 'Yes. Your result has its own link that reopens the same build, and a share card you can save as an image. Nothing is uploaded and no account is needed.'
  }
];
---

<BaseLayout
  title="FC Mobile PlayStyle Finder: Find the Best PlayStyles for Your Position | FCMOBILETOOLS"
  description="Answer a few match scenarios and get the FC Mobile PlayStyles that fit how you actually play. Position-aware, community-meta aware, with match scores, reasons and a shareable build card."
  canonical="/player/playstyle-finder/"
>
  <main class="psf-page" id="psfRoot">
    <div class="psf-bg" aria-hidden="true"><span class="psf-orb o1"></span><span class="psf-orb o2"></span><span class="psf-orb o3"></span><span class="psf-gridlines"></span></div>

    <section class="psf-hero">
      <div class="psf-shell">
        <nav class="psf-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/player/playstyle/">PlayStyle Guide</a><span aria-hidden="true">/</span><strong>Finder</strong>
        </nav>
        <div class="psf-hero-grid">
          <div>
            <span class="psf-pill"><i></i> FC Mobile 27 ready</span>
            <h1>Find the PlayStyle <span class="psf-shine">your game is asking for.</span></h1>
            <p class="psf-lede">No guessing from descriptions. Tell us what you do in real match moments and our analyzer reads your play, then matches it to the PlayStyles that make that play better.</p>
            <ul class="psf-trust">
              <li><b>22</b> PlayStyles analysed</li>
              <li><b>12</b> positions</li>
              <li><b>~40s</b> to your result</li>
              <li><b>Meta</b> aware</li>
            </ul>
          </div>
          <div class="psf-constellation" id="psfConstellation" aria-hidden="true">
            {orbit.map((item, i) => (
              <div class="psf-orbit" style={`--x:${item.x};--y:${item.y};--d:${item.d};--delay:${item.delay};--c:${item.c}`}>
                <img src={item.src} alt="" width="68" height="68" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="psf-shell psf-builder" id="psfBuilder" aria-label="PlayStyle finder">
      <div class="psf-stage" id="psfStage">
        <div class="psf-stage-head">
          <div class="psf-stage-meta"><span id="psfStepLabel"><b>Step 1</b> / Position</span><span id="psfStepHint">Takes about 40 seconds</span></div>
          <div class="psf-pips" id="psfPips" aria-hidden="true"></div>
        </div>

        <div class="psf-panels">
          <section class="psf-panel" id="psfPanelPosition" aria-labelledby="psfPosTitle">
            <span class="psf-q-kicker">Start here</span>
            <h2 class="psf-q-title" id="psfPosTitle">Where does this player play?</h2>
            <p class="psf-q-hint">Tap the position on the pitch. It sets which questions we ask and which PlayStyles are in the running.</p>
            <div class="psf-pitch" id="psfPitch">
              {[false, true].map((portrait) => (
                <svg class={'psf-pl ' + (portrait ? 'psf-pl-p' : 'psf-pl-l')} viewBox={portrait ? '0 0 64 100' : '0 0 100 64'} aria-hidden="true" focusable="false">
                  {lines.map((pts) => <path class="psf-pline" pathLength="1" d={toPath(pts, portrait)} />)}
                  <circle class="psf-pline" pathLength="1" cx={circleAt(50, 32, portrait).cx} cy={circleAt(50, 32, portrait).cy} r="8" />
                  {spots.map(([x, y]) => <circle class="psf-pdot" cx={circleAt(x, y, portrait).cx} cy={circleAt(x, y, portrait).cy} r=".7" />)}
                </svg>
              ))}
              {positions.map((position) => (
                <button type="button" class="psf-pos" data-position={position.code} aria-pressed="false" aria-label={position.label + ' (' + position.code + ')'} style={`--lx:${position.x};--ly:${position.y};--px:${position.px};--py:${position.py};--i:${position.index}`}>
                  {position.code}
                  <span class="psf-pos-tip">{position.label}</span>
                </button>
              ))}
            </div>
            <p class="psf-pitch-note"><span id="psfPitchNote">Not sure? Use the position shown on your player card.</span><span>Attacking <strong>&rarr;</strong></span></p>
          </section>

          <section class="psf-panel" id="psfPanelQuestion" hidden aria-live="polite"></section>
        </div>

        <div class="psf-stage-foot">
          <button class="psf-btn" id="psfBack" type="button" hidden><span aria-hidden="true">&larr;</span> Back</button>
          <p class="psf-status" id="psfStatus" role="status" aria-live="polite">Pick a position to wake the analyzer.</p>
          <button class="psf-btn primary" id="psfNext" type="button" disabled><span id="psfNextLabel">Continue</span> <span aria-hidden="true">&rarr;</span></button>
        </div>

        <div class="psf-analyzing" id="psfAnalyzing" hidden>
          <div>
            <div class="psf-scan"><i></i><i></i><i></i><b>FC</b></div>
            <h3>Analysing your play</h3>
            <p id="psfAnalyzingLine">Reading your answers&hellip;</p>
          </div>
        </div>
      </div>

      <aside class="psf-live" id="psfLive" aria-label="Live analyzer">
        <div class="psf-live-head">
          <span class="psf-live-title"><i></i> Live analyzer</span>
          <span class="psf-signal" id="psfSignal" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        </div>
        <div class="psf-live-role">
          <small>Your read so far</small>
          <strong id="psfLiveTitle">Waiting for a position</strong>
          <span id="psfLiveSub">Pick a position and answer to watch the read sharpen in real time.</span>
        </div>
        <div>
          <div class="psf-live-radar" id="psfLiveRadar"></div>
        </div>
        <div>
          <p class="psf-live-label">Currently leaning toward</p>
          <div class="psf-lean" id="psfLean"><p class="psf-lean-empty">Your top three PlayStyles appear here and re-rank after every answer.</p></div>
        </div>
        <p class="psf-live-foot">Tip: use keys 1 to 5 to answer, Enter to continue and Backspace to go back.</p>
        <button class="psf-btn small psf-restart" id="psfRestart" type="button">Start over</button>
      </aside>
    </section>

    <section class="psf-shell psf-recent" id="psfRecent" hidden>
      <h2>Your recent builds</h2>
      <div class="psf-recent-list" id="psfRecentList"></div>
    </section>

    <section class="psf-shell psf-results" id="psfResults" aria-live="polite" hidden></section>

    <section class="psf-shell psf-how" aria-labelledby="psfHowTitle">
      <div class="psf-section-title" style="margin-top:0">
        <h2 id="psfHowTitle">A finder that actually thinks</h2>
        <p>Built from the PlayStyle guide and what FC Mobile players are running right now.</p>
      </div>
      <div class="psf-how-grid">
        <article class="psf-how-card"><span>01</span><h3>Scenarios, not labels</h3><p>You are never asked to pick a PlayStyle from its description. You describe what you do when a cut-back lands or a winger runs at you, and we work out the rest.</p></article>
        <article class="psf-how-card"><span>02</span><h3>Position aware</h3><p>A centre-back and a winger get different questions and a different pool. A PlayStyle that does not suit your role is scored down instead of ignored.</p></article>
        <article class="psf-how-card"><span>03</span><h3>Meta checked</h3><p>Community picks for your position are shown next to your result, so you can see where your build matches the crowd and where it goes its own way.</p></article>
      </div>
      <div class="psf-faq">
        {faqs.map((item) => (
          <details><summary>{item.q}</summary><p>{item.a}</p></details>
        ))}
      </div>
    </section>

    <div class="psf-toast" id="psfToast" role="status" aria-live="polite"></div>
  </main>

  <script>
    import '../../scripts/playstyle-finder.js';
  </script>
</BaseLayout>
