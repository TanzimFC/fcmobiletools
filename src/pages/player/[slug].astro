.profile-strip small{display:block;color:#587187;font:800 7.5px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.13em}
.profile-strip b{display:block;margin-top:6px;color:#DCE9F1;font-size:11px;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.alt-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:9px;padding:12px 14px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}
.alt-row>span{color:#587187;font:800 7.5px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.13em}
.alt-row div{display:flex;flex-wrap:wrap;gap:6px}
.alt-row b{padding:6px 10px;border-radius:99px;color:var(--accent-2);background:rgba(var(--accent-rgb),.09);border:1px solid rgba(var(--accent-rgb),.18);font:800 10px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.06em}
.tool-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:16px}
.button{position:relative;overflow:hidden;min-height:54px;display:flex;align-items:center;justify-content:center;gap:10px;padding:0 16px;border-radius:15px;text-decoration:none;font:800 11px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.04em;transition:transform .2s var(--ease),border-color .2s,box-shadow .2s}
.button:hover{transform:translateY(-3px)}
.button-primary{color:var(--ink);background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 14px 34px rgba(var(--accent-rgb),.22)}
.button-primary::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-120%);transition:transform .7s var(--ease)}
.button-primary:hover{box-shadow:0 20px 44px rgba(var(--accent-rgb),.34)}
.button-primary:hover::after{transform:translateX(120%)}
.button-secondary{color:#E4F6FD;border:1px solid rgba(var(--accent-rgb),.22);background:rgba(var(--accent-rgb),.06)}
.button-secondary:hover{border-color:rgba(var(--accent-rgb),.5);background:rgba(var(--accent-rgb),.1)}
.button-icon{display:grid;place-items:center;min-width:22px;height:22px;border-radius:7px;font-size:10px;background:rgba(0,0,0,.14)}
.button-secondary .button-icon{background:rgba(var(--accent-rgb),.14);color:var(--accent-2)}

/* panels */
.core-section,.panel-section{position:relative;border-radius:26px;border:1px solid var(--line);background:linear-gradient(165deg,rgba(18,31,45,.82),rgba(8,17,26,.86));backdrop-filter:blur(10px);box-shadow:0 30px 80px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.04)}
.core-section::before,.panel-section::before{content:"";position:absolute;left:26px;right:26px;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(var(--accent-rgb),.55),transparent);opacity:.7}
.core-section{padding:26px;margin-top:6px}
.panel-section{padding:26px}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
.kicker{display:inline-flex;align-items:center;gap:8px;color:var(--accent);font:800 8.5px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.18em}
.kicker::before{content:"";width:16px;height:2px;border-radius:2px;background:var(--accent)}
.section-head h2{margin:10px 0 0;color:#F2FAFD;font:800 29px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.05em}
.section-note{color:#587286;font:800 8px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}

/* stat tiers */
.t-elite{--tier:var(--elite)}
.t-high{--tier:var(--high)}
.t-mid{--tier:var(--mid)}
.t-low{--tier:var(--low)}
.t-none{--tier:var(--low)}

.core-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.core-card{--tier:var(--high);padding:16px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(150deg,rgba(20,38,54,.9),rgba(10,20,30,.9));transition:border-color .2s,transform .25s var(--ease)}
