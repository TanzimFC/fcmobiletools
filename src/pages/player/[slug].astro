.data-empty{display:grid;gap:5px;padding:22px;border:1px dashed rgba(var(--accent-rgb),.2);border-radius:16px;background:rgba(var(--accent-rgb),.03);color:#7890A1;font-size:12px;line-height:1.6}
.data-empty strong{color:#B7D5E2;font-size:12px}

/* radar */
.radar{display:block;width:min(100%,320px);margin:0 auto 12px;overflow:visible}
.radar polygon{fill:none}
.radar-ring{stroke:rgba(255,255,255,.07);stroke-width:1}
.radar-axis{stroke:rgba(255,255,255,.06);stroke-width:1}
.radar .radar-fill{fill:url(#radarFill);stroke:var(--accent);stroke-width:2;stroke-linejoin:round;filter:drop-shadow(0 0 12px rgba(var(--accent-rgb),.4));transform-origin:160px 160px;transform-box:view-box;transition:transform 1s var(--ease),opacity .6s}
.radar-dot{fill:var(--accent-2);stroke:var(--bg);stroke-width:2;transition:opacity .6s .6s}
