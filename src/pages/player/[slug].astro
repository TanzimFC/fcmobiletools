---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalog from '../../data/playerPageCatalog.json';
export function getStaticPaths() {
  return catalog.map(([player_id, name, ovr, position]) => {
    const slug = `${name.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${player_id}`;
    return { params: { slug }, props: { player: { player_id, name, slug, ovr, position } } };
  });
}
const { player } = Astro.props;
const title = `${player.name} ${player.ovr} ${player.position} | FC Mobile Player Database`;
const description = `${player.name} ${player.ovr} OVR ${player.position} FC Mobile card. View card details, player stats, rank records, and dated Star Shard cost data.`;
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: new URL(`/player/${player.slug}/`, Astro.site), isPartOf: { '@type': 'WebSite', name: 'FCMOBILETOOLS', url: Astro.site } };
---
<BaseLayout title={title} description={description}>
  <main class="player-detail" data-player-slug={player.slug}>
    <a class="player-back-link" href="/players/">← Back to player database</a>
    <section class="player-detail-head">
      <div class="player-detail-art" id="detail-art"><div class="player-card-fallback" aria-hidden="true">{player.name.slice(0, 1).toUpperCase()}</div></div>
      <div class="player-detail-title">
        <p class="players-eyebrow">FCMOBILETOOLS · PLAYER PROFILE</p>
        <h1>{player.name}</h1>
        <p id="player-event">FC Mobile player card</p>
        <div class="player-info-pills"><span><b>{player.ovr}</b> OVR</span><span>{player.position}</span><span>Alt: —</span><span class="player-rank-label">Base card</span></div>
        <p class="player-source player-market" id="market-status">Current coin sell-price data: no verified price observation available.</p>
      </div>
    </section>
    <div class="player-detail-grid">
      <section class="player-panel"><h2>Overview</h2><div class="player-stat-list" id="player-overview"><span class="player-loading">Loading player details…</span></div></section>
      <section class="player-panel"><h2>Star Shard cost</h2><div class="player-stat-list" id="player-shards"><span class="player-loading">Checking dated source records…</span></div><p class="player-source" id="shard-source"></p></section>
      <section class="player-panel"><h2>Attributes</h2><div id="player-stats"><p class="player-loading">Detailed stats have not been verified for this card.</p></div></section>
      <section class="player-panel"><h2>Rank and training records</h2><div class="player-rank-list" id="player-ranks"><span>Rank data has not been sourced for this card.</span></div><p class="player-source" id="rank-status">No rank modifier is applied unless a source record exists.</p></section>
      <section class="player-panel"><h2>PlayStyles</h2><div class="player-abilities" id="player-abilities"><span class="player-loading">No verified PlayStyle records yet.</span></div></section>
      <section class="player-panel"><h2>Traits</h2><div class="player-abilities" id="player-traits"><span class="player-loading">No verified trait records yet.</span></div></section>
    </div>
    <section class="player-panel" style="margin-top:14px"><h2>Related players</h2><div class="player-related" id="related-players"><span class="player-loading">Loading players in the same position…</span></div></section>
    <p class="player-data-note">Player listing and Star Shard source: <a href="https://fcmobilesquad.com/star-signings-players" rel="nofollow">FC Mobile Squad</a>. Dataset observed September 16, 2026. Prices, statistics, and abilities are shown only when sourced.</p>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </main>
</BaseLayout>

<script>
import { renderPlayerCard as card } from '../../lib/playerCard.js';
const page = document.querySelector('[data-player-slug]');
const slug = page?.getAttribute('data-player-slug');
const esc = (value = '') => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
const groups = { Pace: ['pace','acceleration','sprint_speed'], Shooting: ['shooting','finishing','shot_power','long_shot','positioning','volleys','penalties'], Passing: ['passing','short_passing','long_passing','vision','crossing','curve','free_kick'], Dribbling: ['dribbling','agility','balance','reactions','ball_control'], Defending: ['defending','marking','standing_tackle','sliding_tackle','awareness','heading'], Physical: ['physical','stamina','strength','aggression','jumping'], Goalkeeping: ['diving','handling','kicking','reflexes'] };
function statRows(stats, activeRank) {
  if (!stats || typeof stats !== 'object' || !Object.keys(stats).length) return '<p class="player-loading">Detailed stats have not been verified for this card.</p>';
  const values = { ...stats };
  const modifiers = activeRank?.stat_modifiers || {};
  for (const [key, amount] of Object.entries(modifiers)) if (Number.isFinite(Number(values[key]))) values[key] = Number(values[key]) + Number(amount);
  const labels = { sprint_speed: 'Sprint speed', shot_power: 'Shot power', long_shot: 'Long shots', short_passing: 'Short passing', long_passing: 'Long passing', free_kick: 'Free kick', ball_control: 'Ball control', standing_tackle: 'Standing tackle', sliding_tackle: 'Sliding tackle' };
  return Object.entries(groups).map(([group, keys]) => {
    const rows = keys.filter((key) => values[key] !== undefined && values[key] !== null).map((key) => { const value=values[key]; const width=Math.min(100,Math.max(0,Number(value)/220*100)); return `<div class="player-stat-item"><span>${esc(labels[key] || key.replaceAll('_', ' ') )}</span><b>${esc(value)}</b><span class="player-stat-bar" aria-hidden="true"><i style="--stat-width:${width}%"></i></span></div>`; }).join('');
    return rows ? `<h3>${esc(group)}</h3><div class="player-stat-list">${rows}</div>` : '';
  }).join('') || '<p class="player-loading">Detailed stats have not been verified for this card.</p>';
}
function abilities(rows, type) {
  const list = rows.filter((row) => row.player_abilities?.ability_type === type);
  if (!list.length) return `<span class="player-loading">No verified ${type === 'playstyle' ? 'PlayStyle' : 'trait'} records yet.</span>`;
  return list.map((row) => { const item = row.player_abilities; const asset = item.player_assets?.public_url || item.player_assets?.local_path; return `<span class="player-ability">${asset ? `<img src="${esc(asset)}" alt="">` : ''}${esc(item.name)}${item.is_plus ? ' +' : ''}</span>`; }).join('');
}
async function load() {
  try {
    const response = await fetch(`/api/players/${encodeURIComponent(slug)}`);
    const player = await response.json();
    if (!response.ok) throw new Error(player.error || 'Player details unavailable.');
    document.querySelector('#player-event').textContent = player.event || 'FC Mobile player card';
    if (player.image) document.querySelector('#detail-art').insertAdjacentHTML('beforeend', `<img src="${esc(player.image)}" alt="${esc(player.name)} ${player.ovr} OVR player card" decoding="async" onerror="this.remove()">`);
    const pills = document.querySelectorAll('.player-info-pills span');
    pills[2].textContent = `Alt: ${(player.alternate_positions || []).join(', ') || '—'}`;
    document.querySelector('#player-overview').innerHTML = [
      ['Skill moves', player.skill_moves], ['Weak foot', player.weak_foot], ['Strong foot', player.strong_foot], ['Foot side', player.strong_foot_side], ['Attack work rate', player.work_rate_attack], ['Defence work rate', player.work_rate_defense], ['Height', player.height_cm ? `${player.height_cm} cm` : null], ['Weight', player.weight_kg ? `${player.weight_kg} kg` : null]
    ].filter(([,value]) => value !== null && value !== undefined).map(([label,value]) => `<div class="player-stat-item"><span>${esc(label)}</span><b>${esc(value)}</b></div>`).join('') || '<p class="player-loading">No additional overview data has been verified.</p>';
    if (player.shard_cost) {
      document.querySelector('#player-shards').innerHTML = `<div class="player-stat-item"><span>${esc(player.shard_cost.shard_type.replaceAll('_',' '))}</span><b>${Number(player.shard_cost.shard_cost).toLocaleString()}</b></div><div class="player-stat-item"><span>Observed</span><b>${new Date(player.shard_cost.observed_at).toLocaleDateString()}</b></div>`;
      document.querySelector('#shard-source').innerHTML = `Source: <a href="${esc(player.shard_cost.source_url)}" rel="nofollow">${esc(player.shard_cost.source_name)}</a>`;
    } else document.querySelector('#player-shards').innerHTML = '<p class="player-loading">No shard-cost record is available.</p>';
    if (player.sell_price?.current_sell_price != null) document.querySelector('#market-status').innerHTML = `Current sell price: <strong class="player-live-price">${Number(player.sell_price.current_sell_price).toLocaleString()} ${esc(player.sell_price.currency)}</strong> · observed ${new Date(player.sell_price.observed_at).toLocaleDateString()} · <a href="${esc(player.sell_price.source_url)}" rel="nofollow">source</a>`;
    document.querySelector('#player-stats').innerHTML = statRows(player.stats?.stats, null);
    const ranks = player.ranks || [];
    if (ranks.length) {
      const rankNode = document.querySelector('#player-ranks');
      rankNode.innerHTML = ranks.map((rank, index) => `<button type="button" class="player-rank-choice" data-rank-index="${index}">Rank ${rank.rank}${rank.training_level ? ` · L${rank.training_level}` : ''}${rank.ovr ? ` · ${rank.ovr} OVR` : ''}</button>`).join('');
      rankNode.querySelectorAll('button').forEach((button) => button.addEventListener('click', () => {
        const rank = ranks[Number(button.dataset.rankIndex)];
        document.querySelectorAll('.player-rank-choice').forEach((x) => x.setAttribute('aria-pressed', String(x === button)));
        document.querySelector('#player-stats').innerHTML = statRows(player.stats?.stats, rank);
        document.querySelector('#rank-status').textContent = rank.source_url ? `Rank modifiers from ${rank.source_url}` : `Rank ${rank.rank} modifiers loaded from the database.`;
      }));
    }
    document.querySelector('#player-abilities').innerHTML = abilities(player.abilities || [], 'playstyle');
    document.querySelector('#player-traits').innerHTML = abilities(player.abilities || [], 'trait');
    const related = await fetch(`/api/players?position=${encodeURIComponent(player.position)}&limit=7&sort=ovr-desc`);
    const relatedData = await related.json();
    document.querySelector('#related-players').innerHTML = relatedData.players.filter((item) => item.player_id !== player.player_id).slice(0,6).map(card).join('') || '<p>No related players found.</p>';
  } catch (error) {
    document.querySelector('#player-overview').innerHTML = `<p class="player-loading">${esc(error.message)}</p>`;
  }
}
load();
</script>

<style is:global>
.players-page,.player-detail{width:min(1220px,calc(100% - 36px));margin:0 auto;padding:54px 0 90px;color:#eaf6fb}.players-heading{margin:0 auto 28px;max-width:760px;text-align:center}.players-eyebrow{font:700 11px/1.2 ui-monospace,monospace;letter-spacing:.18em;color:#5cd4ff}.players-heading h1{margin:12px 0;font-size:clamp(34px,6vw,60px);letter-spacing:-.055em}.players-heading>p:last-child{color:#98acb8;font-size:15px}.player-filters{display:grid;grid-template-columns:2fr repeat(2,minmax(130px,1fr)) repeat(2,minmax(110px,.7fr)) minmax(170px,1fr) auto;gap:10px;align-items:end;padding:16px;border:1px solid #203744;border-radius:18px;background:linear-gradient(140deg,#101c25,#0b131a);box-shadow:0 14px 38px #0003}.player-filters label{display:grid;gap:7px;min-width:0}.player-filters label span{font-size:11px;font-weight:700;color:#8ca3b0}.player-filters input,.player-filters select{min-width:0;width:100%;height:42px;padding:0 12px;border:1px solid #29404d;border-radius:10px;background:#091219;color:#eef8fc;font:500 13px inherit}.player-filter-submit,.player-pagination button{height:42px;padding:0 16px;border:1px solid #47c9f7;border-radius:10px;background:#48c4ed;color:#05131b;font-weight:800;cursor:pointer}.player-results-head{display:flex;justify-content:space-between;align-items:center;margin:26px 2px 13px;color:#9bb1bd;font-size:13px}.player-results-head strong{color:#eff9fc;font-size:14px}.player-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.player-card-shell{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid #203945;border-radius:17px;background:#0a1218;color:inherit;text-decoration:none;transition:transform .18s,border-color .18s,box-shadow .18s}.player-card-shell:hover{transform:translateY(-3px);border-color:#55cef6;box-shadow:0 15px 34px #0005}.player-card-art{position:relative;isolation:isolate;display:block;min-height:260px;overflow:hidden;padding:12px;background-image:var(--player-card-bg,none),radial-gradient(ellipse at 50% 55%,#5bd8f53b,transparent 44%),linear-gradient(145deg,#142f3c 0%,#0c1a23 54%,#091119 100%);background-size:cover,auto,auto;background-position:center,center,center}.player-card-art:before{content:"";position:absolute;inset:6px;border:1px solid var(--card-accent);clip-path:polygon(0 0,78% 0,100% 18%,100% 100%,0 100%);opacity:.72;pointer-events:none}.player-card-art:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 15px,#ffffff08 16px,#ffffff08 17px,transparent 18px 31px);pointer-events:none}.player-card-tier-standard{--card-accent:#62d8f4}.player-card-tier-elite{--card-accent:#a8a7ff;background-image:var(--player-card-bg,none),radial-gradient(ellipse at 50% 55%,#9275ff4d,transparent 45%),linear-gradient(145deg,#29254b,#11172a 56%,#0a101a);background-size:cover,auto,auto;background-position:center,center,center}.player-card-tier-legend{--card-accent:#ffe095;background-image:var(--player-card-bg,none),radial-gradient(ellipse at 50% 55%,#ffc45b45,transparent 46%),linear-gradient(145deg,#55452a,#211b16 56%,#0d1117);background-size:cover,auto,auto;background-position:center,center,center}.player-card-topline,.player-card-footline{position:absolute;z-index:3;left:16px;right:16px;display:flex;justify-content:space-between;align-items:center;color:var(--card-accent);font:700 8px/1.2 ui-monospace,monospace;letter-spacing:.11em}.player-card-topline{top:16px}.player-card-edition{color:#c3d0d6;font-size:7px}.player-card-rating{position:absolute;z-index:4;left:17px;top:39px;display:grid;text-align:center;color:#f8fbfc}.player-card-rating b{font:800 25px/1 system-ui}.player-card-rating small{font:800 8px/1.4 ui-monospace,monospace;letter-spacing:.15em;color:var(--card-accent)}.player-card-rating strong{margin-top:4px;font:800 10px/1 system-ui;color:#fff}.player-card-emblem{position:absolute;z-index:2;right:17px;top:39px;color:var(--card-accent);font:900 11px/1 system-ui;letter-spacing:-.05em}.player-card-portrait{position:absolute;z-index:1;inset:67px 14px 52px;display:grid;place-items:center}.player-card-monogram{display:grid;place-items:center;width:104px;aspect-ratio:1;border-radius:50%;border:1px solid var(--card-accent);background:radial-gradient(circle at 50% 38%,#ffffff20,transparent 60%),linear-gradient(145deg,#dcecf01c,#60747e08);color:#f2fbfe;font:800 31px/1 system-ui;letter-spacing:-.06em;text-shadow:0 5px 19px #0008;box-shadow:0 0 42px #62d8f426}.player-card-image{position:absolute;inset:0;width:100%;height:100%;max-width:100%;object-fit:contain;filter:drop-shadow(0 12px 17px #0009)}.player-card-mark{width:15px;height:15px;object-fit:contain;filter:drop-shadow(0 2px 5px #0009)}.player-card-emblem:has(.player-card-mark){display:flex;align-items:center;gap:4px}.player-card-identity{position:absolute;z-index:4;left:16px;right:16px;bottom:30px;display:grid;gap:4px;text-align:center;text-shadow:0 2px 10px #000}.player-card-identity strong{overflow:hidden;color:#fff;font:800 15px/1.1 system-ui;letter-spacing:-.035em;text-overflow:ellipsis;white-space:nowrap}.player-card-identity span{overflow:hidden;color:var(--card-accent);font:700 8px/1.2 ui-monospace,monospace;letter-spacing:.06em;text-overflow:ellipsis;white-space:nowrap}.player-card-footline{bottom:13px;color:#9bb0bb;font-size:6px}.player-card-shards{position:absolute;z-index:5;right:9px;bottom:9px;display:flex;align-items:center;gap:4px;padding:5px 7px;border:1px solid #f0d27755;border-radius:999px;background:#09151be8;color:#ffe28f;font-size:8px;font-weight:800}.player-card-shards img{width:12px;height:12px;object-fit:contain}.player-card-copy{padding:12px 13px 14px}.player-card-copy h2{overflow:hidden;margin:0;color:#f1f9fc;font-size:14px;text-overflow:ellipsis;white-space:nowrap}.player-card-copy p{overflow:hidden;margin:5px 0 0;color:#8ea5b2;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.player-empty{padding:45px 15px;text-align:center;color:#9db2bd;border:1px dashed #34505e;border-radius:16px}.player-pagination{display:flex;justify-content:center;align-items:center;gap:17px;margin:28px 0 18px;color:#a8bdc7;font-size:13px}.player-pagination button{background:transparent;color:#cceefa}.player-pagination button:disabled{opacity:.4;cursor:not-allowed}.player-data-note{margin:20px auto 0;max-width:820px;text-align:center;color:#849aa6;font-size:11px;line-height:1.7}.player-data-note a{color:#77dfff}.player-detail-head{display:grid;grid-template-columns:minmax(210px,320px) 1fr;gap:30px;align-items:center;margin-bottom:30px;padding:28px;border:1px solid #24404e;border-radius:22px;background:radial-gradient(ellipse at 14% 15%,#51d1ff19,transparent 43%),linear-gradient(145deg,#11212b,#0a1218)}.player-detail-art{display:grid;place-items:center;position:relative;min-height:300px}.player-detail-art img{max-width:100%;height:300px;object-fit:contain;filter:drop-shadow(0 18px 25px #0009)}.player-detail-title .players-eyebrow{margin:0}.player-detail-title h1{margin:12px 0;font-size:clamp(32px,5vw,54px);letter-spacing:-.05em}.player-detail-title p{color:#a8bbc5;line-height:1.8}.player-info-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.player-info-pills span{padding:8px 11px;border:1px solid #2d4a59;border-radius:999px;background:#0a171f;color:#b9d9e5;font-size:11px}.player-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.player-panel{padding:21px;border:1px solid #223a47;border-radius:17px;background:#0e1920}.player-panel h2{margin:0 0 14px;font-size:17px}.player-stat-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.player-stat-item{display:flex;justify-content:space-between;gap:12px;padding:10px;border-radius:9px;background:#081117;color:#99aeba;font-size:12px}.player-stat-item b{color:#e3f5fa}.player-source{margin-top:12px;color:#8299a5;font-size:11px}.player-source a{color:#74dafa}.player-live-price{color:#fff0bb}.player-rank-list{display:flex;gap:7px;flex-wrap:wrap}.player-rank-list span{padding:7px 10px;border:1px solid #2a4553;border-radius:9px;color:#bdd4de;font-size:11px}.player-loading{color:#91a8b3}.player-abilities{display:flex;gap:10px;flex-wrap:wrap}.player-ability{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #28414e;border-radius:11px;color:#c9dce4;font-size:12px}.player-ability img{width:28px;height:28px;object-fit:contain}.player-related{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.player-back-link{display:inline-block;margin-bottom:19px;color:#75dafa;text-decoration:none;font-size:13px}.player-loading-card{height:280px;border-radius:16px;background:linear-gradient(100deg,#101d25,#172831,#101d25);background-size:200% 100%;animation:player-shimmer 1.5s infinite}@keyframes player-shimmer{to{background-position:-200% 0}}@media(max-width:1050px){.player-filters{grid-template-columns:repeat(4,minmax(0,1fr))}.player-search{grid-column:span 2}.player-grid,.player-related{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:700px){.players-page,.player-detail{width:min(100% - 24px,580px);padding:34px 0 65px}.player-filters{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px}.player-search{grid-column:span 2}.player-filter-submit{grid-column:span 2}.player-grid,.player-related{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.player-card-art{min-height:176px}.player-card-art img{height:160px}.player-detail-head{grid-template-columns:1fr;gap:6px;padding:18px}.player-detail-art{min-height:240px}.player-detail-art img{height:235px}.player-detail-grid{grid-template-columns:1fr}.player-results-head span{font-size:11px}.player-card-copy{padding:10px}.player-card-copy h2{font-size:12px}}

/* Detail profile enhancements */
.player-detail-head{position:relative;overflow:hidden;isolation:isolate;min-height:350px;box-shadow:0 24px 70px #0005}
.player-detail-head:after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,transparent 45%,#5bd8f508),radial-gradient(ellipse at 80% 20%,#5bd8f51a,transparent 54%)}
.player-detail-art{min-height:310px;overflow:hidden;border-radius:15px;background:radial-gradient(ellipse at 50% 45%,#62d8f42c,transparent 60%),linear-gradient(145deg,#0a151c99,#07101655)}
.player-detail-art:before{content:"";position:absolute;inset:9px;border:1px solid #74dcf455;border-radius:12px;clip-path:polygon(0 0,80% 0,100% 14%,100% 100%,0 100%);pointer-events:none}
.player-detail-art .player-card-fallback{display:grid;place-items:center;width:130px;aspect-ratio:1;border-radius:50%;border:1px solid #71dbf777;background:radial-gradient(circle at 50% 38%,#ffffff24,transparent 60%),linear-gradient(145deg,#dcecf01c,#60747e08);color:#eefbff;font:900 44px/1 system-ui;letter-spacing:-.07em;text-shadow:0 5px 19px #0008;box-shadow:0 0 55px #62d8f426}
.player-detail-art img{position:relative;z-index:1;max-height:310px;width:100%;object-fit:contain;filter:drop-shadow(0 18px 25px #0009)}
.player-detail-title{position:relative;z-index:1}.player-detail-title h1{font-size:clamp(36px,5.5vw,64px);line-height:1.02}.player-detail-title #player-event{display:inline-flex;align-items:center;gap:8px;margin:0;padding:7px 10px;border:1px solid #56c9ed45;border-radius:999px;background:#06131bcc;color:#8ce6ff;font:700 10px/1.3 ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase}
.player-info-pills span{display:inline-flex;align-items:center;gap:5px;border-color:#284554;background:linear-gradient(135deg,#0b1921,#0a131a);color:#cde7f0;font-weight:700;box-shadow:inset 0 1px #ffffff08}
.player-info-pills span:first-child{border-color:#f0d27768;color:#ffe6a4}.player-info-pills span:first-child b{font:800 20px/1 var(--mono)}
.player-rank-label{color:#9daaff!important;border-color:#8176ec55!important}
.player-market{margin-top:20px!important;padding:10px 12px;border-left:2px solid #55c7f2;background:#09151b;color:#91a8b3!important}
.player-detail-grid{align-items:start;gap:16px}
.player-panel{position:relative;overflow:hidden;border-color:#203744;background:linear-gradient(145deg,#101b23,#0b1319);box-shadow:0 14px 36px #0002}
