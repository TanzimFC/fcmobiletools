---
import BaseLayout from '../../layouts/BaseLayout.astro';
import topPlayerIds from '../../data/top-players.json';
import { RANKS, getRankBracket } from '../../data/fcMobileRankUp.js';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../../data/fcMobileTraining.js';
import {
  buildZenithPlayerSlug,
  fetchZenithPlayerBySlug,
  fetchZenithPlayersByIds,
} from '../../lib/zenithPlayerApi.js';

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png',
};

export async function getStaticPaths() {
  const prerenderLimit = Math.min(
    10000,
    Math.max(1, Number(globalThis.process?.env?.TOP_PLAYERS_PRERENDER_LIMIT || 100))
  );
  const ids = topPlayerIds.map(String).slice(0, prerenderLimit);
  const players = await fetchZenithPlayersByIds(ids, { rank: 0, chunkSize: 100 });
  const paths = [];
  const seen = new Set();

  for (const player of players) {
    const slug = buildZenithPlayerSlug(player);
    if (!slug || seen.has(slug)) continue;
    seen.add(slug);
    paths.push({ params: { slug }, props: { player } });
  }

  console.log('[player-pages] generated static paths:', paths.length);
  return paths;
}

const slug = Astro.params.slug ?? '';
let player = Astro.props.player ?? null;

if (!player) player = await fetchZenithPlayerBySlug(slug, 0);

const assets = Array.isArray(player?.images) ? player.images : [];

const getAsset = (...types) => {
  for (const type of types) {
    const match =
      assets.find((item) => item.asset_type === type && item.is_primary) ??
      assets.find((item) => item.asset_type === type);
    if (match) return match;
  }
  return null;
};

const render = getAsset('player_render');
const background = getAsset('card_background');
const flag = getAsset('nation_flag');
const clubLogo = getAsset('club_logo', 'club_badge');
const leagueLogo = getAsset('league_logo');

const baseStats = player?.stats ?? {};
const statGroups = [
  ['Pace', ['acceleration', 'sprint_speed']],
  ['Shooting', ['finishing', 'positioning', 'shot_power', 'long_shot', 'volleys', 'volley', 'penalties']],
  ['Passing', ['short_passing', 'long_passing', 'vision', 'crossing', 'curve', 'free_kick']],
  ['Dribbling', ['dribbling_head', 'agility', 'balance', 'reactions', 'ball_control']],
  ['Defending', ['marking', 'standing_tackle', 'sliding_tackle', 'awareness', 'heading']],
  ['Physical', ['strength', 'aggression', 'jumping', 'stamina_stat']],
  ['Goalkeeping', ['diving', 'gk_diving', 'handling', 'gk_handling', 'kicking', 'gk_kicking', 'reflexes', 'gk_reflexes', 'gk_positioning']],
];

const labels = {
  acceleration: 'Acceleration',
  sprint_speed: 'Sprint Speed',
  finishing: 'Finishing',
  positioning: 'Positioning',
  shot_power: 'Shot Power',
  long_shot: 'Long Shot',
  volleys: 'Volleys',
  volley: 'Volley',
  penalties: 'Penalties',
  short_passing: 'Short Passing',
  long_passing: 'Long Passing',
  vision: 'Vision',
  crossing: 'Crossing',
  curve: 'Curve',
  free_kick: 'Free Kick',
  dribbling_head: 'Dribbling',
  agility: 'Agility',
  balance: 'Balance',
  reactions: 'Reactions',
  ball_control: 'Ball Control',
  marking: 'Marking',
  standing_tackle: 'Standing Tackle',
  sliding_tackle: 'Sliding Tackle',
  awareness: 'Defensive Awareness',
  heading: 'Heading',
  strength: 'Strength',
  aggression: 'Aggression',
  jumping: 'Jumping',
  stamina_stat: 'Stamina',
  diving: 'Diving',
  gk_diving: 'Diving',
  handling: 'Handling',
  gk_handling: 'Handling',
  kicking: 'Kicking',
  gk_kicking: 'Kicking',
  reflexes: 'Reflexes',
  gk_reflexes: 'Reflexes',
  gk_positioning: 'Positioning',
};

const availableGroups = statGroups
  .map(([name, keys]) => [name, keys.filter((key) => baseStats[key] !== undefined && baseStats[key] !== null)] as const)
  .filter(([, keys]) => keys.length > 0);

const playstyles = Array.isArray(player?.playStyles)
  ? player.playStyles
  : Array.isArray(player?.skill_details) ? player.skill_details : [];

const traits = Array.isArray(player?.trait_details)
  ? player.trait_details
  : Array.isArray(player?.traits)
    ? player.traits.map((name) => ({ name, level: null, plus: false, asset_paths: [] }))
    : [];

const rankBracket = player ? getRankBracket(player.ovr) : null;
const rankCards = RANKS.map((rank, index) => ({
  ...rank,
  icon: RANK_ICONS[rank.value],
  ovr: player ? player.ovr + rank.value : null,
  stepCost: rank.value > 0 && rankBracket ? rankBracket.costs[rank.value - 1] : null,
  state: index === 0 ? 'BASE' : 'RANK ' + rank.value,
}));


const num = (v) => (v === undefined || v === null || v === '' ? null : Number(v));
const statTier = (v) => {
  const n = num(v);
  if (n === null) return 'none';
  if (n >= 90) return 'elite';
  if (n >= 75) return 'high';
  if (n >= 60) return 'mid';
  return 'low';
};
const barWidth = (v) => Math.max(0, Math.min(100, (Number(v ?? 0) / 150) * 100));
const cardTier = player ? (player.ovr >= 120 ? 'icon' : player.ovr >= 114 ? 'elite' : 'base') : 'base';
const tierLabel = { icon: 'ICON TIER', elite: 'ELITE TIER', base: 'PLAYER CARD' }[cardTier];

const coreKeys = [
  ['pace', 'PAC', 'Pace'],
  ['shooting', 'SHO', 'Shooting'],
  ['passing', 'PAS', 'Passing'],
  ['dribbling', 'DRI', 'Dribbling'],
  ['defending', 'DEF', 'Defending'],
  ['physical', 'PHY', 'Physical'],
];
const RADAR_C = 160, RADAR_R = 112;
const radarAngle = (i) => -Math.PI / 2 + (i * Math.PI) / 3;
const radarPoint = (i, scale) => [
  +(RADAR_C + Math.cos(radarAngle(i)) * RADAR_R * scale).toFixed(1),
  +(RADAR_C + Math.sin(radarAngle(i)) * RADAR_R * scale).toFixed(1),
];
const radarRing = (scale) => coreKeys.map((_, i) => radarPoint(i, scale).join(',')).join(' ');
const radarValues = coreKeys.map(([key]) => Math.max(0.04, Math.min(1, Number(baseStats[key] ?? 0) / 150)));
const radarShape = radarValues.map((v, i) => radarPoint(i, v).join(',')).join(' ');
const radarDots = radarValues.map((v, i) => radarPoint(i, v));
const radarLabels = coreKeys.map(([, short], i) => {
  const [x, y] = radarPoint(i, 1.2);
  return { short, x, y: y + 3 };
});
const coreValues = coreKeys.map(([key]) => num(baseStats[key])).filter((v) => v !== null);
const coreAvg = coreValues.length ? Math.round(coreValues.reduce((a, b) => a + b, 0) / coreValues.length) : null;
const bestCore = coreKeys.reduce((best, [key, short, long]) => {
  const v = num(baseStats[key]);
  return v !== null && (!best || v > best.v) ? { v, short, long } : best;
}, null);

let runningRp = 0;
rankCards.forEach((rank) => {
  if (rank.stepCost != null) runningRp += Number(rank.stepCost) || 0;
  rank.cumCost = rank.value === 0 ? 0 : runningRp;
});
const maxRp = runningRp;

const trainingMilestones = [0, 5, 10, 15, 20, 25, 30];

const playerId = String(player?.playerId ?? '');
const playerPosition = String(player?.primary_position || player?.position || '');
const trainingPayload = JSON.stringify(TRAINING_LEVELS);
const fodderPayload = JSON.stringify(FODDER);
const statsPayload = JSON.stringify(baseStats);
const rankPayload = JSON.stringify(rankCards);
const hasPlayer = Boolean(player);
const playerTitle = player ? `${player.name} ${player.ovr ?? ''} OVR | FCMobiletools` : 'Player Database | FCMobiletools';
const playerDescription = player
  ? `View ${player.name} at ${player.ovr} OVR with FC Mobile stats, PlayStyles, traits, rank progression and training tools.`
  : 'FC Mobile player database on FCMobiletools.';
const playerSchema = player ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: player.fullName || player.name,
  url: new URL(`/player/${player.slug}/`, Astro.site ?? new URL('https://fcmobiletools.online')).toString(),
  image: render?.asset_url || undefined,
} : null;
---

<BaseLayout title={playerTitle} description={playerDescription} image={render?.asset_url || undefined}>
  {playerSchema && <script type="application/ld+json" set:html={JSON.stringify(playerSchema)}></script>}

  <main class="player-page" id="player-page" data-tier={cardTier}>
    <div class="ambient" aria-hidden="true"><i class="orb o1"></i><i class="orb o2"></i><i class="grain"></i></div>

    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/players/"><span class="arrow">←</span> Players</a>
        <span class="sep">/</span>
        <span class="current">{player?.event || 'Player Database'}</span>
      </nav>

      {!player ? (
        <section class="not-found">
          <span class="kicker">PLAYER DATABASE</span>
          <h1>Player not found</h1>
          <p>This player is not available in the active catalog.</p>
          <a class="button button-primary" href="/players/">Back to players</a>
        </section>
      ) : (
        <>
          <section class="hero" id="hero">
            <div class="hero-card-column">
              <div class="stage">
                <div class="stage-glow" aria-hidden="true"></div>
                <div class="stage-ring" aria-hidden="true"></div>
                <div class="stage-floor" aria-hidden="true"></div>

                <div class="tilt" id="tilt">
                  <div
                    class="player-card"
                    style={background ? `--card-background:url("${background.asset_url}")` : ''}
                  >
                    <div class="card-bg" data-card-bg></div>
                    <div class="card-vignette"></div>
                    <div class="card-shine" aria-hidden="true"></div>

                    <div class="card-meta">
                      <span>{player.event || 'FC MOBILE'}</span>
                      <span>{player.color_name || 'PLAYER'}</span>
                    </div>

                    <div class="card-rating" data-card-rating>
                      <strong data-card-ovr>{player.ovr ?? '—'}</strong>
                      <span data-card-position>{player.primary_position || player.position || '—'}</span>
                    </div>

                    <img
                      class="card-render"
                      data-card-render
                      src={render?.asset_url || ''}
                      alt={player.name}
                      fetchpriority="high"
                      decoding="async"
                      hidden={!render}
                    />
                    <div class="render-fallback" data-card-fallback aria-hidden="true" hidden={Boolean(render)}>
                      {player.name.slice(0, 2).toUpperCase()}
                    </div>

                    <div class="card-name" data-card-name>
                      <span>{player.name}</span>
                      {player.fullName && player.fullName !== player.name && <small>{player.fullName}</small>}
                    </div>

                    <div class="card-badges" data-card-badges>
                      {flag && <img data-card-flag src={flag.asset_url} alt={player.nation || ''} />}
                      {clubLogo && <img data-card-club src={clubLogo.asset_url} alt={player.club || ''} />}
                      {leagueLogo && <img data-card-league src={leagueLogo.asset_url} alt={player.league || ''} />}
                    </div>

                    {player.alternate_positions?.length > 0 && (
                      <div class="card-alt">{player.alternate_positions.join(' · ')}</div>
                    )}
                  </div>
                </div>
              </div>

              <div class="card-caption">
                <span>FCMOBILETOOLS · {tierLabel}</span>
                <b>{player.ovr} OVR · {player.primary_position || player.position || '—'}</b>
              </div>
            </div>

            <div class="hero-content">
              <div class="hero-badges">
                <span class="live-pill"><i class="status-dot"></i>LIVE DATABASE</span>
                <span class="tier-pill">{tierLabel}</span>
              </div>

              <h1>{player.name}</h1>
              <p class="hero-sub">
                {player.event || 'FC Mobile'} <span>·</span> {player.primary_position || player.position || 'Position'} <span>·</span> {player.club || 'Club not listed'}
              </p>

              <div class="spotlight">
                <div class="spot-ovr">
                  <span>OVERALL</span>
                  <strong data-count={player.ovr} data-live-ovr>{player.ovr}</strong>
                </div>
                <div class="spot-sep"></div>
                <div class="spot-item">
                  <span>CORE AVG</span>
                  <b>{coreAvg ?? '—'}</b>
                </div>
                <div class="spot-item">
                  <span>BEST ATTRIBUTE</span>
                  <b>{bestCore ? `${bestCore.short} ${bestCore.v}` : '—'}</b>
                </div>
                <div class="spot-item">
                  <span>PLAYSTYLES</span>
                  <b>{playstyles.length}</b>
                </div>
              </div>

              <div class="identity-grid">
                <div class="identity-metric">
                  <span>POSITION</span>
                  <strong data-live-position>{player.primary_position || player.position || '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>SKILL MOVES</span>
                  <strong class="stars">{player.skill_moves ? '★'.repeat(Math.min(5, player.skill_moves)) : '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>WEAK FOOT</span>
                  <strong class="stars">{player.weak_foot ? '★'.repeat(Math.min(5, player.weak_foot)) : '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>STRONG FOOT</span>
                  <strong>{player.strong_foot_side || player.preferred_foot || '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>WORK RATE</span>
                  <strong>{player.attack_work_rate || '—'} / {player.defense_work_rate || '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>BUILD</span>
                  <strong>{player.height_cm ? `${player.height_cm} cm` : '—'}{player.weight_kg ? ` · ${player.weight_kg} kg` : ''}</strong>
                </div>
              </div>

              <div class="profile-strip">
                <div>
                  {flag ? <img src={flag.asset_url} alt="" /> : <i></i>}
                  <span><small>NATION</small><b>{player.nation || 'Not listed'}</b></span>
                </div>
                <div>
                  {clubLogo ? <img src={clubLogo.asset_url} alt="" /> : <i></i>}
                  <span><small>CLUB</small><b>{player.club || 'Not listed'}</b></span>
                </div>
                <div>
                  {leagueLogo ? <img src={leagueLogo.asset_url} alt="" /> : <i></i>}
                  <span><small>LEAGUE</small><b>{player.league || 'Not listed'}</b></span>
                </div>
              </div>

              {player.alternate_positions?.length > 0 && (
                <div class="alt-row">
                  <span>ALTERNATE POSITIONS</span>
                  <div>{player.alternate_positions.map((pos) => <b>{pos}</b>)}</div>
                </div>
              )}

              <div class="tool-actions">
                <a class="button button-primary" href={`/rank-up-calculator/?base=${player.ovr}&current=0&target=5`}>
                  <span class="button-icon">↗</span>
                  Rank Up Calculator
                </a>
                <a class="button button-secondary" href="/training-calculator/">
                  <span class="button-icon">XP</span>
                  Training Calculator
                </a>
              </div>
            </div>
          </section>

          <section class="core-section reveal">
            <div class="section-head">
              <div>
                <span class="kicker">PERFORMANCE</span>
                <h2>Core attributes</h2>
              </div>
              <span class="section-note">{Object.keys(baseStats).length} tracked values</span>
            </div>

            <div class="core-grid">
              {coreKeys.map(([key, , label], i) => (
                <article class:list={['core-card', `t-${statTier(baseStats[key])}`, num(baseStats[key]) === null && 'is-empty']} style={`--d:${i * 70}ms`}>
                  <div class="core-top">
                    <span>{label.toUpperCase()}</span>
                    <strong data-count={baseStats[key] ?? ''} data-core-stat={key}>{baseStats[key] ?? '—'}</strong>
                  </div>
                  <div class="progress"><i data-core-bar={key} style={`--w:${barWidth(baseStats[key])}%`}></i></div>
                </article>
              ))}
            </div>
          </section>

          <section class="content-grid">
            <div class="main-column">
              <section class="panel-section reveal">
                <div class="section-head">
                  <div>
                    <span class="kicker">ATTRIBUTES</span>
                    <h2>Detailed stats</h2>
                  </div>
                  <span class="section-note">Base card values</span>
                </div>

                {availableGroups.length ? (
                  <div class="stat-groups">
                    {availableGroups.map(([group, keys]) => (
                      <article class="stat-group">
                        <header>
                          <span>{group}</span>
                          <b>{keys.length} stats</b>
                        </header>
                        <div class="stat-rows">
                          {keys.map((key) => (
                            <div class={`stat-row t-${statTier(baseStats[key])}`}>
                              <span>{labels[key] || key.replaceAll('_', ' ')}</span>
                              <div class="stat-track"><i data-stat-bar={key} style={`--w:${barWidth(baseStats[key])}%`}></i></div>
                              <strong data-stat-value={key}>{baseStats[key]}</strong>
                            </div>
                          ))}
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  <div class="data-empty">No detailed attribute values were supplied for this player.</div>
                )}
              </section>

              <section class="panel-section reveal">
                <div class="section-head">
                  <div>
                    <span class="kicker">PLAYSTYLE</span>
                    <h2>PlayStyles</h2>
                  </div>
                  <span class="section-note"><b id="playstyleCount">{playstyles.length}</b> collected</span>
                </div>

                {playstyles.length ? (
                  <div class="playstyle-grid" id="playstyleGrid">
                    {playstyles.map((item) => {
                      const paths = Array.isArray(item.asset_paths) ? item.asset_paths : [];
                      const level = Number(item.level);
                      const icon = Number.isInteger(level) && level >= 0
                        ? paths[level] || paths[paths.length - 1]
                        : paths[paths.length - 1];
                      return (
                        <article class:list={['ability-card', 'playstyle-card', item.plus && 'is-plus']}>
                          <div class="ability-icon">
                            {icon ? <img src={icon} alt="" loading="lazy" decoding="async" /> : <span>✦</span>}
                          </div>
                          <div class="ability-copy">
                            <span>{item.plus ? 'PLAYSTYLE+' : 'PLAYSTYLE'}</span>
                            <strong>{item.name}</strong>
                            <small>{item.level != null ? `Level ${item.level + 1}` : 'Active style'}</small>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                ) : (
                  <div class="data-empty"><strong>No PlayStyles were returned for this player.</strong><span>The card can still be used with the available core attributes and progression tools.</span></div>
                )}
              </section>

              <section class="panel-section reveal">
                <div class="section-head">
                  <div>
                    <span class="kicker">TRAITS</span>
                    <h2>Player traits</h2>
                  </div>
                  <span class="section-note"><b id="traitCount">{traits.length}</b> collected</span>
                </div>

                {traits.length ? (
                  <div class="traits-grid" id="traitGrid">
                    {traits.map((item) => (
                      <div class="trait"><span>✓</span><b>{item.name}</b></div>
                    ))}
                  </div>
                ) : (
                  <div class="data-empty">No traits were returned for this player.</div>
                )}
              </section>
            </div>

            <aside class="side-column">
              <section class="panel-section skills-panel reveal">
                <div class="section-head">
                  <div><span class="kicker">SKILL POINTS</span><h2>Player skills</h2></div>
                  <span class="section-note"><b id="skillPointsRemaining">0</b> / <b id="skillPointsTotal">0</b></span>
                </div>
                <div id="skillGrid" class="skill-grid"><div class="data-empty">Loading ranked skill data…</div></div>
                <button id="resetSkills" class="reset-skills" type="button">Reset skill allocation</button>
              </section>
              <section class="panel-section shape-panel reveal">
                <div class="section-head">
                  <div>
                    <span class="kicker">PROFILE</span>
                    <h2>Attribute shape</h2>
                  </div>
                </div>

                <svg class="radar" viewBox="-10 -6 340 332" aria-label="Player attribute radar">
                  <defs>
                    <linearGradient id="radarFill" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="var(--accent)" stop-opacity=".48"></stop>
                      <stop offset="1" stop-color="var(--accent-2)" stop-opacity=".12"></stop>
                    </linearGradient>
                  </defs>
                  <polygon class="radar-ring" points={radarRing(1)}></polygon>
                  <polygon class="radar-ring" points={radarRing(0.75)}></polygon>
                  <polygon class="radar-ring" points={radarRing(0.5)}></polygon>
                  <polygon class="radar-ring" points={radarRing(0.25)}></polygon>
                  {coreKeys.map((_, i) => {
                    const [x, y] = radarPoint(i, 1);
                    return <line class="radar-axis" x1={RADAR_C} y1={RADAR_C} x2={x} y2={y}></line>;
                  })}
                  <polygon class="radar-fill" points={radarShape}></polygon>
                  {radarDots.map(([x, y]) => <circle class="radar-dot" cx={x} cy={y} r="3.6"></circle>)}
                  {radarLabels.map((l) => <text x={l.x} y={l.y}>{l.short}</text>)}
                </svg>

                <div class="shape-legend">
                  {coreKeys.map(([key, short]) => (
                    <span class={`t-${statTier(baseStats[key])}`}><em>{short}</em><b>{baseStats[key] ?? '—'}</b></span>
                  ))}
                </div>
              </section>

              <section class="panel-section progression-panel reveal">
                <div class="section-head">
                  <div>
                    <span class="kicker">PROGRESSION</span>
                    <h2>Rank Up</h2>
                  </div>
                  <span class="section-note">+1 OVR / rank</span>
                </div>

                <div class="rank-path" id="rankPath">
                  {rankCards.map((rank) => (
                    <button class:list={['rank-tile', rank.value === 0 && 'selected']} type="button" data-rank={rank.value} aria-pressed={rank.value === 0 ? 'true' : 'false'}>
                      <img src={rank.icon} alt="" loading="lazy" />
                      <span>{rank.name}</span>
                      <strong>{rank.ovr}</strong>
                      {rank.stepCost != null ? <small>{rank.stepCost} RP</small> : <small>BASE</small>}
                    </button>
                  ))}
                </div>

                <div class="rank-readout">
                  <div>
                    <span>SELECTED RANK</span>
                    <strong id="selectedRank">Base</strong>
                  </div>
                  <div class="rr-mid">
                    <span>TOTAL RP</span>
                    <strong id="selectedRp">0</strong>
                  </div>
                  <b><em id="selectedOvr">{player.ovr}</em><small>OVR</small></b>
                </div>
                {maxRp > 0 && <div class="rank-meter"><i id="rankMeter" style="--w:0%"></i></div>}

                <a class="wide-link" href={`/rank-up-calculator/?base=${player.ovr}&current=0&target=5`}>
                  Open full Rank Up Calculator <span>→</span>
                </a>
              </section>

              <section class="panel-section training-panel reveal">
                <div class="section-head">
                  <div><span class="kicker">TRAINING</span><h2>Training level</h2></div>
                  <span class="section-note">0–30</span>
                </div>
                <label class="training-select">
                  <span>SELECT LEVEL</span>
                  <select id="trainingLevel">
                    {Array.from({ length: MAX_TRAINING_LEVEL + 1 }, (_, level) => <option value={level}>Level {level}</option>)}
                  </select>
                </label>
                <div class="training-summary">
                  <div><span>LEVEL</span><strong id="trainingLevelValue">0</strong></div>
                  <div><span>XP NEEDED</span><strong id="trainingXp">0</strong></div>
                  <div><span>CARDS</span><strong id="trainingCards">0</strong></div>
                </div>
                <div class="training-boost-list" id="trainingBoosts">
                  <span>Choose a training level to preview position-specific boosts.</span>
                </div>
                <a class="wide-link" href="/training-calculator/">Open Training Calculator <span>→</span></a>
              </section>            </aside>
          </section>
        </>
      )}
    </div>

    {hasPlayer && (
      <div class="dock" id="dock" aria-hidden="true">
        <div class="dock-id">
          <b>{player.ovr}</b>
          <span><strong>{player.name}</strong><small>{player.primary_position || player.position || ''}{player.event ? ` · ${player.event}` : ''}</small></span>
        </div>
        <a class="dock-btn" href={`/rank-up-calculator/?base=${player.ovr}&current=0&target=5`} tabindex="-1">Rank Up</a>
        <a class="dock-btn ghost" href="/training-calculator/" tabindex="-1">Training</a>
      </div>
    )}
  </main>

  {hasPlayer && (
    <script define:vars={{ rankPayload, statsPayload, playerId, playerPosition, trainingPayload, fodderPayload }}>
      const ranks = JSON.parse(rankPayload);
      const initialStats = JSON.parse(statsPayload);
      const trainingLevels = JSON.parse(trainingPayload);
      const fodder = JSON.parse(fodderPayload);
      const playerApiId = String(playerId || '');
      const basePosition = String(playerPosition || '');
      const maxRp = Math.max(0, ...ranks.map((r) => Number(r.cumCost) || 0));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const state = {
        record: { playerId: playerApiId, ovr: Number(ranks[0]?.ovr || 0), primary_position: basePosition, position: basePosition, stats: initialStats },
        rank: 0,
        training: 0,
        trainingBoosts: {},
        skills: [],
        skillBoosts: {},
        allocations: {},
        budget: 0
      };

      document.documentElement.classList.add('js');

      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));
      const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (m) => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
      }[m]));
      const num = (value) => {
        const n = Number(value);
        return Number.isFinite(n) ? n : 0;
      };
      const fmt = (value) => num(value).toLocaleString();

      const rankIcon = (rank) => ({
        0:'/assets/images/rankup/rankicon_25_RANK0.png',
        1:'/assets/images/rankup/rankicon_25_RANK1.png',
        2:'/assets/images/rankup/rankicon_25_RANK2.png',
        3:'/assets/images/rankup/rankicon_25_RANK3.png',
        4:'/assets/images/rankup/rankicon_25_RANK4.png',
        5:'/assets/images/rankup/rankicon_25_RANK5.png'
      })[rank] || '';

      const getBoost = (boosts, key) => {
        if (!boosts || typeof boosts !== 'object') return 0;
        const target = String(key).toLowerCase().replace(/[_\-\s]/g, '');
        for (const pair of Object.entries(boosts)) {
          const normalized = String(pair[0]).replace(/^boost_/i, '').toLowerCase().replace(/[_\-\s]/g, '');
          if (normalized === target) return num(pair[1]);
        }
        return 0;
      };

      function skillId(skill) {
        return String(skill?.id ?? skill?.skill_id ?? skill?.skillId ?? '').trim();
      }

      function skillName(skill) {
        return String(skill?.name ?? skill?.skill_name ?? skill?.skillName ?? '').trim();
      }

      function skillImage(skill) {
        return String(skill?.image ?? skill?.skill_image ?? skill?.skillImage ?? '').trim();
      }

      function skillMaxLevel(skill) {
        const id = skillId(skill);
        const rows = state.skillBoosts[id];
        if (!Array.isArray(rows) || !rows.length) return 1;
        return Math.max(1, ...rows.map((row) => num(row?.level_number ?? row?.levelNumber)));
      }

      function isSkillUnlocked(skill) {
        if (skill?.locked === true) return false;
        const type = String(skill?.unlock_requirement_type || '').toLowerCase();
        const requiredName = String(skill?.unlock_requirement_skillname || '').trim();
        const requiredLevel = Math.max(1, num(skill?.unlock_requirement_level));
        if (type !== 'skill_level' || !requiredName) return true;

        const prereqId = String(skill?.prerequisite_skill_id || '').trim();
        if (prereqId) return num(state.allocations[prereqId]) >= requiredLevel;

        const prereq = state.skills.find((candidate) => skillName(candidate).toUpperCase() === requiredName.toUpperCase());
        return prereq ? num(state.allocations[skillId(prereq)]) >= requiredLevel : false;
      }

      function aggregateSkillBoosts() {
        const totals = {};
        Object.entries(state.allocations).forEach(([id, level]) => {
          const rows = state.skillBoosts[id];
          if (!Array.isArray(rows)) return;
          const row = rows.find((item) => num(item?.level_number ?? item?.levelNumber) === num(level));
          if (!row) return;
          Object.entries(row).forEach(([key, value]) => {
            if (!String(key).startsWith('boost_') || !num(value)) return;
            const stat = String(key).slice(6);
            totals[stat] = (totals[stat] || 0) + num(value);
          });
        });
        return totals;
      }

      function effectiveStats() {
        const base = state.record?.stats || {};
        const skillBoosts = aggregateSkillBoosts();
        return new Proxy(base, {
          get(source, key) {
            if (typeof key !== 'string') return source[key];
            return num(source[key]) + getBoost(state.trainingBoosts, key) + num(skillBoosts[key]);
          }
        });
      }

      function assetUrl(record, type) {
        const found = Array.isArray(record?.images)
          ? record.images.find((item) => item.asset_type === type)
          : null;
        return String(
          type === 'player_render' ? record?.playerImage
          : type === 'card_background' ? record?.cardBackground
          : type === 'nation_flag' ? record?.nationFlag
          : type === 'club_logo' ? record?.clubLogo
          : type === 'league_logo' ? record?.leagueImage
          : found?.asset_url || ''
        ).trim();
      }

      function updateCard() {
        const record = state.record || {};
        const card = $('.player-card');
        if (!card) return;

        const background = assetUrl(record, 'card_background');
        card.style.setProperty('--card-background', background ? 'url("' + background.replace(/"/g, '\\"') + '")' : 'none');

        const render = $('[data-card-render]');
        const fallback = $('[data-card-fallback]');
        if (render) {
          if (record.playerImage) {
            render.src = record.playerImage;
            render.hidden = false;
            if (fallback) fallback.hidden = true;
          } else {
            render.hidden = true;
            if (fallback) fallback.hidden = false;
          }
        }

        const ovr = $('[data-card-ovr]');
        if (ovr) ovr.textContent = record.ovr ?? '—';

        const pos = $('[data-card-position]');
        if (pos) pos.textContent = record.primary_position || record.position || '—';

        const name = $('[data-card-name] > span');
        if (name) name.textContent = record.name || '';

        const mainOvr = $('[data-live-ovr]');
        if (mainOvr) mainOvr.textContent = record.ovr ?? '—';

        const livePosition = $('[data-live-position]');
        if (livePosition) livePosition.textContent = record.primary_position || record.position || '—';

        const badgesBox = $('[data-card-badges]');
        if (badgesBox) {
          const badgeRows = [
            ['nation_flag', record.nation || ''],
            ['club_logo', record.club || ''],
            ['league_logo', record.league || '']
          ];
          badgesBox.innerHTML = badgeRows.map(([type, label]) => {
            const url = assetUrl(record, type);
            return url ? '<img src="' + esc(url) + '" alt="' + esc(label) + '" loading="lazy" decoding="async">' : '';
          }).join('');
          badgesBox.hidden = !badgesBox.children.length;
        }

        const caption = $('.card-caption b');
        if (caption) caption.textContent = (record.ovr || '—') + ' OVR · ' + (record.primary_position || record.position || '—');

        const dockOvr = $('.dock-id > b');
        const dockName = $('.dock-id strong');
        if (dockOvr) dockOvr.textContent = record.ovr || '—';
        if (dockName) dockName.textContent = record.name || '';
      }

      function renderStats() {
        const stats = effectiveStats();
        const core = ['pace','shooting','passing','dribbling','defending','physical'];

        core.forEach((key) => {
          const value = Math.round(num(stats[key]));
          const node = $('[data-count="' + key + '"]');
          const fallback = document.querySelector('[data-core-value="' + key + '"]');
          const strong = document.querySelector('.core-card [data-core-stat="' + key + '"]');
          const any = strong || fallback || null;
          if (any) any.textContent = value || '—';
          $$('[data-core-stat="' + key + '"]').forEach((item) => { item.textContent = value || '—'; });
          $$('[data-core-bar="' + key + '"]').forEach((item) => { item.style.setProperty('--w', Math.min(100, value / 1.5) + '%'); });
          $$('[data-shape-stat="' + key + '"]').forEach((item) => { item.textContent = value || '—'; });
        });

        $$('[data-stat-value]').forEach((node) => {
          const key = node.getAttribute('data-stat-value');
          const value = Math.round(num(stats[key]));
          node.textContent = value || '—';
          const bar = $('[data-stat-bar="' + key + '"]');
          if (bar) bar.style.setProperty('--w', Math.min(100, value / 1.5) + '%');
        });

        const coreValues = core.map((key) => num(stats[key]));
        const values = coreValues.map((value) => Math.max(0.04, Math.min(1, value / 150)));
        const angles = core.map((_, index) => -Math.PI / 2 + index * Math.PI / 3);
        const points = values.map((value, index) => {
          return (160 + Math.cos(angles[index]) * 112 * value) + ',' + (160 + Math.sin(angles[index]) * 112 * value);
        }).join(' ');
        const radar = $('.radar-fill');
        if (radar) radar.setAttribute('points', points);

        const stateLabel = $('#statStateLabel');
        if (stateLabel) {
          const stateParts = [];
          if (state.rank) stateParts.push('R' + state.rank);
          if (state.training) stateParts.push('T' + state.training);
          stateLabel.textContent = stateParts.length ? stateParts.join(' · ') : 'BASE';
        }
      }

      function renderRankState() {
        $$('[data-rank]').forEach((button) => {
          const value = num(button.dataset.rank);
          button.classList.toggle('selected', value === state.rank);
          button.setAttribute('aria-pressed', value === state.rank ? 'true' : 'false');
        });

        const selected = ranks.find((item) => num(item.value) === state.rank);
        $('#selectedRank').textContent = selected?.name || 'Base';
        $('#selectedRp').textContent = num(selected?.cumCost).toLocaleString();
        $('#selectedOvr').textContent = state.record?.ovr ?? selected?.ovr ?? '—';

        const meter = $('#rankMeter');
        if (meter && maxRp) meter.style.setProperty('--w', (num(selected?.cumCost) / maxRp) * 100 + '%');

        const icon = $('.card-rank-badge img');
        const badge = $('.card-rank-badge');
        if (icon && badge) {
          if (state.rank > 0) {
            badge.hidden = false;
            icon.src = rankIcon(state.rank);
          } else {
            badge.hidden = true;
          }
        }
      }

      function renderTraining() {
        $('#trainingLevelValue').textContent = state.training;
        const requiredXp = Math.max(0, num(trainingLevels[state.training]) - num(trainingLevels[0]));
        const bestFodder = fodder[fodder.length - 1] || { xp: 0 };
        $('#trainingXp').textContent = fmt(requiredXp);
        $('#trainingCards').textContent = bestFodder.xp ? Math.ceil(requiredXp / num(bestFodder.xp)).toLocaleString() : '—';
        const box = $('#trainingBoosts');

        if (!state.training) {
          box.innerHTML = '<span>Choose a training level to preview position-specific boosts.</span>';
          return;
        }

        const boosts = Object.entries(state.trainingBoosts || {})
          .filter(([key, value]) => String(key).startsWith('boost_') && num(value))
          .map(([key, value]) => '<b>+' + num(value) + ' ' + esc(String(key).slice(6).replace(/_/g, ' ')) + '</b>');

        box.innerHTML = boosts.length
          ? boosts.slice(0, 10).join('')
          : '<span>No position-specific boost data returned for this level.</span>';
      }

      function updateSkillBudget() {
        const spent = Object.values(state.allocations).reduce((sum, value) => sum + num(value), 0);
        const remaining = Math.max(0, state.budget - spent);
        $('#skillPointsTotal').textContent = state.budget;
        $('#skillPointsRemaining').textContent = remaining;
        return { spent, remaining };
      }

      function renderSkills() {
        const grid = $('#skillGrid');
        if (!grid) return;

        if (!state.skills.length) {
          grid.innerHTML = '<div class="data-empty">No ranked skill data was returned for this player.</div>';
          updateSkillBudget();
          return;
        }

        grid.innerHTML = state.skills.map((skill) => {
          const id = skillId(skill);
          const name = skillName(skill) || 'Skill';
          const image = skillImage(skill);
          const unlocked = isSkillUnlocked(skill);
          const current = num(state.allocations[id]);
          const max = skillMaxLevel(skill);
          const message = unlocked
            ? (current ? 'Level ' + current + ' active' : 'Allocate a point')
            : (skill.unlock_requirement_text || ('Requires ' + (skill.unlock_requirement_skillname || 'another skill') + ' Level ' + Math.max(1, num(skill.unlock_requirement_level))));

          return '<article class="skill-card ' + (unlocked ? '' : 'locked') + '">'
            + '<div class="skill-main">'
            + '<div class="skill-icon">' + (image ? '<img src="' + esc(image) + '" alt="" loading="lazy">' : '<span>✦</span>') + '</div>'
            + '<div class="skill-copy"><small>' + (unlocked ? 'SKILL' : 'LOCKED') + '</small><strong>' + esc(name) + '</strong><span>' + esc(message) + '</span></div>'
            + '</div>'
            + '<div class="skill-controls">'
            + '<button type="button" class="skill-step" data-skill="' + esc(id) + '" data-dir="-1" ' + (!current ? 'disabled' : '') + '>−</button>'
            + '<b>Lv ' + current + '/' + max + '</b>'
            + '<button type="button" class="skill-step" data-skill="' + esc(id) + '" data-dir="1" ' + (!unlocked || current >= max || !id ? 'disabled' : '') + '>+</button>'
            + '</div>'
            + '</article>';
        }).join('');

        $$('.skill-step', grid).forEach((button) => {
          button.addEventListener('click', () => {
            const id = String(button.dataset.skill || '');
            const skill = state.skills.find((item) => skillId(item) === id);
            if (!skill) return;

            const current = num(state.allocations[id]);
            const direction = num(button.dataset.dir);
            const max = skillMaxLevel(skill);

            if (direction > 0) {
              const spent = Object.values(state.allocations).reduce((sum, value) => sum + num(value), 0);
              if (spent + 1 > state.budget || !isSkillUnlocked(skill) || current >= max) return;
              state.allocations[id] = current + 1;
            } else {
              if (current <= 0) return;
              if (current === 1) delete state.allocations[id];
              else state.allocations[id] = current - 1;
            }

            renderSkills();
            renderStats();
          });
        });

        updateSkillBudget();
      }

      function renderPlaystyles(items) {
        const grid = $('#playstyleGrid');
        const count = $('#playstyleCount');
        if (!grid) return;

        const list = Array.isArray(items) ? items : [];
        if (count) count.textContent = String(list.length);

        if (!list.length) {
          grid.innerHTML = '<div class="data-empty"><strong>No PlayStyles were returned for this player.</strong><span>The live player feed did not include PlayStyle records.</span></div>';
          return;
        }

        grid.innerHTML = list.map((item) => {
          const paths = Array.isArray(item.asset_paths) ? item.asset_paths : [];
          const level = num(item.level);
          const icon = item.image || paths[level] || paths[paths.length - 1] || '';
          return '<article class="ability-card playstyle-card ' + (item.plus ? 'is-plus' : '') + '">'
            + '<div class="ability-icon">' + (icon ? '<img src="' + esc(icon) + '" alt="" loading="lazy">' : '<span>✦</span>') + '</div>'
            + '<div class="ability-copy"><span>' + (item.plus ? 'PLAYSTYLE+' : 'PLAYSTYLE') + '</span><strong>' + esc(item.name || 'PlayStyle') + '</strong><small>' + (item.level != null ? 'Level ' + (num(item.level) + 1) : 'Active style') + '</small></div>'
            + '</article>';
        }).join('');
      }

      function renderTraits(items) {
        const grid = $('#traitGrid');
        const count = $('#traitCount');
        const list = Array.isArray(items) ? items : [];
        if (count) count.textContent = String(list.length);
        if (!grid) return;

        grid.innerHTML = list.length
          ? list.map((item) => '<div class="trait"><span>✓</span><b>' + esc(item.name || item) + '</b></div>').join('')
          : '<div class="data-empty">No traits were returned for this player.</div>';
      }

      async function apiJson(url) {
        const response = await fetch(url, {
          headers: { Accept: 'application/json' },
          cache: 'no-store'
        });
        if (!response.ok) throw new Error('Request failed (' + response.status + ')');
        return response.json();
      }

      async function loadSkillBoosts() {
        const ids = state.skills.map(skillId).filter(Boolean);
        const missing = ids.filter((id) => !Array.isArray(state.skillBoosts[id]));
        if (!missing.length) return;

        const rows = await Promise.all(missing.map(async (id) => {
          try {
            const payload = await apiJson('/api/skill-boosts/' + encodeURIComponent(id));
            return [id, Array.isArray(payload.boosts) ? payload.boosts : []];
          } catch {
            return [id, []];
          }
        }));
        rows.forEach((entry) => { state.skillBoosts[entry[0]] = entry[1]; });
      }

      async function loadRankData(nextRank) {
        const rank = Math.max(0, Math.min(5, num(nextRank)));
        state.rank = rank;
        state.training = 0;
        state.trainingBoosts = {};
        state.allocations = {};

        renderRankState();
        renderTraining();

        try {
          const payload = await apiJson('/api/players/' + encodeURIComponent(playerApiId) + '?rank=' + rank);
          state.record = payload?.playerId ? payload : (payload?.player && typeof payload.player === 'object' ? payload.player : state.record);
          if (payload?.playerId) {
            state.record.primary_position = payload.primary_position || payload.position || basePosition;
            state.record.position = payload.position || state.record.primary_position;
          }

          state.budget = num(payload?.available_skill_points);
          if (!state.budget) state.budget = rank;

          renderRankState();
          renderTraining();
          updateCard();

          state.skills = Array.isArray(payload?.skills) ? payload.skills : [];
          state.skillBoosts = {};
          renderSkills();
          const livePlaystyles = Array.isArray(payload?.playstyles) ? payload.playstyles : (Array.isArray(payload?.playStyles) ? payload.playStyles : []);
          const liveTraits = Array.isArray(payload?.trait_details) ? payload.trait_details : (Array.isArray(payload?.traits) ? payload.traits.map((name) => ({ name })) : []);
          if (livePlaystyles.length || rank > 0) renderPlaystyles(livePlaystyles);
          if (liveTraits.length || rank > 0) renderTraits(liveTraits);

          await loadSkillBoosts();
          renderSkills();
          renderStats();

          const rankStatus = $('#selectedRank');
          if (rankStatus) rankStatus.textContent = rank ? 'Rank ' + rank : 'Base';
        } catch (error) {
          console.error('[player-detail] ranked player load failed', error);
          state.rank = 0;
          state.training = 0;
          state.trainingBoosts = {};
          state.record = { playerId: playerApiId, ovr: Number(ranks[0]?.ovr || 0), primary_position: basePosition, position: basePosition, stats: initialStats };
          state.budget = 0;
          renderRankState();
          renderTraining();
          updateCard();
          renderStats();
          renderSkills();
        }
      }

      async function setTraining(level) {
        state.training = Math.max(0, Math.min(30, num(level)));
        state.trainingBoosts = {};
        renderTraining();
        renderStats();

        if (!state.training) return;

        const position = String(state.record?.primary_position || state.record?.position || basePosition);
        if (!position) return;

        try {
          state.trainingBoosts = await apiJson('/api/training/boosts?position=' + encodeURIComponent(position) + '&level=' + state.training).then((payload) => (
            payload?.boosts && typeof payload.boosts === 'object' ? payload.boosts : {}
          ));
        } catch (error) {
          console.error('[player-detail] training boost load failed', error);
          state.trainingBoosts = {};
        }

        renderTraining();
        renderStats();
      }

      $$('[data-rank]').forEach((button) => {
        button.addEventListener('click', () => loadRankData(button.dataset.rank));
      });

      $('#trainingLevel')?.addEventListener('change', (event) => setTraining(event.target.value));

      $('#resetSkills')?.addEventListener('click', () => {
        state.allocations = {};
        renderSkills();
        renderStats();
      });

      // Initial state.
      updateSkillBudget();
      renderRankState();
      renderTraining();
      updateCard();
      renderStats();

      /* reveal on scroll + bar fill + count up */
      const countUp = (el) => {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target) || reduceMotion) return;
        const start = performance.now();
        const duration = 850;
        const tick = (now) => {
          const progress = Math.min(1, (now - start) / duration);
          el.textContent = Math.round(target * (1 - Math.pow(1 - progress, 3)));
          if (progress < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          entry.target.querySelectorAll('[data-count]').forEach(countUp);
          io.unobserve(entry.target);
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal').forEach((element) => io.observe(element));
      document.querySelectorAll('.hero [data-count]').forEach(countUp);
      requestAnimationFrame(() => document.querySelector('.hero')?.classList.add('in'));

      /* 3D tilt */
      const tilt = document.getElementById('tilt');
      if (tilt && !reduceMotion && window.matchMedia('(hover: hover)').matches) {
        const stage = tilt.closest('.stage');
        stage.addEventListener('pointermove', (event) => {
          const rect = tilt.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          tilt.style.setProperty('--rx', (-y * 9).toFixed(2) + 'deg');
          tilt.style.setProperty('--ry', (x * 11).toFixed(2) + 'deg');
          tilt.style.setProperty('--mx', ((x + 0.5) * 100).toFixed(1) + '%');
          tilt.style.setProperty('--my', ((y + 0.5) * 100).toFixed(1) + '%');
          tilt.classList.add('is-active');
        });
        stage.addEventListener('pointerleave', () => {
          tilt.style.setProperty('--rx', '0deg');
          tilt.style.setProperty('--ry', '0deg');
          tilt.classList.remove('is-active');
        });
      }

      
/* floating dock */
      const dock = document.getElementById('dock');
      const hero = document.getElementById('hero');
      const body = document.querySelector('.content-grid');
      if (dock && hero && body) {
        let heroInView = true;
        let bodyInView = false;
        const syncDock = () => {
          const show = !heroInView && bodyInView;
          dock.classList.toggle('show', show);
          dock.setAttribute('aria-hidden', show ? 'false' : 'true');
          dock.querySelectorAll('a').forEach((anchor) => { anchor.tabIndex = show ? 0 : -1; });
        };
        new IntersectionObserver(([entry]) => { heroInView = entry.isIntersecting; syncDock(); }, { rootMargin: '-80px 0px 0px 0px' }).observe(hero);
        new IntersectionObserver(([entry]) => { bodyInView = entry.isIntersecting; syncDock(); }, { rootMargin: '0px 0px -120px 0px' }).observe(body);
      }

      // Hydrate the initial player detail data once so PlayStyles and rank skills are live.
      loadRankData(0);
    </script>
  )}
</BaseLayout>

<style>
.player-page{
  --bg:#060d15;
  --deep:#04090f;
  --surface:rgba(16,28,41,.72);
