---
import BaseLayout from '../../layouts/BaseLayout.astro';
import topPlayerIds from '../../data/top-players.json';
import { RANKS, getRankBracket } from '../../data/fcMobileRankUp.js';
import { TRAINING_LEVELS, FODDER, MAX_TRAINING_LEVEL } from '../../data/fcMobileTraining.js';
import {
  buildZenithPlayerSlug,
  fetchZenithPlayerBySlug,
  fetchZenithPlayersByIds,
} from '../../lib/zenithPlayerApi.js';

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png',
};

export async function getStaticPaths() {
  const prerenderLimit = Math.min(
    10000,
    Math.max(1, Number(globalThis.process?.env?.TOP_PLAYERS_PRERENDER_LIMIT || 10000))
  );
  const ids = topPlayerIds.map(String).slice(0, prerenderLimit);
  const players = await fetchZenithPlayersByIds(ids, { rank: 0, chunkSize: 100 });
  const paths = [];
  const seen = new Set();

  for (const player of players) {
    const slug = buildZenithPlayerSlug(player);
    if (!slug || seen.has(slug)) continue;
    seen.add(slug);
    paths.push({ params: { slug }, props: { player } });
  }

  console.log('[player-pages] generated static paths:', paths.length);
  return paths;
}

const slug = Astro.params.slug ?? '';
let player = Astro.props.player ?? null;

if (!player) player = await fetchZenithPlayerBySlug(slug, 0);

const assets = Array.isArray(player?.images) ? player.images : [];

const getAsset = (...types) => {
  for (const type of types) {
    const match =
      assets.find((item) => item.asset_type === type && item.is_primary) ??
      assets.find((item) => item.asset_type === type);
    if (match) return match;
  }
  return null;
};

const render = getAsset('player_render');
const background = getAsset('card_background');
const flag = getAsset('nation_flag');
const clubLogo = getAsset('club_logo', 'club_badge');
const leagueLogo = getAsset('league_logo');

const baseStats = player?.stats ?? {};
const statGroups = [
  ['Pace', ['acceleration', 'sprint_speed']],
  ['Shooting', ['finishing', 'positioning', 'shot_power', 'long_shot', 'volleys', 'volley', 'penalties']],
  ['Passing', ['short_passing', 'long_passing', 'vision', 'crossing', 'curve', 'free_kick']],
  ['Dribbling', ['dribbling_head', 'agility', 'balance', 'reactions', 'ball_control']],
  ['Defending', ['marking', 'standing_tackle', 'sliding_tackle', 'awareness', 'heading']],
  ['Physical', ['strength', 'aggression', 'jumping', 'stamina_stat']],
  ['Goalkeeping', ['diving', 'gk_diving', 'handling', 'gk_handling', 'kicking', 'gk_kicking', 'reflexes', 'gk_reflexes', 'gk_positioning']],
];

const labels = {
  acceleration: 'Acceleration',
  sprint_speed: 'Sprint Speed',
  finishing: 'Finishing',
  positioning: 'Positioning',
  shot_power: 'Shot Power',
  long_shot: 'Long Shot',
  volleys: 'Volleys',
  volley: 'Volley',
  penalties: 'Penalties',
  short_passing: 'Short Passing',
  long_passing: 'Long Passing',
  vision: 'Vision',
  crossing: 'Crossing',
  curve: 'Curve',
  free_kick: 'Free Kick',
  dribbling_head: 'Dribbling',
  agility: 'Agility',
  balance: 'Balance',
  reactions: 'Reactions',
  ball_control: 'Ball Control',
  marking: 'Marking',
  standing_tackle: 'Standing Tackle',
  sliding_tackle: 'Sliding Tackle',
  awareness: 'Defensive Awareness',
  heading: 'Heading',
  strength: 'Strength',
  aggression: 'Aggression',
  jumping: 'Jumping',
  stamina_stat: 'Stamina',
  diving: 'Diving',
  gk_diving: 'Diving',
  handling: 'Handling',
  gk_handling: 'Handling',
  kicking: 'Kicking',
  gk_kicking: 'Kicking',
  reflexes: 'Reflexes',
  gk_reflexes: 'Reflexes',
  gk_positioning: 'Positioning',
};

const availableGroups = statGroups
  .map(([name, keys]) => [name, keys.filter((key) => baseStats[key] !== undefined && baseStats[key] !== null)] as const)
  .filter(([, keys]) => keys.length > 0);

const playstyles = Array.isArray(player?.playStyles)
  ? player.playStyles
  : Array.isArray(player?.skill_details) ? player.skill_details : [];

const traits = Array.isArray(player?.trait_details)
  ? player.trait_details
  : Array.isArray(player?.traits)
    ? player.traits.map((name) => ({ name, level: null, plus: false, asset_paths: [] }))
    : [];

const rankBracket = player ? getRankBracket(player.ovr) : null;
const rankCards = RANKS.map((rank, index) => ({
  ...rank,
  icon: RANK_ICONS[rank.value],
  ovr: player ? player.ovr + rank.value : null,
  stepCost: rank.value > 0 && rankBracket ? rankBracket.costs[rank.value - 1] : null,
  state: index === 0 ? 'BASE' : 'RANK ' + rank.value,
}));

const trainingMilestones = [0, 5, 10, 15, 20, 25, 30];

const statsPayload = JSON.stringify(baseStats);
const rankPayload = JSON.stringify(rankCards);
const hasPlayer = Boolean(player);
const playerTitle = player ? `${player.name} ${player.ovr ?? ''} OVR | FCMobiletools` : 'Player Database | FCMobiletools';
const playerDescription = player
  ? `View ${player.name} at ${player.ovr} OVR with FC Mobile stats, PlayStyles, traits, rank progression and training tools.`
  : 'FC Mobile player database on FCMobiletools.';
const playerSchema = player ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: player.fullName || player.name,
  url: new URL(`/player/${player.slug}/`, Astro.site ?? new URL('https://fcmobiletools.online')).toString(),
  image: render?.asset_url || undefined,
} : null;
---

<BaseLayout title={playerTitle} description={playerDescription} image={render?.asset_url || undefined}>
  {playerSchema && <script type="application/ld+json" set:html={JSON.stringify(playerSchema)}></script>}

  <main class="player-page" id="player-page">
    <div class="shell">
      <div class="crumbs">
        <a href="/players/">Players</a>
        <span>/</span>
        <span>{player?.event || 'Player Database'}</span>
      </div>

      {!player ? (
        <section class="not-found">
          <span class="kicker">PLAYER DATABASE</span>
          <h1>Player not found</h1>
          <p>This player is not available in the active catalog.</p>
          <a class="button button-primary" href="/players/">Back to players</a>
        </section>
      ) : (
        <>
          <section class="hero">
            <div class="hero-card-column">
              <div
                class="player-card"
                style={background ? `--card-background:url("${background.asset_url}")` : ''}
              >
                <div class="card-bg"></div>
                <div class="card-vignette"></div>
                <div class="card-grid"></div>

                <div class="card-meta">
                  <span>{player.event || 'FC MOBILE'}</span>
                  <span>{player.color_name || 'PLAYER'}</span>
                </div>

                <div class="card-rating">
                  <strong>{player.ovr ?? '—'}</strong>
                  <span>{player.primary_position || player.position || '—'}</span>
                </div>

                {render ? (
                  <img class="card-render" src={render.asset_url} alt={player.name} fetchpriority="high" decoding="async" />
                ) : (
                  <div class="render-fallback" aria-hidden="true">{player.name.slice(0, 2).toUpperCase()}</div>
                )}

                <div class="card-name">
                  <span>{player.name}</span>
                  {player.fullName && player.fullName !== player.name && <small>{player.fullName}</small>}
                </div>

                <div class="card-badges">
                  {flag && <img src={flag.asset_url} alt={player.nation || ''} />}
                  {clubLogo && <img src={clubLogo.asset_url} alt={player.club || ''} />}
                  {leagueLogo && <img src={leagueLogo.asset_url} alt={player.league || ''} />}
                </div>

                {player.alternate_positions?.length > 0 && (
                  <div class="card-alt">{player.alternate_positions.join(' · ')}</div>
                )}
              </div>

              <div class="card-caption">
                <span>FCMOBILETOOLS PLAYER CARD</span>
                <b>{player.ovr} OVR · {player.primary_position || player.position || '—'}</b>
              </div>
            </div>

            <div class="hero-content">
              <div class="hero-kicker">
                <span class="status-dot"></span>
                LIVE PLAYER DATABASE
              </div>
              <h1>{player.name}</h1>
              <p class="hero-sub">
                {player.event || 'FC Mobile'} <span>·</span> {player.primary_position || player.position || 'Position'} <span>·</span> {player.club || 'Club not listed'}
              </p>

              <div class="identity-grid">
                <div class="identity-metric featured">
                  <span>OVR</span>
                  <strong>{player.ovr}</strong>
                </div>
                <div class="identity-metric">
                  <span>POSITION</span>
                  <strong>{player.primary_position || player.position || '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>EVENT</span>
                  <strong>{player.event || '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>SKILL MOVES</span>
                  <strong>{player.skill_moves ? `${player.skill_moves}★` : '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>WEAK FOOT</span>
                  <strong>{player.weak_foot ? `${player.weak_foot}★` : '—'}</strong>
                </div>
                <div class="identity-metric">
                  <span>STRONG FOOT</span>
                  <strong>{player.strong_foot_side || player.preferred_foot || '—'}</strong>
                </div>
              </div>

              <div class="profile-strip">
                <div>
                  {flag ? <img src={flag.asset_url} alt="" /> : <i></i>}
                  <span><small>NATION</small><b>{player.nation || 'Not listed'}</b></span>
                </div>
                <div>
                  {clubLogo ? <img src={clubLogo.asset_url} alt="" /> : <i></i>}
                  <span><small>CLUB</small><b>{player.club || 'Not listed'}</b></span>
                </div>
                <div>
                  {leagueLogo ? <img src={leagueLogo.asset_url} alt="" /> : <i></i>}
                  <span><small>LEAGUE</small><b>{player.league || 'Not listed'}</b></span>
                </div>
              </div>

              <div class="body-facts">
                <div><span>WORK RATE</span><b>{player.attack_work_rate || '—'} / {player.defense_work_rate || '—'}</b></div>
                <div><span>HEIGHT</span><b>{player.height_cm ? `${player.height_cm} cm` : '—'}</b></div>
                <div><span>WEIGHT</span><b>{player.weight_kg ? `${player.weight_kg} kg` : '—'}</b></div>
                <div><span>ALT POSITIONS</span><b>{player.alternate_positions?.join(', ') || '—'}</b></div>
              </div>

              <div class="tool-actions">
                <a class="button button-primary" href={`/rank-up-calculator/?base=${player.ovr}&current=0&target=5`}>
                  <span class="button-icon">↗</span>
                  Rank Up Calculator
                </a>
                <a class="button button-secondary" href="/training-calculator/">
                  <span class="button-icon">XP</span>
                  Training Calculator
                </a>
              </div>
            </div>
          </section>

          <section class="core-section">
            <div class="section-head">
              <div>
                <span class="kicker">PERFORMANCE</span>
                <h2>Core attributes</h2>
              </div>
              <span class="section-note">{Object.keys(baseStats).length} tracked values</span>
            </div>

            <div class="core-grid">
              {[
                ['pace', 'PACE'],
                ['shooting', 'SHOOTING'],
                ['passing', 'PASSING'],
                ['dribbling', 'DRIBBLING'],
                ['defending', 'DEFENDING'],
                ['physical', 'PHYSICAL'],
              ].map(([key, label]) => (
                <article class:list={['core-card', !baseStats[key] && 'is-empty']}>
                  <div class="core-top">
                    <span>{label}</span>
                    <strong>{baseStats[key] ?? '—'}</strong>
                  </div>
                  <div class="progress"><i style={`width:${Math.min(100, Number(baseStats[key] ?? 0) / 1.5)}%`}></i></div>
                </article>
              ))}
            </div>
          </section>

          <section class="content-grid">
            <div class="main-column">
              <section class="panel-section">
                <div class="section-head">
                  <div>
                    <span class="kicker">ATTRIBUTES</span>
                    <h2>Detailed stats</h2>
                  </div>
                  <span class="section-note">Base card values</span>
                </div>

                {availableGroups.length ? (
                  <div class="stat-groups">
                    {availableGroups.map(([group, keys]) => (
                      <article class="stat-group">
                        <header>
                          <span>{group}</span>
                          <b>{keys.length} stats</b>
                        </header>
                        <div class="stat-rows">
                          {keys.map((key) => (
                            <div class="stat-row">
                              <span>{labels[key] || key.replaceAll('_', ' ')}</span>
                              <div class="stat-track"><i style={`width:${Math.min(100, Number(baseStats[key]) / 1.5)}%`}></i></div>
                              <strong>{baseStats[key]}</strong>
                            </div>
                          ))}
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  <div class="data-empty">No detailed attribute values were supplied for this player.</div>
                )}
              </section>

              <section class="panel-section">
                <div class="section-head">
                  <div>
                    <span class="kicker">PLAYSTYLE</span>
                    <h2>PlayStyles</h2>
                  </div>
                  <span class="section-note">{playstyles.length} collected</span>
                </div>

                {playstyles.length ? (
                  <div class="playstyle-grid">
                    {playstyles.map((item) => {
                      const paths = Array.isArray(item.asset_paths) ? item.asset_paths : [];
                      const level = Number(item.level);
                      const icon = Number.isInteger(level) && level >= 0
                        ? paths[level] || paths[paths.length - 1]
                        : paths[paths.length - 1];
                      return (
                        <article class="ability-card playstyle-card">
                          <div class="ability-icon">
                            {icon ? <img src={icon} alt="" loading="lazy" decoding="async" /> : <span>✦</span>}
                          </div>
                          <div class="ability-copy">
                            <span>{item.plus ? 'PLAYSTYLE+' : 'PLAYSTYLE'}</span>
                            <strong>{item.name}</strong>
                            <small>{item.level != null ? `Level ${item.level + 1}` : 'Active style'}</small>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                ) : (
                  <div class="data-empty"><strong>No PlayStyles were returned for this player.</strong><span>The card can still be used with the available core attributes and progression tools.</span></div>
                )}
              </section>

              <section class="panel-section">
                <div class="section-head">
                  <div>
                    <span class="kicker">TRAITS</span>
                    <h2>Player traits</h2>
                  </div>
                  <span class="section-note">{traits.length} collected</span>
                </div>

                {traits.length ? (
                  <div class="traits-grid">
                    {traits.map((item) => (
                      <div class="trait"><span>✓</span><b>{item.name}</b></div>
                    ))}
                  </div>
                ) : (
                  <div class="data-empty">No traits were returned for this player.</div>
                )}
              </section>
            </div>

            <aside class="side-column">
              <section class="panel-section progression-panel">
                <div class="section-head">
                  <div>
                    <span class="kicker">PROGRESSION</span>
                    <h2>Rank Up</h2>
                  </div>
                  <span class="section-note">+1 OVR / rank</span>
                </div>

                <div class="rank-path" id="rankPath">
                  {rankCards.map((rank) => (
                    <button class:list={['rank-tile', rank.value === 0 && 'selected']} type="button" data-rank={rank.value}>
                      <img src={rank.icon} alt="" loading="lazy" />
                      <span>{rank.name}</span>
                      <strong>{rank.ovr}</strong>
                      {rank.stepCost != null ? <small>{rank.stepCost} RP</small> : <small>BASE</small>}
                    </button>
                  ))}
                </div>

                <div class="rank-readout">
                  <span>SELECTED RANK</span>
                  <strong id="selectedRank">Base</strong>
                  <b><em id="selectedOvr">{player.ovr}</em> OVR</b>
                </div>

                <a class="wide-link" href={`/rank-up-calculator/?base=${player.ovr}&current=0&target=5`}>
                  Open full Rank Up Calculator <span>→</span>
                </a>
              </section>

              <section class="panel-section training-panel">
                <div class="section-head">
                  <div>
                    <span class="kicker">TRAINING</span>
                    <h2>Training path</h2>
                  </div>
                  <span class="section-note">Level 0–30</span>
                </div>

                <div class="training-hero">
                  <strong>0 → 30</strong>
                  <span>Full training range</span>
                </div>

                <div class="training-track" aria-label="Training level milestones">
                  {trainingMilestones.map((level) => (
                    <div>
                      <span>{level}</span>
                      <i class:list={{ active: level === 30 }}></i>
                    </div>
                  ))}
                </div>

                <div class="training-facts">
                  <div><span>MAX LEVEL</span><b>{MAX_TRAINING_LEVEL}</b></div>
                  <div><span>TOP FODDER</span><b>{FODDER.at(-1)?.label || 'Configured'}</b></div>
                </div>

                <a class="wide-link" href="/training-calculator/">
                  Open full Training Calculator <span>→</span>
                </a>
              </section>

              <section class="panel-section shape-panel">
                <div class="section-head">
                  <div>
                    <span class="kicker">PROFILE</span>
                    <h2>Attribute shape</h2>
                  </div>
                </div>

                <svg class="radar" viewBox="0 0 320 320" aria-label="Player attribute radar">
                  <polygon class="radar-ring r1" points="160,30 272,95 272,225 160,290 48,225 48,95"></polygon>
                  <polygon class="radar-ring r2" points="160,68 239,114 239,206 160,252 81,206 81,114"></polygon>
                  <polygon class="radar-ring r3" points="160,106 206,133 206,187 160,214 114,187 114,133"></polygon>
                  <polygon class="radar-fill" id="shape" points="160,106 206,133 206,187 160,214 114,187 114,133"></polygon>
                  <text x="160" y="16">PAC</text>
                  <text x="290" y="94">SHO</text>
                  <text x="290" y="232">PAS</text>
                  <text x="160" y="313">DRI</text>
                  <text x="30" y="232">DEF</text>
                  <text x="30" y="94">PHY</text>
                </svg>

                <div class="shape-legend">
                  {[
                    ['pace', 'PACE'], ['shooting', 'SHO'], ['passing', 'PAS'],
                    ['dribbling', 'DRI'], ['defending', 'DEF'], ['physical', 'PHY']
                  ].map(([key, label]) => (
                    <span><b>{baseStats[key] ?? '—'}</b>{label}</span>
                  ))}
                </div>
              </section>
            </aside>
          </section>
        </>
      )}
    </div>
  </main>

  {hasPlayer && (
    <script define:vars={{ statsPayload, rankPayload }}>
      const base = JSON.parse(statsPayload);
      const ranks = JSON.parse(rankPayload);
      const values = ['pace', 'shooting', 'passing', 'dribbling', 'defending', 'physical']
        .map((key) => Math.max(0, Math.min(1, Number(base[key] ?? 0) / 150)));
      const angles = [-Math.PI / 2, -Math.PI / 2 + Math.PI / 3, -Math.PI / 2 + 2 * Math.PI / 3, Math.PI / 2, Math.PI * 5 / 6, Math.PI * 7 / 6];
      const points = values.map((value, index) => {
        const angle = angles[index];
        return (160 + Math.cos(angle) * 128 * value) + ',' + (160 + Math.sin(angle) * 128 * value);
      }).join(' ');
      document.getElementById('shape')?.setAttribute('points', points);

      const selectedRank = document.getElementById('selectedRank');
      const selectedOvr = document.getElementById('selectedOvr');
      document.querySelectorAll('[data-rank]').forEach((button) => {
        button.addEventListener('click', () => {
          const rank = ranks.find((item) => Number(item.value) === Number(button.dataset.rank));
          if (!rank) return;
          document.querySelectorAll('.rank-tile').forEach((tile) => tile.classList.remove('selected'));
          button.classList.add('selected');
          selectedRank.textContent = rank.name;
          selectedOvr.textContent = rank.ovr;
        });
      });
    </script>
  )}
</BaseLayout>

<style>
.player-page{
  --bg:#071018;
  --deep:#050c14;
  --surface:#0F1A26;
  --surface-2:#132333;
  --surface-3:#162536;
  --line:rgba(255,255,255,.08);
  --line-bright:rgba(76,201,255,.22);
  --text:#F5F8FB;
  --muted:#A7B4C3;
  --dim:#708596;
  --cyan:#4CC9FF;
  --cyan-2:#63D4FF;
  min-height:100vh;
  color:var(--text);
  background:
    radial-gradient(1000px 650px at 85% 0%,rgba(76,201,255,.10),transparent 62%),
    radial-gradient(820px 520px at 5% 28%,rgba(76,201,255,.045),transparent 65%),
    linear-gradient(180deg,var(--bg),var(--deep));
  padding:0 0 90px;
}
.player-page *{box-sizing:border-box}
.shell{width:min(1220px,calc(100% - 34px));margin:0 auto}
.crumbs{display:flex;align-items:center;gap:10px;padding:28px 0 20px;color:#647D90;font:800 9px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.crumbs a{color:var(--cyan);text-decoration:none}
.crumbs a:hover{color:var(--cyan-2)}
.hero{display:grid;grid-template-columns:minmax(360px,470px) minmax(0,1fr);gap:58px;align-items:center;padding:10px 0 54px}
.hero-card-column{min-width:0}
.player-card{
  position:relative;
  width:min(100%,470px);
  aspect-ratio:5 / 7;
  margin:auto;
  overflow:hidden;
  border-radius:28px;
  isolation:isolate;
  border:1px solid rgba(76,201,255,.26);
  background:linear-gradient(150deg,#183247,#08131e 74%);
  box-shadow:0 45px 110px rgba(0,0,0,.48),0 0 85px rgba(76,201,255,.08);
}
.player-card::after{content:"";position:absolute;inset:8px;border:1px solid rgba(255,255,255,.10);border-radius:23px;pointer-events:none;z-index:9}
.card-bg{position:absolute;inset:0;background-image:var(--card-background);background-size:100% 100%;background-position:center;background-repeat:no-repeat;z-index:-4}
.card-vignette{position:absolute;inset:0;background:
  radial-gradient(circle at 48% 36%,rgba(255,255,255,.08),transparent 30%),
  linear-gradient(180deg,rgba(0,0,0,.03) 0%,rgba(0,0,0,.03) 40%,rgba(0,0,0,.50) 100%);
  z-index:-3
}
.card-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(76,201,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.025) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(180deg,transparent 5%,#000 38%,#000 78%,transparent 100%);z-index:-2;opacity:.5}
.card-meta{position:absolute;top:5.5%;left:8.5%;right:8.5%;display:flex;justify-content:space-between;gap:12px;z-index:7;color:rgba(235,250,255,.74);font:800 8px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.13em;text-transform:uppercase}
.card-meta span{max-width:52%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
