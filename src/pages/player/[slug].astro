.core-card.is-empty{opacity:.6}
.core-top{display:flex;flex-direction:column;gap:12px}
.core-top span{color:#6A8597;font:800 8px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.12em}
.core-top strong{color:var(--tier);font:900 36px/.9 "Space Grotesk",system-ui,sans-serif;letter-spacing:-.06em;text-shadow:0 0 24px color-mix(in srgb,var(--tier) 40%,transparent)}
.progress,.stat-track{height:5px;margin-top:15px;border-radius:99px;background:rgba(255,255,255,.06);overflow:hidden}
.progress i,.stat-track i{display:block;height:100%;width:var(--w);border-radius:inherit;background:linear-gradient(90deg,color-mix(in srgb,var(--tier,var(--high)) 55%,#0b1620),var(--tier,var(--high)));box-shadow:0 0 12px color-mix(in srgb,var(--tier,var(--high)) 40%,transparent)}

.content-grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:16px;margin-top:16px;align-items:start}
.main-column,.side-column{display:grid;gap:16px}

.stat-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}
.stat-group{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:rgba(6,14,22,.55)}
.stat-group header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);background:linear-gradient(90deg,rgba(var(--accent-rgb),.08),transparent)}
.stat-group header span{color:#E8F6FB;font:800 13px/1 "Space Grotesk",system-ui,sans-serif}
.stat-group header b{color:#4B7184;font:800 7.5px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.stat-rows{padding:8px 16px 12px}
.stat-row{display:grid;grid-template-columns:116px minmax(0,1fr) 30px;gap:10px;align-items:center;padding:7px 0}
.stat-row>span{color:#8CA3B1;font-size:10px;line-height:1.2}
.stat-row>strong{color:var(--tier);font:800 11px/1 "Space Grotesk",system-ui,sans-serif;text-align:right}
.stat-track{margin:0;height:4px}

.playstyle-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.ability-card{position:relative;display:flex;align-items:center;gap:13px;min-width:0;padding:13px;border:1px solid rgba(var(--accent-rgb),.14);border-radius:18px;background:linear-gradient(145deg,rgba(14,38,56,.8),rgba(9,19,28,.85));transition:transform .25s var(--ease),border-color .2s}
.ability-card:hover{transform:translateY(-3px);border-color:rgba(var(--accent-rgb),.4)}
.ability-card.is-plus{border-color:rgba(242,200,121,.35);background:linear-gradient(145deg,rgba(54,42,18,.55),rgba(9,19,28,.85))}
.ability-icon{width:52px;height:52px;flex:none;display:grid;place-items:center;border-radius:14px;background:rgba(var(--accent-rgb),.08);border:1px solid rgba(var(--accent-rgb),.14);overflow:hidden}
.is-plus .ability-icon{background:rgba(242,200,121,.1);border-color:rgba(242,200,121,.3)}
.ability-icon img{width:100%;height:100%;padding:7px;object-fit:contain}
.ability-icon span{color:var(--accent);font-size:22px}
.ability-copy{min-width:0}
.ability-copy span{display:block;color:#5C879D;font:800 7.5px/1 "Space Grotesk",system-ui,sans-serif;letter-spacing:.14em}
.is-plus .ability-copy span{color:var(--elite)}
.ability-copy strong{display:block;margin-top:7px;color:#EAF9FD;font:800 13px/1.15 "Space Grotesk",system-ui,sans-serif;overflow-wrap:anywhere}
.ability-copy small{display:block;margin-top:6px;color:#6B8698;font-size:10px}

.traits-grid{display:flex;flex-wrap:wrap;gap:8px}
.trait{display:flex;align-items:center;gap:9px;padding:10px 13px 10px 10px;border:1px solid var(--line);border-radius:99px;background:rgba(8,17,26,.7);transition:border-color .2s,transform .2s var(--ease)}
.trait:hover{border-color:rgba(var(--accent-rgb),.4);transform:translateY(-2px)}
.trait span{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;color:var(--ink);background:var(--accent);font-size:10px;font-weight:900}
