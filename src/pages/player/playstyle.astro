---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PLAYSTYLES } from '../../data/playstyles.js';

const categoryNames = ['All', 'Ball Control', 'Finishing', 'Passing', 'Defending', 'Physical', 'Goalkeeper'];
const iconPath = (name, tier) => '/assets/images/playstyle/playstyle_64_PLAYSTYLE_' + name + '_' + tier + '.png';
const playstyles = PLAYSTYLES.map((style) => {
  const tiers = style.noBaseIcon ? [1, 1, 2] : [0, 1, 2];
  return {
    ...style,
    categoryKey: style.category.toLowerCase().replaceAll(' ', '-'),
    icons: tiers.map((tier) => iconPath(style.icon, tier)),
    searchText: [style.name, style.category, style.summary, ...style.levels].join(' ').toLowerCase()
  };
});
const categoryCount = categoryNames.length - 1;
---

<BaseLayout
  title="FC Mobile PlayStyle Guide"
  description="Explore FC Mobile PlayStyles by category, compare all three effect levels, and learn how each style changes player behaviour in matches."
  canonical="/player/playstyle/"
>
  <main class="ps-page">
    <section class="ps-hero">
      <div class="ps-shell ps-hero-layout">
        <div class="ps-hero-copy">
          <nav class="ps-crumbs" aria-label="Breadcrumb">
            <a href="/">FCMOBILETOOLS</a><span aria-hidden="true">/</span><span>Player</span><span aria-hidden="true">/</span><strong>PlayStyles</strong>
          </nav>
          <div class="ps-eyebrow"><i aria-hidden="true"></i> FC MOBILE FIELD GUIDE <span>PLAYER KNOWLEDGE</span></div>
          <h1>Know what changes <em>on the pitch.</em></h1>
          <p class="ps-lede">Every PlayStyle has a job. Find the one you need, compare its three levels, and see which actions it improves before you build your squad.</p>
          <div class="ps-hero-actions">
            <a class="ps-btn ps-btn-primary" href="#playstyle-library">Browse PlayStyles <span aria-hidden="true">↓</span></a>
            <a class="ps-btn ps-btn-quiet" href="/player/playstyle-finder/">Find by action <span aria-hidden="true">↗</span></a>
            <a class="ps-btn ps-btn-quiet" href="#level-guide">How levels work <span aria-hidden="true">↗</span></a>
          </div>
          <div class="ps-stats" aria-label="Guide overview">
            <div><strong>{playstyles.length}</strong><span>PlayStyles</span></div>
            <div><strong>{categoryCount}</strong><span>Categories</span></div>
            <div><strong>3</strong><span>Effect levels</span></div>
          </div>
        </div>
        <div class="ps-hero-art" aria-label="Featured PlayStyle icons">
          <div class="ps-art-grid" aria-hidden="true"></div>
          <div class="ps-orbit ps-orbit-one" aria-hidden="true"></div>
          <div class="ps-orbit ps-orbit-two" aria-hidden="true"></div>
          <div class="ps-art-kicker"><span class="ps-live-dot"></span> PLAYSTYLE SYSTEM <span>01 / 22</span></div>
          <div class="ps-feature-icon ps-feature-rapid">
            <img src="/assets/images/playstyle/playstyle_64_PLAYSTYLE_SPEED_DRIBBLER_2.png" width="66" height="66" alt="" loading="eager" decoding="async" />
          </div>
          <div class="ps-feature-icon ps-feature-pass">
            <img src="/assets/images/playstyle/playstyle_64_PLAYSTYLE_INCISIVE_THROUGH_2.png" width="62" height="62" alt="" loading="eager" decoding="async" />
          </div>
          <div class="ps-feature-icon ps-feature-defend">
            <img src="/assets/images/playstyle/playstyle_64_PLAYSTYLE_STAND_TACKLE_MASTER_2.png" width="58" height="58" alt="" loading="eager" decoding="async" />
          </div>
          <div class="ps-art-center">
            <div class="ps-center-ring"></div>
            <img src="/assets/images/playstyle/playstyle_64_PLAYSTYLE_POWER_SHOT_2.png" width="112" height="112" alt="Power Shot PlayStyle icon" loading="eager" decoding="async" />
            <span>POWER SHOT</span>
            <strong>Make the action count.</strong>
          </div>
          <div class="ps-art-foot"><span>BEHAVIOUR</span><b>NOT JUST OVR</b><span>FC MOBILE</span></div>
        </div>
      </div>
    </section>

    <section class="ps-library ps-shell" id="playstyle-library">
      <div class="ps-section-head">
        <div>
          <div class="ps-section-kicker"><span></span> THE REFERENCE</div>
          <h2>Find your PlayStyle.</h2>
          <p>Search by name, category or effect. Select a level to read what changes.</p>
        </div>
        <div class="ps-result" id="psResultCount" aria-live="polite">{playstyles.length} PlayStyles</div>
      </div>

      <div class="ps-controls">
        <label class="ps-search" for="psSearch">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.5 4.5"></path></svg>
          <input id="psSearch" type="search" placeholder="Search PlayStyles or effects…" autocomplete="off" spellcheck="false" />
          <button type="button" id="psClearSearch" aria-label="Clear search" hidden>×</button>
        </label>
        <div class="ps-filter-label">FILTER CATEGORY</div>
        <div class="ps-filters" role="group" aria-label="Filter PlayStyles by category">
          {categoryNames.map((category) => (
            <button
              type="button"
              class:list={['ps-filter', category === 'All' && 'is-active']}
              data-filter={category.toLowerCase().replaceAll(' ', '-')}
              aria-pressed={category === 'All' ? 'true' : 'false'}
            >
              {category}
              <span>{category === 'All' ? playstyles.length : playstyles.filter((style) => style.category === category).length}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="ps-card-grid" id="psCardGrid">
        {playstyles.map((style, index) => (
          <article
            class="ps-card"
            data-style-card
            data-category={style.categoryKey}
            data-search={style.searchText}
            data-icons={JSON.stringify(style.icons)}
            data-levels={JSON.stringify(style.levels)}
            style={'--card-order:' + index}
          >
            <div class="ps-card-head">
              <div class="ps-icon-wrap">
                <img
                  class="ps-style-icon"
                  src={style.icons[0]}
                  alt={style.name + ' PlayStyle icon'}
                  width="62"
                  height="62"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="ps-card-title">
                <span class="ps-card-overline">PLAYSTYLE</span>
                <h3>{style.name}</h3>
                <span class="ps-category"><i aria-hidden="true"></i>{style.category}</span>
              </div>
              <span class="ps-card-index">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p class="ps-summary">{style.summary}</p>
            {style.summaryNote && <p class="ps-note">{style.summaryNote}</p>}
            <div class="ps-level-head">
              <span>LEVEL EFFECT</span>
              <span class="ps-tier-label" data-tier-label>Level 1</span>
            </div>
            <div class="ps-level-tabs" role="group" aria-label={'Select ' + style.name + ' effect level'}>
              <button type="button" class="ps-level-btn is-active" data-level="1" aria-pressed="true">Level 1</button>
              <button type="button" class="ps-level-btn" data-level="2" aria-pressed="false">Level 2</button>
              <button type="button" class="ps-level-btn ps-level-three" data-level="3" aria-pressed="false"><span aria-hidden="true">★</span> Level 3</button>
            </div>
            <p class="ps-level-copy" data-level-copy>{style.levels[0]}</p>
          </article>
        ))}
      </div>

      <div class="ps-empty" id="psEmpty" hidden>
        <span aria-hidden="true">⌕</span>
        <h3>No PlayStyles found</h3>
        <p>Try another name, effect or category.</p>
        <button type="button" id="psResetFilters">Reset filters</button>
      </div>

      <p class="ps-disclaimer">Effect descriptions are qualitative; the game does not publish exact modifier values. Level 3 descriptions follow the supplied guide text where available; exact numerical gameplay modifiers are not published here.</p>
    </section>

    <section class="ps-level-guide" id="level-guide">
      <div class="ps-shell ps-level-guide-layout">
        <div>
          <div class="ps-section-kicker"><span></span> READ THE LEVELS</div>
          <h2>Same PlayStyle.<br /><em>Stronger effect.</em></h2>
          <p>Higher levels strengthen the action a PlayStyle affects. They do not turn every movement or stat into a permanent bonus.</p>
        </div>
        <div class="ps-level-explain">
          <div class="ps-level-explain-row">
            <span class="ps-level-mark">01</span>
            <div><strong>Level 1</strong><p>The base effect. Use this description to understand the action the style changes.</p></div>
          </div>
          <div class="ps-level-explain-row">
            <span class="ps-level-mark">02</span>
            <div><strong>Level 2</strong><p>A stronger version, sometimes adding another benefit such as better recovery or control.</p></div>
          </div>
          <div class="ps-level-explain-row">
            <span class="ps-level-mark ps-level-mark-gold">★</span>
            <div><strong>Level 3</strong><p>The strongest effect shown in this guide, based on the available descriptions.</p></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    (() => {
      const page = document.querySelector('.ps-page');
      if (!page) return;

      const cards = Array.from(page.querySelectorAll('[data-style-card]'));
      const filters = Array.from(page.querySelectorAll('[data-filter]'));
      const search = page.querySelector('#psSearch');
      const clearSearch = page.querySelector('#psClearSearch');
      const resultCount = page.querySelector('#psResultCount');
      const empty = page.querySelector('#psEmpty');
      const reset = page.querySelector('#psResetFilters');
      let activeCategory = 'all';

      const applyFilters = () => {
        const query = (search.value || '').trim().toLowerCase();
        let shown = 0;
        cards.forEach((card) => {
          const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
          const matchesQuery = !query || card.dataset.search.includes(query);
          const visible = matchesCategory && matchesQuery;
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        resultCount.textContent = shown + (shown === 1 ? ' PlayStyle' : ' PlayStyles');
        empty.hidden = shown !== 0;
        clearSearch.hidden = !search.value;
      };

      filters.forEach((button) => {
        button.addEventListener('click', () => {
          activeCategory = button.dataset.filter;
          filters.forEach((filter) => {
            const isActive = filter === button;
            filter.classList.toggle('is-active', isActive);
            filter.setAttribute('aria-pressed', String(isActive));
          });
          applyFilters();
        });
      });

      search.addEventListener('input', applyFilters);
      clearSearch.addEventListener('click', () => {
        search.value = '';
        search.focus();
        applyFilters();
      });

      page.addEventListener('click', (event) => {
        const button = event.target.closest('.ps-level-btn');
        if (!button) return;
        const card = button.closest('[data-style-card]');
        if (!card) return;
        const level = Number(button.dataset.level);
        const tabs = card.querySelectorAll('.ps-level-btn');
        tabs.forEach((tab) => {
          const isActive = tab === button;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-pressed', String(isActive));
        });
        const levels = JSON.parse(card.dataset.levels);
        const icons = JSON.parse(card.dataset.icons);
        const copy = card.querySelector('[data-level-copy]');
        const icon = card.querySelector('.ps-style-icon');
        const tierLabel = card.querySelector('[data-tier-label]');
        copy.textContent = levels[level - 1];
        icon.src = icons[level - 1];
        tierLabel.textContent = level === 3 ? '★ Level 3' : 'Level ' + level;
      });

      reset.addEventListener('click', () => {
        activeCategory = 'all';
        search.value = '';
        filters.forEach((filter) => {
          const isActive = filter.dataset.filter === 'all';
          filter.classList.toggle('is-active', isActive);
          filter.setAttribute('aria-pressed', String(isActive));
        });
        applyFilters();
        search.focus();
      });

      applyFilters();
    })();
  </script>

  <style>
    .ps-page {
      --ps-bg: #071018;
      --ps-surface: #0f1a26;
      --ps-surface-raised: #132333;
      --ps-line: rgba(222, 240, 250, .09);
      --ps-text: #f5f8fb;
      --ps-muted: #a7b4c3;
      --ps-blue: #4cc9ff;
      --ps-blue-soft: rgba(76, 201, 255, .11);
      --ps-gold: #f2c977;
      color: var(--ps-text);
      background: var(--ps-bg);
      overflow: clip;
    }
    .ps-shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
    .ps-hero {
      position: relative;
      isolation: isolate;
      padding: 26px 0 60px;
      background:
        radial-gradient(ellipse at 0% 0%, rgba(35, 79, 108, .18), transparent 42%),
        linear-gradient(180deg, #091522 0%, #071018 100%);
      border-bottom: 1px solid rgba(213, 235, 249, .07);
    }
    .ps-hero::before {
      content: ""; position: absolute; inset: 0; z-index: -1; opacity: .17; pointer-events: none;
      background-image:linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size: 46px 46px;
      mask-image: linear-gradient(90deg, #000, transparent 75%);
    }
    .ps-hero-layout { display: grid; grid-template-columns: 1.03fr .97fr; align-items: center; gap: 44px; min-height: 466px; }
    .ps-hero-copy { position: relative; z-index: 2; animation: ps-rise .55s ease both; }
    .ps-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; color: #6e8495; font: 600 12px/1.5 var(--font-body, Inter, sans-serif); letter-spacing: .08em; }
    .ps-crumbs a { color: #9daebe; text-decoration: none; transition: color .2s; }
    .ps-crumbs a:hover { color: var(--ps-blue); }
    .ps-crumbs strong { color: #e9f5fb; font-weight: 600; }
    .ps-eyebrow, .ps-section-kicker { display: flex; align-items: center; gap: 9px; color: var(--ps-blue); font: 800 12px/1.5 var(--font-body, Inter, sans-serif); letter-spacing: .02em; }
    .ps-eyebrow { margin-top: 34px; }
    .ps-eyebrow i, .ps-section-kicker span { display: inline-block; width: 6px; height: 6px; flex: 0 0 6px; border-radius: 50%; background: var(--ps-blue); box-shadow:none; }
    .ps-eyebrow > span { margin-left: 3px; padding: 5px 7px; border: 1px solid rgba(76,201,255,.22); border-radius: 4px; color: #96aab9; font-size: 12px; letter-spacing: .1em; }
    .ps-hero h1 { max-width: 610px; margin: 18px 0 16px; font: 700 clamp(42px, 5.2vw, 67px)/.99 var(--font-heading, "Space Grotesk", sans-serif); letter-spacing: -.06em; }
    .ps-hero h1 em, .ps-level-guide h2 em { color: var(--ps-blue); font-style: normal; }
    .ps-lede { max-width: 510px; margin: 0; color: #a7b4c3; font: 400 15px/1.8 var(--font-body, Inter, sans-serif); }
    .ps-hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 25px; }
    .ps-btn { display: inline-flex; justify-content: center; align-items: center; gap: 17px; min-height: 44px; padding: 0 16px; border: 1px solid transparent; border-radius: 8px; text-decoration: none; font: 700 12px/1 var(--font-body, Inter, sans-serif); transition: transform .2s ease, border-color .2s ease, background .2s ease; }
    .ps-btn:hover { transform: translateY(-2px); }
    .ps-btn-primary { color: #06121b; background: var(--ps-blue); box-shadow:none; }
    .ps-btn-primary:hover { background: #71d6ff; }
    .ps-btn-quiet { border-color: var(--ps-line); color: #d2e0ea; background: rgba(255,255,255,.02); }
    .ps-btn-quiet:hover { border-color: rgba(76,201,255,.35); background: rgba(76,201,255,.05); }
    .ps-stats { display: flex; gap: 30px; margin-top: 34px; padding-top: 19px; border-top: 1px solid var(--ps-line); max-width: 420px; }
    .ps-stats div { display: grid; gap: 5px; }
    .ps-stats strong { font: 700 23px/1 var(--font-heading, "Space Grotesk", sans-serif); letter-spacing: -.04em; }
    .ps-stats span { color: #8294a4; font: 600 12px/1.4 var(--font-body, Inter, sans-serif); letter-spacing: .04em; text-transform:none; }
    .ps-hero-art { min-height: 400px; position: relative; isolation: isolate; display: grid; place-items: center; animation: ps-rise .65s .08s ease both; }
    .ps-art-grid { position: absolute; inset: 4% 2%; z-index: -2; opacity: .44; background-image:linear-gradient(rgba(150,220,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(150,220,255,.05) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(ellipse, #000, transparent 72%); }
    .ps-orbit { position: absolute; aspect-ratio: 1; border: 1px solid rgba(76,201,255,.12); border-radius: 50%; }
    .ps-orbit-one { width: 80%; transform: rotate(-18deg) scaleY(.78); }
    .ps-orbit-two { width: 60%; transform: rotate(25deg) scaleY(.76); border-style: dashed; border-color: rgba(76,201,255,.11); }
    .ps-art-kicker { position: absolute; top: 18px; left: 14px; right: 14px; display: flex; align-items: center; gap: 8px; color: #9caebd; font: 800 12px/1 var(--font-body, Inter, sans-serif); letter-spacing: .02em; }
    .ps-art-kicker > span:last-child { margin-left: auto; color: #506879; font-size: 12px; }
    .ps-live-dot { width: 5px; height: 5px; border-radius: 50%; background: #58d58c; box-shadow:none; }
    .ps-art-center { position: relative; z-index: 1; display: grid; justify-items: center; padding: 30px 34px 25px; width: 235px; border: 1px solid rgba(157,217,244,.15); border-radius: 14px; background:rgba(21,42,59,.94); box-shadow:0 25px 70px rgba(0,0,0,.28), inset 0 1px rgba(255,255,255,.05); }
    .ps-center-ring { position: absolute; top: 35px; width: 130px; height: 130px; border: 1px solid rgba(76,201,255,.23); border-radius: 50%; box-shadow:inset 0 0 28px rgba(76,201,255,.07); }
    .ps-art-center img { position: relative; z-index: 1; width: 112px; height: 112px; object-fit: contain; filter: drop-shadow(0 11px 18px rgba(0,0,0,.25)); }
    .ps-art-center span { margin-top: 10px; color: var(--ps-blue); font: 800 12px/1 var(--font-body, Inter, sans-serif); letter-spacing: .02em; }
    .ps-art-center strong { margin-top: 8px; color: #f0f7fb; font: 600 14px/1.4 var(--font-heading, "Space Grotesk", sans-serif); }
    .ps-feature-icon { position: absolute; z-index: 2; display: grid; place-items: center; width: 86px; height: 86px; border: 1px solid rgba(170,219,241,.15); border-radius: 17px; background:rgba(22,43,59,.96); box-shadow:0 15px 36px rgba(0,0,0,.24); }
    .ps-feature-icon img { max-width: 100%; height: auto; object-fit: contain; }
    .ps-feature-rapid { top: 16%; left: 4%; transform: rotate(-8deg); }
    .ps-feature-pass { top: 28%; right: 4%; transform: rotate(8deg); }
    .ps-feature-defend { right: 11%; bottom: 11%; width: 78px; height: 78px; transform: rotate(5deg); }
    .ps-art-foot { position: absolute; bottom: 11px; left: 13px; right: 13px; display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #617889; font: 700 12px/1 var(--font-body, Inter, sans-serif); letter-spacing: .1em; }
    .ps-art-foot b { color: #a6bfce; font-weight: 800; }
    .ps-library { padding-top: 62px; padding-bottom: 76px; }
    .ps-section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
    .ps-section-kicker { margin-bottom: 11px; }
    .ps-section-head h2, .ps-level-guide h2 { margin: 0; font: 700 clamp(30px, 4vw, 42px)/1.06 var(--font-heading, "Space Grotesk", sans-serif); letter-spacing: -.05em; }
    .ps-section-head p { margin: 10px 0 0; color: var(--ps-muted); font: 400 13px/1.7 var(--font-body, Inter, sans-serif); }
    .ps-result { flex: 0 0 auto; margin-bottom: 4px; padding: 9px 12px; border: 1px solid var(--ps-line); border-radius: 6px; color: #b7c8d4; background: rgba(255,255,255,.025); font: 700 12px/1 var(--font-body, Inter, sans-serif); }
    .ps-controls { margin-top: 27px; padding: 17px; border: 1px solid var(--ps-line); border-radius: 13px; background:rgba(15,26,38,.96); }
    .ps-search { display: flex; align-items: center; gap: 11px; height: 46px; max-width: 100%; padding: 0 13px; border: 1px solid rgba(204,232,247,.1); border-radius: 8px; background: rgba(3,11,18,.38); transition: border-color .2s, box-shadow .2s; }
    .ps-search:focus-within { border-color: rgba(76,201,255,.45); box-shadow:0 0 0 3px rgba(76,201,255,.07); }
    .ps-search svg { width: 17px; height: 17px; flex: 0 0 17px; fill: none; stroke: #7891a3; stroke-width: 1.8; stroke-linecap: round; }
    .ps-search input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--ps-text); background: transparent; font: 500 12px/1.5 var(--font-body, Inter, sans-serif); }
    .ps-search input::placeholder { color: #748595; }
    .ps-search input::-webkit-search-cancel-button { display: none; }
    .ps-search button { border: 0; padding: 4px 7px; color: #9db1bf; background: transparent; font: 400 21px/1 var(--font-body, Inter, sans-serif); cursor: pointer; }
    .ps-filter-label { margin: 17px 0 9px; color: #60798a; font: 800 12px/1.3 var(--font-body, Inter, sans-serif); letter-spacing: .02em; }
    .ps-filters { display: flex; gap: 7px; overflow-x: auto; padding: 1px 1px 3px; scrollbar-width: thin; scrollbar-color: #304454 transparent; }
    .ps-filter { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 10px; border: 1px solid rgba(202,231,247,.08); border-radius: 6px; color: #9eafbd; background: rgba(255,255,255,.018); font: 700 12px/1 var(--font-body, Inter, sans-serif); cursor: pointer; transition: color .18s, background .18s, border-color .18s; }
    .ps-filter span { padding: 4px 5px; border-radius: 4px; color: #8195a4; background: rgba(255,255,255,.045); font-size: 12px; font-variant-numeric: tabular-nums; }
    .ps-filter:hover { border-color: rgba(76,201,255,.28); color: #d8edf7; }
    .ps-filter.is-active { border-color: rgba(76,201,255,.38); color: #eaf8ff; background: rgba(76,201,255,.1); }
    .ps-filter.is-active span { color: #071018; background: var(--ps-blue); }
    .ps-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; margin-top: 17px; align-items: stretch; }
    .ps-card { min-width: 0; display: flex; flex-direction: column; padding: 17px; border: 1px solid var(--ps-line); border-radius: 12px; background:rgba(16,29,42,.98); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; animation: ps-card-in .38s both; animation-delay: calc(min(var(--card-order), 12) * 15ms); }
    .ps-card:hover { transform: translateY(-3px); border-color: rgba(76,201,255,.23); box-shadow:0 14px 34px rgba(0,0,0,.16); }
    .ps-card[hidden] { display: none; }
    .ps-card-head { display: flex; align-items: center; gap: 12px; min-height: 69px; }
