---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Account Settings" description="Manage your FCMobiletools profile and public profile visibility." robots="noindex,nofollow" googlebot="noindex,nofollow">
  <main class="settings-page">
    <div id="settingsRoot" class="settings-root"><div class="loading-card">Loading account settings…</div></div>
  </main>
</BaseLayout>

<script>
  import { accountAuth, accountApi } from '../../lib/account-client.js';

  const root=document.querySelector('#settingsRoot');
  const esc=(v)=>String(v ?? '').replace(/[&<>"']/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  function state(title,copy){root.innerHTML='<section class="state-card"><span class="kicker">ACCOUNT SETTINGS</span><h1>'+esc(title)+'</h1><p>'+esc(copy)+'</p><a class="primary-btn" href="/account/">Open account</a></section>';}

  async function load(){
    const session=await accountAuth.auth.getSession();
    if(!session.data.session){state('Sign in first.','Sign in to manage your profile and public profile visibility.');return;}
    const r=await accountApi('/api/account/me');
    const b=await r.json().catch(()=>({}));
    if(!r.ok){state(b.error || 'Unable to load settings.','Please sign in again.');return;}

    const a=b.account || {}, s=b.settings || {};
    root.innerHTML='<section class="head"><span class="kicker">ACCOUNT SETTINGS</span><h1>Keep your profile yours.</h1><p>These controls affect what other people can see. Email and security information are never public.</p></section>'
      +'<section class="form-grid"><form class="panel" id="profileForm"><div class="panel-head"><div><span class="kicker">PROFILE</span><h2>Identity</h2></div></div>'
      +'<label><span>Username</span><input id="username" value="'+esc(a.username)+'" minlength="3" maxlength="24" pattern="[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]" required></label>'
      +'<label><span>Display name</span><input id="displayName" value="'+esc(a.displayName || '')+'" maxlength="80"></label>'
      +'<label><span>Avatar URL</span><input id="avatarUrl" value="'+esc(a.avatarUrl || '')+'" maxlength="2048" placeholder="https://..."></label>'
      +'<button class="primary-btn" type="submit">Save profile</button><p class="msg" id="profileMsg" role="status"></p></form>'
      +'<form class="panel" id="privacyForm"><div class="panel-head"><div><span class="kicker">PUBLIC PROFILE</span><h2>Visibility</h2></div></div>'
      +[['profile_public','Profile page public'],['show_display_name','Display name'],['show_level','Level'],['show_xp','XP'],['show_streak','Streak'],['show_joined_date','Joined date'],['show_achievements','Achievements'],['show_tournament_stats','Tournament stats'],['show_activity_summary','Activity summary']].map(([n,l])=>'<label class="toggle"><input type="checkbox" data-setting="'+n+'" '+(s[n] !== false ? 'checked' : '')+'><span>'+esc(l)+'</span></label>').join('')
      +'<button class="primary-btn" type="submit">Save privacy settings</button><p class="msg" id="privacyMsg" role="status"></p></form></section>';

    document.querySelector('#profileForm').addEventListener('submit',async (event)=>{
      event.preventDefault(); const form=event.currentTarget,msg=document.querySelector('#profileMsg'),button=form.querySelector('button[type="submit"]'); msg.textContent='';button.disabled=true;
      try{
        if(!form.checkValidity()){form.reportValidity();return;}
        const r=await accountApi('/api/account/profile',{method:'PUT',body:JSON.stringify({username:document.querySelector('#username').value.trim().toLowerCase(),displayName:document.querySelector('#displayName').value.trim(),avatarUrl:document.querySelector('#avatarUrl').value.trim()})});
        const b=await r.json().catch(()=>({})); if(!r.ok)throw Error(b.error || 'Unable to save profile.');
        msg.textContent='Profile saved.';msg.className='msg success';
      }catch(e){msg.textContent=e.message;msg.className='msg error';}finally{button.disabled=false;}
    });

    document.querySelector('#privacyForm').addEventListener('submit',async (event)=>{
      event.preventDefault(); const form=event.currentTarget,msg=document.querySelector('#privacyMsg'),button=form.querySelector('button[type="submit"]');msg.textContent='';button.disabled=true;
      try{
        const values={};form.querySelectorAll('[data-setting]').forEach((input)=>values[input.dataset.setting]=input.checked);
        const r=await accountApi('/api/account/settings',{method:'PUT',body:JSON.stringify(values)});
        const b=await r.json().catch(()=>({}));if(!r.ok)throw Error(b.error || 'Unable to save privacy settings.');
        msg.textContent='Privacy settings saved.';msg.className='msg success';
      }catch(e){msg.textContent=e.message;msg.className='msg error';}finally{button.disabled=false;}
    });
  }
  load().catch(()=>state('Something went wrong.','Please refresh and try again.'));
</script>

<style>
.settings-page{min-height:calc(100vh - 80px);padding:72px 18px 100px}.settings-root{width:min(1040px,100%);margin:auto}.kicker{color:var(--primary);font:800 9px var(--font-body);letter-spacing:.14em;text-transform:uppercase}.head h1{margin:13px 0 8px;font:700 clamp(40px,5vw,62px)/1 var(--font-display);letter-spacing:-.06em}.head p{margin:0;color:var(--muted);font:500 12px/1.7 var(--font-body)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:25px}.panel,.loading-card,.state-card{padding:22px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:linear-gradient(150deg,rgba(15,26,38,.98),rgba(7,16,24,.98));box-shadow:0 22px 65px rgba(0,0,0,.23)}.panel{display:grid;gap:14px}.panel-head h2{margin:7px 0 0;font:700 20px var(--font-display);letter-spacing:-.035em}.panel label>span{display:block;margin-bottom:7px;color:#dce8ef;font:700 10px var(--font-body)}.panel input:not([type="checkbox"]){width:100%;min-height:44px;padding:0 12px;border:1px solid #29414e;border-radius:11px;background:#09141d;color:var(--text);font:600 12px var(--font-body);outline:0}.panel input:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(76,201,255,.09)}.toggle{display:flex!important;gap:10px;align-items:center;padding:10px 11px;border:1px solid rgba(255,255,255,.06);border-radius:10px;background:#09141d}.toggle input{width:16px!important;height:16px!important;min-height:16px!important}.toggle span{margin:0!important;color:#bdd0dc!important}.primary-btn{min-height:42px;padding:0 14px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #69d8ff;border-radius:11px;background:linear-gradient(135deg,#9fe6ff,#4cc9ff);color:#04121a;text-decoration:none;font:800 9px var(--font-body);cursor:pointer}.primary-btn:disabled{opacity:.6}.msg{min-height:18px;margin:0;font:700 9px var(--font-body)}.msg.success{color:#86e7a0}.msg.error{color:#ff9e96}.state-card{max-width:630px;margin:40px auto}.state-card h1{margin:11px 0;font:700 35px var(--font-display);letter-spacing:-.05em}.state-card p{color:var(--muted);font:500 11px/1.7 var(--font-body);margin:0 0 20px}
@media(max-width:760px){.form-grid{grid-template-columns:1fr}}@media(max-width:520px){.settings-page{padding:48px 12px 75px}.panel{padding:17px}}
</style>
