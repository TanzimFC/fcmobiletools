---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="Account Settings & Privacy | FCMobiletools"
  description="Manage your FCMobiletools profile identity, avatar and public profile privacy controls."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="set-page">
    <div class="set-wrap">
      <AccountNav active="settings" sectionLabel="Settings & Privacy" />

      <div id="settingsRoot" class="set-root">
        <div class="acc-skel set-skel" aria-label="Loading account settings"></div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    accountAuth,
    accountApi,
    setCachedIdentity,
    clearCachedIdentity,
    escapeHtml as esc,
    getAuthRedirectUrl
  } from '../../lib/account-client.js';

  const root = document.getElementById('settingsRoot');

  const PRIVACY_OPTIONS = [
    ['profile_public', 'Public profile enabled', 'Allow visitors to view your public profile at /profile/username/.'],
    ['show_display_name', 'Show display name', 'Display your custom name instead of only your @username.'],
    ['show_level', 'Show progression level', 'Display your current account level on your public card.'],
    ['show_xp', 'Show recorded XP balance', 'Display your verified XP total on your public profile.'],
    ['show_streak', 'Show activity streak', 'Display your current and longest qualifying day streak.'],
    ['show_joined_date', 'Show joined date', 'Display the month and year you joined FCMobiletools.'],
    ['show_achievements', 'Show unlocked achievements', 'Display your unlocked milestone badges on your public profile.'],
    ['show_fc_mobile_uid', 'Show FC Mobile UID', 'Display your FC Mobile UID publicly. Off by default.'],
    ['show_in_game_username', 'Show in-game username', 'Display your FC Mobile in-game name publicly.'],
    ['show_region_server', 'Show Region / Server', 'Display your FC Mobile region or server publicly.'],
    ['show_discord_handle', 'Show Discord handle', 'Display your Discord handle publicly.'],
    ['show_player_tags', 'Show player style tags', 'Show tags like Competitive H2H, VSA Grinder or Investor.'],
    ['show_tournament_stats', 'Show tournament record', 'Only used when FCMobiletools tournaments are public.'],
    ['show_activity_summary', 'Show activity summary', 'Allow public activity summary metrics when enabled.']
  ];

  function renderSignedOut(title, copy) {
    root.innerHTML = `
      <section class="set-guest acc-anim">
        <span class="set-kicker">ACCOUNT SETTINGS</span>
        <h1>${esc(title)}</h1>
        <p>${esc(copy)}</p>
        <div class="set-guest-actions">
          <a class="set-btn-primary" href="/account/">Sign in to Account →</a>
          <a class="set-btn-secondary" href="/account/?mode=signup">Create Account</a>
        </div>
      </section>
    `;
  }

  async function loadSettings() {
    const session = await accountAuth.auth.getSession();
    if (!session.data?.session) {
      renderSignedOut('Sign in to manage your settings', 'Control your @username, display name, avatar and public profile visibility.');
      return;
    }

    const r = await accountApi('/api/account/me');
    const b = await r.json().catch(() => ({}));
    if (!r.ok || !b?.account) {
      renderSignedOut(b?.error || 'Unable to load settings', 'Please sign in again to manage your account.');
      return;
    }

    const a = b.account;
    const s = b.settings || {};
    setCachedIdentity(a);

    const display = a.displayName || a.username;
    const initials = String(display || 'FC').slice(0, 2).toUpperCase();
    const isVerified = Boolean(a.emailConfirmedAt);

    root.innerHTML = `
      <header class="set-header acc-anim">
        <div>
          <span class="set-kicker">IDENTITY &amp; PRIVACY</span>
          <h1>Keep your profile yours.</h1>
          <p>Update your public handle and choose exactly which progression stats appear on your public profile. Private email and security data are never public.</p>
        </div>
        <a class="set-btn-secondary" href="/profile/${encodeURIComponent(a.username)}/">Preview Public Profile ↗</a>
      </header>

      <div class="set-grid acc-anim acc-anim-d1">
        <!-- Left: Identity Form + Security Box -->
        <div class="set-col">
          <form class="set-panel" id="profileForm" novalidate>
            <div class="panel-head">
              <div>
                <span class="set-kicker">PUBLIC IDENTITY</span>
                <h2>Profile Details</h2>
              </div>
              <span class="pill-tag">Level ${Number(a.level || 1)}</span>
            </div>

            <!-- Live mini card preview -->
            <div class="live-id-preview">
              <div class="live-id-avatar" id="liveAvatarPreview">
                ${a.avatarUrl ? `<img src="${esc(a.avatarUrl)}" alt="" />` : `<span>${esc(initials)}</span>`}
              </div>
              <div class="live-id-text">
                <strong id="liveDisplayPreview">${esc(display)}</strong>
                <span id="liveHandlePreview">@${esc(a.username)}</span>
              </div>
            </div>

            <div class="field">
              <label for="username">Username <small>(3–24 chars)</small></label>
              <div class="input-prefix-wrap">
                <span>@</span>
                <input
                  id="username"
                  value="${esc(a.username)}"
                  minlength="3"
                  maxlength="24"
                  pattern="[a-z0-9][a-z0-9._-]{1,22}[a-z0-9]"
                  required
                />
              </div>
              <small class="hint">Lowercase letters, numbers, dots, underscores or hyphens.</small>
            </div>

            <div class="field">
              <label for="displayName">Display Name <small>(optional, max 80 chars)</small></label>
              <input id="displayName" value="${esc(a.displayName || '')}" maxlength="80" placeholder="Your display name" />
            </div>

            <div class="field">
              <label for="avatarUrl">Avatar Image URL <small>(optional HTTPS URL)</small></label>
              <input id="avatarUrl" value="${esc(a.avatarUrl || '')}" maxlength="2048" placeholder="https://..." />
              <small class="hint">Leave blank to use your custom monogram badge.</small>
            </div>

            <div class="panel-foot">
              <button class="set-btn-primary" type="submit">Save Name & Avatar</button>
              <p class="status-msg" id="profileMsg" role="status"></p>
            </div>
          </form>

          <form class="set-panel" id="gameProfileForm">
            <div class="panel-head">
              <div>
                <span class="set-kicker">FC MOBILE IDENTITY</span>
                <h2>Your Player Profile</h2>
              </div>
              <span class="pill-tag">${a.gameProfile?.complete ? 'Complete' : 'Finish setup'}</span>
            </div>
            <p class="privacy-intro">This is the FC Mobile info that powers your account. UID, in-game name and Region / Server are required. Discord and player style tags are optional.</p>
            <div class="field-grid">
              <div class="field"><label for="fcMobileUid">FC Mobile UID</label><input id="fcMobileUid" maxlength="32" required value="${esc(a.gameProfile?.fcMobileUid || '')}" placeholder="Your FC Mobile UID" /></div>
              <div class="field"><label for="inGameUsername">In-game username</label><input id="inGameUsername" maxlength="40" required value="${esc(a.gameProfile?.inGameUsername || '')}" placeholder="Your in-game name" /></div>
            </div>
            <div class="field-grid">
              <div class="field"><label for="regionServer">Region / Server</label><input id="regionServer" maxlength="40" required value="${esc(a.gameProfile?.regionServer || '')}" placeholder="e.g. Asia, Europe, NA" /></div>
              <div class="field"><label for="discordHandle">Discord Handle <small>(optional)</small></label><input id="discordHandle" maxlength="64" value="${esc(a.gameProfile?.discordHandle || '')}" placeholder="name or name#1234" /></div>
            </div>
            <div class="field">
              <label>How do you play FC Mobile? <small>(optional)</small></label>
              <div class="tag-select" id="playerTagSelect">
                ${['Competitive H2H','VSA Grinder','Investor','Theme Team Builder','Casual'].map(tag => `
                  <label class="tag-choice"><input type="checkbox" value="${esc(tag)}" ${a.gameProfile?.playerTags?.includes(tag) ? 'checked' : ''} /><span>${esc(tag)}</span></label>
                `).join('')}
              </div>
            </div>
            <div class="panel-foot"><button class="set-btn-primary" type="submit">Save FC Mobile Profile</button><p class="status-msg" id="gameProfileMsg" role="status"></p></div>
          </form>

          <!-- Security & Account Box -->
          <section class="set-panel">
            <div class="panel-head">
              <div>
                <span class="set-kicker">PRIVATE CREDENTIALS</span>
                <h2>Email &amp; Security</h2>
              </div>
              <span class="pill-tag ${isVerified ? 'is-green' : 'is-amber'}">
                ${isVerified ? 'Verified' : 'Unverified'}
              </span>
            </div>
            <div class="sec-info-row">
              <div>
                <small>LINKED EMAIL ADDRESS (NEVER PUBLIC)</small>
                <strong>${esc(a.email || 'Protected')}</strong>
              </div>
            </div>
            <p class="sec-note">
              ${isVerified
                ? 'Your email address is verified. Password changes require your current password.'
                : 'Your email address is not verified yet. You can resend a fresh verification link whenever you need one.'}
            </p>

            ${!isVerified ? '<div class="sec-actions"><button type="button" class="set-btn-secondary" id="resendVerificationBtn">Resend Verification Email</button></div>' : ''}

            <form class="password-change-form" id="passwordChangeForm" novalidate>
              <div class="password-change-title">CHANGE PASSWORD</div>
              <div class="password-change-grid">
                <div class="field">
                  <label for="currentPassword">Current password</label>
                  <input id="currentPassword" type="password" autocomplete="current-password" required minlength="10" placeholder="Enter your current password" />
                </div>
                <div class="field">
                  <label for="newPassword">New password <small>(min 10 characters)</small></label>
                  <input id="newPassword" type="password" autocomplete="new-password" required minlength="10" placeholder="Create a new password" />
                </div>
              </div>
              <div class="field">
                <label for="confirmNewPassword">Confirm new password</label>
                <input id="confirmNewPassword" type="password" autocomplete="new-password" required minlength="10" placeholder="Enter the new password again" />
              </div>
              <button class="set-btn-primary" type="submit">Change Password</button>
              <p class="status-msg" id="passwordMsg" role="status"></p>
            </form>

            <div class="forgot-help">
              <strong>Forgot your password?</strong>
              <span>Password recovery is currently locked. Please contact us on <a href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener noreferrer">Discord</a> for help.</span>
            </div>

            <div class="sec-actions">
              <button type="button" class="set-btn-danger" id="settingsLogoutBtn">Sign out</button>
            </div>
            <p class="status-msg" id="securityMsg" role="status"></p>
          </section>
        </div>

        <!-- Right: Public Visibility Switch Toggles -->
        <form class="set-panel" id="privacyForm">
          <div class="panel-head">
            <div>
              <span class="set-kicker">VISIBILITY CONTROLS</span>
              <h2>What Other Players Can See</h2>
            </div>
          </div>
          <p class="privacy-intro">
            Choose what other players can see when they visit <code>/profile/${esc(a.username)}/</code>.
          </p>

          <div class="switch-list">
            ${PRIVACY_OPTIONS.map(
              ([key, label, desc]) => `
              <label class="switch-row">
                <div class="switch-copy">
                  <strong>${esc(label)}</strong>
                  <small>${esc(desc)}</small>
                </div>
                <span class="switch-control">
                  <input type="checkbox" data-setting="${key}" ${s[key] !== false ? 'checked' : ''} />
                  <i class="switch-slider"></i>
                </span>
              </label>
            `
            ).join('')}
          </div>

          <div class="panel-foot">
            <button class="set-btn-primary" type="submit">Save Privacy</button>
            <p class="status-msg" id="privacyMsg" role="status"></p>
          </div>
        </form>
      </div>
    `;

    // Live preview updates
    const uInput = document.getElementById('username');
    const dInput = document.getElementById('displayName');
    const avInput = document.getElementById('avatarUrl');
    const avBox = document.getElementById('liveAvatarPreview');
    const dBox = document.getElementById('liveDisplayPreview');
    const hBox = document.getElementById('liveHandlePreview');

    const updatePreview = () => {
      const u = String(uInput?.value || '').trim().toLowerCase() || a.username;
      const d = String(dInput?.value || '').trim() || u;
      const av = String(avInput?.value || '').trim();
      if (dBox) dBox.textContent = d;
      if (hBox) hBox.textContent = '@' + u;
      if (avBox) {
        if (av && /^https?:\/\//i.test(av)) {
          avBox.innerHTML = `<img src="${esc(av)}" alt="" />`;
        } else {
          avBox.innerHTML = `<span>${esc(d.slice(0, 2).toUpperCase())}</span>`;
        }
      }
    };
    uInput?.addEventListener('input', updatePreview);
    dInput?.addEventListener('input', updatePreview);
    avInput?.addEventListener('input', updatePreview);

    // Save Profile
    document.getElementById('profileForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const msg = document.getElementById('profileMsg');
      const button = form.querySelector('button[type="submit"]');
      msg.textContent = '';
      msg.className = 'status-msg';
      button.disabled = true;
      try {
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        const username = uInput.value.trim().toLowerCase();
        const displayName = dInput.value.trim();
        const avatarUrl = avInput.value.trim();
        const r = await accountApi('/api/account/profile', {
          method: 'PUT',
          body: JSON.stringify({ username, displayName, avatarUrl })
        });
        const out = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(out.error || 'Unable to save profile.');
        setCachedIdentity({ ...a, username, displayName: displayName || username, avatarUrl: avatarUrl || null });
        msg.textContent = 'Profile saved and synced.';
        msg.className = 'status-msg is-ok';
      } catch (e) {
        msg.textContent = e.message;
        msg.className = 'status-msg is-err';
      } finally {
        button.disabled = false;
      }
    });

    document.getElementById('gameProfileForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const msg = document.getElementById('gameProfileMsg');
      const button = form.querySelector('button[type="submit"]');
      msg.textContent = '';
      msg.className = 'status-msg';
      button.disabled = true;
      try {
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const playerTags = [...form.querySelectorAll('#playerTagSelect input:checked')].map(input => input.value);
        const r = await accountApi('/api/account/game-profile', {
          method: 'PUT',
          body: JSON.stringify({
            fcMobileUid: document.getElementById('fcMobileUid').value.trim(),
            inGameUsername: document.getElementById('inGameUsername').value.trim(),
            regionServer: document.getElementById('regionServer').value.trim(),
            discordHandle: document.getElementById('discordHandle').value.trim(),
            playerTags
          })
        });
        const out = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(out.error || 'Unable to save your FC Mobile profile.');
        msg.textContent = 'FC Mobile profile saved.';
        msg.className = 'status-msg is-ok';
        window.setTimeout(() => location.reload(), 500);
      } catch (e) {
        msg.textContent = e.message;
        msg.className = 'status-msg is-err';
      } finally { button.disabled = false; }
    });

    // Save Privacy Settings
    document.getElementById('privacyForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const msg = document.getElementById('privacyMsg');
      const button = form.querySelector('button[type="submit"]');
      msg.textContent = '';
      msg.className = 'status-msg';
      button.disabled = true;
      try {
        const values = {};
        form.querySelectorAll('[data-setting]').forEach((input) => {
          values[input.dataset.setting] = input.checked;
        });
        const r = await accountApi('/api/account/settings', {
          method: 'PUT',
          body: JSON.stringify(values)
        });
        const out = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(out.error || 'Unable to save privacy settings.');
        msg.textContent = 'Privacy settings saved.';
        msg.className = 'status-msg is-ok';
      } catch (e) {
        msg.textContent = e.message;
        msg.className = 'status-msg is-err';
      } finally {
        button.disabled = false;
      }
    });

    // Verification resend for accounts that have not confirmed their email yet.
    document.getElementById('resendVerificationBtn')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget;
      btn.disabled = true;
      const msg = document.getElementById('securityMsg');
      msg.textContent = '';
      try {
        const result = await accountAuth.auth.resend({
          type: 'signup',
          email: a.email,
          options: { emailRedirectTo: getAuthRedirectUrl() }
        });
        if (result.error) throw result.error;
        msg.textContent = 'A fresh verification email has been requested. Check your inbox and spam folder.';
        msg.className = 'status-msg is-ok';
      } catch (e) {
        msg.textContent = e.message || 'Unable to resend the verification email right now.';
        msg.className = 'status-msg is-err';
      } finally {
        btn.disabled = false;
      }
    });

    // Password changes require verification of the current password first.
    document.getElementById('passwordChangeForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const msg = document.getElementById('passwordMsg');
      const button = form.querySelector('button[type="submit"]');
      const currentPassword = String(document.getElementById('currentPassword')?.value || '');
      const newPassword = String(document.getElementById('newPassword')?.value || '');
      const confirmPassword = String(document.getElementById('confirmNewPassword')?.value || '');

      msg.textContent = '';
      msg.className = 'status-msg';

      if (currentPassword.length < 10) {
        msg.textContent = 'Enter your current password.';
        msg.className = 'status-msg is-err';
        return;
      }
      if (newPassword.length < 10) {
        msg.textContent = 'Use a new password with at least 10 characters.';
        msg.className = 'status-msg is-err';
        return;
      }
      if (newPassword === currentPassword) {
        msg.textContent = 'Your new password must be different from the current password.';
        msg.className = 'status-msg is-err';
        return;
      }
      if (newPassword !== confirmPassword) {
        msg.textContent = 'The new passwords do not match.';
        msg.className = 'status-msg is-err';
        return;
      }

      button.disabled = true;
      try {
        const currentEmail = String(a.email || '').trim().toLowerCase();
        if (!currentEmail) throw new Error('Your account email is unavailable. Please sign in again.');

        const verify = await accountAuth.auth.signInWithPassword({
          email: currentEmail,
          password: currentPassword
        });
        if (verify.error) throw new Error('Current password is incorrect.');

        const updated = await accountAuth.auth.updateUser({ password: newPassword });
        if (updated.error) throw updated.error;

        form.reset();
        msg.textContent = 'Password changed successfully.';
        msg.className = 'status-msg is-ok';
      } catch (e) {
        msg.textContent = e.message || 'Unable to change your password right now.';
        msg.className = 'status-msg is-err';
      } finally {
        button.disabled = false;
      }
    });

    // Logout
    document.getElementById('settingsLogoutBtn')?.addEventListener('click', async () => {
      await accountAuth.auth.signOut();
      clearCachedIdentity();
      location.replace('/');
    });
  }

  loadSettings().catch(() =>
    renderSignedOut('Something went wrong', 'Please refresh the page and try again.')
  );
</script>

<style is:global>
  .set-page {
    min-height: calc(100vh - 80px);
    padding: 36px 18px 110px;
    background: radial-gradient(900px 440px at 15% 0%, rgba(76, 201, 255, 0.07), transparent 65%);
  }
  .set-wrap {
    width: min(1140px, 100%);
    margin: 0 auto;
  }
  .set-skel {
    height: 460px;
    border-radius: 24px;
  }

  .set-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .set-kicker {
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .set-header h1 {
    margin: 10px 0 8px;
    font: 700 clamp(30px, 4.5vw, 46px) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
    color: #f5f8fb;
  }
  .set-header p {
    margin: 0;
    max-width: 660px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }

  .set-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .set-col {
    display: grid;
    gap: 16px;
  }

  .set-panel,
  .set-guest {
    padding: 26px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(155deg, rgba(15, 26, 38, 0.97), rgba(8, 16, 24, 0.97));
    box-shadow: 0 22px 58px rgba(0, 0, 0, 0.28);
    display: grid;
    gap: 16px;
  }

  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .panel-head h2 {
    margin: 6px 0 0;
    font: 700 22px/1.15 var(--font-display);
    letter-spacing: -0.03em;
    color: #f5f8fb;
  }
  .pill-tag {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.12);
    border: 1px solid rgba(76, 201, 255, 0.28);
    color: #8ee0ff;
    font: 700 11.5px/1 var(--font-body);
  }
  .pill-tag.is-green {
    background: rgba(71, 209, 108, 0.12);
    border-color: rgba(71, 209, 108, 0.3);
    color: #8ceca4;
  }
  .pill-tag.is-amber {
    background: rgba(255, 191, 104, 0.12);
    border-color: rgba(255, 191, 104, 0.3);
    color: #ffd36e;
  }

  .live-id-preview {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid rgba(76, 201, 255, 0.2);
    background: rgba(7, 16, 24, 0.75);
  }
  .live-id-avatar {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font: 800 18px/1 var(--font-display);
    overflow: hidden;
  }
  .live-id-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .live-id-text strong {
    display: block;
    color: #f5f8fb;
    font: 700 16px/1.25 var(--font-display);
  }
  .live-id-text span {
    display: block;
    margin-top: 2px;
    color: #879fb1;
    font: 600 13px/1.3 var(--font-body);
  }

  .field {
    display: grid;
    gap: 6px;
  }
  .field label {
    color: #e1ecf3;
    font: 700 13px/1.2 var(--font-body);
  }
  .field label small {
    color: #7990a2;
    font-weight: 500;
  }
  .input-prefix-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-prefix-wrap span {
    position: absolute;
    left: 14px;
    color: #4cc9ff;
    font: 700 14px/1 var(--font-body);
  }
  .input-prefix-wrap input {
    padding-left: 30px !important;
  }
  .field input {
    width: 100%;
    min-height: 46px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid #263d4d;
    background: #071018;
    color: #f5f8fb;
    font: 600 14px/1.2 var(--font-body);
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .field input:focus {
    border-color: #4cc9ff;
    box-shadow: 0 0 0 4px rgba(76, 201, 255, 0.12);
  }
  .password-change-form {
    display: grid;
    gap: 12px;
