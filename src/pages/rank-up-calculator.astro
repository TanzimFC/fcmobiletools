---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator" description="Calculate Rank Up Points and the exact cost to rank an FC Mobile player from one rank to another">
<main class="page"><div class="wrap">
<header class="hero"><div><span>FC MOBILE 26</span><h1>Rank Up Calculator</h1><p>Enter the player's Base OVR and rank to get the exact Rank Up Points</p></div></header>
<section class="card inputs"><div class="label">PLAYER</div><div class="fields"><label>Base OVR<input id="base" type="number" min="0" max="130" value="110"></label><label>Current Rank<select id="current">{RANKS.map(r=><option value={r.value}>{r.value} · {r.name}</option>)}</select></label><label>Target Rank<select id="target">{RANKS.map(r=><option value={r.value} selected={r.value===5}>{r.value} · {r.name}</option>)}</select></label><label>Available RP <small>optional</small><input id="available" type="number" min="0" placeholder="0"></label></div></section>
<section id="result" class="result"></section>
<section class="card"><div class="section-head"><div><div class="label">UPGRADE PATH</div><h2>Rank progression</h2></div><strong id="bracket"></strong></div><div id="path"></div></section>
<section class="card"><div class="label">COST</div><h2>Rank Up Points needed</h2><div id="steps"></div></section>
<section class="card reference"><div class="label">REFERENCE</div><h2>RP cost by Base OVR</h2><div id="table"></div></section>
</div></main>
</BaseLayout>
<style>
.page{--blue:#54cdf5;--ink:#122832;--muted:#70858d;--line:#d9e8ed;background:radial-gradient(circle at 90% 0,#c9f3ff,transparent 30%),#f4fafc;min-height:100vh;padding:40px 16px 80px}.wrap{max-width:1040px;margin:auto}.hero{padding:12px 0 30px}.hero span,.label{font:900 9px ui-monospace,monospace;letter-spacing:.15em;color:#139dcc}.hero h1{font-size:clamp(42px,7vw,70px);letter-spacing:-.065em;line-height:.9;margin:9px 0 12px}.hero p{margin:0;color:var(--muted);font-size:14px}.card,.result{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 42px #2c647813;padding:22px;margin-bottom:14px}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-top:16px}label{display:grid;gap:7px;font:900 9px ui-monospace,monospace;color:#58717a}label small{font-size:8px;color:#9caeb4}input,select{width:100%;box-sizing:border-box;border:1px solid #cfe0e6;background:#f9fdfe;border-radius:10px;padding:13px 11px;font:800 12px ui-monospace,monospace;color:#142b34;outline:0}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #54cdf51c}.result{background:#0d2d3a;border-color:#1a5369;color:#f1fcff}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}.result-kicker{font:900 8px ui-monospace,monospace;letter-spacing:.14em;color:#78ddff}.total{font:900 clamp(48px,8vw,78px) ui-monospace,monospace;line-height:.88;letter-spacing:-.07em;margin:9px 0}.total small{font-size:13px;letter-spacing:0;color:#8eb5c2}.sub{font:800 9px ui-monospace,monospace;color:#9ebbc4}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stat{border:1px solid #ffffff18;border-radius:12px;background:#ffffff08;padding:14px}.stat span{display:block;font:800 7px ui-monospace,monospace;color:#75a5b2;margin-bottom:6px}.stat strong{font:900 15px ui-monospace,monospace}.status{grid-column:1/-1;padding:11px;border-radius:9px;font:900 8px ui-monospace,monospace}.good{background:#69f4c61b;color:#9effd6}.bad{background:#ff6d6d18;color:#ffb7b7}.neutral{background:#ffffff09;color:#b8cbd1}.section-head{display:flex;justify-content:space-between;align-items:end}.section-head h2,.card h2{font-size:19px;margin:6px 0 18px}.section-head strong{font:900 8px ui-monospace,monospace;color:#178db2;background:#eefaff;border:1px solid #c8eaf3;border-radius:8px;padding:6px 8px}.path{display:flex;align-items:center;gap:5px;padding:8px 0}.node{flex:1;text-align:center}.orb{width:46px;height:46px;border-radius:50%;margin:auto;display:grid;place-items:center;background:#f1f6f8;border:2px solid #d5e4e8;color:#75888f;font:900 9px ui-monospace,monospace}.node.current .orb{border-color:var(--blue);background:#effbff;color:#087fa9;box-shadow:0 0 0 5px #54cdf51a}.node.target .orb{background:#102e3a;border-color:#102e3a;color:#fff}.node small{display:block;margin-top:7px;color:#85989f;font:900 6px ui-monospace,monospace}.line{height:2px;flex:1;background:#dce7eb}.step{display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-icon{width:38px;height:38px;border-radius:11px;background:#eefaff;color:#148bb0;display:grid;place-items:center;font:900 8px ui-monospace,monospace}.step b{font-size:11px}.step small{display:block;color:var(--muted);font-size:8px;margin-top:3px}.step strong{font:900 13px ui-monospace,monospace;color:#1484a8}.total-row{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:14px;margin-top:3px;font-size:10px}.total-row strong{font:900 18px ui-monospace,monospace}.reference table{width:100%;border-collapse:collapse;font:800 9px ui-monospace,monospace}.reference th,.reference td{padding:11px 8px;border-bottom:1px solid var(--line);text-align:center}.reference th{font-size:7px;color:#82979e}.reference th:first-child,.reference td:first-child{text-align:left}.reference tr.active{background:#eefaff}.reference td{color:#314951}@media(max-width:800px){.fields{grid-template-columns:1fr 1fr}.result-grid{grid-template-columns:1fr}}@media(max-width:520px){.page{padding:25px 13px 60px}.card,.result{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.orb{width:35px;height:35px}.node small{font-size:5px}}
</style>
<script>
import { calculateRankUp } from '../lib/fcMobileRankUp.js';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
const base=document.querySelector('#base'),current=document.querySelector('#current'),target=document.querySelector('#target'),available=document.querySelector('#available'),result=document.querySelector('#result'),path=document.querySelector('#path'),bracket=document.querySelector('#bracket'),steps=document.querySelector('#steps'),table=document.querySelector('#table');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);
function render(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c);const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availableRP:available.value});if(!d.valid){result.innerHTML=`<div class="result-kicker">CHECK PLAYER</div><div class="total" style="font-size:26px">${d.error}</div>`;return}const status=d.availableRP===null?'':d.affordable?`✓ Enough RP · ${fmt(d.remainingRP)} RP remaining`:`✕ ${fmt(Math.abs(d.remainingRP))} RP short`;const cls=d.availableRP===null?'neutral':d.affordable?'good':'bad';result.innerHTML=`<div class="result-grid"><div><div class="result-kicker">TOTAL RP REQUIRED</div><div class="total">${fmt(d.requiredRP)} <small>RP</small></div><div class="sub">${d.bracket.label} Base OVR · Rank ${d.currentRank} → ${d.targetRank}</div></div><div class="stats"><div class="stat"><span>DISPLAYED OVR</span><strong>${d.baseOVR+d.currentRank} → ${d.targetOVR}</strong></div><div class="stat"><span>SKILL POINTS</span><strong>+${d.skillPoints}</strong></div><div class="stat"><span>RANKS GAINED</span><strong>+${d.ranksGained}</strong></div><div class="stat"><span>MAX RANK</span><strong>5</strong></div><div class="status ${cls}">${status||'Add Available RP above to check your balance'}</div></div></div>`;path.innerHTML='<div class="path">'+RANKS.map((r,i)=>`${i?'<div class="line"></div>':''}<div class="node ${r.value===d.currentRank?'current':''} ${r.value===d.targetRank?'target':''}"><div class="orb">R${r.value}</div><small>${r.name}</small></div>`).join('')+'</div>';bracket.textContent=`Base OVR ${d.bracket.label}`;steps.innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-icon">R${s.to}</div><div><b>Rank ${s.from} → Rank ${s.to}</b><small>${RANKS[s.to].name} · +1 OVR · +1 Skill Point</small></div><strong>${fmt(s.cost)} RP</strong></div>`).join('')+`<div class="total-row"><span>Total</span><strong>${fmt(d.requiredRP)} RP</strong></div>`:'<div class="total-row"><span>Already at target</span><strong>0 RP</strong></div>';table.innerHTML=`<table><thead><tr><th>Base OVR</th>${RANKS.slice(1).map(r=>`<th>R${r.value}</th>`).join('')}</tr></thead><tbody>${RANK_COSTS.map(row=>`<tr class="${row===d.bracket?'active':''}"><td>${row.label}</td>${row.costs.map(v=>`<td>${fmt(v)}</td>`).join('')}</tr>`).join('')}</tbody></table>`}
[base,current,target,available].forEach(x=>x.addEventListener('input',render));render();
</script>