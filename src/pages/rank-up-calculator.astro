---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator | RP Cost & OVR Gain | FCMOBILETOOLS" description="Calculate FC Mobile Rank Up Points, OVR gain, skill points and the exact RP cost from your current rank to your target rank.">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebApplication","name":"FC Mobile Rank Up Calculator","url":"https://tanzimfc.fcmobiletools.workers.dev/rank-up-calculator","applicationCategory":"UtilitiesApplication","operatingSystem":"Any","description":"Calculate FC Mobile Rank Up Points, OVR gain, skill points and upgrade cost.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@type":"Organization","name":"FCMOBILETOOLS"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"FC Mobile Tools","item":"https://tanzimfc.fcmobiletools.workers.dev/"},{"@type":"ListItem","position":2,"name":"Rank Up Calculator","item":"https://tanzimfc.fcmobiletools.workers.dev/rank-up-calculator"}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does Rank Up do in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"Rank Up increases a player's displayed OVR and grants a Skill Point at each rank gained. The exact Rank Up Points required depend on the player's Base OVR bracket and the rank being added."}},{"@type":"Question","name":"How many Rank Up Points do I need?","acceptedAnswer":{"@type":"Answer","text":"The required Rank Up Points depend on Base OVR and the number of ranks you want to gain. Use the calculator to get the exact total and each individual step."}},{"@type":"Question","name":"Does Rank Up increase player OVR?","acceptedAnswer":{"@type":"Answer","text":"Yes. In the calculator model, each rank gained adds one displayed OVR and one Skill Point."}},{"@type":"Question","name":"What is the maximum rank?","acceptedAnswer":{"@type":"Answer","text":"The rank progression used here runs from Base through Green, Blue, Purple, Red and Orange, with Orange as Rank 5."}}]}
</script>
<main class="rank-page">
<section class="hero"><div class="hero-grid"></div><div class="hero-orbit"></div><div class="wrap"><nav class="crumb" aria-label="Breadcrumb"><a href="/">FC Mobile Tools</a><span>/</span>Rank Up Calculator</nav><div class="hero-layout"><div><div class="eyebrow"><i></i> FC MOBILE TOOLS / CALCULATOR 06</div><h1>Rank Up <span>Calculator</span></h1><p>Map the full upgrade path before you spend Rank Up Points. See required RP, OVR gain, Skill Points and every rank cost in one premium workspace.</p><div class="hero-tags"><span>RP PLANNER</span><span>BASE OVR → 130+</span><span>FREE</span></div></div><div class="rank-visual" aria-hidden="true"><div class="orbit o1"></div><div class="orbit o2"></div><div class="rank-core"><small>RANK</small><strong>5</strong><span>ORANGE</span></div><div class="rank-chip rc-one">+OVR <b>+5</b></div><div class="rank-chip rc-two">RP <b>700</b></div></div></div></div></section>
<section class="workspace"><div class="wrap"><div class="calculator"><div class="calc-top"><div><span class="label">RANK UP PLAN</span><h2>Build your upgrade path</h2><p>Enter the player's Base OVR, current rank and target rank</p></div><div class="max-rank"><span>MAX</span><strong>R5</strong><small>ORANGE</small></div></div><div class="inputs"><label><span><b>01</b> Base OVR</span><input id="base" type="number" min="0" max="130" value="110" aria-label="Base OVR"><small>Player OVR before Rank Up</small></label><label><span><b>02</b> Current Rank</span><select id="current" aria-label="Current Rank">{RANKS.map(r=><option value={r.value}>{r.value} · {r.name}</option>)}</select><small>Rank the player has now</small></label><label><span><b>03</b> Target Rank</span><select id="target" aria-label="Target Rank">{RANKS.map(r=><option value={r.value} selected={r.value===5}>{r.value} · {r.name}</option>)}</select><small>Rank you want to reach</small></label><label><span><b>04</b> Available RP <em>OPTIONAL</em></span><input id="available" type="number" min="0" placeholder="0" aria-label="Available Rank Up Points"><small>Check if your balance covers the plan</small></label></div><div class="result" id="result"></div><div class="path-card"><div class="path-head"><div><span class="label">UPGRADE PATH</span><h3>Rank progression</h3></div><strong id="bracket"></strong></div><div class="path" id="path"></div></div><div class="cost-card"><div class="cost-head"><div><span class="label">COST BREAKDOWN</span><h3>Every rank step</h3></div><span>RP</span></div><div id="steps"></div></div></div><section class="reference"><div class="section-intro"><span class="label">REFERENCE DATA</span><h2>Rank Up Points by Base OVR</h2><p>Use the full cost table to compare the RP required across Base OVR brackets.</p></div><div class="ref-table" id="table"></div></section><section class="seo"><span class="label">FC MOBILE RANK UP GUIDE</span><h2>Understand Rank Up before spending RP</h2><div class="prose"><p>The FCMOBILETOOLS Rank Up Calculator lets you plan a player's upgrade from one rank to another before committing Rank Up Points. Enter Base OVR first because the RP cost is determined by the player's Base OVR bracket.</p><p>Each rank step in the current calculator model adds one displayed OVR and one Skill Point. The calculator separates the total RP requirement from the individual rank costs so you can see exactly where your points are going.</p><p>Training and Rank Up are different systems. Training uses XP to improve player stats, while Rank Up changes the player's displayed OVR and adds Skill Points. Use the <a href="/training-calculator">Training Calculator</a> for XP planning.</p></div><div class="faq" id="faqList"></div></section></div></section>
</main>
<style>
:root{--bg:#05080d;--panel:#0b1119;--line:#1d2b39;--text:#f4f9fc;--muted:#7e91a0;--cyan:#39c6ff;--blue:#4778ff;--red:#ff4d5e;--green:#55e0a0;--mono:'IBM Plex Mono',ui-monospace,monospace;--sans:'Manrope',Inter,system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:var(--cyan);text-decoration:none}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.rank-page{background:var(--bg);min-height:100vh}.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);padding:30px 0 52px;isolation:isolate}.hero-grid{position:absolute;inset:0;z-index:-2;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:46px 46px;opacity:.025}.hero:after{content:'';position:absolute;inset:0;z-index:-3;background:radial-gradient(ellipse 620px 420px at 15% 0,#0ea5e91c,transparent 70%),radial-gradient(ellipse 540px 400px at 90% 30%,#4778ff14,transparent 72%)}.hero-orbit{position:absolute;width:520px;height:520px;border:1px solid #39c6ff0b;border-radius:50%;right:-150px;top:-240px}.crumb{display:flex;gap:9px;align-items:center;font:700 10px var(--mono);color:#667a8a;margin-bottom:42px}.crumb a{color:var(--cyan)}.hero-layout{display:grid;grid-template-columns:1fr 370px;gap:50px;align-items:center}.eyebrow,.label{font:800 9px var(--mono);letter-spacing:.16em;color:var(--cyan)}.eyebrow i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px #ff4d5e15;margin-right:8px;animation:beep 1.7s infinite}.hero h1{font-size:clamp(54px,7vw,86px);line-height:.92;letter-spacing:-.07em;margin:14px 0 18px;font-weight:900}.hero h1 span{display:block;background:linear-gradient(105deg,#fff 5%,var(--cyan) 72%);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:660px;color:#8da0af;font-size:15px;line-height:1.75;margin:0}.hero-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.hero-tags span{border:1px solid var(--line);background:#0a1119aa;border-radius:7px;padding:7px 10px;color:#8295a5;font:700 8px var(--mono)}.rank-visual{height:300px;position:relative;display:grid;place-items:center}.orbit{position:absolute;border:1px solid #39c6ff26;border-radius:50%;animation:spin 18s linear infinite}.o1{width:250px;height:250px}.o2{width:170px;height:170px;border-style:dashed;animation-direction:reverse;animation-duration:11s}.rank-core{width:120px;height:120px;border-radius:32px;transform:rotate(-7deg);display:grid;place-items:center;align-content:center;border:1px solid #39c6ff58;background:linear-gradient(145deg,#102532,#081119);box-shadow:0 0 65px #39c6ff1b;z-index:2}.rank-core small,.rank-core span{font:800 7px var(--mono);letter-spacing:.17em;color:#6f8998}.rank-core strong{font:900 51px var(--mono);line-height:1;color:#f2fbff}.rank-core span{color:var(--cyan);margin-top:4px}.rank-chip{position:absolute;border:1px solid var(--line);background:#0a121bd9;backdrop-filter:blur(12px);border-radius:9px;padding:8px 10px;font:700 7px var(--mono);color:#667d8c;z-index:3}.rank-chip b{display:block;color:#eef8fc;font-size:13px;margin-top:2px}.rc-one{right:5px;top:52px;transform:rotate(6deg)}.rc-two{left:8px;bottom:48px;transform:rotate(-6deg)}.workspace{padding:42px 0 80px}.calculator{border:1px solid var(--line);background:linear-gradient(145deg,#0c141d,#080e15);border-radius:24px;box-shadow:0 30px 100px #00000050;overflow:hidden}.calc-top{display:flex;justify-content:space-between;gap:20px;padding:28px 30px;border-bottom:1px solid var(--line)}.calc-top h2{font-size:25px;letter-spacing:-.035em;margin:7px 0 5px}.calc-top p{font-size:12px;color:var(--muted);margin:0}.max-rank{min-width:82px;text-align:center;border:1px solid #39c6ff2a;background:#39c6ff08;padding:10px;border-radius:11px;display:grid;align-content:center}.max-rank span,.max-rank small{font:700 7px var(--mono);color:#67808f;letter-spacing:.12em}.max-rank strong{font:900 25px var(--mono);color:var(--cyan)}.inputs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:22px 30px}.inputs label{display:grid;gap:8px;color:#8799a8;font:800 9px var(--mono)}.inputs label span{color:#e5edf2;font-size:10px}.inputs label span b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#39c6ff12;color:var(--cyan);font-size:8px;margin-right:7px}.inputs em{font-style:normal;font-size:6px;color:#566c7c;margin-left:5px}.inputs small{color:#556a79;font:600 8px var(--sans)}input,select{width:100%;border:1px solid #263746;background:#080f16;color:#eef7fb;border-radius:10px;padding:13px 12px;outline:none;font:800 11px var(--mono);transition:border-color .18s,box-shadow .18s}input:focus,select:focus{border-color:#39c6ff77;box-shadow:0 0 0 3px #39c6ff0c}.result{margin:0 30px 14px;border:1px solid #1e3b4a;border-radius:15px;background:linear-gradient(120deg,#091a23,#0a1119);padding:23px;color:#f3fbff}.result-grid{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:18px;align-items:center}.result-kicker{font:800 8px var(--mono);letter-spacing:.14em;color:#73a0b1}.total{font:900 clamp(40px,5vw,60px) var(--mono);letter-spacing:-.07em;line-height:1;margin:8px 0;color:var(--cyan)}.total small{font-size:12px;letter-spacing:0;color:#7c98a6}.sub{font-size:9px;color:#718796}.stat{padding-left:15px;border-left:1px solid #ffffff0d}.stat span{display:block;font:800 7px var(--mono);color:#5f7888;margin-bottom:8px}.stat strong{font:900 16px var(--mono)}.status{grid-column:1/-1;padding:10px;border-radius:8px;font:800 8px var(--mono)}.good{background:#55e0a012;color:#91efbf;border:1px solid #55e0a01f}.bad{background:#ff4d5e10;color:#ff9ba5;border:1px solid #ff4d5e22}.neutral{background:#ffffff06;color:#91a5b0}.path-card,.cost-card{margin:0 30px 14px;border:1px solid var(--line);border-radius:15px;background:#0a1119;overflow:hidden}.path-head,.cost-head{display:flex;justify-content:space-between;align-items:end;padding:19px 20px;border-bottom:1px solid var(--line)}.path-head h3,.cost-head h3{margin:6px 0 0;font-size:16px}.path-head>strong{font:800 8px var(--mono);color:var(--cyan);border:1px solid #39c6ff26;background:#39c6ff08;padding:7px 8px;border-radius:7px}.path{display:flex;align-items:center;gap:5px;padding:26px 20px}.node{flex:1;text-align:center}.orb{width:48px;height:48px;margin:auto;display:grid;place-items:center;border-radius:14px;border:1px solid #273845;background:#0d171f;color:#738795;font:900 10px var(--mono);transform:rotate(-3deg)}.node.current .orb{border-color:#39c6ff;background:#0b202b;color:var(--cyan);box-shadow:0 0 0 5px #39c6ff0b}.node.target .orb{border-color:#55e0a0;background:#0d241b;color:#8bf0bb;box-shadow:0 0 0 5px #55e0a00b}.node small{display:block;margin-top:8px;color:#687d8c;font:700 6px var(--mono)}.line{height:1px;flex:1;background:#233541}.step{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:center;padding:13px 20px;border-bottom:1px solid #15222d}.step:last-child{border:0}.step-icon{width:38px;height:38px;border-radius:10px;background:#39c6ff09;border:1px solid #39c6ff22;color:var(--cyan);display:grid;place-items:center;font:900 8px var(--mono)}.step b{font-size:10px}.step small{display:block;color:#657b8a;font-size:8px;margin-top:3px}.step strong{font:900 13px var(--mono);color:#eaf8fc}.total-row{display:flex;justify-content:space-between;padding:15px 20px;border-top:1px solid var(--line);font-size:9px;color:#708593}.total-row strong{font:900 17px var(--mono);color:var(--cyan)}.reference,.seo{margin-top:65px}.section-intro{max-width:680px;margin-bottom:22px}.section-intro h2,.seo h2{font-size:clamp(28px,4vw,40px);letter-spacing:-.045em;margin:9px 0}.section-intro p{color:#718494;font-size:12px}.ref-table{border:1px solid var(--line);border-radius:17px;background:#0b121a;overflow:auto}.ref-table table{width:100%;min-width:620px;border-collapse:collapse;font:700 9px var(--mono)}.ref-table th,.ref-table td{padding:13px 12px;border-bottom:1px solid #15222d;text-align:center}.ref-table th{color:#587080;font-size:7px}.ref-table th:first-child,.ref-table td:first-child{text-align:left}.ref-table td{color:#9fb1bc}.ref-table tr.active{background:#39c6ff08}.ref-table tr.active td{color:#dff7ff}.seo{max-width:860px}.prose{color:#8395a3;font-size:12px;line-height:1.85}.prose p{margin:0 0 16px}.faq{margin-top:28px;border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-q{width:100%;display:flex;justify-content:space-between;text-align:left;border:0;background:none;color:#e5eef3;padding:16px 0;font-weight:800;font-size:11px}.faq-q span{color:var(--cyan);font-family:var(--mono)}.faq-a{display:none;color:#718493;font-size:10px;line-height:1.75;padding:0 20px 16px 0}.faq-item.open .faq-a{display:block}@keyframes beep{0%,72%,100%{box-shadow:0 0 0 5px #ff4d5e15}76%{box-shadow:0 0 0 9px #ff4d5e00}80%{box-shadow:0 0 0 5px #ff4d5e15}}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:980px){.hero-layout{grid-template-columns:1fr}.rank-visual{display:none}.inputs{grid-template-columns:1fr 1fr}.result-grid{grid-template-columns:1.5fr 1fr 1fr}.stat:nth-child(4){grid-column:2}.status{grid-column:1/-1}}@media(max-width:620px){.wrap{width:min(100% - 26px,1120px)}.hero{padding:22px 0 38px}.crumb{margin-bottom:30px}.hero h1{font-size:clamp(50px,13vw,74px)}.calc-top{padding:22px 18px}.max-rank{display:none}.inputs{grid-template-columns:1fr;padding:18px}.result,.path-card,.cost-card{margin-left:18px;margin-right:18px}.result{padding:18px}.result-grid{grid-template-columns:1fr 1fr;gap:13px}.result-main{grid-column:1/-1}.stat{border-left:0;padding-left:0}.status{grid-column:1/-1}.path{padding:20px 10px;gap:2px}.orb{width:38px;height:38px;border-radius:11px}.node small{font-size:5px}.line{min-width:4px}.step{grid-template-columns:36px 1fr auto;padding:12px 14px}.reference,.seo{margin-top:50px}.section-intro h2,.seo h2{font-size:29px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
<script>
import { calculateRankUp } from '../lib/fcMobileRankUp.js';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
const base=document.querySelector('#base'),current=document.querySelector('#current'),target=document.querySelector('#target'),available=document.querySelector('#available'),result=document.querySelector('#result'),path=document.querySelector('#path'),bracket=document.querySelector('#bracket'),steps=document.querySelector('#steps'),table=document.querySelector('#table'),fmt=n=>new Intl.NumberFormat('en-US').format(n);
function render(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c);const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availableRP:available.value});if(!d.valid){result.innerHTML=`<div class="result-kicker">CHECK INPUTS</div><div class="total" style="font-size:25px">${d.error}</div>`;return}const status=d.availableRP===null?'Add Available RP above to check your balance':d.affordable?`✓ Enough RP · ${fmt(d.remainingRP)} RP remaining`:`✕ ${fmt(Math.abs(d.remainingRP))} RP short`;const cls=d.availableRP===null?'neutral':d.affordable?'good':'bad';result.innerHTML=`<div class="result-grid"><div><div class="result-kicker">TOTAL RP REQUIRED</div><div class="total">${fmt(d.requiredRP)} <small>RP</small></div><div class="sub">Base OVR ${d.baseOVR} · ${d.bracket.label} bracket · Rank ${d.currentRank} → ${d.targetRank}</div></div><div class="stat"><span>DISPLAYED OVR</span><strong>${d.baseOVR+d.currentRank} → ${d.targetOVR}</strong></div><div class="stat"><span>OVR GAIN</span><strong>+${d.ranksGained}</strong></div><div class="stat"><span>SKILL POINTS</span><strong>+${d.skillPoints}</strong></div><div class="stat"><span>RANKS</span><strong>${d.currentRank} → ${d.targetRank}</strong></div><div class="status ${cls}">${status}</div></div>`;path.innerHTML=RANKS.map((r,i)=>`${i?'<div class="line"></div>':''}<div class="node ${r.value===d.currentRank?'current':''} ${r.value===d.targetRank?'target':''}"><div class="orb">R${r.value}</div><small>${r.name}</small></div>`).join('');bracket.textContent=`Base OVR ${d.bracket.label}`;steps.innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-icon">R${s.to}</div><div><b>Rank ${s.from} → Rank ${s.to}</b><small>${RANKS[s.to].name} · +1 OVR · +1 Skill Point</small></div><strong>${fmt(s.cost)} RP</strong></div>`).join('')+`<div class="total-row"><span>Total Rank Up Points</span><strong>${fmt(d.requiredRP)} RP</strong></div>`:'<div class="total-row"><span>Already at target</span><strong>0 RP</strong></div>';table.innerHTML=`<table><thead><tr><th>BASE OVR</th>${RANKS.slice(1).map(r=>`<th>R${r.value}</th>`).join('')}</tr></thead><tbody>${RANK_COSTS.map(row=>`<tr class="${row===d.bracket?'active':''}"><td>${row.label}</td>${row.costs.map(v=>`<td>${fmt(v)}</td>`).join('')}</tr>`).join('')}</tbody></table>`}
[base,current,target,available].forEach(x=>x.addEventListener('input',render));render();
const faqs=[['What does Rank Up do in FC Mobile?','Rank Up increases displayed OVR and grants a Skill Point at each rank gained in the current calculator model.'],['How many Rank Up Points do I need?','The exact RP total depends on Base OVR and the number of rank steps between your current and target rank.'],['Does Rank Up increase player OVR?','Yes. Each rank gained adds one displayed OVR in the calculator model.'],['What is the maximum rank?','The progression runs from Base to Green, Blue, Purple, Red and Orange, with Orange as Rank 5.']];document.querySelector('#faqList').innerHTML=faqs.map((f,i)=>`<div class="faq-item ${i===0?'open':''}"><button class="faq-q" type="button">${f[0]}<span>${i===0?'−':'+'}</span></button><div class="faq-a">${f[1]}</div></div>`).join('');document.querySelectorAll('.faq-q').forEach(b=>b.addEventListener('click',()=>{const item=b.parentElement;item.classList.toggle('open');b.querySelector('span').textContent=item.classList.contains('open')?'−':'+'}));
</script>
</BaseLayout>