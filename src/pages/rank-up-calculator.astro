---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};

const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank."
>
  <main class="rank-page">
    <section class="hero">
      <div class="shell">
        <div class="crumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Rank Up Calculator</span></div>

        <div class="hero-layout">
          <div class="hero-copy">
            <span class="eyebrow">FC MOBILE / RANK LAB</span>
            <h1>Rank Up <em>Calculator</em></h1>
            <p>Plan the exact upgrade route for your player. Set the Base OVR, tap the current rank, choose the destination, and get the RP total instantly.</p>
            <div class="hero-meta">
              <span>LIVE CALCULATOR</span>
              <span>STATIC RANK ART</span>
              <span>RP BREAKDOWN</span>
            </div>
          </div>

          <div class="hero-rank" aria-hidden="true">
            <div class="hero-ring hero-ring-one"></div>
            <div class="hero-ring hero-ring-two"></div>
            <div class="hero-rank-core"><img src={RANK_ICONS[5]} alt="" /></div>
            <div class="hero-rank-label"><strong>Orange</strong><span>Maximum rank</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="shell content">
      <div class="planner">
        <div class="planner-topline"></div>

        <header class="planner-head">
          <div>
            <span class="eyebrow">RANK UP PLANNER</span>
            <h2>Build the upgrade</h2>
            <p>Everything updates as you change the selection.</p>
          </div>
          <div class="status-badge"><i></i><span>LIVE</span></div>
        </header>

        <div class="inputs">
          <label class="input-card">
            <div class="input-label">
              <span>BASE OVR</span>
              <small>PLAYER BASE</small>
            </div>
            <div class="input-control">
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" aria-label="Base OVR" />
              <span>OVR</span>
            </div>
          </label>

          <label class="input-card optional">
            <div class="input-label">
              <span>AVAILABLE RP</span>
              <small>OPTIONAL</small>
            </div>
            <div class="input-control">
              <input id="available" type="number" min="0" placeholder="—" inputmode="numeric" aria-label="Available Rank Up Points" />
              <span>RP</span>
            </div>
          </label>
        </div>

        <section class="rank-picker">
          <div class="picker-head">
            <div>
              <span class="eyebrow">RANK PATH</span>
              <h3>Choose the starting and finishing rank</h3>
              <p>Selecting a rank creates the route automatically.</p>
            </div>
            <div class="picker-route">
              <span id="routeFrom">Base</span>
              <i></i>
              <span id="routeTo">Orange</span>
            </div>
          </div>

          <div class="rank-stage">
            <div class="rank-column">
              <div class="rank-column-head">
                <span class="step-index">01</span>
                <div><span>CURRENT RANK</span><small>Your player's rank now</small></div>
              </div>
              <div class="rank-frame">
                <div id="currentChoices" class="rank-grid"></div>
              </div>
            </div>

            <div class="path-arrow" aria-hidden="true">
              <span></span><b>→</b><span></span>
            </div>

            <div class="rank-column">
              <div class="rank-column-head">
                <span class="step-index">02</span>
                <div><span>TARGET RANK</span><small>Your player's destination</small></div>
              </div>
              <div class="rank-frame">
                <div id="targetChoices" class="rank-grid"></div>
              </div>
            </div>
          </div>

          <input id="current" type="hidden" value="0" />
          <input id="target" type="hidden" value="5" />
          <div id="error" class="error" hidden></div>
        </section>

        <section class="results">
          <div class="result-summary">
            <article class="rp-card">
              <div class="summary-cap"><span class="eyebrow">TOTAL RP REQUIRED</span><span class="summary-line"></span></div>
              <div class="rp-main">
                <div class="rp-orb"><img src={RP_ICON} alt="" /></div>
                <strong id="required">0</strong>
                <span>RP</span>
              </div>
              <p id="status">Choose your upgrade route.</p>
              <div class="summary-route"><span id="miniFrom">Base</span><i>→</i><span id="miniTo">Orange</span></div>
            </article>

            <div class="stat-grid">
              <article>
                <span>OVR AFTER RANK</span>
                <strong id="ovr">110</strong>
                <small>Base OVR + rank</small>
              </article>
              <article>
                <span>RANKS GAINED</span>
                <strong id="gained">0</strong>
                <small>Total upgrade steps</small>
              </article>
              <article>
                <span>SKILL POINTS</span>
                <strong id="skills">0</strong>
                <small>Earned from ranks</small>
              </article>
              <article>
                <span>RP BALANCE</span>
                <strong id="remaining">—</strong>
                <small>After the upgrade</small>
              </article>
            </div>
          </div>

          <section class="cost-panel">
            <div class="cost-head">
              <div>
                <span class="eyebrow">COST BREAKDOWN</span>
                <h3>Upgrade steps</h3>
                <p>Simple table. One row per rank-up.</p>
              </div>
              <div class="total-pill"><span>TOTAL</span><strong id="costTotal">0 RP</strong></div>
            </div>

            <div class="table-wrap">
              <table class="cost-table">
                <thead>
                  <tr>
                    <th>STEP</th>
                    <th>UPGRADE</th>
                    <th>BASE OVR</th>
                    <th>RP REQUIRED</th>
                  </tr>
                </thead>
                <tbody id="stepRows"></tbody>
              </table>
            </div>
          </section>
        </section>
      </div>

      <section class="reference">
        <div class="reference-head">
          <div>
            <span class="eyebrow">REFERENCE</span>
            <h2>RP cost by Base OVR</h2>
            <p>The exact configured cost for each individual rank step.</p>
          </div>
          <div class="ref-mark">FCMOBILETOOLS <span>/</span> DATA</div>
        </div>

        <div class="reference-wrap">
          <table>
            <thead>
              <tr>
                <th>BASE OVR</th>
                <th>GREEN</th>
                <th>BLUE</th>
                <th>PURPLE</th>
                <th>RED</th>
                <th>ORANGE</th>
              </tr>
            </thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  {row.costs.map((cost) => <td>{fmt(cost)} RP</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </section>

    <section class="faq">
      <div class="shell">
        <span class="eyebrow">HELP</span>
        <h2>Rank Up Calculator FAQ</h2>
        <div class="faq-grid">
          <details open><summary>How does the calculator work?</summary><p>The calculator reads the Base OVR bracket and adds each rank-up cost from your current rank to the target rank.</p></details>
          <details><summary>Which ranks are supported?</summary><p>Base, Green, Blue, Purple, Red and Orange.</p></details>
          <details><summary>What does Available RP do?</summary><p>Enter your current RP balance to see how much remains after the selected upgrade route.</p></details>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const ICONS = {
      0:'/assets/images/rankup/rankicon_25_RANK0.png',
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return '<img src="'+ICONS[value]+'" alt="" loading="eager" />';
    }

    function makeRankButtons(kind){
      return RANKS.map((rank) =>
        '<button class="rank-tile" type="button" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-tile-bg"></span>'
          +'<span class="rank-tile-shine"></span>'
          +'<span class="rank-tile-art">'+icon(rank.value)+'</span>'
          +'<span class="rank-tile-name">'+rank.name+'</span>'
          +'<span class="rank-tile-check"></span>'
        +'</button>'
      ).join('');
    }

    function buildSelectors(){
      currentChoices.innerHTML = makeRankButtons('current');
      targetChoices.innerHTML = makeRankButtons('target');

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value >= to;
        button.classList.toggle('selected', value === from);
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value <= from;
        button.classList.toggle('selected', value === to);
      });
    }

    function renderTable(data){
      $('costTotal').textContent = fmt(data.requiredRP)+' RP';

      if(!data.steps.length){
        $('stepRows').innerHTML = '<tr><td colspan="4" class="table-empty">No upgrade steps are required for this route.</td></tr>';
        return;
      }

      $('stepRows').innerHTML = data.steps.map((step, index) =>
        '<tr>'
          +'<td><span class="step-num">'+String(index + 1).padStart(2,'0')+'</span></td>'
          +'<td><div class="upgrade-cell"><strong>'+rankName(step.from)+'</strong><span>→</span><strong>'+rankName(step.to)+'</strong></div></td>'
          +'<td>'+data.bracket.label+'</td>'
          +'<td><strong class="rp-amount">'+fmt(step.cost)+' RP</strong></td>'
        +'</tr>'
      ).join('');
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label+' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('miniFrom').textContent = rankName(data.currentRank);
      $('miniTo').textContent = rankName(data.targetRank);
      $('routeFrom').textContent = rankName(data.currentRank);
      $('routeTo').textContent = rankName(data.targetRank);

      renderTable(data);
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', render));
    render();
  </script>

  <style>
    :root{
      --r-bg:#050b11;
      --r-panel:#09131d;
      --r-panel-2:#0c1925;
      --r-panel-3:#102332;
      --r-line:rgba(255,255,255,.085);
      --r-line-soft:rgba(255,255,255,.045);
      --r-text:#f4f9fb;
      --r-muted:#8fa7b4;
      --r-dim:#5d7481;
      --r-cyan:#49ccff;
      --r-cyan-bright:#a7ebff;
      --r-glow:rgba(73,204,255,.24);
      --r-head:'Space Grotesk',system-ui,sans-serif;
      --r-body:'Inter',system-ui,sans-serif;
    }

    .rank-page{
      min-height:100vh;
      color:var(--r-text);
      background:
        radial-gradient(900px 500px at 8% -5%,rgba(73,204,255,.11),transparent 66%),
        radial-gradient(780px 480px at 95% 10%,rgba(73,204,255,.06),transparent 70%),
        linear-gradient(180deg,#050b11 0%,#07111a 54%,#050c12 100%);
      overflow:hidden;
    }

    .shell{width:min(1180px,calc(100% - 36px));margin:0 auto}
    .hero{position:relative;border-bottom:1px solid var(--r-line);background:linear-gradient(180deg,rgba(5,11,17,.98),rgba(5,11,17,.72))}
    .hero:after{content:"";position:absolute;left:12%;right:12%;bottom:0;height:1px;background:linear-gradient(90deg,transparent,rgba(73,204,255,.52),transparent)}
    .hero .shell{padding:27px 0 48px}
    .crumb{display:flex;align-items:center;gap:9px;margin-bottom:48px;color:#5b727f;font:800 9px/1 var(--r-head)}
    .crumb a{color:var(--r-cyan);text-decoration:none}
    .hero-layout{display:grid;grid-template-columns:minmax(0,1fr) 210px;align-items:center;gap:62px}
    .eyebrow{color:var(--r-cyan);font:900 9px/1 var(--r-head);letter-spacing:.16em}
    .hero h1{margin:14px 0 17px;font:800 clamp(52px,7vw,84px)/.86 var(--r-head);letter-spacing:-.075em}
    .hero h1 em{font-style:normal;color:var(--r-cyan)}
    .hero-copy>p{max-width:720px;margin:0;color:var(--r-muted);font:500 13px/1.8 var(--r-body)}
    .hero-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
    .hero-meta span{padding:7px 10px;border:1px solid var(--r-line);border-radius:999px;color:#728b98;background:rgba(255,255,255,.012);font:900 7px/1 var(--r-head);letter-spacing:.08em}

    .hero-rank{position:relative;display:grid;justify-items:center;padding:20px 15px 16px;border:1px solid rgba(73,204,255,.16);border-radius:26px;background:linear-gradient(145deg,#0c202d,#08131c);box-shadow:0 30px 80px rgba(0,0,0,.28);overflow:hidden}
    .hero-rank:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(73,204,255,.08),transparent 48%);pointer-events:none}
    .hero-rank-core{position:relative;display:grid;place-items:center;width:145px;height:145px}
    .hero-rank-core img{width:136px;height:136px;object-fit:contain;filter:drop-shadow(0 18px 30px rgba(0,0,0,.4))}
    .hero-ring{position:absolute;border-radius:50%;border:1px solid rgba(73,204,255,.14)}
    .hero-ring-one{width:158px;height:158px;animation:spin 18s linear infinite}
    .hero-ring-two{width:122px;height:122px;border-color:rgba(73,204,255,.08);animation:spin-reverse 12s linear infinite}
    .hero-rank-label{text-align:center}.hero-rank-label strong{display:block;margin-top:3px;font:900 24px/1 var(--r-head)}.hero-rank-label span{display:block;margin-top:5px;color:#708a97;font:700 8px/1 var(--r-head)}
    @keyframes spin{to{transform:rotate(360deg)}}@keyframes spin-reverse{to{transform:rotate(-360deg)}}

    .content{padding:38px 0 70px}
    .planner,.reference{border:1px solid var(--r-line);border-radius:26px;background:linear-gradient(145deg,#091520,#071019);box-shadow:0 30px 100px rgba(0,0,0,.24);overflow:hidden}
    .planner{position:relative}
    .planner-topline{height:2px;background:linear-gradient(90deg,transparent,rgba(73,204,255,.48),rgba(167,235,255,.84),transparent)}
    .planner-head{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:24px 28px;border-bottom:1px solid var(--r-line)}
    .planner-head h2,.reference h2,.faq h2{margin:7px 0 5px;font:800 27px/1 var(--r-head);letter-spacing:-.045em}
    .planner-head p,.reference-head p{margin:0;color:var(--r-muted);font:500 10px/1.55 var(--r-body)}
    .status-badge{display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid rgba(73,204,255,.13);border-radius:999px;color:#78929f;font:900 7px/1 var(--r-head);letter-spacing:.12em}
    .status-badge i{width:6px;height:6px;border-radius:50%;background:var(--r-cyan);box-shadow:0 0 0 rgba(73,204,255,.7);animation:pulse 2.2s ease-out infinite}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(73,204,255,0)}55%{box-shadow:0 0 0 7px rgba(73,204,255,0)}20%{box-shadow:0 0 0 0 rgba(73,204,255,.45)}}

    .inputs{display:grid;grid-template-columns:1fr 1fr;gap:11px;padding:19px 28px 9px}
    .input-card{padding:14px 15px;border:1px solid var(--r-line-soft);border-radius:17px;background:linear-gradient(145deg,rgba(255,255,255,.018),rgba(255,255,255,.005))}
    .input-label{display:flex;justify-content:space-between;gap:10px;margin-bottom:9px;color:#718895;font:900 8px/1 var(--r-head);letter-spacing:.12em}
    .input-label small{color:#4b6572;font:900 7px/1 var(--r-head);letter-spacing:.08em}
    .input-control{display:flex;align-items:center;gap:10px}
    .input-control input{width:100%;min-width:0;height:46px;border:1px solid #294250;border-radius:12px;background:#07131c;color:var(--r-text);padding:0 13px;outline:0;font:900 13px var(--r-head);transition:border-color .18s,box-shadow .18s,background .18s}
    .input-control input:focus{border-color:rgba(73,204,255,.72);background:#081620;box-shadow:0 0 0 3px rgba(73,204,255,.09),0 0 30px rgba(73,204,255,.06)}
    .input-control>span{color:#56727f;font:900 8px/1 var(--r-head)}

    .rank-picker{padding:22px 28px 28px}
    .picker-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:18px}
    .picker-head h3{margin:7px 0 0;font:800 20px/1 var(--r-head);letter-spacing:-.035em}
    .picker-head p{margin:5px 0 0;color:#607986;font:500 9px/1.45 var(--r-body)}
    .picker-route{display:flex;align-items:center;gap:9px;padding:9px 11px;border:1px solid rgba(73,204,255,.14);border-radius:999px;background:rgba(73,204,255,.028);color:#9bb1bb;font:900 8px/1 var(--r-head);white-space:nowrap}
    .picker-route i{width:19px;height:1px;background:#42616f}

    .rank-stage{display:grid;grid-template-columns:minmax(0,1fr) 38px minmax(0,1fr);align-items:stretch;gap:12px}
    .rank-column-head{display:flex;align-items:center;gap:10px;margin:0 0 10px 2px}
    .step-index{display:grid;place-items:center;width:29px;height:29px;border:1px solid rgba(73,204,255,.18);border-radius:8px;background:#0a2030;color:var(--r-cyan);font:900 8px/1 var(--r-head)}
    .rank-column-head span:not(.step-index){display:block;color:#d7e8ee;font:900 8px/1 var(--r-head);letter-spacing:.11em}
    .rank-column-head small{display:block;margin-top:4px;color:#4e6976;font:500 7px/1 var(--r-body)}
    .rank-frame{padding:12px;border:1px solid rgba(255,255,255,.065);border-radius:20px;background:linear-gradient(145deg,#08131c,#061019);box-shadow:inset 0 1px 0 rgba(255,255,255,.02)}
    .rank-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}

    .rank-tile{
      position:relative;
      width:100%;
      min-width:0;
      height:116px;
      padding:9px 6px 8px;
      border:1px solid rgba(255,255,255,.07);
      border-radius:16px;
      background:linear-gradient(145deg,#0a1620,#071119);
      color:var(--r-text);
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:3px;
      cursor:pointer;
      overflow:hidden;
      isolation:isolate;
      transition:transform .24s cubic-bezier(.2,.8,.2,1),border-color .22s,box-shadow .24s,background .22s,opacity .2s;
    }
    .rank-tile:after{
      content:"";
      position:absolute;
      inset:1px;
      border-radius:15px;
      border:1px solid transparent;
      background:linear-gradient(145deg,rgba(255,255,255,.05),transparent 34%,rgba(73,204,255,.015)) border-box;
      mask:linear-gradient(#fff 0 0) padding-box,linear-gradient(#fff 0 0);
      mask-composite:exclude;
      pointer-events:none;
      z-index:2;
    }
    .rank-tile:hover:not(:disabled){
      transform:translateY(-4px);
      border-color:rgba(73,204,255,.24);
      background:linear-gradient(145deg,#0c1b27,#09141d);
      box-shadow:0 16px 32px rgba(0,0,0,.25),0 0 30px rgba(73,204,255,.045);
    }
    .rank-tile.selected{
      border-color:rgba(73,204,255,.92);
      background:
        radial-gradient(90px 75px at 50% 12%,rgba(73,204,255,.20),transparent 72%),
        linear-gradient(145deg,#102739,#08141d);
      box-shadow:
        inset 0 0 0 1px rgba(167,235,255,.13),
        inset 0 -18px 35px rgba(73,204,255,.035),
        0 0 0 1px rgba(73,204,255,.10),
        0 12px 36px rgba(73,204,255,.10);
      animation:selectedLift 2.7s ease-in-out infinite;
    }
    @keyframes selectedLift{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
    .rank-tile-bg{
      position:absolute;
      width:85px;
      height:85px;
      top:-36px;
      left:50%;
      transform:translateX(-50%);
      border-radius:50%;
      background:rgba(73,204,255,.18);
      filter:blur(23px);
      opacity:0;
      transition:opacity .22s,transform .32s;
      z-index:-1;
    }
    .rank-tile.selected .rank-tile-bg{opacity:1;transform:translateX(-50%) scale(1.13);animation:tileGlow 2.6s ease-in-out infinite}
