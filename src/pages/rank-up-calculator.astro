---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAX_RANK, RANK_NAMES, RANK_COLORS } from '../data/rankUpCalculator.js';
---

<BaseLayout title="FC Mobile Rank Up Calculator" description="Calculate FC Mobile 26 Rank Up Points, OVR gain, Skill Points and affordability from Base OVR and rank.">
  <main class="rank-page">
    <div class="rank-wrap">
      <header class="rank-header">
        <div>
          <div class="eyebrow">FC MOBILE 26 / TOOL</div>
          <h1>Rank Up Calculator</h1>
          <p>Plan your next rank with the current Rank Up Point system. Costs always use the player's Base OVR bracket.</p>
        </div>
        <div class="system-pill"><i></i> Rank Up Points</div>
      </header>

      <section class="rank-grid">
        <section class="panel setup-panel">
          <div class="panel-head"><div><span>01</span><h2>Player setup</h2></div><small>Enter the player's base state</small></div>
          <div class="form-grid">
            <label>Base OVR<input id="baseOVR" type="number" min="0" max="130" step="1" value="107" inputmode="numeric" /></label>
            <label>Current Rank<select id="currentRank">{Array.from({ length: MAX_RANK + 1 }, (_, rank) => <option value={rank} selected={rank === 4}>Rank {rank}{rank ? ` · ${RANK_NAMES[rank]}` : ''}</option>)}</select></label>
            <label>Target Rank<select id="targetRank">{Array.from({ length: MAX_RANK + 1 }, (_, rank) => <option value={rank} selected={rank === 5}>Rank {rank}{rank ? ` · ${RANK_NAMES[rank]}` : ''}</option>)}</select></label>
            <label>Available Rank Up Points<span class="optional">optional</span><input id="availablePoints" type="number" min="0" step="1" placeholder="e.g. 1200" inputmode="numeric" /></label>
          </div>
          <div class="quick-row"><span>Quick target</span><button data-add="1">+1</button><button data-add="2">+2</button><button data-add="3">+3</button><button data-max>MAX</button></div>
        </section>

        <section class="panel rank-panel">
          <div class="panel-head"><div><span>02</span><h2>Rank path</h2></div><small>Current → target</small></div>
          <div id="rankPath" class="rank-path" aria-label="Rank progression"></div>
          <div class="bracket-row"><span>Base OVR bracket</span><strong id="bracket">105–109</strong></div>
        </section>
      </section>

      <section id="result" class="result-panel" aria-live="polite"></section>

      <section class="lower-grid">
        <section class="panel progression-panel">
          <div class="panel-head"><div><span>03</span><h2>Upgrade breakdown</h2></div><small>Individual rank costs</small></div>
          <div id="steps"></div>
        </section>
        <section class="panel affordability-panel">
          <div class="panel-head"><div><span>04</span><h2>Affordability</h2></div><small>Based on your balance</small></div>
          <div id="affordability"></div>
        </section>
      </section>

      <section class="panel reference-panel">
        <div class="panel-head"><div><span>05</span><h2>Rank Up reference</h2></div><small>Configured FC Mobile 26 costs</small></div>
        <div id="reference"></div>
      </section>

      <details class="rules-panel">
        <summary>How Rank Up is calculated</summary>
        <div class="rules-copy">
          <p><strong>Base OVR → bracket → Rank Up Point cost.</strong> The displayed OVR after previous ranks never changes the cost bracket. A 107 Base OVR player remains in the 105–109 bracket even at Rank 4.</p>
          <p>Total cost is the cumulative cost at the target rank minus the cumulative cost at the current rank. Every rank adds +1 displayed OVR and +1 Skill Point.</p>
          <p>Training XP, market price, duplicate cards, Mascherano, Dudek and success probabilities are not part of this calculator.</p>
        </div>
      </details>
    </div>
  </main>
</BaseLayout>

<style>
.rank-page{--rp-blue:#55c7f2;--rp-blue-soft:#55c7f21a;--rp-bg:#f4fbfe;--rp-panel:#fff;--rp-ink:#10222c;--rp-muted:#6c818b;--rp-line:#dbeaf0;min-height:100vh;background:radial-gradient(circle at 85% 0%,#bcecff 0,transparent 28%),linear-gradient(180deg,#f7fcfe,#eef7fa);color:var(--rp-ink);padding:42px 20px 80px}.rank-wrap{max-width:1120px;margin:auto}.rank-header{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding:20px 0 34px}.eyebrow,.panel-head>div>span{font:900 10px var(--mono);letter-spacing:.14em;color:#159ed0}.rank-header h1{font-size:clamp(42px,6vw,70px);line-height:.92;letter-spacing:-.065em;margin:10px 0 14px}.rank-header p{max-width:680px;color:var(--rp-muted);font-size:14px;line-height:1.7;margin:0}.system-pill{white-space:nowrap;border:1px solid #cbe5ee;background:#fff;border-radius:999px;padding:10px 14px;font:900 9px var(--mono);color:#47717f;box-shadow:0 8px 25px #31758d12}.system-pill i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--rp-blue);margin-right:8px}.rank-grid,.lower-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:14px}.panel,.result-panel{background:rgba(255,255,255,.92);border:1px solid var(--rp-line);border-radius:20px;box-shadow:0 16px 45px rgba(38,95,113,.08)}.panel{padding:22px}.panel-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:20px}.panel-head>div{display:flex;align-items:center;gap:10px}.panel-head h2{font-size:18px;letter-spacing:-.02em;margin:0}.panel-head small{font-size:10px;color:#8aa0aa}.form-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}label{display:grid;gap:8px;font-size:10px;font-weight:900;color:#5d747e}input,select{width:100%;box-sizing:border-box;border:1px solid #cfe2e9;background:#f9fdfe;color:#152b35;border-radius:11px;padding:13px 11px;font:800 13px var(--mono);outline:0;transition:.18s}input:focus,select:focus{border-color:var(--rp-blue);box-shadow:0 0 0 3px var(--rp-blue-soft)}.optional{font-weight:600;color:#9aacb4;margin-left:5px}.quick-row{display:flex;align-items:center;gap:7px;margin-top:15px;font:800 9px var(--mono);color:#8aa0aa}.quick-row button{border:1px solid #cfe2e9;background:#f5fbfd;color:#347189;border-radius:8px;padding:8px 12px;font:900 9px var(--mono);cursor:pointer;transition:.18s}.quick-row button:hover{border-color:var(--rp-blue);background:var(--rp-blue-soft);color:#087eae}.rank-path{display:flex;align-items:center;justify-content:space-between;gap:5px;padding:18px 3px 22px}.rank-node{display:grid;justify-items:center;gap:7px;min-width:44px}.rank-node .orb{width:39px;height:39px;border-radius:50%;display:grid;place-items:center;background:#edf4f6;border:2px solid #d4e4e9;font:900 11px var(--mono);color:#71858d;position:relative}.rank-node.active .orb{border-color:var(--rp-blue);box-shadow:0 0 0 5px var(--rp-blue-soft);color:#087da9;background:#fff}.rank-node.target .orb{background:#0e2934;color:#fff;border-color:#0e2934;box-shadow:0 8px 18px #0e293433}.rank-node small{font:900 7px var(--mono);color:#8499a1;text-transform:uppercase}.rank-node.active small,.rank-node.target small{color:#138bb7}.rank-line{height:2px;flex:1;background:#dbe8ec;min-width:8px}.bracket-row{border-top:1px solid var(--rp-line);padding-top:14px;display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--rp-muted)}.bracket-row strong{font:900 12px var(--mono);color:#1d89ad}.result-panel{margin:14px 0;padding:26px;background:linear-gradient(135deg,#102b38,#123e50);color:#f1fbff;border-color:#19495c;box-shadow:0 22px 55px rgba(14,68,91,.18)}.result-main{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:center}.result-kicker{font:900 9px var(--mono);letter-spacing:.14em;color:#7bdcff}.required{font:900 clamp(44px,6vw,68px) var(--mono);letter-spacing:-.07em;line-height:1;margin:7px 0}.required small{font-size:14px;letter-spacing:0;color:#86a9b7}.result-path-label{font-size:11px;color:#94b0bc}.result-path-label strong{color:#fff}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.hero-stat{padding:14px;border:1px solid #ffffff16;background:#ffffff08;border-radius:13px}.hero-stat span{display:block;font:800 8px var(--mono);color:#78a1af;margin-bottom:7px}.hero-stat strong{font:900 17px var(--mono)}.status{margin-top:15px;padding:11px 13px;border-radius:11px;font:900 10px var(--mono)}.status.good{background:#7dffd018;color:#a8ffd5}.status.bad{background:#ff767614;color:#ffb1b1}.status.neutral{background:#ffffff0b;color:#a9c1ca}.lower-grid{margin-top:14px}.step-row{display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:13px;padding:13px 0;border-bottom:1px solid var(--rp-line)}.step-row:last-child{border-bottom:0}.step-rank{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:#eef8fb;border:1px solid #d3e9f0;font:900 10px var(--mono);color:#188fb7}.step-row b{font-size:12px}.step-row span{display:block;font-size:9px;color:var(--rp-muted);margin-top:3px}.step-cost{font:900 13px var(--mono);color:#1a8db5}.total-row{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--rp-line);margin-top:6px;padding-top:15px;font-size:11px}.total-row strong{font:900 18px var(--mono)}.affordance{display:grid;gap:12px}.affordance-main{padding:20px;border-radius:15px;background:#f1fafd;border:1px solid #d7edf4}.affordance-main strong{display:block;font:900 27px var(--mono);color:#117fa6}.affordance-main span{font-size:10px;color:var(--rp-muted)}.balance-bar{height:9px;border-radius:99px;background:#deebef;overflow:hidden;margin:15px 0 9px}.balance-bar i{display:block;height:100%;border-radius:inherit;background:var(--rp-blue);transition:width .2s}.balance-meta{display:flex;justify-content:space-between;font:800 8px var(--mono);color:#78909a}.affordable-ranks{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:3px}.affordable-rank{padding:9px 5px;border-radius:9px;text-align:center;background:#f6fafb;border:1px solid var(--rp-line);font:900 8px var(--mono);color:#82969e}.affordable-rank.yes{color:#0a8c65;border-color:#bde8d8;background:#f0fbf7}.affordable-rank.no{color:#bd6970}.reference-panel{margin-top:14px}.reference-table{width:100%;border-collapse:collapse;font-size:10px}.reference-table th{text-align:left;color:#82979f;font:900 8px var(--mono);text-transform:uppercase;letter-spacing:.08em}.reference-table th,.reference-table td{padding:10px 8px;border-bottom:1px solid var(--rp-line)}.reference-table tr:last-child td{border-bottom:0}.reference-table .selected{background:#f0fbfe}.reference-table td:not(:first-child){font:900 10px var(--mono);text-align:center}.rank-chip{display:inline-flex;align-items:center;gap:7px}.rank-chip i{width:7px;height:7px;border-radius:50%;display:inline-block}.rank-chip .green{background:#32b979}.rank-chip .blue{background:#318ff2}.rank-chip .purple{background:#8d58d7}.rank-chip .red{background:#e34e55}.rank-chip .orange{background:#f39a35}.rules-panel{margin-top:14px;border:1px solid var(--rp-line);background:#fff;border-radius:16px;padding:16px 18px;color:var(--rp-ink)}.rules-panel summary{cursor:pointer;font:900 10px var(--mono);color:#397184}.rules-copy{max-width:850px;color:var(--rp-muted);font-size:11px;line-height:1.7}.rules-copy strong{color:#285766}@media(max-width:850px){.form-grid{grid-template-columns:1fr 1fr}.rank-grid,.lower-grid{grid-template-columns:1fr}.rank-header{align-items:start}.result-main{grid-template-columns:1fr}}@media(max-width:560px){.rank-page{padding:25px 13px 55px}.rank-header{display:block}.system-pill{display:inline-block;margin-top:18px}.panel,.result-panel{padding:18px;border-radius:16px}.form-grid{grid-template-columns:1fr}.hero-stats{grid-template-columns:1fr 1fr}.hero-stat:last-child{grid-column:1/-1}.rank-path{overflow:hidden}.rank-node{min-width:37px}.rank-node .orb{width:34px;height:34px}.reference-table{font-size:8px}.reference-table th,.reference-table td{padding:8px 4px}.affordable-ranks{grid-template-columns:repeat(2,1fr)}}
</style>

<script>
  import { calculateRankUp } from '../lib/rankUpCalculator.js';
  import { MAX_RANK, RANK_NAMES, RANK_COLORS, RANK_UP_COSTS } from '../data/rankUpCalculator.js';

  const baseOVR = document.querySelector('#baseOVR');
  const currentRank = document.querySelector('#currentRank');
  const targetRank = document.querySelector('#targetRank');
  const availablePoints = document.querySelector('#availablePoints');
  const rankPath = document.querySelector('#rankPath');
  const bracket = document.querySelector('#bracket');
  const result = document.querySelector('#result');
  const steps = document.querySelector('#steps');
  const affordability = document.querySelector('#affordability');
  const reference = document.querySelector('#reference');
  const format = (value) => new Intl.NumberFormat('en-US').format(value);

  function syncTargetOptions() {
    const current = Number(currentRank.value);
    [...targetRank.options].forEach((option) => {
      option.disabled = Number(option.value) < current;
    });
    if (Number(targetRank.value) < current) targetRank.value = String(current);
  }

  function renderPath(current, target) {
    rankPath.innerHTML = Array.from({ length: MAX_RANK + 1 }, (_, rank) => `${rank > 0 ? '<div class="rank-line"></div>' : ''}<div class="rank-node ${rank === current ? 'active' : ''} ${rank === target && target !== current ? 'target' : ''}"><div class="orb">R${rank}</div><small>${RANK_NAMES[rank]}</small></div>`).join('');
  }

  function renderReference(selectedBracket) {
    reference.innerHTML = `<div style="overflow-x:auto"><table class="reference-table"><thead><tr><th>Base OVR</th>${[1,2,3,4,5].map((rank) => `<th>R${rank}</th>`).join('')}</tr></thead><tbody>${Object.entries(RANK_UP_COSTS).map(([id, costs]) => `<tr class="${id === selectedBracket ? 'selected' : ''}"><td><span class="rank-chip">${id === selectedBracket ? '● ' : ''}${id.replace('-', '–')}</span></td>${[1,2,3,4,5].map((rank) => `<td>${format(costs[rank])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
  }

  function render() {
    syncTargetOptions();
    const data = calculateRankUp({ baseOVR: baseOVR.value, currentRank: currentRank.value, targetRank: targetRank.value, availablePoints: availablePoints.value });
    if (!data.valid) {
      result.innerHTML = `<div class="result-kicker">CHECK YOUR SETUP</div><div class="required" style="font-size:32px">${data.error}</div>`;
      steps.innerHTML = '';
      affordability.innerHTML = '';
      bracket.textContent = '—';
      rankPath.innerHTML = '';
      return;
    }

    renderPath(data.currentRank, data.targetRank);
    bracket.textContent = data.bracket.label;
    renderReference(data.bracket.id);

    const balanceText = data.availablePoints == null ? 'Add your balance to check affordability' : data.affordable ? `✓ You have enough Rank Up Points` : `✕ You need ${format(Math.abs(data.remainingPoints))} more Rank Up Points`;
    const statusClass = data.availablePoints == null ? 'neutral' : data.affordable ? 'good' : 'bad';
    const progress = data.availablePoints == null ? 0 : Math.min(100, Math.max(0, (data.availablePoints / Math.max(data.requiredPoints, 1)) * 100));
    result.innerHTML = `<div class="result-main"><div><div class="result-kicker">RANK UP POINTS REQUIRED</div><div class="required">${format(data.requiredPoints)} <small>RP</small></div><div class="result-path-label">Rank ${data.currentRank} → Rank ${data.targetRank} · <strong>Base OVR ${data.baseOVR}</strong> · ${data.bracket.label} bracket</div></div><div class="hero-stats"><div class="hero-stat"><span>OVR</span><strong>${data.baseOVR + data.currentRank} → ${data.targetOVR}</strong></div><div class="hero-stat"><span>SKILL POINTS</span><strong>+${data.skillPoints}</strong></div><div class="hero-stat"><span>REMAINING</span><strong>${data.remainingPoints == null ? '—' : format(data.remainingPoints)}</strong></div></div></div><div class="status ${statusClass}">${balanceText}</div>`;

    steps.innerHTML = data.steps.length ? `${data.steps.map((step) => `<div class="step-row"><div class="step-rank">R${step.to}</div><div><b>Rank ${step.from} → Rank ${step.to}</b><span>${RANK_NAMES[step.to]} rank · +1 OVR · +1 Skill Point</span></div><div class="step-cost">${format(step.cost)} RP</div></div>`).join('')}<div class="total-row"><span>Total for this upgrade</span><strong>${format(data.requiredPoints)} RP</strong></div>` : '<div class="affordance-main"><strong>Already here</strong><span>Current and target Rank are the same.</span></div>';

    if (data.availablePoints == null) {
      affordability.innerHTML = `<div class="affordance-main"><strong>Add your balance</strong><span>Enter Available Rank Up Points above to see whether this target is affordable and your maximum affordable Rank.</span></div>`;
    } else {
      const maxCost = data.maxAffordableRank > data.currentRank ? data.costs[data.maxAffordableRank] : 0;
      const used = data.maxAffordableRank === data.currentRank ? 0 : data.maxAffordableRank === 0 ? 0 : data.costs[data.maxAffordableRank];
      const cumulativeFromCurrent = data.maxAffordableRank > data.currentRank ? data.costs[data.maxAffordableRank] : 0;
      const currentCum = data.costs[data.currentRank] || 0;
      const usedFromCurrent = cumulativeFromCurrent - currentCum;
      affordability.innerHTML = `<div class="affordance"><div class="affordance-main"><strong>Rank ${data.maxAffordableRank}</strong><span>Maximum affordable Rank · ${format(usedFromCurrent)} RP used · ${format(Math.max(0, data.availablePoints - usedFromCurrent))} RP remaining</span><div class="balance-bar"><i style="width:${progress}%"></i></div><div class="balance-meta"><span>${format(data.availablePoints)} RP balance</span><span>${format(data.requiredPoints)} RP target</span></div></div><div class="affordable-ranks">${Array.from({length:MAX_RANK},(_,i)=>i+1).map((rank)=>{const cost=getCostFromCurrent(data,rank);return `<div class="affordable-rank ${cost <= data.availablePoints ? 'yes':'no'}">R${rank} ${cost <= data.availablePoints ? '✓':'×'}</div>`}).join('')}</div></div>`;
    }
  }

  function getCostFromCurrent(data, rank) {
    if (rank <= data.currentRank) return 0;
    return data.costs[rank] - (data.costs[data.currentRank] || 0);
  }

  [baseOVR, currentRank, targetRank, availablePoints].forEach((el) => el.addEventListener('input', render));
  document.querySelectorAll('[data-add]').forEach((button) => button.addEventListener('click', () => { targetRank.value = String(Math.min(MAX_RANK, Number(currentRank.value) + Number(button.dataset.add))); render(); }));
  document.querySelector('[data-max]').addEventListener('click', () => { targetRank.value = String(MAX_RANK); render(); });
  render();
</script>
