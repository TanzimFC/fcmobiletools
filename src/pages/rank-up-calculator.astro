---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAX_RANK, RANK_NAMES, RANK_UP_COSTS } from '../data/rankUpCalculator.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator" description="Calculate FC Mobile 26 Rank Up Points, OVR gain, Skill Points and affordability from Base OVR and rank.">
<main class="rank-page"><div class="wrap rank-wrap">
<header class="rank-header"><div><div class="eyebrow">FC MOBILE 26 / TOOL</div><h1>Rank Up Calculator</h1><p>Calculate the exact Rank Up Points needed for any Base OVR and rank path.</p></div><div class="system-pill"><i></i> Rank Up Points</div></header>
<section class="top-grid">
<section class="panel setup"><div class="panel-head"><div><b>01</b><h2>Player setup</h2></div><small>Base state only</small></div><div class="fields"><label>Base OVR<input id="baseOVR" type="number" min="0" max="130" step="1" value="107"></label><label>Current Rank<select id="currentRank">{Array.from({length:6},(_,r)=><option value={r} selected={r===4}>Rank {r}{r?` · ${RANK_NAMES[r]}`:''}</option>)}</select></label><label>Target Rank<select id="targetRank">{Array.from({length:6},(_,r)=><option value={r} selected={r===5}>Rank {r}{r?` · ${RANK_NAMES[r]}`:''}</option>)}</select></label><label>Available RP <em>optional</em><input id="availablePoints" type="number" min="0" step="1" placeholder="1200"></label></div><div class="quick"><span>Quick target</span><button data-add="1">+1</button><button data-add="2">+2</button><button data-add="3">+3</button><button data-max>MAX</button></div></section>
<section class="panel path-panel"><div class="panel-head"><div><b>02</b><h2>Rank path</h2></div><small id="bracket">105–109</small></div><div id="rankPath" class="rank-path"></div><div class="path-note">Cost bracket always follows <strong>Base OVR</strong>, never displayed OVR.</div></section>
</section>
<section id="result" class="result" aria-live="polite"></section>
<section class="bottom-grid"><section class="panel"><div class="panel-head"><div><b>03</b><h2>Upgrade breakdown</h2></div><small>One rank at a time</small></div><div id="steps"></div></section><section class="panel"><div class="panel-head"><div><b>04</b><h2>Affordability</h2></div><small>Your balance</small></div><div id="affordability"></div></section></section>
<section class="panel reference"><div class="panel-head"><div><b>05</b><h2>Rank Up reference</h2></div><small>Rank 1 → Rank 5 cost</small></div><div id="reference"></div></section>
<details class="rules"><summary>Calculation rules</summary><p>Each rank adds +1 displayed OVR and +1 Skill Point. Total RP is the cumulative target cost minus the cumulative current cost. The player's Base OVR bracket never changes after ranking. Training XP, market price, duplicate cards, Mascherano, Dudek and success probabilities are not used.</p></details>
</div></main>
</BaseLayout>
<style>
.rank-page{--blue:#55c7f2;--ink:#10232d;--muted:#70858e;--line:#d9e9ef;min-height:100vh;background:radial-gradient(circle at 86% 0,#bfeeff,transparent 29%),linear-gradient(#f8fdff,#eef7fa);color:var(--ink);padding:40px 20px 80px}.rank-wrap{max-width:1120px}.rank-header{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:18px 0 32px}.eyebrow,.panel-head b{font:900 9px var(--mono);letter-spacing:.14em;color:#139bcf}.rank-header h1{font-size:clamp(44px,6vw,70px);line-height:.9;letter-spacing:-.065em;margin:10px 0 13px}.rank-header p{margin:0;color:var(--muted);font-size:14px}.system-pill{padding:10px 14px;border:1px solid #cce5ed;border-radius:99px;background:#fff;font:900 9px var(--mono);white-space:nowrap;color:#47707c}.system-pill i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--blue);margin-right:7px}.top-grid,.bottom-grid{display:grid;grid-template-columns:1.3fr .9fr;gap:14px}.bottom-grid{margin-top:14px}.panel,.result{border:1px solid var(--line);background:#fffffff2;border-radius:19px;box-shadow:0 16px 42px #235c7110}.panel{padding:22px}.panel-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:19px}.panel-head>div{display:flex;align-items:center;gap:10px}.panel-head h2{font-size:18px;margin:0}.panel-head small{font-size:9px;color:#8aa0a8}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}label{display:grid;gap:7px;font-size:9px;font-weight:900;color:#58717b}label em{font-style:normal;font-weight:600;color:#a0afb5}input,select{box-sizing:border-box;width:100%;padding:12px 10px;border:1px solid #cfe2e8;border-radius:10px;background:#f9fdfe;color:#152b35;font:800 12px var(--mono);outline:0}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55c7f21a}.quick{display:flex;align-items:center;gap:7px;margin-top:14px;font:800 8px var(--mono);color:#82979f}.quick button{border:1px solid #cfe2e8;background:#f5fbfd;color:#33728a;border-radius:8px;padding:7px 11px;font:900 8px var(--mono);cursor:pointer}.quick button:hover{border-color:var(--blue);background:#55c7f214}.rank-path{display:flex;align-items:center;gap:4px;padding:18px 0}.rank-node{flex:1;text-align:center}.rank-orb{width:40px;height:40px;margin:auto;border-radius:50%;display:grid;place-items:center;background:#eef5f7;border:2px solid #d5e4e9;color:#73868e;font:900 10px var(--mono)}.rank-node.current .rank-orb{background:#fff;border-color:var(--blue);box-shadow:0 0 0 5px #55c7f21a;color:#087da8}.rank-node.target .rank-orb{background:#0f2c38;border-color:#0f2c38;color:#fff}.rank-node small{display:block;margin-top:7px;font:900 6px var(--mono);color:#879aa1}.rank-connector{height:2px;flex:1;background:#dce8ec}.path-note{border-top:1px solid var(--line);padding-top:13px;font-size:9px;color:var(--muted)}.path-note strong{color:#1684a9}.result{margin:14px 0;padding:25px;background:linear-gradient(135deg,#102b38,#12465a);color:#effaff;border-color:#1b4e62}.result-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;align-items:center}.result-label{font:900 8px var(--mono);letter-spacing:.14em;color:#7bdcff}.rp-total{font:900 clamp(46px,6vw,68px) var(--mono);letter-spacing:-.07em;line-height:1;margin:6px 0}.rp-total small{font-size:13px;letter-spacing:0;color:#8cadb9}.result-sub{font-size:10px;color:#9ab5bf}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{padding:13px;border:1px solid #ffffff17;background:#ffffff09;border-radius:12px}.stat span{display:block;font:800 7px var(--mono);color:#78a1af;margin-bottom:6px}.stat strong{font:900 15px var(--mono)}.status{margin-top:14px;padding:10px 12px;border-radius:10px;font:900 9px var(--mono)}.good{background:#7dffd018;color:#aaffd5}.bad{background:#ff777714;color:#ffb6b6}.neutral{background:#ffffff0b;color:#aac1c9}.step{display:grid;grid-template-columns:43px 1fr auto;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-rank{width:37px;height:37px;display:grid;place-items:center;border-radius:10px;background:#eef9fc;color:#178bb2;font:900 9px var(--mono)}.step b{font-size:11px}.step span{display:block;color:var(--muted);font-size:8px;margin-top:3px}.step strong{font:900 12px var(--mono);color:#1588ae}.total{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:13px;margin-top:5px;font-size:10px}.total strong{font:900 17px var(--mono)}.afford-main{padding:18px;border-radius:14px;background:#f1fafd;border:1px solid #d7edf4}.afford-main strong{display:block;font:900 25px var(--mono);color:#117fa6}.afford-main span{font-size:9px;color:var(--muted)}.bar{height:8px;background:#dcebef;border-radius:99px;overflow:hidden;margin:14px 0 7px}.bar i{display:block;height:100%;background:var(--blue);border-radius:inherit}.bar-meta{display:flex;justify-content:space-between;font:800 7px var(--mono);color:#78909a}.afford-ranks{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}.afford-ranks div{padding:8px;text-align:center;border:1px solid var(--line);border-radius:8px;background:#fafcfd;font:900 8px var(--mono);color:#9a6c70}.afford-ranks .yes{color:#0a8d67;background:#f0fbf7;border-color:#bfe8da}.reference{margin-top:14px}.table-wrap{overflow-x:auto}.reference table{width:100%;border-collapse:collapse;font:800 9px var(--mono)}.reference th{text-align:center;color:#83979f;font-size:7px;letter-spacing:.08em}.reference th,.reference td{padding:9px 8px;border-bottom:1px solid var(--line)}.reference td{text-align:center}.reference td:first-child{text-align:left;font-family:inherit}.reference tr.selected{background:#f0fbfe}.rules{margin-top:14px;border:1px solid var(--line);border-radius:15px;background:#fff;padding:15px 17px;font-size:10px;color:var(--muted)}.rules summary{cursor:pointer;font:900 9px var(--mono);color:#397184}.rules p{line-height:1.7;margin-bottom:0}@media(max-width:850px){.fields{grid-template-columns:1fr 1fr}.top-grid,.bottom-grid{grid-template-columns:1fr}.result-grid{grid-template-columns:1fr}}@media(max-width:560px){.rank-page{padding:25px 13px 55px}.rank-header{display:block}.system-pill{display:inline-block;margin-top:16px}.panel,.result{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.stat:last-child{grid-column:1/-1}.rank-path{gap:1px}.rank-orb{width:34px;height:34px}.rank-node small{font-size:5px}.reference th,.reference td{padding:8px 4px;font-size:8px}}
</style>
<script>
import { calculateRankUp } from '../lib/rankUpCalculator.js';
import { MAX_RANK, RANK_NAMES, RANK_UP_COSTS } from '../data/rankUpCalculator.js';
const base=document.querySelector('#baseOVR'), current=document.querySelector('#currentRank'), target=document.querySelector('#targetRank'), available=document.querySelector('#availablePoints'), path=document.querySelector('#rankPath'), bracket=document.querySelector('#bracket'), result=document.querySelector('#result'), steps=document.querySelector('#steps'), afford=document.querySelector('#affordability'), reference=document.querySelector('#reference');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);
function sync(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c)}
function pathRender(c,t){path.innerHTML=Array.from({length:6},(_,r)=>`${r?'<div class="rank-connector"></div>':''}<div class="rank-node ${r===c?'current':''} ${r===t&&t!==c?'target':''}"><div class="rank-orb">R${r}</div><small>${RANK_NAMES[r]}</small></div>`).join('')}
function currentCost(data,r){let total=0;for(let x=data.currentRank+1;x<=r;x++)total+=data.costs[x];return total}
function refRender(id){reference.innerHTML=`<div class="table-wrap"><table><thead><tr><th>Base OVR</th>${[1,2,3,4,5].map(r=>`<th>R${r}</th>`).join('')}</tr></thead><tbody>${Object.entries(RANK_UP_COSTS).map(([k,c])=>`<tr class="${k===id?'selected':''}"><td>${k.replace('-', '–')}</td>${[1,2,3,4,5].map(r=>`<td>${fmt(c[r])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`}
function render(){sync();const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availablePoints:available.value});if(!d.valid){result.innerHTML=`<div class="result-label">CHECK YOUR SETUP</div><div class="rp-total" style="font-size:30px">${d.error}</div>`;path.innerHTML='';steps.innerHTML='';afford.innerHTML='';bracket.textContent='—';return}pathRender(d.currentRank,d.targetRank);bracket.textContent=d.bracket.label;refRender(d.bracket.id);const status=d.availablePoints==null?'Add your balance to check affordability':d.affordable?`✓ CAN RANK UP · ${fmt(d.remainingPoints)} RP remaining`:`✕ NEED ${fmt(Math.abs(d.remainingPoints))} MORE RP`;const cls=d.availablePoints==null?'neutral':d.affordable?'good':'bad';result.innerHTML=`<div class="result-grid"><div><div class="result-label">RANK UP POINTS REQUIRED</div><div class="rp-total">${fmt(d.requiredPoints)} <small>RP</small></div><div class="result-sub">Rank ${d.currentRank} → Rank ${d.targetRank} · Base OVR ${d.baseOVR} · ${d.bracket.label} bracket</div></div><div class="stats"><div class="stat"><span>OVR</span><strong>${d.baseOVR+d.currentRank} → ${d.targetOVR}</strong></div><div class="stat"><span>SKILL POINTS</span><strong>+${d.skillPoints}</strong></div><div class="stat"><span>REMAINING</span><strong>${d.remainingPoints==null?'—':fmt(d.remainingPoints)}</strong></div></div></div><div class="status ${cls}">${status}</div>`;steps.innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-rank">R${s.to}</div><div><b>Rank ${s.from} → Rank ${s.to}</b><span>${RANK_NAMES[s.to]} · +1 OVR · +1 Skill Point</span></div><strong>${fmt(s.cost)} RP</strong></div>`).join('')+`<div class="total"><span>Total</span><strong>${fmt(d.requiredPoints)} RP</strong></div>`:'<div class="afford-main"><strong>Already Rank '+d.currentRank+'</strong><span>No Rank Up Points are needed.</span></div>';
if(d.availablePoints==null){afford.innerHTML='<div class="afford-main"><strong>Add your balance</strong><span>Enter Available RP to see the maximum affordable Rank.</span></div>'}else{const used=currentCost(d,d.maxAffordableRank);const pct=Math.min(100,d.requiredPoints?Math.max(0,d.availablePoints/d.requiredPoints*100):100);afford.innerHTML=`<div class="afford-main"><strong>Rank ${d.maxAffordableRank}</strong><span>Maximum affordable Rank · ${fmt(used)} RP used · ${fmt(Math.max(0,d.availablePoints-used))} RP remaining</span><div class="bar"><i style="width:${pct}%"></i></div><div class="bar-meta"><span>${fmt(d.availablePoints)} RP balance</span><span>${fmt(d.requiredPoints)} RP target</span></div></div><div class="afford-ranks">${[1,2,3,4,5].map(r=>`<div class="${currentCost(d,r)<=d.availablePoints?'yes':''}">R${r} ${currentCost(d,r)<=d.availablePoints?'✓':'×'}</div>`).join('')}</div>`}}
[base,current,target,available].forEach(e=>e.addEventListener('input',render));document.querySelectorAll('[data-add]').forEach(b=>b.addEventListener('click',()=>{target.value=String(Math.min(MAX_RANK,Number(current.value)+Number(b.dataset.add)));render()}));document.querySelector('[data-max]').addEventListener('click',()=>{target.value=String(MAX_RANK);render()});render();
</script>