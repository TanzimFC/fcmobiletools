---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator | Rank Up Points & OVR | FCMOBILETOOLS" description="Calculate FC Mobile Rank Up Points, OVR gain, Skill Points and exact cost from any rank to Orange. Includes the complete Rank Up Points reference table.">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"FC Mobile Rank Up Calculator","applicationCategory":"UtilitiesApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"description":"Calculate FC Mobile Rank Up Points, OVR gain and exact Rank Up cost."}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many Rank Up Points do I need in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"The Rank Up Points required depend on the player's Base OVR and the rank steps you want to complete. Enter the Base OVR and target rank to calculate the exact cost."}},{"@type":"Question","name":"Does Rank Up increase OVR in FC Mobile?","acceptedAnswer":{"@type":"Answer","text":"Yes. Each completed rank step increases the displayed OVR by one in the rank model used by this calculator."}},{"@type":"Question","name":"What are the FC Mobile ranks?","acceptedAnswer":{"@type":"Answer","text":"The calculator uses Base, Green, Blue, Purple, Red and Orange rank stages."}}]}</script>
<main class="rank-page"><header class="hero"><div class="hero-grid"></div><div class="wrap"><nav><a href="/">FCMOBILETOOLS</a><span>›</span><span>Rank Up Calculator</span></nav><div class="hero-main"><div><div class="eyebrow"><i></i> FC MOBILE / RANK LAB</div><h1>Rank Up <em>Calculator</em></h1><p>Map the exact path from your player's current rank to the target rank. See Rank Up Points, OVR gain, Skill Points and balance in one view.</p><div class="hero-pills"><span>RANK UP POINTS</span><span>BASE OVR</span><span>OVR +1 / RANK</span></div></div><div class="rank-visual"><div class="halo h1"></div><div class="halo h2"></div><div class="rank-stack"><b>R</b><span>UP</span></div><div class="rank-chip rc-a">OVR <b>+1</b></div><div class="rank-chip rc-b">RP <b>700</b></div></div></div></div></header>
<section class="wrap calculator-wrap"><div class="calculator"><div class="calc-head"><div><span class="label">RANK UP PLANNER</span><h2>Build your rank path</h2><p>Set the player's Base OVR, starting rank and destination</p></div><div class="orange"><small>MAX</small><b>ORANGE</b><span>R5</span></div></div><div class="fields"><label><span><b>01</b> Base OVR</span><input id="base" type="number" min="0" max="130" value="110"><small>Player's base OVR before ranks</small></label><label><span><b>02</b> Current rank</span><select id="current">{RANKS.map(r=><option value={r.value}>R{r.value} · {r.name}</option>)}</select><small>Current rank stage</small></label><label><span><b>03</b> Target rank</span><select id="target">{RANKS.map(r=><option value={r.value} selected={r.value===5}>R{r.value} · {r.name}</option>)}</select><small>Rank you want to reach</small></label><label><span><b>04</b> Available RP <i>optional</i></span><input id="available" type="number" min="0" placeholder="0"><small>Check whether your balance covers it</small></label></div><div id="error" class="error" hidden></div><div class="hero-result"><div><span>TOTAL RP REQUIRED</span><strong id="required">0</strong><small>Rank Up Points</small></div><div class="result-meta"><div><span>OVR AFTER RANK</span><b id="ovr">110</b></div><div><span>SKILL POINTS</span><b id="skills">0</b></div><div><span>RANKS GAINED</span><b id="gained">0</b></div></div></div><div class="path-head"><div><span class="label">UPGRADE PATH</span><h3>Rank progression</h3></div><b id="bracket">Base OVR 110+</b></div><div class="rank-path" id="path"></div><div class="cost-panel"><div class="cost-head"><div><span class="label">COST BREAKDOWN</span><h3>Every rank step</h3></div><b id="costTotal">0 RP</b></div><div id="steps"></div></div></div><div class="reference-card"><div class="ref-intro"><span class="label">REFERENCE DATA</span><h2>Rank Up Points by Base OVR</h2><p>Use this table to compare the RP cost of every rank step.</p></div><div class="table-shell"><table><thead><tr><th>BASE OVR</th><th>R1 GREEN</th><th>R2 BLUE</th><th>R3 PURPLE</th><th>R4 RED</th><th>R5 ORANGE</th></tr></thead><tbody id="table">{RANK_COSTS.map(row=><tr><td>{row.label}</td>{row.costs.map(v=><td>{v} RP</td>)}</tr>)}</tbody></table></div></div><section class="faq"><span class="label">FAQ</span><h2>FC Mobile Rank Up Calculator FAQ</h2><div class="faq-list"><details open><summary>How many Rank Up Points do I need?</summary><p>It depends on Base OVR and the number of rank steps. Enter both ranks above for the exact total.</p></details><details><summary>Does Rank Up increase OVR?</summary><p>Yes. In the current rank data, each completed rank step adds one displayed OVR and one Skill Point.</p></details><details><summary>What ranks are included?</summary><p>The calculator covers Base, Green, Blue, Purple, Red and Orange.</p></details><details><summary>Can I check my RP balance?</summary><p>Yes. Enter Available RP and the calculator will show whether your balance covers the upgrade and how much remains or is missing.</p></details></div></section></section></main>
<style>
:root{--bg:#05080d;--panel:#0b121b;--panel2:#101a25;--line:#203040;--text:#f5fbff;--muted:#8194a4;--cyan:#36c9ff;--blue:#4b7dff;--red:#ff4d5e;--gold:#ffb84a;--mono:'IBM Plex Mono',monospace;--sans:'Manrope',system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans)}.wrap{width:min(1180px,calc(100% - 44px));margin:auto}a{text-decoration:none;color:inherit}.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(circle at 20% 0,#36c9ff16,transparent 34%),radial-gradient(circle at 86% 40%,#4b7dff14,transparent 36%)}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:48px 48px;opacity:.025}.hero>.wrap{padding:28px 0 58px}.hero nav{display:flex;gap:10px;color:#607585;font:700 9px var(--mono);margin-bottom:54px}.hero nav a{color:var(--cyan)}.hero-main{display:grid;grid-template-columns:1fr 390px;gap:70px;align-items:center}.eyebrow,.label{font:800 9px var(--mono);letter-spacing:.16em;color:var(--cyan)}.eyebrow i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px #ff4d5e15;animation:beep 1.5s infinite}.hero h1{font-size:clamp(54px,8vw,94px);line-height:.9;letter-spacing:-.075em;margin:14px 0 20px;font-weight:900}.hero h1 em{font-style:normal;background:linear-gradient(100deg,#fff,var(--cyan));background-clip:text;color:transparent}.hero p{max-width:670px;color:#8da1b0;font-size:15px;line-height:1.75}.hero-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:26px}.hero-pills span{padding:8px 10px;border:1px solid var(--line);background:#09111a;border-radius:7px;color:#718596;font:700 8px var(--mono)}.rank-visual{height:310px;position:relative;display:grid;place-items:center}.halo{position:absolute;border:1px solid #36c9ff27;border-radius:50%;animation:spin 18s linear infinite}.h1{width:275px;height:275px}.h2{width:190px;height:190px;border-style:dashed;animation-direction:reverse;animation-duration:11s}.rank-stack{width:130px;height:130px;border-radius:34px;transform:rotate(-7deg);display:grid;place-items:center;align-content:center;background:linear-gradient(145deg,#152938,#071018);border:1px solid #36c9ff55;box-shadow:0 0 70px #36c9ff18}.rank-stack b{font:900 50px var(--mono);line-height:.9}.rank-stack span{font:800 8px var(--mono);letter-spacing:.2em;color:var(--cyan)}.rank-chip{position:absolute;padding:10px 12px;border:1px solid var(--line);background:#0c151fd9;backdrop-filter:blur(12px);border-radius:10px;color:#718697;font:700 8px var(--mono)}.rank-chip b{display:block;color:#f5fbff;font-size:14px;margin-top:2px}.rc-a{right:8px;top:48px;transform:rotate(7deg)}.rc-b{left:8px;bottom:45px;transform:rotate(-6deg)}.calculator-wrap{padding:44px 0 80px}.calculator{border:1px solid var(--line);background:linear-gradient(145deg,#0c151f,#080e15);border-radius:26px;box-shadow:0 30px 100px #00000055;overflow:hidden}.calc-head{display:flex;justify-content:space-between;padding:30px;border-bottom:1px solid var(--line)}.calc-head h2{font-size:26px;margin:7px 0 6px;letter-spacing:-.04em}.calc-head p{color:var(--muted);font-size:12px;margin:0}.orange{min-width:92px;text-align:center;border:1px solid #ffb84a35;background:#ffb84a08;border-radius:12px;padding:9px}.orange small,.orange span{display:block;font:700 7px var(--mono);color:#7f796b}.orange b{display:block;font:900 12px var(--mono);color:var(--gold);margin:6px 0}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:24px 30px}.fields label{display:grid;gap:8px;color:#8094a4;font:800 9px var(--mono)}.fields label>span{color:#eaf4f8;font-size:10px}.fields label span b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;background:#36c9ff12;color:var(--cyan);margin-right:7px}.fields label span i{font-style:normal;color:#536979;font-size:8px}.fields small{font:600 8px var(--sans);color:#536979}input,select{width:100%;border:1px solid #293b4b;background:#070e15;color:#f0f7fa;border-radius:11px;padding:14px 12px;outline:none;font:700 11px var(--mono)}input:focus,select:focus{border-color:var(--cyan);box-shadow:0 0 0 3px #36c9ff13}.error{margin:0 30px 16px;padding:12px;border:1px solid #ff4d5e30;background:#ff4d5e0c;color:#ff9ca5;border-radius:10px;font:700 9px var(--mono)}.hero-result{margin:0 30px;border:1px solid #36c9ff24;background:linear-gradient(135deg,#0e2532,#09141d);border-radius:18px;padding:22px;display:grid;grid-template-columns:1.1fr 1fr;gap:20px}.hero-result>div:first-child>span,.result-meta span{font:800 8px var(--mono);letter-spacing:.12em;color:#6e9aab}.hero-result strong{display:block;font:900 clamp(48px,7vw,76px) var(--mono);letter-spacing:-.08em;line-height:.95;margin:8px 0;color:#f4fcff}.hero-result small{font:700 9px var(--mono);color:#829ba8}.result-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px}.result-meta>div{border:1px solid #ffffff10;background:#ffffff06;border-radius:11px;padding:14px}.result-meta b{display:block;font:900 17px var(--mono);margin-top:8px}.path-head{display:flex;justify-content:space-between;align-items:end;padding:28px 30px 18px}.path-head h3,.cost-head h3{font-size:18px;margin:6px 0 0}.path-head>b{padding:7px 9px;background:#36c9ff09;border:1px solid #36c9ff24;color:var(--cyan);border-radius:7px;font:800 8px var(--mono)}.rank-path{display:flex;align-items:center;padding:10px 30px 30px;gap:7px}.rank-node{min-width:76px;text-align:center}.rank-orb{width:54px;height:54px;margin:auto;display:grid;place-items:center;border-radius:16px;border:1px solid #344857;background:#0b141d;color:#718594;font:900 9px var(--mono);transition:.2s}.rank-node.current .rank-orb{border-color:var(--cyan);box-shadow:0 0 0 5px #36c9ff0d;color:var(--cyan)}.rank-node.target .rank-orb{background:linear-gradient(145deg,#36c9ff,#2877db);border-color:#36c9ff;color:#031018;box-shadow:0 12px 30px #36c9ff18}.rank-node small{display:block;margin-top:8px;color:#6f8391;font:800 7px var(--mono)}.rank-line{height:2px;flex:1;background:linear-gradient(90deg,#233644,#36c9ff33)}.cost-panel{margin:0 30px 30px;border:1px solid var(--line);border-radius:16px;overflow:hidden}.cost-head{display:flex;justify-content:space-between;padding:19px;border-bottom:1px solid var(--line)}.cost-head>b{color:var(--cyan);font:900 16px var(--mono)}.step{display:grid;grid-template-columns:52px 1fr auto;gap:12px;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-badge{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;background:#36c9ff0b;border:1px solid #36c9ff20;color:var(--cyan);font:900 8px var(--mono)}.step b{font-size:11px}.step small{display:block;color:#617887;font-size:8px;margin-top:4px}.step strong{font:900 14px var(--mono);color:#dff8ff}.reference-card{margin-top:14px;border:1px solid var(--line);background:#0a1119;border-radius:20px;overflow:hidden}.ref-intro{padding:25px;border-bottom:1px solid var(--line)}.ref-intro h2,.faq h2{font-size:26px;margin:7px 0 6px;letter-spacing:-.04em}.ref-intro p{margin:0;color:var(--muted);font-size:11px}.table-shell{overflow:auto}.table-shell table{width:100%;min-width:720px;border-collapse:collapse;font:700 9px var(--mono)}.table-shell th,.table-shell td{padding:12px;border-bottom:1px solid var(--line);text-align:center}.table-shell th:first-child,.table-shell td:first-child{text-align:left}.table-shell th{font-size:7px;color:#647988}.table-shell tr.active{background:#36c9ff08}.faq{padding:72px 0 10px}.faq h2{font-size:34px;margin-bottom:25px}.faq-list{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line);padding:19px 0}summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;font-size:13px;font-weight:800}summary::-webkit-details-marker{display:none}summary:after{content:'+';color:var(--cyan);font:700 18px var(--mono)}details[open] summary:after{content:'−'}details p{color:#7f93a1;font-size:11px;line-height:1.75;max-width:800px;margin:12px 0 0}@keyframes spin{to{transform:rotate(360deg)}}@keyframes beep{0%,70%,100%{opacity:1;box-shadow:0 0 0 5px #ff4d5e12}75%{opacity:.45;box-shadow:0 0 0 9px #ff4d5e00}}@media(max-width:900px){.hero-main{grid-template-columns:1fr}.rank-visual{height:250px}.fields{grid-template-columns:1fr 1fr}.hero-result{grid-template-columns:1fr}.rank-path{overflow:auto}.rank-node{min-width:64px}}@media(max-width:560px){.wrap{width:min(100% - 26px,1180px)}.hero h1{font-size:52px}.hero nav{margin-bottom:38px}.fields,.calc-head,.path-head{padding-left:18px;padding-right:18px}.hero-result{margin:0 18px;padding:17px}.cost-panel{margin-left:18px;margin-right:18px}.rank-path{padding-left:18px;padding-right:18px}.result-meta{gap:6px}.hero-result strong{font-size:52px}.rank-visual{height:220px}.h1{width:200px;height:200px}.h2{width:140px;height:140px}.rank-stack{width:100px;height:100px}.rank-stack b{font-size:38px}.rc-a{right:0}.rc-b{left:0}}
</style>
<script>
import { calculateRankUp } from '../lib/fcMobileRankUp.js';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
const base=document.querySelector('#base'),current=document.querySelector('#current'),target=document.querySelector('#target'),available=document.querySelector('#available');const fmt=n=>new Intl.NumberFormat('en-US').format(n);current.innerHTML=RANKS.map(r=>`<option value="${r.value}">R${r.value} · ${r.name}</option>`).join('');target.innerHTML=RANKS.map(r=>`<option value="${r.value}">R${r.value} · ${r.name}</option>`).join('');current.value='0';target.value='5';
function render(){[...target.options].forEach(o=>o.disabled=Number(o.value)<Number(current.value));if(Number(target.value)<Number(current.value))target.value=current.value;const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availableRP:available.value});if(!d.valid){document.querySelector('#error').hidden=false;document.querySelector('#error').textContent=d.error;return}document.querySelector('#error').hidden=true;document.querySelector('#required').textContent=fmt(d.requiredRP);document.querySelector('#ovr').textContent=`${d.baseOVR} → ${d.targetOVR}`;document.querySelector('#skills').textContent=`+${d.skillPoints}`;document.querySelector('#gained').textContent=`+${d.ranksGained}`;document.querySelector('#bracket').textContent=`Base OVR ${d.bracket.label}`;document.querySelector('#costTotal').textContent=`${fmt(d.requiredRP)} RP`;document.querySelector('#path').innerHTML=RANKS.map((r,i)=>`${i?'<div class="rank-line"></div>':''}<div class="rank-node ${r.value===d.currentRank?'current':''} ${r.value===d.targetRank?'target':''}"><div class="rank-orb">R${r.value}</div><small>${r.name}</small></div>`).join('');document.querySelector('#steps').innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-badge">R${s.from} → R${s.to}</div><div><b>${RANKS[s.from].name} → ${RANKS[s.to].name}</b><small>+1 OVR · +1 Skill Point</small></div><strong>${fmt(s.cost)} RP</strong></div>`).join(''):'<div class="step"><div><b>Already at target rank</b></div><strong>0 RP</strong></div>';document.querySelector('#table').innerHTML=RANK_COSTS.map(row=>`<tr class="${row===d.bracket?'active':''}"><td>${row.label}</td>${row.costs.map(v=>`<td>${fmt(v)} RP</td>`).join('')}</tr>`).join('')}
[base,current,target,available].forEach(x=>x.addEventListener('input',render));render();
</script>
---
