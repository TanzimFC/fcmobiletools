---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};

const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank."
>
  <main class="rank-page">
    <section class="hero">
      <div class="shell">
        <div class="crumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Rank Up Calculator</span></div>

        <div class="hero-layout">
          <div class="hero-copy">
            <span class="eyebrow">FC MOBILE / RANK LAB</span>
            <h1>Rank Up <em>Calculator</em></h1>
            <p>Plan the exact upgrade route for your player. Set the Base OVR, tap the current rank, choose the destination, and get the RP total instantly.</p>
            <div class="hero-meta">
              <span>LIVE CALCULATOR</span>
              <span>STATIC RANK ART</span>
              <span>RP BREAKDOWN</span>
            </div>
          </div>

          <div class="hero-rank" aria-hidden="true">
            <div class="hero-ring hero-ring-one"></div>
            <div class="hero-ring hero-ring-two"></div>
            <div class="hero-rank-core"><img src={RANK_ICONS[5]} alt="" /></div>
            <div class="hero-rank-label"><strong>Orange</strong><span>Maximum rank</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="shell content">
      <div class="planner">
        <div class="planner-topline"></div>

        <header class="planner-head">
          <div>
            <span class="eyebrow">RANK UP PLANNER</span>
            <h2>Build the upgrade</h2>
            <p>Everything updates as you change the selection.</p>
          </div>
          <div class="status-badge"><i></i><span>LIVE</span></div>
        </header>

        <div class="inputs">
          <label class="input-card">
            <div class="input-label">
              <span>BASE OVR</span>
              <small>PLAYER BASE</small>
            </div>
            <div class="input-control">
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" aria-label="Base OVR" />
              <span>OVR</span>
            </div>
          </label>

          <label class="input-card optional">
            <div class="input-label">
              <span>AVAILABLE RP</span>
              <small>OPTIONAL</small>
            </div>
            <div class="input-control">
              <input id="available" type="number" min="0" placeholder="—" inputmode="numeric" aria-label="Available Rank Up Points" />
              <span>RP</span>
            </div>
          </label>
        </div>

        <section class="rank-picker">
          <div class="picker-head">
            <div>
              <span class="eyebrow">SELECT RANK</span>
              <h3>Choose your route</h3>
            </div>
            <div class="picker-route">
              <span id="routeFrom">Base</span>
              <i></i>
              <span id="routeTo">Orange</span>
            </div>
          </div>

          <div class="rank-lanes">
            <div class="lane">
              <div class="lane-head">
                <div class="lane-number">01</div>
                <div><span>CURRENT</span><small>Where your player is now</small></div>
              </div>
              <div id="currentChoices" class="rank-grid"></div>
            </div>

            <div class="lane-divider"><span>TO</span></div>

            <div class="lane">
              <div class="lane-head">
                <div class="lane-number">02</div>
                <div><span>TARGET</span><small>Where your player is going</small></div>
              </div>
              <div id="targetChoices" class="rank-grid"></div>
            </div>
          </div>

          <input id="current" type="hidden" value="0" />
          <input id="target" type="hidden" value="5" />
          <div id="error" class="error" hidden></div>
        </section>

        <section class="results">
          <div class="result-summary">
            <article class="rp-card">
              <div class="summary-cap"><span class="eyebrow">TOTAL RP REQUIRED</span><span class="summary-line"></span></div>
              <div class="rp-main">
                <div class="rp-orb"><img src={RP_ICON} alt="" /></div>
                <strong id="required">0</strong>
                <span>RP</span>
              </div>
              <p id="status">Choose your upgrade route.</p>
              <div class="summary-route"><span id="miniFrom">Base</span><i>→</i><span id="miniTo">Orange</span></div>
            </article>

            <div class="stat-grid">
              <article>
                <span>OVR AFTER RANK</span>
                <strong id="ovr">110</strong>
                <small>Base OVR + rank</small>
              </article>
              <article>
                <span>RANKS GAINED</span>
                <strong id="gained">0</strong>
                <small>Total upgrade steps</small>
              </article>
              <article>
                <span>SKILL POINTS</span>
                <strong id="skills">0</strong>
                <small>Earned from ranks</small>
              </article>
              <article>
                <span>RP BALANCE</span>
                <strong id="remaining">—</strong>
                <small>After the upgrade</small>
              </article>
            </div>
          </div>

          <section class="cost-panel">
            <div class="cost-head">
              <div>
                <span class="eyebrow">COST BREAKDOWN</span>
                <h3>Upgrade steps</h3>
                <p>Simple table. One row per rank-up.</p>
              </div>
              <div class="total-pill"><span>TOTAL</span><strong id="costTotal">0 RP</strong></div>
            </div>

            <div class="table-wrap">
              <table class="cost-table">
                <thead>
                  <tr>
                    <th>STEP</th>
                    <th>UPGRADE</th>
                    <th>BASE OVR</th>
                    <th>RP REQUIRED</th>
                  </tr>
                </thead>
                <tbody id="stepRows"></tbody>
              </table>
            </div>
          </section>
        </section>
      </div>

      <section class="reference">
        <div class="reference-head">
          <div>
            <span class="eyebrow">REFERENCE</span>
            <h2>RP cost by Base OVR</h2>
            <p>The exact configured cost for each individual rank step.</p>
          </div>
          <div class="ref-mark">FCMOBILETOOLS <span>/</span> DATA</div>
        </div>

        <div class="reference-wrap">
          <table>
            <thead>
              <tr>
                <th>BASE OVR</th>
                <th>GREEN</th>
                <th>BLUE</th>
                <th>PURPLE</th>
                <th>RED</th>
                <th>ORANGE</th>
              </tr>
            </thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  {row.costs.map((cost) => <td>{fmt(cost)} RP</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </section>

    <section class="faq">
      <div class="shell">
        <span class="eyebrow">HELP</span>
        <h2>Rank Up Calculator FAQ</h2>
        <div class="faq-grid">
          <details open><summary>How does the calculator work?</summary><p>The calculator reads the Base OVR bracket and adds each rank-up cost from your current rank to the target rank.</p></details>
          <details><summary>Which ranks are supported?</summary><p>Base, Green, Blue, Purple, Red and Orange.</p></details>
          <details><summary>What does Available RP do?</summary><p>Enter your current RP balance to see how much remains after the selected upgrade route.</p></details>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const ICONS = {
      0:'/assets/images/rankup/rankicon_25_RANK0.png',
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return '<img src="'+ICONS[value]+'" alt="" loading="eager" />';
    }

    function makeRankButtons(kind){
      return RANKS.map((rank) =>
        '<button class="rank-tile" type="button" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-tile-glow"></span>'
          +'<span class="rank-tile-art">'+icon(rank.value)+'</span>'
          +'<span class="rank-tile-name">'+rank.name+'</span>'
          +'<span class="rank-tile-check"></span>'
        +'</button>'
      ).join('');
    }

    function buildSelectors(){
      currentChoices.innerHTML = makeRankButtons('current');
      targetChoices.innerHTML = makeRankButtons('target');

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value >= to;
        button.classList.toggle('selected', value === from);
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value <= from;
        button.classList.toggle('selected', value === to);
      });
    }

    function renderTable(data){
      $('costTotal').textContent = fmt(data.requiredRP)+' RP';

      if(!data.steps.length){
        $('stepRows').innerHTML = '<tr><td colspan="4" class="table-empty">No upgrade steps are required for this route.</td></tr>';
        return;
      }

      $('stepRows').innerHTML = data.steps.map((step, index) =>
        '<tr>'
          +'<td><span class="step-num">'+String(index + 1).padStart(2,'0')+'</span></td>'
          +'<td><div class="upgrade-cell"><strong>'+rankName(step.from)+'</strong><span>→</span><strong>'+rankName(step.to)+'</strong></div></td>'
          +'<td>'+data.bracket.label+'</td>'
          +'<td><strong class="rp-amount">'+fmt(step.cost)+' RP</strong></td>'
        +'</tr>'
      ).join('');
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label+' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('miniFrom').textContent = rankName(data.currentRank);
      $('miniTo').textContent = rankName(data.targetRank);
      $('routeFrom').textContent = rankName(data.currentRank);
      $('routeTo').textContent = rankName(data.targetRank);

      renderTable(data);
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', render));
    render();
  </script>

  <style>
    :root{
      --r-bg:#050d14;
      --r-panel:#091520;
      --r-panel-2:#0c1924;
      --r-panel-3:#0f202d;
      --r-line:rgba(255,255,255,.07);
      --r-line-soft:rgba(255,255,255,.045);
      --r-text:#f3f8fa;
      --r-muted:#8fa5b2;
      --r-dim:#5c7280;
      --r-cyan:#49c9ff;
      --r-cyan-2:#8ce2ff;
      --r-font-head:'Space Grotesk',system-ui,sans-serif;
      --r-font-body:'Inter',system-ui,sans-serif;
    }

    .rank-page{
      min-height:100vh;
      color:var(--r-text);
      background:
        radial-gradient(720px 420px at 8% 0%,rgba(73,201,255,.10),transparent 68%),
        radial-gradient(800px 500px at 92% 10%,rgba(73,201,255,.055),transparent 70%),
        linear-gradient(180deg,#050d14 0%,#07111a 52%,#061018 100%);
      overflow:hidden;
    }

    .shell{width:min(1160px,calc(100% - 38px));margin:0 auto}

    .hero{position:relative;border-bottom:1px solid var(--r-line);background:linear-gradient(180deg,rgba(5,13,20,.92),rgba(5,13,20,.65))}
    .hero:after{content:"";position:absolute;inset:auto 0 0;height:1px;background:linear-gradient(90deg,transparent,rgba(73,201,255,.42),transparent);opacity:.65}
    .hero .shell{padding:27px 0 47px}
    .crumb{display:flex;align-items:center;gap:9px;margin-bottom:47px;color:#5a717f;font:800 9px/1 var(--r-font-head)}
    .crumb a{color:var(--r-cyan);text-decoration:none}
    .hero-layout{display:grid;grid-template-columns:minmax(0,1fr) 195px;align-items:center;gap:70px}
    .eyebrow{color:var(--r-cyan);font:900 9px/1 var(--r-font-head);letter-spacing:.16em}
    .hero h1{margin:14px 0 17px;font:800 clamp(50px,7vw,82px)/.88 var(--r-font-head);letter-spacing:-.075em}
    .hero h1 em{font-style:normal;color:var(--r-cyan)}
    .hero-copy>p{max-width:690px;margin:0;color:var(--r-muted);font:500 13px/1.8 var(--r-font-body)}
    .hero-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
    .hero-meta span{padding:7px 10px;border:1px solid var(--r-line);border-radius:999px;background:rgba(255,255,255,.012);color:#718894;font:900 7px/1 var(--r-font-head);letter-spacing:.08em}

    .hero-rank{position:relative;display:grid;justify-items:center;padding:22px 16px 16px;border:1px solid rgba(73,201,255,.13);border-radius:24px;background:linear-gradient(145deg,#0c1f2c,#08131c);box-shadow:0 28px 80px rgba(0,0,0,.28);overflow:hidden}
    .hero-rank:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(73,201,255,.07),transparent 45%);pointer-events:none}
    .hero-rank-core{position:relative;display:grid;place-items:center;width:132px;height:132px}
    .hero-rank-core img{position:relative;width:124px;height:124px;object-fit:contain;filter:drop-shadow(0 18px 28px rgba(0,0,0,.38))}
    .hero-ring{position:absolute;border:1px solid rgba(73,201,255,.15);border-radius:50%;pointer-events:none}
    .hero-ring-one{width:145px;height:145px;animation:spin 16s linear infinite}
    .hero-ring-two{width:114px;height:114px;border-color:rgba(73,201,255,.08);animation:spin-reverse 12s linear infinite}
    .hero-rank-label{text-align:center}
    .hero-rank-label strong{display:block;margin-top:4px;font:900 23px/1 var(--r-font-head)}
    .hero-rank-label span{display:block;margin-top:5px;color:#708694;font:700 8px/1 var(--r-font-head)}
    @keyframes spin{to{transform:rotate(360deg)}} @keyframes spin-reverse{to{transform:rotate(-360deg)}}

    .content{padding:38px 0 66px}
    .planner,.reference{border:1px solid var(--r-line);border-radius:24px;background:linear-gradient(145deg,#091620,#071119);box-shadow:0 28px 90px rgba(0,0,0,.24);overflow:hidden}
    .planner{position:relative}
    .planner-topline{height:2px;background:linear-gradient(90deg,transparent,rgba(73,201,255,.55),rgba(140,226,255,.8),transparent);opacity:.85}
    .planner-head{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:23px 28px;border-bottom:1px solid var(--r-line)}
    .planner-head h2,.reference h2,.faq h2{margin:7px 0 5px;font:800 26px/1 var(--r-font-head);letter-spacing:-.045em}
    .planner-head p,.reference-head p{margin:0;color:var(--r-muted);font:500 10px/1.55 var(--r-font-body)}
    .status-badge{display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid rgba(73,201,255,.12);border-radius:999px;color:#78909c;font:900 7px/1 var(--r-font-head);letter-spacing:.12em}
    .status-badge i{width:6px;height:6px;border-radius:50%;background:var(--r-cyan);box-shadow:0 0 0 rgba(73,201,255,.7);animation:pulse 2.2s ease-out infinite}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(73,201,255,.42)}65%{box-shadow:0 0 0 7px rgba(73,201,255,0)}100%{box-shadow:0 0 0 0 rgba(73,201,255,0)}}

    .inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:19px 28px 8px}
    .input-card{padding:14px 15px;border:1px solid var(--r-line-soft);border-radius:16px;background:linear-gradient(145deg,rgba(255,255,255,.018),rgba(255,255,255,.006))}
    .input-label{display:flex;justify-content:space-between;gap:10px;margin-bottom:9px;color:#708692;font:900 8px/1 var(--r-font-head);letter-spacing:.12em}
    .input-label small{color:#4c6572;font:900 7px/1 var(--r-font-head);letter-spacing:.08em}
    .input-control{display:flex;align-items:center;gap:9px}
    .input-control input{width:100%;min-width:0;height:44px;border:1px solid #29424f;border-radius:11px;background:#07131c;color:var(--r-text);padding:0 12px;outline:0;font:900 12px var(--r-font-head);transition:border-color .18s,box-shadow .18s,background .18s}
    .input-control input:focus{border-color:rgba(73,201,255,.72);background:#081620;box-shadow:0 0 0 3px rgba(73,201,255,.09),0 0 28px rgba(73,201,255,.06)}
    .input-control>span{color:#56727f;font:900 8px/1 var(--r-font-head)}

    .rank-picker{padding:22px 28px 25px}
    .picker-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:16px}
    .picker-head h3{margin:7px 0 0;font:800 18px/1 var(--r-font-head);letter-spacing:-.03em}
    .picker-route{display:flex;align-items:center;gap:9px;padding:8px 10px;border:1px solid rgba(73,201,255,.10);border-radius:999px;background:rgba(73,201,255,.025);color:#91aab6;font:900 8px/1 var(--r-font-head)}
    .picker-route i{width:18px;height:1px;background:#43606d}

    .rank-lanes{display:grid;grid-template-columns:minmax(0,1fr) 34px minmax(0,1fr);align-items:stretch}
    .lane{min-width:0}
    .lane-head{display:flex;align-items:center;gap:10px;margin-bottom:9px}
    .lane-number{display:grid;place-items:center;width:27px;height:27px;border:1px solid rgba(73,201,255,.16);border-radius:8px;background:#091e2b;color:var(--r-cyan);font:900 8px/1 var(--r-font-head)}
    .lane-head span{display:block;color:#d5e5eb;font:900 8px/1 var(--r-font-head);letter-spacing:.10em}
    .lane-head small{display:block;margin-top:4px;color:#4f6976;font:500 7px/1 var(--r-font-body)}
    .lane-divider{position:relative;display:flex;align-items:center;justify-content:center}
    .lane-divider:before{content:"";width:1px;height:100%;background:linear-gradient(180deg,transparent,var(--r-line),transparent)}
    .lane-divider span{position:absolute;padding:5px 5px;background:#091620;color:#4b6572;font:900 6px/1 var(--r-font-head);letter-spacing:.14em}

    .rank-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}
    .rank-tile{position:relative;min-width:0;height:82px;border:1px solid rgba(255,255,255,.045);border-radius:13px;background:linear-gradient(145deg,#08141d,#071119);color:var(--r-text);padding:6px 4px 5px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;overflow:hidden;transition:transform .22s cubic-bezier(.2,.8,.2,1),border-color .22s,background .22s,box-shadow .22s,opacity .22s}
    .rank-tile:before{content:"";position:absolute;inset:0;background:radial-gradient(65px 45px at 50% 0%,rgba(73,201,255,.08),transparent 70%);opacity:0;transition:opacity .25s}
    .rank-tile:hover:not(:disabled){transform:translateY(-3px) scale(1.015);border-color:rgba(73,201,255,.28);background:#0a1822;box-shadow:0 12px 26px rgba(0,0,0,.22),0 0 24px rgba(73,201,255,.035)}
    .rank-tile:hover:not(:disabled):before{opacity:1}
    .rank-tile.selected{border-color:rgba(73,201,255,.82);background:linear-gradient(180deg,rgba(73,201,255,.12),rgba(9,20,29,.98));box-shadow:inset 0 0 0 1px rgba(140,226,255,.10),0 0 0 1px rgba(73,201,255,.08),0 8px 28px rgba(73,201,255,.09)}
    .rank-tile.selected:after{content:"";position:absolute;left:14%;right:14%;bottom:0;height:2px;border-radius:999px;background:linear-gradient(90deg,transparent,var(--r-cyan-2),transparent);box-shadow:0 0 12px rgba(73,201,255,.8);animation:selectionSweep 2.3s ease-in-out infinite}
    .rank-tile:disabled{opacity:.14;cursor:not-allowed;filter:saturate(.25)}
    .rank-tile-glow{position:absolute;width:50px;height:50px;top:-20px;left:50%;transform:translateX(-50%);border-radius:50%;background:rgba(73,201,255,.18);filter:blur(18px);opacity:0;transition:opacity .22s}
    .rank-tile.selected .rank-tile-glow{opacity:1;animation:glowBreath 2.4s ease-in-out infinite}
    .rank-tile-art{position:relative;display:grid;place-items:center;width:44px;height:44px}
    .rank-tile-art img{width:51px;height:51px;object-fit:contain;filter:drop-shadow(0 6px 9px rgba(0,0,0,.34));transition:transform .22s,filter .22s}
    .rank-tile:hover:not(:disabled) .rank-tile-art img{transform:translateY(-1px) scale(1.04)}
    .rank-tile.selected .rank-tile-art img{transform:scale(1.07);filter:drop-shadow(0 8px 13px rgba(73,201,255,.18))}
    .rank-tile-name{position:relative;color:#8da2ad;font:900 7px/1 var(--r-font-head);letter-spacing:.02em;transition:color .2s}
    .rank-tile.selected .rank-tile-name{color:#e9f8fc}
