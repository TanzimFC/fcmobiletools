---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';
const fmt=(n)=>Number(n).toLocaleString();
const RANK_ICONS = {
  1: '/assets/images/rankup/rankicon_25_RANK1_ANIM.png',
  2: '/assets/images/rankup/rankicon_25_RANK2_ANIM.png',
  3: '/assets/images/rankup/rankicon_25_RANK3_ANIM.png',
  4: '/assets/images/rankup/rankicon_25_RANK4_ANIM.png',
  5: '/assets/images/rankup/rankicon_25_RANK5_ANIM.png'
};
const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---
<BaseLayout title="FC Mobile Rank Up Calculator | Rank Up Points | FCMOBILETOOLS" description="Calculate FC Mobile Rank Up Points, rank costs, OVR gain and Skill Points with a complete Base OVR reference table.">
<main class="rank-page"><header class="hero"><div class="wrap"><nav><a href="/">FCMOBILETOOLS</a><span>›</span><span>Rank Up Calculator</span></nav><div class="hero-grid"><div><span class="eyebrow">FC MOBILE / RANK LAB</span><h1>Rank Up <em>Calculator</em></h1><p>Calculate the exact Rank Up Points needed from your current rank to your target rank.</p><div class="pills"><span>RANK UP POINTS</span><span>BASE OVR</span><span>R0 → R5</span></div></div><div class="hero-mark"><div class="hero-rank-orb"><img src={RANK_ICONS[5]} alt="" /></div><strong>R5</strong><small>ORANGE RANK</small></div></div></div></header>
<section class="wrap section"><div class="calculator-shell">
  <div class="planner-head"><div><span class="label">RANK UP PLANNER</span><h2>Build your rank path</h2><p>Enter the Base OVR and choose the current and target rank. Calculation logic is unchanged.</p></div><b class="max">R0 → R5</b></div>
  <div class="fields"><label>Base OVR<input id="base" type="number" min="0" max="150" value="110"></label><label>Current Rank<select id="current">${RANKS.map((r)=><option value={r.value}>R{r.value} · {r.name}</option>)}</select></label><label>Target Rank<select id="target">${RANKS.map((r)=><option value={r.value}>R{r.value} · {r.name}</option>)}</select></label><label>Available RP<input id="available" type="number" min="0" placeholder="Optional"></label></div>
  <div id="error" class="error" hidden></div>
  <div class="summary-grid"><article class="rp-summary"><small>RP REQUIRED</small><strong id="required">0</strong><p id="status">Choose your rank path</p><div class="rank-flow-mini"><span id="miniFrom">R0</span><i></i><span id="miniTo">R5</span></div></article><div class="metric-grid"><article><small>OVR AFTER RANK</small><b id="ovr">110</b><span>Base OVR + rank</span></article><article><small>SKILL POINTS</small><b id="skills">0</b><span>Earned on the route</span></article><article><small>RANKS GAINED</small><b id="gained">0</b><span>Upgrade steps</span></article><article><small>RP BALANCE</small><b id="remaining">—</b><span>After available RP</span></article></div></div>
  <div class="rank-chart"><div class="chart-head"><span class="label">RANK UP CHART</span><h3>Player rank slots</h3><p>Each step is a card instead of plain text.</p></div><div id="rankPath" class="rank-cards"></div></div>
  <div class="steps"><div class="steps-head"><div><span class="label">COST BREAKDOWN</span><h3>Every rank step</h3></div><b id="costTotal">0 RP</b></div><div id="stepRows"></div></div>
</div>
<div class="reference"><div class="section-title"><span class="label">REFERENCE DATA</span><h2>Rank Up Points by Base OVR</h2><p>Complete R1 to R5 costs for every configured Base OVR bracket.</p></div><div class="scroll"><table><thead><tr><th>BASE OVR</th><th>R1 GREEN</th><th>R2 BLUE</th><th>R3 PURPLE</th><th>R4 RED</th><th>R5 ORANGE</th></tr></thead><tbody>${RANK_COSTS.map((row)=><tr><td>{row.label}</td>{row.costs.map((cost)=><td>{fmt(cost)} RP</td>)}</tr>)</tbody></table></div></div></section>
<section class="faq"><div class="wrap"><span class="label">FAQ</span><h2>FC Mobile Rank Up Calculator FAQ</h2><details open><summary>How are Rank Up Points calculated?</summary><p>The calculator finds the Base OVR bracket and adds the costs for each rank step between your current and target rank.</p></details><details><summary>Which ranks are included?</summary><p>{RANKS.map((r)=>`R${r.value} ${r.name}`).join(' · ')}.</p></details></div></section></main>
<script>
import { calculateRankUp } from '../lib/fcMobileRankUp.js';
import { RANKS } from '../data/fcMobileRankUp.js';
const $=(id)=>document.getElementById(id);
const fmt=(n)=>Number(n).toLocaleString();
const base=$('base'),current=$('current'),target=$('target'),available=$('available');
current.value='0';target.value='5';
function render(){
  const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availableRP:available.value});
  if(!d.valid){$('error').hidden=false;$('error').textContent=d.error;return}
  $('error').hidden=true;
  $('required').textContent=fmt(d.requiredRP);
  $('ovr').textContent=fmt(d.targetOVR);
  $('skills').textContent=d.skillPoints;
  $('gained').textContent=d.ranksGained;
  $('costTotal').textContent=fmt(d.requiredRP)+' RP';
  $('status').textContent=d.bracket.label+' · R'+d.currentRank+' → R'+d.targetRank;
  $('remaining').textContent=d.remainingRP===null?'—':fmt(d.remainingRP);
  $('miniFrom').textContent='R'+d.currentRank;
  $('miniTo').textContent='R'+d.targetRank;
  $('rankPath').innerHTML=RANKS.map((r)=>'<article class="rank-card '+(r.value===d.currentRank?'current ':'')+(r.value===d.targetRank?'target ':'')+(r.value>d.currentRank&&r.value<d.targetRank?'route ':'')+'"><div class="rank-card-top"><span class="rank-index">R'+r.value+'</span><b>'+(r.value===d.currentRank?'CURRENT':r.value===d.targetRank?'TARGET':r.value<d.currentRank?'PREVIOUS':'UPGRADE')+'</b></div><div class="rank-icon '+(r.value===0?'rank-icon-base':'')+'">'+(RANK_ICONS[r.value]?'<img src="'+RANK_ICONS[r.value]+'" alt="" loading="lazy"/>':'<span>BASE</span>')+'</div><strong>'+r.name+'</strong><small>Rank '+r.value+'</small></article>').join('');
  $('stepRows').innerHTML=d.steps.length?d.steps.map((step,index)=>'<article class="cost-step"><div class="cost-step-rail"><span class="cost-step-dot">'+String(index+1).padStart(2,'0')+'</span><i></i></div><div class="cost-step-main"><div class="cost-step-heading"><div><span class="step-kicker">RANK UPGRADE</span><h4>R'+step.from+' → R'+step.to+' <em>'+RANKS[step.to].name+'</em></h4></div><strong><img src="'+RP_ICON+'" alt="" />'+fmt(step.cost)+' <small>RP</small></strong></div><div class="cost-step-meta"><span><b>FROM</b> R'+step.from+'</span><span><b>TO</b> R'+step.to+'</span><span><b>OVR BRACKET</b> '+d.bracket.label+'</span></div><div class="cost-step-meter"><span style="width:'+Math.min(100,Math.max(8,Math.round(step.cost/Math.max(...d.steps.map(s=>s.cost))*100)))+'%"></span></div></div></article>').join(''):'<div class="empty">No RP required</div>';
}
[base,current,target,available].forEach((e)=>e.addEventListener('input',render));
render();
</script>
<style>
:root{--bg:#071018;--panel:#0f1a26;--panel2:#132333;--line:rgba(255,255,255,.08);--text:#f5f8fb;--muted:#a7b4c3;--cyan:#4cc9ff;--cyan2:#63d4ff;--gold:#ffb84a;--mono:'Space Grotesk',system-ui,sans-serif;--sans:'Inter',system-ui,sans-serif}
*{box-sizing:border-box}.rank-page{background:radial-gradient(700px 380px at 80% 3%,rgba(76,201,255,.08),transparent 70%);padding-bottom:24px}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}.hero{border-bottom:1px solid var(--line);background:radial-gradient(700px 400px at 8% 0,rgba(76,201,255,.1),transparent 64%)}.hero>.wrap{padding:34px 0 58px}.hero nav{display:flex;gap:10px;color:#718394;font:700 10px var(--mono);margin-bottom:58px}.hero nav a{color:var(--cyan)}.hero-grid{display:grid;grid-template-columns:1fr 240px;gap:40px;align-items:center}.eyebrow,.label{font:800 10px var(--mono);letter-spacing:.14em;color:var(--cyan)}h1{font:700 clamp(50px,7vw,88px)/.9 var(--mono);letter-spacing:-.07em;margin:15px 0 20px}h1 em{font-style:normal;color:var(--cyan)}.hero p{max-width:650px;color:var(--muted);font-size:15px;line-height:1.7}.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.pills span{padding:8px 10px;border:1px solid var(--line);border-radius:999px;color:#7f92a1;font:700 8px var(--mono)}.hero-mark{height:230px;display:grid;place-items:center;align-content:center;border:1px solid rgba(76,201,255,.16);border-radius:28px;background:linear-gradient(145deg,#102433,#0a141e);box-shadow:0 24px 80px rgba(0,0,0,.3),0 0 80px rgba(76,201,255,.08)}.hero-rank-orb{width:110px;height:110px;display:grid;place-items:center;margin-bottom:2px}.hero-rank-orb img{width:125px;height:125px;object-fit:contain;filter:drop-shadow(0 16px 22px rgba(0,0,0,.35))}.hero-mark strong{font:900 50px var(--mono);letter-spacing:-.09em}.hero-mark small{color:var(--cyan);font:800 8px var(--mono);letter-spacing:.2em}.section{padding:42px 0 70px}.calculator-shell,.reference{border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,#0f1a26,#0b131c);box-shadow:0 24px 70px rgba(0,0,0,.24);overflow:hidden}.planner-head{display:flex;justify-content:space-between;gap:20px;padding:28px;border-bottom:1px solid var(--line)}h2{font-size:28px;letter-spacing:-.04em;margin:7px 0}.planner-head p{margin:0;color:var(--muted);font-size:12px}.max{height:max-content;padding:10px 12px;border:1px solid rgba(255,184,74,.2);border-radius:10px;color:var(--gold);background:rgba(255,184,74,.05);font:800 9px var(--mono)}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:24px 28px}.fields label{display:grid;gap:8px;color:#91a3b2;font:800 9px var(--mono)}input,select{width:100%;min-height:48px;padding:0 13px;border:1px solid #284051;border-radius:12px;background:#0b141d;color:var(--text);font:700 11px var(--mono);outline:0}.summary-grid{position:sticky;top:104px;z-index:18;display:grid;grid-template-columns:minmax(0,1fr) 1.05fr;gap:14px;padding:2px 28px;background:linear-gradient(180deg,#0f1a26 0%,#0f1a26f2 84%,transparent)}.rp-summary,.metric-grid article{border:1px solid rgba(255,255,255,.08);border-radius:18px;background:linear-gradient(145deg,#122635,#0b1822)}.rp-summary{padding:22px}.rp-summary small,.metric-grid small{font:800 8px var(--mono);letter-spacing:.12em;color:#76a4b6}.rp-summary strong{display:block;margin:8px 0;font:900 clamp(44px,6vw,76px)/.9 var(--mono);letter-spacing:-.08em}.rp-summary p{margin:0;color:var(--muted);font-size:11px}.rank-flow-mini{display:flex;align-items:center;gap:9px;margin-top:18px;color:#8ea2b1;font:800 8px var(--mono)}.rank-flow-mini i{width:44px;height:2px;background:linear-gradient(90deg,#2b4558,var(--cyan))}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.metric-grid article{padding:16px}.metric-grid b{display:block;margin:8px 0 3px;font:900 20px var(--mono);color:var(--text)}.metric-grid span{color:#708595;font-size:9px}.rank-chart{margin-top:20px;border-top:1px solid var(--line);padding:24px 28px 25px}.chart-head h3{margin:7px 0 4px;font-size:19px}.chart-head p{margin:0;color:var(--muted);font-size:10px}.rank-cards{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-top:16px}.rank-card{position:relative;min-height:164px;padding:13px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#0b151f,#0a121a);display:flex;flex-direction:column;justify-content:space-between;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.rank-card .rank-card-top{display:flex;align-items:center;justify-content:space-between;gap:6px}.rank-card .rank-index{font:900 10px var(--mono);color:#6f8594}.rank-card .rank-card-top>b{font:800 6px var(--mono);letter-spacing:.1em;color:#637988}.rank-card .rank-icon{width:72px;height:72px;margin:4px auto 0;display:grid;place-items:center;border:1px solid rgba(76,201,255,.13);border-radius:15px;background:radial-gradient(circle,rgba(76,201,255,.1),rgba(7,16,24,.12));overflow:hidden}.rank-card .rank-icon img{width:86px;height:86px;object-fit:contain;display:block;filter:drop-shadow(0 7px 12px rgba(0,0,0,.28))}.rank-card strong{font:800 13px var(--mono);line-height:1.1;text-align:center}.rank-icon-base{border-color:rgba(255,255,255,.06)!important;color:#617381;font:800 8px var(--mono)}.rank-icon-base span{opacity:.75}.rank-card>small{display:block;color:#637988;font:600 8px var(--mono);text-align:center}.rank-card.current{border-color:rgba(76,201,255,.5);box-shadow:0 0 28px rgba(76,201,255,.08)}.rank-card.current .rank-index,.rank-card.current b{color:var(--cyan)}.rank-card.target{background:linear-gradient(145deg,rgba(76,201,255,.19),#0c2030);border-color:var(--cyan);box-shadow:0 12px 35px rgba(76,201,255,.12)}.rank-card.target .rank-index,.rank-card.target b{color:var(--cyan2)}.rank-card.route{border-color:rgba(76,201,255,.18)}.steps{margin:0 28px 28px;border:1px solid var(--line);border-radius:15px;overflow:hidden}.steps-head{display:flex;justify-content:space-between;padding:19px;border-bottom:1px solid var(--line)}.steps-head h3{margin:7px 0 0}.steps-head>b{color:var(--cyan);font:900 15px var(--mono)}.step{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:15px 18px;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-left{display:flex;align-items:center;gap:12px}.step-badge{padding:7px 8px;border-radius:8px;background:#102131;color:var(--cyan);font:800 8px var(--mono)}.step b{font-size:11px}.step small{display:block;color:#617887;font-size:8px;margin-top:4px}.step>strong{font:900 13px var(--mono);color:#dff8ff;white-space:nowrap}.reference{padding:26px;margin-top:14px}.section-title{margin-bottom:20px}.section-title h2{margin:8px 0}.section-title p{margin:0;color:var(--muted);font-size:11px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:720px}th,td{text-align:left;padding:12px 14px;border-top:1px solid var(--line);font-size:10px}th{color:#6f8594;font:800 8px var(--mono)}td{color:#d7e4ea}.faq{padding:70px 0}.faq details{border-top:1px solid var(--line);padding:17px 0}.faq summary{cursor:pointer;font-weight:800;font-size:12px}.faq p{color:var(--muted);font-size:11px;line-height:1.7}.error{margin:0 28px 14px;padding:11px;border:1px solid rgba(255,112,112,.25);background:rgba(255,112,112,.06);color:#ff9b9b;border-radius:10px;font:700 9px var(--mono)}.empty{padding:18px;color:var(--muted);font-size:10px}@media(max-width:920px){.summary-grid{position:relative;top:auto;background:none}.hero-grid,.summary-grid{grid-template-columns:1fr}.hero-mark{display:none}.fields{grid-template-columns:1fr 1fr}.rank-cards{grid-template-columns:repeat(3,1fr)}.wrap{width:calc(100% - 24px)}}@media(max-width:560px){.hero>.wrap{padding-bottom:44px}.hero nav{margin-bottom:38px}.hero h1{font-size:52px}.section{padding-top:28px}.fields{grid-template-columns:1fr;padding:18px}.summary-grid{padding:0 18px}.rp-summary{padding:18px}.planner-head{align-items:flex-start;flex-direction:column}.rank-chart{padding:22px 18px}.rank-cards{grid-template-columns:repeat(2,1fr)}.steps{margin:0 18px 18px}.reference{padding:20px}.step{align-items:flex-start}.step-left{align-items:flex-start}.step>strong{font-size:11px}}
</style>
<style>
.rank-page .steps{margin:0 28px 28px;border:1px solid rgba(255,255,255,.08);border-radius:20px;overflow:hidden;background:linear-gradient(145deg,#0d1822,#0a121a);box-shadow:0 18px 55px rgba(0,0,0,.2)}
.rank-page .steps-head{padding:22px 22px 18px;background:linear-gradient(180deg,rgba(76,201,255,.045),transparent);border-bottom:1px solid var(--line);align-items:flex-end}
.rank-page .steps-head h3{font-size:22px;letter-spacing:-.03em}.rank-page .steps-head p{margin:5px 0 0;color:var(--muted);font-size:10px}.rank-page .steps-head>b{padding:10px 12px;border:1px solid rgba(76,201,255,.16);border-radius:10px;background:rgba(76,201,255,.055);font-size:13px}
.rank-page #stepRows{padding:8px 14px 14px}.rank-page .cost-step{display:grid;grid-template-columns:38px minmax(0,1fr);gap:13px;padding:9px 5px}.rank-page .cost-step-rail{display:flex;flex-direction:column;align-items:center;padding-top:5px}.rank-page .cost-step-dot{width:28px;height:28px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.22);border-radius:9px;background:#0e2230;color:var(--cyan);font:800 8px var(--mono)}.rank-page .cost-step-rail i{width:1px;flex:1;margin-top:6px;background:linear-gradient(180deg,rgba(76,201,255,.24),rgba(255,255,255,.03))}.rank-page .cost-step:last-child .cost-step-rail i{display:none}
.rank-page .cost-step-main{padding:15px 16px;border:1px solid rgba(255,255,255,.07);border-radius:15px;background:#0d1721;transition:border-color .18s,transform .18s,background .18s}.rank-page .cost-step-main:hover{transform:translateX(2px);border-color:rgba(76,201,255,.18);background:#0f1b26}.rank-page .cost-step-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}.rank-page .step-kicker{font:800 7px var(--mono);letter-spacing:.14em;color:#668394}.rank-page .cost-step-heading h4{margin:5px 0 0;font:800 14px var(--mono)}.rank-page .cost-step-heading h4 em{font-style:normal;color:#758b98;font-weight:600}.rank-page .cost-step-heading>strong{font:900 21px var(--mono);color:#e4f8ff;white-space:nowrap}.rank-page .cost-step-heading>strong small{font:800 8px var(--mono);color:var(--cyan)}.rank-page .cost-step-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:11px;color:#6f8593;font:700 8px var(--mono)}.rank-page .cost-step-meta b{color:#496676;margin-right:3px}.rank-page .cost-step-meter{height:4px;margin-top:13px;border-radius:99px;background:#172834;overflow:hidden}.rank-page .cost-step-meter span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#2875c8,var(--cyan))}
@media(max-width:560px){.rank-page .rank-cards{grid-template-columns:repeat(2,1fr)}.rank-page .rank-card{min-height:152px}.rank-page .rank-icon{width:50px;height:50px}.rank-page .rank-icon img{width:62px;height:62px}.rank-page .steps{margin-left:18px;margin-right:18px}.rank-page #stepRows{padding-inline:9px}.rank-page .cost-step{grid-template-columns:30px minmax(0,1fr);gap:9px}.rank-page .cost-step-dot{width:24px;height:24px;font-size:7px}.rank-page .cost-step-main{padding:13px}.rank-page .cost-step-heading{display:block}.rank-page .cost-step-heading>strong{display:block;margin-top:9px;font-size:19px}.rank-page .cost-step-meta{gap:8px}.rank-page .steps-head{align-items:flex-start;display:block}.rank-page .steps-head>b{display:inline-flex;margin-top:12px}}
</style>