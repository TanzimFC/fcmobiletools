---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS } from '../data/rankUpCalculator.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator" description="Calculate the exact Rank Up Points needed for an FC Mobile player">
<main class="page"><div class="wrap">
<header class="hero"><div><span>FC MOBILE 26</span><h1>Rank Up Calculator</h1><p>Enter your player details and see the exact upgrade cost</p></div><div class="hero-icon">RP</div></header>
<section class="card setup"><div class="eyebrow">PLAYER</div><h2>Choose your player</h2><div class="fields"><label>Base OVR<input id="base" type="number" min="0" max="130" value="107"></label><label>Current Rank<select id="current">{RANKS.map(r=><option value={r.rank}>{r.rank} · {r.name}</option>)}</select></label><label>Target Rank<select id="target">{RANKS.map(r=><option value={r.rank} selected={r.rank===5}>{r.rank} · {r.name}</option>)}</select></label><label>Available RP <small>optional</small><input id="available" type="number" min="0" placeholder="Your RP"></label></div><div class="quick"><span>Target</span><button data-step="1">+1</button><button data-step="2">+2</button><button data-step="3">+3</button><button id="max">Rank 5</button></div></section>
<section id="result" class="answer"></section>
<section class="card"><div class="section-title"><div><div class="eyebrow">UPGRADE</div><h2>Rank path</h2></div><span id="bracket"></span></div><div id="rankPath"></div></section>
<section class="two"><section class="card"><div class="eyebrow">COST</div><h2>Rank Up Points</h2><div id="steps"></div></section><section class="card"><div class="eyebrow">RP CHECK</div><h2>Available points</h2><div id="balance"></div></section></section>
<details class="card rules"><summary>How Rank Up works</summary><p>In FC Mobile 26, Rank Up uses Rank Up Points. The cost is determined by the player's Base OVR bracket. Every rank adds +1 displayed OVR and +1 Skill Point, up to Rank 5.</p></details>
</div></main>
</BaseLayout>
<style>
.page{--blue:#55cff7;--ink:#112b35;--muted:#71868e;--line:#d8e8ed;min-height:100vh;padding:42px 18px 80px;background:radial-gradient(circle at 85% 0,#c8f3ff,transparent 30%),#f3fafc;color:var(--ink)}.wrap{max-width:1040px;margin:auto}.hero{display:flex;justify-content:space-between;align-items:end;padding:15px 0 32px}.hero span,.eyebrow{font:900 9px ui-monospace,monospace;letter-spacing:.16em;color:#159fce}.hero h1{font-size:clamp(42px,7vw,70px);letter-spacing:-.065em;line-height:.9;margin:10px 0}.hero p{margin:0;color:var(--muted);font-size:14px}.hero-icon{width:60px;height:60px;border-radius:18px;background:#102e3a;color:#8ce4ff;display:grid;place-items:center;font:900 18px ui-monospace,monospace}.card,.answer{border:1px solid var(--line);background:#fff;border-radius:20px;box-shadow:0 14px 40px #32687a12;padding:22px}.setup{margin-bottom:14px}.setup h2,.card h2{font-size:19px;margin:6px 0 18px}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}label{display:grid;gap:7px;font:900 9px ui-monospace,monospace;color:#58717a}label small{font-size:8px;color:#9aabb1;font-weight:600}input,select{width:100%;box-sizing:border-box;border:1px solid #cfe1e7;border-radius:11px;background:#f8fdff;color:#142d37;padding:13px 11px;font:800 12px ui-monospace,monospace;outline:0}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55cff71c}.quick{display:flex;align-items:center;gap:7px;margin-top:14px;color:#84979e;font:800 8px ui-monospace,monospace}.quick button{border:1px solid #cfe1e7;background:#f5fbfd;color:#28788f;border-radius:8px;padding:8px 11px;font:900 8px ui-monospace,monospace;cursor:pointer}.answer{margin-bottom:14px;background:linear-gradient(135deg,#0d2c39,#12495c);border-color:#1b5267;color:#effcff}.answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}.answer-label{font:900 8px ui-monospace,monospace;letter-spacing:.15em;color:#7cdefc}.answer-number{font:900 clamp(48px,8vw,76px) ui-monospace,monospace;line-height:.9;letter-spacing:-.07em;margin:9px 0}.answer-number small{font-size:13px;letter-spacing:0;color:#8eb4c0}.answer-sub{font-size:10px;color:#9fbac3}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stat{border:1px solid #ffffff18;background:#ffffff09;border-radius:12px;padding:14px}.stat span{display:block;font:800 7px ui-monospace,monospace;color:#77a4b1;margin-bottom:6px}.stat strong{font:900 15px ui-monospace,monospace}.status{grid-column:1/-1;padding:11px;border-radius:9px;font:900 8px ui-monospace,monospace}.good{background:#69f4c619;color:#9dffd7}.bad{background:#ff737318;color:#ffb7b7}.neutral{background:#ffffff0a;color:#b9ccd2}.section-title{display:flex;justify-content:space-between;align-items:end}.section-title>span{font:900 8px ui-monospace,monospace;color:#168db2;background:#effaff;border:1px solid #cbeaf3;border-radius:8px;padding:6px 8px}#rankPath{display:flex;align-items:center;gap:5px;padding:12px 0 2px}.rank-node{flex:1;text-align:center}.rank-orb{width:46px;height:46px;margin:auto;border-radius:50%;display:grid;place-items:center;border:2px solid #d6e5e9;background:#f3f7f8;color:#74878e;font:900 9px ui-monospace,monospace}.rank-node.current .rank-orb{border-color:var(--blue);background:#effbff;color:#087fa9;box-shadow:0 0 0 5px #55cff71a}.rank-node.target .rank-orb{background:#112f3b;border-color:#112f3b;color:#fff}.rank-node small{display:block;margin-top:7px;color:#84979e;font:900 6px ui-monospace,monospace}.rank-line{height:2px;flex:1;background:#dbe7eb}.two{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px}.step{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-icon{width:36px;height:36px;border-radius:10px;background:#eefaff;color:#168db2;display:grid;place-items:center;font:900 8px ui-monospace,monospace}.step b{font-size:11px}.step small{display:block;color:var(--muted);font-size:8px;margin-top:3px}.step strong{font:900 12px ui-monospace,monospace;color:#1683a7}.total-row{border-top:1px solid var(--line);padding-top:13px;margin-top:4px;display:flex;justify-content:space-between;font-size:10px}.total-row strong{font:900 17px ui-monospace,monospace}.balance-box{padding:18px;border:1px solid #d0e8ef;background:#f2fbfe;border-radius:14px}.balance-box strong{display:block;font:900 27px ui-monospace,monospace;color:#1380a4;margin:6px 0}.balance-box p{margin:0;color:#738a93;font-size:9px;line-height:1.6}.meter{height:8px;background:#dbecef;border-radius:99px;overflow:hidden;margin:14px 0 7px}.meter i{display:block;height:100%;background:var(--blue);border-radius:inherit}.meter-label{display:flex;justify-content:space-between;font:800 7px ui-monospace,monospace;color:#789099}.rules{margin-top:14px;font-size:10px;color:var(--muted)}.rules summary{cursor:pointer;font:900 9px ui-monospace,monospace;color:#397481}.rules p{line-height:1.7;margin-bottom:0}@media(max-width:800px){.fields{grid-template-columns:1fr 1fr}.two,.answer-grid{grid-template-columns:1fr}}@media(max-width:520px){.page{padding:25px 13px 55px}.hero{display:block}.hero-icon{margin-top:16px}.card,.answer{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.rank-orb{width:35px;height:35px}.rank-node small{font-size:5px}.quick{flex-wrap:wrap}}
</style>
<script>
import { calculateRankUp } from '../lib/rankUpCalculator.js';
import { RANKS } from '../data/rankUpCalculator.js';
const base=document.querySelector('#base'),current=document.querySelector('#current'),target=document.querySelector('#target'),available=document.querySelector('#available'),answer=document.querySelector('#result'),rankPath=document.querySelector('#rankPath'),bracket=document.querySelector('#bracket'),steps=document.querySelector('#steps'),balance=document.querySelector('#balance');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);
function render(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c);const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availablePoints:available.value});if(!d.valid){answer.innerHTML=`<div class="answer-label">PLAYER</div><div class="answer-number" style="font-size:25px">${d.error}</div>`;return}const status=d.availablePoints==null?'Add Available RP for an affordability check':d.affordable?`✓ Enough RP · ${fmt(d.remainingPoints)} RP left`:`✕ ${fmt(Math.abs(d.remainingPoints))} RP short`;const cls=d.availablePoints==null?'neutral':d.affordable?'good':'bad';answer.innerHTML=`<div class="answer-grid"><div><div class="answer-label">TOTAL RANK UP POINTS</div><div class="answer-number">${fmt(d.requiredPoints)} <small>RP</small></div><div class="answer-sub">Base OVR ${d.baseOVR} · Rank ${d.currentRank} → Rank ${d.targetRank}</div></div><div class="stats"><div class="stat"><span>DISPLAYED OVR</span><strong>${d.baseOVR+d.currentRank} → ${d.targetOVR}</strong></div><div class="stat"><span>SKILL POINTS</span><strong>+${d.skillPoints}</strong></div><div class="stat"><span>RANKS GAINED</span><strong>+${d.ranksGained}</strong></div><div class="stat"><span>OVR GAIN</span><strong>+${d.ovrGain}</strong></div><div class="status ${cls}">${status}</div></div></div>`;
rankPath.innerHTML=RANKS.map((r,i)=>`${i?'<div class="rank-line"></div>':''}<div class="rank-node ${r.rank===d.currentRank?'current':''} ${r.rank===d.targetRank?'target':''}"><div class="rank-orb">R${r.rank}</div><small>${r.name}</small></div>`).join('');bracket.textContent=`Base OVR ${d.bracket.label}`;
steps.innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-icon">R${s.to}</div><div><b>Rank ${s.from} → Rank ${s.to}</b><small>${RANKS[s.to].name} · +1 OVR · +1 Skill Point</small></div><strong>${fmt(s.cost)} RP</strong></div>`).join('')+`<div class="total-row"><span>Total</span><strong>${fmt(d.requiredPoints)} RP</strong></div>`:'<div class="balance-box"><strong>No upgrade needed</strong><p>The player is already at the selected target rank</p></div>';
if(d.availablePoints==null)balance.innerHTML='<div class="balance-box"><strong>Enter RP</strong><p>Add your current Rank Up Points above to see how far you can upgrade this player</p></div>';else{const pct=d.requiredPoints?Math.min(100,d.availablePoints/d.requiredPoints*100):100;balance.innerHTML=`<div class="balance-box"><span class="eyebrow">AVAILABLE RP</span><strong>${fmt(d.availablePoints)}</strong><p>${fmt(d.requiredPoints)} RP required for this upgrade</p><div class="meter"><i style="width:${pct}%"></i></div><div class="meter-label"><span>${Math.round(pct)}% covered</span><span>${d.affordable?fmt(d.remainingPoints)+' left':fmt(Math.abs(d.remainingPoints))+' short'}</span></div></div>`}}
[base,current,target,available].forEach(x=>x.addEventListener('input',render));document.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>{target.value=String(Math.min(5,Number(current.value)+Number(b.dataset.step)));render()}));document.querySelector('#max').addEventListener('click',()=>{target.value='5';render()});render();
</script>