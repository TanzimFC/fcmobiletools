---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString('en-US');
const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';

/* ---------- Colour helpers (used to cut the vector gems + theme the page) ---------- */
const toRgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const toHex = (c) => '#' + c.map((v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, '0')).join('');
const mix = (h, to, a) => toHex(toRgb(h).map((v, i) => v + (to[i] - v) * a));
const lighten = (h, a) => mix(h, [255, 255, 255], a);
const darken = (h, a) => mix(h, [0, 0, 0], a);

// One colour per rank. The whole page re-tints itself to the selected TARGET rank.
const THEMES = [
  { base: '#c4cdd8' }, // Base
  { base: '#34d65b' }, // Green
  { base: '#3d86ff' }, // Blue
  { base: '#a35cff' }, // Purple
  { base: '#ff4a5a' }, // Red
  { base: '#ff9f1c' }  // Orange
].map((t) => ({ ...t, light: lighten(t.base, 0.5), deep: darken(t.base, 0.5) }));

const MAX_RP = RANK_COSTS[0].costs.reduce((a, b) => a + b, 0);
const BRACKETS = RANK_COSTS.length;
const STEP_LABELS = RANKS.slice(0, 5).map((r, i) => `${r.name} → ${RANKS[i + 1].name}`);
const HEAT_MAX = Math.max(...RANK_COSTS.flatMap((r) => r.costs));
---

<BaseLayout
  title="FC Mobile Rank Up Calculator"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank. Live RP totals, step-by-step costs, OVR after rank-up and skill points."
>
  <!-- Vector gem sprite: crisp at any size, re-used everywhere via <use> -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      {THEMES.map((t, i) => (
        <>
          <linearGradient id={`rk-gc-${i}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color={lighten(t.base, 0.86)} />
            <stop offset="1" stop-color={lighten(t.base, 0.4)} />
          </linearGradient>
          <linearGradient id={`rk-gl-${i}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color={lighten(t.base, 0.2)} />
            <stop offset="1" stop-color={t.base} />
          </linearGradient>
          <linearGradient id={`rk-gr-${i}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color={darken(t.base, 0.1)} />
            <stop offset="1" stop-color={darken(t.base, 0.38)} />
          </linearGradient>
        </>
      ))}
    </defs>
    {THEMES.map((t, i) => (
      <symbol id={`rk-gem-${i}`} viewBox="0 0 100 100">
        <polygon points="50,3 92,27 92,73 50,97 8,73 8,27" fill={darken(t.base, 0.5)} stroke={darken(t.base, 0.62)} stroke-width="5" stroke-linejoin="round" />
        <polygon points="50,3 8,27 29,37" fill={lighten(t.base, 0.4)} />
        <polygon points="50,3 29,37 71,37" fill={lighten(t.base, 0.62)} />
        <polygon points="50,3 71,37 92,27" fill={lighten(t.base, 0.14)} />
        <polygon points="8,27 29,37 50,85 8,73" fill={`url(#rk-gl-${i})`} />
        <polygon points="92,27 71,37 50,85 92,73" fill={`url(#rk-gr-${i})`} />
        <polygon points="8,73 50,85 50,97" fill={darken(t.base, 0.14)} />
        <polygon points="92,73 50,85 50,97" fill={darken(t.base, 0.42)} />
        <polygon points="29,37 71,37 50,85" fill={`url(#rk-gc-${i})`} />
        <path d="M50 3L29 37L71 37Z M8 27L29 37L50 85L8 73 M92 27L71 37L50 85L92 73 M50 85L50 97" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="1" stroke-linejoin="round" />
        <path d="M50 3L8 27" stroke="rgba(255,255,255,.6)" stroke-width="1.6" stroke-linecap="round" />
        <path d="M30 20l2.2 6.2 6.2 2.2-6.2 2.2L30 37l-2.2-6.2-6.2-2.2 6.2-2.2z" fill="#fff" opacity=".85" transform="translate(5 -7) scale(.8)" />
      </symbol>
    ))}
  </svg>

  <main class="rank-page" id="rkPage" data-themes={JSON.stringify(THEMES)}>
    <div class="rk-bg" aria-hidden="true">
      <i class="rk-blob rk-blob-a"></i>
      <i class="rk-blob rk-blob-b"></i>
      <i class="rk-blob rk-blob-c"></i>
      <i class="rk-grid"></i>
    </div>

    <!-- ======================= HERO ======================= -->
    <section class="rk-hero">
      <div class="rk-wrap rk-hero-grid">
        <div class="rk-hero-copy">
          <nav class="rk-crumbs rk-in" style="--d:0" aria-label="Breadcrumb">
            <a href="/">FCMOBILETOOLS</a><span>/</span><span>Tools</span><span>/</span><b>Rank Up</b>
          </nav>

          <span class="rk-pill rk-in" style="--d:1"><i></i>FC Mobile companion tool</span>

          <h1 class="rk-in" style="--d:2">
            <span class="rk-h1-a">Rank Up</span>
            <span class="rk-h1-b">Calculator</span>
          </h1>

          <p class="rk-lede rk-in" style="--d:3">
            Build an upgrade route from Base to Orange and see the exact RP requirement, OVR after rank-up, skill points and remaining balance.
          </p>

          <div class="rk-hero-actions rk-in" style="--d:4">
            <a class="rk-btn rk-btn-primary" href="#calculator">Start calculating <span aria-hidden="true">→</span></a>
            <a class="rk-btn rk-btn-ghost" href="#reference">RP cost table</a>
          </div>

          <ul class="rk-hero-stats rk-in" style="--d:5">
            <li><strong>{RANKS.length}</strong><span>Ranks</span></li>
            <li><strong>{BRACKETS}</strong><span>OVR brackets</span></li>
            <li><strong>{fmt(MAX_RP)}</strong><span>Max RP route</span></li>
          </ul>
        </div>

        <div class="rk-stage rk-in" style="--d:3" id="rkStage" aria-hidden="true">
          <div class="rk-halo"></div>
          <div class="rk-ring rk-ring-a"></div>
          <div class="rk-ring rk-ring-b"></div>
          <div class="rk-ring rk-ring-glow"></div>

          <div class="rk-orbit">
            {THEMES.map((t, i) => (
              <span class="rk-sat" data-sat={i} style={`--a:${i * 60}deg`}>
                <svg viewBox="0 0 100 100"><use href={`#rk-gem-${i}`}></use></svg>
              </span>
            ))}
          </div>

          <div class="rk-gem-wrap">
            <div class="rk-gem-float" id="heroGemFloat">
              <svg class="rk-hero-gem" viewBox="0 0 100 100"><use id="heroGem" href="#rk-gem-5"></use></svg>
              <i class="rk-gem-sheen"></i>
            </div>
            <i class="rk-gem-floor"></i>
          </div>

          <div class="rk-stage-cap">
            <small>Target rank</small>
            <strong id="heroName">Orange</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= RANK 6 NEWS ======================= -->
    <section class="rk-wrap rk-news rk-reveal" aria-label="Rank Up Level 6 update">
      <div class="rk-news-copy">
        <span class="rk-badge"><i></i>Rank Up Watch · Oct 8, 2026</span>
        <h2>Rank Up Level 6 could be coming</h2>
        <p>
          A new community report points to a possible sixth Rank Up tier that may use a separate currency. It is <strong>not in the game yet</strong>, and the name, cost and rewards are not confirmed.
        </p>
        <ul class="rk-news-meta">
          <li><b>Live system</b>Rank 5 · Orange</li>
          <li><b>Rumor</b>New currency for Rank 6</li>
          <li><b>Theory</b>Extra Skill Point / third PlayStyle slot</li>
        </ul>
      </div>
      <a class="rk-news-link" href="/blog/fc-mobile-rank-up-level-6-new-currency-leak/">
        <span>Read the breakdown</span>
        <strong>What this could mean <i aria-hidden="true">→</i></strong>
      </a>
    </section>

    <!-- ======================= CALCULATOR ======================= -->
    <section class="rk-wrap rk-console" id="calculator">
      <!-- ---- Controls ---- -->
      <div class="rk-panel rk-controls rk-reveal" data-spot>
        <header class="rk-panel-head">
          <div>
            <span class="rk-eyebrow"><i></i>Rank path builder</span>
            <h2>Plan the upgrade</h2>
            <p>Choose the player’s Base OVR, starting rank and destination rank.</p>
          </div>
          <span class="rk-status"><i></i>Calculator active</span>
        </header>

        <div class="rk-fields">
          <div class="rk-field">
            <label class="rk-label" for="base">Base OVR</label>
            <div class="rk-input">
              <button type="button" class="rk-step-btn" data-step="-1" data-for="base" aria-label="Decrease Base OVR">−</button>
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" />
              <button type="button" class="rk-step-btn" data-step="1" data-for="base" aria-label="Increase Base OVR">+</button>
            </div>
            <small class="rk-hint">Cost bracket <b id="bracketLabel">110+</b></small>
          </div>

          <div class="rk-field">
            <label class="rk-label" for="available">Available RP <em>Optional</em></label>
            <div class="rk-input rk-input-rp">
              <span class="rk-input-icon"><img src={RP_ICON} alt="" width="26" height="26" loading="lazy" /></span>
              <input id="available" type="number" min="0" placeholder="Enter your RP" inputmode="numeric" />
              <span class="rk-unit">RP</span>
            </div>
            <small class="rk-hint">See what’s left after the route.</small>
          </div>
        </div>

        <section class="rk-select" aria-label="Rank selection">
          <div class="rk-select-head">
            <div>
              <span class="rk-eyebrow"><i></i>Rank route</span>
              <h3>Choose your upgrade path</h3>
            </div>
            <div class="rk-route-chip" aria-live="polite">
              <span id="routeFromLarge">Base</span><i aria-hidden="true">→</i><span id="routeToLarge">Orange</span>
            </div>
          </div>

          <div class="rk-lane">
            <div class="rk-lane-label"><b>01</b><div><strong>Current rank</strong><small>Where the player is now</small></div></div>
            <div class="rk-gems" id="currentChoices" role="group" aria-label="Current rank">
              {RANKS.map((rank) => (
                <button class="rk-gem-btn" type="button" data-kind="current" data-value={rank.value} aria-pressed="false" aria-label={`Current rank: ${rank.name}`} style={`--c:${THEMES[rank.value].base}`}>
                  <span class="rk-gem-halo"></span>
                  <span class="rk-gem-body"><svg class="rk-gem" viewBox="0 0 100 100"><use href={`#rk-gem-${rank.value}`}></use></svg></span>
                  <span class="rk-gem-name">{rank.name}</span>
                  <span class="rk-gem-check" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </div>

          <div class="rk-flow" aria-hidden="true"><span></span><b>Upgrade</b><span></span></div>

          <div class="rk-lane">
            <div class="rk-lane-label"><b>02</b><div><strong>Target rank</strong><small>Where you want to finish</small></div></div>
            <div class="rk-gems" id="targetChoices" role="group" aria-label="Target rank">
              {RANKS.map((rank) => (
                <button class="rk-gem-btn" type="button" data-kind="target" data-value={rank.value} aria-pressed="false" aria-label={`Target rank: ${rank.name}`} style={`--c:${THEMES[rank.value].base}`}>
                  <span class="rk-gem-halo"></span>
                  <span class="rk-gem-body"><svg class="rk-gem" viewBox="0 0 100 100"><use href={`#rk-gem-${rank.value}`}></use></svg></span>
                  <span class="rk-gem-name">{rank.name}</span>
                  <span class="rk-gem-check" aria-hidden="true">✓</span>
                </button>
              ))}
            </div>
          </div>
        </section>

        <input id="current" type="hidden" value="0" />
        <input id="target" type="hidden" value="5" />
        <div id="error" class="rk-error" role="alert" hidden></div>

        <section class="rk-steps-wrap" aria-label="Cost breakdown">
          <div class="rk-steps-head">
            <div>
              <span class="rk-eyebrow"><i></i>Upgrade steps</span>
              <h3>Cost breakdown</h3>
            </div>
            <div class="rk-steps-total"><small>Total</small><strong id="costTotal">0 RP</strong></div>
          </div>
          <ol class="rk-steps" id="stepRows"></ol>
        </section>
      </div>

      <!-- ---- Results ---- -->
      <aside class="rk-panel rk-result rk-reveal" id="rkResult" data-spot aria-label="Results">
        <div class="rk-result-route">
          <span class="rk-mini"><svg viewBox="0 0 100 100"><use id="resFromGem" href="#rk-gem-0"></use></svg><b id="routeFrom">Base</b></span>
          <i class="rk-result-arrow" aria-hidden="true"><span></span></i>
          <span class="rk-mini"><svg viewBox="0 0 100 100"><use id="resToGem" href="#rk-gem-5"></use></svg><b id="routeTo">Orange</b></span>
        </div>

        <span class="rk-eyebrow"><i></i>Total RP required</span>
        <div class="rk-total">
          <span class="rk-rp-icon"><img src={RP_ICON} alt="" width="64" height="64" /></span>
          <strong id="required">0</strong>
          <em>RP</em>
        </div>
        <p class="rk-status-line" id="status">Choose your upgrade route.</p>

        <div class="rk-meter" id="meter" hidden>
          <div class="rk-meter-top">
            <span>You have <b id="meterHave">0</b> RP</span>
            <span class="rk-meter-chip" id="meterChip">—</span>
          </div>
          <div class="rk-meter-bar"><i id="meterFill"></i></div>
        </div>

        <div class="rk-stats">
          <div class="rk-stat"><span>OVR after rank</span><strong id="ovr">110</strong><small>Base OVR + target rank</small></div>
          <div class="rk-stat"><span>Ranks gained</span><strong id="gained">0</strong><small>Upgrade steps</small></div>
          <div class="rk-stat"><span>Skill points</span><strong id="skills">0</strong><small>Earned from upgrades</small></div>
          <div class="rk-stat"><span>RP balance</span><strong id="remaining">—</strong><small>After available RP</small></div>
        </div>

        <div class="rk-actions">
          <button type="button" class="rk-btn rk-btn-primary rk-btn-sm" id="copyLink"><span id="copyLabel">Copy link</span></button>
          <button type="button" class="rk-btn rk-btn-ghost rk-btn-sm" id="resetBtn">Reset</button>
        </div>
      </aside>
    </section>

    <!-- ======================= REFERENCE ======================= -->
    <section class="rk-wrap rk-ref rk-reveal" id="reference">
      <header class="rk-section-head">
        <div>
          <span class="rk-eyebrow"><i></i>Reference</span>
          <h2>RP cost by Base OVR</h2>
          <p>Each column is the RP cost of one rank step inside that Base OVR bracket. Your bracket and route light up as you calculate.</p>
        </div>
        <span class="rk-status"><i></i>Live data</span>
      </header>

      <div class="rk-ref-card">
        <div class="rk-ref-scroll">
          <table class="rk-ref-table">
            <thead>
              <tr>
                <th scope="col">Base OVR</th>
                {STEP_LABELS.map((label, i) => (
                  <th scope="col" data-step={i}>
                    <span class="rk-th">
                      <svg viewBox="0 0 100 100"><use href={`#rk-gem-${i + 1}`}></use></svg>
                      <span>{label}</span>
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr data-label={row.label} data-min={row.min} data-max={row.max ?? ''}>
                  <th scope="row"><span>{row.label}</span></th>
                  {row.costs.map((cost, index) => (
                    <td data-step={index} style={`--h:${(cost / HEAT_MAX).toFixed(3)}`}>
                      <b>{fmt(cost)}</b><small>RP</small>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================= FAQ ======================= -->
    <section class="rk-wrap rk-faq rk-reveal">
      <header class="rk-section-head">
        <div>
          <span class="rk-eyebrow"><i></i>Need to know</span>
          <h2>Rank Up Calculator FAQ</h2>
        </div>
      </header>
      <div class="rk-faq-grid">
        <details open>
          <summary>How is the RP total calculated?</summary>
          <div class="rk-faq-body"><p>The calculator reads the Base OVR bracket and adds every rank-step cost between the current and target rank.</p></div>
        </details>
        <details>
          <summary>Which ranks are supported?</summary>
          <div class="rk-faq-body"><p>Base, Green, Blue, Purple, Red and Orange.</p></div>
        </details>
        <details>
          <summary>What does Available RP do?</summary>
          <div class="rk-faq-body"><p>Enter your current RP balance to see the remaining amount after the selected route.</p></div>
        </details>
        <details>
          <summary>What is Base OVR?</summary>
          <div class="rk-faq-body"><p>It is the player’s OVR before any Rank Up bonus. Each rank step adds +1 OVR, so reaching Orange adds +5 in total.</p></div>
        </details>
        <details>
          <summary>Is Rank Up Level 6 in the game?</summary>
          <div class="rk-faq-body"><p>Not yet. Rank 5 · Orange is the highest live rank, and anything about a sixth tier is still an unconfirmed report.</p></div>
        </details>
        <details>
          <summary>Can I share my route?</summary>
          <div class="rk-faq-body"><p>Yes. Use <strong>Copy link</strong> in the results panel to share your exact Base OVR and rank route.</p></div>
        </details>
      </div>
    </section>

    <!-- Mobile dock: keeps the live total visible while you pick ranks -->
    <button type="button" class="rk-dock" id="rkDock" aria-label="Jump to results">
      <span class="rk-dock-route">
        <svg viewBox="0 0 100 100"><use id="dockFrom" href="#rk-gem-0"></use></svg>
        <i aria-hidden="true">→</i>
        <svg viewBox="0 0 100 100"><use id="dockTo" href="#rk-gem-5"></use></svg>
      </span>
      <span class="rk-dock-total"><small>Total RP</small><strong id="dockTotal">0</strong></span>
      <span class="rk-dock-go" aria-hidden="true">↓</span>
    </button>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString('en-US');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const page = $('rkPage');
    const themes = JSON.parse(page.dataset.themes);
    page.classList.add('rk-js');

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');
    const stepList = $('stepRows');

    const DEFAULTS = { base: 110, current: 0, target: 5 };

    /* ---------- Initial state (only read params that are really in the URL) ---------- */
    const params = new URLSearchParams(window.location.search);
    const readParam = (key, min, max) => {
      if (!params.has(key)) return null;
      const n = Number(params.get(key));
      return Number.isInteger(n) && n >= min && n <= max ? n : null;
    };
    const pBase = readParam('base', 0, 150);
    const pCur = readParam('current', 0, 5);
    const pTar = readParam('target', 0, 5);
    base.value = String(pBase ?? DEFAULTS.base);
    current.value = String(pCur ?? DEFAULTS.current);
    target.value = String(pTar ?? DEFAULTS.target);
    if (Number(target.value) <= Number(current.value)) target.value = String(Math.min(5, Number(current.value) + 1));
    if (Number(current.value) >= Number(target.value)) current.value = String(Math.max(0, Number(target.value) - 1));

    const rankName = (value) => RANKS[value]?.name || 'Base';
    const gem = (n, cls = '') =>
      '<svg class="rk-gem ' + cls + '" viewBox="0 0 100 100" aria-hidden="true"><use href="#rk-gem-' + n + '"></use></svg>';

    /* ---------- Animated numbers ---------- */
    function tween(el, to, format = fmt) {
      const from = Number.isFinite(el.__v) ? el.__v : 0;
      cancelAnimationFrame(el.__raf);
      if (reduce || from === to) { el.__v = to; el.textContent = format(to); return; }
      const t0 = performance.now();
      const dur = Math.min(950, 380 + Math.abs(to - from) * 0.35);
      const tick = (now) => {
        const p = Math.min(1, (now - t0) / dur);
        const e = 1 - Math.pow(1 - p, 4);
        const v = Math.round(from + (to - from) * e);
        el.__v = v;
        el.textContent = format(v);
        if (p < 1) el.__raf = requestAnimationFrame(tick);
        else { el.__v = to; el.textContent = format(to); }
      };
      el.__raf = requestAnimationFrame(tick);
    }
    function setStatic(el, text) { cancelAnimationFrame(el.__raf); el.__v = undefined; el.textContent = text; }

    /* ---------- Particle burst on rank pick ---------- */
    function burst(el) {
      if (reduce) return;
      const r = el.getBoundingClientRect();
      const color = el.style.getPropertyValue('--c') || '#fff';
      for (let i = 0; i < 12; i++) {
        const s = document.createElement('i');
        s.className = 'rk-spark';
        s.style.left = r.left + r.width / 2 + 'px';
        s.style.top = r.top + r.height / 2 - 8 + 'px';
        s.style.background = color;
        s.style.color = color;
        document.body.appendChild(s);
        const a = (Math.PI * 2 * i) / 12 + Math.random() * 0.5;
        const d = 38 + Math.random() * 38;
        s.animate(
          [
            { transform: 'translate(-50%,-50%) scale(1) rotate(45deg)', opacity: 1 },
            { transform: `translate(calc(-50% + ${Math.cos(a) * d}px),calc(-50% + ${Math.sin(a) * d}px)) scale(0) rotate(180deg)`, opacity: 0 }
          ],
          { duration: 600 + Math.random() * 260, easing: 'cubic-bezier(.2,.8,.2,1)' }
        ).onfinish = () => s.remove();
      }
    }

    /* ---------- Rank selectors ---------- */
    let rankTouched = false;

    function wireSelectors() {
      currentChoices.querySelectorAll('.rk-gem-btn').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if (Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          rankTouched = true;
          burst(button);
          render();
        });
      });
      targetChoices.querySelectorAll('.rk-gem-btn').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.disabled) return;
          target.value = button.dataset.value;
          rankTouched = true;
          burst(button);
          render();
        });
      });
    }

    function syncSelectors() {
      const from = Number(current.value);
      const to = Number(target.value);
      currentChoices.querySelectorAll('.rk-gem-btn').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === from;
        button.disabled = value >= to;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      targetChoices.querySelectorAll('.rk-gem-btn').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === to;
        button.disabled = value <= from;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    }

    /* ---------- Steps list ---------- */
    let stepSig = '';
    function renderSteps(data) {
      tween($('costTotal'), data.requiredRP, (v) => fmt(v) + ' RP');
      const sig = [data.bracket.label, data.currentRank, data.targetRank].join('|');
      if (sig === stepSig) return;
      stepSig = sig;

      if (!data.steps.length) {
        stepList.innerHTML = '<li class="rk-empty">No upgrade steps are required for this route.</li>';
        return;
      }
      let run = 0;
      stepList.innerHTML = data.steps
        .map((step, index) => {
          run += step.cost;
          const pct = Math.max(6, Math.round((run / data.requiredRP) * 100));
          return (
            '<li class="rk-step" style="--i:' + index + ';--w:' + pct + '%;--from:' + themes[step.from].base + ';--to:' + themes[step.to].base + '">' +
              '<span class="rk-step-n">' + String(index + 1).padStart(2, '0') + '</span>' +
              '<div class="rk-step-route">' +
                '<span class="rk-chip">' + gem(step.from) + '<b>' + rankName(step.from) + '</b></span>' +
                '<i class="rk-chip-arrow" aria-hidden="true">→</i>' +
                '<span class="rk-chip">' + gem(step.to) + '<b>' + rankName(step.to) + '</b></span>' +
              '</div>' +
              '<div class="rk-step-cost"><strong>' + fmt(step.cost) + '</strong><small>RP</small></div>' +
              '<div class="rk-step-bar" aria-hidden="true"><i></i><em>Running total ' + fmt(run) + '</em></div>' +
            '</li>'
          );
        })
        .join('');
    }

    /* ---------- Reference table highlight ---------- */
    const refRows = [...document.querySelectorAll('.rk-ref tbody tr')];
    const refStepCells = [...document.querySelectorAll('.rk-ref [data-step]')];
    function syncReference(data) {
      refRows.forEach((tr) => tr.classList.toggle('is-active', tr.dataset.label === data.bracket.label));
      refStepCells.forEach((cell) => {
        const i = Number(cell.dataset.step);
        cell.classList.toggle('in-route', i + 1 > data.currentRank && i + 1 <= data.targetRank);
      });
    }

    /* ---------- Theme + hero ---------- */
    let lastTarget = -1;
    function applyTheme(data) {
      const t = themes[data.targetRank];
      page.style.setProperty('--rk-accent', t.base);
      page.style.setProperty('--rk-accent-2', t.light);
      page.style.setProperty('--rk-deep', t.deep);

      $('heroGem').setAttribute('href', '#rk-gem-' + data.targetRank);
      $('resFromGem').setAttribute('href', '#rk-gem-' + data.currentRank);
      $('resToGem').setAttribute('href', '#rk-gem-' + data.targetRank);
      $('dockFrom').setAttribute('href', '#rk-gem-' + data.currentRank);
      $('dockTo').setAttribute('href', '#rk-gem-' + data.targetRank);
      $('heroName').textContent = rankName(data.targetRank);

      document.querySelectorAll('.rk-sat').forEach((sat) => {
        sat.classList.toggle('on', Number(sat.dataset.sat) === data.targetRank);
      });

      if (lastTarget !== data.targetRank && lastTarget !== -1 && !reduce) {
        const f = $('heroGemFloat');
        f.classList.remove('pop'); void f.offsetWidth; f.classList.add('pop');
      }
      lastTarget = data.targetRank;
    }

    /* ---------- Activity tracking (unchanged contract) ---------- */
    let rankActivityTimer = 0;
    let lastRankActivitySignature = '';
    function scheduleRankActivity(data) {
      if (!rankTouched || !data?.valid) return;
      window.clearTimeout(rankActivityTimer);
      rankActivityTimer = window.setTimeout(() => {
        const signature = [data.baseOVR, data.currentRank, data.targetRank, data.requiredRP].join(':');
        if (signature === lastRankActivitySignature) return;
        lastRankActivitySignature = signature;
        window.dispatchEvent(new CustomEvent('fcmobiletools:tool-activity', {
          detail: {
            entityId: 'rank-up-calculator',
            durationMs: 3000,
            metadata: {
              baseOVR: Number(data.baseOVR),
              currentRank: Number(data.currentRank),
              targetRank: Number(data.targetRank),
              requiredRP: Number(data.requiredRP)
            }
          }
        }));
      }, 900);
    }

    /* ---------- Main render ---------- */
    function render() {
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if (!data.valid) {
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }
      $('error').hidden = true;

      applyTheme(data);
      tween($('required'), data.requiredRP);
      tween($('ovr'), data.targetOVR);
      tween($('skills'), data.skillPoints);
      tween($('gained'), data.ranksGained);
      tween($('dockTotal'), data.requiredRP);

      const remaining = $('remaining');
      remaining.classList.toggle('neg', data.remainingRP !== null && data.remainingRP < 0);
      if (data.remainingRP === null) setStatic(remaining, '—');
      else if (Number.isFinite(remaining.__v)) tween(remaining, data.remainingRP);
      else setStatic(remaining, fmt(data.remainingRP)), (remaining.__v = data.remainingRP);

      $('status').textContent = data.bracket.label + ' OVR · ' + rankName(data.currentRank) + ' → ' + rankName(data.targetRank);
      $('routeFrom').textContent = rankName(data.currentRank);
      $('routeTo').textContent = rankName(data.targetRank);
      $('routeFromLarge').textContent = rankName(data.currentRank);
      $('routeToLarge').textContent = rankName(data.targetRank);

      // Affordability meter
      const meter = $('meter');
      if (data.availableRP === null) {
        meter.hidden = true;
      } else {
        meter.hidden = false;
        const pct = data.requiredRP === 0 ? 100 : Math.min(100, Math.round((data.availableRP / data.requiredRP) * 100));
        $('meterHave').textContent = fmt(data.availableRP);
        $('meterFill').style.width = pct + '%';
        meter.classList.toggle('ok', data.affordable);
        meter.classList.toggle('short', !data.affordable);
        $('meterChip').textContent = data.affordable
          ? (data.requiredRP === 0 ? 'Nothing to spend' : 'Enough RP')
          : 'Short by ' + fmt(data.requiredRP - data.availableRP) + ' RP';
      }

      renderSteps(data);
      syncReference(data);
      scheduleRankActivity(data);
    }

    /* ---------- Input steppers (tap or press-and-hold) ---------- */
    document.querySelectorAll('.rk-step-btn').forEach((btn) => {
      const input = $(btn.dataset.for);
      const dir = Number(btn.dataset.step);
      let hold = 0, repeat = 0;
      const nudge = () => {
        const next = Math.max(0, Math.min(150, (Number(input.value) || 0) + dir));
        input.value = String(next);
        rankTouched = true;
        render();
      };
      const stop = () => { clearTimeout(hold); clearInterval(repeat); };
      btn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        nudge();
        hold = window.setTimeout(() => { repeat = window.setInterval(nudge, 70); }, 380);
      });
      ['pointerup', 'pointerleave', 'pointercancel', 'blur'].forEach((ev) => btn.addEventListener(ev, stop));
      btn.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); nudge(); } });
    });

    [base, available].forEach((field) => field.addEventListener('input', () => { rankTouched = true; render(); }));

    /* ---------- Copy link + reset ---------- */
    const copyLabel = $('copyLabel');
    $('copyLink').addEventListener('click', async () => {
      const url = new URL(window.location.href);
      url.search = '';
      url.searchParams.set('base', String(Number(base.value) || 0));
      url.searchParams.set('current', current.value);
      url.searchParams.set('target', target.value);
      url.hash = '';
      let ok = false;
      try { await navigator.clipboard.writeText(url.toString()); ok = true; } catch {
        const ta = document.createElement('textarea');
        ta.value = url.toString(); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
      }
      copyLabel.textContent = ok ? 'Link copied ✓' : 'Copy failed';
      setTimeout(() => { copyLabel.textContent = 'Copy link'; }, 1800);
    });

    $('resetBtn').addEventListener('click', () => {
      base.value = String(DEFAULTS.base);
      current.value = String(DEFAULTS.current);
      target.value = String(DEFAULTS.target);
      available.value = '';
      rankTouched = true;
      render();
    });

    /* ---------- Cursor spotlight on glass panels ---------- */
    if (window.matchMedia('(hover: hover)').matches && !reduce) {
      document.querySelectorAll('[data-spot]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', e.clientX - r.left + 'px');
          el.style.setProperty('--my', e.clientY - r.top + 'px');
        });
      });
      // Hero parallax
      const stage = $('rkStage');
      const hero = document.querySelector('.rk-hero');
      hero.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
        const y = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
        stage.style.setProperty('--px', x.toFixed(3));
        stage.style.setProperty('--py', y.toFixed(3));
      });
    }

    /* ---------- Scroll reveal + mobile dock visibility ---------- */
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); reveal.unobserve(en.target); } });
    }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.rk-reveal').forEach((el) => reveal.observe(el));

    const dock = $('rkDock');
    let inConsole = false, inResult = false;
    const syncDock = () => dock.classList.toggle('is-visible', inConsole && !inResult);
    new IntersectionObserver((e) => { inConsole = e[0].isIntersecting; syncDock(); }, { threshold: 0.05 }).observe($('calculator'));
    new IntersectionObserver((e) => { inResult = e[0].isIntersecting; syncDock(); }, { threshold: 0.25 }).observe($('rkResult'));
    dock.addEventListener('click', () => $('rkResult').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }));

    wireSelectors();
    render();
  </script>

  <style is:global>
    /* ==========================================================================
       RANK UP CALCULATOR — premium redesign
       All selectors are prefixed (.rank-page / .rk-*) so nothing leaks site-wide.
       ========================================================================== */
    @property --rk-accent   { syntax:'<color>'; inherits:true; initial-value:#ff9f1c; }
    @property --rk-accent-2 { syntax:'<color>'; inherits:true; initial-value:#ffd08a; }
    @property --rk-deep     { syntax:'<color>'; inherits:true; initial-value:#804e0e; }
    @property --rk-angle    { syntax:'<angle>'; inherits:false; initial-value:0deg; }

    .rank-page{
      --rk-accent:#ff9f1c; --rk-accent-2:#ffd08a; --rk-deep:#804e0e;
      --rk-cyan:#4cc9ff;
      --rk-bg:#050d16;
      --rk-text:#eef6fb;
      --rk-muted:#93abbd;
      --rk-dim:#647f93;
      --rk-line:rgba(255,255,255,.08);
      --rk-line-2:rgba(255,255,255,.14);
      --rk-ease:cubic-bezier(.22,1,.36,1);
      --rk-glass:linear-gradient(160deg,rgba(20,38,58,.74),rgba(8,17,28,.88));
      position:relative; isolation:isolate; overflow:clip;
      min-height:100vh; color:var(--rk-text);
      background:var(--rk-bg);
      transition:--rk-accent .9s ease,--rk-accent-2 .9s ease,--rk-deep .9s ease;
      font-family:var(--font-body,'Inter',system-ui,sans-serif);
      -webkit-font-smoothing:antialiased;
    }
    .rank-page *,.rank-page *::before,.rank-page *::after{box-sizing:border-box}
    .rank-page h1,.rank-page h2,.rank-page h3{margin:0;font-family:var(--font-display,'Space Grotesk',system-ui,sans-serif);color:var(--rk-text)}
    .rank-page p{margin:0}
    .rank-page ol,.rank-page ul{margin:0;padding:0;list-style:none}
    .rank-page button{font-family:inherit}
    .rk-wrap{width:min(1200px,calc(100% - 40px));margin-inline:auto}
    .rank-page [id]{scroll-margin-top:110px}

    /* ---------- Atmosphere ---------- */
    .rk-bg{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
    .rk-blob{position:absolute;border-radius:50%;filter:blur(90px);will-change:transform;opacity:.9}
    .rk-blob-a{width:720px;height:720px;right:-220px;top:-260px;background:radial-gradient(circle,color-mix(in srgb,var(--rk-accent) 38%,transparent),transparent 68%);animation:rk-drift-a 26s ease-in-out infinite alternate}
    .rk-blob-b{width:640px;height:640px;left:-260px;top:120px;background:radial-gradient(circle,rgba(76,201,255,.2),transparent 70%);animation:rk-drift-b 32s ease-in-out infinite alternate}
    .rk-blob-c{width:900px;height:900px;left:30%;top:1250px;background:radial-gradient(circle,color-mix(in srgb,var(--rk-accent) 14%,transparent),transparent 70%);animation:rk-drift-a 38s ease-in-out infinite alternate-reverse}
    .rk-grid{position:absolute;inset:0;height:1100px;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse 80% 70% at 70% 0%,#000 0%,transparent 72%);-webkit-mask-image:radial-gradient(ellipse 80% 70% at 70% 0%,#000 0%,transparent 72%)}
    @keyframes rk-drift-a{to{transform:translate3d(-70px,60px,0) scale(1.08)}}
    @keyframes rk-drift-b{to{transform:translate3d(80px,-40px,0) scale(1.12)}}

    /* ---------- Shared bits ---------- */
    .rk-eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--rk-cyan);font:700 12px/1 var(--font-display,system-ui);letter-spacing:.18em;text-transform:uppercase}
    .rk-eyebrow i{width:22px;height:1px;background:currentColor;box-shadow:0 0 12px currentColor}
    .rk-pill,.rk-badge{display:inline-flex;align-items:center;gap:9px;padding:8px 14px;border:1px solid var(--rk-line-2);border-radius:999px;background:rgba(255,255,255,.04);backdrop-filter:blur(8px);color:var(--rk-muted);font:600 12px/1 var(--font-display,system-ui);letter-spacing:.1em;text-transform:uppercase}
    .rk-pill i,.rk-badge i,.rk-status i{width:7px;height:7px;border-radius:50%;background:var(--rk-accent);box-shadow:0 0 0 0 color-mix(in srgb,var(--rk-accent) 70%,transparent);animation:rk-ping 2.4s infinite}
    @keyframes rk-ping{70%{box-shadow:0 0 0 9px transparent}100%{box-shadow:0 0 0 0 transparent}}
    .rk-status{display:inline-flex;align-items:center;gap:9px;padding:9px 14px;border:1px solid var(--rk-line);border-radius:999px;color:var(--rk-muted);font:600 11.5px/1 var(--font-display,system-ui);letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}

    .rk-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:10px;height:54px;padding:0 26px;border:1px solid var(--rk-line-2);border-radius:16px;color:var(--rk-text);font:700 15px/1 var(--font-display,system-ui);letter-spacing:.01em;cursor:pointer;text-decoration:none;overflow:hidden;transition:transform .3s var(--rk-ease),box-shadow .3s var(--rk-ease),border-color .3s,background .3s}
    .rk-btn span{transition:transform .3s var(--rk-ease)}
    .rk-btn:hover{transform:translateY(-2px)}
    .rk-btn:hover span[aria-hidden]{transform:translateX(4px)}
    .rk-btn:active{transform:translateY(0) scale(.98)}
    .rk-btn-primary{border-color:transparent;color:#0a0f16;background:linear-gradient(135deg,var(--rk-accent-2),var(--rk-accent));box-shadow:0 14px 36px -10px color-mix(in srgb,var(--rk-accent) 70%,transparent),inset 0 1px 0 rgba(255,255,255,.55)}
    .rk-btn-primary::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-120%);transition:transform .8s var(--rk-ease)}
    .rk-btn-primary:hover{box-shadow:0 20px 44px -10px color-mix(in srgb,var(--rk-accent) 85%,transparent),inset 0 1px 0 rgba(255,255,255,.6)}
    .rk-btn-primary:hover::after{transform:translateX(120%)}
    .rk-btn-ghost{background:rgba(255,255,255,.04);backdrop-filter:blur(8px)}
    .rk-btn-ghost:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.26)}
    .rk-btn-sm{height:46px;padding:0 20px;font-size:14px;border-radius:14px;flex:1}

    /* ---------- Entrance choreography ---------- */
    .rk-in{opacity:0;transform:translateY(22px);animation:rk-rise .9s var(--rk-ease) forwards;animation-delay:calc(var(--d,0)*90ms + 120ms)}
    @keyframes rk-rise{to{opacity:1;transform:none}}
    .rank-page.rk-js .rk-reveal{opacity:0;transform:translateY(28px);transition:opacity .9s var(--rk-ease),transform .9s var(--rk-ease)}
    .rank-page.rk-js .rk-reveal.is-in{opacity:1;transform:none}

    /* ======================= HERO ======================= */
    .rk-hero{position:relative;padding:clamp(120px,13vw,150px) 0 54px}
    .rk-hero-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:40px;align-items:center}
    .rk-crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:26px;color:var(--rk-dim);font:600 12px/1 var(--font-display,system-ui);letter-spacing:.12em;text-transform:uppercase}
    .rk-crumbs a{color:var(--rk-cyan);transition:opacity .2s}.rk-crumbs a:hover{opacity:.75}
    .rk-crumbs b{color:var(--rk-muted);font-weight:600}
    .rk-hero-copy h1{margin:22px 0 22px;display:flex;flex-direction:column;font-weight:700;font-size:clamp(54px,8.4vw,108px);line-height:.92;letter-spacing:-.055em}
    .rk-h1-a{color:#fff}
    .rk-h1-b{background:linear-gradient(100deg,var(--rk-accent-2) 0%,var(--rk-accent) 55%,color-mix(in srgb,var(--rk-accent) 70%,#fff) 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;padding-bottom:.08em;filter:drop-shadow(0 0 38px color-mix(in srgb,var(--rk-accent) 38%,transparent))}
    .rk-lede{max-width:560px;color:var(--rk-muted);font-size:clamp(16px,1.5vw,18.5px);line-height:1.75}
    .rk-hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
    .rk-hero-stats{display:flex;flex-wrap:wrap;gap:clamp(22px,4vw,48px);margin-top:44px;padding-top:26px;border-top:1px solid var(--rk-line)}
    .rk-hero-stats li{display:grid;gap:6px}
    .rk-hero-stats strong{font:700 clamp(28px,3.4vw,38px)/1 var(--font-display,system-ui);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
    .rk-hero-stats span{color:var(--rk-dim);font:600 12px/1 var(--font-display,system-ui);letter-spacing:.14em;text-transform:uppercase}

    /* Stage */
    .rk-stage{--px:0;--py:0;position:relative;height:500px;display:grid;place-items:center}
    .rk-halo{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--rk-accent) 40%,transparent),color-mix(in srgb,var(--rk-accent) 8%,transparent) 48%,transparent 70%);filter:blur(10px);animation:rk-breathe 6s ease-in-out infinite}
    @keyframes rk-breathe{50%{transform:scale(1.12);opacity:.8}}
    .rk-ring{position:absolute;border-radius:50%}
    .rk-ring-a{width:330px;height:330px;border:1px solid var(--rk-line-2)}
    .rk-ring-b{width:470px;height:470px;border:1px dashed rgba(255,255,255,.1);animation:rk-spin 120s linear infinite}
    .rk-ring-glow{width:330px;height:330px;background:conic-gradient(from var(--rk-angle),transparent 0 62%,var(--rk-accent) 88%,transparent 100%);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));animation:rk-angle 7s linear infinite;filter:drop-shadow(0 0 10px var(--rk-accent))}
    @keyframes rk-angle{to{--rk-angle:360deg}}
    @keyframes rk-spin{to{transform:rotate(360deg)}}

    .rk-orbit{position:absolute;width:0;height:0;animation:rk-spin 60s linear infinite}
    .rk-sat{position:absolute;left:0;top:0;width:46px;height:46px;margin:-23px 0 0 -23px;transform:rotate(var(--a)) translateY(-235px);opacity:.5;transition:opacity .6s,filter .6s}
    .rk-sat svg{width:100%;height:100%;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.5));animation:rk-counter 60s linear infinite;transition:scale .6s var(--rk-ease)}
    .rk-sat.on{opacity:1}
    .rk-sat.on svg{scale:1.28;filter:drop-shadow(0 0 14px var(--rk-accent)) drop-shadow(0 6px 10px rgba(0,0,0,.5))}
    @keyframes rk-counter{from{transform:rotate(calc(-1*var(--a)))}to{transform:rotate(calc(-1*var(--a) - 360deg))}}

    .rk-gem-wrap{position:relative;display:grid;place-items:center;transform:translate3d(calc(var(--px)*34px),calc(var(--py)*26px),0);transition:transform .5s var(--rk-ease)}
    .rk-gem-float{position:relative;width:clamp(190px,22vw,260px);aspect-ratio:1;animation:rk-float 6.5s ease-in-out infinite}
    .rk-gem-float.pop{animation:rk-pop .8s var(--rk-ease),rk-float 6.5s ease-in-out .8s infinite}
    @keyframes rk-float{0%,100%{transform:translateY(-8px) rotate(-1.5deg)}50%{transform:translateY(12px) rotate(1.5deg)}}
    @keyframes rk-pop{0%{transform:scale(.72) rotate(-12deg);opacity:.2}60%{transform:scale(1.08) rotate(3deg);opacity:1}100%{transform:scale(1)}}
    .rk-hero-gem{width:100%;height:100%;display:block;filter:drop-shadow(0 34px 38px rgba(0,0,0,.6)) drop-shadow(0 0 46px color-mix(in srgb,var(--rk-accent) 50%,transparent))}
    .rk-gem-sheen{position:absolute;inset:0;clip-path:polygon(50% 3%,92% 27%,92% 73%,50% 97%,8% 73%,8% 27%);background:linear-gradient(115deg,transparent 38%,rgba(255,255,255,.7) 50%,transparent 62%);background-size:260% 100%;background-position:160% 0;animation:rk-sheen 5.5s ease-in-out 1.2s infinite;pointer-events:none;mix-blend-mode:overlay}
    @keyframes rk-sheen{0%{background-position:160% 0}40%,100%{background-position:-60% 0}}
    .rk-gem-floor{position:absolute;bottom:-44px;width:150px;height:22px;border-radius:50%;background:radial-gradient(ellipse,rgba(0,0,0,.6),transparent 70%);filter:blur(6px);animation:rk-floor 6.5s ease-in-out infinite}
    @keyframes rk-floor{0%,100%{transform:scale(1.05);opacity:.9}50%{transform:scale(.8);opacity:.55}}
    .rk-stage-cap{position:absolute;left:0;right:0;bottom:6px;text-align:center}
    .rk-stage-cap small{display:block;color:var(--rk-dim);font:600 12px/1 var(--font-display,system-ui);letter-spacing:.2em;text-transform:uppercase}
    .rk-stage-cap strong{display:block;margin-top:9px;font:700 28px/1 var(--font-display,system-ui);letter-spacing:-.02em;background:linear-gradient(90deg,#fff,var(--rk-accent-2));-webkit-background-clip:text;background-clip:text;color:transparent}

    /* ======================= NEWS ======================= */
    .rk-news{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:center;margin-top:18px;padding:28px 32px;border:1px solid var(--rk-line);border-radius:26px;background:var(--rk-glass);box-shadow:0 30px 60px -34px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.05);overflow:hidden}
    .rk-news::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(180deg,transparent,var(--rk-accent),transparent);box-shadow:0 0 24px var(--rk-accent)}
    .rk-news h2{margin:16px 0 10px;font:700 clamp(22px,2.6vw,28px)/1.15 var(--font-display,system-ui);letter-spacing:-.03em}
    .rk-news-copy>p{max-width:760px;color:var(--rk-muted);font-size:15px;line-height:1.75}
    .rk-news-copy>p strong{color:#fff;font-weight:600}
    .rk-news-meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:18px;color:var(--rk-dim);font:500 13px/1.4 var(--font-body,system-ui)}
    .rk-news-meta li{display:inline-flex;align-items:center;gap:9px}
    .rk-news-meta b{padding:4px 9px;border-radius:7px;background:rgba(76,201,255,.1);color:var(--rk-cyan);font:700 10.5px/1 var(--font-display,system-ui);letter-spacing:.12em;text-transform:uppercase}
    .rk-news-link{display:grid;gap:8px;min-width:220px;padding:18px 20px;border:1px solid var(--rk-line-2);border-radius:18px;background:rgba(255,255,255,.04);transition:transform .35s var(--rk-ease),border-color .3s,background .3s}
    .rk-news-link span{color:var(--rk-dim);font:600 11.5px/1 var(--font-display,system-ui);letter-spacing:.14em;text-transform:uppercase}
    .rk-news-link strong{display:flex;justify-content:space-between;gap:12px;font:700 15px/1.3 var(--font-display,system-ui)}
    .rk-news-link i{font-style:normal;color:var(--rk-accent);transition:transform .3s var(--rk-ease)}
    .rk-news-link:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--rk-accent) 55%,transparent);background:rgba(255,255,255,.07)}
    .rk-news-link:hover i{transform:translateX(5px)}

    /* ======================= GLASS PANELS ======================= */
    .rk-panel{position:relative;border-radius:30px;background:var(--rk-glass);box-shadow:0 1px 0 rgba(255,255,255,.07) inset,0 50px 90px -40px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.055);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
    .rk-panel::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:radial-gradient(540px circle at var(--mx,50%) var(--my,0%),color-mix(in srgb,var(--rk-accent) 13%,transparent),transparent 62%);opacity:0;transition:opacity .4s}
    .rk-panel:hover::before{opacity:1}
    .rk-panel::after{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;background:conic-gradient(from var(--rk-angle),transparent 0 74%,color-mix(in srgb,var(--rk-accent) 85%,transparent) 90%,transparent 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:rk-angle 9s linear infinite;opacity:.9}

    .rk-console{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:22px;align-items:start;margin-top:22px}
    .rk-controls{padding:clamp(22px,3vw,38px)}
    .rk-panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:30px}
    .rk-panel-head h2{margin:16px 0 8px;font:700 clamp(30px,3.6vw,42px)/1.02 var(--font-display,system-ui);letter-spacing:-.045em}
    .rk-panel-head p{color:var(--rk-muted);font-size:15px;line-height:1.6}

    /* ---------- Inputs ---------- */
    .rk-fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .rk-field{display:grid;gap:11px;align-content:start}
    .rk-label{display:flex;align-items:center;gap:10px;color:var(--rk-muted);font:700 12px/1 var(--font-display,system-ui);letter-spacing:.14em;text-transform:uppercase}
    .rk-label em{margin-left:auto;padding:4px 8px;border-radius:6px;background:rgba(255,255,255,.06);color:var(--rk-dim);font:600 10px/1 var(--font-display,system-ui);font-style:normal;letter-spacing:.1em}
    .rk-input{display:flex;align-items:center;gap:6px;height:66px;padding:0 8px;border:1px solid var(--rk-line-2);border-radius:20px;background:rgba(3,9,16,.62);box-shadow:inset 0 2px 8px rgba(0,0,0,.35);transition:border-color .25s,box-shadow .25s}
    .rk-input:focus-within{border-color:var(--rk-accent);box-shadow:inset 0 2px 8px rgba(0,0,0,.35),0 0 0 4px color-mix(in srgb,var(--rk-accent) 18%,transparent),0 0 36px -6px color-mix(in srgb,var(--rk-accent) 45%,transparent)}
    .rk-input input{flex:1;min-width:0;width:100%;height:100%;border:0;outline:0;background:transparent;color:#fff;text-align:center;font:700 28px/1 var(--font-display,system-ui);letter-spacing:-.03em;font-variant-numeric:tabular-nums;-moz-appearance:textfield;appearance:textfield}
    .rk-input input::placeholder{color:var(--rk-dim);font-weight:500;font-size:16px;letter-spacing:0}
    .rk-input input::-webkit-outer-spin-button,.rk-input input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
    .rk-input-rp input{text-align:left;padding-left:4px;font-size:24px}
    .rk-input-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.05);flex:none}
    .rk-input-icon img{width:26px;height:26px;object-fit:contain}
    .rk-unit{padding:0 14px 0 4px;color:var(--rk-dim);font:700 13px/1 var(--font-display,system-ui);letter-spacing:.12em}
    .rk-step-btn{flex:none;width:48px;height:48px;border:1px solid var(--rk-line);border-radius:15px;background:rgba(255,255,255,.05);color:var(--rk-text);font:500 24px/1 var(--font-display,system-ui);cursor:pointer;touch-action:manipulation;user-select:none;transition:background .2s,transform .2s var(--rk-ease),border-color .2s,color .2s}
    .rk-step-btn:hover{background:color-mix(in srgb,var(--rk-accent) 22%,transparent);border-color:color-mix(in srgb,var(--rk-accent) 55%,transparent);color:#fff}
    .rk-step-btn:active{transform:scale(.9)}
    .rk-hint{color:var(--rk-dim);font-size:13px;line-height:1.4;padding-left:4px}
    .rk-hint b{color:var(--rk-accent-2);font-weight:700}

    /* ---------- Rank selector ---------- */
    .rk-select{margin-top:34px;padding:clamp(18px,2.4vw,28px);border:1px solid var(--rk-line);border-radius:26px;background:linear-gradient(180deg,rgba(3,9,16,.5),rgba(3,9,16,.28))}
    .rk-select-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:24px}
    .rk-select-head h3{margin-top:14px;font:700 clamp(22px,2.4vw,27px)/1.1 var(--font-display,system-ui);letter-spacing:-.035em}
    .rk-route-chip{display:inline-flex;align-items:center;gap:12px;padding:11px 16px;border:1px solid color-mix(in srgb,var(--rk-accent) 40%,transparent);border-radius:14px;background:color-mix(in srgb,var(--rk-accent) 10%,transparent);font:700 14px/1 var(--font-display,system-ui);white-space:nowrap}
    .rk-route-chip i{color:var(--rk-accent-2);font-style:normal}
    .rk-lane{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;align-items:center}
    .rk-lane-label{display:flex;align-items:center;gap:12px}
    .rk-lane-label>b{display:grid;place-items:center;flex:none;width:36px;height:36px;border:1px solid var(--rk-line-2);border-radius:11px;background:rgba(255,255,255,.04);color:var(--rk-cyan);font:700 12px/1 var(--font-display,system-ui)}
    .rk-lane-label strong{display:block;font:700 14px/1.1 var(--font-display,system-ui)}
    .rk-lane-label small{display:block;margin-top:5px;color:var(--rk-dim);font-size:12px;line-height:1.3}
    .rk-gems{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
    .rk-flow{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;margin:12px 0 12px 168px}
    .rk-flow span{height:1px;background:linear-gradient(90deg,transparent,var(--rk-line-2),transparent)}
    .rk-flow b{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border:1px solid var(--rk-line);border-radius:999px;background:rgba(255,255,255,.03);color:var(--rk-dim);font:700 10.5px/1 var(--font-display,system-ui);letter-spacing:.18em;text-transform:uppercase}
    .rk-flow b::after{content:"↓";color:var(--rk-accent);animation:rk-bob 1.6s ease-in-out infinite}
    @keyframes rk-bob{50%{transform:translateY(3px)}}

    .rk-gem-btn{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;aspect-ratio:1/1.14;padding:10px 4px 12px;border:1px solid var(--rk-line);border-radius:20px;background:rgba(255,255,255,.025);color:var(--rk-muted);cursor:pointer;-webkit-tap-highlight-color:transparent;transition:transform .35s var(--rk-ease),border-color .3s,background .3s,box-shadow .35s,opacity .3s,filter .3s}
    .rk-gem-halo{position:absolute;inset:6px;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--c) 55%,transparent),transparent 68%);filter:blur(16px);opacity:0;transition:opacity .4s;pointer-events:none}
    .rk-gem-body{position:relative;width:62%;aspect-ratio:1;display:block;transition:transform .4s var(--rk-ease)}
    .rk-gem-body .rk-gem{width:100%;height:100%;display:block;filter:drop-shadow(0 8px 10px rgba(0,0,0,.5));transition:filter .4s}
    .rk-gem-body::after{content:"";position:absolute;inset:0;clip-path:polygon(50% 3%,92% 27%,92% 73%,50% 97%,8% 73%,8% 27%);background:linear-gradient(115deg,transparent 38%,rgba(255,255,255,.85) 50%,transparent 62%);background-size:260% 100%;background-position:160% 0;opacity:0;mix-blend-mode:overlay;pointer-events:none}
    .rk-gem-name{position:relative;font:700 12.5px/1 var(--font-display,system-ui);letter-spacing:.02em;transition:color .3s}
    .rk-gem-check{position:absolute;top:8px;right:8px;display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:var(--c);color:#06101a;font:900 11px/1 var(--font-display,system-ui);transform:scale(0);transition:transform .4s var(--rk-ease)}
    .rk-gem-btn:hover:not(:disabled){transform:translateY(-5px);border-color:color-mix(in srgb,var(--c) 55%,transparent);background:linear-gradient(180deg,color-mix(in srgb,var(--c) 14%,transparent),rgba(255,255,255,.02));color:#fff}
    .rk-gem-btn:hover:not(:disabled) .rk-gem-body{transform:scale(1.1) rotate(-3deg)}
    .rk-gem-btn:hover:not(:disabled) .rk-gem-halo{opacity:.55}
    .rk-gem-btn:active:not(:disabled){transform:translateY(-1px) scale(.97)}
    .rk-gem-btn.selected{border-color:var(--c);color:#fff;background:linear-gradient(180deg,color-mix(in srgb,var(--c) 20%,transparent),color-mix(in srgb,var(--c) 5%,transparent));box-shadow:0 0 0 1px var(--c),0 18px 44px -14px color-mix(in srgb,var(--c) 70%,transparent),inset 0 1px 0 rgba(255,255,255,.18)}
    .rk-gem-btn.selected .rk-gem-halo{opacity:1}
    .rk-gem-btn.selected .rk-gem-body{transform:scale(1.14);animation:rk-bobgem 3.8s ease-in-out infinite}
    .rk-gem-btn.selected .rk-gem-body .rk-gem{filter:drop-shadow(0 0 14px color-mix(in srgb,var(--c) 80%,transparent)) drop-shadow(0 8px 10px rgba(0,0,0,.5))}
    .rk-gem-btn.selected .rk-gem-body::after{opacity:1;animation:rk-sheen 3.6s ease-in-out infinite}
    .rk-gem-btn.selected .rk-gem-check{transform:scale(1)}
    @keyframes rk-bobgem{50%{transform:scale(1.14) translateY(-4px)}}
    .rk-gem-btn:disabled{opacity:.2;filter:grayscale(.7);cursor:not-allowed}
    .rk-gem-btn:focus-visible{outline:2px solid var(--c);outline-offset:3px}

    .rk-error{margin-top:18px;padding:14px 16px;border:1px solid rgba(255,112,112,.4);border-radius:14px;background:rgba(255,112,112,.08);color:#ffb4b4;font:600 14px/1.5 var(--font-body,system-ui)}
    .rk-error[hidden]{display:none}

    /* ---------- Steps ---------- */
    .rk-steps-wrap{margin-top:34px}
    .rk-steps-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:18px}
    .rk-steps-head h3{margin-top:14px;font:700 clamp(22px,2.4vw,27px)/1.1 var(--font-display,system-ui);letter-spacing:-.035em}
    .rk-steps-total{text-align:right}
    .rk-steps-total small{display:block;color:var(--rk-dim);font:700 11.5px/1 var(--font-display,system-ui);letter-spacing:.16em;text-transform:uppercase}
    .rk-steps-total strong{display:block;margin-top:7px;font:700 24px/1 var(--font-display,system-ui);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
    .rk-steps{display:grid;gap:10px}
    .rk-step{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"n route cost" "bar bar bar";align-items:center;gap:12px 18px;padding:16px 20px 14px;border:1px solid var(--rk-line);border-radius:20px;background:linear-gradient(135deg,rgba(255,255,255,.045),rgba(255,255,255,.015));overflow:hidden;opacity:0;transform:translateY(14px);animation:rk-rise .7s var(--rk-ease) forwards;animation-delay:calc(var(--i)*90ms);transition:border-color .3s,background .3s,transform .3s var(--rk-ease)}
    .rk-step:hover{border-color:var(--rk-line-2);transform:translateY(-2px);background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.025))}
    .rk-step-n{grid-area:n;display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:rgba(76,201,255,.1);border:1px solid rgba(76,201,255,.22);color:var(--rk-cyan);font:700 13px/1 var(--font-display,system-ui)}
    .rk-step-route{grid-area:route;display:flex;align-items:center;flex-wrap:wrap;gap:10px}
    .rk-chip{display:inline-flex;align-items:center;gap:9px;padding:6px 14px 6px 8px;border:1px solid var(--rk-line);border-radius:999px;background:rgba(3,9,16,.5)}
    .rk-chip .rk-gem{width:28px;height:28px;display:block;filter:drop-shadow(0 3px 5px rgba(0,0,0,.5))}
    .rk-chip b{font:700 14px/1 var(--font-display,system-ui)}
    .rk-chip-arrow{color:var(--rk-dim);font-style:normal;animation:rk-nudge 2s ease-in-out infinite}
    @keyframes rk-nudge{50%{transform:translateX(4px)}}
    .rk-step-cost{grid-area:cost;display:flex;align-items:baseline;gap:6px;text-align:right}
    .rk-step-cost strong{font:700 26px/1 var(--font-display,system-ui);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
    .rk-step-cost small{color:var(--rk-dim);font:700 12px/1 var(--font-display,system-ui);letter-spacing:.1em}
    .rk-step-bar{grid-area:bar;position:relative;height:6px;border-radius:99px;background:rgba(255,255,255,.06)}
    .rk-step-bar i{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--from),var(--to));box-shadow:0 0 14px color-mix(in srgb,var(--to) 60%,transparent);animation:rk-fill 1.1s var(--rk-ease) forwards;animation-delay:calc(var(--i)*90ms + 200ms)}
    @keyframes rk-fill{to{width:var(--w)}}
    .rk-step-bar em{position:absolute;right:0;top:12px;color:var(--rk-dim);font:500 12px/1 var(--font-body,system-ui);font-style:normal}
    .rk-step{padding-bottom:34px}
    .rk-empty{padding:26px 20px;border:1px dashed var(--rk-line-2);border-radius:18px;color:var(--rk-muted);text-align:center;font-size:15px}

    /* ======================= RESULT PANEL ======================= */
    .rk-result{position:sticky;top:104px;padding:clamp(22px,2.6vw,32px);overflow:hidden}
    .rk-result::before{opacity:1}
    .rk-result>*{position:relative;z-index:1}
    .rk-result-route{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:28px;padding:14px;border:1px solid var(--rk-line);border-radius:20px;background:rgba(3,9,16,.45)}
    .rk-mini{display:inline-flex;align-items:center;gap:10px}
    .rk-mini svg{width:40px;height:40px;display:block;filter:drop-shadow(0 4px 8px rgba(0,0,0,.5)) drop-shadow(0 0 14px color-mix(in srgb,var(--rk-accent) 30%,transparent))}
    .rk-mini b{font:700 16px/1 var(--font-display,system-ui)}
    .rk-result-arrow{position:relative;flex:1;max-width:90px;height:2px;background:linear-gradient(90deg,rgba(255,255,255,.08),var(--rk-accent),rgba(255,255,255,.08));border-radius:99px;overflow:visible}
    .rk-result-arrow::after{content:"";position:absolute;right:-2px;top:50%;width:9px;height:9px;border-top:2px solid var(--rk-accent);border-right:2px solid var(--rk-accent);transform:translateY(-50%) rotate(45deg)}
    .rk-result-arrow span{position:absolute;top:50%;left:0;width:8px;height:8px;margin-top:-4px;border-radius:50%;background:#fff;box-shadow:0 0 12px var(--rk-accent);animation:rk-travel 2.2s var(--rk-ease) infinite}
    @keyframes rk-travel{0%{left:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{left:calc(100% - 8px);opacity:0}}
    .rk-total{display:flex;align-items:center;gap:14px;margin-top:20px;min-width:0}
    .rk-rp-icon{display:grid;place-items:center;flex:none;width:64px;height:64px;border:1px solid color-mix(in srgb,var(--rk-accent) 40%,transparent);border-radius:20px;background:color-mix(in srgb,var(--rk-accent) 12%,transparent);box-shadow:0 0 30px -6px color-mix(in srgb,var(--rk-accent) 60%,transparent)}
    .rk-rp-icon img{width:42px;height:42px;object-fit:contain;filter:drop-shadow(0 6px 8px rgba(0,0,0,.4))}
    .rk-total strong{min-width:0;font:700 clamp(54px,6vw,76px)/.9 var(--font-display,system-ui);letter-spacing:-.06em;font-variant-numeric:tabular-nums;background:linear-gradient(180deg,#fff 30%,var(--rk-accent-2));-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 30px color-mix(in srgb,var(--rk-accent) 35%,transparent))}
    .rk-total em{align-self:flex-end;margin-bottom:8px;color:var(--rk-accent-2);font:700 15px/1 var(--font-display,system-ui);font-style:normal;letter-spacing:.1em}
    .rk-status-line{margin-top:16px;color:var(--rk-muted);font-size:14.5px;line-height:1.5}

    .rk-meter{margin-top:22px;padding:16px 18px;border:1px solid var(--rk-line);border-radius:18px;background:rgba(3,9,16,.45)}
    .rk-meter[hidden]{display:none}
    .rk-meter-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px;color:var(--rk-muted);font-size:14px}
    .rk-meter-top b{color:#fff;font-variant-numeric:tabular-nums}
    .rk-meter-chip{padding:6px 11px;border-radius:999px;font:700 12px/1 var(--font-display,system-ui);letter-spacing:.04em;white-space:nowrap}
    .rk-meter-bar{height:8px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden}
    .rk-meter-bar i{display:block;height:100%;width:0;border-radius:inherit;transition:width .9s var(--rk-ease),background .4s}
    .rk-meter.ok .rk-meter-chip{background:rgba(71,209,108,.14);color:#66e08c}
    .rk-meter.ok .rk-meter-bar i{background:linear-gradient(90deg,#2fbf5a,#7af0a0);box-shadow:0 0 16px rgba(71,209,108,.5)}
    .rk-meter.short .rk-meter-chip{background:rgba(255,160,70,.13);color:#ffb35c}
    .rk-meter.short .rk-meter-bar i{background:linear-gradient(90deg,#ff7a45,#ffc15c);box-shadow:0 0 16px rgba(255,160,70,.45)}

    .rk-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}
    .rk-stat{padding:18px 16px;border:1px solid var(--rk-line);border-radius:20px;background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.015));transition:transform .35s var(--rk-ease),border-color .3s}
    .rk-stat:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--rk-accent) 45%,transparent)}
    .rk-stat span{display:block;color:var(--rk-dim);font:700 11px/1.2 var(--font-display,system-ui);letter-spacing:.13em;text-transform:uppercase}
    .rk-stat strong{display:block;margin-top:12px;font:700 32px/1 var(--font-display,system-ui);letter-spacing:-.05em;font-variant-numeric:tabular-nums}
    .rk-stat strong.neg{color:#ff8a8a}
    .rk-stat small{display:block;margin-top:8px;color:var(--rk-dim);font-size:12px;line-height:1.35}
    .rk-actions{display:flex;gap:10px;margin-top:20px}

    /* ======================= REFERENCE ======================= */
    .rk-ref,.rk-faq{margin-top:clamp(70px,8vw,110px)}
    .rk-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px}
    .rk-section-head h2{margin:16px 0 10px;font:700 clamp(30px,4vw,46px)/1.02 var(--font-display,system-ui);letter-spacing:-.045em}
    .rk-section-head p{max-width:620px;color:var(--rk-muted);font-size:15.5px;line-height:1.7}
    .rk-ref-card{border:1px solid var(--rk-line);border-radius:28px;background:var(--rk-glass);box-shadow:0 40px 80px -44px rgba(0,0,0,.9),inset 0 1px 0 rgba(255,255,255,.06);overflow:hidden}
    .rk-ref-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
    .rk-ref-table{width:100%;min-width:760px;border-collapse:separate;border-spacing:0}
    .rk-ref-table thead th{position:relative;padding:20px 14px;border-bottom:1px solid var(--rk-line);background:rgba(255,255,255,.03);color:var(--rk-muted);font:700 12px/1.2 var(--font-display,system-ui);letter-spacing:.06em;text-align:left;white-space:nowrap}
    .rk-ref-table thead th:first-child{padding-left:26px;color:var(--rk-dim);letter-spacing:.14em;text-transform:uppercase}
    .rk-th{display:inline-flex;align-items:center;gap:10px}
    .rk-th svg{width:24px;height:24px;display:block;flex:none;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}
    .rk-ref-table tbody th,.rk-ref-table tbody td{padding:18px 14px;border-bottom:1px solid var(--rk-line);transition:background .35s,color .35s}
    .rk-ref-table tbody tr:last-child th,.rk-ref-table tbody tr:last-child td{border-bottom:0}
    .rk-ref-table tbody th{padding-left:26px;text-align:left;font:700 16px/1 var(--font-display,system-ui);color:#d6e6f1;white-space:nowrap}
    .rk-ref-table td{position:relative;white-space:nowrap;background:linear-gradient(0deg,color-mix(in srgb,var(--rk-accent) calc(var(--h)*14%),transparent),transparent)}
    .rk-ref-table td b{font:700 17px/1 var(--font-display,system-ui);letter-spacing:-.02em;font-variant-numeric:tabular-nums;color:#e3f0f8}
    .rk-ref-table td small{margin-left:5px;color:var(--rk-dim);font:700 11px/1 var(--font-display,system-ui);letter-spacing:.08em}
    .rk-ref-table tbody tr:hover td,.rk-ref-table tbody tr:hover th{background-color:rgba(255,255,255,.035)}
    .rk-ref-table thead th.in-route{color:#fff;background:color-mix(in srgb,var(--rk-accent) 14%,transparent);box-shadow:inset 0 -2px 0 var(--rk-accent)}
    .rk-ref-table tr.is-active th{color:#fff;background:linear-gradient(90deg,color-mix(in srgb,var(--rk-accent) 22%,transparent),transparent);box-shadow:inset 3px 0 0 var(--rk-accent)}
    .rk-ref-table tr.is-active th span::after{content:"Your bracket";margin-left:12px;padding:4px 8px;border-radius:6px;background:color-mix(in srgb,var(--rk-accent) 22%,transparent);color:var(--rk-accent-2);font:700 10px/1 var(--font-display,system-ui);letter-spacing:.1em;text-transform:uppercase;vertical-align:middle}
    .rk-ref-table tr.is-active td{background:color-mix(in srgb,var(--rk-accent) 7%,transparent)}
    .rk-ref-table tr.is-active td.in-route{background:color-mix(in srgb,var(--rk-accent) 26%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--rk-accent) 60%,transparent)}
    .rk-ref-table tr.is-active td.in-route b{color:#fff}

    /* ======================= FAQ ======================= */
    .rk-faq{padding-bottom:clamp(80px,9vw,120px)}
    .rk-faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}
    .rk-faq-grid details{border:1px solid var(--rk-line);border-radius:22px;background:var(--rk-glass);box-shadow:inset 0 1px 0 rgba(255,255,255,.05);transition:border-color .3s,background .3s,transform .35s var(--rk-ease)}
    .rk-faq-grid details:hover{border-color:var(--rk-line-2);transform:translateY(-2px)}
    .rk-faq-grid details[open]{border-color:color-mix(in srgb,var(--rk-accent) 40%,transparent)}
    .rk-faq-grid summary{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 24px;cursor:pointer;list-style:none;font:700 16px/1.35 var(--font-display,system-ui);letter-spacing:-.01em}
    .rk-faq-grid summary::-webkit-details-marker{display:none}
    .rk-faq-grid summary::after{content:"+";display:grid;place-items:center;flex:none;width:32px;height:32px;border:1px solid var(--rk-line-2);border-radius:10px;color:var(--rk-accent);font:500 20px/1 var(--font-display,system-ui);transition:transform .4s var(--rk-ease),background .3s}
    .rk-faq-grid details[open] summary::after{transform:rotate(45deg);background:color-mix(in srgb,var(--rk-accent) 16%,transparent)}
    .rk-faq-body{padding:0 24px 24px;animation:rk-faq .5s var(--rk-ease)}
    .rk-faq-body p{color:var(--rk-muted);font-size:15px;line-height:1.75}
    .rk-faq-body strong{color:#fff}
    @keyframes rk-faq{from{opacity:0;transform:translateY(-8px)}}

    /* ======================= MOBILE DOCK ======================= */
    .rk-dock{display:none}
    .rk-spark{position:fixed;z-index:3000;width:7px;height:7px;border-radius:2px;pointer-events:none;box-shadow:0 0 10px currentColor}

    /* ======================= RESPONSIVE ======================= */
    @media(max-width:1060px){
      .rk-console{grid-template-columns:1fr}
      .rk-result{position:relative;top:0}
      .rk-hero-grid{grid-template-columns:1fr}
      .rk-stage{display:none}
      .rk-hero{padding-bottom:30px}
      .rk-news{grid-template-columns:1fr}
      .rk-news-link{min-width:0}
      .rk-dock{position:fixed;left:50%;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:1150;display:flex;align-items:center;gap:16px;width:min(440px,calc(100% - 24px));padding:10px 12px 10px 16px;border:1px solid color-mix(in srgb,var(--rk-accent) 45%,transparent);border-radius:22px;background:rgba(8,17,28,.82);backdrop-filter:blur(22px) saturate(1.4);-webkit-backdrop-filter:blur(22px) saturate(1.4);box-shadow:0 24px 50px -10px rgba(0,0,0,.7),0 0 36px -8px color-mix(in srgb,var(--rk-accent) 55%,transparent);color:#fff;cursor:pointer;transform:translate(-50%,140%);opacity:0;pointer-events:none;transition:transform .5s var(--rk-ease),opacity .4s}
      .rk-dock.is-visible{transform:translate(-50%,0);opacity:1;pointer-events:auto}
      .rk-dock-route{display:flex;align-items:center;gap:8px}
      .rk-dock-route svg{width:30px;height:30px;display:block;filter:drop-shadow(0 3px 6px rgba(0,0,0,.5))}
      .rk-dock-route i{color:var(--rk-dim);font-style:normal}
      .rk-dock-total{flex:1;display:grid;gap:4px;text-align:left}
      .rk-dock-total small{color:var(--rk-dim);font:700 10.5px/1 var(--font-display,system-ui);letter-spacing:.14em;text-transform:uppercase}
      .rk-dock-total strong{font:700 22px/1 var(--font-display,system-ui);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
      .rk-dock-go{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--rk-accent-2),var(--rk-accent));color:#0a0f16;font:700 18px/1 var(--font-display,system-ui)}
    }
    @media(max-width:860px){
      .rk-faq-grid{grid-template-columns:1fr}
    }
    @media(max-width:700px){
      .rk-wrap{width:calc(100% - 24px)}
      .rk-hero{padding-top:112px}
      .rk-hero-actions .rk-btn{flex:1}
      .rk-news{padding:22px 20px}
      .rk-panel{border-radius:26px}
      .rk-panel-head{flex-direction:column;gap:16px}
      .rk-fields{grid-template-columns:1fr}
      .rk-select{padding:16px 12px;border-radius:22px}
      .rk-select-head{flex-direction:column;align-items:flex-start}
      .rk-lane{grid-template-columns:1fr;gap:12px}
      .rk-flow{margin-left:0}
      .rk-gems{gap:6px}
      .rk-gem-btn{aspect-ratio:auto;min-height:92px;padding:10px 2px;border-radius:16px;gap:7px}
      .rk-gem-body{width:66%}
      .rk-gem-name{font-size:11px}
      .rk-gem-check{top:5px;right:5px;width:16px;height:16px;font-size:9px}
      .rk-step{grid-template-columns:auto minmax(0,1fr);grid-template-areas:"n route" "cost cost" "bar bar";padding:16px 16px 34px}
      .rk-step-cost{justify-content:flex-start}
      .rk-step-cost strong{font-size:24px}
      .rk-section-head{flex-direction:column;align-items:flex-start}
      .rk-faq-grid summary{padding:18px 18px;font-size:15px}
      .rk-faq-body{padding:0 18px 20px}
    }
    @media(max-width:400px){
      .rk-hero-copy h1{font-size:52px}
      .rk-stat strong{font-size:27px}
      .rk-total strong{font-size:52px}
      .rk-rp-icon{width:54px;height:54px}
    }

    @media(prefers-reduced-motion:reduce){
      .rank-page *,.rank-page *::before,.rank-page *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;animation-delay:0s!important;transition-duration:.001ms!important}
      .rk-in,.rank-page.rk-js .rk-reveal,.rk-step{opacity:1!important;transform:none!important}
      .rk-step-bar i{width:var(--w)}
    }
  </style>
</BaseLayout>
