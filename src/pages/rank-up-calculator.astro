---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};

const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank."
>
  <main class="rank-page">
    <section class="rank-hero">
      <div class="hero-orbit hero-orbit-a"></div>
      <div class="hero-orbit hero-orbit-b"></div>
      <div class="hero-grid"></div>
      <div class="shell hero-shell">
        <div class="hero-meta">
          <a href="/">FCMOBILETOOLS</a>
          <span>/</span>
          <span>TOOLS / RANK UP</span>
        </div>

        <div class="hero-layout">
          <div class="hero-copy">
            <div class="eyebrow"><i></i> FC MOBILE COMPANION TOOL</div>
            <h1>Rank Up<br /><span>Calculator</span></h1>
            <p>Build an upgrade route from Base to Orange and see the exact RP requirement, OVR after rank-up, skill points and remaining balance.</p>

            <div class="hero-proof">
              <span><b></b> LIVE CALCULATION</span>
              <span><b></b> RP BREAKDOWN</span>
              <span><b></b> MOBILE READY</span>
            </div>
          </div>

          <div class="hero-art" aria-hidden="true">
            <div class="art-caption"><small>MAX RANK</small><strong>{RANKS[5]?.name ?? 'Orange'}</strong></div>
            <div class="art-halo"></div>
            <div class="art-grid"></div>
            <img src={RANK_ICONS[5]} alt="" />
          </div>
        </div>
      </div>
    </section>

    <section class="shell calculator-shell">
      <div class="tool-frame">
        <header class="tool-header">
          <div>
            <span class="eyebrow">RANK PATH BUILDER</span>
            <h2>Plan the upgrade</h2>
            <p>Choose the player’s Base OVR, starting rank and destination rank.</p>
          </div>
          <div class="live-state"><i></i> CALCULATOR ACTIVE</div>
        </header>

        <div class="input-row">
          <label class="input-card">
            <span>BASE OVR</span>
            <div>
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" />
              <b>OVR</b>
            </div>
          </label>

          <label class="input-card">
            <span>AVAILABLE RP <em>OPTIONAL</em></span>
            <div>
              <input id="available" type="number" min="0" placeholder="—" inputmode="numeric" />
              <b>RP</b>
            </div>
          </label>

          <div class="input-helper">
            <span>ROUTE</span>
            <div class="route-preview"><strong id="routeFrom">Base</strong><b>→</b><strong id="routeTo">Orange</strong></div>
            <small>Only valid rank paths can be selected.</small>
          </div>
        </div>

        <section class="rank-select-zone" aria-label="Rank selection">
          <div class="rank-select-head">
            <div>
              <span class="eyebrow">RANK ROUTE</span>
              <h3>Choose your upgrade path</h3>
              <p>Tap the rank artwork itself. The selected artwork becomes your player state or target.</p>
            </div>
            <div class="route-live">
              <div><span>CURRENT</span><strong id="routeFromLarge">Base</strong></div>
              <b>→</b>
              <div><span>TARGET</span><strong id="routeToLarge">Orange</strong></div>
            </div>
          </div>

          <div class="rank-select-canvas">
            <div class="rank-stage">
              <div class="rank-stage-label"><span>01</span><div><b>PLAYER RANK</b><small>Starting rank</small></div></div>
              <div class="rank-art-row" id="currentChoices"></div>
            </div>

            <div class="rank-route-line" aria-hidden="true">
              <span></span>
              <b>UPGRADE</b>
              <i>→</i>
              <span></span>
            </div>

            <div class="rank-stage">
              <div class="rank-stage-label"><span>02</span><div><b>TARGET RANK</b><small>Finish rank</small></div></div>
              <div class="rank-art-row" id="targetChoices"></div>
            </div>
          </div>
        </section>
        <input id="current" type="hidden" value="0" />
        <input id="target" type="hidden" value="5" />
        <div id="error" class="error" hidden></div>

        <section class="results">
          <div class="result-lead">
            <div class="rp-summary">
              <span class="eyebrow">TOTAL RP REQUIRED</span>
              <div class="rp-line">
                <span class="rp-icon"><img src={RP_ICON} alt="" /></span>
                <strong id="required">0</strong>
                <em>RP</em>
              </div>
              <p id="status">Choose your upgrade route.</p>
            </div>

            <div class="stat-grid">
              <div class="stat-card">
                <span>OVR AFTER RANK</span>
                <strong id="ovr">110</strong>
                <small>Base OVR + target rank</small>
              </div>
              <div class="stat-card">
                <span>RANKS GAINED</span>
                <strong id="gained">0</strong>
                <small>Upgrade steps</small>
              </div>
              <div class="stat-card">
                <span>SKILL POINTS</span>
                <strong id="skills">0</strong>
                <small>Earned from upgrades</small>
              </div>
              <div class="stat-card">
                <span>RP BALANCE</span>
                <strong id="remaining">—</strong>
                <small>After available RP</small>
              </div>
            </div>
          </div>

          <section class="cost-module">
            <div class="module-header">
              <div>
                <span class="eyebrow">UPGRADE STEPS</span>
                <h3>Cost breakdown</h3>
              </div>
              <div class="module-total"><small>TOTAL</small><strong id="costTotal">0 RP</strong></div>
            </div>

            <div class="table-scroll">
              <table class="cost-table">
                <thead>
                  <tr><th>STEP</th><th>UPGRADE</th><th>BASE OVR</th><th>RP REQUIRED</th></tr>
                </thead>
                <tbody id="stepRows"></tbody>
              </table>
            </div>
          </section>
        </section>
      </div>

      <section class="reference-panel">
        <div class="reference-heading">
          <div>
            <span class="eyebrow">REFERENCE</span>
            <h2>RP cost by Base OVR</h2>
            <p>Each column is the RP cost for one rank step inside that Base OVR bracket.</p>
          </div>
          <div class="reference-lock"><i></i> LIVE DATA</div>
        </div>

        <div class="reference-grid">
          {RANK_COSTS.map((row) => (
            <div class="reference-row">
              <strong>{row.label}</strong>
              {row.costs.map((cost, index) => (
                <div class="ref-value">
                  <span>{RANKS[index]?.name}</span>
                  <b>{fmt(cost)}</b>
                  <small>RP</small>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

      <section class="faq-panel">
        <div class="faq-heading">
          <span class="eyebrow">NEED TO KNOW</span>
          <h2>Rank Up Calculator FAQ</h2>
        </div>
        <div class="faq-grid">
          <details open>
            <summary>How is the RP total calculated?</summary>
            <p>The calculator reads the Base OVR bracket and adds every rank-step cost between the current and target rank.</p>
          </details>
          <details>
            <summary>Which ranks are supported?</summary>
            <p>Base, Green, Blue, Purple, Red and Orange.</p>
          </details>
          <details>
            <summary>What does Available RP do?</summary>
            <p>Enter your current RP balance to see the remaining amount after the selected route.</p>
          </details>
        </div>
      </section>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const params = new URLSearchParams(window.location.search);
    const baseParam = Number(params.get('base'));
    const currentParam = Number(params.get('current'));
    const targetParam = Number(params.get('target'));
    if (Number.isInteger(baseParam) && baseParam >= 0 && baseParam <= 150) base.value = String(baseParam);
    if (Number.isInteger(currentParam) && currentParam >= 0 && currentParam <= 5) current.value = String(currentParam);
    if (Number.isInteger(targetParam) && targetParam >= 0 && targetParam <= 5) target.value = String(targetParam);

    const ICONS = {
      0:'/assets/images/rankup/rankicon_25_RANK0.png',
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return '<img src="'+ICONS[value]+'" alt="" loading="eager" />';
    }

    function makeRankButtons(kind){
      return RANKS.map((rank) =>
        '<button class="rank-icon-btn" type="button" aria-label="'+rank.name+'" aria-pressed="false" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-icon-glow"></span>'
          +'<span class="rank-icon-frame"><img src="'+ICONS[rank.value]+'" alt="" loading="eager" /></span>'
          +'<span class="rank-icon-check">✓</span>'
          +'<span class="rank-icon-rank">'+rank.name+'</span>'
        +'</button>'
      ).join('');
    }

    function buildSelectors(){
      currentChoices.innerHTML = makeRankButtons('current');
      targetChoices.innerHTML = makeRankButtons('target');

      currentChoices.querySelectorAll('.rank-icon-btn').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          rankTouched=true;
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-icon-btn').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          rankTouched=true;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-icon-btn').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === from;
        button.disabled = value >= to;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      targetChoices.querySelectorAll('.rank-icon-btn').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === to;
        button.disabled = value <= from;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    }

    function renderTable(data){
      $('costTotal').textContent = fmt(data.requiredRP)+' RP';

      if(!data.steps.length){
        $('stepRows').innerHTML = '<tr><td colspan="4" class="table-empty">No upgrade steps are required for this route.</td></tr>';
        return;
      }

      $('stepRows').innerHTML = data.steps.map((step, index) =>
        '<tr>'
          +'<td><span class="step-num">'+String(index + 1).padStart(2,'0')+'</span></td>'
          +'<td><div class="upgrade-cell"><strong>'+rankName(step.from)+'</strong><span>→</span><strong>'+rankName(step.to)+'</strong></div></td>'
          +'<td>'+data.bracket.label+'</td>'
          +'<td><strong class="rp-amount">'+fmt(step.cost)+' RP</strong></td>'
        +'</tr>'
      ).join('');
    }

    let rankTouched=false;
    let rankActivityTimer=0;
    let lastRankActivitySignature='';

    function scheduleRankActivity(data){
      if(!rankTouched || !data?.valid) return;
      window.clearTimeout(rankActivityTimer);
      rankActivityTimer=window.setTimeout(()=>{
        const signature=[data.baseOVR,data.currentRank,data.targetRank,data.requiredRP].join(':');
        if(signature===lastRankActivitySignature) return;
        lastRankActivitySignature=signature;
        window.dispatchEvent(new CustomEvent('fcmobiletools:tool-activity',{
          detail:{
            entityId:'rank-up-calculator',
            durationMs:3000,
            metadata:{
              baseOVR:Number(data.baseOVR),
              currentRank:Number(data.currentRank),
              targetRank:Number(data.targetRank),
              requiredRP:Number(data.requiredRP)
            }
          }
        }));
      },900);
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label+' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('routeFrom').textContent = rankName(data.currentRank);
      $('routeTo').textContent = rankName(data.targetRank);
      $('routeFromLarge').textContent = rankName(data.currentRank);
      $('routeToLarge').textContent = rankName(data.targetRank);

      renderTable(data);
      scheduleRankActivity(data);
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', () => {
      rankTouched=true;
      render();
    }));
    render();
  </script>


  <style>
    .rank-page{
      --rp-bg:#06111e;
      --rp-bg-deep:#040b14;
      --rp-surface:#09192a;
      --rp-surface-2:#0b2035;
      --rp-surface-3:#0e2942;
      --rp-line:rgba(98,168,206,.20);
      --rp-line-soft:rgba(98,168,206,.11);
      --rp-text:#f2f8fc;
      --rp-muted:#89a6b8;
      --rp-dim:#58788d;
      --rp-cyan:#4CC9FF;
      color:var(--rp-text);
      min-height:100vh;
      overflow:hidden;
      background:
        radial-gradient(900px 620px at 7% 0%,rgba(76,201,255,.10),transparent 66%),
        radial-gradient(900px 620px at 100% 20%,rgba(76,201,255,.065),transparent 68%),
        linear-gradient(180deg,var(--rp-bg) 0%,var(--rp-bg-deep) 100%);
    }
    .rank-page *{box-sizing:border-box}
    .shell{width:min(1180px,calc(100% - 36px));margin:0 auto}
    .rank-hero{position:relative;isolation:isolate;border-bottom:1px solid var(--rp-line);overflow:hidden}
    .hero-grid{position:absolute;inset:0;opacity:.22;background-image:linear-gradient(rgba(76,201,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.055) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,#000 0%,#000 58%,transparent 100%)}
    .hero-orbit{position:absolute;border:1px solid rgba(76,201,255,.13);border-radius:50%;pointer-events:none}
    .hero-orbit-a{width:560px;height:560px;right:-180px;top:-250px;box-shadow:inset 0 0 80px rgba(76,201,255,.04)}
    .hero-orbit-b{width:360px;height:360px;right:-80px;top:-120px}
    .hero-shell{position:relative;padding:30px 0 60px}
    .hero-meta{display:flex;gap:10px;align-items:center;margin-bottom:64px;color:#56798d;font:700 9px/1 var(--font-display);letter-spacing:.12em}
    .hero-meta a{color:var(--rp-cyan);text-decoration:none}
    .hero-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:72px;align-items:center}
    .eyebrow{display:flex;align-items:center;gap:8px;color:var(--rp-cyan);font:800 8px/1 var(--font-display);letter-spacing:.16em}
    .eyebrow i{width:18px;height:1px;background:var(--rp-cyan);box-shadow:0 0 13px rgba(76,201,255,.7)}
    .hero-copy h1{margin:16px 0 18px;color:var(--rp-cyan)!important;font:800 clamp(56px,8vw,92px)/.86 var(--font-display);letter-spacing:-.075em;text-shadow:0 0 30px rgba(76,201,255,.10)}
    .hero-copy h1 span{color:var(--rp-cyan)!important}
    .hero-copy>p{max-width:700px;margin:0;color:var(--rp-muted);font:500 14px/1.8 var(--font-body)}
    .hero-proof{display:flex;flex-wrap:wrap;gap:18px;margin-top:24px}
    .hero-proof span{display:flex;align-items:center;gap:7px;color:#6d8c9e;font:700 8px/1 var(--font-display);letter-spacing:.08em}
    .hero-proof b{width:5px;height:5px;border-radius:50%;background:var(--rp-cyan);box-shadow:0 0 11px rgba(76,201,255,.8)}
    .hero-art{position:relative;height:320px;display:grid;place-items:center}
    .hero-art .art-halo{position:absolute;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(76,201,255,.16),rgba(76,201,255,.02) 45%,transparent 70%);filter:blur(4px)}
    .hero-art .art-grid{position:absolute;width:290px;height:290px;border:1px solid rgba(76,201,255,.10);border-radius:50%;background-image:linear-gradient(rgba(76,201,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.03) 1px,transparent 1px);background-size:20px 20px;mask-image:radial-gradient(circle,#000 12%,transparent 72%)}
    .hero-art img{position:relative;width:232px;height:232px;object-fit:contain;filter:drop-shadow(0 24px 34px rgba(0,0,0,.55)) drop-shadow(0 0 18px rgba(76,201,255,.08))}
    .art-caption{position:absolute;left:0;right:0;bottom:0;text-align:center}
    .art-caption small{display:block;color:#4f6f83;font:800 7px/1 var(--font-display);letter-spacing:.17em}
    .art-caption strong{display:block;margin-top:6px;color:#dff6ff;font:800 21px/1 var(--font-display);letter-spacing:.03em}

    .calculator-shell{padding:42px 0 80px}
    .tool-frame{border:1px solid var(--rp-line);border-radius:30px;background:linear-gradient(160deg,rgba(9,25,42,.97),rgba(5,16,28,.98));box-shadow:0 35px 100px rgba(0,0,0,.30);overflow:hidden}
    .tool-frame:before{content:"";display:block;height:2px;background:linear-gradient(90deg,transparent,var(--rp-cyan),transparent)}
    .tool-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding:28px 30px;border-bottom:1px solid var(--rp-line)}
    .tool-header h2,.reference-heading h2,.faq-heading h2{margin:9px 0 4px;font:800 31px/1 var(--font-display);letter-spacing:-.05em}
    .tool-header p,.reference-heading p{margin:0;color:var(--rp-muted);font:500 10px/1.6 var(--font-body)}
    .live-state{display:flex;align-items:center;gap:8px;padding:9px 11px;border:1px solid rgba(76,201,255,.15);border-radius:999px;color:#6f8ea0;font:800 7px/1 var(--font-display);letter-spacing:.12em}
    .live-state i{width:6px;height:6px;border-radius:50%;background:var(--rp-cyan);box-shadow:0 0 12px rgba(76,201,255,.85);animation:rpPulse 2.3s infinite}
    @keyframes rpPulse{50%{box-shadow:0 0 0 6px rgba(76,201,255,0)}}

    .input-row{display:grid;grid-template-columns:1fr 1fr 1.25fr;gap:10px;padding:20px 30px 8px}
    .input-card{padding:15px;border:1px solid var(--rp-line-soft);border-radius:18px;background:linear-gradient(145deg,#0b2238,#091b2f)}
    .input-card>span,.input-helper>span{display:flex;align-items:center;gap:8px;color:#7190a3;font:800 8px/1 var(--font-display);letter-spacing:.13em}
    .input-card em{margin-left:auto;color:#45677c;font-style:normal;font-size:7px}
    .input-card>div{display:flex;align-items:center;gap:9px;margin-top:10px}
    .input-card input{width:100%;height:48px;border:1px solid #21445a;border-radius:12px;background:#061522;color:var(--rp-text);padding:0 13px;outline:0;font:800 15px var(--font-display);transition:.18s}
    .input-card input:focus{border-color:var(--rp-cyan);box-shadow:0 0 0 3px rgba(76,201,255,.09),0 0 30px rgba(76,201,255,.06)}
    .input-card b{color:#55778c;font:800 8px/1 var(--font-display)}
    .input-helper{display:flex;flex-direction:column;justify-content:center;padding:15px 16px;border-left:1px solid rgba(76,201,255,.13)}
    .route-preview{display:flex;align-items:center;gap:10px;margin-top:10px}
    .route-preview strong{color:#d8edf7;font:800 13px/1 var(--font-display)}
    .route-preview b{color:var(--rp-cyan);font:800 13px/1 var(--font-display)}
    .input-helper small{margin-top:8px;color:#557489;font:500 8px/1.4 var(--font-body)}

    .rank-select-zone{padding:30px}
    .rank-select-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:20px}
    .rank-select-head h3{margin:9px 0 5px;font:800 25px/1 var(--font-display);letter-spacing:-.045em}
    .rank-select-head p{max-width:620px;margin:0;color:#6e8da2;font:500 9px/1.6 var(--font-body)}
    .route-live{display:flex;align-items:center;gap:13px;padding:11px 13px;border:1px solid rgba(76,201,255,.14);border-radius:16px;background:#071b2d;white-space:nowrap}
    .route-live div{display:grid;gap:5px}.route-live span{color:#4d7085;font:800 6px/1 var(--font-display);letter-spacing:.13em}.route-live strong{color:#dff7ff;font:800 12px/1 var(--font-display)}
    .route-live>b{color:var(--rp-cyan);font:900 14px/1 var(--font-display)}

    .rank-select-canvas{position:relative;padding:24px 22px 20px;border:1px solid var(--rp-line);border-radius:24px;background:linear-gradient(160deg,#07182a,#061220);box-shadow:inset 0 1px 0 rgba(255,255,255,.018),0 16px 45px rgba(0,0,0,.16)}
    .rank-stage{display:grid;grid-template-columns:145px 1fr;align-items:center;gap:18px}
    .rank-stage-label{display:flex;align-items:center;gap:10px}
    .rank-stage-label>span{width:28px;height:28px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.16);border-radius:9px;background:#092238;color:var(--rp-cyan);font:800 7px/1 var(--font-display)}
    .rank-stage-label b{display:block;color:#d9edf5;font:800 8px/1 var(--font-display);letter-spacing:.11em}.rank-stage-label small{display:block;margin-top:4px;color:#506f83;font:500 7px/1 var(--font-body)}
