    .stat-card small{display:block;margin-top:6px;color:#537286;font:500 7px/1.45 var(--font-body)}

    .cost-module{margin-top:10px;border:1px solid var(--rp-line);border-radius:21px;background:#071725;overflow:hidden}
    .module-header{display:flex;justify-content:space-between;align-items:flex-end;gap:15px;padding:18px 20px;border-bottom:1px solid var(--rp-line)}
