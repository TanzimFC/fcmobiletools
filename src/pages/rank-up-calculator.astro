---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANK_NAMES } from '../data/rankUpCalculator.js';
---
<BaseLayout title="FC Mobile Rank Up Calculator" description="Calculate the exact Rank Up Points needed to upgrade an FC Mobile player">
<main class="rank-page"><div class="wrap">
<header class="hero"><div><span>FC MOBILE 26</span><h1>Rank Up Calculator</h1><p>Choose your player and instantly see the real RP cost to reach the rank you want</p></div><div class="mark">RP</div></header>
<section class="box setup"><div class="heading"><div><small>PLAYER</small><h2>Rank up your player</h2></div><b>LIVE</b></div><div class="fields"><label>Base OVR<input id="base" type="number" min="0" max="130" value="107"></label><label>Current Rank<select id="current">{Array.from({length:6},(_,r)=><option value={r} selected={r===0}>Rank {r} · {RANK_NAMES[r]}</option>)}</select></label><label>Target Rank<select id="target">{Array.from({length:6},(_,r)=><option value={r} selected={r===5}>Rank {r} · {RANK_NAMES[r]}</option>)}</select></label><label>Available RP <em>optional</em><input id="available" type="number" min="0" placeholder="Enter RP"></label></div><div class="quick"><span>Quick target</span><button data-step="1">+1</button><button data-step="2">+2</button><button data-step="3">+3</button><button id="max">MAX</button></div></section>
<section id="result" class="result"></section>
<section class="box journey"><div class="heading"><div><small>UPGRADE PATH</small><h2>Rank progression</h2></div><span id="bracket"></span></div><div id="path"></div></section>
<section class="columns"><section class="box"><div class="heading"><div><small>EXACT COST</small><h2>Each rank</h2></div></div><div id="steps"></div></section><section class="box"><div class="heading"><div><small>YOUR RP</small><h2>Can you afford it</h2></div></div><div id="afford"></div></section></section>
<details class="box rules"><summary>Rank Up rules</summary><p>Rank Up Points are based on Base OVR brackets. Each rank gives +1 displayed OVR and +1 Skill Point. The Base OVR bracket stays the same throughout the upgrade.</p></details>
</div></main>
</BaseLayout>
<style>
.rank-page{--blue:#58cdf7;--ink:#102731;--muted:#6e858e;--line:#d7e8ee;min-height:100vh;background:radial-gradient(circle at 88% 0,#c5f2ff,transparent 31%),linear-gradient(180deg,#f9fdff,#edf7fa);padding:42px 18px 80px;color:var(--ink)}.wrap{max-width:1050px;margin:auto}.hero{display:flex;justify-content:space-between;align-items:end;padding:18px 0 32px}.hero span,.heading small{font:900 9px ui-monospace,monospace;letter-spacing:.15em;color:#149dcc}.hero h1{font-size:clamp(44px,7vw,70px);line-height:.9;letter-spacing:-.06em;margin:10px 0 13px}.hero p{margin:0;color:var(--muted);font-size:14px}.mark{width:58px;height:58px;border-radius:17px;background:#102f3c;color:#8be1ff;display:grid;place-items:center;font:900 17px ui-monospace,monospace}.box,.result{border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 15px 42px #32677c12}.box{padding:22px}.setup{margin-bottom:14px}.heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:18px}.heading h2{margin:4px 0 0;font-size:19px}.heading>b{font:900 8px ui-monospace,monospace;color:#159bc9}.heading>span{font:900 8px ui-monospace,monospace;color:#738b94}.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}label{display:grid;gap:7px;font:900 9px ui-monospace,monospace;color:#58727c}label em{font-style:normal;color:#9aaab0;font-weight:600}input,select{box-sizing:border-box;width:100%;padding:12px 10px;border:1px solid #cfe1e7;border-radius:10px;background:#f9fdfe;color:#142b35;font:800 12px ui-monospace,monospace;outline:0}input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #58cdf71c}.quick{display:flex;align-items:center;gap:7px;margin-top:14px;color:#81979f;font:800 8px ui-monospace,monospace}.quick button{border:1px solid #cfe1e7;background:#f5fbfd;color:#28738d;border-radius:8px;padding:7px 11px;font:900 8px ui-monospace,monospace;cursor:pointer}.quick button:hover{border-color:var(--blue);background:#edfbff}.result{margin-bottom:14px;padding:25px;background:linear-gradient(135deg,#0d2c39,#12485b);color:#f0fcff;border-color:#1b5368}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}.kicker{font:900 8px ui-monospace,monospace;letter-spacing:.15em;color:#7ce0ff}.total{font:900 clamp(50px,7vw,76px) ui-monospace,monospace;line-height:.9;letter-spacing:-.07em;margin:8px 0}.total small{font-size:14px;letter-spacing:0;color:#8eb2bf}.sub{font-size:10px;color:#a1bdc6}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stat{padding:14px;border:1px solid #ffffff18;border-radius:12px;background:#ffffff09}.stat span{display:block;font:800 7px ui-monospace,monospace;color:#78a3b0;margin-bottom:6px}.stat strong{font:900 15px ui-monospace,monospace}.status{grid-column:1/-1;padding:10px;border-radius:9px;font:900 8px ui-monospace,monospace}.good{background:#73f3c51a;color:#9affd4}.bad{background:#ff747418;color:#ffb4b4}.neutral{background:#ffffff0a;color:#b7cbd1}.journey{margin-bottom:14px}.path{display:flex;align-items:center;gap:5px;padding:14px 0 5px}.node{flex:1;text-align:center}.orb{width:44px;height:44px;margin:auto;border-radius:50%;display:grid;place-items:center;border:2px solid #d5e4e9;background:#f1f6f8;color:#70848c;font:900 9px ui-monospace,monospace}.node.current .orb{border-color:var(--blue);background:#f1fbff;color:#087ea9;box-shadow:0 0 0 5px #58cdf71a}.node.target .orb{background:#102f3c;border-color:#102f3c;color:white}.node small{display:block;margin-top:7px;font:900 6px ui-monospace,monospace;color:#899ba2}.connector{height:2px;flex:1;background:#dbe7eb}.columns{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-bottom:14px}.step{display:grid;grid-template-columns:40px 1fr auto;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}.step:last-child{border:0}.step-icon{width:36px;height:36px;border-radius:10px;background:#eefaff;color:#138bb3;display:grid;place-items:center;font:900 8px ui-monospace,monospace}.step b{font-size:11px}.step small{display:block;margin-top:3px;color:var(--muted);font-size:8px}.step strong{font:900 12px ui-monospace,monospace;color:#1386aa}.sum{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:13px;margin-top:4px;font-size:10px}.sum strong{font:900 17px ui-monospace,monospace}.afford-box{padding:18px;border:1px solid #d2e9f0;background:#f3fbfe;border-radius:14px}.afford-box .label{font:900 8px ui-monospace,monospace;color:#769099}.afford-box strong{display:block;font:900 27px ui-monospace,monospace;color:#1281a6;margin:6px 0}.afford-box p{margin:0;color:#748b94;font-size:9px;line-height:1.6}.bar{height:8px;background:#dcecef;border-radius:99px;overflow:hidden;margin:14px 0 7px}.bar i{display:block;height:100%;background:var(--blue);border-radius:inherit}.bar-label{display:flex;justify-content:space-between;font:800 7px ui-monospace,monospace;color:#78919a}.rules{font-size:10px;color:var(--muted)}.rules summary{cursor:pointer;font:900 9px ui-monospace,monospace;color:#397383}.rules p{line-height:1.7;margin-bottom:0}@media(max-width:800px){.fields{grid-template-columns:1fr 1fr}.columns,.result-grid{grid-template-columns:1fr}}@media(max-width:520px){.rank-page{padding:25px 13px 55px}.hero{display:block}.mark{margin-top:16px}.box,.result{padding:18px;border-radius:16px}.fields{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.orb{width:35px;height:35px}.node small{font-size:5px}.quick{flex-wrap:wrap}}
</style>
<script>
import { calculateRankUp } from '../lib/rankUpCalculator.js';
import { RANK_NAMES } from '../data/rankUpCalculator.js';
const base=document.querySelector('#base'),current=document.querySelector('#current'),target=document.querySelector('#target'),available=document.querySelector('#available'),result=document.querySelector('#result'),path=document.querySelector('#path'),bracket=document.querySelector('#bracket'),steps=document.querySelector('#steps'),afford=document.querySelector('#afford');
const fmt=n=>new Intl.NumberFormat('en-US').format(n);
function sync(){const c=Number(current.value);[...target.options].forEach(o=>o.disabled=Number(o.value)<c);if(Number(target.value)<c)target.value=String(c)}
function renderPath(c,t){path.innerHTML='<div class="path">'+Array.from({length:6},(_,r)=>`${r?'<div class="connector"></div>':''}<div class="node ${r===c?'current':''} ${r===t&&t!==c?'target':''}"><div class="orb">R${r}</div><small>${RANK_NAMES[r]}</small></div>`).join('')+'</div>'}
function render(){sync();const d=calculateRankUp({baseOVR:base.value,currentRank:current.value,targetRank:target.value,availablePoints:available.value});if(!d.valid){result.innerHTML=`<div class="kicker">CHECK PLAYER</div><div class="total" style="font-size:28px">${d.error}</div>`;path.innerHTML='';steps.innerHTML='';afford.innerHTML='';return}renderPath(d.currentRank,d.targetRank);bracket.textContent=d.bracket.label;
const status=d.availablePoints==null?'Enter Available RP to check affordability':d.affordable?`✓ You can reach Rank ${d.targetRank} · ${fmt(d.remainingPoints)} RP left`:`✕ ${fmt(Math.abs(d.remainingPoints))} more RP needed`;const cls=d.availablePoints==null?'neutral':d.affordable?'good':'bad';
result.innerHTML=`<div class="result-grid"><div><div class="kicker">TOTAL RP REQUIRED</div><div class="total">${fmt(d.requiredPoints)} <small>RP</small></div><div class="sub">Rank ${d.currentRank} → Rank ${d.targetRank} · Base OVR ${d.baseOVR}</div></div><div class="stats"><div class="stat"><span>DISPLAYED OVR</span><strong>${d.baseOVR+d.currentRank} → ${d.targetOVR}</strong></div><div class="stat"><span>SKILL POINTS</span><strong>+${d.skillPoints}</strong></div><div class="stat"><span>RANKS</span><strong>+${d.targetRank-d.currentRank}</strong></div><div class="stat"><span>OVR GAIN</span><strong>+${d.ovrGain}</strong></div><div class="status ${cls}">${status}</div></div></div>`;
steps.innerHTML=d.steps.length?d.steps.map(s=>`<div class="step"><div class="step-icon">R${s.to}</div><div><b>Rank ${s.from} → Rank ${s.to}</b><small>${RANK_NAMES[s.to]} · +1 OVR · +1 Skill Point</small></div><strong>${fmt(s.cost)} RP</strong></div>`).join('')+`<div class="sum"><span>Total RP</span><strong>${fmt(d.requiredPoints)}</strong></div>`:'<div class="afford-box"><strong>Already at this rank</strong><p>No Rank Up Points are needed</p></div>';
if(d.availablePoints==null){afford.innerHTML='<div class="afford-box"><span class="label">AVAILABLE RP</span><strong>Not entered</strong><p>Add your RP balance above and the calculator will show exactly how far you can rank up</p></div>'}else{const pct=d.requiredPoints?Math.min(100,d.availablePoints/d.requiredPoints*100):100;afford.innerHTML=`<div class="afford-box"><span class="label">AVAILABLE RP</span><strong>${fmt(d.availablePoints)}</strong><p>${fmt(d.requiredPoints)} RP required for this upgrade</p><div class="bar"><i style="width:${pct}%"></i></div><div class="bar-label"><span>${Math.round(pct)}% covered</span><span>${d.affordable?fmt(d.remainingPoints)+' left':fmt(Math.abs(d.remainingPoints))+' short'}</span></div></div>`}}
[base,current,target,available].forEach(el=>el.addEventListener('input',render));document.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>{target.value=String(Math.min(5,Number(current.value)+Number(b.dataset.step)));render()}));document.querySelector('#max').addEventListener('click',()=>{target.value='5';render()});render();
</script>