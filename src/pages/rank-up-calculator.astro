---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};

const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank."
>
  <main class="rank-page">
    <section class="hero">
      <div class="shell">
        <div class="crumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Rank Up Calculator</span></div>

        <div class="hero-layout">
          <div class="hero-copy">
            <span class="eyebrow">FC MOBILE / RANK LAB</span>
            <h1>Rank Up <em>Calculator</em></h1>
            <p>Choose the player's Base OVR, current rank and target rank. The calculator instantly shows the RP needed for every upgrade step.</p>
            <div class="hero-meta">
              <span>LIVE CALCULATION</span>
              <span>6 RANKS</span>
              <span>5 UPGRADE STEPS</span>
            </div>
          </div>

          <div class="hero-badge" aria-hidden="true">
            <div class="hero-orbit"></div>
            <img src={RANK_ICONS[5]} alt="" />
            <div><strong>Orange</strong><span>Final rank</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="shell content">
      <div class="workspace">
        <div class="workspace-head">
          <div>
            <span class="eyebrow">RANK UP PLANNER</span>
            <h2>Build your upgrade path</h2>
            <p>Set the three values that matter. Everything else is calculated for you.</p>
          </div>
          <div class="live-dot"><i></i> LIVE</div>
        </div>

        <div class="top-inputs">
          <label class="input-card">
            <span>BASE OVR</span>
            <div class="input-wrap">
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" aria-label="Base OVR" />
              <small>PLAYER BASE</small>
            </div>
          </label>

          <label class="input-card">
            <span>AVAILABLE RANK UP POINTS</span>
            <div class="input-wrap">
              <input id="available" type="number" min="0" placeholder="Optional" inputmode="numeric" aria-label="Available Rank Up Points" />
              <small>OPTIONAL</small>
            </div>
          </label>
        </div>

        <div class="rank-selectors">
          <div class="selector-block">
            <div class="selector-title">
              <div>
                <span class="eyebrow">CURRENT RANK</span>
                <p>Select where the player is now.</p>
              </div>
            </div>
            <div id="currentChoices" class="rank-grid"></div>
          </div>

          <div class="selector-separator"><span></span><b>TO</b><span></span></div>

          <div class="selector-block">
            <div class="selector-title">
              <div>
                <span class="eyebrow">TARGET RANK</span>
                <p>Select where the player should finish.</p>
              </div>
            </div>
            <div id="targetChoices" class="rank-grid"></div>
          </div>

          <input id="current" type="hidden" value="0" />
          <input id="target" type="hidden" value="5" />
          <div id="error" class="error" hidden></div>
        </div>

        <div class="result-area">
          <div class="result-top">
            <article class="rp-card">
              <span class="eyebrow">RP REQUIRED</span>
              <div class="rp-value">
                <img src={RP_ICON} alt="" />
                <strong id="required">0</strong>
              </div>
              <p id="status">Choose your upgrade route.</p>
              <div class="rp-route"><span id="miniFrom">Base</span><i>→</i><span id="miniTo">Orange</span></div>
            </article>

            <div class="stat-grid">
              <article><span>OVR AFTER RANK</span><strong id="ovr">110</strong><small>Base OVR + target rank</small></article>
              <article><span>RANKS GAINED</span><strong id="gained">0</strong><small>Upgrade steps</small></article>
              <article><span>SKILL POINTS</span><strong id="skills">0</strong><small>Earned from upgrades</small></article>
              <article><span>RP BALANCE</span><strong id="remaining">—</strong><small>After available RP</small></article>
            </div>
          </div>

          <section class="cost-section">
            <div class="section-heading">
              <div>
                <span class="eyebrow">COST BREAKDOWN</span>
                <h3>Upgrade cost table</h3>
                <p>Every step is shown once. No extra currency artwork inside the table.</p>
              </div>
              <div class="table-total">
                <span>TOTAL</span>
                <strong id="costTotal">0 RP</strong>
              </div>
            </div>

            <div class="cost-table-wrap">
              <table class="cost-table">
                <thead>
                  <tr>
                    <th>STEP</th>
                    <th>UPGRADE</th>
                    <th>BASE OVR</th>
                    <th>RP REQUIRED</th>
                  </tr>
                </thead>
                <tbody id="stepRows"></tbody>
              </table>
            </div>
          </section>
        </div>
      </div>

      <div class="reference">
        <div class="reference-heading">
          <div>
            <span class="eyebrow">REFERENCE</span>
            <h2>Rank Up Point costs by Base OVR</h2>
            <p>The configured cost for each individual rank step.</p>
          </div>
        </div>

        <div class="reference-scroll">
          <table>
            <thead>
              <tr>
                <th>BASE OVR</th>
                <th>GREEN</th>
                <th>BLUE</th>
                <th>PURPLE</th>
                <th>RED</th>
                <th>ORANGE</th>
              </tr>
            </thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  {row.costs.map((cost) => <td>{fmt(cost)} RP</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="shell">
        <span class="eyebrow">HELP</span>
        <h2>Rank Up Calculator FAQ</h2>
        <div class="faq-grid">
          <details open>
            <summary>How does the calculator work?</summary>
            <p>It reads your Base OVR bracket, then adds the cost of every rank between your current rank and target rank.</p>
          </details>
          <details>
            <summary>What ranks are supported?</summary>
            <p>Base, Green, Blue, Purple, Red and Orange.</p>
          </details>
          <details>
            <summary>What is Available Rank Up Points?</summary>
            <p>Enter your current RP balance to see how much will remain after the selected upgrade route.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const ICONS = {
      0:'/assets/images/rankup/rankicon_25_RANK0.png',
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return '<img src="'+ICONS[value]+'" alt="" loading="eager" />';
    }

    function buildSelectors(){
      const make = (kind) => RANKS.map((rank) =>
        '<button class="rank-option" type="button" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-art">'+icon(rank.value)+'</span>'
          +'<strong>'+rank.name+'</strong>'
          +'<span class="rank-indicator"></span>'
        +'</button>'
      ).join('');

      currentChoices.innerHTML = make('current');
      targetChoices.innerHTML = make('target');

      currentChoices.querySelectorAll('.rank-option').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-option').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-option').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value >= to;
        button.classList.toggle('selected', value === from);
      });

      targetChoices.querySelectorAll('.rank-option').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value <= from;
        button.classList.toggle('selected', value === to);
      });
    }

    function renderTable(data){
      $('costTotal').textContent = fmt(data.requiredRP) + ' RP';

      if(!data.steps.length){
        $('stepRows').innerHTML = '<tr><td colspan="4" class="table-empty">No upgrade steps are required for this route.</td></tr>';
        return;
      }

      $('stepRows').innerHTML = data.steps.map((step, index) =>
        '<tr>'
          +'<td><span class="step-num">'+String(index + 1).padStart(2,'0')+'</span></td>'
          +'<td><div class="upgrade-cell"><strong>'+rankName(step.from)+'</strong><span>→</span><strong>'+rankName(step.to)+'</strong></div></td>'
          +'<td>'+data.bracket.label+'</td>'
          +'<td><strong class="rp-amount">'+fmt(step.cost)+' RP</strong></td>'
        +'</tr>'
      ).join('');
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label+' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('miniFrom').textContent = rankName(data.currentRank);
      $('miniTo').textContent = rankName(data.targetRank);

      renderTable(data);
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', render));
    render();
  </script>

  <style>
    :root{
      --r-bg:#061019;
      --r-surface:#0b1722;
      --r-surface-2:#0e1c28;
      --r-line:rgba(255,255,255,.075);
      --r-line-soft:rgba(255,255,255,.045);
      --r-text:#f2f7fa;
      --r-muted:#91a5b2;
      --r-dim:#5e7481;
      --r-cyan:#4cc9ff;
      --r-cyan-soft:rgba(76,201,255,.1);
      --r-head:'Space Grotesk',system-ui,sans-serif;
      --r-body:'Inter',system-ui,sans-serif;
    }

    .rank-page{
      min-height:100vh;
      color:var(--r-text);
      background:
        radial-gradient(850px 520px at 10% 0%,rgba(76,201,255,.085),transparent 68%),
        radial-gradient(780px 450px at 90% 6%,rgba(76,201,255,.045),transparent 70%),
        var(--r-bg);
      overflow:hidden;
    }

    .shell{width:min(1160px,calc(100% - 38px));margin:0 auto}

    .hero{border-bottom:1px solid var(--r-line);background:linear-gradient(180deg,rgba(6,16,25,.96),rgba(6,16,25,.72))}
    .hero .shell{padding:28px 0 46px}
    .crumb{display:flex;gap:9px;align-items:center;margin-bottom:50px;color:#5f7582;font:800 9px/1 var(--r-head);letter-spacing:.04em}
    .crumb a{color:var(--r-cyan);text-decoration:none}

    .hero-layout{display:grid;grid-template-columns:minmax(0,1fr) 190px;align-items:center;gap:70px}
    .eyebrow{color:var(--r-cyan);font:900 9px/1 var(--r-head);letter-spacing:.16em}
    .hero h1{margin:14px 0 17px;font:800 clamp(50px,7vw,82px)/.88 var(--r-head);letter-spacing:-.075em}
    .hero h1 em{font-style:normal;color:var(--r-cyan)}
    .hero-copy>p{max-width:700px;margin:0;color:var(--r-muted);font:500 13px/1.8 var(--r-body)}
    .hero-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:21px}
    .hero-meta span{padding:7px 9px;border:1px solid var(--r-line);border-radius:999px;color:#728692;background:rgba(255,255,255,.012);font:900 7px/1 var(--r-head);letter-spacing:.08em}

    .hero-badge{position:relative;display:grid;justify-items:center;padding:24px 16px 16px;border:1px solid rgba(76,201,255,.13);border-radius:24px;background:linear-gradient(145deg,#102433,#09131d);box-shadow:0 24px 70px rgba(0,0,0,.24)}
    .hero-badge img{position:relative;width:122px;height:122px;object-fit:contain;filter:drop-shadow(0 15px 24px rgba(0,0,0,.34))}
    .hero-orbit{position:absolute;width:116px;height:116px;border-radius:50%;background:rgba(76,201,255,.13);filter:blur(26px)}
    .hero-badge strong{display:block;margin-top:4px;font:900 23px/1 var(--r-head)}
    .hero-badge span{display:block;margin-top:5px;text-align:center;color:#708692;font:700 8px/1 var(--r-head)}

    .content{padding:38px 0 68px}
    .workspace,.reference{border:1px solid var(--r-line);border-radius:24px;background:linear-gradient(145deg,#0c1824,#09131d);box-shadow:0 30px 90px rgba(0,0,0,.22);overflow:hidden}
    .workspace-head{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:25px 28px;border-bottom:1px solid var(--r-line)}
    .workspace-head h2,.reference h2,.faq h2{margin:7px 0 5px;font:800 26px/1 var(--r-head);letter-spacing:-.045em}
    .workspace-head p,.reference-heading p{margin:0;color:var(--r-muted);font:500 10px/1.6 var(--r-body)}
    .live-dot{display:flex;gap:7px;align-items:center;padding:8px 10px;border:1px solid rgba(76,201,255,.12);border-radius:999px;color:#76909d;font:900 7px/1 var(--r-head);letter-spacing:.12em}
    .live-dot i{width:6px;height:6px;border-radius:50%;background:var(--r-cyan);box-shadow:0 0 10px rgba(76,201,255,.7)}

    .top-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:20px 28px 8px}
    .input-card{padding:14px;border:1px solid var(--r-line-soft);border-radius:16px;background:rgba(255,255,255,.012)}
    .input-card>span{display:block;margin-bottom:8px;color:#728693;font:900 8px/1 var(--r-head);letter-spacing:.12em}
    .input-wrap{display:flex;align-items:center;gap:10px}
    .input-wrap input{min-width:0;width:100%;height:45px;border:1px solid #29404e;border-radius:11px;background:#08131c;color:var(--r-text);padding:0 12px;outline:0;font:800 12px var(--r-head);transition:border-color .16s,box-shadow .16s}
    .input-wrap input:focus{border-color:var(--r-cyan);box-shadow:0 0 0 3px rgba(76,201,255,.09)}
    .input-wrap small{flex:0 0 auto;color:#4f6774;font:900 7px/1 var(--r-head);letter-spacing:.08em}

    .rank-selectors{padding:21px 28px 27px}
    .selector-title{margin-bottom:11px}
    .selector-title p{margin:5px 0 0;color:#607783;font:500 9px/1.5 var(--r-body)}

    .rank-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}
    .rank-option{position:relative;min-height:104px;border:1px solid rgba(255,255,255,.055);border-radius:15px;background:#0a151e;color:var(--r-text);padding:10px 8px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;transition:border-color .16s,background .16s,opacity .16s}
    .rank-option:hover:not(:disabled){border-color:rgba(76,201,255,.18);background:#0c1923}
    .rank-option.selected{border-color:rgba(76,201,255,.72);background:linear-gradient(180deg,rgba(76,201,255,.09),rgba(76,201,255,.025));box-shadow:inset 0 0 0 1px rgba(76,201,255,.08),0 0 24px rgba(76,201,255,.04)}
    .rank-option:disabled{opacity:.14;cursor:not-allowed}
    .rank-art{width:58px;height:58px;display:grid;place-items:center}
    .rank-art img{width:64px;height:64px;display:block;object-fit:contain;filter:drop-shadow(0 8px 12px rgba(0,0,0,.34))}
    .rank-option>strong{font:900 11px/1 var(--r-head);color:#dcebf1}
    .rank-indicator{position:absolute;right:9px;top:9px;width:5px;height:5px;border:1px solid #365160;border-radius:50%}
    .rank-option.selected .rank-indicator{border-color:var(--r-cyan);background:var(--r-cyan);box-shadow:0 0 9px rgba(76,201,255,.55)}

    .selector-separator{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin:20px 0 19px;color:#48606e}
    .selector-separator span{height:1px;background:var(--r-line)}
    .selector-separator b{font:900 7px/1 var(--r-head);letter-spacing:.16em}

    .error{margin:0 28px 15px;padding:11px 12px;border:1px solid rgba(255,116,112,.22);border-radius:10px;background:rgba(255,116,112,.055);color:#ffaba6;font:700 9px/1.4 var(--r-head)}

    .result-area{padding:0 28px 28px}
    .result-top{display:grid;grid-template-columns:minmax(0,1fr) 1.45fr;gap:10px}

    .rp-card{padding:20px 21px;border:1px solid rgba(76,201,255,.13);border-radius:18px;background:linear-gradient(145deg,#102635,#0a1720)}
    .rp-value{display:flex;align-items:center;gap:12px;margin:11px 0 7px}
    .rp-value img{width:56px;height:56px;object-fit:contain;filter:drop-shadow(0 8px 13px rgba(0,0,0,.34))}
    .rp-value strong{font:900 clamp(48px,5vw,68px)/.9 var(--r-head);letter-spacing:-.075em}
    .rp-card p{margin:0;color:var(--r-muted);font:500 9px/1.55 var(--r-body)}
    .rp-route{display:inline-flex;align-items:center;gap:9px;margin-top:14px;padding:7px 9px;border:1px solid rgba(255,255,255,.065);border-radius:999px;color:#87a0ad;font:800 8px/1 var(--r-head)}
    .rp-route i{font-style:normal;color:#49616e}

    .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .stat-grid article{padding:15px;border:1px solid var(--r-line-soft);border-radius:16px;background:#0a151e}
    .stat-grid span{display:block;color:#687e8a;font:900 7px/1 var(--r-head);letter-spacing:.1em}
    .stat-grid strong{display:block;margin-top:7px;font:900 22px/1 var(--r-head);letter-spacing:-.045em}
    .stat-grid small{display:block;margin-top:4px;color:#506673;font:500 7px/1.45 var(--r-body)}

    .cost-section{margin-top:12px;border:1px solid var(--r-line);border-radius:18px;overflow:hidden;background:#08131c}
    .section-heading{display:flex;justify-content:space-between;align-items:end;gap:18px;padding:19px 19px 17px;border-bottom:1px solid var(--r-line);background:linear-gradient(180deg,rgba(76,201,255,.03),transparent)}
    .section-heading h3{margin:7px 0 4px;font:800 20px/1 var(--r-head);letter-spacing:-.04em}
    .section-heading p{margin:0;color:#58717f;font:500 9px/1.5 var(--r-body)}
    .table-total{min-width:102px;text-align:right}
    .table-total span{display:block;color:#627a88;font:900 7px/1 var(--r-head);letter-spacing:.12em}
    .table-total strong{display:block;margin-top:5px;color:#e8f5f9;font:900 18px/1 var(--r-head)}

    .cost-table-wrap{overflow:auto}
    .cost-table{width:100%;border-collapse:collapse;min-width:620px}
    .cost-table th{padding:11px 16px;border-bottom:1px solid var(--r-line);background:#09151e;color:#5f7784;text-align:left;font:900 7px/1 var(--r-head);letter-spacing:.12em}
    .cost-table td{padding:13px 16px;border-bottom:1px solid var(--r-line-soft);color:#8398a4;font:600 9px/1 var(--r-body)}
    .cost-table tbody tr:last-child td{border-bottom:0}
    .step-num{display:grid;place-items:center;width:27px;height:27px;border:1px solid rgba(76,201,255,.12);border-radius:8px;background:#0b202e;color:var(--r-cyan);font:900 8px/1 var(--r-head)}
    .upgrade-cell{display:flex;align-items:center;gap:8px}
    .upgrade-cell strong{color:#e1edf1;font:900 10px/1 var(--r-head)}
    .upgrade-cell span{color:#3d5967}
    .rp-amount{color:#f3f7f9;font:900 12px/1 var(--r-head);white-space:nowrap}
    .table-empty{padding:22px 16px!important;color:#718693!important}

    .reference{margin-top:13px;padding:25px 28px}
    .reference-heading{margin-bottom:17px}
    .reference-scroll{overflow:auto}
    .reference table{width:100%;min-width:720px;border-collapse:collapse}
    .reference th,.reference td{padding:11px 12px;border-top:1px solid var(--r-line);text-align:left}
    .reference th{color:#5e7683;font:900 7px/1 var(--r-head);letter-spacing:.1em}
    .reference td{color:#b7c6cd;font:700 9px/1 var(--r-body)}
    .reference td strong{font:900 9px/1 var(--r-head)}

    .faq{padding:15px 0 78px}
    .faq h2{margin-bottom:18px}
    .faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
    .faq details{min-height:106px;padding:15px 16px;border:1px solid var(--r-line);border-radius:15px;background:#0a151e}
    .faq summary{cursor:pointer;color:#e1edf1;font:900 10px/1.4 var(--r-head)}
    .faq p{color:var(--r-muted);font:500 9px/1.7 var(--r-body)}

    @media(max-width:980px){
      .hero-layout{grid-template-columns:1fr}
      .hero-badge{display:none}
      .result-top{grid-template-columns:1fr}
      .faq-grid{grid-template-columns:1fr}
    }

