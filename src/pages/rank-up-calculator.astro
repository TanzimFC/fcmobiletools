---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();
const RANK_ICONS = {
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};
const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | Rank Up Points | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, choose your current and target rank visually, and view a clear rank-up cost breakdown."
>
  <main class="rank-page">
    <header class="hero">
      <div class="wrap hero-wrap">
        <div class="crumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Rank Up Calculator</span></div>
        <div class="hero-grid">
          <div>
            <span class="eyebrow">FC MOBILE / RANK LAB</span>
            <h1>Rank Up <em>Calculator</em></h1>
            <p>Choose the rank you have, choose the rank you want, enter the Base OVR, and the calculator handles the rest.</p>
            <div class="hero-tags"><span>LIVE CALCULATION</span><span>BASE OVR</span><span>RANK PATH</span></div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="hero-art-glow"></div>
            <img src={RANK_ICONS[5]} alt="" />
            <div class="hero-art-copy"><b>Orange</b><span>Final rank</span></div>
          </div>
        </div>
      </div>
    </header>

    <section class="wrap main-section">
      <div class="calculator">
        <div class="calculator-head">
          <div>
            <span class="eyebrow">RANK UP PLANNER</span>
            <h2>Plan the upgrade</h2>
            <p>Use the rank artwork as the selector. No complicated dropdowns.</p>
          </div>
          <div class="head-note"><span>6 ranks</span><i></i><span>5 upgrade steps</span></div>
        </div>

        <div class="inputs">
          <label class="field">
            <span>BASE OVR</span>
            <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" />
          </label>
          <label class="field">
            <span>AVAILABLE RANK UP POINTS <small>OPTIONAL</small></span>
            <input id="available" type="number" min="0" placeholder="Leave empty to ignore" inputmode="numeric" />
          </label>
        </div>

        <div class="selector">
          <div class="selector-row">
            <div class="selector-heading">
              <span class="eyebrow">CURRENT RANK</span>
              <p>Pick the rank the player currently has.</p>
            </div>
            
          </div>
          <div id="currentChoices" class="rank-grid"></div>

          <div class="selector-divider"></div>

          <div class="selector-row">
            <div class="selector-heading">
              <span class="eyebrow">TARGET RANK</span>
              <p>Pick the rank you want to reach.</p>
            </div>
            
          </div>
          <div id="targetChoices" class="rank-grid"></div>

          <input id="current" type="hidden" value="0" />
          <input id="target" type="hidden" value="5" />
          <div id="error" class="error" hidden></div>
        </div>

        <div class="result">
          <div class="result-grid">
            <article class="total-card">
              <span class="eyebrow">RP REQUIRED</span>
              <div class="rp-number">
                <img src={RP_ICON} alt="" />
                <strong id="required">0</strong>
              </div>
              <p id="status">Choose your upgrade route.</p>
              <div class="route-pill"><span id="miniFrom">Base</span><i></i><span id="miniTo">Orange</span></div>
            </article>

            <div class="metrics">
              <article><span>OVR AFTER RANK</span><strong id="ovr">110</strong><small>Base OVR plus rank value</small></article>
              <article><span>SKILL POINTS</span><strong id="skills">0</strong><small>Earned across the route</small></article>
              <article><span>RANKS GAINED</span><strong id="gained">0</strong><small>Upgrade steps</small></article>
              <article><span>RP BALANCE</span><strong id="remaining">—</strong><small>After available points</small></article>
            </div>
          </div>

          <div class="route-preview">
            <div class="route-preview-head">
              <div><span class="eyebrow">UPGRADE PATH</span><strong id="routeText">Base → Orange</strong></div>
              <span class="route-status">CALCULATED LIVE</span>
            </div>
            <div id="routeTrack" class="route-track"></div>
          </div>

          <section class="breakdown">
            <div class="breakdown-head">
              <div>
                <span class="eyebrow">COST BREAKDOWN</span>
                <h3>What each step costs</h3>
                <p>Actual Rank Up Point costs only. The RP icon appears beside real currency values.</p>
              </div>
              <div class="breakdown-total"><img src={RP_ICON} alt="" /><strong id="costTotal">0</strong><small>RP</small></div>
            </div>
            <div id="stepRows"></div>
          </section>
        </div>
      </div>

      <div class="reference">
        <div class="reference-head">
          <div>
            <span class="eyebrow">REFERENCE</span>
            <h2>Rank Up Points by Base OVR</h2>
            <p>Use this table when you want to verify the configured cost brackets.</p>
          </div>
        </div>
        <div class="table-scroll">
          <table>
            <thead><tr><th>BASE OVR</th><th>Green</th><th>Blue</th><th>Purple</th><th>Red</th><th>Orange</th></tr></thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  {row.costs.map((cost) => <td><img src={RP_ICON} alt="" />{fmt(cost)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="wrap">
        <span class="eyebrow">FAQ</span>
        <h2>Rank Up Calculator FAQ</h2>
        <details open><summary>How are Rank Up Points calculated?</summary><p>The calculator uses the Base OVR bracket and adds the configured cost of each upgrade between your selected current and target rank.</p></details>
        <details><summary>Which ranks are available?</summary><p>Base, Green, Blue, Purple, Red and Orange.</p></details>
        <details><summary>What does Available Rank Up Points do?</summary><p>Enter your current balance to see how many points remain after the upgrade route.</p></details>
      </div>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();
    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const ICONS = {
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return ICONS[value]
        ? '<img src="'+ICONS[value]+'" alt="" loading="eager" />'
        : '<span class="base-icon">Base</span>';
    }

    function buildSelectors(){
      const make = (kind) => RANKS.map((rank) =>
        '<button class="rank-option" type="button" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-option-art '+(rank.value===0?'base':'')+'">'+icon(rank.value)+'</span>'
          +'<span class="rank-option-copy"><strong>'+rank.name+'</strong></span>'
          +'<span class="rank-option-check"></span>'
        +'</button>'
      ).join('');

      currentChoices.innerHTML = make('current');
      targetChoices.innerHTML = make('target');

      currentChoices.querySelectorAll('.rank-option').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-option').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-option').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value >= to;
        button.classList.toggle('selected', value === from);
      });

      targetChoices.querySelectorAll('.rank-option').forEach((button) => {
        const value = Number(button.dataset.value);
        button.disabled = value <= from;
        button.classList.toggle('selected', value === to);
      });

    }

    function routeMarkup(from, to){
      return RANKS.map((rank) => {
        const active = rank.value >= from && rank.value <= to;
        const focus = rank.value === from || rank.value === to;
        return '<div class="route-node '+(active?'active ':'')+(focus?'focus':'')+'">'
          +'<span class="route-icon '+(rank.value===0?'base':'')+'">'+icon(rank.value)+'</span>'
          +'<strong>'+rank.name+'</strong>'
        +'</div>';
      }).join('<i></i>');
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label + ' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('miniFrom').textContent = rankName(data.currentRank);
      $('miniTo').textContent = rankName(data.targetRank);
      $('routeText').textContent = rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('routeTrack').innerHTML = routeMarkup(Number(data.currentRank), Number(data.targetRank));
      $('costTotal').textContent = fmt(data.requiredRP);

      $('stepRows').innerHTML = data.steps.length
        ? data.steps.map((step, index) =>
          '<article class="cost-row">'
            +'<div class="cost-row-index">'+String(index+1).padStart(2,'0')+'</div>'
            +'<div class="cost-row-route"><span>'+rankName(step.from)+'</span><i>→</i><strong>'+rankName(step.to)+'</strong></div>'
            +'<div class="cost-row-ovr">OVR '+data.bracket.label+'</div>'
            +'<div class="cost-row-price"><img src="/assets/images/fc_c2_IMG_FC_C02_07.png" alt="" /><strong>'+fmt(step.cost)+'</strong><small>RP</small></div>'
          +'</article>'
        ).join('')
        : '<div class="empty">No Rank Up Points required for this route.</div>';
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', render));
    render();
  </script>

  <style>
    :root{
      --rank-bg:#071018;--rank-panel:#0d1822;--rank-panel-2:#112230;
      --rank-line:rgba(255,255,255,.08);--rank-text:#f5f8fb;--rank-muted:#9aabb8;
      --rank-dim:#647987;--rank-cyan:#4cc9ff;--rank-cyan-2:#86ddff;
      --rank-font-head:'Space Grotesk',system-ui,sans-serif;--rank-font-body:'Inter',system-ui,sans-serif
    }
    .rank-page{color:var(--rank-text);background:
      radial-gradient(700px 400px at 8% 0,rgba(76,201,255,.09),transparent 66%),
      radial-gradient(600px 360px at 92% 10%,rgba(76,201,255,.045),transparent 70%);
      padding-bottom:30px}
    .wrap{width:min(1180px,calc(100% - 36px));margin:auto}
    .hero{border-bottom:1px solid var(--rank-line);background:linear-gradient(180deg,rgba(7,16,24,.75),transparent)}
    .hero-wrap{padding:30px 0 48px}
    .crumb{display:flex;gap:9px;margin-bottom:45px;color:#607583;font:700 9px var(--rank-font-head)}
    .crumb a{color:var(--rank-cyan);text-decoration:none}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:50px;align-items:center}
    .eyebrow{font:800 9px var(--rank-font-head);letter-spacing:.14em;color:var(--rank-cyan);text-transform:uppercase}
    h1{margin:13px 0 17px;font:800 clamp(50px,7vw,82px)/.9 var(--rank-font-head);letter-spacing:-.07em}
    h1 em{font-style:normal;color:var(--rank-cyan)}
    .hero p{max-width:680px;margin:0;color:var(--rank-muted);font:500 14px/1.75 var(--rank-font-body)}
    .hero-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:21px}
    .hero-tags span{padding:7px 10px;border:1px solid var(--rank-line);border-radius:999px;color:#788e9c;font:800 8px var(--rank-font-head);background:rgba(255,255,255,.015)}
    .hero-art{position:relative;display:grid;place-items:center;padding:24px 12px 18px;border:1px solid rgba(76,201,255,.13);border-radius:26px;background:linear-gradient(145deg,#102432,#0a141d);box-shadow:0 24px 70px rgba(0,0,0,.26)}
    .hero-art-glow{position:absolute;width:130px;height:130px;border-radius:50%;background:rgba(76,201,255,.13);filter:blur(28px)}
    .hero-art img{position:relative;width:132px;height:132px;object-fit:contain;filter:drop-shadow(0 15px 24px rgba(0,0,0,.34))}
    .hero-art-copy{position:relative;text-align:center;margin-top:4px}.hero-art-copy b{display:block;font:900 25px var(--rank-font-head)}.hero-art-copy span{display:block;margin-top:3px;color:#718795;font:600 8px var(--rank-font-head)}
    .main-section{padding:40px 0 64px}
    .calculator,.reference{border:1px solid var(--rank-line);border-radius:24px;background:linear-gradient(145deg,#0f1a26,#0b141d);box-shadow:0 28px 90px rgba(0,0,0,.22);overflow:hidden}
    .calculator-head{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:26px 28px;border-bottom:1px solid var(--rank-line)}
    .calculator-head h2,.reference h2,.faq h2{margin:7px 0 5px;font:800 27px var(--rank-font-head);letter-spacing:-.04em}
    .calculator-head p,.reference p{margin:0;color:var(--rank-muted);font:500 11px/1.6 var(--rank-font-body)}
    .head-note{display:flex;align-items:center;gap:10px;color:#6c8391;font:800 8px var(--rank-font-head);white-space:nowrap}
    .head-note i{width:24px;height:1px;background:#335061}
    .inputs{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:22px 28px 6px}
    .field{display:grid;gap:8px;color:#7a909e;font:800 9px var(--rank-font-head);letter-spacing:.1em}
    .field small{color:#4d6675;font-size:7px;letter-spacing:.08em}
    .field input{width:100%;height:48px;border:1px solid #29414e;border-radius:12px;background:#09141d;color:var(--rank-text);padding:0 13px;outline:none;font:700 11px var(--rank-font-head);transition:.18s}
    .field input:focus{border-color:var(--rank-cyan);box-shadow:0 0 0 3px rgba(76,201,255,.1)}
    .selector{padding:22px 28px 26px}
    .selector-row{display:flex;justify-content:space-between;align-items:end;gap:14px;margin-bottom:11px}
    .selector-heading p{margin:4px 0 0;color:#586f7d;font:500 9px var(--rank-font-body)}
    .selector-row>strong{color:var(--rank-cyan);font:900 11px var(--rank-font-head)}
    .rank-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}
    .rank-option{position:relative;min-height:100px;padding:11px 10px;border:1px solid rgba(255,255,255,.065);border-radius:16px;background:linear-gradient(145deg,#0c1720,#09131b);color:var(--rank-text);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,background .16s ease}
    .rank-option:hover:not(:disabled){transform:translateY(-2px);border-color:rgba(76,201,255,.25);box-shadow:0 16px 34px rgba(0,0,0,.18)}
    .rank-option.selected{border-color:var(--rank-cyan);background:linear-gradient(145deg,rgba(76,201,255,.13),#0a1822);box-shadow:0 0 0 1px rgba(76,201,255,.12),0 15px 38px rgba(76,201,255,.08)}
    .rank-option:disabled{opacity:.22;cursor:not-allowed;filter:saturate(.45)}
    .rank-option-art{width:55px;height:55px;display:grid;place-items:center}.rank-option-art img{width:61px;height:61px;object-fit:contain;display:block;filter:drop-shadow(0 8px 12px rgba(0,0,0,.3))}
    .rank-option-art.base{border:1px solid rgba(255,255,255,.07);border-radius:13px;background:rgba(255,255,255,.02)}
    .base-icon{color:#718592;font:900 10px var(--rank-font-head)}
    .rank-option-copy{text-align:center}.rank-option-copy strong{display:block;font:900 12px var(--rank-font-head)}.rank-option-copy small{display:block;margin-top:3px;color:#526a77;font:600 7px var(--rank-font-head)}
    .rank-option-check{position:absolute;top:8px;right:8px;width:7px;height:7px;border:1px solid #385363;border-radius:50%}.rank-option.selected .rank-option-check{background:var(--rank-cyan);border-color:var(--rank-cyan);box-shadow:0 0 10px rgba(76,201,255,.55)}
    .selector-divider{height:1px;margin:23px 0;background:linear-gradient(90deg,transparent,var(--rank-line),transparent)}
    .error{margin:0 28px 14px;padding:11px 12px;border:1px solid rgba(255,116,112,.25);border-radius:10px;background:rgba(255,116,112,.055);color:#ffaaa4;font:700 9px var(--rank-font-head)}
    .result{padding:2px 28px 28px}
    .result-grid{display:grid;grid-template-columns:minmax(0,1fr) 1.15fr;gap:12px}
    .total-card,.metrics article{border:1px solid rgba(76,201,255,.11);border-radius:18px;background:linear-gradient(145deg,#102533,#0b1721)}
    .total-card{padding:20px 21px}.rp-number{display:flex;align-items:center;gap:9px;margin:10px 0 5px}.rp-number img{width:34px;height:34px;object-fit:contain;filter:drop-shadow(0 5px 8px rgba(0,0,0,.3))}.rp-number strong{font:900 clamp(45px,6vw,70px)/.9 var(--rank-font-head);letter-spacing:-.08em}.total-card p{margin:0;color:var(--rank-muted);font:500 10px var(--rank-font-body)}
    .route-pill{display:inline-flex;align-items:center;gap:9px;margin-top:15px;padding:7px 9px;border:1px solid rgba(255,255,255,.065);border-radius:999px;color:#86a0af;font:800 8px var(--rank-font-head)}.route-pill i{width:20px;height:1px;background:#36505f}
    .metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px}.metrics article{padding:16px}.metrics article span{display:block;color:#637b89;font:800 8px var(--rank-font-head);letter-spacing:.1em}.metrics article strong{display:block;margin-top:7px;font:900 22px var(--rank-font-head);letter-spacing:-.04em}.metrics article small{display:block;margin-top:3px;color:#4f6572;font:500 8px var(--rank-font-body)}
    .route-preview{margin-top:13px;padding:15px 16px;border:1px solid rgba(255,255,255,.065);border-radius:16px;background:rgba(255,255,255,.017)}.route-preview-head{display:flex;justify-content:space-between;align-items:end;gap:14px}.route-preview-head>div strong{display:block;margin-top:4px;font:900 16px var(--rank-font-head)}.route-status{padding:6px 8px;border:1px solid rgba(76,201,255,.1);border-radius:999px;color:#7290a0;font:800 7px var(--rank-font-head)}
    .route-track{display:flex;align-items:center;gap:6px;margin-top:13px;overflow:auto;padding-bottom:2px}.route-node{min-width:65px;display:grid;justify-items:center;gap:3px;color:#536b78}.route-node.active{color:#a8dff0}.route-node.focus{color:var(--rank-cyan)}.route-node i{}.route-node .route-icon{width:34px;height:34px;display:grid;place-items:center}.route-node .route-icon img{width:39px;height:39px;object-fit:contain}.route-node .route-icon.base{border:1px solid rgba(255,255,255,.07);border-radius:9px}.route-node .route-icon.base:before{content:'Base';font:900 7px var(--rank-font-head);color:#718692}.route-node strong{font:800 8px var(--rank-font-head);white-space:nowrap}.route-track>i{width:22px;height:1px;flex:0 0 22px;background:#2b4554}
    .breakdown{margin-top:14px;border:1px solid rgba(255,255,255,.07);border-radius:18px;overflow:hidden;background:#0a151e}.breakdown-head{display:flex;justify-content:space-between;align-items:end;gap:16px;padding:18px 19px;border-bottom:1px solid var(--rank-line);background:linear-gradient(180deg,rgba(76,201,255,.035),transparent)}.breakdown-head h3{margin:7px 0 3px;font:800 20px var(--rank-font-head);letter-spacing:-.03em}.breakdown-head p{margin:0;color:#5a717f;font:500 9px var(--rank-font-body)}.breakdown-total{display:flex;align-items:center;gap:7px;padding:9px 11px;border:1px solid rgba(76,201,255,.13);border-radius:10px;background:rgba(76,201,255,.04)}.breakdown-total img{width:21px;height:21px;object-fit:contain}.breakdown-total strong{font:900 16px var(--rank-font-head)}.breakdown-total small{color:var(--rank-cyan);font:900 8px var(--rank-font-head)}
    .cost-row{display:grid;grid-template-columns:34px minmax(0,1fr) 100px auto;align-items:center;gap:12px;padding:13px 17px;border-bottom:1px solid rgba(255,255,255,.05)}.cost-row:last-child{border-bottom:0}.cost-row-index{width:27px;height:27px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.15);border-radius:8px;color:var(--rank-cyan);background:#0d202d;font:800 8px var(--rank-font-head)}.cost-row-route{display:flex;align-items:center;gap:7px;color:#95aab6;font:800 10px var(--rank-font-head)}.cost-row-route span{color:#607783}.cost-row-route i{font-style:normal;color:#365263}.cost-row-route strong{color:#e8f3f7}.cost-row-ovr{color:#536b78;font:700 8px var(--rank-font-head)}.cost-row-price{display:flex;align-items:center;justify-content:flex-end;gap:5px}.cost-row-price img{width:19px;height:19px;object-fit:contain}.cost-row-price strong{font:900 17px var(--rank-font-head)}.cost-row-price small{color:var(--rank-cyan);font:900 7px var(--rank-font-head)}
    .empty{padding:18px;color:var(--rank-muted);font:600 10px var(--rank-font-body)}
