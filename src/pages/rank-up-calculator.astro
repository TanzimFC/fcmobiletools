---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANKS, RANK_COSTS } from '../data/fcMobileRankUp.js';

const fmt = (n) => Number(n).toLocaleString();

const RANK_ICONS = {
  0: '/assets/images/rankup/rankicon_25_RANK0.png',
  1: '/assets/images/rankup/rankicon_25_RANK1.png',
  2: '/assets/images/rankup/rankicon_25_RANK2.png',
  3: '/assets/images/rankup/rankicon_25_RANK3.png',
  4: '/assets/images/rankup/rankicon_25_RANK4.png',
  5: '/assets/images/rankup/rankicon_25_RANK5.png'
};

const RP_ICON = '/assets/images/fc_c2_IMG_FC_C02_07.png';
---

<BaseLayout
  title="FC Mobile Rank Up Calculator | FCMOBILETOOLS"
  description="Calculate FC Mobile Rank Up Points by Base OVR, current rank and target rank."
>
  <main class="rank-page">
    <section class="hero">
      <div class="hero-backdrop"></div>
      <div class="shell hero-inner">
        <div class="crumb"><a href="/">FCMOBILETOOLS</a><span>/</span><span>Rank Up Calculator</span></div>
        <div class="hero-layout">
          <div class="hero-copy">
            <div class="hero-kicker"><span></span>RANK LAB / FC MOBILE</div>
            <h1>Rank Up <em>Calculator</em></h1>
            <p>Build the exact upgrade route for your player. Set the Base OVR, select the current rank, select the target rank, and get the required RP instantly.</p>
            <div class="hero-pills">
              <span>LIVE CALCULATION</span>
              <span>STATIC RANK ART</span>
              <span>RP BREAKDOWN</span>
            </div>
          </div>

          <div class="hero-display" aria-hidden="true">
            <div class="hero-display-grid"></div>
            <div class="hero-ring ring-a"></div>
            <div class="hero-ring ring-b"></div>
            <div class="hero-rank-art"><img src={RANK_ICONS[5]} alt="" /></div>
            <div class="hero-display-caption">
              <span>MAXIMUM RANK</span>
              <strong>ORANGE</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="shell app">
      <div class="workspace">
        <div class="workspace-top">
          <div>
            <span class="section-kicker">RANK UP PLANNER</span>
            <h2>Build your upgrade path</h2>
          </div>
          <div class="workspace-status"><i></i><span>CALCULATOR ACTIVE</span></div>
        </div>

        <div class="workspace-controls">
          <label class="control">
            <span>BASE OVR</span>
            <div class="control-field">
              <input id="base" type="number" min="0" max="150" value="110" inputmode="numeric" />
              <small>OVR</small>
            </div>
          </label>

          <label class="control">
            <span>AVAILABLE RP <em>OPTIONAL</em></span>
            <div class="control-field">
              <input id="available" type="number" min="0" placeholder="—" inputmode="numeric" />
              <small>RP</small>
            </div>
          </label>

          <div class="control-note">
            <span>HOW IT WORKS</span>
            <p>Choose your starting rank and destination. Only valid routes stay active.</p>
          </div>
        </div>

        <section class="selector-area">
          <div class="selector-heading">
            <div>
              <span class="section-kicker">RANK PATH</span>
              <h3>Choose the starting and finishing rank</h3>
            </div>
            <div class="route-chip">
              <span id="routeFrom">Base</span>
              <b>→</b>
              <span id="routeTo">Orange</span>
            </div>
          </div>

          <div class="selector-stage">
            <div class="selector-group">
              <div class="group-heading">
                <span class="group-index">01</span>
                <div><strong>CURRENT RANK</strong><small>Player's current level</small></div>
              </div>
              <div class="rank-dock">
                <div id="currentChoices" class="rank-grid"></div>
              </div>
            </div>

            <div class="selector-bridge">
              <span></span>
              <b>→</b>
              <span></span>
            </div>

            <div class="selector-group">
              <div class="group-heading">
                <span class="group-index">02</span>
                <div><strong>TARGET RANK</strong><small>Desired finishing level</small></div>
              </div>
              <div class="rank-dock">
                <div id="targetChoices" class="rank-grid"></div>
              </div>
            </div>
          </div>

          <input id="current" type="hidden" value="0" />
          <input id="target" type="hidden" value="5" />
          <div id="error" class="error" hidden></div>
        </section>

        <section class="results">
          <div class="result-hero">
            <div class="result-copy">
              <span class="section-kicker">UPGRADE COST</span>
              <div class="result-number">
                <div class="rp-icon-frame"><img src={RP_ICON} alt="" /></div>
                <strong id="required">0</strong>
                <span>RP</span>
              </div>
              <p id="status">Choose your upgrade route.</p>
              <div class="result-path"><span id="miniFrom">Base</span><i>→</i><span id="miniTo">Orange</span></div>
            </div>

            <div class="result-stats">
              <div><span>OVR AFTER RANK</span><strong id="ovr">110</strong><small>Base OVR + target rank</small></div>
              <div><span>RANKS GAINED</span><strong id="gained">0</strong><small>Upgrade steps</small></div>
              <div><span>SKILL POINTS</span><strong id="skills">0</strong><small>Earned from upgrades</small></div>
              <div><span>RP BALANCE</span><strong id="remaining">—</strong><small>After available RP</small></div>
            </div>
          </div>

          <section class="cost-module">
            <div class="module-head">
              <div>
                <span class="section-kicker">COST BREAKDOWN</span>
                <h3>Every upgrade step</h3>
              </div>
              <div class="module-total"><span>TOTAL</span><strong id="costTotal">0 RP</strong></div>
            </div>
            <div class="table-wrap">
              <table class="cost-table">
                <thead>
                  <tr><th>STEP</th><th>UPGRADE</th><th>BASE OVR</th><th>RP REQUIRED</th></tr>
                </thead>
                <tbody id="stepRows"></tbody>
              </table>
            </div>
          </section>
        </section>
      </div>

      <section class="reference">
        <div class="reference-head">
          <div>
            <span class="section-kicker">REFERENCE DATA</span>
            <h2>RP cost by Base OVR</h2>
            <p>Each column represents the cost of one individual rank step.</p>
          </div>
          <div class="reference-mark">FCMOBILETOOLS <span>/</span> RANK LAB</div>
        </div>

        <div class="reference-table-wrap">
          <table class="reference-table">
            <thead>
              <tr><th>BASE OVR</th><th>GREEN</th><th>BLUE</th><th>PURPLE</th><th>RED</th><th>ORANGE</th></tr>
            </thead>
            <tbody>
              {RANK_COSTS.map((row) => (
                <tr>
                  <td><strong>{row.label}</strong></td>
                  {row.costs.map((cost) => <td>{fmt(cost)} RP</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </section>

    <section class="faq">
      <div class="shell">
        <span class="section-kicker">HELP</span>
        <h2>Rank Up Calculator FAQ</h2>
        <div class="faq-grid">
          <details open><summary>How is the RP total calculated?</summary><p>The calculator reads the Base OVR bracket and adds the cost of every rank step between the current and target rank.</p></details>
          <details><summary>Which ranks are supported?</summary><p>Base, Green, Blue, Purple, Red and Orange.</p></details>
          <details><summary>What does Available RP do?</summary><p>Enter your balance to calculate the remaining RP after the selected upgrade path.</p></details>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { calculateRankUp } from '../lib/fcMobileRankUp.js';
    import { RANKS } from '../data/fcMobileRankUp.js';

    const $ = (id) => document.getElementById(id);
    const fmt = (n) => Number(n).toLocaleString();

    const base = $('base');
    const available = $('available');
    const current = $('current');
    const target = $('target');
    const currentChoices = $('currentChoices');
    const targetChoices = $('targetChoices');

    const ICONS = {
      0:'/assets/images/rankup/rankicon_25_RANK0.png',
      1:'/assets/images/rankup/rankicon_25_RANK1.png',
      2:'/assets/images/rankup/rankicon_25_RANK2.png',
      3:'/assets/images/rankup/rankicon_25_RANK3.png',
      4:'/assets/images/rankup/rankicon_25_RANK4.png',
      5:'/assets/images/rankup/rankicon_25_RANK5.png'
    };

    const rankName = (value) => RANKS[value]?.name || 'Base';

    function icon(value){
      return '<img src="'+ICONS[value]+'" alt="" loading="eager" />';
    }

    function makeRankButtons(kind){
      return RANKS.map((rank) =>
        '<button class="rank-tile" type="button" aria-pressed="false" data-kind="'+kind+'" data-value="'+rank.value+'">'
          +'<span class="rank-tile-aura"></span>'
          +'<span class="rank-tile-sheen"></span>'
          +'<span class="rank-tile-art">'+icon(rank.value)+'</span>'
          +'<span class="rank-tile-label">'+rank.name+'</span>'
          +'<span class="rank-tile-marker">✓</span>'
        +'</button>'
      ).join('');
    }

    function buildSelectors(){
      currentChoices.innerHTML = makeRankButtons('current');
      targetChoices.innerHTML = makeRankButtons('target');

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          const value = Number(button.dataset.value);
          current.value = String(value);
          if(Number(target.value) <= value) target.value = String(Math.min(5, value + 1));
          render();
        });
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        button.addEventListener('click', () => {
          if(button.disabled) return;
          target.value = button.dataset.value;
          render();
        });
      });
    }

    function syncSelectors(){
      const from = Number(current.value);
      const to = Number(target.value);

      currentChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === from;
        button.disabled = value >= to;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      targetChoices.querySelectorAll('.rank-tile').forEach((button) => {
        const value = Number(button.dataset.value);
        const selected = value === to;
        button.disabled = value <= from;
        button.classList.toggle('selected', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
    }

    function renderTable(data){
      $('costTotal').textContent = fmt(data.requiredRP)+' RP';

      if(!data.steps.length){
        $('stepRows').innerHTML = '<tr><td colspan="4" class="table-empty">No upgrade steps are required for this route.</td></tr>';
        return;
      }

      $('stepRows').innerHTML = data.steps.map((step, index) =>
        '<tr>'
          +'<td><span class="step-num">'+String(index + 1).padStart(2,'0')+'</span></td>'
          +'<td><div class="upgrade-cell"><strong>'+rankName(step.from)+'</strong><span>→</span><strong>'+rankName(step.to)+'</strong></div></td>'
          +'<td>'+data.bracket.label+'</td>'
          +'<td><strong class="rp-amount">'+fmt(step.cost)+' RP</strong></td>'
        +'</tr>'
      ).join('');
    }

    function render(){
      syncSelectors();

      const data = calculateRankUp({
        baseOVR: base.value,
        currentRank: current.value,
        targetRank: target.value,
        availableRP: available.value
      });

      if(!data.valid){
        $('error').hidden = false;
        $('error').textContent = data.error;
        return;
      }

      $('error').hidden = true;
      $('required').textContent = fmt(data.requiredRP);
      $('ovr').textContent = fmt(data.targetOVR);
      $('skills').textContent = data.skillPoints;
      $('gained').textContent = data.ranksGained;
      $('remaining').textContent = data.remainingRP === null ? '—' : fmt(data.remainingRP);
      $('status').textContent = data.bracket.label+' · '+rankName(data.currentRank)+' → '+rankName(data.targetRank);
      $('miniFrom').textContent = rankName(data.currentRank);
      $('miniTo').textContent = rankName(data.targetRank);
      $('routeFrom').textContent = rankName(data.currentRank);
      $('routeTo').textContent = rankName(data.targetRank);

      renderTable(data);
    }

    buildSelectors();
    [base, available].forEach((field) => field.addEventListener('input', render));
    render();
  </script>

  <style>
    :root{
      --rc-bg:#040b11;
      --rc-bg-2:#06131c;
      --rc-panel:#081722;
      --rc-panel-2:#0a1c29;
      --rc-panel-3:#0d2433;
      --rc-text:#f5f9fb;
      --rc-muted:#93a9b5;
      --rc-dim:#607987;
      --rc-line:rgba(255,255,255,.075);
      --rc-line-soft:rgba(255,255,255,.045);
      --rc-cyan:#4cc9ff;
      --rc-cyan-2:#a5ebff;
      --rc-head:'Space Grotesk',system-ui,sans-serif;
      --rc-body:'Inter',system-ui,sans-serif;
    }

    .rank-page{
      color:var(--rc-text);
      min-height:100vh;
      background:
        radial-gradient(900px 500px at 4% 0%,rgba(76,201,255,.12),transparent 68%),
        radial-gradient(760px 470px at 96% 8%,rgba(76,201,255,.07),transparent 68%),
        linear-gradient(180deg,#040b11 0%,#061019 52%,#040b11 100%);
    }
    .shell{width:min(1180px,calc(100% - 38px));margin:auto}

    .hero{position:relative;border-bottom:1px solid var(--rc-line);overflow:hidden}
    .hero-backdrop{position:absolute;inset:0;background-image:linear-gradient(rgba(76,201,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.018) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,#000,transparent 94%);opacity:.75}
    .hero-inner{position:relative;padding:28px 0 52px}
    .crumb{display:flex;gap:9px;align-items:center;margin-bottom:48px;color:#56717e;font:800 9px/1 var(--rc-head)}
    .crumb a{color:var(--rc-cyan);text-decoration:none}
    .hero-layout{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:72px;align-items:center}
    .hero-kicker{display:flex;align-items:center;gap:8px;color:#6f8996;font:900 8px/1 var(--rc-head);letter-spacing:.15em}
    .hero-kicker span{width:20px;height:1px;background:var(--rc-cyan);box-shadow:0 0 12px rgba(76,201,255,.5)}
    .hero h1{margin:15px 0 17px;font:800 clamp(52px,7vw,86px)/.86 var(--rc-head);letter-spacing:-.08em}
    .hero h1 em{font-style:normal;color:var(--rc-cyan)}
    .hero-copy>p{max-width:700px;margin:0;color:var(--rc-muted);font:500 13px/1.8 var(--rc-body)}
    .hero-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:21px}
    .hero-pills span{padding:7px 10px;border:1px solid var(--rc-line);border-radius:999px;color:#718996;background:rgba(255,255,255,.01);font:900 7px/1 var(--rc-head);letter-spacing:.08em}

    .hero-display{position:relative;height:244px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.16);border-radius:30px;background:linear-gradient(145deg,#0a1c28,#06121b);box-shadow:0 30px 100px rgba(0,0,0,.28);overflow:hidden}
    .hero-display-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(76,201,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(76,201,255,.025) 1px,transparent 1px);background-size:26px 26px;mask-image:radial-gradient(circle,#000 25%,transparent 74%)}
    .hero-ring{position:absolute;border-radius:50%;border:1px solid rgba(76,201,255,.16)}
    .ring-a{width:176px;height:176px;animation:spin 18s linear infinite}
    .ring-b{width:136px;height:136px;border-color:rgba(76,201,255,.08);animation:spin-reverse 11s linear infinite}
    .hero-rank-art{position:relative;width:160px;height:160px;display:grid;place-items:center}
    .hero-rank-art img{width:150px;height:150px;object-fit:contain;filter:drop-shadow(0 22px 30px rgba(0,0,0,.45))}
    .hero-display-caption{position:absolute;bottom:17px;left:0;right:0;text-align:center}
    .hero-display-caption span{display:block;color:#5f7a87;font:900 7px/1 var(--rc-head);letter-spacing:.14em}.hero-display-caption strong{display:block;margin-top:5px;color:#eaf8fc;font:900 20px/1 var(--rc-head)}
    @keyframes spin{to{transform:rotate(360deg)}}@keyframes spin-reverse{to{transform:rotate(-360deg)}}

    .app{padding:39px 0 72px}
    .workspace{border:1px solid var(--rc-line);border-radius:28px;background:linear-gradient(150deg,#081722,#061019);box-shadow:0 35px 110px rgba(0,0,0,.28);overflow:hidden}
    .workspace:before{content:"";display:block;height:2px;background:linear-gradient(90deg,transparent,var(--rc-cyan),rgba(165,235,255,.75),transparent)}
    .workspace-top{display:flex;justify-content:space-between;align-items:center;padding:25px 29px;border-bottom:1px solid var(--rc-line)}
    .section-kicker{display:block;color:var(--rc-cyan);font:900 8px/1 var(--rc-head);letter-spacing:.17em}
    .workspace-top h2,.reference h2,.faq h2{margin:8px 0 4px;font:800 27px/1 var(--rc-head);letter-spacing:-.05em}
    .workspace-status{display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid rgba(76,201,255,.12);border-radius:999px;color:#6d8794;font:900 7px/1 var(--rc-head);letter-spacing:.11em}
    .workspace-status i{width:6px;height:6px;border-radius:50%;background:var(--rc-cyan);box-shadow:0 0 12px rgba(76,201,255,.75);animation:pulse 2.2s infinite}
    @keyframes pulse{50%{box-shadow:0 0 0 6px rgba(76,201,255,0)}}

    .workspace-controls{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:11px;padding:21px 29px 8px}
    .control{padding:14px;border:1px solid var(--rc-line-soft);border-radius:18px;background:rgba(255,255,255,.008)}
    .control>span{display:flex;justify-content:space-between;margin-bottom:9px;color:#718a96;font:900 8px/1 var(--rc-head);letter-spacing:.12em}
    .control>span em{font-style:normal;color:#45616f;font-size:7px}
    .control-field{display:flex;align-items:center;gap:9px}.control-field input{width:100%;height:45px;border:1px solid #28414e;border-radius:12px;background:#06131d;color:var(--rc-text);padding:0 12px;outline:0;font:900 13px var(--rc-head);transition:.18s}
    .control-field input:focus{border-color:rgba(76,201,255,.72);box-shadow:0 0 0 3px rgba(76,201,255,.08),0 0 26px rgba(76,201,255,.05)}
    .control-field small{color:#52707d;font:900 7px/1 var(--rc-head)}
    .control-note{padding:14px 16px;border-left:1px solid rgba(76,201,255,.16);align-self:stretch;display:flex;flex-direction:column;justify-content:center}
    .control-note span{color:#536f7c;font:900 7px/1 var(--rc-head);letter-spacing:.13em}.control-note p{margin:7px 0 0;max-width:300px;color:#76909c;font:500 9px/1.55 var(--rc-body)}

    .selector-area{padding:24px 29px 29px}
    .selector-heading{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:18px}
    .selector-heading h3{margin:8px 0 0;font:800 20px/1 var(--rc-head);letter-spacing:-.035em}
    .route-chip{display:flex;gap:10px;align-items:center;padding:9px 12px;border:1px solid rgba(76,201,255,.13);border-radius:999px;background:rgba(76,201,255,.025);color:#9bb2bd;font:900 8px/1 var(--rc-head)}.route-chip b{color:var(--rc-cyan);font-size:10px}

    .selector-stage{display:grid;grid-template-columns:minmax(0,1fr) 44px minmax(0,1fr);align-items:stretch;gap:12px}
    .group-heading{display:flex;gap:10px;align-items:center;margin:0 0 10px 2px}.group-index{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;border:1px solid rgba(76,201,255,.16);background:#082031;color:var(--rc-cyan);font:900 8px/1 var(--rc-head)}
    .group-heading strong{display:block;color:#dceaf0;font:900 8px/1 var(--rc-head);letter-spacing:.10em}.group-heading small{display:block;margin-top:4px;color:#506b78;font:500 7px/1 var(--rc-body)}
    .rank-dock{padding:13px;border:1px solid rgba(68,139,171,.18);border-radius:23px;background:linear-gradient(145deg,#061926,#06131d);box-shadow:inset 0 1px 0 rgba(255,255,255,.025),inset 0 -25px 60px rgba(0,92,132,.025)}
    .rank-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}

    .rank-tile{position:relative;min-width:0;width:100%;height:122px;padding:10px 6px 9px;border:1px solid rgba(74,132,158,.18);border-radius:17px;background:linear-gradient(145deg,#091824,#06121c);color:var(--rc-text);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;overflow:hidden;isolation:isolate;transition:transform .2s cubic-bezier(.2,.8,.2,1),border-color .2s,box-shadow .2s,background .2s,opacity .2s}
    .rank-tile:hover:not(:disabled){transform:translateY(-4px);border-color:rgba(76,201,255,.4);background:linear-gradient(145deg,#0a1d2b,#07131e);box-shadow:0 16px 34px rgba(0,0,0,.24),0 0 28px rgba(76,201,255,.05)}
    .rank-tile.selected{border:2px solid var(--rc-cyan);background:radial-gradient(100px 72px at 50% 5%,rgba(76,201,255,.24),transparent 72%),linear-gradient(180deg,#123247,#081720);box-shadow:inset 0 0 0 1px rgba(165,235,255,.16),inset 0 0 28px rgba(76,201,255,.08),0 0 0 3px rgba(76,201,255,.08),0 0 30px rgba(76,201,255,.16);animation:selectedPulse 2.5s ease-in-out infinite}
    .rank-tile.selected:after{content:"";position:absolute;left:16%;right:16%;bottom:0;height:3px;border-radius:999px;background:linear-gradient(90deg,transparent,var(--rc-cyan-2),transparent);box-shadow:0 0 16px rgba(76,201,255,.9);animation:barPulse 2.2s ease-in-out infinite}
    .rank-tile:disabled{opacity:.12;cursor:not-allowed}
    .rank-tile-aura{position:absolute;width:92px;height:92px;left:50%;top:-42px;transform:translateX(-50%);border-radius:50%;background:rgba(76,201,255,.18);filter:blur(24px);opacity:0;z-index:-1}
    .rank-tile.selected .rank-tile-aura{opacity:1;animation:auraPulse 2.6s ease-in-out infinite}
    .rank-tile-sheen{position:absolute;top:-100%;left:-25%;width:150%;height:220%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.11),transparent);transform:rotate(22deg) translateX(-70%);opacity:0}
    .rank-tile.selected .rank-tile-sheen{opacity:1;animation:sheen 3.2s ease-in-out infinite}
