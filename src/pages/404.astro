---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <section class="wrap page-hero not-found">
    <div class="not-found-mark">404</div>
    <p class="eyebrow">FC MOBILE TOOLS</p>
    <h1>That page doesn't exist.</h1>
    <p>The page may have moved during the site redesign. Use the homepage to find the latest tools, guides and trackers.</p>
    <div class="not-found-actions"><a class="btn primary" href="/">Back home</a><a class="btn secondary" href="/blog/">Browse guides</a></div>
  </section>
</BaseLayout>
<style>
.not-found{position:relative;min-height:55vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;overflow:hidden}.not-found::after{content:"";position:absolute;width:360px;height:360px;right:-80px;top:40px;border-radius:50%;background:radial-gradient(circle,#d8f1f7 0,transparent 68%);pointer-events:none}.not-found-mark{position:absolute;right:18px;top:5px;font:900 clamp(100px,18vw,210px)/1 var(--mono);letter-spacing:-.1em;color:#eaf7fa;z-index:-1}.not-found h1{max-width:650px;font-size:clamp(44px,7vw,76px);letter-spacing:-.07em;margin:10px 0}.not-found>p:not(.eyebrow){max-width:570px;color:var(--muted);font-size:12px;line-height:1.7}.not-found-actions{display:flex;gap:8px;margin-top:18px}.not-found-actions .btn{min-width:115px;text-align:center}.btn.secondary{border:1px solid var(--border);background:var(--surface);color:var(--text)}
@media(max-width:600px){.not-found{min-height:60vh}.not-found-mark{right:-10px;top:35px;font-size:100px}.not-found-actions{width:100%}.not-found-actions .btn{flex:1}}
</style>
