---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Page Not Found" description="The page you requested could not be found on FCMobiletools.">
  <main class="not-found-page">
    <section class="not-found-hero wrap">
      <div class="nf-copy">
        <div class="nf-kicker"><span></span> ERROR 404 <span>PAGE NOT FOUND</span></div>
        <h1>This page is<br /><em>offside.</em></h1>
        <p>The link may be outdated, the page may have moved, or the address was entered incorrectly. Nothing is broken on your side.</p>
        <div class="nf-actions">
          <a class="nf-primary" href="/">Return home <b>↗</b></a>
          <a class="nf-secondary" href="/blog/">Explore articles <b>↗</b></a>
        </div>
      </div>

      <div class="error-card" aria-hidden="true">
        <div class="error-card-top"><span>FCMOBILETOOLS</span><span>STATUS / 404</span></div>
        <div class="error-number">404</div>
        <div class="error-line"><i></i><span>ROUTE NOT FOUND</span><i></i></div>
        <div class="error-card-bottom"><span>SEARCH THE SITE</span><span>RETURN TO PLAY</span></div>
      </div>
    </section>

    <section class="nf-links wrap">
      <div class="nf-section-head">
        <div>
          <p>NEED SOMEWHERE TO GO?</p>
          <h2>Jump back into FCMobiletools.</h2>
        </div>
        <span>QUICK ROUTES</span>
      </div>
      <div class="nf-route-grid">
        <a href="/team-ovr"><small>01</small><span><b>Team OVR</b><em>Build and check your squad rating.</em></span><i>↗</i></a>
        <a href="/training-calculator"><small>02</small><span><b>Training Calculator</b><em>Plan XP and training costs.</em></span><i>↗</i></a>
        <a href="/redeem-codes"><small>03</small><span><b>Redeem Codes</b><em>Check the latest available codes.</em></span><i>↗</i></a>
        <a href="/football-centre"><small>04</small><span><b>Football Centre</b><em>Open the live event tools.</em></span><i>↗</i></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.not-found-page{min-height:calc(100vh - 94px);padding:18px 0 30px;background:radial-gradient(680px 420px at 78% 22%,rgba(76,201,255,.12),transparent 68%),radial-gradient(520px 340px at 4% 78%,rgba(76,201,255,.045),transparent 72%)}
.not-found-hero{min-height:64vh;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(290px,.72fr);align-items:center;gap:72px}
.nf-copy{max-width:700px}
.nf-kicker{display:flex;align-items:center;gap:10px;color:var(--primary);font:800 10px/1 var(--font-body);letter-spacing:.14em}.nf-kicker>span:first-child{width:26px;height:1px;background:var(--primary);box-shadow:0 0 12px rgba(76,201,255,.45)}.nf-kicker>span:last-child{color:#66798a}
.nf-copy h1{margin:20px 0 22px;font:700 clamp(66px,8vw,112px)/.84 var(--font-display);letter-spacing:-.075em}.nf-copy h1 em{font-style:normal;color:var(--primary)}
.nf-copy>p{max-width:580px;margin:0;color:var(--muted);font-size:15px;line-height:1.8}
.nf-actions{display:flex;gap:10px;margin-top:30px}.nf-actions a{display:inline-flex;align-items:center;gap:14px;min-height:48px;padding:0 16px;border:1px solid var(--border);border-radius:12px;font:700 12px/1 var(--font-body);transition:transform .18s ease,border-color .18s ease,background .18s ease}.nf-actions b{font-size:14px;font-weight:700}
.nf-primary{background:linear-gradient(135deg,var(--primary),#36baf2);color:#04131c;border-color:transparent!important;box-shadow:0 14px 36px rgba(76,201,255,.16)}.nf-secondary{background:rgba(15,26,38,.78);color:var(--text)}
.nf-actions a:hover{transform:translateY(-2px);border-color:rgba(76,201,255,.32)}
.error-card{position:relative;width:min(430px,100%);aspect-ratio:1/.96;justify-self:end;padding:22px;overflow:hidden;border:1px solid rgba(76,201,255,.15);border-radius:28px;background:linear-gradient(145deg,rgba(19,34,47,.98),rgba(7,16,24,.98));box-shadow:0 30px 90px rgba(0,0,0,.35),inset 0 1px rgba(255,255,255,.045);transform:rotate(2.2deg)}
.error-card:before{content:"";position:absolute;width:240px;height:240px;right:-80px;top:-90px;border-radius:50%;background:rgba(76,201,255,.14);filter:blur(55px)}.error-card:after{content:"";position:absolute;inset:15px;border:1px solid rgba(255,255,255,.035);border-radius:20px;pointer-events:none}
.error-card-top,.error-card-bottom{position:relative;z-index:1;display:flex;justify-content:space-between;gap:12px;font:800 9px/1 var(--font-body);letter-spacing:.12em;color:#708394}.error-card-top span:last-child{color:var(--primary)}
.error-number{position:relative;z-index:1;margin:54px 0 30px;font:700 clamp(100px,15vw,170px)/.8 var(--font-display);letter-spacing:-.1em;color:#eefaff;text-shadow:0 0 50px rgba(76,201,255,.11)}
.error-line{position:relative;z-index:1;display:flex;align-items:center;gap:10px;color:#667b8c;font:800 9px/1 var(--font-body);letter-spacing:.15em}.error-line i{display:block;flex:1;height:1px;background:rgba(255,255,255,.08)}.error-line i:first-child{background:linear-gradient(90deg,transparent,rgba(76,201,255,.34))}
.error-card-bottom{position:absolute;z-index:1;left:22px;right:22px;bottom:22px;color:#53697a}.error-card-bottom span:last-child{color:#8ea1af}
.nf-links{padding:22px 0 62px}.nf-section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:16px}.nf-section-head p{margin:0 0 8px;color:var(--primary);font:800 9px/1 var(--font-body);letter-spacing:.16em}.nf-section-head h2{margin:0;font-size:clamp(28px,4vw,42px);line-height:1;letter-spacing:-.04em}.nf-section-head>span{color:#607385;font:800 9px/1 var(--font-body);letter-spacing:.15em}
.nf-route-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);border-left:1px solid var(--border)}.nf-route-grid a{min-height:142px;display:grid;grid-template-columns:26px minmax(0,1fr) 16px;gap:12px;padding:16px 14px;border-right:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(15,26,38,.35);transition:background .18s ease,transform .18s ease,border-color .18s ease}.nf-route-grid a:hover{background:rgba(15,26,38,.88);transform:translateY(-2px);border-color:rgba(76,201,255,.18)}.nf-route-grid small,.nf-route-grid i{color:var(--primary);font:800 8px/1 var(--font-body);font-style:normal}.nf-route-grid span{display:block}.nf-route-grid b,.nf-route-grid em{display:block}.nf-route-grid b{color:var(--text);font:700 12px/1.3 var(--font-body)}.nf-route-grid em{margin-top:8px;color:#718394;font:500 11px/1.55 var(--font-body);font-style:normal}.nf-route-grid i{justify-self:end}
@media(max-width:900px){.not-found-hero{grid-template-columns:1fr;gap:48px;min-height:auto;padding:68px 0 60px}.error-card{justify-self:start;width:min(390px,100%);margin-left:auto}.nf-route-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.not-found-page{padding-top:4px}.nf-copy h1{font-size:62px}.nf-copy>p{font-size:14px}.nf-actions{flex-direction:column}.nf-actions a{width:100%;justify-content:space-between}.error-card{transform:none}.error-number{margin:48px 0 24px}.nf-section-head{align-items:flex-start;flex-direction:column;gap:12px}.nf-route-grid{grid-template-columns:1fr}.nf-route-grid a{min-height:118px}}
</style>