---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you requested could not be found on FC Mobile Tools.">
  <main class="not-found-page">
    <section class="not-found-hero wrap">
      <div class="nf-copy">
        <p class="eyebrow">FC MOBILE TOOLS · 404</p>
        <h1>Looks like you<br><span>lost the match.</span></h1>
        <p>The page you're looking for isn't here. It may have moved, been renamed, or never existed.</p>
        <div class="nf-actions"><a class="nf-primary" href="/">Back to homepage ↗</a><a class="nf-secondary" href="/blog/">Browse guides</a></div>
      </div>
      <div class="scoreboard" aria-hidden="true"><small>ERROR</small><strong>404</strong><span>PAGE NOT FOUND</span></div>
    </section>
    <section class="nf-links wrap"><p class="eyebrow">QUICK ROUTES</p><div><a href="/redeem-codes"><b>01</b><span>Redeem Codes</span><i>↗</i></a><a href="/football-centre"><b>02</b><span>Football Centre</span><i>↗</i></a><a href="/team-ovr"><b>03</b><span>Team OVR Calculator</span><i>↗</i></a><a href="/a-nations-story"><b>04</b><span>A Nation's Story</span><i>↗</i></a></div></section>
  </main>
</BaseLayout>
<style>
.not-found-page{min-height:calc(100vh - 70px);background:radial-gradient(700px 420px at 75% 35%,#12354a55,transparent 70%)}.not-found-hero{min-height:68vh;display:flex;align-items:center;justify-content:space-between;gap:50px}.nf-copy{max-width:680px}.eyebrow{margin:0;color:var(--blue);font:900 9px var(--mono);letter-spacing:.16em}.nf-copy h1{font-size:clamp(54px,8vw,94px);line-height:.88;letter-spacing:-.07em;margin:18px 0 24px}.nf-copy h1 span{color:var(--blue)}.nf-copy>p:not(.eyebrow){max-width:520px;color:var(--muted);font-size:13px;line-height:1.75}.nf-actions{display:flex;gap:8px;margin-top:26px}.nf-actions a{display:inline-flex;align-items:center;justify-content:center;padding:12px 15px;border:1px solid var(--border);border-radius:9px;font:900 8px var(--mono);transition:.18s}.nf-primary{background:linear-gradient(135deg,var(--blue),var(--blue2));border-color:var(--blue)!important;color:#04131c}.nf-secondary{background:var(--surface);color:var(--text)}.nf-actions a:hover{transform:translateY(-2px);border-color:var(--blue)}.scoreboard{width:min(310px,38vw);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid #55c7f233;border-radius:28px;background:linear-gradient(145deg,#0d1720,#091016);box-shadow:0 25px 70px #0005, inset 0 0 0 1px #ffffff05;transform:rotate(3deg)}.scoreboard small,.scoreboard span{font:900 8px var(--mono);letter-spacing:.18em;color:var(--blue)}.scoreboard strong{font:900 clamp(80px,13vw,150px)/.9 var(--mono);letter-spacing:-.1em;color:#e8f8fd;text-shadow:0 0 45px #55c7f233;margin:13px 0}.scoreboard span{color:#667d89}.nf-links{padding:0 0 70px}.nf-links>div{display:grid;grid-template-columns:repeat(4,1fr);margin-top:14px;border-top:1px solid var(--border)}.nf-links a{display:grid;grid-template-columns:30px 1fr 18px;gap:8px;align-items:center;padding:15px 12px;border-right:1px solid var(--border);border-bottom:1px solid var(--border);color:var(--muted);transition:.18s}.nf-links a:first-child{border-left:1px solid var(--border)}.nf-links a:hover{background:var(--surface);color:var(--text)}.nf-links b,.nf-links i{font:800 8px var(--mono);font-style:normal;color:var(--blue)}.nf-links span{font-size:10px;font-weight:700}@media(max-width:760px){.not-found-hero{min-height:62vh;display:block;padding-top:90px}.scoreboard{width:190px;margin:45px auto 0}.nf-links>div{grid-template-columns:1fr 1fr}}@media(max-width:480px){.nf-copy h1{font-size:54px}.nf-actions{flex-direction:column}.nf-actions a{width:100%}.nf-links>div{grid-template-columns:1fr}.nf-links a:first-child{border-left:1px solid var(--border)}}
</style>
