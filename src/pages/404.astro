---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <section class="wrap page-hero empty-state">
    <p class="eyebrow">404</p>
    <h1>That page doesn't exist.</h1>
    <p>The page may have moved during the site redesign.</p>
    <a class="btn primary" href="/">Back home</a>
  </section>
</BaseLayout>
