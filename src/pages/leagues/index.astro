---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/league-hub.css';
import { loadPublicDirectory, ssrSupabaseRest } from '../../lib/leaguePublic.js';
import { DIVISIONS, divisionIcon, divisionRange, SITE_ORIGIN } from '../../data/leagueConfig.js';
import { leagueCard, leagueHref, esc, infoBtn } from '../../lib/league-card.js';

// Rendered on demand and cached at the edge by the Worker. Real league cards are in the HTML
// so search engines and slow connections see them before any script runs.
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
let board = { leagues: [], spotlight: [], stats: { leagues: 0, spots: 0, sample: 0 } };
let loadFailed = false;
try { board = await loadPublicDirectory(env, ssrSupabaseRest); } catch (e) { loadFailed = true; console.error('[LEAGUES_PAGE]', e?.message); }
if (loadFailed) Astro.response.headers.set('cache-control', 'no-store');

const ssrLeagues = board.leagues.slice(0, 24);
const real = board.leagues.filter(l => !l.isSample);
const regions = new Set(real.map(l => l.regionServer)).size;
const boot = JSON.stringify({ ...board, at: Date.now() }).replace(/</g, '\\u003c');

const faq = [
  ['How do I join an FC Mobile league?', 'Pick a league with open spots, check the minimum OVR and tap Apply. Add a screenshot of your team so the owner can see your squad. Some leagues also use a Discord link or a league ID you can search in the game.'],
  ['What is the minimum OVR for a league?', 'Every league sets its own minimum OVR. Enter your team OVR on this page to see only the leagues you qualify for.'],
  ['What are league divisions?', 'Divisions group leagues by level: Bronze 1,050 to 2,000, Silver 2,100 to 4,000, World Class 4,100 to 6,000, Legendary 6,100 to 8,000 and FC Champions 8,100 to 10,000.'],
  ['What is the difference between Verified and Reviewed?', 'A Verified club is confirmed as a real, active club by FCMobiletools. A Reviewed listing was checked by the team but is not a verification.'],
  ['Can I list my own league?', 'Yes. Any player can list one league for free. Sign in, agree to the rules and fill in your division, minimum OVR, open spots and how to join.']
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'FC Mobile leagues with open spots', url: SITE_ORIGIN + '/leagues/',
    description: 'Browse FC Mobile leagues by division, region and minimum OVR.',
    mainEntity: { '@type': 'ItemList', itemListElement: ssrLeagues.filter(l => !l.isSample).slice(0, 20).map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_ORIGIN + leagueHref(l), name: l.name })) } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
    { '@type': 'ListItem', position: 2, name: 'Leagues', item: SITE_ORIGIN + '/leagues/' } ] }
];
---

<BaseLayout
  title="FC Mobile Leagues: Find a League with Open Spots"
  description="Browse FC Mobile leagues by division, region and minimum OVR. See open spots, schedules and how to join, then apply with your team screenshot. Free to use."
>
  {schema.map(s => <script slot="head" type="application/ld+json" set:html={JSON.stringify(s)}></script>)}

  <main class="app fl lg-root" id="app" data-page="find-a-league">
    <div class="lg-aurora" aria-hidden="true"></div>
    <div class="lg-wrap">

      <header class="lg-hero" id="lgHero">
        <div class="lg-hero-copy">
          <div class="lg-eyebrow"><i></i> FC MOBILE LEAGUES</div>
          <h1>Find an FC Mobile league <em>with open spots.</em></h1>
          <p>See division, minimum OVR, open spots and schedule on every league. Browse freely, sign in when you are ready to apply.</p>
          <div class="lg-hero-cta">
            <button class="lg-btn lg-btn-primary" id="lgListCta" type="button">List your league</button>
            <button class="lg-btn lg-btn-quiet" type="button" data-info="listing">How listing works</button>
          </div>
        </div>
        <div class="lg-hero-side">
          <div class="lg-stats" id="lgStats">
            <div><strong id="statLeagues">{real.length}</strong><span>Leagues</span></div>
            <div><strong id="statSpots">{real.reduce((n, l) => n + l.openSpots, 0)}</strong><span>Open spots</span></div>
            <div><strong id="statRegions">{regions}</strong><span>Regions</span></div>
          </div>
          <div class="lg-me" id="lgMe" hidden></div>
        </div>
      </header>

      <section class="lg-gate" id="lgError" hidden>
        <div class="lg-gate-mark warn" aria-hidden="true">!</div>
        <h2>We could not load the leagues.</h2>
        <p id="lgErrorMsg">Check your connection and try again.</p>
        <button class="lg-btn lg-btn-primary" id="lgRetry" type="button">Try again</button>
      </section>

      <div class="lg-workspace" id="lgWorkspace">
        <nav class="lg-tabs" id="lgTabs" role="tablist" aria-label="Leagues" hidden></nav>

        <!-- LEAGUES -->
        <section class="lg-panel" id="panelLeagues" role="tabpanel">
          <div class="lg-divbar" id="lgDivbar" role="group" aria-label="Division">
            <button type="button" class="lg-divpick on" data-div="">All divisions</button>
            {DIVISIONS.map(d => (
              <button type="button" class="lg-divpick" data-div={d.key}><img src={divisionIcon(d.key)} alt="" width="26" height="26" loading="lazy" decoding="async"><span>{d.label}<small>{divisionRange(d)}</small></span></button>
            ))}
          </div>

          <div class="lg-toolbar">
            <label class="lg-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="fQ" type="search" placeholder="Search league name or region" aria-label="Search leagues" autocomplete="off"></label>
            <select id="fSort" aria-label="Sort leagues"></select>
          </div>
          <div class="lg-quick">
            <label class="lg-ovrbox">My OVR <input id="fOvr" type="number" inputmode="numeric" min="50" max="200" placeholder="e.g. 118" aria-label="My team OVR"><Fragment set:html={infoBtn('ovr')} /></label>
            <label class="lg-switch-chip"><input type="checkbox" id="fSpots"><span>Open spots only</span></label>
            <select id="fRegion" aria-label="Region"></select>
          </div>
          <details class="lg-adv" id="lgAdv">
            <summary>More filters <span id="fCount" class="lg-tabbadge" hidden>0</span></summary>
            <div class="lg-filters">
              <select id="fFreq" aria-label="How often"><option value="">Any schedule</option><option value="daily">Daily</option><option value="most_days">Most days</option><option value="several_weekly">3 to 4 days a week</option><option value="weekly">Weekly</option><option value="occasional">Occasional</option></select>
              <select id="fSize" aria-label="Tournament size"><option value="">Any size</option><option>4v4</option><option>8v8</option><option>16v16</option><option>32v32</option></select>
              <select id="fLang" aria-label="Language"></select>
              <select id="fCommit" aria-label="Style"><option value="">Any style</option><option value="casual">Casual</option><option value="regular">Regular</option><option value="competitive">Competitive</option></select>
              <select id="fJoin" aria-label="How to join"><option value="">Any way to join</option><option value="apply">Apply here</option><option value="discord">Join Discord</option><option value="in_game">Search in game</option></select>
              <label class="lg-switch-chip"><input type="checkbox" id="fVerified"><span>Verified clubs only</span></label>
            </div>
          </details>

          <div class="lg-meta-row"><span id="lgResults">{real.length} leagues</span><span class="lg-meta-actions"><Fragment set:html={infoBtn('trust')} /><button type="button" class="lg-link" id="fClear">Clear filters</button></span></div>
          <p class="lg-sample-note" id="lgSampleNote" hidden>Clubs marked <b>Sample club</b> are made for testing. They are not real leagues.</p>

          <div id="lgGrid" class="lg-grid"><Fragment set:html={ssrLeagues.map((l, i) => leagueCard(l, { index: i, showSave: false })).join('')} /></div>
          <div class="lg-empty" id="lgEmpty" hidden>
            <span class="lg-empty-icon" aria-hidden="true">⌕</span>
            <h3 id="lgEmptyTitle">No leagues match.</h3>
            <p id="lgEmptyText">Try a different division or region.</p>
            <button class="lg-btn lg-btn-outline" id="lgEmptyReset" type="button">Clear filters</button>
          </div>
        </section>

        <section class="lg-panel" id="panelSpotlight" role="tabpanel" hidden>
          <div class="lg-panel-head slim"><div><h2>Community Spotlight <Fragment set:html={infoBtn('spotlight')} /></h2><p>Leagues with recent community activity. Open a league to learn more or save it for later.</p></div></div>
          <div id="lgSpot" class="lg-spot">
            <div class="lg-spot-head"><span class="lg-badge gold">★ Community Spotlight</span><small>Updated automatically</small></div>
            <div class="lg-rail" id="lgRail"></div>
          </div>
          <div class="lg-empty" id="lgSpotEmpty" hidden><span class="lg-empty-icon" aria-hidden="true">✦</span><h3>Spotlight is warming up.</h3><p>As players confirm activity, active leagues will appear here.</p><button class="lg-btn lg-btn-outline" data-goto="leagues" type="button">Browse all leagues</button></div>
        </section>

        <section class="lg-panel" id="panelSaved" role="tabpanel" hidden>
          <div class="lg-panel-head slim"><div><h2>Saved leagues</h2><p>Leagues you saved to look at again.</p></div></div>
          <div id="lgSavedGrid" class="lg-grid"></div>
          <div class="lg-empty" id="lgSavedEmpty" hidden><span class="lg-empty-icon" aria-hidden="true">♡</span><h3>Nothing saved yet.</h3><p>Tap the heart on a league to keep it here.</p><button class="lg-btn lg-btn-outline" data-goto="leagues" type="button">Browse leagues</button></div>
        </section>

        <section class="lg-panel" id="panelApps" role="tabpanel" hidden>
          <div class="lg-panel-head slim"><div><h2>My applications</h2><p>Leagues you applied to and what happened.</p></div></div>
          <div id="lgAppList"></div>
        </section>

        <section class="lg-panel" id="panelInbox" role="tabpanel" hidden>
          <div class="lg-panel-head slim"><div><h2>Inbox <Fragment set:html={infoBtn('inbox')} /></h2><p>Messages about league applications, decisions and moderation notices.</p></div><button class="lg-btn lg-btn-outline lg-btn-sm" id="lgInboxRefresh" type="button">Refresh</button></div>
          <div class="lg-inbox-admin-warning" role="note"><b><span aria-hidden="true">!</span> Inbox safety notice</b>
            <p>FCMOBILETOOLS admins can review Inbox messages. Never share passwords, login or recovery codes, payment details, or other sensitive information. Keep messages relevant to the league application. Abuse, spam or off-topic messages can lead to Inbox suspension. Messages are automatically deleted after 48 hours.</p>
          </div>
          <section class="lg-inbox-notices" id="lgInboxNotices" aria-label="League decisions and moderation notices"></section>
          <div class="lg-inbox">
            <div class="lg-inbox-threads" id="lgInboxThreads" aria-label="Conversations"><div class="lg-empty"><p>Loading conversations…</p></div></div>
            <section class="lg-inbox-chat" aria-label="Message conversation">
              <header class="lg-inbox-chat-head"><b id="lgInboxTitle">Choose a conversation</b><small id="lgInboxSubtitle">Your messages stay inside FCMobiletools.</small></header>
              <div class="lg-inbox-messages" id="lgInboxMessages" role="log" aria-live="polite"><div class="lg-inbox-empty">Select an application conversation to read messages.</div></div>
              <form class="lg-inbox-form" id="lgInboxForm" hidden>
                <label class="lg-field"><span>Message <Fragment set:html={infoBtn('inbox')} /></span><textarea id="lgInboxInput" rows="2" maxlength="1200" placeholder="Write a clear, respectful message…" required></textarea><small class="lg-help">No passwords or sensitive account details. Up to 1,200 characters.</small></label>
                <button class="lg-btn lg-btn-primary" id="lgInboxSend" type="submit">Send message</button>
              </form>
            </section>
          </div>
        </section>

        <section class="lg-panel" id="panelPlayers" role="tabpanel" hidden>
          <div class="lg-panel-head slim">
            <div><h2>Players looking for a league</h2><p>Unlock a player card to see what they chose to share.</p></div>
            <div class="lg-usage"><div class="lg-pips" id="lgPips"></div><span><strong id="lgRemaining">3</strong> unlocks left today<small>Resets at 00:00 UTC</small></span></div>
          </div>
          <div class="lg-toolbar">
            <label class="lg-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="pQ" type="search" placeholder="Search player or region" aria-label="Search players" autocomplete="off"></label>
            <select id="pSort" aria-label="Sort players"><option value="recent">Recently updated</option><option value="ovr">Highest OVR</option></select>
          </div>
          <div class="lg-filters open-always">
            <select id="pRegion" aria-label="Region"></select>
            <select id="pSize" aria-label="Tournament size"><option value="">Any size</option><option>4v4</option><option>8v8</option><option>16v16</option><option>32v32</option></select>
            <select id="pLang" aria-label="Language"></select>
            <select id="pOvr" aria-label="Minimum OVR"><option value="50">Any OVR</option><option value="100">100+</option><option value="110">110+</option><option value="120">120+</option><option value="125">125+</option></select>
          </div>
          <div class="lg-meta-row"><span id="lgPlayerResults">Players</span></div>
          <div id="lgPlayerGrid" class="lg-grid lg-grid-sm"></div>
          <div class="lg-empty" id="lgPlayerEmpty" hidden><span class="lg-empty-icon" aria-hidden="true">⌕</span><h3>No players match.</h3><p>Try a wider region or size.</p></div>
        </section>

        <section class="lg-panel" id="panelOwner" role="tabpanel" hidden></section>
      </div>

      <!-- LISTING EDITOR -->
      <section class="lg-setup" id="lgEditor" hidden>
        <div class="lg-setup-main">
          <div class="lg-panel-head">
            <div>
              <button class="lg-back" type="button" id="lgEditorBack">← Back</button>
              <h2 id="lgEditorTitle">List your league</h2>
              <p>Short and true works best. Players read the cards fast.</p>
            </div>
          </div>
          <form id="lgListingForm" class="lg-form" novalidate></form>
        </div>
        <aside class="lg-setup-side">
          <div class="lg-preview-label">How players see it</div>
          <div id="lgListingPreview"></div>
        </aside>
      </section>

      <section class="lg-faq" aria-labelledby="lgFaqH">
        <h2 id="lgFaqH">FC Mobile leagues: quick answers</h2>
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </section>
    </div>
    <script id="lgBoot" type="application/json" set:html={boot}></script>
    <div class="lg-toast" id="lgToast" role="status" aria-live="polite"></div>
  </main>
</BaseLayout>

<script>
  import { accountAuth } from '../../lib/account-client.js';
  import { api, token, signInUrl, toast, openSheet, bindInfo, openProfileSheet, startApply, openRulesSheet, mountUploader, $, $$, REGIONS, LANGS, SIZES } from '../../lib/league-client.js';
  import { leagueCard, esc, fmt, ts, crest, ring, infoBtn, divisionBadge, trustBadge, leagueHref, freqLabel } from '../../lib/league-card.js';
  import { DIVISIONS, ACCENTS, JOIN_METHODS, divisionIcon, divisionRange } from '../../data/leagueConfig.js';

  // ───────────── constants ─────────────
  const STYLE_COMMIT = { 'Competitive': ['competitive'], 'Active and relaxed': ['regular'], 'Casual': ['casual'], 'Quest focused': ['casual', 'regular'], 'Building a new team': ['casual', 'regular', 'competitive'] };
  const ALL_FREQ = ['daily', 'most_days', 'several_weekly', 'weekly', 'occasional'];
  const AVAIL_FREQ = { 'Daily': ['daily', 'most_days', 'several_weekly'], 'Most days': ['daily', 'most_days', 'several_weekly', 'weekly'], 'Weekends': ['weekly', 'occasional', 'several_weekly'], 'Evenings': ALL_FREQ, 'Flexible': ALL_FREQ, 'Casual / whenever': ['weekly', 'occasional'] };
  const KICKOFF_MS = 6 * 3600 * 1000;
  const APP_LABEL = { new: 'Sent', shortlisted: 'Shortlisted', invited: 'Invited in game', joined: 'Joined', declined: 'Declined', withdrawn: 'Withdrawn' };
  const same = (a, b) => String(a || '').toLowerCase() === String(b || '').toLowerCase();
  const safeStore = { get(k) { try { return localStorage.getItem(k) || ''; } catch { return ''; } }, set(k, v) { try { localStorage.setItem(k, v); } catch { /* private mode */ } } };

  const state = {
    signedIn: false, loadedPersonal: false, account: null, profile: null, suggested: {},
    leagues: [], spotlight: [], ownListings: [], ownerCrew: [], crewReady: false, myCrew: null, myApplications: [], ownerApps: null, newApplications: 0,
    inboxThreads: [], inboxMessages: [], activeConversationId: null, inboxLoading: false, savedCount: 0,
    canFindPlayers: false, remaining: 3, players: [], revealed: new Map(), editingId: null, tab: 'leagues', view: 'board',
    filters: { q: '', division: '', region: '', freq: '', size: '', lang: '', commit: '', join: '', verified: false, spots: false, ovr: 0 }, sort: 'active'
  };

  // ───────────── matching ─────────────
  function matchFor(r) {
    const p = state.profile; if (!p) return null;
    const reasons = [], gaps = []; let score = 0;
    const ovr = Number(p.ovr || 0); const qualifies = ovr >= r.minOvr;
    if (qualifies) score += 35; else gaps.push('Needs ' + (r.minOvr - ovr) + ' more OVR');
    if (same(p.region_server, r.regionServer)) score += 20;
    if ((r.preferredLanguages || []).some(l => (p.preferred_languages || []).includes(l))) score += 15;
    const sizes = p.tournament_sizes || [];
    if (!sizes.length) score += 8; else if ((r.tournamentSizes || []).some(s => sizes.includes(s))) score += 15;
    if (!p.play_style) score += 5; else if ((STYLE_COMMIT[p.play_style] || []).includes(r.playerCommitment)) score += 10;
    if (!p.availability) score += 3; else if ((AVAIL_FREQ[p.availability] || ALL_FREQ).includes(r.tournamentFrequency)) score += 5;
    score = Math.max(0, Math.min(100, score));
    return { score, qualifies, gaps, tone: !qualifies ? 'low' : score >= 80 ? 'great' : score >= 60 ? 'good' : 'low', label: !qualifies ? 'Below minimum OVR' : score >= 80 ? 'Great fit' : score >= 60 ? 'Good fit' : 'Partial fit' };
  }

  // ───────────── filter + sort ─────────────
  const recency = (r) => ts(r.lastActiveAt) || ts(r.createdAt);
  const realFirst = (fn) => (a, b) => (Number(a.isSample) - Number(b.isSample)) || fn(a, b);
  const SORTERS = {
    match: realFirst((a, b) => (b._m?.score || 0) - (a._m?.score || 0) || recency(b) - recency(a)),
    active: realFirst((a, b) => Number(b.kickoffActive) - Number(a.kickoffActive) || b.activityScore - a.activityScore || recency(b) - recency(a)),
    newest: realFirst((a, b) => ts(b.createdAt) - ts(a.createdAt)),
    spots: realFirst((a, b) => b.openSpots - a.openSpots || recency(b) - recency(a)),
    ovr: realFirst((a, b) => a.minOvr - b.minOvr || recency(b) - recency(a))
  };
  function passes(r, f) {
    const q = f.q.trim().toLowerCase();
    if (q && ![r.name, r.tagline, r.regionServer, r.slug, (r.preferredLanguages || []).join(' ')].join(' ').toLowerCase().includes(q)) return false;
    if (f.division && r.division !== f.division) return false;
    if (f.region && r.regionServer !== f.region) return false;
    if (f.freq && r.tournamentFrequency !== f.freq) return false;
    if (f.size && !(r.tournamentSizes || []).includes(f.size)) return false;
    if (f.lang && !(r.preferredLanguages || []).includes(f.lang)) return false;
    if (f.commit && r.playerCommitment !== f.commit) return false;
    if (f.join && !(r.joinMethods || []).includes(f.join)) return false;
    if (f.verified && !r.verified) return false;
    if (f.spots && r.openSpots <= 0) return false;
    if (f.ovr && r.minOvr > f.ovr) return false;
    return true;
  }
  const withMatch = () => state.leagues.map(r => ({ ...r, _m: matchFor(r) }));
  const visible = () => withMatch().filter(r => passes(r, state.filters)).sort(SORTERS[state.sort] || SORTERS.active);
  const moreFilterCount = () => ['freq', 'size', 'lang', 'commit', 'join'].filter(k => state.filters[k]).length + (state.filters.verified ? 1 : 0);
  const myOvr = () => state.filters.ovr || Number(state.profile?.ovr || 0);

  // ───────────── static setup ─────────────
  function buildOptions() {
    const opt = (v, l) => '<option value="' + esc(v) + '">' + esc(l == null ? v : l) + '</option>';
    $('#fRegion').innerHTML = opt('', 'All regions') + REGIONS.map(r => opt(r)).join('');
    $('#pRegion').innerHTML = opt('', 'All regions') + REGIONS.map(r => opt(r)).join('');
    $('#fLang').innerHTML = opt('', 'Any language') + LANGS.map(r => opt(r)).join('');
    $('#pLang').innerHTML = opt('', 'Any language') + LANGS.map(r => opt(r)).join('');
    setSortOptions();
  }
  function setSortOptions() {
    const sel = $('#fSort'); const keep = state.sort;
    sel.innerHTML = (state.profile ? '<option value="match">Best match</option>' : '') +
      '<option value="active">Most active</option><option value="newest">Newest</option><option value="spots">Most open spots</option><option value="ovr">Lowest OVR needed</option>';
    if (!state.profile && keep === 'match') state.sort = 'active';
    sel.value = state.sort;
  }

  // ───────────── render: hero + tabs ─────────────
  function renderHero() {
    const real = state.leagues.filter(r => !r.isSample);
    $('#statLeagues').textContent = fmt(real.length);
    $('#statSpots').textContent = fmt(real.reduce((n, r) => n + Number(r.openSpots || 0), 0));
    $('#statRegions').textContent = fmt(new Set(real.map(r => r.regionServer)).size);
    const me = $('#lgMe'), p = state.profile;
    if (!state.signedIn) { me.hidden = true; $('#lgListCta').textContent = 'List your league'; return; }
    me.hidden = false;
    me.innerHTML = p
      ? crest(p.avatar_url || state.account?.avatarUrl, state.account?.displayName || p.in_game_username, 'lg-avatar') + '<div class="lg-me-txt"><b>' + esc(p.in_game_username) + '</b><small>OVR ' + fmt(p.ovr) + ' · ' + esc(p.region_server) + '</small></div><button class="lg-btn lg-btn-outline lg-btn-sm" id="lgEditProfile" type="button">Edit card</button>'
      : '<div class="lg-me-txt"><b>' + esc(state.account?.displayName || 'Signed in') + '</b><small>Add your OVR to see your best matches</small></div><button class="lg-btn lg-btn-primary lg-btn-sm" id="lgEditProfile" type="button">Add player card</button>';
    $('#lgListCta').textContent = state.ownListings[0] && state.ownListings[0].status !== 'removed' ? 'Manage my league' : 'List your league';
  }
  function tabList() {
    const unread = state.inboxThreads.reduce((n, t) => n + Number(t.unreadCount || 0), 0);
    const tabs = [{ id: 'leagues', label: 'Leagues' }, { id: 'spotlight', label: 'Spotlight' },
      { id: 'inbox', label: 'Inbox', count: unread }];
    if (!state.signedIn) return tabs;
    tabs.push({ id: 'saved', label: 'Saved', count: state.savedCount || state.leagues.filter(r => r.saved).length });
    tabs.push({ id: 'apps', label: 'My applications', count: state.myApplications.filter(a => a.status !== 'withdrawn').length });
    if (state.canFindPlayers) tabs.push({ id: 'players', label: 'Find players' });
    const hasOwn = state.ownListings[0] && state.ownListings[0].status !== 'removed';
    tabs.push({ id: 'owner', label: hasOwn ? 'My league' : 'List a league', badge: state.newApplications });
    return tabs;
  }
  function renderTabs() {
    const tabs = tabList(); const nav = $('#lgTabs');
    nav.hidden = tabs.length < 2;
    if (!tabs.some(t => t.id === state.tab)) state.tab = 'leagues';
