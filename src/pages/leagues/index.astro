</style>

<script>
  import { accountAuth } from '../../lib/account-client.js';

  // ───────────── constants ─────────────
  const REGIONS = ['Asia', 'Europe', 'North America', 'South America', 'Africa', 'Middle East', 'Other'];
  const LANGS = ['English', 'Bengali', 'Indonesian', 'Arabic', 'Spanish', 'French', 'Portuguese', 'Other'];
  const SIZES = ['4v4', '8v8', '16v16', '32v32'];
  const STYLES = ['Competitive', 'Active and relaxed', 'Casual', 'Quest focused', 'Building a new team'];
  const AVAIL = ['Daily', 'Most days', 'Weekends', 'Evenings', 'Flexible', 'Casual / whenever'];
  const FREQ = { daily: 'Daily', most_days: 'Most days', several_weekly: 'Several times a week', weekly: 'Weekly', occasional: 'Occasional' };
  const COMMIT = { casual: 'Casual', regular: 'Regular play', competitive: 'Competitive' };
  const STATUS = { looking_for_league: 'Looking for a league', in_a_league: 'In a league', league_owner: 'League owner', not_looking: 'Just browsing' };
  const REASONS = [['fake_or_misleading', 'Fake or misleading details'], ['inactive', 'League looks inactive'], ['inappropriate', 'Inappropriate content'], ['spam', 'Spam or advertising'], ['other', 'Something else']];
  const STYLE_COMMIT = { 'Competitive': ['competitive'], 'Active and relaxed': ['regular'], 'Casual': ['casual'], 'Quest focused': ['casual', 'regular'], 'Building a new team': ['casual', 'regular', 'competitive'] };
  const ALL_FREQ = ['daily', 'most_days', 'several_weekly', 'weekly', 'occasional'];
  const AVAIL_FREQ = {
    'Daily': ['daily', 'most_days', 'several_weekly'], 'Most days': ['daily', 'most_days', 'several_weekly', 'weekly'],
    'Weekends': ['weekly', 'occasional', 'several_weekly'], 'Evenings': ALL_FREQ, 'Flexible': ALL_FREQ, 'Casual / whenever': ['weekly', 'occasional']
  };
  const KICKOFF_MS = 6 * 60 * 60 * 1000;
  const ICON = {
    check: '<svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>',
    heart: '<svg viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.4-9.3C1.3 7.9 3.3 4.5 6.7 4.5c2 0 3.6 1.1 5.3 3 1.7-1.9 3.3-3 5.3-3 3.4 0 5.4 3.4 4.1 6.7-1.9 4.7-9.4 9.3-9.4 9.3Z"/></svg>'
  };

  // ───────────── helpers ─────────────
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const fmt = (v) => Number(v || 0).toLocaleString();
  const initials = (v) => String(v || 'FC').trim().split(/\s+/).slice(0, 2).map(p => p[0] || '').join('').toUpperCase() || 'FC';
  const same = (a, b) => String(a || '').toLowerCase() === String(b || '').toLowerCase();
  const freqLabel = (v) => FREQ[v] || 'Schedule varies';
  const commitLabel = (v) => COMMIT[v] || 'Regular play';
  const ts = (iso) => { const n = Date.parse(iso || ''); return Number.isFinite(n) ? n : 0; };

  function timeAgo(iso) {
    const t = ts(iso); if (!t) return '';
    const s = Math.max(0, Math.round((Date.now() - t) / 1000));
    if (s < 90) return 'just now';
    if (s < 3600) return Math.round(s / 60) + ' min ago';
    if (s < 86400) return Math.round(s / 3600) + ' h ago';
    const d = Math.round(s / 86400);
    return d === 1 ? 'yesterday' : d < 30 ? d + ' days ago' : new Date(t).toLocaleDateString();
  }
  function clock(ms) {
    const s = Math.max(0, Math.ceil(ms / 1000));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
    return (h ? h + 'h ' : '') + String(m).padStart(h ? 2 : 1, '0') + 'm ' + String(x).padStart(2, '0') + 's';
  }
  function toast(message, error = false) {
    const node = $('#lgToast'); node.textContent = message; node.classList.toggle('error', error); node.classList.add('show');
    clearTimeout(toast.t); toast.t = setTimeout(() => node.classList.remove('show'), 4200);
  }
  function msg(sel, text, kind) { const n = $(sel); if (!n) return; n.textContent = text || ''; n.classList.toggle('ok', kind === 'ok'); }
  async function copyText(text, label) {
    try { await navigator.clipboard.writeText(text); toast((label || 'Text') + ' copied.'); }
    catch { toast('Copy failed. ' + text, true); }
  }
  const selectedValues = (form, name) => $$('input[name="' + name + '"]:checked', form).map(i => i.value);
  const setChecks = (form, name, values) => { const list = Array.isArray(values) ? values : []; $$('input[name="' + name + '"]', form).forEach(i => { i.checked = list.includes(i.value); }); };

  // ───────────── state ─────────────
  const state = {
    view: 'loading', tab: 'leagues', account: null, profile: null, premiumReady: true,
    leagues: [], ownListings: [], insights: null, players: [], revealed: new Map(),
    canFindPlayers: false, remaining: 3, editingId: null, detailId: null, reportId: null,
    filters: { q: '', region: '', freq: '', size: '', lang: '', commit: '', qualify: true, verified: false },
    sort: 'match', busy: new Set(), lastFocus: null
  };

  async function token() {
    const r = await accountAuth.auth.getSession();
    return r.data?.session?.access_token || '';
  }
  async function api(path, options = {}) {
    const accessToken = await token();
    const headers = new Headers(options.headers || {});
    if (accessToken) headers.set('authorization', 'Bearer ' + accessToken);
    if (options.body && !(options.body instanceof FormData) && !headers.has('content-type')) headers.set('content-type', 'application/json');
    const res = await fetch(path, { ...options, headers, credentials: 'same-origin', cache: 'no-store' });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) { const e = new Error(body.error || 'Something went wrong. Please try again.'); e.status = res.status; e.body = body; throw e; }
    return body;
  }

  // ───────────── view switching ─────────────
  const VIEWS = { gate: '#lgGate', loading: '#lgLoading', error: '#lgError', profile: '#lgProfile', workspace: '#lgWorkspace', editor: '#lgEditor' };
  function showView(name, { scroll = false } = {}) {
    state.view = name;
    for (const [key, sel] of Object.entries(VIEWS)) $(sel).hidden = key !== name;
    $('#lgHero').hidden = name === 'editor' || name === 'profile';
    $('#lgStats').hidden = name !== 'workspace';
    $('#lgMe').hidden = name !== 'workspace' || !state.profile;
    if (name !== 'workspace') closeDrawer();
    if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ───────────── matching ─────────────
  function matchFor(r) {
    const p = state.profile;
    if (!p) return null;
    const reasons = [], gaps = [];
    let score = 0;
    const ovr = Number(p.ovr || 0);
    const qualifies = ovr >= r.minOvr;
    if (qualifies) { score += 35; reasons.push('Your ' + ovr + ' OVR clears the ' + r.minOvr + '+ minimum'); }
    else gaps.push('You need ' + (r.minOvr - ovr) + ' more OVR to meet the ' + r.minOvr + '+ minimum');
    if (same(p.region_server, r.regionServer)) { score += 20; reasons.push('Same region (' + r.regionServer + ')'); }
    else gaps.push('Different region (' + r.regionServer + ')');
    const common = (r.preferredLanguages || []).filter(l => (p.preferred_languages || []).includes(l));
    if (common.length) { score += 15; reasons.push('You share ' + common.slice(0, 2).join(' / ')); } else gaps.push('No shared language');
    const sizes = p.tournament_sizes || [];
    if (!sizes.length) score += 8;
    else {
      const c = (r.tournamentSizes || []).filter(s => sizes.includes(s));
      if (c.length) { score += 15; reasons.push('Runs ' + c.join(', ') + ' tournaments you play'); } else gaps.push('Different tournament sizes');
    }
    if (!p.play_style) score += 5;
    else if ((STYLE_COMMIT[p.play_style] || []).includes(r.playerCommitment)) { score += 10; reasons.push('Play style fits a ' + commitLabel(r.playerCommitment).toLowerCase() + ' club'); }
    else gaps.push('Play style differs from the club culture');
    if (!p.availability) score += 3;
    else if ((AVAIL_FREQ[p.availability] || ALL_FREQ).includes(r.tournamentFrequency)) { score += 5; reasons.push('Schedule matches your availability'); }
    else gaps.push('Tournament rhythm may not match your availability');
    score = Math.max(0, Math.min(100, score));
    const tone = !qualifies ? 'low' : score >= 80 ? 'great' : score >= 60 ? 'good' : 'low';
    const label = !qualifies ? 'Below minimum OVR' : score >= 80 ? 'Great fit' : score >= 60 ? 'Good fit' : 'Partial fit';
    return { score, reasons, gaps, qualifies, tone, label };
  }

  // ───────────── filtering / sorting ─────────────
  const recency = (r) => ts(r.lastActiveAt) || ts(r.createdAt);
  const SORTERS = {
    match: (a, b) => b._m.score - a._m.score || recency(b) - recency(a),
    active: (a, b) => (Number(b.kickoffActive) - Number(a.kickoffActive)) || (b.kickoffActive ? ts(b.lastKickoffAt) - ts(a.lastKickoffAt) : recency(b) - recency(a)),
    newest: (a, b) => ts(b.createdAt) - ts(a.createdAt),
    spots: (a, b) => b.openSpots - a.openSpots || recency(b) - recency(a),
    ovr: (a, b) => a.minOvr - b.minOvr || recency(b) - recency(a)
  };
  function passes(r, f, ignoreQualify = false) {
    const q = f.q.trim().toLowerCase();
    if (q) {
      const hay = [r.name, r.tagline, r.description, r.regionServer, r.leagueGameId, (r.preferredLanguages || []).join(' '), r.owner?.displayName].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    if (f.region && r.regionServer !== f.region) return false;
    if (f.freq && r.tournamentFrequency !== f.freq) return false;
    if (f.size && !(r.tournamentSizes || []).includes(f.size)) return false;
    if (f.lang && !(r.preferredLanguages || []).includes(f.lang)) return false;
    if (f.commit && r.playerCommitment !== f.commit) return false;
    if (f.verified && !r.verified) return false;
    if (!ignoreQualify && f.qualify && state.profile && !r.isMine && r.minOvr > Number(state.profile.ovr || 0)) return false;
    return true;
  }
  function visibleLeagues() {
    const withMatch = state.leagues.map(r => ({ ...r, _m: matchFor(r) || { score: 0, reasons: [], gaps: [], qualifies: true, tone: 'good', label: '' } }));
    const rows = withMatch.filter(r => passes(r, state.filters)).sort(SORTERS[state.sort] || SORTERS.match);
    const hiddenByOvr = state.filters.qualify
      ? withMatch.filter(r => passes(r, state.filters, true) && !passes(r, state.filters)).length : 0;
    return { rows, hiddenByOvr };
  }
  function activeFilterCount() {
    const f = state.filters;
    return ['region', 'freq', 'size', 'lang', 'commit'].filter(k => f[k]).length + (f.verified ? 1 : 0) + (f.qualify ? 0 : 1);
  }

  // ───────────── markup builders ─────────────
  function crest(url, name, cls) {
    return '<div class="' + cls + '"><span>' + esc(initials(name)) + '</span>' +
      (url ? '<img src="' + esc(url) + '" alt="" loading="lazy" referrerpolicy="no-referrer">' : '') + '</div>';
  }
  function ring(m, small = true) {
    return '<div class="lg-ring ' + m.tone + '" style="--p:' + m.score + '" title="' + esc(m.label) + '"><b>' + m.score + '</b>' + (small ? '<small>match</small>' : '') + '</div>';
  }
  function signalLine(r) {
    if (r.confirmations7d > 0) return '<i class="hot"></i><span>' + r.confirmations7d + ' player' + (r.confirmations7d === 1 ? '' : 's') + ' confirmed active this week</span>';
    if (r.lastActiveAt) return '<i></i><span>Last confirmed ' + esc(timeAgo(r.lastActiveAt)) + '</span>';
    return '<i></i><span>Listed ' + esc(timeAgo(r.createdAt) || 'recently') + '</span>';
  }
  function leagueCard(r, opts = {}) {
    const m = r._m || matchFor(r);
    const preview = Boolean(opts.preview);
    const showRing = m && !preview && !r.isMine;
    const badges = [];
    if (r.featured) badges.push('<span class="lg-badge gold">★ Featured</span>');
    if (r.kickoffActive) badges.push('<span class="lg-badge cyan"><i class="lg-pulse"></i> Kickoff</span>');
    if (r.isMine) badges.push('<span class="lg-badge mint">Your league</span>');
    if (m && !m.qualifies && !r.isMine && !preview) badges.push('<span class="lg-badge amber">Needs ' + r.minOvr + '+ OVR</span>');
    if (r.discordRequired) badges.push('<span class="lg-badge">Discord required</span>');
    const sizes = (r.tournamentSizes || []).map(s => '<span class="lg-tag cyan">' + esc(s) + '</span>').join('');
    const langs = (r.preferredLanguages || []).slice(0, 3).map(l => '<span class="lg-tag">' + esc(l) + '</span>').join('');
    const saveBtn = (preview || r.isMine) ? '' :
      '<button type="button" class="lg-icon-btn' + (r.saved ? ' on' : '') + '" data-save="' + esc(r.id) + '" aria-pressed="' + (r.saved ? 'true' : 'false') + '" aria-label="' + (r.saved ? 'Remove from shortlist' : 'Save league') + '">' + ICON.heart + '</button>';
    const action = preview ? '' : '<button type="button" class="lg-btn lg-btn-primary lg-btn-sm" data-open="' + esc(r.id) + '">View league</button>';
    return '<article class="lg-card' + (r.featured ? ' is-featured' : '') + (preview ? ' is-preview' : '') + '"' + (preview ? '' : ' data-card="' + esc(r.id) + '"') + ' style="animation-delay:' + Math.min((opts.index || 0) * 40, 240) + 'ms">' +
      '<div class="lg-card-glow"></div><div class="lg-card-in">' +
      '<div class="lg-card-top">' + crest(r.logoUrl, r.name, 'lg-crest') +
      '<div class="lg-card-id"><h3>' + esc(r.name || 'Your league name') + (r.verified ? ' <span class="lg-verified" title="Verified by FCMobiletools">' + ICON.check + '</span>' : '') + '</h3>' +
      '<div class="lg-card-sub"><span>' + esc(r.regionServer || 'Region') + '</span><i class="lg-dotsep"></i><span>' + fmt(r.openSpots) + ' spot' + (Number(r.openSpots) === 1 ? '' : 's') + ' open</span></div></div>' +
      (showRing ? ring(m) : '') + '</div>' +
      (badges.length ? '<div class="lg-badges">' + badges.join('') + '</div>' : '') +
      '<p class="lg-tagline">' + esc(r.tagline || r.description || 'Your league description will appear here.') + '</p>' +
      '<div class="lg-tags">' + sizes + langs + '</div>' +
      '<div class="lg-stat-row"><div><span>Min OVR</span><strong>' + fmt(r.minOvr) + '+</strong></div><div><span>Rhythm</span><strong>' + esc(freqLabel(r.tournamentFrequency)) + '</strong></div><div><span>Culture</span><strong>' + esc(commitLabel(r.playerCommitment)) + '</strong></div></div>' +
      '<div class="lg-card-foot"><div class="lg-signal">' + (preview ? '<i></i><span>Preview</span>' : signalLine(r)) + '</div><div class="lg-card-actions">' + saveBtn + action + '</div></div>' +
      '</div></article>';
  }
  function playerCard(row, { preview = false, index = 0 } = {}) {
    const tags = (row.tournamentSizes || []).map(s => '<span class="lg-tag cyan">' + esc(s) + '</span>').join('') +
      (row.preferredLanguages || []).slice(0, 2).map(l => '<span class="lg-tag">' + esc(l) + '</span>').join('');
    const rev = state.revealed.get(row.accountId);
    const copyRow = (label, value) => '<dt>' + label + '</dt><dd>' + esc(value || 'Not provided') + '</dd>' +
      (value ? '<button type="button" class="lg-copy" data-copy="' + esc(value) + '" data-label="' + label + '">Copy</button>' : '<span></span>');
    const panel = rev ? '<div class="lg-revealed"><h4>Contact details</h4><dl class="lg-kv">' + copyRow('UID', rev.fcMobileUid) + copyRow('In-game', rev.inGameUsername) + copyRow('Discord', rev.discordHandle) + '<dt>Region</dt><dd>' + esc(rev.regionServer) + '</dd><span></span></dl></div>' : '';
    const unlocked = rev || row.revealed;
    const btn = preview ? '' : '<button type="button" class="lg-btn ' + (unlocked ? 'lg-btn-outline' : 'lg-btn-primary') + ' lg-btn-sm" data-reveal="' + esc(row.accountId) + '"' + (!unlocked && state.remaining <= 0 ? ' disabled' : '') + '>' +
      (rev ? 'Contact unlocked' : unlocked ? 'View contact · already unlocked' : state.remaining <= 0 ? 'Daily limit reached' : 'Unlock contact · uses 1 of ' + state.remaining + ' left') + '</button>';
    return '<article class="lg-pcard" style="animation-delay:' + Math.min(index * 30, 180) + 'ms"><div class="lg-pcard-head">' +
      crest(row.avatarUrl, row.displayName, 'lg-avatar') +
      '<div class="lg-pcard-id"><h3>' + esc(row.displayName) + '</h3><p>' + (row.username ? '@' + esc(row.username) + ' · ' : '') + esc(row.regionServer || '') + '</p></div>' +
      '<div class="lg-ovr">' + fmt(row.ovr) + '</div></div>' +
      '<div class="lg-tags">' + tags + '</div>' +
      '<p class="lg-pcard-note">' + esc(row.availability || 'Availability not specified') + (row.playStyle ? ' · ' + esc(row.playStyle) : '') + '</p>' +
      (row.notes ? '<p class="lg-pcard-note">' + esc(row.notes) + '</p>' : '') + btn + panel + '</article>';
  }

  // ───────────── hero + tabs ─────────────
  function renderHero() {
    const rows = state.leagues;
    $('#statLeagues').textContent = fmt(rows.length);
    $('#statSpots').textContent = fmt(rows.reduce((n, r) => n + Number(r.openSpots || 0), 0));
    $('#statRegions').textContent = fmt(new Set(rows.map(r => r.regionServer)).size);
    const p = state.profile, me = $('#lgMe');
    if (!p) { me.innerHTML = ''; return; }
    me.innerHTML = crest(p.avatar_url || state.account?.avatarUrl, state.account?.displayName || p.in_game_username, 'lg-avatar') +
      '<div class="lg-me-txt"><b>' + esc(p.in_game_username) + '</b><small>OVR ' + fmt(p.ovr) + ' · ' + esc(STATUS[p.status] || '') + '</small></div>' +
      '<button class="lg-btn lg-btn-outline lg-btn-sm" id="lgEditProfile" type="button">Edit</button>';
    me.hidden = state.view !== 'workspace';
  }
  function tabList() {
    const savedN = state.leagues.filter(r => r.saved).length;
    const tabs = [{ id: 'leagues', label: 'Leagues', count: state.leagues.length }, { id: 'saved', label: 'Saved', count: savedN }];
    if (state.canFindPlayers) tabs.push({ id: 'players', label: 'Find players' });
    if (state.profile?.status === 'league_owner') {
      const own = state.ownListings[0];
      const dot = own ? (own.status === 'approved' ? 'live' : (own.status === 'pending' || own.status === 'rejected' || own.status === 'paused') ? 'warn' : '') : '';
      tabs.push({ id: 'owner', label: 'Owner desk', dot });
    }
    return tabs;
  }
  function renderTabs() {
    const tabs = tabList();
    if (!tabs.some(t => t.id === state.tab)) state.tab = 'leagues';
    $('#lgTabs').innerHTML = tabs.map(t =>
      '<button class="lg-tab' + (t.id === state.tab ? ' active' : '') + '" role="tab" type="button" data-tab="' + t.id + '" aria-selected="' + (t.id === state.tab) + '">' + esc(t.label) +
      (t.count !== undefined ? '<em>' + fmt(t.count) + '</em>' : '') + (t.dot !== undefined && t.dot !== '' ? '<span class="lg-dot ' + t.dot + '"></span>' : t.dot === '' && t.id === 'owner' ? '' : '') + '</button>').join('');
    for (const [id, sel] of [['leagues', '#panelLeagues'], ['saved', '#panelSaved'], ['players', '#panelPlayers'], ['owner', '#panelOwner']]) $(sel).hidden = id !== state.tab;
  }
  function setTab(id) {
    state.tab = id; renderTabs();
    if (id === 'leagues') renderLeagues();
    if (id === 'saved') renderSaved();
    if (id === 'owner') renderOwner();
    if (id === 'players') loadPlayers();
  }

  // ───────────── leagues panel ─────────────
  function renderLeagues() {
    const { rows, hiddenByOvr } = visibleLeagues();
    const featured = rows.filter(r => r.featured);
    const rest = featured.length ? rows.filter(r => !r.featured) : rows;
    const total = state.leagues.length;
    $('#lgFeatured').hidden = featured.length === 0;
    $('#lgRail').innerHTML = featured.map((r, i) => leagueCard(r, { index: i })).join('');
    $('#lgGrid').innerHTML = rest.map((r, i) => leagueCard(r, { index: i })).join('');
    $('#lgGrid').hidden = rest.length === 0;
    $('#lgEmpty').hidden = rows.length > 0;
    $('#lgResults').textContent = !total ? 'No leagues are live yet.' : rows.length + (rows.length === 1 ? ' league' : ' leagues') + (activeFilterCount() || state.filters.q || state.filters.qualify ? ' match your filters' : ' live now');
    const showAll = $('#fShowAll'); showAll.hidden = hiddenByOvr === 0;
    showAll.textContent = 'Show ' + hiddenByOvr + ' above my OVR';
    const count = activeFilterCount(); const badge = $('#fCount'); badge.hidden = count === 0; badge.textContent = count;
    if (!total) {
      $('#lgEmpty h3').textContent = 'No leagues are live yet.';
      $('#lgEmpty p').textContent = 'Be the first. Set your profile to League owner and submit your club.';
    } else {
      $('#lgEmpty h3').textContent = 'No leagues match these filters.';
      $('#lgEmpty p').textContent = 'Try widening the region or OVR filter, or help the board grow by listing your own club.';
    }
  }
  function renderSaved() {
    const rows = state.leagues.filter(r => r.saved).map(r => ({ ...r, _m: matchFor(r) })).sort((a, b) => b._m.score - a._m.score);
    $('#lgSavedGrid').innerHTML = rows.map((r, i) => leagueCard(r, { index: i })).join('');
    $('#lgSavedGrid').hidden = rows.length === 0; $('#lgSavedEmpty').hidden = rows.length > 0;
  }
  function refreshLeagueSurfaces() {
    renderHero(); renderTabs(); renderLeagues(); renderSaved(); if (state.tab === 'owner') renderOwner();
    if (state.detailId) renderDrawer(true);
  }

  // ───────────── drawer ─────────────
  function findLeague(id) { return state.leagues.find(r => r.id === id); }
  function drawerHtml(r) {
    const m = matchFor(r);
    const trust = r.confirmations7d > 0
      ? '<div class="lg-trust"><i></i><div><b>' + r.confirmations7d + ' player' + (r.confirmations7d === 1 ? '' : 's') + ' confirmed this league is active this week</b><small>' + (r.lastActiveAt ? 'Last confirmation ' + esc(timeAgo(r.lastActiveAt)) : '') + '</small></div></div>'
      : '<div class="lg-trust cold"><i></i><div><b>No activity confirmations this week</b><small>' + (r.lastActiveAt ? 'Last confirmed ' + esc(timeAgo(r.lastActiveAt)) : 'Be the first to confirm it after you visit') + '</small></div></div>';
    const matchBlock = m && !r.isMine ? '<div class="lg-d-sec"><h4>Your match</h4><div class="lg-match">' + ring(m, false) + '<div><h5>' + esc(m.label) + '</h5><p>Based on your OVR, region, languages, play style and schedule.</p></div></div>' +
      '<ul class="lg-why">' + m.reasons.map(x => '<li>' + esc(x) + '</li>').join('') + m.gaps.map(x => '<li class="gap">' + esc(x) + '</li>').join('') + '</ul></div>' : '';
    const grid = [
      ['Region', r.regionServer], ['Minimum OVR', fmt(r.minOvr) + '+'], ['Tournament rhythm', freqLabel(r.tournamentFrequency)], ['Culture', commitLabel(r.playerCommitment)],
      ['Tournament sizes', (r.tournamentSizes || []).join(', ') || '–'], ['Languages', (r.preferredLanguages || []).join(', ') || 'English'],
      ['Active hours', r.activeHours || 'Not specified'], ['Open spots', fmt(r.openSpots)], ['Discord', r.discordRequired ? 'Required to join' : 'Optional'], ['League ID', r.leagueGameId || 'Not shared']
    ].map(([k, v]) => '<div><span>' + k + '</span><strong>' + esc(v) + '</strong></div>').join('');
    const join = r.discordInviteUrl
      ? '<a class="lg-btn lg-btn-primary" data-join="' + esc(r.id) + '" href="' + esc(r.discordInviteUrl) + '" target="_blank" rel="noopener noreferrer">Join on Discord ↗</a>'
      : r.contactDiscord ? '' : '<span class="lg-note" style="flex:1">No public contact yet. Save it and check back.</span>';
    const contact = r.contactDiscord ? '<button class="lg-btn lg-btn-outline" data-contact="' + esc(r.contactDiscord) + '" type="button">Copy Discord ' + esc(r.contactDiscord) + '</button>' : '';
    const own = r.isMine;
    const bar = '<div class="lg-d-bar">' + join + contact +
      (own ? '<span class="lg-note" style="flex:1">This is your league. Manage it from the Owner desk.</span>' :
        '<button type="button" class="lg-icon-btn' + (r.saved ? ' on' : '') + '" data-save="' + esc(r.id) + '" aria-pressed="' + (r.saved ? 'true' : 'false') + '" aria-label="' + (r.saved ? 'Remove from shortlist' : 'Save league') + '">' + ICON.heart + '</button>') + '</div>';
    return '<div class="lg-d-hero' + (r.featured ? ' is-featured' : '') + '"><div class="lg-d-id">' + crest(r.logoUrl, r.name, 'lg-crest') +
      '<div><h2>' + esc(r.name) + (r.verified ? ' <span class="lg-verified" title="Verified by FCMobiletools">' + ICON.check + '</span>' : '') + '</h2><p>' + esc(r.regionServer) + ' · ' + fmt(r.openSpots) + ' open spot' + (Number(r.openSpots) === 1 ? '' : 's') + '</p></div></div>' +
      '<div class="lg-badges">' + (r.featured ? '<span class="lg-badge gold">★ Featured</span>' : '') + (r.verified ? '<span class="lg-badge cyan">Verified</span>' : '') + (r.kickoffActive ? '<span class="lg-badge cyan"><i class="lg-pulse"></i> Kickoff</span>' : '') + (r.isMine ? '<span class="lg-badge mint">Your league</span>' : '') + '</div>' +
      (r.tagline ? '<p class="lg-tagline" style="-webkit-line-clamp:unset">' + esc(r.tagline) + '</p>' : '') + '</div>' +
      matchBlock +
      '<div class="lg-d-sec"><h4>About</h4><p class="lg-d-desc">' + esc(r.description) + '</p></div>' +
      '<div class="lg-d-sec"><h4>League details</h4><div class="lg-d-grid">' + grid + '</div></div>' +
      (r.weeklyRewards ? '<div class="lg-d-sec"><h4>Rewards &amp; perks</h4><p class="lg-d-desc">' + esc(r.weeklyRewards) + '</p></div>' : '') +
      '<div class="lg-d-sec"><h4>Activity</h4>' + trust +
      (!own ? '<div class="lg-actions"><button class="lg-btn lg-btn-outline lg-btn-sm" data-confirm="' + esc(r.id) + '" type="button"' + (r.confirmedByMe ? ' disabled' : '') + '>' + (r.confirmedByMe ? 'Confirmed · try again in 24h' : 'Confirm this league is active') + '</button></div>' : '') + '</div>' +
      '<div class="lg-d-sec"><h4>Managed by</h4><div class="lg-owner-row">' + crest(r.owner?.avatarUrl, r.owner?.displayName, 'lg-avatar') + '<span>' + esc(r.owner?.displayName || 'FC Mobile player') + '</span></div>' +
      (!own ? '<div class="lg-d-links"><button class="lg-link" data-report="' + esc(r.id) + '" type="button">Report this league</button></div>' : '') + '</div>' + bar;
  }
  function renderDrawer(keepScroll = false) {
    const r = findLeague(state.detailId);
    if (!r) { closeDrawer(); return; }
    const body = $('#lgDrawerBody'); const top = body.scrollTop;
    body.innerHTML = drawerHtml(r);
    // the action bar must sit outside the scroll flow, so it lives inside the drawer container
    const bar = $('.lg-d-bar', body); if (bar) { $('#lgDrawer').querySelector('.lg-d-bar')?.remove(); $('#lgDrawer').appendChild(bar); }
    if (keepScroll) body.scrollTop = top;
  }
  function openDrawer(id) {
    if (!findLeague(id)) return;
    state.lastFocus = document.activeElement; state.detailId = id;
    $('#lgBackdrop').hidden = false; $('#lgDrawer').hidden = false; document.body.classList.add('lg-lock');
    renderDrawer(); $('#lgDrawerBody').scrollTop = 0; $('#lgDrawerClose').focus();
  }
  function closeDrawer() {
    if ($('#lgDrawer').hidden) return;
    state.detailId = null; $('#lgDrawer').hidden = true; $('#lgBackdrop').hidden = true; document.body.classList.remove('lg-lock');
    $('#lgDrawer').querySelector('.lg-d-bar')?.remove();
    if (state.lastFocus?.isConnected) state.lastFocus.focus();
  }

  // ───────────── actions: save / confirm / join / report ─────────────
  async function toggleSave(id) {
    const r = findLeague(id); const key = 'save' + id;
    if (!r || r.isMine || state.busy.has(key)) return;
    state.busy.add(key);
    const prev = r.saved; r.saved = !prev; r.saves = Math.max(0, r.saves + (r.saved ? 1 : -1)); refreshLeagueSurfaces();
    try {
      const res = await api('/api/leagues/listings/' + encodeURIComponent(id) + '/save', { method: 'POST', body: '{}' });
      if (res.saved !== r.saved) { r.saves = Math.max(0, r.saves + (res.saved ? 1 : -1)); r.saved = res.saved; }
      refreshLeagueSurfaces();
      toast(r.saved ? 'Saved to your shortlist.' : 'Removed from your shortlist.');
    } catch (error) {
      r.saved = prev; r.saves = Math.max(0, r.saves + (prev ? 1 : -1)); refreshLeagueSurfaces(); toast(error.message, true);
    } finally { state.busy.delete(key); }
  }
  async function confirmActive(id, button) {
    if (button) button.disabled = true;
    try {
      const res = await api('/api/leagues/listings/' + encodeURIComponent(id) + '/active', { method: 'POST', body: '{}' });
      const r = findLeague(id);
      if (r) { r.lastActiveAt = res.confirmedAt || new Date().toISOString(); r.confirmedByMe = true; r.confirmations7d = Math.max(Number(res.confirmationsLast7Days || 0), r.confirmations7d + 1); }
      refreshLeagueSurfaces(); toast('Thanks. That helps other players trust the board.');
    } catch (error) {
      toast(error.message, true); if (error.status === 429) { const r = findLeague(id); if (r) { r.confirmedByMe = true; refreshLeagueSurfaces(); } } else if (button) button.disabled = false;
    }
  }
  function trackJoin(id) { api('/api/leagues/listings/' + encodeURIComponent(id) + '/join', { method: 'POST', body: '{}' }).catch(() => {}); }
  function openReport(id) {
    state.reportId = id; $('#lgReportDetails').value = ''; msg('#lgReportMsg', ''); $('#lgReportReason').selectedIndex = 0;
    $('#lgReport').hidden = false; $('#lgReportReason').focus();
  }
  function closeReport() { $('#lgReport').hidden = true; state.reportId = null; }
  async function sendReport() {
    const btn = $('#lgReportSend'); btn.disabled = true; msg('#lgReportMsg', '');
    try {
      const res = await api('/api/leagues/listings/' + encodeURIComponent(state.reportId) + '/report', { method: 'POST', body: JSON.stringify({ reason: $('#lgReportReason').value, details: $('#lgReportDetails').value.trim() }) });
      closeReport(); toast(res.message || 'Thanks. The review team will take a look.');
    } catch (error) { msg('#lgReportMsg', error.message); } finally { btn.disabled = false; }
  }

  // ───────────── owner desk ─────────────
  function ownerSteps(row) {
    const s = row.status;
    const reviewState = s === 'pending' ? 'now' : s === 'rejected' ? 'warn' : s === 'paused' ? 'warn' : 'done';
    const liveState = s === 'approved' ? 'done' : 'todo';
    const reviewLabel = s === 'rejected' ? 'Changes requested' : s === 'paused' ? 'Paused' : 'Review';
    const mark = (st, n) => st === 'done' ? '✓' : st === 'warn' ? '!' : n;
    return '<div class="lg-steps"><div class="lg-step done"><i>✓</i>Submitted</div><div class="lg-step-line done"></div>' +
      '<div class="lg-step ' + reviewState + '"><i>' + mark(reviewState, 2) + '</i>' + reviewLabel + '</div>' +
      '<div class="lg-step-line ' + (liveState === 'done' ? 'done' : '') + '"></div>' +
      '<div class="lg-step ' + (liveState === 'done' ? 'done' : '') + '"><i>' + (liveState === 'done' ? '✓' : 3) + '</i>Live</div></div>';
  }
  function renderOwner() {
    const el = $('#panelOwner');
    const own = state.ownListings[0];
    const hasOpen = state.ownListings.some(r => ['pending', 'approved', 'paused'].includes(r.status));
    const head = '<div class="lg-panel-head slim"><div><h2>Owner desk</h2><p>Manage your club listing, boost it with Kickoff and see how players respond.</p></div></div>';
    if (!own || (!hasOpen && own.status === 'removed')) {
      el.innerHTML = head + '<div class="lg-box"><h3>Bring your club to the board.</h3><p>Every new listing is reviewed before it appears in search.</p>' +
        (own?.status === 'removed' ? '<div class="lg-callout red"><strong>Your previous listing was removed.</strong>' + esc(own.moderationNote || 'You can submit a new listing when your club is ready.') + '</div>' : '') +
        '<div class="lg-actions"><button class="lg-btn lg-btn-primary" data-create-listing type="button">Create league listing →</button></div></div>';
      return;
    }
    const live = own.status === 'approved';
    const nextAt = own.lastKickoffAt ? ts(own.lastKickoffAt) + KICKOFF_MS : 0;
    const cooling = nextAt > Date.now();
    let callout = '';
    if (own.status === 'pending') callout = '<div class="lg-callout cyan"><strong>Your listing is with the review team.</strong>You can keep browsing. We will update this page as soon as there is a decision.</div>';
    if (own.status === 'rejected') callout = '<div class="lg-callout"><strong>Changes requested</strong>' + esc(own.moderationNote || 'Please update your listing and resubmit it.') + '</div>';
    if (own.status === 'paused') callout = '<div class="lg-callout"><strong>Your listing is paused</strong>' + esc(own.moderationNote || 'The review team paused this listing.') + ' Update your details and resubmit to request a review.</div>';
    const ins = state.insights;
    const insights = live && ins ? '<div class="lg-insights"><div><strong>' + fmt(ins.joinClicks7d) + '</strong><span>Join clicks<br>last 7 days</span></div><div><strong>' + fmt(ins.saves) + '</strong><span>Players who<br>saved you</span></div><div><strong>' + fmt(ins.confirmations7d) + '</strong><span>Active confirmations<br>last 7 days</span></div></div>' : '';
    const canTune = own.status === 'approved' || own.status === 'pending';
    const controls = canTune ? '<div class="lg-box"><h3>Quick controls</h3><p class="lg-box-sub">These apply instantly and do not need a new review.</p>' +
      '<div class="lg-ctrl"><div><b>Open spots</b><small>How many players you can still take.</small></div><div class="lg-stepper"><button class="lg-icon-btn" data-spots="-1" type="button" aria-label="Fewer spots">−</button><output id="lgSpotsOut">' + fmt(own.openSpots) + '</output><button class="lg-icon-btn" data-spots="1" type="button" aria-label="More spots">+</button></div></div>' +
      '<div class="lg-ctrl"><div><b>Open for new members</b><small>Turn off to hide your league from the directory. Kickoff and player search also pause.</small></div><button class="lg-toggle" id="lgRecruitToggle" type="button" role="switch" aria-checked="' + own.recruitingOpen + '" aria-label="Open for new members"></button></div>' +
      (live ? '<div class="lg-ctrl"><div><b>Kickoff</b><small>' + (cooling ? 'Next Kickoff in <span class="lg-cd" data-until="' + nextAt + '">' + clock(nextAt - Date.now()) + '</span>' : 'Give your league a temporary boost to the top. Available every 6 hours.') + '</small></div>' +
        '<button class="lg-btn lg-btn-primary lg-btn-sm" id="lgKickoff" type="button"' + (cooling || !own.recruitingOpen ? ' disabled' : '') + '>↗ ' + (cooling ? 'Cooling down' : 'Kickoff') + '</button></div>' : '') + '</div>' : '';
    el.innerHTML = head + '<div class="lg-owner-grid"><div>' +
      '<div class="lg-box"><h3>Listing status</h3>' + ownerSteps(own) + callout + insights +
      '<div class="lg-actions">' + (own.status !== 'removed' ? '<button class="lg-btn lg-btn-outline" data-edit-listing type="button">Edit details</button>' : '') +
      (own.status === 'rejected' || own.status === 'paused' ? '<button class="lg-btn lg-btn-primary" data-edit-listing type="button">Edit &amp; resubmit</button>' : '') + '</div>' +
      (live ? '<p class="lg-box-sub" style="margin-top:12px">Editing your details sends the listing back for review. Spots and recruiting status do not.</p>' : '') + '</div>' + controls +
      '</div><div><div class="lg-preview-label">How players see you</div>' + leagueCard({ ...own, isMine: true, saved: false, _m: null }, { preview: true }) + '</div></div>';
  }
  async function quickUpdate(patch, button) {
    const own = state.ownListings[0]; if (!own) return;
    $$('#panelOwner [data-spots], #lgRecruitToggle').forEach(n => { n.disabled = true; });
    try {
      const res = await api('/api/leagues/listings/' + encodeURIComponent(own.id) + '/quick', { method: 'POST', body: JSON.stringify(patch) });
      own.openSpots = res.openSpots; own.recruitingOpen = res.recruitingOpen;
      const pub = findLeague(own.id);
      if (pub) { pub.openSpots = res.openSpots; if (!res.recruitingOpen) state.leagues = state.leagues.filter(r => r.id !== own.id); }
      if (!pub && res.recruitingOpen && own.status === 'approved') { await load({ silent: true }); }
      state.canFindPlayers = state.profile?.status === 'league_owner' && own.status === 'approved' && own.recruitingOpen;
      toast('Updated.'); refreshLeagueSurfaces(); renderOwner();
    } catch (error) { toast(error.message, true); renderOwner(); }
  }
  async function doKickoff(button) {
    const own = state.ownListings[0]; if (!own) return; button.disabled = true;
    try {
      const res = await api('/api/leagues/listings/' + encodeURIComponent(own.id) + '/kickoff', { method: 'POST', body: '{}' });
      own.lastKickoffAt = res.lastKickoffAt || new Date().toISOString();
      const pub = findLeague(own.id); if (pub) { pub.lastKickoffAt = own.lastKickoffAt; pub.kickoffActive = true; }
      toast('Kickoff complete. Your league is back in the spotlight.'); refreshLeagueSurfaces(); renderOwner();
    } catch (error) { toast(error.message, true); load({ silent: true }); }
  }

  // ───────────── players panel ─────────────
  let playerTimer;
  async function loadPlayers() {
    const grid = $('#lgPlayerGrid');
    grid.innerHTML = '<div class="lg-skel"></div><div class="lg-skel"></div><div class="lg-skel"></div>';
    $('#lgPlayerEmpty').hidden = true;
    try {
      const params = new URLSearchParams();
      const q = $('#pQ').value.trim(); if (q) params.set('q', q);
      if ($('#pRegion').value) params.set('region', $('#pRegion').value);
      if ($('#pSize').value) params.set('size', $('#pSize').value);
      if ($('#pLang').value) params.set('lang', $('#pLang').value);
      params.set('minOvr', $('#pOvr').value || '50');
      if ($('#pSort').value === 'ovr') params.set('sort', 'ovr');
      const data = await api('/api/leagues/players?' + params.toString());
      state.players = data.players || []; renderPlayers();
    } catch (error) {
      grid.innerHTML = '<div class="lg-empty" style="grid-column:1/-1"><h3>Player search is unavailable.</h3><p>' + esc(error.message) + '</p></div>';
    }
  }
  function renderPlayers() {
    const rows = state.players;
    $('#lgPlayerResults').textContent = rows.length + (rows.length === 1 ? ' player found' : ' players found');
    $('#lgRemaining').textContent = state.remaining;
    $('#lgPips').innerHTML = [0, 1, 2].map(i => '<i class="' + (i < state.remaining ? 'on' : '') + '"></i>').join('');
    $('#lgPlayerGrid').innerHTML = rows.map((r, i) => playerCard(r, { index: i })).join('');
    $('#lgPlayerGrid').hidden = rows.length === 0; $('#lgPlayerEmpty').hidden = rows.length > 0;
  }
  async function revealPlayer(id, button) {
    button.disabled = true;
    try {
      const res = await api('/api/leagues/players/' + encodeURIComponent(id) + '/reveal', { method: 'POST', body: '{}' });
      state.revealed.set(id, res.player); state.remaining = Number(res.remainingToday || 0);
      const row = state.players.find(p => p.accountId === id); if (row) row.revealed = true;
      renderPlayers(); toast(res.alreadyRevealed ? 'Contact details restored.' : 'Contact unlocked. Reach out respectfully.');
    } catch (error) {
      toast(error.message, true); button.disabled = false;
      if (/daily limit/i.test(error.message)) { state.remaining = 0; renderPlayers(); }
    }
  }

  // ───────────── profile form ─────────────
  function profileDraft() {
    const f = $('#lgProfileForm');
    return {
      displayName: state.account?.displayName || f.elements.inGameUsername.value || 'Your name', username: state.account?.username || '',
      avatarUrl: f.elements.avatarUrl.value || state.account?.avatarUrl || null, ovr: Number(f.elements.ovr.value || 0) || '—',
      regionServer: f.elements.regionServer.value || 'Region', tournamentSizes: selectedValues(f, 'tournamentSizes'),
      preferredLanguages: selectedValues(f, 'preferredLanguages'), availability: f.elements.availability.value, playStyle: f.elements.playStyle.value, notes: f.elements.notes.value.trim()
    };
  }
  const renderProfilePreview = () => { $('#lgProfilePreview').innerHTML = playerCard(profileDraft(), { preview: true }); };
  function openProfile(suggested) {
    const f = $('#lgProfileForm'); const p = state.profile || {}; const s = suggested || {};
    f.reset();
    f.elements.fcMobileUid.value = p.fc_mobile_uid || s.fcMobileUid || '';
    f.elements.inGameUsername.value = p.in_game_username || s.inGameUsername || '';
    f.elements.avatarUrl.value = p.avatar_url || '';
    f.elements.ovr.value = p.ovr || '';
    f.elements.regionServer.value = p.region_server || s.regionServer || '';
    f.elements.status.value = p.status || 'looking_for_league';
    f.elements.discordHandle.value = p.discord_handle || s.discordHandle || '';
    f.elements.availability.value = p.availability || '';
    f.elements.playStyle.value = p.play_style || '';
    f.elements.notes.value = p.notes || '';
    setChecks(f, 'preferredLanguages', p.preferred_languages || ['English']);
    setChecks(f, 'tournamentSizes', p.tournament_sizes || []);
    $('#lgProfileTitle').textContent = state.profile ? 'Update your league profile.' : 'Set up your league profile.';
    $('#lgProfileCancel').hidden = !state.profile;
    msg('#lgProfileMsg', ''); renderProfilePreview(); showView('profile', { scroll: true });
  }
  async function submitProfile(event) {
    event.preventDefault();
    const f = event.currentTarget; const btn = $('#lgProfileSave');
    if (!f.reportValidity()) return;
    btn.disabled = true; btn.textContent = 'Saving profile…'; msg('#lgProfileMsg', '');
    const payload = {
      fcMobileUid: f.elements.fcMobileUid.value.trim(), inGameUsername: f.elements.inGameUsername.value.trim(), avatarUrl: f.elements.avatarUrl.value,
      ovr: Number(f.elements.ovr.value), regionServer: f.elements.regionServer.value, status: f.elements.status.value, discordHandle: f.elements.discordHandle.value.trim(),
      availability: f.elements.availability.value, playStyle: f.elements.playStyle.value, notes: f.elements.notes.value.trim(),
      preferredLanguages: selectedValues(f, 'preferredLanguages'), tournamentSizes: selectedValues(f, 'tournamentSizes')
    };
    try {
      await api('/api/leagues/profile', { method: 'POST', body: JSON.stringify(payload) });
      toast('Player profile saved.'); await load(); 
    } catch (error) { msg('#lgProfileMsg', error.message); }
    finally { btn.disabled = false; btn.innerHTML = 'Save player profile <span aria-hidden="true">→</span>'; }
  }

  // ───────────── listing editor ─────────────
  function listingDraft() {
    const f = $('#lgListingForm'); const own = state.ownListings.find(r => r.id === state.editingId);
    return {
      id: 'preview', name: f.elements.name.value.trim() || own?.name || '', tagline: f.elements.tagline.value.trim(), description: f.elements.description.value.trim(),
      logoUrl: f.elements.logoUrl.value || null, regionServer: f.elements.regionServer.value, minOvr: Number(f.elements.minOvr.value || 0) || 0,
      tournamentFrequency: f.elements.tournamentFrequency.value, tournamentSizes: selectedValues(f, 'tournamentSizes'), preferredLanguages: selectedValues(f, 'preferredLanguages'),
      playerCommitment: f.elements.playerCommitment.value, openSpots: Number(f.elements.openSpots.value || 0), discordRequired: f.elements.discordRequired.checked,
      verified: Boolean(own?.verified), featured: false, kickoffActive: false, saved: false, isMine: true, confirmations7d: 0, lastActiveAt: null, createdAt: new Date().toISOString()
    };
  }
  const renderListingPreview = () => { $('#lgListingPreview').innerHTML = leagueCard(listingDraft(), { preview: true }); };
  function openEditor(row = null) {
    if (state.profile?.status !== 'league_owner') { openProfile(); toast('Set your status to League owner to submit a club listing.'); return; }
    state.editingId = row?.id || null;
    const f = $('#lgListingForm'); f.reset();
    f.elements.name.value = row?.name || ''; f.elements.name.disabled = Boolean(row); $('#lgNameHelp').hidden = !row;
    f.elements.tagline.value = row?.tagline || ''; f.elements.regionServer.value = row?.regionServer || state.profile?.region_server || '';
    f.elements.minOvr.value = row?.minOvr ?? ''; f.elements.tournamentFrequency.value = row?.tournamentFrequency || 'daily';
    f.elements.playerCommitment.value = row?.playerCommitment || 'regular'; f.elements.openSpots.value = String(row?.openSpots ?? 5);
    f.elements.activeHours.value = row?.activeHours || ''; f.elements.leagueGameId.value = row?.leagueGameId || '';
    f.elements.discordInviteUrl.value = row?.discordInviteUrl || ''; f.elements.contactDiscord.value = row?.contactDiscord || '';
    f.elements.description.value = row?.description || ''; f.elements.weeklyRewards.value = row?.weeklyRewards || '';
    f.elements.logoUrl.value = row?.logoUrl || ''; f.elements.discordRequired.checked = Boolean(row?.discordRequired); f.elements.recruitingOpen.checked = row ? row.recruitingOpen !== false : true;
    setChecks(f, 'tournamentSizes', row?.tournamentSizes || ['4v4']); setChecks(f, 'preferredLanguages', row?.preferredLanguages || ['English']);
    $('#lgEditorTitle').textContent = row ? 'Update your league listing.' : 'Put your league on the board.';
    $('#lgListingSave').innerHTML = row ? 'Resubmit for review <span aria-hidden="true">→</span>' : 'Submit for review <span aria-hidden="true">→</span>';
    msg('#lgListingMsg', ''); renderListingPreview(); showView('editor', { scroll: true });
  }
  async function submitListing(event) {
    event.preventDefault();
    const f = event.currentTarget; const btn = $('#lgListingSave');
    if (!selectedValues(f, 'tournamentSizes').length) { msg('#lgListingMsg', 'Choose at least one tournament size.'); return; }
    if (!f.reportValidity()) return;
    btn.disabled = true; btn.textContent = 'Submitting…'; msg('#lgListingMsg', '');
    const payload = {
      name: f.elements.name.value.trim(), tagline: f.elements.tagline.value.trim(), leagueGameId: f.elements.leagueGameId.value.trim(), description: f.elements.description.value.trim(),
      logoUrl: f.elements.logoUrl.value, regionServer: f.elements.regionServer.value, minOvr: Number(f.elements.minOvr.value), tournamentFrequency: f.elements.tournamentFrequency.value,
      tournamentSizes: selectedValues(f, 'tournamentSizes'), preferredLanguages: selectedValues(f, 'preferredLanguages'), playerCommitment: f.elements.playerCommitment.value,
      weeklyRewards: f.elements.weeklyRewards.value.trim(), discordInviteUrl: f.elements.discordInviteUrl.value.trim(), contactDiscord: f.elements.contactDiscord.value.trim(),
      activeHours: f.elements.activeHours.value.trim(), openSpots: Number(f.elements.openSpots.value), discordRequired: f.elements.discordRequired.checked, recruitingOpen: f.elements.recruitingOpen.checked
    };
    try {
      const endpoint = state.editingId ? '/api/leagues/listings/' + encodeURIComponent(state.editingId) + '/update' : '/api/leagues/listings';
      const res = await api(endpoint, { method: 'POST', body: JSON.stringify(payload) });
      state.editingId = null; toast(res.message || 'Submitted. It goes live after review.'); state.tab = 'owner'; await load();
    } catch (error) { msg('#lgListingMsg', error.message); }
    finally { btn.disabled = false; btn.innerHTML = (state.editingId ? 'Resubmit for review' : 'Submit for review') + ' <span aria-hidden="true">→</span>'; }
  }

  async function uploadImage(file, hiddenInput) {
    const ok = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    if (!ok.includes(file.type) || file.size > 8 * 1024 * 1024) throw new Error('Use a JPG, PNG, WebP or GIF image smaller than 8 MB.');
    const accessToken = await token(); if (!accessToken) throw new Error('Sign in again before uploading an image.');
    const body = new FormData(); body.append('file', file); body.append('permanent', 'true');
    const res = await fetch('/api/account/image-upload', { method: 'POST', headers: { authorization: 'Bearer ' + accessToken }, body, credentials: 'same-origin', cache: 'no-store' });
    const result = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(result.error || 'Image upload failed. Please try again.');
    const url = result.image?.url || result.url || result.imageUrl || result.data?.url || result.data?.display_url || '';
    if (!url) throw new Error('Image upload did not return a usable image URL.');
    hiddenInput.value = url; return url;
  }

  // ───────────── bootstrap ─────────────
  async function load({ silent = false } = {}) {
    if (!silent) showView('loading');
    try {
      if (!(await token())) { showView('gate'); return; }
      const d = await api('/api/leagues/bootstrap');
      state.account = d.account; state.profile = d.profile; state.leagues = d.leagues || []; state.ownListings = d.ownListings || [];
      state.insights = d.ownerInsights || null; state.canFindPlayers = Boolean(d.canFindPlayers); state.remaining = Number(d.outreachRemaining ?? 3); state.premiumReady = d.premiumReady !== false;
      if (!d.profile) { openProfile(d.suggestedProfile); return; }
      if (state.view !== 'workspace') showView('workspace', { scroll: !silent });
      if (d.directoryFailed) toast('Some leagues could not be loaded. Pull to refresh in a moment.', true);
      renderHero(); renderTabs(); renderLeagues(); renderSaved(); renderOwner();
      if (state.tab === 'players') loadPlayers();
    } catch (error) {
      if (silent) { toast(error.message, true); return; }
      if (error.status === 401) { showView('gate'); return; }
      $('#lgErrorMsg').textContent = error.message || 'Something went wrong. Please try again.'; showView('error');
    }
  }

  // ───────────── static setup ─────────────
  function buildOptions() {
    const opt = (value, label) => '<option value="' + esc(value) + '">' + esc(label == null ? value : label) + '</option>';
    const sets = {
      'regions': '<option value="">Choose region</option>' + REGIONS.map(r => opt(r)).join(''),
      'regions-any': '<option value="">All regions</option>' + REGIONS.map(r => opt(r)).join(''),
      'languages-any': '<option value="">Any language</option>' + LANGS.map(r => opt(r)).join(''),
      'availability': '<option value="">Choose your usual availability</option>' + AVAIL.map(r => opt(r)).join(''),
      'styles': '<option value="">Choose a play style</option>' + STYLES.map(r => opt(r)).join(''),
      'reasons': REASONS.map(([v, l]) => opt(v, l)).join('')
    };
    $$('[data-options]').forEach(n => { n.innerHTML = sets[n.dataset.options] || ''; });
    const chip = (name, v) => '<label class="lg-chip"><input type="checkbox" name="' + name + '" value="' + esc(v) + '"><span>' + esc(v) + '</span></label>';
    $$('[data-chips]').forEach(n => { n.innerHTML = (n.dataset.chips === 'sizes' ? SIZES : LANGS).map(v => chip(n.dataset.name, v)).join(''); });
  }
  function resetFilters() {
    state.filters = { q: '', region: '', freq: '', size: '', lang: '', commit: '', qualify: true, verified: false };
    $('#fQ').value = ''; ['fRegion', 'fFreq', 'fSize', 'fLang', 'fCommit'].forEach(id => { $('#' + id).value = ''; });
    $('#fQualify').checked = true; $('#fVerified').checked = false; renderLeagues();
  }
  function bindFilters() {
    const map = { fRegion: 'region', fFreq: 'freq', fSize: 'size', fLang: 'lang', fCommit: 'commit' };
    $('#fQ').addEventListener('input', e => { state.filters.q = e.target.value; renderLeagues(); });
    for (const [id, key] of Object.entries(map)) $('#' + id).addEventListener('change', e => { state.filters[key] = e.target.value; renderLeagues(); });
    $('#fQualify').addEventListener('change', e => { state.filters.qualify = e.target.checked; renderLeagues(); });
    $('#fVerified').addEventListener('change', e => { state.filters.verified = e.target.checked; renderLeagues(); });
    $('#fSort').addEventListener('change', e => { state.sort = e.target.value; renderLeagues(); });
    $('#fClear').addEventListener('click', resetFilters); $('#lgEmptyReset').addEventListener('click', resetFilters);
    $('#fShowAll').addEventListener('click', () => { state.filters.qualify = false; $('#fQualify').checked = false; renderLeagues(); });
    $('#fToggle').addEventListener('click', e => { const open = $('#lgFilters').classList.toggle('open'); e.currentTarget.setAttribute('aria-expanded', String(open)); });
    const reload = () => { clearTimeout(playerTimer); playerTimer = setTimeout(loadPlayers, 220); };
    ['pQ'].forEach(id => $('#' + id).addEventListener('input', reload));
    ['pRegion', 'pSize', 'pLang', 'pOvr', 'pSort'].forEach(id => $('#' + id).addEventListener('change', loadPlayers));
  }
  function bindForms() {
    $('#lgProfileForm').addEventListener('submit', submitProfile);
    $('#lgProfileForm').addEventListener('input', renderProfilePreview); $('#lgProfileForm').addEventListener('change', renderProfilePreview);
    $('#lgListingForm').addEventListener('submit', submitListing);
    $('#lgListingForm').addEventListener('input', renderListingPreview); $('#lgListingForm').addEventListener('change', renderListingPreview);
    $('#lgProfileCancel').addEventListener('click', () => { showView('workspace', { scroll: true }); });
    $('#lgEditorBack').addEventListener('click', () => { state.editingId = null; showView('workspace', { scroll: true }); setTab('owner'); });
    $('#lgAvatarFile').addEventListener('change', async e => {
      const file = e.currentTarget.files?.[0]; if (!file) return; const btn = $('#lgProfileSave'); btn.disabled = true; msg('#lgProfileMsg', 'Uploading avatar…', 'ok');
      try { await uploadImage(file, $('#lgProfileForm').elements.avatarUrl); msg('#lgProfileMsg', 'Avatar uploaded.', 'ok'); renderProfilePreview(); } catch (error) { msg('#lgProfileMsg', error.message); } finally { btn.disabled = false; }
    });
    $('#lgCrestFile').addEventListener('change', async e => {
      const file = e.currentTarget.files?.[0]; if (!file) return; const btn = $('#lgListingSave'); btn.disabled = true; msg('#lgListingMsg', 'Uploading crest…', 'ok');
      try { await uploadImage(file, $('#lgListingForm').elements.logoUrl); msg('#lgListingMsg', 'Crest uploaded.', 'ok'); renderListingPreview(); } catch (error) { msg('#lgListingMsg', error.message); } finally { btn.disabled = false; }
    });
  }
  function bindGlobal() {
    document.addEventListener('error', e => { if (e.target?.tagName === 'IMG' && e.target.closest?.('.lg-root')) e.target.remove(); }, true);
    $('#lgRetry').addEventListener('click', () => load());
    $('#lgBackdrop').addEventListener('click', closeDrawer); $('#lgDrawerClose').addEventListener('click', closeDrawer);
    $('#lgReportCancel').addEventListener('click', closeReport); $('#lgReportSend').addEventListener('click', sendReport);
    $('#lgReport').addEventListener('click', e => { if (e.target === e.currentTarget) closeReport(); });
    document.addEventListener('keydown', e => { if (e.key !== 'Escape') return; if (!$('#lgReport').hidden) closeReport(); else closeDrawer(); });

    $('#lgRoot').addEventListener('click', e => {
      const t = e.target;
      const tab = t.closest('[data-tab]'); if (tab) { setTab(tab.dataset.tab); return; }
      const go = t.closest('[data-goto]'); if (go) { setTab(go.dataset.goto); return; }
      const save = t.closest('[data-save]'); if (save) { e.stopPropagation(); toggleSave(save.dataset.save); return; }
      const open = t.closest('[data-open]'); if (open) { openDrawer(open.dataset.open); return; }
      const copy = t.closest('[data-copy]'); if (copy) { copyText(copy.dataset.copy, copy.dataset.label); return; }
      const contact = t.closest('[data-contact]'); if (contact) { copyText(contact.dataset.contact, 'Discord contact'); return; }
      const join = t.closest('[data-join]'); if (join) { trackJoin(join.dataset.join); return; }
      const conf = t.closest('[data-confirm]'); if (conf) { confirmActive(conf.dataset.confirm, conf); return; }
      const rep = t.closest('[data-report]'); if (rep) { openReport(rep.dataset.report); return; }
      const rev = t.closest('[data-reveal]'); if (rev) { revealPlayer(rev.dataset.reveal, rev); return; }
      if (t.closest('#lgEditProfile')) { openProfile(); return; }
      if (t.closest('[data-create-listing]')) { openEditor(); return; }
      if (t.closest('[data-edit-listing]')) { openEditor(state.ownListings[0]); return; }
      const spots = t.closest('[data-spots]');
      if (spots) { const own = state.ownListings[0]; const next = Math.max(0, Math.min(50, Number(own?.openSpots || 0) + Number(spots.dataset.spots))); if (own && next !== own.openSpots) quickUpdate({ openSpots: next }); return; }
      if (t.closest('#lgRecruitToggle')) { const own = state.ownListings[0]; if (own) quickUpdate({ recruitingOpen: !own.recruitingOpen }); return; }
      const kick = t.closest('#lgKickoff'); if (kick) { doKickoff(kick); return; }
      const card = t.closest('[data-card]'); if (card && !t.closest('a,button')) openDrawer(card.dataset.card);
    });
  }
  // live countdowns (owner Kickoff cooldown)
  setInterval(() => {
    const nodes = $$('[data-until]'); if (!nodes.length) return;
    let expired = false;
    for (const n of nodes) { const left = Number(n.dataset.until) - Date.now(); if (left <= 0) expired = true; else n.textContent = clock(left); }
    if (expired && state.view === 'workspace') renderOwner();
  }, 1000);

  buildOptions(); bindFilters(); bindForms(); bindGlobal();
  accountAuth.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_OUT') { state.profile = null; showView('gate'); }
    if (event === 'SIGNED_IN' && session?.access_token && state.view === 'gate') load();
  });
  load();
</script>
