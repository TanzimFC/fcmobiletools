    const map = { fRegion: 'region', fFreq: 'freq', fSize: 'size', fLang: 'lang', fCommit: 'commit', fJoin: 'join' };
    for (const [id, key] of Object.entries(map)) $('#' + id).addEventListener('change', e => { f[key] = e.target.value; renderLeagues(); });
