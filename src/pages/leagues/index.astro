        state.inboxThreads = []; state.inboxMessages = []; state.activeConversationId = null; renderInbox();
        $('#lgInboxThreads').innerHTML = '<div class="lg-empty"><h3>Inbox access suspended</h3><p>' + esc(e.message) + '</p>' + (e.body.suspendedUntil ? '<p>Available again: ' + esc(inboxTime(e.body.suspendedUntil)) + '</p>' : '') + '</div>';
        return;
      }
      if (!silent) toast(e.message || 'Inbox could not be loaded.', true);
      $('#lgInboxThreads').innerHTML = '<div class="lg-empty"><h3>Inbox unavailable.</h3><p>' + esc(e.message) + '</p><button class="lg-btn lg-btn-outline" id="lgInboxRetry" type="button">Try again</button></div>';
    } finally { state.inboxLoading = false; }
