        own.appealStatus = result.status || 'open';
        sheet.close();
        toast('Appeal submitted for review.');
        renderOwner();
      } catch (error) {
        msg.textContent = error.message || 'The appeal could not be submitted.';
        button.disabled = false; button.textContent = 'Send appeal';
      }
    });
  }

