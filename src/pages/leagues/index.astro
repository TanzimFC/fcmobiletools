    $('#fOvr').addEventListener('input', e => {
      const n = Number(e.target.value); f.ovr = n >= 50 && n <= 200 ? n : 0; if (f.ovr) safeStore.set('lg-ovr', String(f.ovr)); renderLeagues();
    });
    const reset = () => {
      Object.assign(f, { q: '', division: '', region: '', freq: '', size: '', lang: '', commit: '', join: '', verified: false, spots: false, ovr: 0 });
      ['fQ', 'fOvr', 'fRegion', 'fFreq', 'fSize', 'fLang', 'fCommit', 'fJoin'].forEach(id => { $('#' + id).value = ''; });
