---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Find a League"
  description="Find an FC Mobile league that fits your OVR, region and playstyle, or list yours and scout players. Fresh Kickoffs rise to the top."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="lg-root fl" id="lgRoot" data-page="find-a-league">
    <div class="lg-aurora" aria-hidden="true"></div>
    <noscript><p class="lg-noscript">Enable JavaScript to use Find a League.</p></noscript>
    <div class="lg-wrap">

      <!-- HERO -->
      <header class="lg-hero" id="lgHero">
        <div class="lg-hero-copy">
          <div class="lg-eyebrow"><i></i> FC MOBILE LEAGUE HUB</div>
          <h1>Find the league that <em>fits your squad.</em></h1>
          <p>Verified clubs, honest activity signals and a match score built around your OVR, region and play style.</p>
        </div>
        <div class="lg-hero-side">
          <div class="lg-stats" id="lgStats" hidden>
            <div><strong id="statLeagues">0</strong><span>Live leagues</span></div>
            <div><strong id="statSpots">0</strong><span>Open spots</span></div>
            <div><strong id="statRegions">0</strong><span>Regions</span></div>
          </div>
          <div class="lg-me" id="lgMe" hidden></div>
        </div>
      </header>

      <!-- SIGN-IN GATE -->
      <section class="lg-gate" id="lgGate" hidden>
        <div class="lg-gate-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M24 4 41 11v12c0 10-6.8 17-17 21C13.8 40 7 33 7 23V11L24 4Z"/><path d="m16 24 5 5 11-12"/></svg>
        </div>
        <h2>Your next club is one sign-in away.</h2>
        <p>Sign in to browse leagues, get a personal match score and contact league owners.</p>
        <ul class="lg-gate-points">
          <li><b>Match score</b><span>See how well each league fits you</span></li>
          <li><b>Verified clubs</b><span>Reviewed before they go live</span></li>
          <li><b>Private by design</b><span>Your UID stays hidden until you choose</span></li>
        </ul>
        <a class="lg-btn lg-btn-primary lg-btn-lg" href="/account/?next=%2Fleagues%2F">Sign in or create account <span aria-hidden="true">↗</span></a>
      </section>

      <!-- LOADING -->
      <section class="lg-loading" id="lgLoading" aria-live="polite">
        <div class="lg-skel-row"><i></i><i></i><i></i></div>
        <div class="lg-grid">
          <div class="lg-skel"></div><div class="lg-skel"></div><div class="lg-skel"></div>
        </div>
      </section>

      <!-- ERROR -->
      <section class="lg-gate" id="lgError" hidden>
        <div class="lg-gate-mark warn" aria-hidden="true">!</div>
        <h2>We couldn't load the league board.</h2>
        <p id="lgErrorMsg">Something went wrong. Please try again.</p>
        <button class="lg-btn lg-btn-primary" id="lgRetry" type="button">Try again</button>
      </section>

      <!-- PLAYER PROFILE SETUP -->
      <section class="lg-setup" id="lgProfile" hidden>
        <div class="lg-setup-main">
          <div class="lg-panel-head">
            <div>
              <span class="lg-eyebrow"><i></i> PLAYER CARD</span>
              <h2 id="lgProfileTitle">Set up your league profile.</h2>
              <p>Used only by Find a League. It never changes your normal account profile or any other tool.</p>
            </div>
            <button class="lg-btn lg-btn-quiet" id="lgProfileCancel" type="button" hidden>Cancel</button>
          </div>
          <form id="lgProfileForm" class="lg-form" novalidate>
            <div class="lg-grid-2">
              <label class="lg-field"><span>FC Mobile UID <b>*</b></span><input name="fcMobileUid" required minlength="3" maxlength="64" autocomplete="off" placeholder="Your in-game UID"></label>
              <label class="lg-field"><span>In-game username <b>*</b></span><input name="inGameUsername" required minlength="2" maxlength="40" placeholder="Your FC Mobile name"></label>
              <label class="lg-field"><span>Current OVR <b>*</b></span><input name="ovr" type="number" inputmode="numeric" min="50" max="200" required placeholder="e.g. 123"></label>
              <label class="lg-field"><span>Region / server <b>*</b></span><select name="regionServer" required data-options="regions"></select></label>
              <label class="lg-field"><span>What describes you? <b>*</b></span>
                <select name="status" required>
                  <option value="looking_for_league">Looking for a league</option>
                  <option value="in_a_league">Already in a league</option>
                  <option value="league_owner">League owner</option>
                  <option value="not_looking">Just browsing for now</option>
                </select>
              </label>
              <label class="lg-field"><span>Discord handle <small>Optional</small></span><input name="discordHandle" maxlength="100" placeholder="name or @name"></label>
              <label class="lg-field"><span>Availability</span><select name="availability" data-options="availability"></select></label>
              <label class="lg-field"><span>Play style</span><select name="playStyle" data-options="styles"></select></label>
            </div>
            <div class="lg-upload-row">
              <label class="lg-upload" for="lgAvatarFile"><span class="lg-upload-icon">↑</span><span><strong>Player avatar</strong><small>Optional · JPG, PNG, WebP or GIF · under 8 MB</small></span><input id="lgAvatarFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></label>
              <input type="hidden" name="avatarUrl">
            </div>
            <fieldset class="lg-fieldset"><legend>Preferred languages</legend><div class="lg-chips" data-chips="languages" data-name="preferredLanguages"></div></fieldset>
            <fieldset class="lg-fieldset"><legend>Tournament sizes you'd play</legend><div class="lg-chips" data-chips="sizes" data-name="tournamentSizes"></div></fieldset>
            <label class="lg-field"><span>Anything league owners should know? <small>Optional</small></span><textarea name="notes" rows="3" maxlength="500" placeholder="Preferred rhythm, what you're looking for, other details."></textarea></label>
            <div class="lg-form-foot">
              <p>Your UID and Discord are shown only to approved league owners, one unlock at a time, and only while you're set to “Looking for a league”.</p>
              <button class="lg-btn lg-btn-primary" type="submit" id="lgProfileSave">Save player profile <span aria-hidden="true">→</span></button>
            </div>
            <div class="lg-msg" id="lgProfileMsg" role="status"></div>
          </form>
        </div>
        <aside class="lg-setup-side">
          <div class="lg-preview-label">Live preview · what owners see</div>
          <div id="lgProfilePreview"></div>
        </aside>
      </section>

      <!-- MAIN WORKSPACE -->
      <div class="lg-workspace" id="lgWorkspace" hidden>
        <nav class="lg-tabs" id="lgTabs" role="tablist" aria-label="League hub"></nav>

        <!-- LEAGUES -->
        <section class="lg-panel" id="panelLeagues" role="tabpanel">
          <div class="lg-toolbar">
            <label class="lg-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="fQ" type="search" placeholder="Search name, language, region or league ID" aria-label="Search leagues" autocomplete="off"></label>
            <select id="fSort" aria-label="Sort leagues">
              <option value="match">Best match</option>
              <option value="active">Most active</option>
              <option value="newest">Newest</option>
              <option value="spots">Most open spots</option>
              <option value="ovr">Lowest OVR needed</option>
            </select>
            <button class="lg-btn lg-btn-outline lg-filter-toggle" id="fToggle" type="button" aria-expanded="false" aria-controls="lgFilters">Filters <span id="fCount" hidden>0</span></button>
          </div>
          <div class="lg-filters" id="lgFilters">
            <select id="fRegion" aria-label="Region" data-options="regions-any"></select>
            <select id="fFreq" aria-label="Tournament rhythm">
              <option value="">Any rhythm</option><option value="daily">Daily</option><option value="most_days">Most days</option><option value="several_weekly">Several times a week</option><option value="weekly">Weekly</option><option value="occasional">Occasional</option>
            </select>
            <select id="fSize" aria-label="Tournament size"><option value="">Any size</option><option>4v4</option><option>8v8</option><option>16v16</option><option>32v32</option></select>
            <select id="fLang" aria-label="Language" data-options="languages-any"></select>
            <select id="fCommit" aria-label="Culture"><option value="">Any culture</option><option value="casual">Casual</option><option value="regular">Regular play</option><option value="competitive">Competitive</option></select>
            <label class="lg-switch-chip"><input type="checkbox" id="fQualify" checked><span>I qualify (OVR)</span></label>
            <label class="lg-switch-chip"><input type="checkbox" id="fVerified"><span>Verified only</span></label>
          </div>
          <div class="lg-meta-row">
            <span id="lgResults">Loading leagues…</span>
            <span class="lg-meta-actions"><button type="button" class="lg-link" id="fShowAll" hidden>Show leagues above my OVR</button><button type="button" class="lg-link" id="fClear">Clear filters</button></span>
          </div>
          <div id="lgFeatured" class="lg-featured" hidden>
            <div class="lg-rail-head"><span class="lg-badge gold">★ Featured</span><small>Hand-picked by the FCMobiletools team</small></div>
            <div class="lg-rail" id="lgRail"></div>
          </div>
          <div id="lgGrid" class="lg-grid"></div>
          <div class="lg-empty" id="lgEmpty" hidden>
            <span class="lg-empty-icon" aria-hidden="true">⌕</span>
            <h3>No leagues match these filters.</h3>
            <p>Try widening the region or OVR filter, or help the board grow by listing your own club.</p>
            <button class="lg-btn lg-btn-outline" id="lgEmptyReset" type="button">Clear filters</button>
          </div>
        </section>

        <!-- SAVED -->
        <section class="lg-panel" id="panelSaved" role="tabpanel" hidden>
          <div class="lg-panel-head slim"><div><h2>Your shortlist</h2><p>Leagues you saved. Compare them and apply when you're ready.</p></div></div>
          <div id="lgSavedGrid" class="lg-grid"></div>
          <div class="lg-empty" id="lgSavedEmpty" hidden>
            <span class="lg-empty-icon" aria-hidden="true">♡</span>
            <h3>Nothing saved yet.</h3>
            <p>Tap the heart on any league to keep it here.</p>
            <button class="lg-btn lg-btn-outline" data-goto="leagues" type="button">Browse leagues</button>
          </div>
        </section>

        <!-- PLAYERS -->
        <section class="lg-panel" id="panelPlayers" role="tabpanel" hidden>
          <div class="lg-panel-head slim">
            <div><h2>Recruit your next player.</h2><p>Available to approved league owners. Contact details unlock one player at a time.</p></div>
            <div class="lg-usage"><div class="lg-pips" id="lgPips"></div><span><strong id="lgRemaining">3</strong> unlocks left today<small>Resets at 00:00 UTC</small></span></div>
          </div>
          <div class="lg-toolbar">
            <label class="lg-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="pQ" type="search" placeholder="Search player or region" aria-label="Search players" autocomplete="off"></label>
            <select id="pSort" aria-label="Sort players"><option value="recent">Recently updated</option><option value="ovr">Highest OVR</option></select>
          </div>
          <div class="lg-filters open-always">
            <select id="pRegion" aria-label="Region" data-options="regions-any"></select>
            <select id="pSize" aria-label="Tournament size"><option value="">Any size</option><option>4v4</option><option>8v8</option><option>16v16</option><option>32v32</option></select>
            <select id="pLang" aria-label="Language" data-options="languages-any"></select>
            <select id="pOvr" aria-label="Minimum OVR"><option value="50">Any OVR</option><option value="100">100+ OVR</option><option value="110">110+ OVR</option><option value="120">120+ OVR</option><option value="125">125+ OVR</option></select>
          </div>
          <div class="lg-meta-row"><span id="lgPlayerResults">Players looking for a league</span><span class="lg-note">UID and Discord stay hidden until you unlock a contact.</span></div>
          <div id="lgPlayerGrid" class="lg-grid lg-grid-sm"></div>
          <div class="lg-empty" id="lgPlayerEmpty" hidden><span class="lg-empty-icon" aria-hidden="true">⌕</span><h3>No players match those filters.</h3><p>Try a wider region or tournament-size filter.</p></div>
        </section>

        <!-- OWNER DESK -->
        <section class="lg-panel" id="panelOwner" role="tabpanel" hidden></section>
      </div>

      <!-- LISTING EDITOR -->
      <section class="lg-setup" id="lgEditor" hidden>
        <div class="lg-setup-main">
          <div class="lg-panel-head">
            <div>
              <button class="lg-back" type="button" id="lgEditorBack">← Back to owner desk</button>
              <span class="lg-eyebrow"><i></i> CLUB APPLICATION</span>
              <h2 id="lgEditorTitle">Put your league on the board.</h2>
              <p>Clear, accurate details attract the players who actually fit your club. Every listing is reviewed before it goes live.</p>
            </div>
          </div>
          <form id="lgListingForm" class="lg-form" novalidate>
            <div class="lg-grid-2">
              <label class="lg-field"><span>League name <b>*</b></span><input name="name" required minlength="3" maxlength="70" placeholder="Your club's name"><small class="lg-help" id="lgNameHelp" hidden>The name is locked after submission so players and reviewers see a stable identity.</small></label>
              <label class="lg-field"><span>Tagline <small>Optional · shown on the card</small></span><input name="tagline" maxlength="100" placeholder="e.g. Daily 8v8 · friendly competitive core"></label>
              <label class="lg-field"><span>Region / server <b>*</b></span><select name="regionServer" required data-options="regions"></select></label>
              <label class="lg-field"><span>Minimum OVR <b>*</b></span><input name="minOvr" type="number" inputmode="numeric" min="50" max="200" required placeholder="e.g. 115"></label>
              <label class="lg-field"><span>Tournament rhythm <b>*</b></span>
                <select name="tournamentFrequency" required><option value="daily">Daily</option><option value="most_days">Most days</option><option value="several_weekly">Several times a week</option><option value="weekly">Weekly</option><option value="occasional">Occasional</option></select>
              </label>
              <label class="lg-field"><span>Player commitment <b>*</b></span>
                <select name="playerCommitment" required><option value="casual">Casual, no pressure</option><option value="regular" selected>Regular play</option><option value="competitive">Competitive</option></select>
              </label>
              <label class="lg-field"><span>Open spots <b>*</b></span><input name="openSpots" type="number" inputmode="numeric" min="0" max="50" required value="5"></label>
              <label class="lg-field"><span>Usual active hours <small>Optional</small></span><input name="activeHours" maxlength="60" placeholder="e.g. 18:00–23:00 UTC"></label>
              <label class="lg-field"><span>League UID / in-game ID <small>Optional</small></span><input name="leagueGameId" maxlength="64" placeholder="Optional"></label>
              <label class="lg-field"><span>Discord invite link <small>Optional</small></span><input name="discordInviteUrl" type="url" maxlength="500" placeholder="https://discord.gg/…"></label>
              <label class="lg-field"><span>Public Discord contact <small>Optional</small></span><input name="contactDiscord" maxlength="100" placeholder="@clubadmin"></label>
            </div>
            <label class="lg-field"><span>Describe your league <b>*</b></span><textarea name="description" required minlength="20" maxlength="700" rows="4" placeholder="Tell players how your club plays, what you expect and what makes it a good fit."></textarea></label>
            <div class="lg-upload-row">
              <label class="lg-upload" for="lgCrestFile"><span class="lg-upload-icon">↑</span><span><strong>League crest</strong><small>Optional · JPG, PNG, WebP or GIF · under 8 MB</small></span><input id="lgCrestFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></label>
              <input type="hidden" name="logoUrl">
            </div>
            <fieldset class="lg-fieldset"><legend>Tournament sizes <b>*</b></legend><div class="lg-chips" data-chips="sizes" data-name="tournamentSizes"></div></fieldset>
            <fieldset class="lg-fieldset"><legend>Languages used by your league</legend><div class="lg-chips" data-chips="languages" data-name="preferredLanguages"></div></fieldset>
            <label class="lg-field"><span>Weekly rewards or perks <small>Optional · only what you really offer</small></span><textarea name="weeklyRewards" rows="2" maxlength="300" placeholder="Optional rewards, recognition or member perks."></textarea></label>
            <div class="lg-checks">
              <label class="lg-check"><input type="checkbox" name="discordRequired"><span>Discord is required to join</span></label>
              <label class="lg-check"><input type="checkbox" name="recruitingOpen" checked><span>Open for new members</span></label>
            </div>
            <div class="lg-form-foot">
              <p>Don't put player UID lists or private member details in the public description.</p>
              <button class="lg-btn lg-btn-primary" type="submit" id="lgListingSave">Submit for review <span aria-hidden="true">→</span></button>
            </div>
            <div class="lg-msg" id="lgListingMsg" role="status"></div>
          </form>
        </div>
        <aside class="lg-setup-side">
          <div class="lg-preview-label">Live preview · how players see it</div>
          <div id="lgListingPreview"></div>
        </aside>
      </section>
    </div>

    <!-- DETAIL DRAWER -->
    <div class="lg-backdrop" id="lgBackdrop" hidden></div>
    <aside class="lg-drawer" id="lgDrawer" role="dialog" aria-modal="true" aria-label="League details" hidden>
      <button class="lg-drawer-close" id="lgDrawerClose" type="button" aria-label="Close details">✕</button>
      <div class="lg-drawer-body" id="lgDrawerBody"></div>
    </aside>

    <!-- REPORT MODAL -->
    <div class="lg-modal" id="lgReport" role="dialog" aria-modal="true" aria-labelledby="lgReportTitle" hidden>
      <div class="lg-modal-card">
        <h3 id="lgReportTitle">Report this league</h3>
        <p>Reports go straight to the review team. Please only report real problems.</p>
        <label class="lg-field"><span>Reason</span><select id="lgReportReason" data-options="reasons"></select></label>
        <label class="lg-field"><span>Details <small>Optional</small></span><textarea id="lgReportDetails" rows="3" maxlength="500" placeholder="What did you notice?"></textarea></label>
        <div class="lg-modal-actions"><button class="lg-btn lg-btn-quiet" id="lgReportCancel" type="button">Cancel</button><button class="lg-btn lg-btn-primary" id="lgReportSend" type="button">Send report</button></div>
        <div class="lg-msg" id="lgReportMsg" role="status"></div>
      </div>
    </div>

    <div class="lg-toast" id="lgToast" role="status" aria-live="polite"></div>
  </main>
</BaseLayout>

<style is:global>
  .lg-root{--bg:#071018;--s1:#0b1620;--s2:#0f1c28;--s3:#14263a;--line:rgba(255,255,255,.08);--line2:rgba(255,255,255,.14);--text:#f5f8fb;--muted:#93a7b7;--dim:#667f92;--cyan:#4cc9ff;--cyan2:#9fe6ff;--mint:#6ee7b7;--gold:#f6c453;--violet:#9a8cff;--red:#ff8f86;--amber:#f1c779;position:relative;color:var(--text);padding:clamp(22px,4vw,48px) 0 96px;font-family:Inter,system-ui,sans-serif;overflow-x:clip}
  .lg-root *,.lg-root *::before,.lg-root *::after{box-sizing:border-box}
  .lg-root [hidden]{display:none!important}
  .lg-root .lg-noscript{position:relative;z-index:2;max-width:1240px;margin:18px auto;padding:14px 16px;border:1px solid rgba(76,201,255,.25);border-radius:12px;background:#0f1a26;color:#f5f8fb;text-align:center}
  .lg-root h1,.lg-root h2,.lg-root h3,.lg-root h4{font-family:'Space Grotesk',Inter,system-ui,sans-serif;margin:0}
  .lg-root p{margin:0}
  .lg-root button,.lg-root input,.lg-root select,.lg-root textarea{font-family:inherit}
  .lg-aurora{position:absolute;inset:0 0 auto 0;height:560px;pointer-events:none;background:radial-gradient(520px 260px at 12% 0,rgba(76,201,255,.16),transparent 70%),radial-gradient(480px 240px at 92% 8%,rgba(154,140,255,.12),transparent 70%)}
  .lg-wrap{position:relative;width:min(1200px,calc(100% - 36px));margin:0 auto}
  body.lg-lock{overflow:hidden}

  /* hero */
  .lg-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:30px;animation:lg-rise .55s cubic-bezier(.2,.7,.2,1) both}
  .lg-hero-copy{max-width:700px}
  .lg-eyebrow{display:inline-flex;align-items:center;gap:9px;color:#86dcff;font-size:10.5px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
  .lg-eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 4px #4cc9ff1c,0 0 14px #4cc9ff80}
  .lg-hero h1{margin:14px 0 12px;font-size:clamp(36px,5.6vw,60px);line-height:1;letter-spacing:-.06em;font-weight:700}
  .lg-hero h1 em{font-style:normal;background:linear-gradient(100deg,#b3efff 0%,#4cc9ff 52%,#9a8cff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .lg-hero p{color:var(--muted);font-size:15px;line-height:1.7;max-width:560px}
  .lg-hero-side{display:grid;gap:12px;justify-items:end}
  .lg-stats{display:flex;border:1px solid var(--line);border-radius:16px;background:linear-gradient(160deg,rgba(18,33,47,.8),rgba(8,16,24,.9));overflow:hidden}
  .lg-stats>div{padding:12px 20px;text-align:left;min-width:92px}
  .lg-stats>div+div{border-left:1px solid var(--line)}
  .lg-stats strong{display:block;font:700 24px/1.1 'Space Grotesk',sans-serif;letter-spacing:-.03em}
  .lg-stats span{display:block;margin-top:4px;color:var(--dim);font-size:10.5px;font-weight:600;letter-spacing:.02em}
  .lg-me{display:flex;align-items:center;gap:11px;padding:8px 8px 8px 10px;border:1px solid var(--line);border-radius:14px;background:#0a141d}
  .lg-me .lg-avatar{width:36px;height:36px;flex:0 0 36px;border-radius:11px}
  .lg-me-txt{min-width:0}.lg-me-txt b{display:block;font-size:12.5px;line-height:1.2;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.lg-me-txt small{display:block;color:var(--muted);font-size:10.5px;margin-top:2px}

  /* buttons */
  .lg-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:0 17px;border:1px solid var(--line2);border-radius:12px;background:#0d1923;color:var(--text);text-decoration:none;cursor:pointer;font:700 12.5px/1 Inter,sans-serif;white-space:nowrap;transition:transform .18s,border-color .18s,background .18s,box-shadow .18s}
  .lg-btn:hover{transform:translateY(-2px);border-color:#4cc9ff66}
  .lg-btn:active{transform:none}
  .lg-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
  .lg-btn:focus-visible,.lg-tab:focus-visible,.lg-link:focus-visible,.lg-icon-btn:focus-visible,.lg-card button:focus-visible,.lg-card a:focus-visible,.lg-drawer button:focus-visible,.lg-drawer a:focus-visible,.lg-back:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  .lg-btn-primary{color:#04131c;border-color:#7be0ff;background:linear-gradient(140deg,#a6edff,#4cc9ff 70%);box-shadow:0 10px 26px -12px #4cc9ffa8,inset 0 1px 0 #ffffffa6}
  .lg-btn-primary:hover{background:linear-gradient(140deg,#c9f4ff,#69d8ff);box-shadow:0 14px 34px -12px #4cc9ffbb}
  .lg-btn-outline{background:#10202c;border-color:#27465a}
  .lg-btn-quiet{background:transparent;color:#b4c5d1}
  .lg-btn-gold{color:#241a02;border-color:#f6d783;background:linear-gradient(140deg,#ffe9a6,#f6c453)}
  .lg-btn-danger{color:#ffc0b7;background:#231519;border-color:#5b3438}
  .lg-btn-lg{min-height:50px;padding:0 24px;font-size:13.5px}
  .lg-btn-sm{min-height:34px;padding:0 12px;font-size:11.5px;border-radius:10px;gap:7px}
  .lg-link{border:0;background:transparent;color:#75d8ff;font:700 11.5px Inter,sans-serif;cursor:pointer;padding:3px 0}
  .lg-link:hover{text-decoration:underline}
  .lg-icon-btn{display:inline-grid;place-items:center;width:34px;height:34px;border:1px solid var(--line2);border-radius:10px;background:#0d1923;color:#b9cad6;cursor:pointer;transition:.18s}
  .lg-icon-btn:hover{border-color:#4cc9ff66;color:#fff}
  .lg-icon-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  .lg-icon-btn.on{color:#ff9fb6;border-color:#ff9fb655;background:#2a1420}
  .lg-icon-btn.on svg{fill:currentColor}

  /* gate / loading / empty */
  .lg-gate{width:min(620px,100%);margin:34px auto 6px;padding:clamp(28px,5vw,48px);text-align:center;border:1px solid transparent;border-radius:26px;background:linear-gradient(150deg,rgba(16,31,44,.96),rgba(8,17,26,.98)) padding-box,linear-gradient(145deg,#4cc9ff6b,#ffffff0b 52%,#9a8cff45) border-box;box-shadow:0 34px 100px -55px #000;animation:lg-rise .5s both}
  .lg-gate-mark{display:grid;place-items:center;width:60px;height:60px;margin:0 auto 18px;border-radius:19px;background:#4cc9ff10;border:1px solid #4cc9ff3a;color:#83ddff;font:700 26px 'Space Grotesk',sans-serif}
  .lg-gate-mark.warn{color:var(--amber);border-color:#f1c77940;background:#f1c7790f}
  .lg-gate-mark svg{width:32px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .lg-gate h2{font-size:clamp(24px,4vw,32px);line-height:1.12;letter-spacing:-.045em;margin-bottom:10px}
  .lg-gate>p{max-width:440px;margin:0 auto 22px;color:var(--muted);font-size:14px;line-height:1.7}
  .lg-gate-points{list-style:none;display:grid;gap:8px;margin:0 0 24px;padding:0;text-align:left}
  .lg-gate-points li{display:flex;flex-direction:column;gap:2px;padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:#09131c}
  .lg-gate-points b{font-size:12.5px}.lg-gate-points span{color:var(--muted);font-size:11.5px}
  .lg-loading{animation:lg-rise .3s both}
  .lg-skel-row{display:flex;gap:10px;margin-bottom:18px}
  .lg-skel-row i,.lg-skel{display:block;border:1px solid #ffffff0a;background:linear-gradient(100deg,#0b1720 20%,#13242f 45%,#0b1720 70%);background-size:220% 100%;animation:lg-shimmer 1.6s linear infinite}
  .lg-skel-row i{height:40px;flex:1;border-radius:12px}
  .lg-skel{height:300px;border-radius:20px}
  .lg-empty{margin-top:16px;padding:44px 20px;text-align:center;border:1px dashed #ffffff1f;border-radius:20px;background:#09141d}
  .lg-empty-icon{display:grid;place-items:center;width:44px;height:44px;margin:0 auto 14px;border-radius:14px;border:1px solid #4cc9ff2a;background:#4cc9ff0a;color:#86dfff;font-size:24px}
  .lg-empty h3{font-size:18px;margin-bottom:7px}.lg-empty p{max-width:400px;margin:0 auto 16px;color:var(--muted);font-size:12.5px;line-height:1.6}

  /* tabs */
  .lg-tabs{display:flex;gap:4px;padding:5px;margin-bottom:22px;border:1px solid var(--line);border-radius:16px;background:#09141d;overflow-x:auto;scrollbar-width:none}
  .lg-tabs::-webkit-scrollbar{display:none}
  .lg-tab{display:inline-flex;align-items:center;gap:9px;min-height:40px;padding:0 16px;border:1px solid transparent;border-radius:11px;background:transparent;color:#8ea3b2;font:700 12.5px Inter,sans-serif;cursor:pointer;white-space:nowrap;transition:.18s}
  .lg-tab:hover{color:#dbe8f0;background:#ffffff06}
  .lg-tab.active{background:linear-gradient(110deg,#4cc9ff17,#9a8cff0d);border-color:#4cc9ff2b;color:#eaf8ff}
  .lg-tab em{font-style:normal;display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 6px;border-radius:7px;background:#ffffff0c;color:#9ec0d2;font-size:10.5px}
  .lg-tab .lg-dot{width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 3px #f1c77920}
  .lg-tab .lg-dot.live{background:var(--mint);box-shadow:0 0 0 3px #6ee7b720}
  .lg-tab-spacer{flex:1}

  /* toolbar + filters */
  .lg-toolbar{display:flex;gap:9px;margin-bottom:10px}
  .lg-search{display:flex;align-items:center;gap:10px;flex:1;min-width:0;padding-left:14px;border:1px solid #ffffff1c;border-radius:13px;background:#09141e;transition:border-color .18s,box-shadow .18s}
  .lg-search:focus-within{border-color:#4cc9ff8c;box-shadow:0 0 0 3px #4cc9ff17}
  .lg-search svg{width:17px;height:17px;flex:0 0 auto;fill:none;stroke:#7795a8;stroke-width:1.8;stroke-linecap:round}
  .lg-search input{width:100%;min-width:0;padding:13px 14px 13px 0;border:0;background:transparent;color:var(--text);outline:0;font:500 13.5px Inter,sans-serif}
  .lg-search input::placeholder{color:#5d7587}
  .lg-root select,.lg-field input,.lg-field textarea{width:100%;min-width:0;border:1px solid #ffffff1c;border-radius:12px;padding:12px 13px;background:#07121b;color:var(--text);outline:0;font:500 13px/1.4 Inter,sans-serif;transition:border-color .18s,box-shadow .18s}
  .lg-root select{width:auto;padding:0 12px;height:46px;background:#09141e;font-size:12.5px;cursor:pointer;appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,#7d97a9 50%),linear-gradient(135deg,#7d97a9 50%,transparent 50%);background-position:calc(100% - 17px) 20px,calc(100% - 12px) 20px;background-size:5px 5px;background-repeat:no-repeat;padding-right:30px}
  .lg-field select{width:100%;height:auto;padding-top:12px;padding-bottom:12px;background-color:#07121b;background-position:calc(100% - 17px) 50%,calc(100% - 12px) 50%}
  .lg-root select:focus,.lg-field input:focus,.lg-field textarea:focus{border-color:#4cc9ff8c;box-shadow:0 0 0 3px #4cc9ff17}
  .lg-root select option{background:#0b1620;color:#f5f8fb}
  .lg-filter-toggle{display:none;height:46px}
  .lg-filter-toggle span{display:inline-grid;place-items:center;min-width:19px;height:19px;border-radius:6px;background:var(--cyan);color:#04131c;font-size:10.5px}
  .lg-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  .lg-filters select{height:40px;font-size:12px;background-position:calc(100% - 17px) 17px,calc(100% - 12px) 17px}
  .lg-switch-chip{position:relative;cursor:pointer}
  .lg-switch-chip input{position:absolute;opacity:0;pointer-events:none}
  .lg-switch-chip span{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 13px;border:1px solid #ffffff1c;border-radius:12px;background:#09141e;color:#9db1c0;font-size:12px;font-weight:650;transition:.18s}
  .lg-switch-chip span::before{content:"";width:14px;height:14px;border-radius:5px;border:1.5px solid #4d6779;transition:.18s}
  .lg-switch-chip input:checked+span{border-color:#4cc9ff6e;background:#4cc9ff12;color:#b0eaff}
  .lg-switch-chip input:checked+span::before{background:var(--cyan);border-color:var(--cyan);box-shadow:inset 0 0 0 2.5px #09141e}
  .lg-switch-chip input:focus-visible+span{outline:2px solid var(--cyan);outline-offset:2px}
  .lg-meta-row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:4px 2px 14px;color:#7f97a8;font-size:12px}
  .lg-meta-actions{display:flex;gap:16px}
  .lg-note{color:var(--dim);font-size:11px}

  /* grids */
  .lg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
  .lg-grid-sm{grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}
  .lg-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
  .lg-featured{margin-bottom:22px;padding:16px 0 4px}
  .lg-rail-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}.lg-rail-head small{color:var(--dim);font-size:11.5px}
  .lg-rail{display:flex;gap:16px;overflow-x:auto;padding:4px 2px 14px;scroll-snap-type:x proximity;scrollbar-width:thin}
  .lg-rail>.lg-card{flex:0 0 min(380px,86vw);scroll-snap-align:start}

  /* badges */
  .lg-badge{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px;border:1px solid #ffffff12;border-radius:7px;background:#ffffff07;color:#b9cad6;font-size:9.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}
  .lg-badge.gold{color:#ffe29a;border-color:#f6c45344;background:linear-gradient(120deg,#f6c4531c,#f6c45308)}
  .lg-badge.cyan{color:#a6e8ff;border-color:#4cc9ff3a;background:#4cc9ff10}
  .lg-badge.mint{color:#9af0cf;border-color:#6ee7b73a;background:#6ee7b710}
  .lg-badge.amber{color:#f4d794;border-color:#f1c77940;background:#f1c7790e}
  .lg-badge.red{color:#ffb5ac;border-color:#ff8f8640;background:#ff8f860e}
  .lg-pulse{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 #4cc9ff99;animation:lg-pulse 1.8s infinite}
  .lg-verified{display:inline-grid;place-items:center;width:17px;height:17px;border-radius:50%;background:linear-gradient(140deg,#8fe9ff,#4cc9ff);color:#04131c;vertical-align:middle;flex:0 0 17px}
  .lg-verified svg{width:11px;height:11px;fill:none;stroke:currentColor;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}

  /* crest / avatar */
  .lg-crest,.lg-avatar{position:relative;display:grid;place-items:center;flex:0 0 58px;width:58px;height:58px;overflow:hidden;border-radius:16px;border:1px solid #4cc9ff30;background:radial-gradient(circle at 22% 12%,#4cc9ff26,transparent 65%),#0a1822;color:#8de1ff;font:800 14px 'Space Grotesk',sans-serif}
  .lg-crest img,.lg-avatar img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

  /* league card */
  .lg-card{position:relative;display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:22px;background:linear-gradient(155deg,rgba(18,33,47,.92),rgba(8,17,26,.98));box-shadow:0 18px 40px -30px #000;transition:transform .24s cubic-bezier(.2,.7,.2,1),border-color .24s,box-shadow .24s;animation:lg-rise .4s both;cursor:pointer}
  .lg-card:hover{transform:translateY(-4px);border-color:#4cc9ff4a;box-shadow:0 28px 54px -34px #000,0 0 40px -22px #4cc9ff90}
  .lg-card.is-featured{border-color:transparent;background:linear-gradient(155deg,#182638,#0a1520) padding-box,linear-gradient(140deg,#f6c453aa,#ffffff10 40%,#4cc9ff66) border-box;border:1px solid transparent}
  .lg-card.is-preview{pointer-events:none;cursor:default}
  .lg-card-glow{height:3px;background:linear-gradient(90deg,transparent,#4cc9ff88,#9a8cff55,transparent)}
  .lg-card.is-featured .lg-card-glow{background:linear-gradient(90deg,transparent,#f6c453cc,#ffffff30,transparent)}
  .lg-card-in{display:flex;flex-direction:column;flex:1;padding:18px}
  .lg-card-top{display:flex;align-items:flex-start;gap:13px}
  .lg-card-id{flex:1;min-width:0}
  .lg-card-id h3{display:flex;align-items:center;gap:7px;font-size:18px;line-height:1.2;letter-spacing:-.03em;overflow-wrap:anywhere}
  .lg-card-sub{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:6px;color:#8aa0b1;font-size:11.5px}
  .lg-dotsep{width:3px;height:3px;border-radius:50%;background:#52697b}
  .lg-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}
  .lg-tagline{margin:13px 0 0;color:#c4d3de;font-size:13px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
  .lg-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:13px}
  .lg-tag{display:inline-flex;align-items:center;height:25px;padding:0 9px;border:1px solid #ffffff0f;border-radius:8px;background:#ffffff05;color:#a9bdcc;font-size:10.5px;font-weight:650}
  .lg-tag.cyan{border-color:#4cc9ff24;background:#4cc9ff0a;color:#a2e5ff}
  .lg-stat-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:auto;padding:13px 0;border-top:1px solid #ffffff0d}
  .lg-card-in>.lg-tags+.lg-stat-row,.lg-card-in>.lg-tagline+.lg-stat-row{margin-top:16px}
  .lg-stat-row span{display:block;color:var(--dim);font-size:10px;margin-bottom:5px}
  .lg-stat-row strong{display:block;color:#e6eef4;font-size:12.5px;line-height:1.3;overflow-wrap:anywhere}
  .lg-card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:13px;border-top:1px solid #ffffff0d}
  .lg-signal{display:flex;align-items:center;gap:7px;min-width:0;color:#7f96a7;font-size:11px}
  .lg-signal i{flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:#52697b}
  .lg-signal i.hot{background:var(--mint);box-shadow:0 0 0 3px #6ee7b71c}
  .lg-signal span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lg-card-actions{display:flex;gap:7px;align-items:center}

  /* match ring */
  .lg-ring{--p:0;--c:var(--cyan);position:relative;flex:0 0 50px;width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--c) calc(var(--p)*1%),rgba(255,255,255,.08) 0)}
  .lg-ring::before{content:"";position:absolute;inset:4px;border-radius:50%;background:#0b1620}
  .lg-ring b{position:relative;font:700 12.5px 'Space Grotesk',sans-serif;letter-spacing:-.02em}
  .lg-ring small{position:absolute;bottom:-17px;left:50%;transform:translateX(-50%);white-space:nowrap;color:var(--dim);font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .lg-ring.great{--c:var(--mint)}.lg-ring.good{--c:var(--cyan)}.lg-ring.low{--c:var(--amber)}

  /* player card */
  .lg-pcard{position:relative;padding:17px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(155deg,rgba(18,33,47,.92),rgba(8,17,26,.98));animation:lg-rise .35s both;transition:border-color .2s,transform .2s}
  .lg-pcard:hover{border-color:#4cc9ff3e}
  .lg-pcard-head{display:flex;align-items:center;gap:12px}
  .lg-pcard .lg-avatar{flex-basis:46px;width:46px;height:46px;border-radius:14px;font-size:12px}
  .lg-pcard-id{flex:1;min-width:0}.lg-pcard-id h3{font-size:15px;line-height:1.2;overflow-wrap:anywhere}.lg-pcard-id p{margin-top:3px;color:#8197a8;font-size:11px}
  .lg-ovr{padding:7px 10px;border:1px solid #4cc9ff2e;border-radius:11px;background:#4cc9ff0c;color:#a6e8ff;font:800 14px 'Space Grotesk',sans-serif}
  .lg-pcard .lg-tags{margin:14px 0 0}
  .lg-pcard-note{margin-top:12px;color:#9db0be;font-size:11.5px;line-height:1.6;overflow-wrap:anywhere}
  .lg-pcard .lg-btn{width:100%;margin-top:14px}
  .lg-revealed{margin-top:13px;padding:13px;border:1px solid #6ee7b730;border-radius:13px;background:#6ee7b709;animation:lg-rise .25s both}
  .lg-revealed h4{margin-bottom:9px;color:#8be9c0;font:800 10px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase}
  .lg-kv{display:grid;grid-template-columns:70px minmax(0,1fr) auto;gap:7px 9px;align-items:center;font-size:11.5px}
  .lg-kv dt{color:#769183}.lg-kv dd{margin:0;color:#d9f2e7;overflow-wrap:anywhere}
  .lg-kv .lg-copy{border:0;background:#ffffff0c;color:#a9d9c3;font:700 10px Inter,sans-serif;padding:4px 8px;border-radius:7px;cursor:pointer}
  .lg-usage{display:flex;align-items:center;gap:12px;padding:11px 15px;border:1px solid #4cc9ff2a;border-radius:14px;background:#4cc9ff09}
  .lg-usage strong{font:700 17px 'Space Grotesk',sans-serif;color:#b0eaff}.lg-usage span{color:#b9c8d3;font-size:11.5px;line-height:1.4}.lg-usage small{display:block;color:var(--dim);font-size:10px;margin-top:2px}
  .lg-pips{display:flex;gap:5px}.lg-pips i{width:9px;height:26px;border-radius:5px;background:#ffffff14}.lg-pips i.on{background:linear-gradient(180deg,#9fe6ff,#4cc9ff);box-shadow:0 0 12px -2px #4cc9ff99}

  /* panels / forms */
  .lg-panel{animation:lg-rise .35s both}
  .lg-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px}
  .lg-panel-head h2{margin:10px 0 7px;font-size:clamp(24px,3.6vw,32px);line-height:1.08;letter-spacing:-.05em}
  .lg-panel-head.slim h2{margin-top:0}
  .lg-panel-head p{color:var(--muted);font-size:13.5px;line-height:1.7;max-width:640px}
  .lg-setup{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:24px;align-items:start;animation:lg-rise .4s both}
  .lg-setup-main{padding:clamp(20px,3.5vw,34px);border:1px solid transparent;border-radius:26px;background:linear-gradient(155deg,rgba(16,29,42,.98),rgba(8,17,26,.99)) padding-box,linear-gradient(145deg,#4cc9ff55,#ffffff0b 58%,#9a8cff30) border-box}
  .lg-setup-side{position:sticky;top:92px}
  .lg-preview-label{margin:0 0 12px 4px;color:var(--dim);font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .lg-back{display:block;margin-bottom:16px;padding:0;border:0;background:transparent;color:#7edbff;font:700 12px Inter,sans-serif;cursor:pointer}
  .lg-form{display:grid;gap:20px}
  .lg-field{display:grid;gap:8px;min-width:0;color:#d5e2eb;font-size:12px;font-weight:700}
  .lg-field>span{display:flex;gap:6px;align-items:center}
  .lg-field b,.lg-fieldset legend b{color:#83deff}
  .lg-field small{font-weight:500;color:#7f95a6;font-size:11px}
  .lg-help{margin-top:-2px;color:var(--amber)!important}
  .lg-field input::placeholder,.lg-field textarea::placeholder{color:#58707f}
  .lg-field input:disabled{opacity:.6;cursor:not-allowed}
  .lg-field textarea{resize:vertical;min-height:90px}
  .lg-fieldset{margin:0;padding:0;border:0;min-width:0}
  .lg-fieldset legend{margin-bottom:10px;padding:0;color:#d5e2eb;font-size:12px;font-weight:800}
  .lg-chips{display:flex;gap:8px;flex-wrap:wrap}
  .lg-chip{position:relative;cursor:pointer}
  .lg-chip input{position:absolute;opacity:0;pointer-events:none}
  .lg-chip span{display:inline-flex;align-items:center;min-height:36px;padding:0 13px;border:1px solid #ffffff18;border-radius:11px;background:#07121b;color:#9eb1c0;font-size:12px;font-weight:650;transition:.18s}
  .lg-chip:hover span{border-color:#4cc9ff45}
  .lg-chip input:checked+span{border-color:#4cc9ff77;background:#4cc9ff14;color:#a9e9ff}
  .lg-chip input:focus-visible+span{outline:2px solid var(--cyan);outline-offset:2px}
  .lg-upload-row{display:flex;align-items:center}
  .lg-upload{display:flex;align-items:center;gap:13px;flex:1;min-height:70px;padding:13px;border:1px dashed #4cc9ff44;border-radius:15px;background:#07121b;cursor:pointer;transition:border-color .18s,background .18s}
  .lg-upload:hover{border-color:#4cc9ff88;background:#0a1823}
  .lg-upload-icon{display:grid;place-items:center;width:38px;height:38px;border:1px solid #4cc9ff33;border-radius:11px;color:#93e1ff;font-size:19px}
  .lg-upload strong{display:block;color:#dce9f1;font-size:12px}.lg-upload small{display:block;margin-top:4px;color:#7d94a5;font-size:10.5px}
  .lg-upload input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
  .lg-checks{display:flex;gap:20px;flex-wrap:wrap}
  .lg-check{display:flex;align-items:center;gap:9px;color:#adbecb;font-size:12px;cursor:pointer}
  .lg-check input{accent-color:#4cc9ff;width:16px;height:16px}
  .lg-form-foot{display:flex;justify-content:space-between;align-items:center;gap:18px;padding-top:18px;border-top:1px solid var(--line)}
  .lg-form-foot p{max-width:520px;color:#8298a9;font-size:11.5px;line-height:1.65}
  .lg-msg{min-height:0;font-size:12.5px;color:var(--red)}.lg-msg:empty{display:none}.lg-msg.ok{color:#87e5b8}

  /* owner desk */
  .lg-owner-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:20px;align-items:start}
  .lg-box{padding:20px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(155deg,rgba(16,29,42,.9),rgba(9,18,27,.97))}
  .lg-box+.lg-box{margin-top:16px}
