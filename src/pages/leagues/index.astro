  const labelFrequency = (value) => ({ daily: 'Daily', most_days: 'Most days', several_weekly: 'Several times a week', weekly: 'Weekly', occasional: 'Occasional' })[value] || 'Schedule varies';
  const labelCommitment = (value) => ({ casual: 'Casual', regular: 'Regular play', competitive: 'Competitive' })[value] || 'Regular play';
  const activeTeamScreenshot = () => state.profile?.team_screenshot_url && Date.parse(state.profile.team_screenshot_expires_at || '') > Date.now() ? state.profile.team_screenshot_url : '';
  const toast = (message, error = false) => {
    const node = $('#toast'); node.textContent = message; node.classList.toggle('error', error); node.classList.add('show');
    window.clearTimeout(toast.timer); toast.timer = window.setTimeout(() => node.classList.remove('show'), 4200);
  };

  async function token() {
    const result = await accountAuth.auth.getSession();
    state.session = result.data?.session || null;
    return state.session?.access_token || '';
  }

  async function api(path, options = {}) {
    const accessToken = await token();
    const headers = new Headers(options.headers || {});
    if (accessToken) headers.set('authorization', 'Bearer ' + accessToken);
    if (options.body && !(options.body instanceof FormData) && !headers.has('content-type')) headers.set('content-type', 'application/json');
    const response = await fetch(path, { ...options, headers, credentials: 'same-origin', cache: 'no-store' });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'Something went wrong. Please try again.');
    return body;
  }

  function setLoading(on) { $('#loadingState').hidden = !on; }
  function showGate() { $('#loginGate').hidden = false; $('#workspace').hidden = true; $('#profileSetup').hidden = true; $('#listingEditor').hidden = true; }
  function selectedValues(form, name) { return [...form.querySelectorAll('input[name="' + name + '"]:checked')].map(input => input.value); }
  function hasOpenOwnerListing() { return (state.ownListings || []).some(row => ['pending','approved','paused'].includes(row.status)); }
  function canCreateOwnerListing() { return state.profile?.status === 'league_owner' && !hasOpenOwnerListing(); }
  function setChecks(form, name, values) { const list = Array.isArray(values) ? values : []; form.querySelectorAll('input[name="' + name + '"]').forEach(input => { input.checked = list.includes(input.value); }); }

  function fillProfileForm(profile, suggested) {
    const form = $('#profileForm');
    const p = profile || {};
    const s = suggested || {};
    form.elements.fcMobileUid.value = p.fc_mobile_uid || s.fcMobileUid || '';
    form.elements.inGameUsername.value = p.in_game_username || s.inGameUsername || '';
    form.elements.avatarUrl.value = p.avatar_url || '';
    $('#profileAvatarPreview').innerHTML = p.avatar_url ? '<img src="' + esc(p.avatar_url) + '" alt="">' : 'Player';
    const teamShotActive = Boolean(p.team_screenshot_url && Date.parse(p.team_screenshot_expires_at || '') > Date.now());
    form.elements.teamScreenshotUrl.value = teamShotActive ? p.team_screenshot_url : '';
    form.elements.teamScreenshotNote.value = teamShotActive ? (p.team_screenshot_note || '') : '';
    form.elements.showTeamToOwners.checked = teamShotActive && Boolean(p.team_screenshot_show_to_owners);
    $('#teamScreenshotPreview').innerHTML = teamShotActive ? '<img src="' + esc(p.team_screenshot_url) + '" alt="">' : 'SQUAD';
    $('#teamScreenshotExpiry').textContent = teamShotActive
      ? 'Temporary image expires ' + new Date(p.team_screenshot_expires_at).toLocaleString() + '.'
      : (p.team_screenshot_url ? 'Your previous screenshot has expired. Upload a fresh one.' : 'Or keep it private and send it to one league at a time.');
    form.elements.ovr.value = p.ovr || '';
    form.elements.regionServer.value = p.region_server || s.regionServer || '';
    form.elements.status.value = p.status || 'looking_for_league';
    form.elements.discordHandle.value = p.discord_handle || s.discordHandle || '';
    form.elements.availability.value = p.availability || '';
    form.elements.playStyle.value = p.play_style || '';
    form.elements.notes.value = p.notes || '';
    setChecks(form, 'preferredLanguages', p.preferred_languages || ['English']);
    setChecks(form, 'tournamentSizes', p.tournament_sizes || []);
    $('#profileSetupTitle').textContent = profile ? 'Update your league profile.' : 'Set up your league profile.';
  }

  function showProfileSetup(profile, suggested) {
    $('#workspace').hidden = true;
    $('#listingEditor').hidden = true;
    $('#profileSetup').hidden = false;
    $('#editProfileBtn').hidden = true;
    $('#listLeagueBtn').hidden = true;
    fillProfileForm(profile, suggested);
    window.scrollTo({ top: 0, behavior: 'smooth' });
