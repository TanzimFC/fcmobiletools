  let crestUp = null;
  function listingDraft() {
    const f = $('#lgListingForm'); const own = state.ownListings.find(r => r.id === state.editingId); const g = (n) => f.elements[n];
    return { id: 'preview', slug: '', name: g('name').value.trim() || own?.name || '', tagline: g('tagline').value.trim(), logoUrl: crestUp?.value() || null, regionServer: g('regionServer').value,
      division: f.querySelector('input[name=division]:checked')?.value || '', minOvr: Number(g('minOvr').value || 0), openSpots: Number(g('openSpots').value || 0), tournamentFrequency: g('tournamentFrequency').value,
      tournamentSizes: $$('input[name=tournamentSizes]:checked', f).map(i => i.value), joinMethods: $$('input[name=joinMethods]:checked', f).map(i => i.value), activeHours: g('activeHours').value.trim(),
      accent: f.querySelector('input[name=accent]:checked')?.value || 'cyan', verified: Boolean(own?.verified), reviewed: false, isSample: false, isMine: true, confirmations7d: 0, matchdays7d: 0, createdAt: new Date().toISOString() };
  }
  const renderListingPreview = () => { $('#lgListingPreview').innerHTML = leagueCard(listingDraft(), { preview: true }); };
  function syncConditional() {
    const f = $('#lgListingForm'); const j = $$('input[name=joinMethods]:checked', f).map(i => i.value);
    $('#condDiscord').hidden = !j.includes('discord'); $('#condGame').hidden = !j.includes('in_game');
    $('#lgPitchCount').textContent = f.elements.tagline.value.length + '/100';
  }
  function showView(name) {
    state.view = name; $('#lgEditor').hidden = name !== 'editor'; $('#lgWorkspace').hidden = name === 'editor'; $('#lgHero').hidden = name === 'editor';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  async function openEditor(row = null) {
    if (!state.signedIn) { location.href = signInUrl('/leagues/?tab=owner'); return; }
    if (!state.account?.emailConfirmed) { toast('Verify your email first, then list your league.', true); return; }
    state.editingId = row?.id || null;
    const f = $('#lgListingForm'); f.innerHTML = editorHtml(row);
    crestUp = mountUploader($('#crestSlot', f), { label: 'League crest', hint: 'Optional · square images look best', value: row?.logoUrl || '', permanent: true, onChange: () => renderListingPreview() });
    $('#lgEditorTitle').textContent = row ? 'Edit your league' : 'List your league';
    $('#lgEditorBack').textContent = '← Back';
    syncConditional(); renderListingPreview(); showView('editor');
  }
  async function submitListing(event) {
    event.preventDefault();
    const f = event.currentTarget; const msg = $('#lgListingMsg'); const btn = $('#lgListingSave'); msg.textContent = '';
    if (crestUp?.busy()) { msg.textContent = 'Your crest is still uploading. Wait for the tick.'; return; }
    if (!$$('input[name=tournamentSizes]:checked', f).length) { msg.textContent = 'Choose at least one tournament size.'; return; }
    if (!f.querySelector('input[name=division]:checked')) { msg.textContent = 'Choose your division.'; return; }
    if (!$$('input[name=joinMethods]:checked', f).length) { msg.textContent = 'Choose at least one way to join.'; return; }
    if (!f.reportValidity()) return;
    if (!state.editingId && !f.elements.acceptRules.checked) { msg.textContent = 'Agree to the league rules to list your league.'; return; }
    const g = (n) => f.elements[n].value.trim(); const d = listingDraft();
    const payload = { name: g('name'), tagline: g('tagline'), division: d.division, regionServer: g('regionServer'), minOvr: Number(g('minOvr')), openSpots: Number(g('openSpots')), tournamentFrequency: g('tournamentFrequency'),
      tournamentSizes: d.tournamentSizes, joinMethods: d.joinMethods, discordInviteUrl: g('discordInviteUrl'), leagueGameId: g('leagueGameId'), logoUrl: crestUp?.value() || '', activeHours: g('activeHours'),
      playerCommitment: g('playerCommitment'), perks: g('perks'), contactDiscord: g('contactDiscord'), preferredLanguages: $$('input[name=preferredLanguages]:checked', f).map(i => i.value), accent: d.accent,
      discordRequired: f.elements.discordRequired.checked, acceptRules: !state.editingId };
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const res = await api(state.editingId ? '/api/leagues/listings/' + encodeURIComponent(state.editingId) + '/update' : '/api/leagues/listings', { method: 'POST', body: JSON.stringify(payload) });
      state.editingId = null; toast(res.message || 'Saved.'); state.tab = 'owner'; showView('board'); await loadPersonal({ refreshPublic: true });
      if (res.url) setTimeout(() => toast('Your league page: ' + location.origin + res.url), 600);
    } catch (e) { msg.textContent = e.message; btn.disabled = false; btn.innerHTML = (state.editingId ? 'Save changes' : 'List my league') + ' <span aria-hidden="true">→</span>'; }
  }

  // ───────────── data loading ─────────────
  function ingestPublic(d) {
    if (state.loadedPersonal) return; state.leagues = (d.leagues || []).map(l => ({ ...l, saved: false })); state.spotlight = d.spotlight || []; }
  async function loadPublic({ silent = false } = {}) {
    try { ingestPublic(await api('/api/leagues/public', { cache: 'default' })); $('#lgError').hidden = true; $('#lgWorkspace').hidden = state.view === 'editor'; refresh(); }
    catch (e) { if (silent || state.leagues.length) return; $('#lgErrorMsg').textContent = e.message; $('#lgError').hidden = false; }
  }
  async function loadPersonal({ refreshPublic = false } = {}) {
    if (!(await token())) { state.signedIn = false; state.loadedPersonal = false; state.profile = null; state.ownListings = []; state.myApplications = []; state.canFindPlayers = false; refresh(); return; }
    try {
      const d = await api('/api/leagues/bootstrap');
      Object.assign(state, { signedIn: true, account: d.account, profile: d.profile, suggested: d.suggestedProfile || {}, ownListings: d.ownListings || [], ownerCrew: d.ownerCrew || [], crewReady: Boolean(d.crewReady),
        myCrew: d.myCrew || null, myApplications: d.myApplications || [], newApplications: d.newApplications || 0, canFindPlayers: Boolean(d.canFindPlayers), remaining: Number(d.outreachRemaining ?? 3), savedCount: Number(d.savedCount || 0) });
      state.leagues = d.leagues || []; state.spotlight = d.spotlight || []; state.loadedPersonal = true;
      if (d.directoryFailed) toast('Some leagues could not be loaded.', true);
      refresh();
      if (state.tab === 'inbox') loadInbox({ silent: true });
      if (state.tab === 'players') loadPlayers();
    } catch (e) {
      if (e.status === 401) { state.signedIn = false; refresh(); return; }
      toast(e.message, true); state.signedIn = true; refresh();
    }
  }

  // ───────────── events ─────────────
  function bindGlobal() {
    $('#lgRetry').addEventListener('click', () => loadPublic());
    $('#lgListCta').addEventListener('click', () => {
      if (!state.signedIn) { location.href = signInUrl('/leagues/?tab=owner'); return; }
      state.tab = 'owner'; renderTabs(); renderOwner(); const own = state.ownListings.find(r => r.status !== 'removed'); if (!own) openEditor();
    });
    $('#lgEditorBack').addEventListener('click', () => { state.editingId = null; showView('board'); });
    const form = $('#lgListingForm');
    form.addEventListener('submit', submitListing);
    form.addEventListener('input', () => { syncConditional(); renderListingPreview(); }); form.addEventListener('change', () => { syncConditional(); renderListingPreview(); });
    form.addEventListener('click', async e => { if (e.target.closest('#lgReadRules')) { e.preventDefault(); if (await openRulesSheet()) { const c = $('#lgAcceptRules'); if (c) c.checked = true; } } });
    document.addEventListener('error', e => { if (e.target?.tagName === 'IMG' && e.target.closest?.('.lg-root') && !e.target.classList.contains('lg-up-thumb')) e.target.remove(); }, true);

    $('#lgInboxForm').addEventListener('submit', sendInboxMessage);
    $('#app').addEventListener('click', async e => {
      const t = e.target;
      const tab = t.closest('[data-tab]'); if (tab) { setTab(tab.dataset.tab); return; }
      const go = t.closest('[data-goto]'); if (go) { setTab(go.dataset.goto); return; }
      const save = t.closest('[data-save]'); if (save) { toggleSave(save.dataset.save); return; }
      const copy = t.closest('[data-copy]'); if (copy) { try { await navigator.clipboard.writeText(copy.dataset.copy); toast((copy.dataset.label || 'Text') + ' copied.'); } catch { toast('Copy failed.', true); } return; }
      const link = t.closest('[data-copy-link]'); if (link) { try { await navigator.clipboard.writeText(location.origin + link.dataset.copyLink); toast('League link copied.'); } catch { toast('Copy failed.', true); } return; }
      const rev = t.closest('[data-reveal]'); if (rev) { revealPlayer(rev.dataset.reveal, rev); return; }
      const wd = t.closest('[data-withdraw]'); if (wd) { wd.disabled = true; try { await api('/api/leagues/applications/' + encodeURIComponent(wd.dataset.withdraw) + '/withdraw', { method: 'POST', body: '{}' }); toast('Application withdrawn.'); await loadPersonal(); } catch (err) { toast(err.message, true); wd.disabled = false; } return; }
      if (t.closest('#lgEditProfile')) { const p = await openProfileSheet({ profile: state.profile, suggested: state.suggested }); if (p) { state.profile = p; refresh(); } return; }
      if (t.closest('[data-create-listing]')) { openEditor(); return; }
      if (t.closest('[data-edit-listing]')) { openEditor(state.ownListings[0]); return; }
      const sp = t.closest('[data-spots]'); if (sp) { const own = state.ownListings[0]; const n = Math.max(0, Math.min(50, Number(own?.openSpots || 0) + Number(sp.dataset.spots))); if (own && n !== own.openSpots) quickUpdate({ openSpots: n }); return; }
      if (t.closest('#lgRecruitToggle')) { const own = state.ownListings[0]; if (own) quickUpdate({ recruitingOpen: !own.recruitingOpen }); return; }
      const kick = t.closest('[data-kick]'); if (kick) { doKickoff(kick.dataset.kick, kick); return; }
      const ap = t.closest('[data-app]'); if (ap) { decideApp(ap.dataset.app, ap.dataset.status, ap); return; }
      const message = t.closest('[data-message-listing]'); if (message) { requestInboxAccess(() => openInboxForListing(message.dataset.messageListing, message.dataset.applicant || '')); return; }
      const conv = t.closest('[data-inbox-thread]'); if (conv) { state.activeConversationId = conv.dataset.inboxThread; state.inboxMessages = []; renderInbox(); loadInboxMessages(); return; }
      if (t.closest('#lgInboxRefresh') || t.closest('#lgInboxRetry')) { loadInbox(); return; }
      const appeal = t.closest('[data-appeal-listing]'); if (appeal) { openListingAppeal(appeal.dataset.appealListing); return; }
      if (t.closest('#lgAppsRetry')) { loadOwnerApps(); return; }
      const cd = t.closest('[data-crew-decide]'); if (cd) { postOwner('crew-decide', { accountId: cd.dataset.account, action: cd.dataset.crewDecide }, 'Updated.', cd); return; }
      const card = t.closest('.lg-card:not(.is-preview)');
      if (card && !t.closest('a,button,input,select,textarea,label,[data-info],[data-save]')) {
        const link = card.querySelector('.lg-card-id h3 a, .lg-card-actions a');
        if (link?.href) { location.assign(link.href); return; }
      }

    });
    setInterval(() => {
      const nodes = $$('[data-until]'); let expired = false;
      for (const n of nodes) { const left = Number(n.dataset.until) - Date.now(); if (left <= 0) expired = true; else n.textContent = clock(left); }
      if (expired && state.tab === 'owner') renderOwner();
    }, 30000);
  }

  // ───────────── start ─────────────
  buildOptions(); bindFilters(); bindGlobal(); bindInfo();
  try {
    const boot = JSON.parse(document.getElementById('lgBoot')?.textContent || 'null');
    if (boot?.leagues) ingestPublic(boot);
  } catch { /* the live request below fills the board */ }
  const urlTab = new URLSearchParams(location.search).get('tab'); if (urlTab) state.tab = urlTab;
  renderHero(); renderTabs(); renderLeagues();
  loadPublic({ silent: true });
  loadPersonal().then(() => {
    if (urlTab === 'owner' && state.signedIn) { state.tab = 'owner'; renderTabs(); renderOwner(); if (!state.ownListings.find(r => r.status !== 'removed') && !sessionStorageFlag()) openEditor(); }
    if (urlTab === 'inbox') {
      if (state.signedIn) requestInboxAccess(() => activateTab('inbox'));
      else location.href = signInUrl('/leagues/?tab=inbox');
    }
  });
  function sessionStorageFlag() { try { if (sessionStorage.getItem('lg-ed')) return true; sessionStorage.setItem('lg-ed', '1'); return false; } catch { return false; } }
  accountAuth.auth.onAuthStateChange((event) => {
    if (event === 'SIGNED_OUT') { state.signedIn = false; state.loadedPersonal = false; state.profile = null; state.ownListings = []; state.inboxThreads = []; state.inboxMessages = []; state.activeConversationId = null; state.savedCount = 0; loadPublic({ silent: true }); refresh(); }
    if (event === 'SIGNED_IN' && !state.signedIn) loadPersonal();
  });
</script>
