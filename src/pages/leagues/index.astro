    const sheet = openSheet('<h3>Appeal league suspension</h3><p class="lg-sub">Explain what happened and what you have changed. Keep it specific and respectful.</p>' +
      '<label class="lg-field"><span>Reason <b>*</b></span><textarea id="lgAppealReason" rows="5" maxlength="1200" minlength="20" placeholder="Describe why the suspension should be reviewed…" required></textarea></label>' +
      '<div class="lg-msg" id="lgAppealMsg" role="alert"></div><div class="lg-modal-actions"><button class="lg-btn lg-btn-quiet" type="button" data-sheet-close>Cancel</button><button class="lg-btn lg-btn-primary" type="button" id="lgAppealSend">Send appeal</button></div>', { label: 'League suspension appeal', wide: true });
    $('#lgAppealSend', sheet.el).addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const reason = $('#lgAppealReason', sheet.el).value.trim();
      const msg = $('#lgAppealMsg', sheet.el);
      if (reason.length < 20) { msg.textContent = 'Add at least 20 characters so the review team has enough context.'; return; }
      button.disabled = true; button.textContent = 'Sending…';
      try {
        const result = await api('/api/leagues/listings/' + encodeURIComponent(id) + '/appeal', {
          method: 'POST', body: JSON.stringify({ reason })
