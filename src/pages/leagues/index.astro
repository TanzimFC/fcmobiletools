  function filterLeagues() {
    const q = $('#leagueSearch').value.trim().toLowerCase();
    const region = $('#regionFilter').value.toLowerCase();
    const frequency = $('#frequencyFilter').value;
    const size = $('#sizeFilter').value;
    const squadOvr = $('#squadOvrFilter').value;
    const maxOvr = squadOvr === 'my' ? Number(state.profile?.ovr || 0) : (squadOvr ? Number(squadOvr) : Infinity);
    const rows = state.leagues.filter(row => {
      const full = [row.name,row.description,row.regionServer,(row.preferredLanguages || []).join(' '),row.owner?.displayName].join(' ').toLowerCase();
      return (!q || full.includes(q)) && (!region || String(row.regionServer || '').toLowerCase() === region) &&
        (!frequency || row.tournamentFrequency === frequency) && (!size || (row.tournamentSizes || []).includes(size)) &&
        row.minOvr <= maxOvr;
    });
    $('#leagueCount').textContent = fmt(state.leagues.length);
    $('#resultsLabel').textContent = rows.length + (rows.length === 1 ? ' league matches your filters' : ' leagues match your filters');
    $('#leagueList').innerHTML = rows.map(leagueCard).join('');
    $('#leagueEmpty').hidden = rows.length > 0;
    $('#leagueList').hidden = rows.length === 0;
    $('#openListingBtn').hidden = !canCreateOwnerListing();
    $('#emptyListBtn').hidden = !canCreateOwnerListing();
    $('#leagueList').querySelectorAll('.fl-active-confirm').forEach(button => button.addEventListener('click', () => confirmLeague(button)));
  }

  function showTab(which) {
    state.activeTab = which;
    const leagues = which === 'leagues';
    const players = which === 'players';
    const teams = which === 'teams';
    $('#tabLeagues').classList.toggle('active', leagues);
    $('#tabLeagues').setAttribute('aria-selected', String(leagues));
    $('#tabPlayers').classList.toggle('active', players);
    $('#tabPlayers').setAttribute('aria-selected', String(players));
    $('#tabTeams').classList.toggle('active', teams);
    $('#tabTeams').setAttribute('aria-selected', String(teams));
    $('#leagueView').hidden = !leagues;
    $('#playersView').hidden = !players;
    $('#teamsView').hidden = !teams;
    $('#ownerPanel').hidden = !leagues || state.profile?.status !== 'league_owner';
    if (players) loadPlayers();
    if (teams) loadTeamShares();
  }

  function ownerDesk() {
    const list = state.ownListings || [];
    $('#ownerPanel').hidden = state.profile?.status !== 'league_owner';
    $('#ownerCreate').hidden = true;
    $('#ownerPending').hidden = true;
    $('#ownerListing').innerHTML = '';
    $('#listLeagueBtn').hidden = !canCreateOwnerListing();
    if (state.profile?.status !== 'league_owner') return;
    if (!list.length) { $('#ownerCreate').hidden = false; return; }
    const row = list[0];
    if (row.status === 'pending') {
      $('#ownerPending').hidden = false;
      $('#ownerListing').innerHTML = ownerListingCard(row, false);
      return;
    }
    $('#ownerListing').innerHTML = ownerListingCard(row, row.status === 'approved' && row.recruitingOpen);
    if (row.status === 'rejected') {
      $('#ownerCreate').hidden = false;
      $('#ownerCreate').querySelector('strong').textContent = 'Your listing needs changes.';
      $('#ownerCreate').querySelector('p').textContent = row.moderationNote || 'Review the listing and submit it again.';
    }
    if (row.status === 'paused') {
      $('#ownerCreate').hidden = true;
    }
    if (row.status === 'removed') {
      $('#ownerCreate').hidden = false;
      $('#ownerCreate').querySelector('strong').textContent = 'Your listing was removed.';
      $('#ownerCreate').querySelector('p').textContent = row.moderationNote || 'You can submit a new listing when your club is ready.';
    }
  }

  function ownerListingCard(row, canKickoff) {
    const statusClass = row.status === 'approved' ? '' : ' ' + esc(row.status);
    const statusLabel = ({ approved: 'Live', pending: 'Awaiting review', rejected: 'Changes requested', paused: 'Paused', removed: 'Removed' })[row.status] || row.status;
    const nextKickoffAt = row.lastKickoffAt ? Date.parse(row.lastKickoffAt) + 6 * 60 * 60 * 1000 : 0;
    const kickCooldown = nextKickoffAt > Date.now();
    const kickText = row.status !== 'approved'
      ? 'Kickoff becomes available after approval'
      : kickCooldown
        ? 'Next Kickoff available ' + esc(new Date(nextKickoffAt).toLocaleString())
        : 'Ready for Kickoff';
    return '<div class="fl-owner-listing">' + avatarMarkup(row.logoUrl, row.name, 'fl-club-logo') +
      '<div class="fl-owner-listing-main"><strong>' + esc(row.name) + ' <span class="fl-status-pill' + statusClass + '">' + esc(statusLabel) + '</span></strong>' +
      '<p>' + esc(row.regionServer) + ' · ' + esc(labelFrequency(row.tournamentFrequency)) + ' · ' + esc((row.tournamentSizes || []).join(', ')) + '<br>' + (row.moderationNote ? esc(row.moderationNote) : '') + '</p></div>' +
      '<div class="fl-owner-listing-actions">' +
      (row.status !== 'removed' ? '<button type="button" class="fl-small-btn fl-edit-listing" data-edit-listing="' + esc(row.id) + '">Edit details</button>' : '') +
      (canKickoff ? '<button type="button" class="fl-small-btn kickoff" id="kickoffBtn" ' + (kickCooldown ? 'disabled' : '') + '><span class="fl-kickoff-icon">↗</span> ' + (kickCooldown ? 'Kickoff cooling down' : 'Kickoff') + '</button>' : '') +
      '<span class="fl-confirm-note">' + kickText + '</span>' +
      '</div></div>';
  }

  async function refreshBootstrap() {
    const data = await api('/api/leagues/bootstrap');
    state.account = data.account;
    state.profile = data.profile;
    state.leagues = data.leagues || [];
    state.ownListings = data.ownListings || [];
    state.canFindPlayers = Boolean(data.canFindPlayers);
    state.outreachRemaining = Number(data.outreachRemaining ?? Math.max(0, 3 - Number(data.outreachUsedToday || 0)));
    $('#signedInAs').textContent = data.account?.displayName || data.account?.username || 'Signed in';
    if (!data.profile) {
      showProfileSetup(null, data.suggestedProfile);
      return;
    }
    $('#profileSetup').hidden = true;
    $('#workspace').hidden = false;
    $('#editProfileBtn').hidden = false;
    $('#listLeagueBtn').hidden = !canCreateOwnerListing();
    $('#tabPlayers').hidden = !state.canFindPlayers;
    $('#tabTeams').hidden = !state.canFindPlayers;
    $('#outreachRemaining').textContent = String(state.outreachRemaining);
    filterLeagues();
    ownerDesk();
    if (state.canFindPlayers && state.profile.status === 'league_owner') $('#tabPlayers').hidden = false;
  }

