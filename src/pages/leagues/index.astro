  function avatarMarkup(url, name, className) {
    const fallback = '<span>' + esc(initials(name)) + '</span>';
    return '<div class="' + className + '">' + (url ? '<img src="' + esc(url) + '" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">' : fallback) + '</div>';
  }

  function leagueCard(row, index) {
    const logo = row.logoUrl ? '<img src="' + esc(row.logoUrl) + '" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">' : esc(initials(row.name));
    const languages = (row.preferredLanguages || []).slice(0, 3).map(value => '<span class="fl-tag">' + esc(value) + '</span>').join('');
    const sizes = (row.tournamentSizes || []).map(value => '<span class="fl-tag cyan">' + esc(value) + '</span>').join('');
    const ownerAvatar = row.owner?.avatarUrl ? '<img src="' + esc(row.owner.avatarUrl) + '" alt="" loading="lazy" onerror="this.remove()">' : '';
    const kickoff = row.lastKickoffAt && row.kickoffActive ? '<span class="fl-status-pill"><span class="fl-kickoff-icon">↗</span> KICKOFF ACTIVE</span>' : '<span class="fl-status-pill">RECRUITING</span>';
    const demoBadge = row.isDemo ? '<span class="fl-status-pill demo">SAMPLE</span>' : '';
    const invite = row.discordInviteUrl ? '<a class="fl-small-btn external" href="' + esc(row.discordInviteUrl) + '" target="_blank" rel="noopener noreferrer">Apply / Join ↗</a>' : '';
    const contactDiscord = row.contactDiscord ? '<button class="fl-small-btn" data-contact-discord="' + esc(row.contactDiscord) + '" type="button">Copy Discord</button>' : '';
    const activeText = row.lastActiveAt ? 'Last confirmed ' + esc(new Date(row.lastActiveAt).toLocaleDateString()) : 'Awaiting first activity check';
    const activeLabel = row.confirmedByMe ? 'Confirmed · 24h' : 'League active';
    const myShare = row.myTeamShare;
    const activeShare = Boolean(myShare && Date.parse(myShare.expiresAt || '') > Date.now() && ['pending','accepted'].includes(myShare.status));
    const shareLabel = activeShare ? (myShare.status === 'accepted' ? 'Team accepted' : 'Team sent · awaiting review') : 'Send team screenshot';
    const sendTeamButton = state.profile?.status === 'looking_for_league'
      ? '<button class="fl-small-btn fl-send-team" data-id="' + esc(row.id) + '" type="button" ' + (activeShare ? 'disabled' : '') + '>' + shareLabel + '</button>'
      : '';
    return '<article class="fl-league-card" style="animation-delay:' + Math.min(index * 35, 210) + 'ms"><div class="fl-card-accent"></div><div class="fl-card-inner">' +
      '<div class="fl-card-top">' +
      '<div class="fl-club-logo">' + logo + '</div>' +
      '<div class="fl-card-ident"><h3>' + esc(row.name) + '</h3><div class="fl-card-sub"><span>' + esc(row.regionServer) + '</span><i class="fl-dot-sep"></i><span>' + fmt(row.openSpots) + ' spots open</span></div></div>' +
      kickoff + demoBadge + '</div>' +
      '<p class="fl-card-desc">' + esc(row.description) + '</p>' +
      '<div class="fl-card-tags">' + sizes + languages + '</div>' +
      '<div class="fl-card-stats"><div><span>Minimum OVR</span><strong>' + fmt(row.minOvr) + '+ OVR</strong></div><div><span>Tournament rhythm</span><strong>' + esc(labelFrequency(row.tournamentFrequency)) + '</strong></div><div><span>Club culture</span><strong>' + esc(labelCommitment(row.playerCommitment)) + '</strong></div></div>' +
      '<div class="fl-card-bottom"><div class="fl-owner-line">' + ownerAvatar + '<span>Managed by ' + esc(row.owner?.displayName || 'FC Mobile player') + '</span></div><div class="fl-card-actions">' +
      '<button class="fl-small-btn fl-active-confirm" data-id="' + esc(row.id) + '" type="button" ' + (row.confirmedByMe ? 'disabled' : '') + '>' + activeLabel + '</button>' + sendTeamButton + invite + contactDiscord +
      '</div></div><div class="fl-confirm-note">' + activeText + (row.discordRequired ? ' · Discord required' : ' · Discord optional') + '</div>' +
      '</div></article>';
