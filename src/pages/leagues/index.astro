  async function uploadImage(file, previewNode, hiddenInput, lifetime = 'permanent') {
    if (!file) return '';
    const accepted = ['image/jpeg','image/png','image/webp','image/gif'];
    if (!accepted.includes(file.type) || file.size > 8 * 1024 * 1024) throw new Error('Use a JPG, PNG, WebP or GIF image smaller than 8 MB.');
    const accessToken = await token();
    if (!accessToken) throw new Error('Sign in again before uploading an image.');
    const body = new FormData(); body.append('file', file);
    if (lifetime === 'temporary') body.append('expirationDays', '7');
    else body.append('permanent', 'true');
    const response = await fetch('/api/account/image-upload', { method: 'POST', headers: { authorization: 'Bearer ' + accessToken }, body, credentials: 'same-origin', cache: 'no-store' });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.error || 'Image upload failed. Please try again.');
    const url = result.image?.url || result.url || result.imageUrl || result.data?.url || result.data?.display_url || '';
    if (!url) throw new Error('Image upload did not return a usable image URL.');
    if (previewNode) previewNode.innerHTML = '<img src="' + esc(url) + '" alt="">';
    if (hiddenInput) hiddenInput.value = url;
    return url;
  }

  async function confirmLeague(button) {
    button.disabled = true;
    try {
      const result = await api('/api/leagues/listings/' + encodeURIComponent(button.dataset.id) + '/active', { method: 'POST', body: '{}' });
      toast('Thanks. You confirmed this league is active.');
      const row = state.leagues.find(item => item.id === button.dataset.id);
      if (row) { row.lastActiveAt = result.confirmedAt || new Date().toISOString(); row.confirmedByMe = true; }
      filterLeagues();
    } catch (error) {
      toast(error.message || 'Unable to confirm this league.', true);
      button.disabled = false;
    }
  }

  async function submitTeamToLeague(button) {
    const listingId = button.dataset.id;
    if (!activeTeamScreenshot()) {
      toast('Upload a current team screenshot in My player profile first.', true);
      openLeagueProfile();
      return;
    }
    button.disabled = true;
    try {
      const result = await api('/api/leagues/listings/' + encodeURIComponent(listingId) + '/team-share', {
        method: 'POST',
        body: JSON.stringify({})
      });
      const row = state.leagues.find(item => item.id === listingId);
      if (row) {
        row.myTeamShare = {
          id: result.share?.id || '',
          status: 'pending',
          submittedAt: result.share?.submitted_at || new Date().toISOString(),
          expiresAt: result.share?.expires_at || new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString()
        };
      }
      filterLeagues();
      toast('Team screenshot sent to ' + (result.leagueName || 'the league') + '. It expires within 7 days.');
    } catch (error) {
      toast(error.message || 'Could not send your team screenshot.', true);
      button.disabled = false;
    }
  }

  function renderTeamShares() {
    const rows = state.teamShares || [];
    $('#teamSubmissionCount').textContent = String(rows.filter(row => row.status === 'pending').length);
    $('#teamShareResultsLabel').textContent = rows.length + (rows.length === 1 ? ' current submission' : ' current submissions');
    $('#teamShareList').innerHTML = rows.map((share, index) => {
      const p = share.player || {};
      const statusLabel = ({ pending: 'Awaiting review', accepted: 'Accepted', declined: 'Declined' })[share.status] || share.status;
      const statusClass = share.status === 'accepted' ? '' : (share.status === 'pending' ? ' pending' : ' rejected');
      const shot = '<a class="fl-team-shot" href="' + esc(share.screenshotUrl) + '" target="_blank" rel="noopener noreferrer" aria-label="Open squad screenshot for ' + esc(p.displayName || 'player') + '"><img src="' + esc(share.screenshotUrl) + '" loading="lazy" alt="Temporary FC Mobile squad screenshot" referrerpolicy="no-referrer"></a>';
      const tags = (p.tournamentSizes || []).map(size => '<span class="fl-tag cyan">' + esc(size) + '</span>').join('') +
        (p.preferredLanguages || []).slice(0, 3).map(lang => '<span class="fl-tag">' + esc(lang) + '</span>').join('');
      const action = share.status === 'pending'
        ? '<button class="fl-small-btn accept" data-team-review="accepted" data-id="' + esc(share.id) + '" type="button">Accept team</button><button class="fl-small-btn decline" data-team-review="declined" data-id="' + esc(share.id) + '" type="button">Decline</button>'
        : '';
      return '<article class="fl-team-share-card" style="animation-delay:' + Math.min(index * 35, 210) + 'ms">' + shot +
        '<div class="fl-team-share-body"><div class="fl-team-share-top"><div><h3>' + esc(p.displayName || 'FC Mobile player') + '</h3><div class="fl-team-share-meta">@' + esc(p.username || 'player') + ' · ' + esc(p.regionServer || 'Region not set') + '<br>' + fmt(p.ovr) + ' OVR · Sent ' + esc(new Date(share.submittedAt).toLocaleDateString()) + '</div></div><span class="fl-status-pill' + statusClass + '">' + esc(statusLabel) + '</span></div>' +
        '<div class="fl-card-tags" style="margin-top:11px">' + tags + '</div>' +
        '<div class="fl-team-share-meta" style="margin-top:10px">League: ' + esc(share.listingName) + ' · Screenshot expiry: ' + esc(new Date(share.expiresAt).toLocaleDateString()) + '</div>' +
        (share.playerNote ? '<div class="fl-team-share-note">' + esc(share.playerNote) + '</div>' : '') +
        (share.reviewNote ? '<div class="fl-team-share-note">Review note: ' + esc(share.reviewNote) + '</div>' : '') +
        '<div class="fl-team-share-actions">' + action + '</div></div></article>';
    }).join('');
    $('#teamShareList').hidden = rows.length === 0;
    $('#teamShareEmpty').hidden = rows.length > 0;
  }

  async function loadTeamShares() {
    $('#teamShareList').innerHTML = '<div class="fl-skeleton"></div><div class="fl-skeleton"></div>';
    $('#teamShareList').hidden = false;
    $('#teamShareEmpty').hidden = true;
    try {
      const result = await api('/api/leagues/team-shares');
      state.teamShares = result.shares || [];
      renderTeamShares();
    } catch (error) {
      state.teamShares = [];
      $('#teamShareList').innerHTML = '';
      $('#teamShareList').hidden = true;
      $('#teamShareEmpty').hidden = false;
      $('#teamShareEmpty').querySelector('h3').textContent = 'Team submissions are unavailable.';
      $('#teamShareEmpty').querySelector('p').textContent = error.message || 'Refresh and try again.';
    }
  }

  async function reviewTeamShare(button) {
    button.disabled = true;
    try {
      await api('/api/leagues/team-shares/' + encodeURIComponent(button.dataset.id) + '/review', {
        method: 'POST',
        body: JSON.stringify({ status: button.dataset.teamReview })
      });
      toast(button.dataset.teamReview === 'accepted' ? 'Team submission accepted.' : 'Team submission declined.');
      await loadTeamShares();
    } catch (error) {
      toast(error.message || 'Could not update this submission.', true);
      button.disabled = false;
    }
  }

  async function loadPlayers() {
    $('#playerList').innerHTML = '<div class="fl-skeleton"></div><div class="fl-skeleton"></div><div class="fl-skeleton"></div>';
    try {
      const params = new URLSearchParams();
      if ($('#playerSearch').value.trim()) params.set('q', $('#playerSearch').value.trim());
      if ($('#playerRegionFilter').value) params.set('region', $('#playerRegionFilter').value);
      if ($('#playerSizeFilter').value) params.set('size', $('#playerSizeFilter').value);
      params.set('minOvr', $('#playerMinOvr').value || '50');
      const data = await api('/api/leagues/players?' + params.toString());
      state.players = data.players || [];
      $('#outreachRemaining').textContent = String(state.outreachRemaining);
      renderPlayers();
    } catch (error) {
      $('#playerList').innerHTML = '<div class="fl-empty"><h3>Player search is unavailable.</h3><p>' + esc(error.message) + '</p></div>';
    }
  }

  function renderPlayers() {
    const rows = state.players;
    $('#playerResultsLabel').textContent = rows.length + (rows.length === 1 ? ' player found' : ' players found');
    $('#playerList').innerHTML = rows.map((row, index) => {
      const tags = (row.tournamentSizes || []).map(size => '<span class="fl-tag cyan">' + esc(size) + '</span>').join('') +
        (row.preferredLanguages || []).slice(0, 2).map(lang => '<span class="fl-tag">' + esc(lang) + '</span>').join('');
      const squadPreview = row.teamScreenshotUrl
        ? '<a class="fl-inline-squad" href="' + esc(row.teamScreenshotUrl) + '" target="_blank" rel="noopener noreferrer"><img src="' + esc(row.teamScreenshotUrl) + '" loading="lazy" alt="" referrerpolicy="no-referrer"><span>Open shared squad screenshot</span></a>'
        : '';
      const revealed = state.revealed.get(row.accountId);
      const revealPanel = revealed ? '<div class="fl-revealed"><h4>Contact details</h4><dl><dt>UID</dt><dd>' + esc(revealed.fcMobileUid) + '</dd><dt>In-game name</dt><dd>' + esc(revealed.inGameUsername) + '</dd><dt>Discord</dt><dd>' + esc(revealed.discordHandle || 'Not provided') + '</dd><dt>Region</dt><dd>' + esc(revealed.regionServer) + '</dd></dl></div>' : '';
      return '<article class="fl-player-card" style="animation-delay:' + Math.min(index * 25, 150) + 'ms">' +
        '<div class="fl-player-head">' + avatarMarkup(row.avatarUrl, row.displayName, 'fl-player-avatar') +
        '<div class="fl-player-id"><h3>' + esc(row.displayName) + '</h3><p>@' + esc(row.username) + ' · ' + esc(row.regionServer) + '</p></div><div class="fl-player-ovr">' + fmt(row.ovr) + '</div></div>' +
        '<div class="fl-player-tags">' + tags + '</div>' +
        '<p class="fl-player-note">' + esc(row.availability || 'Availability not specified') + (row.playStyle ? ' · ' + esc(row.playStyle) : '') + '</p>' +
        (row.notes ? '<p class="fl-player-note">' + esc(row.notes) + '</p>' : '') +
        squadPreview +
        (row.teamScreenshotNote && row.teamScreenshotUrl ? '<p class="fl-player-note">' + esc(row.teamScreenshotNote) + '</p>' : '') +
        '<button type="button" class="fl-small-btn fl-player-reveal" data-id="' + esc(row.accountId) + '" ' + (state.outreachRemaining <= 0 && !revealed ? 'disabled' : '') + '>' + (revealed ? 'Contact already unlocked' : 'Unlock contact · uses 1 daily contact') + '</button>' +
        revealPanel + '</article>';
    }).join('');
    $('#playerEmpty').hidden = rows.length > 0;
    $('#playerList').hidden = rows.length === 0;
    $('#playerList').querySelectorAll('.fl-player-reveal').forEach(button => button.addEventListener('click', () => revealPlayer(button)));
  }

  async function revealPlayer(button) {
    const playerId = button.dataset.id;
    button.disabled = true;
    try {
      const result = await api('/api/leagues/players/' + encodeURIComponent(playerId) + '/reveal', { method: 'POST', body: '{}' });
      state.revealed.set(playerId, result.player);
      state.outreachRemaining = Number(result.remainingToday || 0);
      $('#outreachRemaining').textContent = String(state.outreachRemaining);
      renderPlayers();
      toast(result.alreadyRevealed ? 'Contact details restored.' : 'Contact details unlocked. Reach out respectfully.');
    } catch (error) {
      toast(error.message || 'Contact details could not be unlocked.', true);
      button.disabled = false;
      if (/daily limit/i.test(error.message)) { state.outreachRemaining = 0; $('#outreachRemaining').textContent = '0'; renderPlayers(); }
    }
  }

  async function initialize() {
    setLoading(true);
    try {
      const accessToken = await token();
      if (!accessToken) {
        setLoading(false);
        showGate();
        return;
      }
      const data = await api('/api/leagues/bootstrap');
      state.account = data.account;
      state.profile = data.profile;
      if (!data.profile) {
        $('#loadingState').hidden = true;
        state.leagues = [];
        showProfileSetup(null, data.suggestedProfile);
        return;
      }
      await refreshBootstrap();
    } catch (error) {
      showGate();
      $('#loginGate').querySelector('p').textContent = error.message || 'Sign in to browse the league board.';
    } finally {
      setLoading(false);
    }
  }

  $('#profileForm').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const button = $('#saveProfileBtn');
    button.disabled = true; button.textContent = 'Saving profile…';
    formMessage('#profileMessage', '');
    const payload = {
      fcMobileUid: form.elements.fcMobileUid.value.trim(),
      inGameUsername: form.elements.inGameUsername.value.trim(),
      avatarUrl: form.elements.avatarUrl.value,
      teamScreenshotUrl: form.elements.teamScreenshotUrl.value,
      teamScreenshotNote: form.elements.teamScreenshotNote.value.trim(),
      showTeamToOwners: form.elements.showTeamToOwners.checked,
      ovr: Number(form.elements.ovr.value),
      regionServer: form.elements.regionServer.value,
      status: form.elements.status.value,
      discordHandle: form.elements.discordHandle.value.trim(),
      availability: form.elements.availability.value,
      playStyle: form.elements.playStyle.value,
      notes: form.elements.notes.value.trim(),
      preferredLanguages: selectedValues(form, 'preferredLanguages'),
      tournamentSizes: selectedValues(form, 'tournamentSizes')
    };
    try {
      const result = await api('/api/leagues/profile', { method: 'POST', body: JSON.stringify(payload) });
      state.profile = result.profile;
      toast('Player profile saved.');
      await refreshBootstrap();
    } catch (error) {
      formMessage('#profileMessage', error.message || 'Unable to save your profile.', true);
    } finally {
      button.disabled = false; button.innerHTML = 'Save player profile <span aria-hidden="true">→</span>';
    }
  });

  $('#listingForm').addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const button = $('#submitListingBtn');
    button.disabled = true; button.textContent = 'Submitting…';
    formMessage('#listingMessage', '');
    try {
      const payload = {
        name: form.elements.name.value.trim(),
        leagueGameId: form.elements.leagueGameId.value.trim(),
        description: form.elements.description.value.trim(),
        logoUrl: form.elements.logoUrl.value,
        regionServer: form.elements.regionServer.value,
        minOvr: Number(form.elements.minOvr.value),
        tournamentFrequency: form.elements.tournamentFrequency.value,
        tournamentSizes: selectedValues(form, 'tournamentSizes'),
        preferredLanguages: selectedValues(form, 'preferredLanguages'),
        playerCommitment: form.elements.playerCommitment.value,
        weeklyRewards: form.elements.weeklyRewards.value.trim(),
        discordInviteUrl: form.elements.discordInviteUrl.value.trim(),
        contactDiscord: form.elements.contactDiscord.value.trim(),
        openSpots: Number(form.elements.openSpots.value),
        discordRequired: form.elements.discordRequired.checked,
        recruitingOpen: form.elements.recruitingOpen.checked
      };
      const endpoint = state.editingListingId
        ? '/api/leagues/listings/' + encodeURIComponent(state.editingListingId) + '/update'
        : '/api/leagues/listings';
      const result = await api(endpoint, { method: 'POST', body: JSON.stringify(payload) });
      state.editingListingId = null;
      toast(result.message || (result.status === 'pending' ? 'Changes submitted for review.' : 'League submitted. It will appear after review.'));
      $('#listingEditor').hidden = true;
      $('#workspace').hidden = false;
      await refreshBootstrap();
    } catch (error) {
      formMessage('#listingMessage', error.message || 'Unable to submit your league.', true);
    } finally {
      button.disabled = false; button.innerHTML = 'Submit for approval <span aria-hidden="true">→</span>';
    }
  });

  $('#profileAvatarFile').addEventListener('change', async event => {
    const file = event.currentTarget.files?.[0];
    if (!file) return;
    $('#saveProfileBtn').disabled = true;
    formMessage('#profileMessage', 'Uploading player avatar…');
    try {
      await uploadImage(file, $('#profileAvatarPreview'), $('#profileForm').elements.avatarUrl);
      formMessage('#profileMessage', 'Avatar uploaded.');
    } catch (error) {
      formMessage('#profileMessage', error.message, true);
    } finally {
      $('#saveProfileBtn').disabled = false;
    }
  });

  $('#teamScreenshotFile').addEventListener('change', async event => {
    const file = event.currentTarget.files?.[0];
    if (!file) return;
    $('#saveProfileBtn').disabled = true;
    formMessage('#profileMessage', 'Uploading temporary squad screenshot…');
    try {
      await uploadImage(file, $('#teamScreenshotPreview'), $('#profileForm').elements.teamScreenshotUrl, 'temporary');
      $('#teamScreenshotExpiry').textContent = 'Temporary screenshot uploaded. It will expire after 7 days. Save your profile to apply the visibility setting.';
      formMessage('#profileMessage', 'Squad screenshot uploaded. Save your profile to finish.');
    } catch (error) {
      formMessage('#profileMessage', error.message, true);
    } finally {
      $('#saveProfileBtn').disabled = false;
    }
  });

  $('#leagueLogoFile').addEventListener('change', async event => {
    const file = event.currentTarget.files?.[0];
    if (!file) return;
    $('#submitListingBtn').disabled = true;
    formMessage('#listingMessage', 'Uploading crest…');
    try {
      state.logoUrl = await uploadImage(file, $('#leagueLogoPreview'), $('#listingForm').elements.logoUrl);
      formMessage('#listingMessage', 'Crest uploaded.');
    } catch (error) {
      formMessage('#listingMessage', error.message, true);
    } finally {
      $('#submitListingBtn').disabled = false;
    }
  });

  $('#tabLeagues').addEventListener('click', () => showTab('leagues'));
  $('#tabPlayers').addEventListener('click', () => { if (state.canFindPlayers) showTab('players'); });
  $('#editProfileBtn').addEventListener('click', openLeagueProfile);
  $('#listLeagueBtn').addEventListener('click', openListingEditor);
  $('#openListingBtn').addEventListener('click', openListingEditor);
  $('#emptyListBtn').addEventListener('click', openListingEditor);
  $('#createListingBtn').addEventListener('click', openListingEditor);
  $('#cancelListing').addEventListener('click', () => { $('#listingEditor').hidden = true; $('#workspace').hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); });
  $('#leagueList').addEventListener('click', async event => {
    const button = event.target.closest('[data-contact-discord]');
    if (!button) return;
    const value = button.dataset.contactDiscord || '';
    try {
      await navigator.clipboard.writeText(value);
      toast('Discord contact copied.');
    } catch {
      toast('Copy failed. Discord handle: ' + value, true);
    }
  });

  $('#leagueSearch').addEventListener('input', filterLeagues);
  $('#regionFilter').addEventListener('change', filterLeagues);
  $('#frequencyFilter').addEventListener('change', filterLeagues);
  $('#sizeFilter').addEventListener('change', filterLeagues);
  $('#squadOvrFilter').addEventListener('change', filterLeagues);
  $('#clearFilters').addEventListener('click', () => { $('#leagueSearch').value = ''; $('#regionFilter').value = ''; $('#frequencyFilter').value = ''; $('#sizeFilter').value = ''; $('#squadOvrFilter').value = 'my'; filterLeagues(); });
  $('#playerSearch').addEventListener('input', () => { window.clearTimeout(window.playerSearchTimer); window.playerSearchTimer = window.setTimeout(loadPlayers, 180); });
  $('#playerRegionFilter').addEventListener('change', loadPlayers);
  $('#playerSizeFilter').addEventListener('change', loadPlayers);
  $('#playerMinOvr').addEventListener('change', loadPlayers);
  $('#ownerPanel').addEventListener('click', async event => {
    const button = event.target.closest('#kickoffBtn');
    if (!button) return;
    const row = (state.ownListings || [])[0];
    if (!row) return;
    button.disabled = true;
    try {
      const result = await api('/api/leagues/listings/' + encodeURIComponent(row.id) + '/kickoff', { method: 'POST', body: '{}' });
      toast('Kickoff complete. Your league is back in the spotlight.');
      row.lastKickoffAt = result.lastKickoffAt || new Date().toISOString();
      ownerDesk();
    } catch (error) {
      toast(error.message || 'Kickoff is not available yet.', true);
      button.disabled = false;
      refreshBootstrap().catch(() => {});
    }
  });

  accountAuth.auth.onAuthStateChange((event, session) => {
    if (event === 'SIGNED_OUT') showGate();
    if (event === 'SIGNED_IN' && session?.access_token && !state.profile) initialize();
  });

  initialize();
</script>
