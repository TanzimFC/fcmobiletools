    $('#submitListingBtn').innerHTML = row ? 'Resubmit for approval <span aria-hidden="true">→</span>' : 'Submit for approval <span aria-hidden="true">→</span>';
    window.scrollTo({ top: 0, behavior: 'smooth' });
