---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/league-hub.css';
import '../../styles/league-premium.css';
import { loadPublicDirectory, ssrSupabaseRest } from '../../lib/leaguePublic.js';
import { DIVISIONS, divisionIcon, divisionRange, SITE_ORIGIN } from '../../data/leagueConfig.js';
import { leagueCard, leagueHref, esc, infoBtn, ICON } from '../../lib/league-card.js';

// Rendered on demand and cached at the edge by the Worker. Real league cards are in the HTML
// so search engines and slow connections see them before any script runs.
export const prerender = false;

const env = Astro.locals.runtime?.env || {};
let board = { leagues: [], spotlight: [], stats: { leagues: 0, spots: 0 } };
let loadFailed = false;
try { board = await loadPublicDirectory(env, ssrSupabaseRest); } catch (e) { loadFailed = true; console.error('[LEAGUES_PAGE]', e?.message); }
if (loadFailed) Astro.response.headers.set('cache-control', 'no-store');

const ssrLeagues = board.leagues.slice(0, 24);
const real = board.leagues;
const regions = new Set(real.map(l => l.regionServer)).size;
const boot = JSON.stringify({ ...board, at: Date.now() }).replace(/</g, '\\u003c');

const faq = [
  ['How do I join an FC Mobile league?', 'Pick a league with open spots, check the minimum OVR and tap Apply. Add a screenshot of your team so the owner can see your squad. Some leagues also use a Discord link or a league ID you can search in the game.'],
  ['What is the minimum OVR for a league?', 'Every league sets its own minimum OVR. Enter your team OVR on this page to see only the leagues you qualify for.'],
  ['What are league divisions?', 'Divisions group leagues by level: Bronze 1,050 to 2,000, Silver 2,100 to 4,000, World Class 4,100 to 6,000, Legendary 6,100 to 8,000 and FC Champions 8,100 to 10,000.'],
  ['What is the difference between Verified and Reviewed?', 'A Verified club is confirmed as a real, active club by FCMobiletools. A Reviewed listing was checked by the team but is not a verification.'],
  ['Can I list my own league?', 'Yes. Any player can list one league for free. Sign in, agree to the rules and fill in your division, minimum OVR, open spots and how to join.']
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'FC Mobile leagues with open spots', url: SITE_ORIGIN + '/leagues/',
    description: 'Browse FC Mobile leagues by division, region and minimum OVR.',
    mainEntity: { '@type': 'ItemList', itemListElement: ssrLeagues.slice(0, 20).map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE_ORIGIN + leagueHref(l), name: l.name })) } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_ORIGIN + '/' },
    { '@type': 'ListItem', position: 2, name: 'Leagues', item: SITE_ORIGIN + '/leagues/' } ] }
];
---

<BaseLayout
  title="FC Mobile Leagues: Find a League with Open Spots"
  description="Browse FC Mobile leagues by division, region and minimum OVR. See open spots, schedules and how to join, then apply with your team screenshot. Free to use."
>
  {schema.map(s => <script slot="head" type="application/ld+json" set:html={JSON.stringify(s)}></script>)}

  <main class="app fl lg-root" id="app" data-page="find-a-league">
    <div class="lg-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="lg-wrap">

      <header class="lg-hero" id="lgHero">
        <div class="lg-hero-copy">
          <div class="lg-eyebrow live"><i></i> FC MOBILE LEAGUES · LIVE BOARD</div>
          <h1>Find an FC Mobile league <em>with open spots.</em></h1>
          <p>See division, minimum OVR, open spots and schedule on every league. Browse freely. Sign in when you are ready to apply and we will show you the leagues that fit.</p>
          <div class="lg-hero-cta">
            <button class="lg-btn lg-btn-primary lg-btn-lg" id="lgListCta" type="button">List your league <Fragment set:html={ICON.arrow} /></button>
            <button class="lg-btn lg-btn-glass lg-btn-lg" id="lgPalBtn" type="button"><Fragment set:html={ICON.search} />Quick search <kbd>Ctrl K</kbd></button>
          </div>
        </div>
        <div class="lg-hero-side" aria-label="Board at a glance">
          <div class="lg-hud">
            <svg class="lg-pitch" viewBox="0 0 320 200" aria-hidden="true">
              <defs><linearGradient id="lgPg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5df2b0" stop-opacity=".9"/><stop offset="1" stop-color="#35c8ff" stop-opacity=".9"/></linearGradient></defs>
              <g fill="none" stroke="url(#lgPg)" stroke-width="1.2" stroke-opacity=".55">
                <rect x="8" y="8" width="304" height="184" rx="10"/><path d="M160 8v184"/><circle cx="160" cy="100" r="26"/>
                <rect x="8" y="58" width="44" height="84" rx="3"/><rect x="268" y="58" width="44" height="84" rx="3"/>
                <rect x="8" y="80" width="18" height="40" rx="2"/><rect x="294" y="80" width="18" height="40" rx="2"/>
              </g>
              <g class="lg-pitch-nodes"><circle cx="70" cy="60" r="4"/><circle cx="110" cy="130" r="4"/><circle cx="160" cy="76" r="4"/><circle cx="214" cy="120" r="4"/><circle cx="250" cy="64" r="4"/></g>
              <path class="lg-pitch-run" d="M70 60 Q 110 40 160 76 T 250 64" fill="none" stroke="url(#lgPg)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="5 7"/>
            </svg>
            <div class="lg-stats" id="lgStats">
              <div><strong id="statLeagues">{real.length}</strong><span>Leagues</span></div>
              <div><strong id="statSpots">{real.reduce((n, l) => n + l.openSpots, 0)}</strong><span>Open spots</span></div>
              <div><strong id="statRegions">{regions}</strong><span>Regions</span></div>
            </div>
          </div>
          <div class="lg-me" id="lgMe" hidden></div>
        </div>
      </header>

      <section class="lg-gate" id="lgError" hidden>
        <div class="lg-gate-mark warn" aria-hidden="true">!</div>
        <h2>We could not load the leagues.</h2>
        <p id="lgErrorMsg">Check your connection and try again.</p>
        <button class="lg-btn lg-btn-primary" id="lgRetry" type="button">Try again</button>
      </section>

      <div class="lg-activity" id="lgActivityNotice" hidden></div>
      <nav class="lg-tabs" id="lgTabs" role="tablist" aria-label="Leagues sections" hidden></nav>

      <div id="lgWorkspace">
        <section id="panelLeagues" aria-label="Discover leagues">
          <div id="lgForYou" class="lg-rail-block" hidden></div>

          <section class="lg-finder" aria-label="Find a league">
            <div class="lg-finder-main">
              <label class="lg-search"><Fragment set:html={ICON.search} /><input id="fQ" type="search" placeholder="Search league name, region or language" autocomplete="off" aria-label="Search leagues" /><kbd>/</kbd></label>
              <label class="lg-ovrbox"><span>My OVR</span><input id="fOvr" type="number" inputmode="numeric" min="50" max="200" placeholder="e.g. 118" aria-label="My team OVR" /><button type="button" id="fUseMine" class="lg-link" hidden>Use mine</button></label>
              <select id="fRegion" aria-label="Region"></select>
              <select id="fSort" aria-label="Sort leagues"></select>
            </div>
            <div class="lg-tiers" id="lgTiers" role="group" aria-label="Division">
              {DIVISIONS.map(d => <button type="button" class="lg-tier" data-div={d.key}><img src={divisionIcon(d.key)} alt="" width="30" height="30" /><span><b>{d.label}</b><small>{divisionRange(d)}</small></span></button>)}
            </div>
            <div class="lg-finder-row">
              <label class="lg-togglechip"><input id="fSpots" type="checkbox" /><span>Open spots only</span></label>
              <button type="button" class="lg-chipbtn" id="fMoreBtn" aria-expanded="false" aria-controls="fMore">More filters <em id="fCount" hidden></em></button>
              <div class="lg-active" id="lgChips"></div>
              <button type="button" class="lg-link" id="lgClear" hidden>Clear all</button>
              <button type="button" class="lg-link" id="fShare" title="Copy a link to this search">Copy search link</button>
              <button type="button" class="lg-info" data-info="division" aria-label="About divisions">i</button>
            </div>
            <div class="lg-more-panel" id="fMore" hidden>
              <label class="lg-field"><span>Schedule</span><select id="fFreq"></select></label>
              <label class="lg-field"><span>Tournament size</span><select id="fSize"></select></label>
              <label class="lg-field"><span>Language</span><select id="fLang"></select></label>
              <label class="lg-field"><span>Style</span><select id="fCommit"></select></label>
              <label class="lg-field"><span>How to join</span><select id="fJoin"></select></label>
              <label class="lg-togglechip"><input id="fVerified" type="checkbox" /><span>Verified clubs only</span></label>
            </div>
          </section>

          <section class="lg-rail-block" id="lgSpot" hidden>
            <div class="lg-rail-head"><div><span class="lg-eyebrow gold"><i></i>COMMUNITY SPOTLIGHT</span><h2>Leagues with real activity this week</h2></div><button type="button" class="lg-info" data-info="spotlight" aria-label="About Spotlight">i</button></div>
            <div class="lg-rail" id="lgRail"></div>
          </section>

          <div class="lg-resultsbar"><p class="lg-results" id="lgResults" aria-live="polite"><b>{real.length}</b> leagues recruiting</p><p class="lg-ovrnote" id="lgOvrNote" hidden></p></div>
          <div id="lgGrid" class="lg-grid"><Fragment set:html={ssrLeagues.map((l, i) => leagueCard(l, { index: i, showSave: false })).join('')} /></div>
          <div class="lg-empty" id="lgEmpty" hidden>
            <div class="lg-empty-art" aria-hidden="true"><i></i><i></i><i></i></div>
            <h3 id="lgEmptyTitle">No leagues match these filters</h3><p id="lgEmptyText">Loosen a filter or clear them all.</p>
            <button class="lg-btn lg-btn-primary" id="lgEmptyReset" type="button">Clear filters</button>
          </div>
        </section>

        <section id="panelSaved" hidden></section>
        <section id="panelApps" hidden></section>
        <section id="panelInbox" hidden></section>
        <section id="panelPlayers" hidden></section>
        <section id="panelOwner" hidden></section>
      </div>

      <section class="lg-editor" id="lgEditor" hidden aria-label="League listing">
        <div class="lg-editor-top"><button class="lg-btn lg-btn-glass lg-btn-sm" id="lgEditorBack" type="button">← Back</button><div><span class="lg-eyebrow"><i></i>LISTING</span><h2 id="lgEditorTitle">List your league</h2></div></div>
        <div class="lg-steps wide" id="lgEdSteps" role="list"></div>
        <div class="lg-editor-grid">
          <div class="lg-editor-main">
            <div class="lg-callout" id="lgEdRestored" hidden><strong>Draft restored.</strong> We kept what you typed last time. <button type="button" class="lg-link" id="lgEdRestartDraft">Start over</button></div>
            <form id="lgListingForm" class="lg-form" novalidate></form>
            <div class="lg-msg" id="lgListingMsg" role="alert"></div>
            <div class="lg-modal-actions between"><button class="lg-btn lg-btn-quiet" id="lgEdBack" type="button">Cancel</button><button class="lg-btn lg-btn-primary" id="lgListingSave" type="submit" form="lgListingForm">Next</button></div>
          </div>
          <aside class="lg-editor-side">
            <div class="lg-preview-label">Live preview</div>
            <div id="lgListingPreview"></div>
            <div class="lg-health-mini" id="lgEdHealth"></div>
          </aside>
        </div>
      </section>

      <section class="lg-faq" aria-labelledby="lgFaqH">
        <h2 id="lgFaqH">FC Mobile leagues: quick answers</h2>
        {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </section>
    </div>
    <script id="lgBoot" type="application/json" set:html={boot}></script>
  </main>
</BaseLayout>

<script>
  import { startBoard } from '../../lib/league-board.js';
  startBoard();
</script>
