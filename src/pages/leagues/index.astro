---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Find a League | FCMobiletools"
  description="Find an FC Mobile league that fits your squad and play style, or recruit players for your league."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="fl-page">
    <div class="fl-wrap">
      <header class="fl-heading">
        <div class="fl-title-block">
          <div class="fl-eyebrow"><span></span> FC MOBILE COMMUNITY</div>
          <h1>Find a <em>League.</em></h1>
          <p>The right squad. The right rhythm. Start with a club that plays your way.</p>
        </div>
        <div class="fl-heading-actions">
          <button class="fl-btn fl-btn-quiet" id="editProfileBtn" type="button" hidden>My player profile</button>
          <button class="fl-btn fl-btn-primary" id="listLeagueBtn" type="button" hidden>+ List your league</button>
        </div>
      </header>

      <section class="fl-gate" id="loginGate" hidden>
        <div class="fl-gate-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M24 4 41 11v12c0 10-6.8 17-17 21C13.8 40 7 33 7 23V11L24 4Z"/><path d="m16 24 5 5 11-12"/></svg>
        </div>
        <h2>Your next club is one sign-in away.</h2>
        <p>Sign in to browse leagues, keep your player profile ready and contact league owners.</p>
        <a class="fl-btn fl-btn-primary" href="/account/?next=%2Fleagues%2F">Sign in or create account <span aria-hidden="true">↗</span></a>
      </section>

      <section class="fl-gate" id="loadingState" aria-live="polite">
        <div class="fl-spinner" aria-hidden="true"></div>
        <p>Getting the league board ready…</p>
      </section>

      <section class="fl-profile-setup" id="profileSetup" hidden>
        <div class="fl-setup-top">
          <div>
            <span class="fl-eyebrow"><span></span> PLAYER CARD</span>
            <h2 id="profileSetupTitle">Set up your league profile.</h2>
            <p>This profile is only for Find a League. It won't change your normal account profile or player database.</p>
          </div>
          <span class="fl-step">01 <i>/</i> PROFILE</span>
        </div>
        <form id="profileForm" class="fl-form">
          <div class="fl-form-grid">
            <label class="fl-field"><span>FC Mobile UID <b>*</b></span><input name="fcMobileUid" required minlength="3" maxlength="64" autocomplete="off" placeholder="Your in-game UID"></label>
            <label class="fl-field"><span>In-game username <b>*</b></span><input name="inGameUsername" required minlength="2" maxlength="40" placeholder="Your FC Mobile name"></label>
            <label class="fl-field"><span>Current OVR <b>*</b></span><input name="ovr" type="number" inputmode="numeric" min="50" max="200" required placeholder="e.g. 123"></label>
            <label class="fl-field"><span>Region / server <b>*</b></span>
              <select name="regionServer" required>
                <option value="">Choose region</option><option>Asia</option><option>Europe</option><option>North America</option><option>South America</option><option>Africa</option><option>Middle East</option><option>Other</option>
              </select>
            </label>
            <label class="fl-field"><span>What describes you? <b>*</b></span>
              <select name="status" required>
                <option value="looking_for_league">Looking for a league</option>
                <option value="in_a_league">Already in a league</option>
                <option value="league_owner">League owner</option>
                <option value="not_looking">Just browsing for now</option>
              </select>
            </label>
            <label class="fl-field"><span>Discord handle <small>Optional</small></span><input name="discordHandle" maxlength="100" placeholder="name or @name"></label>
            <label class="fl-field"><span>Availability</span>
              <select name="availability"><option value="">Choose your usual availability</option><option>Daily</option><option>Most days</option><option>Weekends</option><option>Evenings</option><option>Flexible</option><option>Casual / whenever</option></select>
            </label>
            <label class="fl-field"><span>Play style</span>
              <select name="playStyle"><option value="">Choose a play style</option><option>Competitive</option><option>Active and relaxed</option><option>Casual</option><option>Quest focused</option><option>Building a new team</option></select>
            </label>
          </div>
          <div class="fl-upload-row">
            <label class="fl-upload" for="profileAvatarFile"><span class="fl-upload-icon">↑</span><span><strong>Player avatar</strong><small>Optional JPG, PNG, WebP or GIF · under 8 MB</small></span><input id="profileAvatarFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></label>
            <div id="profileAvatarPreview" class="fl-logo-preview">Player</div>
            <input type="hidden" name="avatarUrl">
          </div>
          <div class="fl-upload-row">
            <label class="fl-upload" for="teamScreenshotFile"><span class="fl-upload-icon">↑</span><span><strong>Temporary squad screenshot</strong><small>JPG, PNG, WebP or GIF · under 8 MB · expires after 7 days</small></span><input id="teamScreenshotFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></label>
            <div id="teamScreenshotPreview" class="fl-logo-preview">SQUAD</div>
            <input type="hidden" name="teamScreenshotUrl">
          </div>
          <div class="fl-team-options">
            <label class="fl-check-line"><input type="checkbox" name="showTeamToOwners"><span>Show my squad to approved league owners searching for players</span></label>
            <span id="teamScreenshotExpiry" class="fl-team-expiry">Or keep it private and send it to one league at a time.</span>
          </div>
          <label class="fl-field"><span>Note with your team screenshot <small>Optional</small></span><textarea name="teamScreenshotNote" rows="2" maxlength="300" placeholder="Formation, play style, or what the league should know about this squad."></textarea></label>
          <fieldset class="fl-choice-group">
            <legend>Preferred languages</legend>
            <div class="fl-choice-row">
              <label><input type="checkbox" name="preferredLanguages" value="English" checked><span>English</span></label>
              <label><input type="checkbox" name="preferredLanguages" value="Bengali"><span>Bengali</span></label>
              <label><input type="checkbox" name="preferredLanguages" value="Indonesian"><span>Indonesian</span></label>
              <label><input type="checkbox" name="preferredLanguages" value="Arabic"><span>Arabic</span></label>
              <label><input type="checkbox" name="preferredLanguages" value="Spanish"><span>Spanish</span></label>
              <label><input type="checkbox" name="preferredLanguages" value="Other"><span>Other</span></label>
            </div>
          </fieldset>
          <fieldset class="fl-choice-group">
            <legend>Tournament sizes you'd play</legend>
            <div class="fl-choice-row">
              <label><input type="checkbox" name="tournamentSizes" value="4v4"><span>4v4</span></label>
              <label><input type="checkbox" name="tournamentSizes" value="8v8"><span>8v8</span></label>
              <label><input type="checkbox" name="tournamentSizes" value="16v16"><span>16v16</span></label>
              <label><input type="checkbox" name="tournamentSizes" value="32v32"><span>32v32</span></label>
            </div>
          </fieldset>
          <label class="fl-field"><span>Anything league owners should know? <small>Optional</small></span><textarea name="notes" rows="3" maxlength="500" placeholder="Preferred tournament rhythm, what you're looking for, or other details."></textarea></label>
          <div class="fl-profile-actions">
            <p>Contact details are shown only to approved league owners when you choose “Looking for a league”.</p>
            <button class="fl-btn fl-btn-primary" type="submit" id="saveProfileBtn">Save player profile <span aria-hidden="true">→</span></button>
          </div>
          <div class="fl-form-message" id="profileMessage" role="status"></div>
        </form>
      </section>

      <div class="fl-workspace" id="workspace" hidden>
        <div class="fl-tabs" role="tablist" aria-label="League directory">
          <button class="fl-tab active" id="tabLeagues" type="button" role="tab" aria-selected="true">Find a League <span id="leagueCount">0</span></button>
          <button class="fl-tab" id="tabPlayers" type="button" role="tab" aria-selected="false" hidden>Find Players</button>
          <button class="fl-tab" id="tabTeams" type="button" role="tab" aria-selected="false" hidden>Team submissions <span id="teamSubmissionCount">0</span></button>
          <span class="fl-tabs-spacer"></span>
          <span class="fl-account-chip"><i></i><span id="signedInAs">Signed in</span></span>
        </div>

        <section class="fl-view" id="leagueView">
          <div class="fl-directory-head">
            <div>
              <h2>Find your fit.</h2>
              <p>Browse current recruitment posts. Kickoff gives a club a temporary lift, not a permanent top spot.</p>
            </div>
            <button class="fl-btn fl-btn-outline" id="openListingBtn" type="button" hidden>List your league</button>
          </div>
          <div class="fl-filters">
            <label class="fl-search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="leagueSearch" type="search" placeholder="Search league name, language or region" aria-label="Search leagues"></label>
            <select id="regionFilter" aria-label="Filter region"><option value="">All regions</option><option>Asia</option><option>Europe</option><option>North America</option><option>South America</option><option>Africa</option><option>Middle East</option><option>Other</option></select>
            <select id="frequencyFilter" aria-label="Filter tournament rhythm"><option value="">Any tournament rhythm</option><option value="daily">Daily</option><option value="most_days">Most days</option><option value="several_weekly">Several times a week</option><option value="weekly">Weekly</option><option value="occasional">Occasional</option></select>
            <select id="sizeFilter" aria-label="Filter tournament size"><option value="">Any size</option><option value="4v4">4v4</option><option value="8v8">8v8</option><option value="16v16">16v16</option><option value="32v32">32v32</option></select>
            <select id="squadOvrFilter" aria-label="Filter by squad OVR"><option value="my" selected>My OVR</option><option value="">Any OVR</option><option value="110">110 OVR</option><option value="115">115 OVR</option><option value="120">120 OVR</option><option value="125">125 OVR</option><option value="130">130 OVR</option></select>
          </div>
          <div class="fl-results-meta"><span id="resultsLabel">Latest league listings</span><button type="button" class="fl-reset" id="clearFilters">Clear filters</button></div>
          <div id="leagueList" class="fl-league-grid">
            <div class="fl-skeleton"></div><div class="fl-skeleton"></div><div class="fl-skeleton"></div>
          </div>
          <div class="fl-empty" id="leagueEmpty" hidden>
            <span class="fl-empty-icon" aria-hidden="true">⌕</span><h3>No matching leagues yet.</h3><p>Try a wider filter, or help the directory grow by listing your club.</p>
            <button class="fl-btn fl-btn-outline" id="emptyListBtn" type="button" hidden>List your league</button>
          </div>
        </section>

        <section class="fl-view" id="playersView" hidden>
          <div class="fl-directory-head">
            <div><h2>Recruit your next player.</h2><p>Player search is available to approved league owners. Contact details unlock one at a time.</p></div>
            <div class="fl-usage"><strong id="outreachRemaining">3</strong><span>player contacts left today <small>Resets at 00:00 UTC</small></span></div>
          </div>
          <div class="fl-filters fl-player-filters">
            <label class="fl-search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><input id="playerSearch" type="search" placeholder="Search player or region" aria-label="Search players"></label>
            <select id="playerRegionFilter" aria-label="Filter player region"><option value="">All regions</option><option>Asia</option><option>Europe</option><option>North America</option><option>South America</option><option>Africa</option><option>Middle East</option><option>Other</option></select>
            <select id="playerSizeFilter" aria-label="Preferred tournament size"><option value="">Any size</option><option value="4v4">4v4</option><option value="8v8">8v8</option><option value="16v16">16v16</option><option value="32v32">32v32</option></select>
            <select id="playerMinOvr" aria-label="Minimum player OVR"><option value="50">Any OVR</option><option value="100">100+ OVR</option><option value="110">110+ OVR</option><option value="120">120+ OVR</option><option value="125">125+ OVR</option></select>
          </div>
          <div class="fl-results-meta"><span id="playerResultsLabel">Players looking for a league</span><span class="fl-private-note">UID and Discord stay hidden until you unlock a contact.</span></div>
          <div id="playerList" class="fl-player-grid"></div>
          <div class="fl-empty" id="playerEmpty" hidden><span class="fl-empty-icon" aria-hidden="true">⌕</span><h3>No players match those filters.</h3><p>Try a wider region or tournament-size filter.</p></div>
        </section>

        <section class="fl-view" id="teamsView" hidden>
          <div class="fl-directory-head">
            <div><h2>Squads sent to your league.</h2><p>Team screenshots are temporary. Review the lineup, then accept or decline the submission. Private UID and Discord details stay protected by player-contact limits.</p></div>
          </div>
          <div class="fl-results-meta"><span id="teamShareResultsLabel">Current team submissions</span><span class="fl-private-note">Screenshots expire after 7 days</span></div>
          <div id="teamShareList" class="fl-team-share-grid"></div>
          <div class="fl-empty" id="teamShareEmpty" hidden><span class="fl-empty-icon" aria-hidden="true">⌕</span><h3>No active team submissions.</h3><p>When players send their current squad to your league, their screenshots will appear here.</p></div>
        </section>

        <section class="fl-owner-panel" id="ownerPanel" hidden>
          <div class="fl-owner-head"><div><span class="fl-eyebrow"><span></span> OWNER DESK</span><h2>Your league</h2><p>Keep your listing current. Kickoff is available every six hours.</p></div><span class="fl-owner-mark" aria-hidden="true">FC</span></div>
          <div id="ownerListing"></div>
          <div class="fl-owner-create" id="ownerCreate" hidden>
            <div><strong>Bring your club to the board.</strong><p>Every new league listing is reviewed before it appears in search.</p></div>
            <button class="fl-btn fl-btn-primary" id="createListingBtn" type="button">Create league listing <span aria-hidden="true">→</span></button>
          </div>
          <div class="fl-owner-create" id="ownerPending" hidden>
            <div><strong>Your listing is with the review team.</strong><p>You can keep browsing while we review your league details.</p></div>
            <span class="fl-status-pill">Awaiting review</span>
          </div>
        </section>
      </div>

      <section class="fl-listing-editor" id="listingEditor" hidden>
        <div class="fl-editor-heading"><button class="fl-back" type="button" id="cancelListing">← Back to leagues</button><span class="fl-eyebrow"><span></span> CLUB APPLICATION</span><h2>Put your league on the board.</h2><p>Clear, accurate details attract the players who actually fit your club. Your listing goes live after approval.</p></div>
        <form id="listingForm" class="fl-form">
          <div class="fl-form-grid">
            <label class="fl-field"><span>League name <b>*</b></span><input name="name" required minlength="3" maxlength="70" placeholder="Your club's name"></label>
            <label class="fl-field"><span>League UID / in-game ID</span><input name="leagueGameId" maxlength="64" placeholder="Optional"></label>
            <label class="fl-field"><span>Region / server <b>*</b></span><select name="regionServer" required><option value="">Choose region</option><option>Asia</option><option>Europe</option><option>North America</option><option>South America</option><option>Africa</option><option>Middle East</option><option>Other</option></select></label>
            <label class="fl-field"><span>Minimum OVR <b>*</b></span><input name="minOvr" type="number" min="50" max="200" required placeholder="e.g. 115"></label>
            <label class="fl-field"><span>Tournament rhythm <b>*</b></span><select name="tournamentFrequency" required><option value="daily">Daily</option><option value="most_days">Most days</option><option value="several_weekly">Several times a week</option><option value="weekly">Weekly</option><option value="occasional">Occasional</option></select></label>
            <label class="fl-field"><span>Player commitment <b>*</b></span><select name="playerCommitment" required><option value="casual">Casual, no pressure</option><option value="regular" selected>Regular play</option><option value="competitive">Competitive</option></select></label>
            <label class="fl-field"><span>Open spots <b>*</b></span><input name="openSpots" type="number" min="0" max="50" required value="5"></label>
            <label class="fl-field"><span>Discord invite link <small>Optional</small></span><input name="discordInviteUrl" type="url" placeholder="https://discord.gg/..." maxlength="500"></label>
            <label class="fl-field"><span>Public Discord contact <small>Optional</small></span><input name="contactDiscord" maxlength="100" placeholder="@clubadmin or Discord handle"></label>
          </div>
          <label class="fl-field"><span>Describe your league <b>*</b></span><textarea name="description" required minlength="20" maxlength="700" rows="4" placeholder="Tell players how your club plays, what you expect and what makes it a good fit."></textarea></label>
          <div class="fl-upload-row">
            <label class="fl-upload" for="leagueLogoFile"><span class="fl-upload-icon">↑</span><span><strong>League crest</strong><small>Optional JPG, PNG, WebP or GIF · under 8 MB</small></span><input id="leagueLogoFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif"></label>
            <div id="leagueLogoPreview" class="fl-logo-preview">FC</div>
            <input type="hidden" name="logoUrl">
          </div>
          <fieldset class="fl-choice-group"><legend>Tournament sizes <b>*</b></legend><div class="fl-choice-row">
            <label><input type="checkbox" name="tournamentSizes" value="4v4" checked><span>4v4</span></label><label><input type="checkbox" name="tournamentSizes" value="8v8"><span>8v8</span></label><label><input type="checkbox" name="tournamentSizes" value="16v16"><span>16v16</span></label><label><input type="checkbox" name="tournamentSizes" value="32v32"><span>32v32</span></label>
          </div></fieldset>
          <fieldset class="fl-choice-group"><legend>Languages used by your league</legend><div class="fl-choice-row">
            <label><input type="checkbox" name="preferredLanguages" value="English" checked><span>English</span></label><label><input type="checkbox" name="preferredLanguages" value="Bengali"><span>Bengali</span></label><label><input type="checkbox" name="preferredLanguages" value="Indonesian"><span>Indonesian</span></label><label><input type="checkbox" name="preferredLanguages" value="Arabic"><span>Arabic</span></label><label><input type="checkbox" name="preferredLanguages" value="Spanish"><span>Spanish</span></label><label><input type="checkbox" name="preferredLanguages" value="Other"><span>Other</span></label>
          </div></fieldset>
          <label class="fl-field"><span>Weekly rewards or perks <small>Optional · describe only what your league actually offers</small></span><textarea name="weeklyRewards" rows="2" maxlength="300" placeholder="Optional rewards, recognition or member perks."></textarea></label>
          <div class="fl-form-bottom">
            <label class="fl-check-line"><input type="checkbox" name="discordRequired"><span>Discord is required to join</span></label>
            <label class="fl-check-line"><input type="checkbox" name="recruitingOpen" checked><span>Open for new members</span></label>
          </div>
          <div class="fl-profile-actions"><p>Don't add player UID lists or private member details to the public description.</p><button class="fl-btn fl-btn-primary" type="submit" id="submitListingBtn">Submit for approval <span aria-hidden="true">→</span></button></div>
          <div class="fl-form-message" id="listingMessage" role="status"></div>
        </form>
      </section>

      <div class="fl-toast" id="toast" role="status" aria-live="polite"></div>
    </div>
  </main>
</BaseLayout>

<style>
  .fl-page{--fl-bg:#071018;--fl-panel:#0e1924;--fl-panel2:#121f2c;--fl-border:rgba(191,223,241,.12);--fl-border-hi:rgba(76,201,255,.35);--fl-text:#f5f8fb;--fl-muted:#9aabba;--fl-cyan:#4cc9ff;--fl-mint:#7ce7bd;--fl-red:#ff9b91;color:var(--fl-text);padding:clamp(30px,5vw,60px) 0 84px}
  .fl-wrap{width:min(1180px,calc(100% - 40px));margin:0 auto}
  .fl-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px;animation:fl-rise .55s cubic-bezier(.2,.7,.2,1) both}
  .fl-title-block{max-width:680px}
  .fl-eyebrow{display:inline-flex;align-items:center;gap:9px;color:#86dcff;font-size:10.5px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}
  .fl-eyebrow>span{width:6px;height:6px;border-radius:50%;background:var(--fl-cyan);box-shadow:0 0 0 4px #4cc9ff19,0 0 12px #4cc9ff7d}
  .fl-heading h1{margin:12px 0 9px;font:700 clamp(38px,6vw,62px)/.98 'Space Grotesk',Inter,system-ui,sans-serif;letter-spacing:-.065em;color:var(--fl-text)}
  .fl-heading h1 em{font-style:normal;background:linear-gradient(100deg,#91e6ff 0%,#4cc9ff 55%,#9caaff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .fl-heading p,.fl-directory-head p,.fl-setup-top p,.fl-editor-heading p{margin:0;color:var(--fl-muted);font-size:14px;line-height:1.7}
  .fl-heading-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}
  .fl-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:43px;padding:0 16px;border:1px solid var(--fl-border);border-radius:12px;text-decoration:none;cursor:pointer;font:700 12.5px/1.2 Inter,system-ui,sans-serif;white-space:nowrap;transition:transform .2s,border-color .2s,background .2s,box-shadow .2s;color:var(--fl-text);background:#0b1620}
  .fl-btn:hover{transform:translateY(-2px);border-color:#4cc9ff67}
  .fl-btn:active{transform:translateY(0) scale(.985)}
  .fl-btn:focus-visible,.fl-tab:focus-visible,.fl-reset:focus-visible{outline:2px solid var(--fl-cyan);outline-offset:3px}
  .fl-btn-primary{color:#04131c;border-color:#79dfff;background:linear-gradient(140deg,#9ae9ff,#4cc9ff 72%);box-shadow:0 9px 24px -12px #4cc9ff9c,inset 0 1px 0 #ffffff9c}
  .fl-btn-primary:hover{background:linear-gradient(140deg,#c3f3ff,#65d7ff);box-shadow:0 13px 32px -12px #4cc9ffb3}
  .fl-btn-quiet{background:transparent;color:#b4c5d1}
  .fl-btn-outline{background:#10202c;border-color:#274050}
  .fl-gate{width:min(590px,100%);margin:46px auto 10px;padding:clamp(28px,5vw,48px);text-align:center;border:1px solid transparent;border-radius:25px;background:linear-gradient(150deg,rgba(16,31,44,.96),rgba(8,17,26,.97)) padding-box,linear-gradient(145deg,#4cc9ff6b,#ffffff0b 52%,#8b94ff45) border-box;box-shadow:0 32px 100px -55px #000;animation:fl-rise .5s both}
  .fl-gate-mark{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 18px;border-radius:18px;background:#4cc9ff10;border:1px solid #4cc9ff3a;color:#83ddff}
  .fl-gate-mark svg{width:32px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .fl-gate h2{margin:0 0 10px;font:700 clamp(24px,4vw,32px)/1.13 'Space Grotesk',Inter,sans-serif;letter-spacing:-.045em}
  .fl-gate p{max-width:440px;margin:0 auto 22px;color:var(--fl-muted);font-size:14px;line-height:1.7}
  .fl-gate .fl-btn{min-height:48px}
  #loadingState{padding:36px 20px;background:transparent;border:0;box-shadow:none}
  #loadingState p{margin:10px 0 0}
  .fl-spinner{width:28px;height:28px;margin:auto;border:2px solid #4cc9ff24;border-top-color:var(--fl-cyan);border-radius:50%;animation:fl-spin .8s linear infinite}
  .fl-profile-setup,.fl-listing-editor{padding:clamp(22px,4vw,36px);border:1px solid transparent;border-radius:23px;background:linear-gradient(155deg,rgba(16,29,42,.98),rgba(8,17,26,.98)) padding-box,linear-gradient(145deg,#4cc9ff57,#ffffff0b 58%,#91a2ff32) border-box;box-shadow:0 28px 90px -65px #000;animation:fl-rise .4s both}
  .fl-setup-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:25px}
  .fl-setup-top h2,.fl-editor-heading h2{margin:10px 0 8px;font:700 clamp(24px,4vw,34px)/1.08 'Space Grotesk',Inter,sans-serif;letter-spacing:-.05em}
  .fl-setup-top p,.fl-editor-heading p{max-width:670px}
