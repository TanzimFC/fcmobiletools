---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlayerReview, getTier } from './playerReviewData.js';
import './player-reviews.css';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'hristo-stoichkov-121-numero-8' },
      props: { player: getPlayerReview('hristo-stoichkov-121-numero-8') }
    }
  ];
}

const player = Astro.props.player;
const tier = getTier(player.review.overall);
const tone = tier.color === 'green' ? 'green' : tier.color === 'yellow' ? 'yellow' : 'red';
const scoreClass = (score) => getTier(score).color === 'green' ? 'bar-green' : getTier(score).color === 'yellow' ? 'bar-yellow' : 'bar-red';

const title = player.name + ' ' + player.ovr + ' OVR Review — ' + player.event + ' | FC Mobile';
const description = player.name + ' ' + player.ovr + ' OVR ' + player.event + ' review with a transparent editorial rating, card data, strengths, weaknesses and PlayStyles.';
---
<BaseLayout title={title} description={description} image={player.cardImage} type="article">
  <main class="review-page review-detail" id="review-top">
    <div class="detail-progress"><span id="detail-progress-bar"></span></div>

    <div class="review-shell detail-shell">
      <a class="detail-back" href="/player-reviews/">← All Player Reviews</a>

      <nav class="mobile-detail-nav">
        <select id="mobile-section-nav" aria-label="Jump to review section">
          <option value="overview">01 · Overview</option>
          <option value="ratings">02 · Ratings</option>
          <option value="strengths">03 · Strengths</option>
          <option value="fit">04 · Fit & PlayStyles</option>
          <option value="data">05 · Card Data</option>
        </select>
      </nav>

      <div class="detail-layout">
        <aside class="detail-left-rail">
          <div class="rail-card">
            <div class="rail-title">On this review</div>
            <nav class="section-nav">
              <a href="#overview" data-section-link="overview" class="is-active"><span>01</span><b>Overview</b></a>
              <a href="#ratings" data-section-link="ratings"><span>02</span><b>Ratings</b></a>
              <a href="#strengths" data-section-link="strengths"><span>03</span><b>Strengths</b></a>
              <a href="#fit" data-section-link="fit"><span>04</span><b>Fit & PlayStyles</b></a>
              <a href="#data" data-section-link="data"><span>05</span><b>Card Data</b></a>
            </nav>
          </div>

          <div class="rail-card" style="margin-top:12px">
            <div class="rail-title">Review profile</div>
            <div style="padding:0 14px 14px;color:#68808b;font:700 8px 'IBM Plex Mono',monospace;line-height:1.75">
              Editorial score<br />
              Card data checked<br />
              <strong style="color:#d8eef3">{player.addedOn}</strong>
            </div>
          </div>
        </aside>

        <div class="detail-main">
          <section class="detail-hero detail-animate" id="overview" data-detail-section>
            <div class="detail-card-zone" data-card-zone>
              <img class="detail-card" src={player.cardImage} alt={player.ovr + ' OVR ' + player.name + ' ' + player.event + ' card'} draggable="false" />
            </div>

            <div class="detail-copy">
              <div class="detail-event-row">
                <span class="detail-chip hot">{player.event}</span>
                <span class="detail-chip">{player.program}</span>
                <span class="detail-chip">{player.position}</span>
              </div>
              <p class="detail-program">TANZIMFC PLAYER REVIEW</p>
              <h1>{player.name}</h1>
              <p class="lede">{player.review.verdict}</p>

              <div class="detail-score-row">
                <strong class="detail-score">{player.review.overall.toFixed(1)}</strong>
                <span class={'detail-tier tier-' + tone}>{tier.name}</span>
              </div>

              <div class="detail-meta-grid">
                <div class="detail-meta"><small>OVR</small><strong>{player.ovr}</strong></div>
                <div class="detail-meta"><small>POSITION</small><strong>{player.position}</strong></div>
                <div class="detail-meta"><small>WEAK FOOT</small><strong>{player.weakFoot}★</strong></div>
                <div class="detail-meta"><small>SKILL MOVES</small><strong>{player.skillMoves}★</strong></div>
              </div>

              <p class="detail-source-note"><b>{player.starShards.toLocaleString()} Star Shards</b> · {player.auctionable ? 'Auctionable' : 'Not auctionable'} · {player.workRate} work rate.</p>
            </div>
          </section>

          <section class="detail-block detail-animate" id="ratings" data-detail-section>
            <header class="detail-block-head">
              <div><p>02 / EDITORIAL BREAKDOWN</p><h2>Category ratings</h2></div>
              <small>GREEN · YELLOW · RED</small>
            </header>

            <div class="category-list">
              {player.review.categories.map(([label, score, note]) => (
                <div class="category-item">
                  <label>{label}</label>
                  <div class="category-track"><i class={scoreClass(score)} style={'width:' + (score * 10) + '%'}></i></div>
                  <b>{score.toFixed(1)}</b>
                  <p class="category-note">{note}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="detail-block detail-animate" id="strengths" data-detail-section>
            <header class="detail-block-head">
              <div><p>03 / THE GOOD & THE BAD</p><h2>Strengths & weaknesses</h2></div>
              <small>OPEN EACH ITEM</small>
            </header>

            <div class="expand-grid">
              <div>
                {player.review.strengths.map((item, index) => (
                  <article class="expand-card">
                    <button class="expand-head" type="button">
                      <span>{String(index + 1).padStart(2, '0')} · {item.title}</span>
                      <b>+</b>
                    </button>
                    <div class="expand-body">{item.detail}</div>
                  </article>
                ))}
              </div>
              <div>
                {player.review.weaknesses.map((item, index) => (
                  <article class="expand-card">
                    <button class="expand-head" type="button">
                      <span>{String(index + 1).padStart(2, '0')} · {item.title}</span>
                      <b>+</b>
                    </button>
                    <div class="expand-body">{item.detail}</div>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section class="detail-block detail-animate" id="fit" data-detail-section>
            <header class="detail-block-head">
              <div><p>04 / ROLE & TOOLS</p><h2>Fit & PlayStyles</h2></div>
              <small>{player.review.bestFor}</small>
            </header>

            <div class="fit-grid">
              <div class="fit-card"><small>Primary role</small><strong>{player.position}</strong><span>{player.alternatePositions.join(' / ')} alternatives</span></div>
              <div class="fit-card"><small>Best for</small><strong>{player.review.bestFor}</strong><span>Editorial role fit</span></div>
              <div class="fit-card"><small>Body profile</small><strong>{player.height}</strong><span>{player.weight} · {player.workRate}</span></div>
            </div>

            <div style="padding:0 22px 22px">
              <div class="fit-card">
                <small>PlayStyles</small>
                <div class="pills">
                  {player.playstyles.map((style) => <span class="pill">{style.name} · L{style.level}</span>)}
                </div>
                <div class="pills">
                  {player.traits.map((trait) => <span class="pill">{trait}</span>)}
                </div>
              </div>
            </div>
          </section>

          <section class="detail-block detail-animate" id="data" data-detail-section>
            <header class="detail-block-head">
              <div><p>05 / CARD DATA</p><h2>Attributes & source trail</h2></div>
              <small>BASE CARD</small>
            </header>

            <div class="fit-grid">
              {Object.entries(player.stats).map(([label, value]) => (
                <div class="fit-card"><small>{label}</small><strong>{value}</strong><span>Base attribute</span></div>
              ))}
            </div>

            <div style="padding:0 22px 22px">
              <div class="fit-card">
                <small>Selected substats</small>
                <div class="pills">{player.substats.map(([label, value]) => <span class="pill">{label} · {value}</span>)}</div>
              </div>
            </div>

            <div class="source-links">
              {player.review.sources.map(([label, url]) => (
                <a class="source-link" href={url} target="_blank" rel="noopener noreferrer">
                  <span>{label}</span><b>↗</b>
                </a>
              ))}
            </div>

            <div style="padding:0 22px 22px;color:#607985;font-size:9px;line-height:1.7">
              {player.review.dataNote}
            </div>
          </section>
        </div>

        <aside class="detail-right-rail">
          <section class="rail-card score-wheel-card">
            <div class="rail-title">Editorial rating</div>
            <div
              class="score-wheel"
              style={'--wheel-progress:' + (player.review.overall * 36) + 'deg;--wheel-color:var(--rv-' + tone + ')'}
            >
              <div><small>RATING</small><strong>{player.review.overall.toFixed(1)}</strong></div>
            </div>
            <p>{tier.name} · {player.review.overall.toFixed(1)} / 10</p>
          </section>

          <section class="rail-card side-data">
            <p class="side-data-title">Player snapshot</p>
            <div class="side-data-grid">
              <div><span>Nation</span><strong>{player.nation}</strong></div>
              <div><span>Foot</span><strong>{player.foot}</strong></div>
              <div><span>Weak foot</span><strong>{player.weakFoot}★</strong></div>
              <div><span>Skill moves</span><strong>{player.skillMoves}★</strong></div>
              <div><span>Height</span><strong>{player.height}</strong></div>
              <div><span>Price</span><strong>{player.starShards.toLocaleString()}</strong></div>
            </div>
          </section>

          <section class="rail-card side-data">
            <p class="side-data-title">Review note</p>
            <p style="margin:0;color:#6e8791;font-size:9px;line-height:1.7">{player.review.dataNote}</p>
          </section>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const progress = document.querySelector('#detail-progress-bar');
  const cardZone = document.querySelector('[data-card-zone]');
  const card = cardZone?.querySelector('.detail-card');
  const navLinks = [...document.querySelectorAll('[data-section-link]')];
  const sections = [...document.querySelectorAll('[data-detail-section]')];
  const mobileSelect = document.querySelector('#mobile-section-nav');

  if (cardZone && card && window.matchMedia('(pointer:fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    cardZone.addEventListener('pointermove', (event) => {
      const rect = cardZone.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      card.style.transform =
        'translate3d(' + (x * 11) + 'px,' + (y * -8) + 'px,0) rotateY(' + (x * 6) + 'deg) rotateX(' + (y * -5) + 'deg) rotateZ(-.45deg) scale(1.018)';
    });
    cardZone.addEventListener('pointerleave', () => {
      card.style.transform = '';
    });
  }

  document.querySelectorAll('.expand-head').forEach((button) => {
    button.addEventListener('click', () => {
      button.parentElement?.classList.toggle('is-open');
    });
  });

  const reveal = () => {
    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      if (rect.top < window.innerHeight * .86) section.classList.add('is-visible');
    });
  };

  const updateProgress = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (progress) progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
    reveal();
  };

  if ('IntersectionObserver' in window) {
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        navLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.sectionLink === id));
        if (mobileSelect && mobileSelect.value !== id && ['overview', 'ratings', 'strengths', 'fit', 'data'].includes(id)) mobileSelect.value = id;
      });
    }, { rootMargin: '-22% 0px -62% 0px', threshold: 0 });

    sections.forEach((section) => sectionObserver.observe(section));
  }

  mobileSelect?.addEventListener('change', () => {
    document.getElementById(mobileSelect.value)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  reveal();
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
</script>
