---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlayerReview, getTier } from './playerReviewData.js';
import './player-reviews.css';

export function getStaticPaths() {
  return [{ params: { slug: 'hristo-stoichkov-121-numero-8' }, props: { player: getPlayerReview('hristo-stoichkov-121-numero-8') } }];
}

const player = Astro.props.player;
if (!player) return Astro.redirect('/player-reviews/');

const tier = getTier(player.review.overall);
const scoreTone = (score) => {
  const color = getTier(score).color;
  return color === 'green' ? 'tone-green' : color === 'yellow' ? 'tone-yellow' : 'tone-red';
};
const barTone = (score) => {
  const color = getTier(score).color;
  return color === 'green' ? 'bar-green' : color === 'yellow' ? 'bar-yellow' : 'bar-red';
};
const tierTone = tier.color === 'green' ? 'tier-green' : tier.color === 'yellow' ? 'tier-yellow' : 'tier-red';
const title = player.name + ' ' + player.ovr + ' OVR Review — ' + player.event + ' | FC Mobile';
const description = player.name + ' ' + player.ovr + ' OVR ' + player.event + ' review with complete stats, substats, PlayStyles and detailed editorial analysis.';
const pretty = (key) => key.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const substatGroups = [
  ['Pace', 'pace', player.stats.pace],
  ['Shooting', 'shooting', player.stats.shooting],
  ['Passing', 'passing', player.stats.passing],
  ['Dribbling', 'dribbling', player.stats.dribbling],
  ['Defending', 'defending', player.stats.defending],
  ['Physical', 'physical', player.stats.physical]
];
---
<BaseLayout title={title} description={description} image={player.cardImage} type="article">
  <main class="review-page review-detail">
    <div class="review-shell">

      <a class="back-link" href="/player-reviews/"><span>←</span> Player Reviews</a>

      <section class="detail-hero">
        <div class="detail-card-stage">
          <div class="detail-card-aura"></div>
          <img src={player.cardImage} alt={player.ovr + ' OVR ' + player.name + ' ' + player.event + ' card'} />
        </div>

        <div class="detail-identity">
          <div class="detail-kicker">
            <span class="detail-chip event">{player.event}</span>
            <span class="detail-chip">{player.program}</span>
          </div>
          <div class="detail-ovr-line">
            <span>{player.ovr} OVR</span>
            <i></i>
            <span>{player.position}</span>
          </div>
          <h1>{player.name}</h1>
          <p class="detail-summary">{player.review.summary}</p>

          <div class="detail-stat-ribbon">
            <div><span>WEAK FOOT</span><strong>{player.weakFoot}★</strong></div>
            <div><span>SKILL MOVES</span><strong>{player.skillMoves}★</strong></div>
            <div><span>FOOT</span><strong>{player.foot}</strong></div>
            <div><span>WORK RATE</span><strong>{player.workRate}</strong></div>
          </div>
        </div>

        <aside class="detail-score">
          <span class="score-label">TANZIMFC RATING</span>
          <strong class="score-number">{player.review.overall.toFixed(1)}</strong>
          <span class={'score-tier ' + tierTone}>{tier.name}</span>
          <div class="score-track"><i class={barTone(player.review.overall)} style={'width:' + (player.review.overall * 10) + '%'}></i></div>
        </aside>
      </section>

      <section class="attribute-overview">
        {player.review.categories.map(([label, score, note]) => (
          <article class="attribute-card">
            <div class="attribute-head">
              <div><span>{label}</span><small>{note}</small></div>
              <strong class={scoreTone(score)}>{score.toFixed(1)}</strong>
            </div>
            <div class="attribute-bar"><i class={barTone(score)} style={'width:' + (score * 10) + '%'}></i></div>
          </article>
        ))}
      </section>

      <section class="detail-main-grid">
        <div class="detail-main-column">
          <section class="premium-panel verdict-panel">
            <div class="panel-heading"><span>01 / VERDICT</span><h2>The card in one read</h2></div>
            <p class="verdict-copy">{player.review.verdict}</p>
            <div class="verdict-meta">
              <div><span>BEST POSITION</span><strong>{player.position}</strong></div>
              <div><span>ALTERNATES</span><strong>{player.alternatePositions.join(' / ')}</strong></div>
              <div><span>BEST FOR</span><strong>{player.review.bestFor}</strong></div>
            </div>
          </section>

          <section class="premium-panel">
            <div class="panel-heading"><span>02 / WHAT STANDS OUT</span><h2>Strengths</h2></div>
            <div class="pros-grid">{player.review.strengths.map((item, index) => <div class="pro-card"><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></div>)}</div>
          </section>

          <section class="premium-panel">
            <div class="panel-heading"><span>03 / TRADE-OFFS</span><h2>Weaknesses</h2></div>
            <div class="cons-grid">{player.review.weaknesses.map((item, index) => <div class="con-card"><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></div>)}</div>
          </section>

          <section class="premium-panel">
            <div class="panel-heading"><span>04 / FULL ATTRIBUTE PROFILE</span><h2>Detailed substats</h2></div>
            <div class="substat-grid">
              {substatGroups.map(([group, key, overall]) => (
                <article class="substat-group">
                  <div class="substat-group-head">
                    <div><span>{group}</span><small>{overall}</small></div>
                    <i></i>
                  </div>
                  <div class="substat-list">
                    {Object.entries(player.substats[key]).map(([name, value]) => (
                      <div class="substat-row">
                        <span>{pretty(name)}</span>
                        <strong>{value}</strong>
                      </div>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>

        <aside class="detail-side-column">
          <section class="premium-panel profile-panel">
            <div class="panel-heading"><span>05 / PLAYER PROFILE</span><h2>Card details</h2></div>
            <dl class="profile-list">
              <div><dt>OVR</dt><dd>{player.ovr}</dd></div>
              <div><dt>Position</dt><dd>{player.position}</dd></div>
              <div><dt>Alternate positions</dt><dd>{player.alternatePositions.join(' / ')}</dd></div>
              <div><dt>Nation</dt><dd>{player.nation}</dd></div>
              <div><dt>Strong foot</dt><dd>{player.foot}</dd></div>
              <div><dt>Weak foot</dt><dd>{player.weakFoot}★</dd></div>
              <div><dt>Skill moves</dt><dd>{player.skillMoves}★</dd></div>
              <div><dt>Height</dt><dd>{player.height}</dd></div>
              <div><dt>Weight</dt><dd>{player.weight}</dd></div>
              <div><dt>Work rate</dt><dd>{player.workRate}</dd></div>
              <div><dt>Star Shards</dt><dd>{player.starShards.toLocaleString()}</dd></div>
              <div><dt>Auctionable</dt><dd>{player.auctionable ? 'Yes' : 'No'}</dd></div>
              <div><dt>Added</dt><dd>{player.addedOn}</dd></div>
            </dl>
          </section>

          <section class="premium-panel">
            <div class="panel-heading"><span>06 / PLAYSTYLES</span><h2>On-card abilities</h2></div>
            <div class="tag-cloud">{player.playstyles.map((item) => <span class="ability-tag primary">{item}</span>)}</div>
            <div class="trait-label">TRAITS</div>
            <div class="tag-cloud">{player.traits.map((item) => <span class="ability-tag">{item}</span>)}</div>
          </section>

          <section class="premium-panel rating-panel">
            <div class="panel-heading"><span>07 / RATING METER</span><h2>How the score reads</h2></div>
            <div class="meter-scale">
              <div><span>9.0 — 10.0</span><b class="green">Elite</b></div>
              <div><span>8.0 — 8.9</span><b class="green">Strong</b></div>
              <div><span>7.0 — 7.9</span><b class="yellow">Solid</b></div>
              <div><span>6.0 — 6.9</span><b class="red">Mixed</b></div>
              <div><span>5.0 — 5.9</span><b class="red">Weak</b></div>
            </div>
          </section>
        </aside>
      </section>
    </div>
  </main>
</BaseLayout>
