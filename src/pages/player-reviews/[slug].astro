---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlayerReview, getTier } from './playerReviewData.js';
import './player-reviews.css';

export function getStaticPaths() {
  return [{ params: { slug: 'hristo-stoichkov-121-numero-8' }, props: { player: getPlayerReview('hristo-stoichkov-121-numero-8') } }];
}

const player = Astro.props.player;
if (!player) return Astro.redirect('/player-reviews/');

const tier = getTier(player.review.overall);
const tone = tier.color === 'green' ? 'green' : tier.color === 'yellow' ? 'yellow' : 'red';

const title = player.name + ' ' + player.ovr + ' OVR Review — ' + player.event + ' | FC Mobile';
const description = player.name + ' ' + player.ovr + ' OVR ' + player.event + ' review with a concise verdict, strengths, weaknesses and key card details.';
---
<BaseLayout title={title} description={description} image={player.cardImage} type="article">
  <main class="review-page review-detail-v4">
    <div class="review-v4-shell">

      <a class="v4-back" href="/player-reviews/">
        <span>←</span>
        Player Reviews
      </a>

      <section class="v4-hero" data-reveal>
        <div class="v4-card-wrap" data-card-zone>
          <img
            src={player.cardImage}
            alt={player.ovr + ' OVR ' + player.name + ' ' + player.event + ' card'}
            draggable="false"
            class="v4-card-image"
          />
        </div>

        <div class="v4-copy">
          <div class="v4-labels">
            <span>{player.event}</span>
            <span>{player.position}</span>
            <span>{player.ovr} OVR</span>
          </div>

          <h1>{player.name}</h1>
          <p class="v4-summary">{player.review.summary}</p>

          <div class="v4-rating-row">
            <div class="v4-rating">
              <strong>{player.review.overall.toFixed(1)}</strong>
              <span class={'v4-rating-tier v4-' + tone}>{tier.name}</span>
            </div>

            <div class="v4-profile-line">
              <span>{player.nation}</span>
              <span>{player.foot} foot</span>
              <span>{player.weakFoot}★ WF</span>
              <span>{player.skillMoves}★ SM</span>
            </div>
          </div>
        </div>
      </section>

      <section class="v4-verdict" data-reveal>
        <div class="v4-section-label">VERDICT</div>
        <div>
          <h2>{player.review.verdict}</h2>
          <p>{player.review.bestFor}</p>
        </div>
        <div class="v4-fit">
          <small>BEST FIT</small>
          <strong>{player.position}</strong>
          <span>{player.alternatePositions.join(' · ')}</span>
        </div>
      </section>

      <section class="v4-sw" data-reveal>
        <article class="v4-panel v4-positive">
          <header>
            <div>
              <span>01</span>
              <h2>Strengths</h2>
            </div>
          </header>

          <div class="v4-list">
            {player.review.strengths.map((item) => (
              <div class="v4-item">
                <i></i>
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </article>

        <article class="v4-panel v4-negative">
          <header>
            <div>
              <span>02</span>
              <h2>Weaknesses</h2>
            </div>
          </header>

          <div class="v4-list">
            {player.review.weaknesses.map((item) => (
              <div class="v4-item">
                <i></i>
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </article>
      </section>

      <section class="v4-bottom" data-reveal>
        <article class="v4-mini">
          <span class="v4-mini-label">PLAYSTYLES</span>
          <div class="v4-tags">
            {player.playstyles.map((item) => <span>{item}</span>)}
          </div>
        </article>

        <article class="v4-mini">
          <span class="v4-mini-label">CARD FIT</span>
          <div class="v4-fit-line">
            <strong>{player.position}</strong>
            <span>{player.alternatePositions.join(' / ')}</span>
            <em>{player.workRate}</em>
          </div>
        </article>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const sections = [...document.querySelectorAll('[data-reveal]')];
  const cardZone = document.querySelector('[data-card-zone]');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    sections.forEach((section) => observer.observe(section));
  } else {
    sections.forEach((section) => section.classList.add('is-visible'));
  }

  cardZone?.addEventListener('contextmenu', (event) => event.preventDefault());
  cardZone?.addEventListener('dragstart', (event) => event.preventDefault());
</script>
