---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPlayerReview, getTier } from './playerReviewData.js';
import './player-reviews.css';

import { playerReviews } from './playerReviewData.js';

export function getStaticPaths() {
  return playerReviews.map((player) => ({
    params: { slug: player.slug },
    props: { player }
  }));
}

const player = Astro.props.player;
const tier = getTier(player.review.overall);
const tone = tier.color;
const categoryTone = (score) => score >= 9 ? 'green' : score >= 7 ? 'yellow' : 'red';
const baseStats = player.stats ? Object.entries(player.stats) : [];
const detailGroups = {
  attack: ['Finishing','Long Shot','Shot Power','Positioning','Short Passing','Long Passing','Vision','Crossing'],
  movement: ['Acceleration','Sprint Speed','Dribbling','Balance','Agility','Reactions','Ball Control'],
  physical: ['Strength','Aggression','Jumping','Stamina','Heading']
};
const detailStats = Object.entries(detailGroups).flatMap(([group, labels]) =>
  labels.map((name) => {
    const item = player.substats.find(([label]) => label === name);
    return item ? { group, label: item[0], value: item[1] } : null;
  }).filter(Boolean)
);
const reviewTitle = player.name + ' ' + player.ovr + ' OVR Review — ' + player.event + ' | FC Mobile';
const description = player.name + ' ' + player.ovr + ' OVR ' + player.event + ' player review with editorial ratings, card data, strengths, weaknesses and PlayStyles.';
---
<BaseLayout title={reviewTitle} description={description} image={player.cardImage} type="article">
  <main class="review-page review-detail stoichkov-review" id="review-top">
    <div class="detail-progress"><i id="detail-progress"></i></div>

    <div class="review-shell sr-shell">
      <header class="sr-topbar">
        <a href="/player-reviews/" class="sr-back">← Player Reviews</a>
        <div class="sr-topmeta"><span>PLAYER DOSSIER</span><b>{player.event}</b></div>
      </header>

      <section class="sr-hero sr-reveal">
        <div class="sr-hero-card" data-card-zone>
          <span class="sr-card-mark">{player.ovr}</span>
          <div class="sr-card-glow"></div>
          {player.cardImage ? (
            <img class="sr-card sr-card-static" src={player.cardImage} alt={player.ovr + ' OVR ' + player.name + ' card'} draggable="false" oncontextmenu="return false" />
          ) : (
            <div class="sr-card-placeholder" aria-label={player.name + ' card artwork pending'}>
              <b>{player.ovr}</b><span>{player.name}</span>
            </div>
          )}
        </div>

        <div class="sr-hero-copy">
          <div class="sr-kicker"><i></i> Editorial review</div>
          <div class="sr-id"><span>{player.position}</span><b>{player.ovr} OVR</b><em>{player.event}</em></div>
          <h1>{player.name}</h1>
          <p class="sr-intro">{player.review.summary}</p>

          <div class="sr-score-lockup">
            <strong>{player.review.overall.toFixed(1)}</strong>
            <span>/10</span>
            <b class={'sr-tier-' + tone}>{tier.name}</b>
          </div>

          <div class="sr-fact-grid">
            <div><small>Primary</small><b>{player.position}</b></div>
            <div><small>Alt positions</small><b>{player.alternatePositions.join(' · ')}</b></div>
            <div><small>Weak foot</small><b>{player.weakFoot}★</b></div>
            <div><small>Skill moves</small><b>{player.skillMoves}★</b></div>
            <div><small>Foot</small><b>{player.foot}</b></div>
            <div><small>Work rate</small><b>{player.workRate}</b></div>
          </div>
        </div>

        <aside class="sr-hero-side">
          <div class="sr-side-top"><span>Card snapshot</span><b>{player.program}</b></div>
          <div class="sr-ring" style={'--angle:' + player.review.overall * 36 + 'deg'}><strong>{player.review.overall.toFixed(1)}</strong><small>/ 10</small></div>
          <div class="sr-side-grid">
            <div><span>Nation</span><b>{player.nation}</b></div>
            <div><span>Height</span><b>{player.height}</b></div>
            <div><span>Weight</span><b>{player.weight}</b></div>
            <div><span>Shards</span><b>{player.starShards.toLocaleString()}</b></div>
            <div><span>Auctionable</span><b>{player.auctionable ? 'Yes' : 'No'}</b></div>
          </div>
        </aside>
      </section>

      <section class="sr-block sr-reveal" id="ratings">
        <header class="sr-head"><div><small>01 / PERFORMANCE MAP</small><h2>Profile at a glance.</h2></div><p>Base card attributes and editorial category scores are shown separately.</p></header>

        {baseStats.length ? (
          <div class="sr-six">
            {baseStats.map(([label,value]) => (
              <article><div><span>{label}</span><b>{value}</b></div><i><em style={'width:' + Math.min(value,160) / 160 * 100 + '%'}></em></i></article>
            ))}
          </div>
        ) : (
          <div class="sr-data-pending">Verified core attribute numbers have not been published for this review entry yet. No unverified numbers are displayed.</div>
        )}

        <div class="sr-categories">
          {player.review.categories.map(([label,score,note]) => (
            <article>
              <div class="sr-cat-score"><b>{score.toFixed(1)}</b><span>{label}</span></div>
              <div><i><em class={'sr-fill-' + categoryTone(score)} style={'width:' + score * 10 + '%'}></em></i><p>{note}</p></div>
            </article>
          ))}
          {!player.review.categories.length && <div class="sr-data-pending">Category scores are not published yet for this entry.</div>}
        </div>
      </section>

      <section class="sr-two sr-reveal">
        <article class="sr-block sr-bullet-panel sr-strengths">
          <header class="sr-head"><div><small>02 / STRENGTHS</small><h2>What stands out.</h2></div><b>+</b></header>
          <ul class="sr-bullets">
            {player.review.strengths.map(([label,detail]) => (
              <li><span class="sr-bullet">+</span><div><strong>{label}</strong><p>{detail}</p></div></li>
            ))}
          </ul>
        </article>

        <article class="sr-block sr-bullet-panel sr-limitations">
          <header class="sr-head"><div><small>03 / WEAKNESSES</small><h2>What to account for.</h2></div><b class="sr-minus">−</b></header>
          <ul class="sr-bullets">
            {player.review.weaknesses.map(([label,detail]) => (
              <li><span class="sr-bullet">−</span><div><strong>{label}</strong><p>{detail}</p></div></li>
            ))}
          </ul>
        </article>
      </section>

      <section class="sr-block sr-reveal" id="fit">
        <header class="sr-head"><div><small>04 / ROLE PROFILE</small><h2>How to read the card.</h2></div><p>{player.review.bestFor}</p></header>
        <div class="sr-role">
          <article class="sr-role-main"><small>PRIMARY POSITION</small><strong>{player.position}</strong><p>Start here. Alternative positions: {player.alternatePositions.join(' / ')}.</p><div>{player.position}{player.alternatePositions.map((pos) => <span>{pos}</span>)}</div></article>
          <article><small>BEST USE</small><strong>{player.review.bestUse}</strong><p>{player.review.bestFor}</p></article>
          <article><small>PLAYSTYLES</small>{player.playstyles.map((style) => <div class="sr-style"><b>{style.name}</b><span>LEVEL {style.level}</span><p>{style.description}</p></div>)}</article>
          <article><small>TRAITS</small><div class="sr-traits">{player.traits.map((trait) => <span>{trait}</span>)}</div></article>
        </div>
      </section>

      <section class="sr-block sr-reveal" id="attributes">
        <header class="sr-head"><div><small>05 / ATTRIBUTE MATRIX</small><h2>Detailed card numbers.</h2></div><p>Switch between groups for a faster scan.</p></header>
        <div class="sr-tabs">
          <button class="is-active" type="button" data-filter="all">All</button>
          <button type="button" data-filter="attack">Attack</button>
          <button type="button" data-filter="movement">Movement</button>
          <button type="button" data-filter="physical">Physical</button>
        </div>
        {detailStats.length ? (
          <div class="sr-detail-grid">
            {detailStats.map((item) => (
              <article class="sr-detail" data-group={item.group}>
                <span>{item.label}</span><b>{item.value}</b><i><em style={'width:' + Math.min(item.value,160) / 160 * 100 + '%'}></em></i>
              </article>
            ))}
          </div>
        ) : (
          <div class="sr-data-pending">Detailed verified attribute numbers will be added when the source data is published.</div>
        )}
      </section>

      <section class="sr-final sr-reveal">
        <div><small>EDITORIAL TAKEAWAY</small><h2>{player.review.verdict}</h2></div>
        <strong>{player.review.overall.toFixed(1)}<span>/10</span></strong>
      </section>

      <nav class="sr-bottom"><a href="/player-reviews/">← All player reviews</a><span>{player.name} · {player.ovr} OVR</span><a href="#review-top">Back to top ↑</a></nav>
    </div>
  </main>
</BaseLayout>

<script>
  const zone = document.querySelector('[data-card-zone]');
  const card = zone?.querySelector('.sr-card');
  const progress = document.querySelector('#detail-progress');

  if (zone && card && window.matchMedia('(pointer:fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    zone.addEventListener('pointermove', (event) => {
      const rect = zone.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - .5;
      const y = (event.clientY - rect.top) / rect.height - .5;
      card.style.transform = 'translate3d(' + x * 12 + 'px,' + y * -10 + 'px,0) rotateY(' + x * 7 + 'deg) rotateX(' + y * -5 + 'deg) rotateZ(-1deg) scale(1.02)';
    });
    zone.addEventListener('pointerleave', () => card.style.transform = '');
  }

  document.querySelectorAll('[data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('is-active', item === button));
      document.querySelectorAll('.sr-detail').forEach((item) => item.hidden = filter !== 'all' && item.dataset.group !== filter);
    });
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
    }), { threshold:.06 });
    document.querySelectorAll('.sr-reveal').forEach((node) => observer.observe(node));
  } else {
    document.querySelectorAll('.sr-reveal').forEach((node) => node.classList.add('is-visible'));
  }

  const updateProgress = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (progress) progress.style.width = (max > 0 ? window.scrollY / max * 100 : 0) + '%';
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive:true });
</script>
