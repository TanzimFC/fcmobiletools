---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { playerReviews, getTier } from './playerReviewData.js';
import './player-reviews.css';

const tierOptions = ['all', 'Excellent', 'Great', 'Good', 'Average', 'Poor'];
const positionOptions = ['all', ...new Set(playerReviews.map((p) => p.position))];
const eventOptions = ['all', ...new Set(playerReviews.map((p) => p.event))];
---
<BaseLayout
  title="Player Reviews"
  description="FC Mobile Player Reviews — a focused editorial library of player cards and detailed reviews."
>
  <main class="review-page">
    <div class="review-shell">
      <header class="review-library-hero">
        <div>
          <p class="review-overline">TANZIMFC / PLAYER REVIEWS</p>
          <h1>Player<br /><em>Reviews.</em></h1>
          <p>A dedicated library for FC Mobile player cards. Browse the cards first, then open a complete review for the numbers, role, strengths, weaknesses and PlayStyles.</p>
        </div>
        <div class="review-library-meta">
          <span>LIBRARY</span>
          <strong>{String(playerReviews.length).padStart(2, '0')}</strong>
          <small>REVIEWS PUBLISHED</small>
        </div>
      </header>

      <button class="review-mobile-filters" id="mobile-filter-toggle" type="button">FILTER PLAYERS</button>

      <div class="review-workspace">
        <aside class="review-filter-rail" id="review-filter-rail" aria-label="Player review filters">
          <div class="filter-block">
            <p class="filter-title">Search</p>
            <label class="filter-search">
              <input id="player-search" type="search" placeholder="Player name…" autocomplete="off" />
              <b>⌕</b>
            </label>
          </div>

          <div class="filter-block">
            <p class="filter-title">Rating</p>
            <div class="filter-options" data-filter="tier">
              {tierOptions.map((value, index) => (
                <button class:list={['filter-option', index === 0 ? 'is-active' : '']} type="button" data-value={value}>
                  <span>{value === 'all' ? 'All ratings' : value}</span>
                  {value !== 'all' && <i class:list={['filter-dot', ['Excellent','Great'].includes(value) ? 'filter-green' : value === 'Good' ? 'filter-yellow' : 'filter-red']}></i>}
                </button>
              ))}
            </div>
          </div>

          <div class="filter-block">
            <p class="filter-title">Position</p>
            <div class="filter-options" data-filter="position">
              {positionOptions.map((value, index) => (
                <button class:list={['filter-option', index === 0 ? 'is-active' : '']} type="button" data-value={value}>
                  <span>{value === 'all' ? 'All positions' : value}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="filter-block">
            <p class="filter-title">Event</p>
            <div class="filter-options" data-filter="event">
              {eventOptions.map((value, index) => (
                <button class:list={['filter-option', index === 0 ? 'is-active' : '']} type="button" data-value={value}>
                  <span>{value === 'all' ? 'All events' : value}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="filter-block">
            <p class="filter-title">Scale</p>
            <div style="display:grid;gap:8px">
              <div style="display:flex;align-items:center;gap:7px;color:#728a94;font:700 7px 'Space Mono',monospace"><i class="filter-dot filter-green"></i>9.0–10.0 · Excellent / Great</div>
              <div style="display:flex;align-items:center;gap:7px;color:#728a94;font:700 7px 'Space Mono',monospace"><i class="filter-dot filter-yellow"></i>7.0–7.9 · Good</div>
              <div style="display:flex;align-items:center;gap:7px;color:#728a94;font:700 7px 'Space Mono',monospace"><i class="filter-dot filter-red"></i>5.0–6.9 · Average / Poor</div>
            </div>
          </div>

          <div class="filter-block">
            <button class="filter-reset" id="reset-filters" type="button">RESET</button>
          </div>
        </aside>

        <section class="review-main">
          <div class="review-main-head">
            <div><p>01 / LIBRARY</p><h2>Player cards</h2></div>
            <span class="review-count" id="result-count">{playerReviews.length} review{playerReviews.length === 1 ? '' : 's'}</span>
          </div>

          <section class="review-stage">
            <div class="card-grid" id="card-grid">
              {playerReviews.map((player, index) => (
                <a
                  class="player-tile"
                  href={'/player-reviews/' + player.slug + '/'}
                  data-player
                  data-search={(player.name + ' ' + player.event + ' ' + player.position).toLowerCase()}
                  data-tier={getTier(player.review.overall).name}
                  data-position={player.position}
                  data-event={player.event}
                  aria-label={'Open ' + player.name + ' review'}
                >
                  <div class="player-card-wrap">
                    <img class="player-card" src={player.cardImage} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
                  </div>
                  <span class="player-name">{player.name}</span>
                </a>
              ))}
              <div class="review-empty" id="empty-state" hidden>
                <div><strong>No matching cards.</strong><span>Try another player, position or event.</span></div>
              </div>
            </div>
          </section>

          <section class="scale-bar">
            <div><small>REVIEW SCALE</small><strong>5.0 — 10.0</strong></div>
            <div class="scale-dots">
              <span><i class="scale-red"></i>Poor</span>
              <span><i class="scale-red"></i>Average</span>
              <span><i class="scale-yellow"></i>Good</span>
              <span><i class="scale-green"></i>Great</span>
              <span><i class="scale-green"></i>Excellent</span>
            </div>
          </section>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const state = { search: '', tier: 'all', position: 'all', event: 'all' };
  const search = document.querySelector('#player-search');
  const cards = [...document.querySelectorAll('[data-player]')];
  const empty = document.querySelector('#empty-state');
  const count = document.querySelector('#result-count');
  const rail = document.querySelector('#review-filter-rail');
  const mobileToggle = document.querySelector('#mobile-filter-toggle');

  function refresh() {
    const query = state.search.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const show =
        (!query || card.dataset.search.includes(query)) &&
        (state.tier === 'all' || card.dataset.tier === state.tier) &&
        (state.position === 'all' || card.dataset.position === state.position) &&
        (state.event === 'all' || card.dataset.event === state.event);
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = visible + ' review' + (visible === 1 ? '' : 's');
  }

  document.querySelectorAll('[data-filter]').forEach((group) => {
    const key = group.dataset.filter;
    group.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      state[key] = button.dataset.value;
      group.querySelectorAll('button').forEach((item) => item.classList.toggle('is-active', item === button));
      refresh();
    });
  });

  search?.addEventListener('input', () => {
    state.search = search.value;
    refresh();
  });

  document.querySelector('#reset-filters')?.addEventListener('click', () => {
    Object.assign(state, { search: '', tier: 'all', position: 'all', event: 'all' });
    if (search) search.value = '';
    document.querySelectorAll('[data-filter]').forEach((group) => {
      group.querySelectorAll('button').forEach((button, index) => button.classList.toggle('is-active', index === 0));
    });
    refresh();
  });

  mobileToggle?.addEventListener('click', () => {
    rail?.classList.toggle('is-open');
    mobileToggle.textContent = rail?.classList.contains('is-open') ? 'CLOSE FILTERS' : 'FILTER PLAYERS';
  });

  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape') {
      rail?.classList.remove('is-open');
      if (mobileToggle) mobileToggle.textContent = 'FILTER PLAYERS';
    }
  });
</script>
