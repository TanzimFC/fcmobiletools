---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { playerReviews, getTier } from './playerReviewData.js';
import './player-reviews.css';

const tierGroups = [
  ['All ratings', 'all'],
  ['Elite', 'Elite'],
  ['Strong', 'Strong'],
  ['Solid', 'Solid'],
  ['Mixed', 'Mixed'],
  ['Weak', 'Weak']
];

const positionGroups = ['All positions', ...new Set(playerReviews.map((player) => player.position))];
const eventGroups = ['All events', ...new Set(playerReviews.map((player) => player.event))];
const weakFootGroups = ['All weak foot', ...new Set(playerReviews.map((player) => player.weakFoot + '★'))];
const skillGroups = ['All skill moves', ...new Set(playerReviews.map((player) => player.skillMoves + '★'))];
---
<BaseLayout
  title="FC Mobile Player Reviews"
  description="Premium editorial FC Mobile player reviews with card-first discovery, ratings, attributes and PlayStyles."
>
  <main class="review-page">
    <div class="review-shell">
      <header class="review-hero">
        <div>
          <p class="review-kicker">TANZIMFC / PLAYER REVIEWS</p>
          <h1>Every card.<br /><em>Properly reviewed.</em></h1>
          <p>A premium, card-first player library. Pick a player to open the complete review—ratings, strengths, weaknesses, fit, PlayStyles and source-linked card data.</p>
        </div>
        <div class="review-head-stat">
          <span>REVIEWS LIVE</span>
          <strong>{String(playerReviews.length).padStart(2, '0')}</strong>
          <small>EDITORIAL LIBRARY</small>
        </div>
      </header>

      <button class="review-mobile-filter" id="mobile-filter-open" type="button">FILTER PLAYERS · {playerReviews.length} LIVE</button>

      <div class="review-workspace">
        <aside class="review-sidebar" id="review-sidebar" aria-label="Player review filters">
          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Find a player</p>
            <label class="review-search">
              <input id="review-search" type="search" placeholder="Search player…" autocomplete="off" />
              <span>⌕</span>
            </label>
          </div>

          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Rating</p>
            <div class="review-filter-list" data-filter-group="tier">
              {tierGroups.map(([label, value]) => (
                <button class:list={['review-filter-button', value === 'all' ? 'is-active' : '']} type="button" data-value={value}>
                  <span>{label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Position</p>
            <div class="review-filter-list" data-filter-group="position">
              {positionGroups.map((label, index) => (
                <button class:list={['review-filter-button', index === 0 ? 'is-active' : '']} type="button" data-value={index === 0 ? 'all' : label}>
                  <span>{label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Event</p>
            <div class="review-filter-list" data-filter-group="event">
              {eventGroups.map((label, index) => (
                <button class:list={['review-filter-button', index === 0 ? 'is-active' : '']} type="button" data-value={index === 0 ? 'all' : label}>
                  <span>{label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Player profile</p>
            <div class="review-filter-list" data-filter-group="weakFoot">
              {weakFootGroups.map((label, index) => (
                <button class:list={['review-filter-button', index === 0 ? 'is-active' : '']} type="button" data-value={index === 0 ? 'all' : label}>
                  <span>{label}</span>
                </button>
              ))}
            </div>
            <div class="review-filter-list" data-filter-group="skillMoves" style="margin-top:6px">
              {skillGroups.map((label, index) => (
                <button class:list={['review-filter-button', index === 0 ? 'is-active' : '']} type="button" data-value={index === 0 ? 'all' : label}>
                  <span>{label}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="review-sidebar-section">
            <p class="review-sidebar-title">Scale</p>
            <div class="review-legend">
              <div class="review-legend-row"><span>9.0 — 10.0 · Elite / Strong</span><i class="review-legend-dot dot-green"></i></div>
              <div class="review-legend-row"><span>7.0 — 7.9 · Solid</span><i class="review-legend-dot dot-yellow"></i></div>
              <div class="review-legend-row"><span>5.0 — 6.9 · Mixed / Weak</span><i class="review-legend-dot dot-red"></i></div>
            </div>
          </div>

          <div class="review-sidebar-section">
            <button class="review-reset" id="review-reset" type="button">RESET FILTERS</button>
          </div>
        </aside>

        <section class="review-library">
          <section class="review-library-head">
            <div>
              <p>01 / PLAYER LIBRARY</p>
              <h2>Latest reviews</h2>
            </div>
            <span id="review-result-count" class="review-result-count">{playerReviews.length} review{playerReviews.length === 1 ? '' : 's'}</span>
          </section>

          <section class="review-stage">
            <div class="review-grid" id="review-grid" aria-live="polite">
              {playerReviews.map((player, index) => (
                <a
                  class="player-tile"
                  href={'/player-reviews/' + player.slug + '/'}
                  data-card
                  data-search={(player.name + ' ' + player.event + ' ' + player.position).toLowerCase()}
                  data-tier={getTier(player.review.overall).name}
                  data-position={player.position}
                  data-event={player.event}
                  data-weak-foot={player.weakFoot + '★'}
                  data-skill-moves={player.skillMoves + '★'}
                  aria-label={'Open ' + player.name + ' player review'}
                >
                  <div class="player-card-frame">
                    <img src={player.cardImage} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
                  </div>
                  <span class="player-name">{player.name}</span>
                </a>
              ))}
              <div class="review-empty" id="review-empty" hidden>
                <div><strong>No player cards found.</strong><span>Try another search or filter.</span></div>
              </div>
            </div>
          </section>

          <section class="review-rating-strip">
            <div>
              <span class="review-strip-kicker">RATING SCALE</span>
              <strong>5.0 — 10.0</strong>
            </div>
            <div class="review-meter">
              <span><i class="meter-red"></i>Weak</span>
              <span><i class="meter-red"></i>Mixed</span>
              <span><i class="meter-yellow"></i>Solid</span>
              <span><i class="meter-green"></i>Strong</span>
              <span><i class="meter-green"></i>Elite</span>
            </div>
          </section>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const mobileOpen = document.querySelector('#mobile-filter-open');
  const sidebar = document.querySelector('#review-sidebar');
  const search = document.querySelector('#review-search');
  const reset = document.querySelector('#review-reset');
  const cards = [...document.querySelectorAll('[data-card]')];
  const count = document.querySelector('#review-result-count');
  const empty = document.querySelector('#review-empty');

  const state = {
    search: '',
    tier: 'all',
    position: 'all',
    event: 'all',
    weakFoot: 'all',
    skillMoves: 'all'
  };

  const groups = [...document.querySelectorAll('[data-filter-group]')];

  function setGroupState(group, value) {
    group.querySelectorAll('button').forEach((button) => {
      button.classList.toggle('is-active', button.dataset.value === value);
    });
  }

  function applyFilters() {
    const q = state.search.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const show =
        (!q || card.dataset.search.includes(q)) &&
        (state.tier === 'all' || card.dataset.tier === state.tier) &&
        (state.position === 'all' || card.dataset.position === state.position) &&
        (state.event === 'all' || card.dataset.event === state.event) &&
        (state.weakFoot === 'all' || card.dataset.weakFoot === state.weakFoot) &&
        (state.skillMoves === 'all' || card.dataset.skillMoves === state.skillMoves);

      card.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = visible + ' review' + (visible === 1 ? '' : 's');
  }

  groups.forEach((group) => {
    const groupName = group.dataset.filterGroup;
    group.addEventListener('click', (event) => {
      const button = event.target.closest('button');
      if (!button) return;
      state[groupName] = button.dataset.value;
      setGroupState(group, button.dataset.value);
      applyFilters();
    });
  });

  search?.addEventListener('input', () => {
    state.search = search.value;
    applyFilters();
  });

  reset?.addEventListener('click', () => {
    Object.assign(state, { search: '', tier: 'all', position: 'all', event: 'all', weakFoot: 'all', skillMoves: 'all' });
    if (search) search.value = '';
    groups.forEach((group) => setGroupState(group, 'all'));
    applyFilters();
  });

  mobileOpen?.addEventListener('click', () => {
    sidebar?.classList.toggle('is-mobile-open');
    mobileOpen.textContent = sidebar?.classList.contains('is-mobile-open') ? 'CLOSE FILTERS' : 'FILTER PLAYERS · 01 LIVE';
  });

  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape') {
      sidebar?.classList.remove('is-mobile-open');
      if (mobileOpen) mobileOpen.textContent = 'FILTER PLAYERS · 01 LIVE';
    }
  });
</script>
