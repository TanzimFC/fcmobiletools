---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { playerReviews, getTier } from './playerReviewData.js';
import './player-reviews.css';

const tiers = ['All ratings', 'Elite', 'Strong', 'Solid', 'Mixed', 'Weak'];
const positions = ['All positions', ...new Set(playerReviews.map((player) => player.position))];
const events = ['All events', ...new Set(playerReviews.map((player) => player.event))];
const weakFeet = ['Weak Foot', ...new Set(playerReviews.map((player) => player.weakFoot + '★'))];
const skillMoves = ['Skill Moves', ...new Set(playerReviews.map((player) => player.skillMoves + '★'))];
---
<BaseLayout
  title="FC Mobile Player Reviews"
  description="Detailed FC Mobile player reviews with full card stats, substats, PlayStyles, strengths, weaknesses and editorial ratings."
>
  <main class="review-page review-home">
    <div class="review-noise"></div>
    <div class="review-light review-light-a"></div>
    <div class="review-light review-light-b"></div>

    <div class="review-shell">
      <header class="review-home-head">
        <div>
          <p class="review-eyebrow">TANZIMFC / PLAYER REVIEWS</p>
          <h1>Every card.<br /><span>Properly reviewed.</span></h1>
          <p class="review-home-lede">A focused FC Mobile player library built around the card itself. Search, filter and open a player for the full review.</p>
        </div>
        <div class="review-head-stat">
          <span>REVIEWS LIVE</span>
          <strong>{playerReviews.length.toString().padStart(2, '0')}</strong>
          <small>EDITORIAL LIBRARY</small>
        </div>
      </header>

      <section class="review-command-bar" aria-label="Player review search and filters">
        <label class="review-search">
          <span>⌕</span>
          <input id="review-search" type="search" placeholder="Search player, event or position…" autocomplete="off" />
          <kbd>⌘ K</kbd>
        </label>

        <div class="review-filter">
          <span>RATING</span>
          <select id="review-tier" aria-label="Filter by rating">{tiers.map((item) => <option value={item}>{item}</option>)}</select>
        </div>
        <div class="review-filter">
          <span>POSITION</span>
          <select id="review-position" aria-label="Filter by position">{positions.map((item) => <option value={item}>{item}</option>)}</select>
        </div>
        <div class="review-filter">
          <span>EVENT</span>
          <select id="review-event" aria-label="Filter by event">{events.map((item) => <option value={item}>{item}</option>)}</select>
        </div>
        <div class="review-filter optional-filter">
          <span>WEAK FOOT</span>
          <select id="review-weak-foot" aria-label="Filter by weak foot">{weakFeet.map((item) => <option value={item}>{item}</option>)}</select>
        </div>
        <div class="review-filter optional-filter">
          <span>SKILL MOVES</span>
          <select id="review-skill-moves" aria-label="Filter by skill moves">{skillMoves.map((item) => <option value={item}>{item}</option>)}</select>
        </div>
      </section>

      <section class="review-library-head">
        <div>
          <span class="review-section-number">01</span>
          <div>
            <p>PLAYER LIBRARY</p>
            <h2>Latest reviews</h2>
          </div>
        </div>
        <span id="review-result-count" class="review-result-count">{playerReviews.length} review{playerReviews.length === 1 ? '' : 's'}</span>
      </section>

      <section class={'review-card-stage' + (playerReviews.length === 1 ? ' single' : '')}>
        <div class="stage-grid"></div>
        <div class="stage-sheen"></div>
        <div class="review-grid" id="review-grid" aria-live="polite">
          {playerReviews.map((player, index) => (
            <a
              class="player-tile"
              href={'/player-reviews/' + player.slug + '/'}
              data-card
              data-search={(player.name + ' ' + player.event + ' ' + player.position + ' ' + player.alternatePositions.join(' ')).toLowerCase()}
              data-tier={getTier(player.review.overall).name}
              data-position={player.position}
              data-event={player.event}
              data-weak-foot={player.weakFoot + '★'}
              data-skill-moves={player.skillMoves + '★'}
              aria-label={'Open ' + player.name + ' player review'}
            >
              <div class="player-card-frame">
                <div class="player-card-aura"></div>
                <div class="player-card-glass"></div>
                <img src={player.cardImage} alt={player.ovr + ' OVR ' + player.name + ' player card'} loading={index === 0 ? 'eager' : 'lazy'} />
              </div>
              <span class="player-name">{player.name}</span>
            </a>
          ))}
          <div id="review-empty" class="empty-state" hidden>
            <strong>No reviews found</strong>
            <span>Try another search or filter.</span>
          </div>
        </div>
      </section>

      <section class="review-rating-strip">
        <div>
          <span class="review-strip-kicker">RATING SYSTEM</span>
          <strong>5.0 — 10.0</strong>
        </div>
        <div class="review-meter">
          <span><i class="meter-red"></i>Weak</span>
          <span><i class="meter-red"></i>Mixed</span>
          <span><i class="meter-yellow"></i>Solid</span>
          <span><i class="meter-green"></i>Strong</span>
          <span><i class="meter-green"></i>Elite</span>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector('#review-search');
  const tier = document.querySelector('#review-tier');
  const position = document.querySelector('#review-position');
  const event = document.querySelector('#review-event');
  const weakFoot = document.querySelector('#review-weak-foot');
  const skillMoves = document.querySelector('#review-skill-moves');
  const cards = [...document.querySelectorAll('[data-card]')];
  const empty = document.querySelector('#review-empty');
  const count = document.querySelector('#review-result-count');

  function filterCards() {
    const query = (search?.value || '').trim().toLowerCase();
    const filters = {
      tier: tier?.value || 'All ratings',
      position: position?.value || 'All positions',
      event: event?.value || 'All events',
      weakFoot: weakFoot?.value || 'Weak Foot',
      skillMoves: skillMoves?.value || 'Skill Moves'
    };

    let visible = 0;

    cards.forEach((card) => {
      const show =
        (!query || card.dataset.search.includes(query)) &&
        (filters.tier === 'All ratings' || card.dataset.tier === filters.tier) &&
        (filters.position === 'All positions' || card.dataset.position === filters.position) &&
        (filters.event === 'All events' || card.dataset.event === filters.event) &&
        (filters.weakFoot === 'Weak Foot' || card.dataset.weakFoot === filters.weakFoot) &&
        (filters.skillMoves === 'Skill Moves' || card.dataset.skillMoves === filters.skillMoves);

      card.hidden = !show;
      if (show) visible += 1;
    });

    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = visible + ' review' + (visible === 1 ? '' : 's');
  }

  [search, tier, position, event, weakFoot, skillMoves].forEach((control) => {
    control?.addEventListener(control === search ? 'input' : 'change', filterCards);
  });

  search?.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      search.focus();
    }
  });
</script>
