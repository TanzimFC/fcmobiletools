---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STAR_SIGNINGS_DATA } from '../data/fcMobileStarSignings.js';

const title = STAR_SIGNINGS_DATA.title;
const description = STAR_SIGNINGS_DATA.description;
const cutoffLabel = new Date(STAR_SIGNINGS_DATA.releaseCutoff + 'T00:00:00').toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
const fmt = (value) => Number(value).toLocaleString();
---
<BaseLayout title={title} description={description}>
<main class="star-page">
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{STAR_SIGNINGS_DATA.eyebrow} · FCMOBILETOOLS</p>
        <h1>Exchange <em>before</em> you tap.</h1>
        <p class="lede">Preview the Star Shards your cards should return, then see whether that exchange gets you closer to the Star Signing you want.</p>
        <div class="chips"><span>OVR + RELEASE ERA</span><span>BATCH PREVIEW</span><span>SIGNING TARGET</span></div>
      </div>
      <div class="hero-card"><small>RELEASE RULE CUTOFF</small><strong>{cutoffLabel}</strong><p>Use the card's first release date, not when you obtained it.</p></div>
    </div>
  </header>

  <section class="wrap section">
    <div class="panel">
      <div class="panel-head">
        <div><span class="label">EXCHANGE PREVIEW</span><h2>Build the exchange first</h2><p>Add every player you are about to release.</p></div>
        <button class="btn primary" id="addRow" type="button">Add player</button>
      </div>
      <div id="rows"></div>
      <div id="empty" class="empty">No players added. Add one to preview the return.</div>
      <div class="totals">
        <div><small>EXCHANGE RETURN</small><strong id="total">0</strong><span>Star Shards</span></div>
        <div><small>UNRESOLVED CARDS</small><strong id="unresolved">0</strong><span>missing a configured rule</span></div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="panel target-panel">
      <div class="panel-head">
        <div><span class="label">SIGNING PLANNER</span><h2>What does this exchange unlock?</h2><p>Enter your current balance and choose a managed Star Signing target.</p></div>
      </div>
      <div class="grid">
        <label class="field"><span>CURRENT STAR SHARDS</span><input id="current" class="input" type="number" min="0" step="1" value="0"></label>
        <label class="field"><span>STAR SIGNING TARGET</span><select id="target" class="input"></select></label>
      </div>
      <div id="targetCard" class="target-card"></div>
      <div class="progress"><i id="progress"></i></div>
      <div class="progress-meta"><span id="status">Choose a target</span><b id="percent">0%</b></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-title"><div><p class="eyebrow">REFERENCE</p><h2>Release value rules</h2></div><p>These are editable from Admin because FC Mobile can change the exchange rules over time.</p></div>
    <div class="table">
      <div class="tr head"><span>OVR</span><span>Before {cutoffLabel}</span><span>On / after {cutoffLabel}</span></div>
      {STAR_SIGNINGS_DATA.releaseValueRules.map(rule => <div class="tr"><span>{rule.minOvr === rule.maxOvr ? rule.minOvr : rule.minOvr + '–' + rule.maxOvr}</span><span>{rule.beforeCutoff == null ? '—' : fmt(rule.beforeCutoff)}</span><span>{rule.afterCutoff == null ? '—' : fmt(rule.afterCutoff)}</span></div>)}
    </div>
  </section>
</main>
</BaseLayout>

<style>
.star-page{background:var(--bg);color:var(--text);overflow:hidden}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}.hero{border-bottom:1px solid var(--line);background:radial-gradient(circle at 78% 25%,#55c7f216,transparent 30%),linear-gradient(145deg,#071017,#05090d 62%,#07111a)}.hero-grid{min-height:560px;display:grid;grid-template-columns:1fr 360px;gap:60px;align-items:center;padding:80px 0}.eyebrow,.label{color:var(--blue);font:900 9px var(--mono);letter-spacing:.15em}.hero h1{font-size:clamp(50px,7vw,88px);line-height:.9;letter-spacing:-.07em;margin:18px 0}.hero h1 em{color:var(--blue);font-style:normal}.lede{max-width:680px;color:#9ab0bb;font-size:14px;line-height:1.8}.chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:26px}.chips span{padding:7px 9px;border:1px solid #29414e;border-radius:999px;color:#78909b;font:800 7px var(--mono)}.hero-card{padding:26px;border:1px solid #294655;border-radius:22px;background:linear-gradient(145deg,#0d1922ed,#071018ee);box-shadow:0 25px 80px #0008}.hero-card small{display:block;color:#718894;font:900 8px var(--mono);letter-spacing:.12em}.hero-card strong{display:block;margin:10px 0;font:900 28px var(--mono);color:#dff8ff}.hero-card p{color:#8197a3;font-size:9px;line-height:1.6}.section{padding:45px 0}.panel{padding:25px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,#0b141d,#071018);box-shadow:0 25px 70px #0005}.panel-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:18px}.panel-head h2,.section-title h2{margin:7px 0 5px;font-size:27px;letter-spacing:-.05em}.panel-head p,.section-title>p{margin:0;color:var(--muted);font-size:10px}.btn{padding:10px 13px;border:1px solid #29414e;border-radius:10px;background:#0c151c;color:#d7e8ef;font:800 8px var(--mono);cursor:pointer}.btn.primary{border-color:#69dcff;background:linear-gradient(135deg,#69e0ff,#2aa8e8);color:#04131c}.exchange-row{display:grid;grid-template-columns:1fr 1.2fr .7fr .8fr auto;gap:9px;align-items:end;padding:12px;border:1px solid #203541;border-radius:12px;background:#091219;margin-top:8px}.field{display:grid;gap:7px}.field>span{color:#78909b;font:900 7px var(--mono)}.input{width:100%;padding:11px 12px;border:1px solid #29414e;border-radius:10px;background:#061017;color:#fff;outline:0;font:800 10px var(--mono)}.input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #55c7f210}.row-return{padding-bottom:11px;color:#9ed7e9;font:900 8px var(--mono)}.remove{width:36px;height:36px;border:1px solid #433138;border-radius:9px;background:#1a1114;color:#ff9b9c;cursor:pointer}.empty{padding:26px;border:1px dashed #29404b;border-radius:12px;color:#66808c;text-align:center;font-size:9px}.totals{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}.totals div{padding:15px;border:1px solid #203541;border-radius:12px;background:#091219}.totals small{display:block;color:#607985;font:900 7px var(--mono)}.totals strong{display:block;margin-top:6px;color:#dff8ff;font:900 25px var(--mono)}.totals span{color:#6f8793;font-size:8px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.target-card{margin-top:14px;padding:14px;border:1px solid #284553;border-radius:12px;background:#071119;min-height:72px}.target-card b{display:block;font-size:14px}.target-card span{display:block;color:#718894;font:800 8px var(--mono);margin-top:4px}.progress{height:9px;margin-top:14px;border:1px solid #203542;border-radius:999px;background:#051018;overflow:hidden}.progress i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--blue),#5de2ff);border-radius:999px}.progress-meta{display:flex;justify-content:space-between;margin-top:7px;color:#657c88;font:800 7px var(--mono)}.progress-meta b{color:#bfefff}.section-title{display:flex;justify-content:space-between;gap:25px;align-items:end;margin-bottom:17px}.table{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#091219}.tr{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;padding:11px 14px;border-top:1px solid #182b35;color:#b8c9d1;font:800 9px var(--mono)}.tr.head{border-top:0;background:#0d1820;color:#66808c;font-size:7px;letter-spacing:.1em}@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-card{max-width:430px}.exchange-row{grid-template-columns:1fr 1fr 1fr}.row-return{grid-column:1/3}.panel-head{align-items:start;flex-direction:column}}@media(max-width:600px){.wrap{width:calc(100% - 26px)}.hero-grid{padding:65px 0 50px}.hero h1{font-size:clamp(46px,14vw,72px)}.grid,.totals{grid-template-columns:1fr}.exchange-row{grid-template-columns:1fr 1fr}.row-return{grid-column:1/-1}.section-title{align-items:start;flex-direction:column}}
</style>

<script define:vars={{ starData: STAR_SIGNINGS_DATA }}>
  const data = starData;
  const rows = [];
  const $ = (s) => document.querySelector(s);
  const fmt = (v) => Number(v || 0).toLocaleString();
  const els = {
    rows: $('#rows'), empty: $('#empty'), total: $('#total'), unresolved: $('#unresolved'),
    current: $('#current'), target: $('#target'), targetCard: $('#targetCard'),
    progress: $('#progress'), status: $('#status'), percent: $('#percent')
  };

  function ruleFor(ovr, era) {
    const rule = data.releaseValueRules.find((item) => Number(ovr) >= item.minOvr && Number(ovr) <= item.maxOvr);
    if (!rule) return null;
    const value = era === 'after' ? rule.afterCutoff : rule.beforeCutoff;
    return Number.isFinite(Number(value)) ? Number(value) : null;
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function renderRows() {
    els.rows.innerHTML = rows.map((row, index) => {
      const each = ruleFor(row.ovr, row.era);
      return '<div class="exchange-row" data-index="' + index + '">' +
        '<label class="field"><span>OVR</span><input class="input" data-key="ovr" type="number" min="1" value="' + row.ovr + '"></label>' +
        '<label class="field"><span>CARD ERA</span><select class="input" data-key="era"><option value="before" ' + (row.era === 'before' ? 'selected' : '') + '>Before ' + data.releaseCutoff + '</option><option value="after" ' + (row.era === 'after' ? 'selected' : '') + '>On / after ' + data.releaseCutoff + '</option></select></label>' +
        '<label class="field"><span>QUANTITY</span><input class="input" data-key="count" type="number" min="1" step="1" value="' + row.count + '"></label>' +
        '<div class="row-return">' + (each == null ? 'No rule' : fmt(each) + ' each') + '</div>' +
        '<button class="remove" type="button" data-remove="' + index + '">×</button>' +
      '</div>';
    }).join('');
    els.empty.style.display = rows.length ? 'none' : 'block';
    document.querySelectorAll('[data-index]').forEach((row) => {
      row.querySelectorAll('[data-key]').forEach((input) => input.addEventListener('input', () => {
        const i = Number(row.dataset.index);
        const key = input.dataset.key;
        rows[i][key] = key === 'era' ? input.value : Math.max(0, Math.floor(Number(input.value) || 0));
        render();
      }));
    });
    document.querySelectorAll('[data-remove]').forEach((button) => button.addEventListener('click', () => {
      rows.splice(Number(button.dataset.remove), 1);
      render();
    }));
  }

  function exchangeTotal() {
    let total = 0;
    let unresolved = 0;
    for (const row of rows) {
      const each = ruleFor(row.ovr, row.era);
      const count = Math.max(0, Math.floor(Number(row.count) || 0));
      if (each == null) unresolved += count;
      else total += each * count;
    }
    return { total, unresolved };
  }

  function renderTargetOptions() {
    const players = data.players.filter((item) => item.enabled !== false);
    els.target.innerHTML = '<option value="">Choose a Star Signing</option>' + players.map((player) =>
      '<option value="' + escapeHtml(player.id) + '">' + escapeHtml(player.name) + ' · ' + player.ovr + ' OVR · ' + fmt(player.cost) + '</option>'
    ).join('');
  }

  function renderTarget() {
    const result = exchangeTotal();
    const player = data.players.find((item) => item.id === els.target.value && item.enabled !== false);
    const current = Math.max(0, Math.floor(Number(els.current.value) || 0));
    const after = current + result.total;
    els.total.textContent = fmt(result.total);
    els.unresolved.textContent = result.unresolved;
    if (!player) {
      els.targetCard.innerHTML = '<span>Choose a signing target to see whether this exchange is enough.</span>';
      els.progress.style.width = '0%';
      els.status.textContent = 'Choose a target';
      els.percent.textContent = '0%';
      return;
    }
    const remaining = Math.max(player.cost - after, 0);
    const surplus = Math.max(after - player.cost, 0);
    const pct = player.cost ? Math.min(after / player.cost * 100, 100) : 0;
    els.targetCard.innerHTML = '<b>' + escapeHtml(player.name) + '</b><span>' + escapeHtml(player.position || '') + ' · ' + player.ovr + ' OVR · ' + fmt(player.cost) + ' Star Shards</span><span>After this exchange: ' + fmt(after) + ' shards</span>';
    els.progress.style.width = pct + '%';
    els.status.textContent = remaining ? fmt(remaining) + ' still needed' : (surplus ? fmt(surplus) + ' surplus' : 'Exactly funded');
    els.percent.textContent = Math.round(pct) + '%';
  }

  function render() {
    renderRows();
    renderTarget();
  }

  $('#addRow').addEventListener('click', () => { rows.push({ovr:117, era:'before', count:1}); render(); });
  $('#current').addEventListener('input', renderTarget);
  $('#target').addEventListener('change', renderTarget);
  renderTargetOptions();
  render();
</script>
