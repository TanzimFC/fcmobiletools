---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
import { getQuestionOptions } from '../../../data/aNationsStoryOptions.js';

export function getStaticPaths() {
  return NATIONS_STORY.flatMap((nation) => nation.days.map((day) => ({
    params: { country: nation.slug, day: day.id },
    props: { nation, day }
  })));
}
const { nation, day } = Astro.props;
const dayNumber = day.id.replace('day-', '');
const title = `FC Mobile ${nation.name} A Nation's Story Day ${dayNumber} Answers | All Questions & Options`;
const description = `FC Mobile A Nation's Story ${nation.name} Day ${dayNumber} answers. See every question, all A-D options and the correct answer instantly.`;
const allDays = nation.days;
const imageMap = {
  japan: '/assets/images/anationstory/AN_japan_thumbnail.png',
  netherlands: '/assets/images/anationstory/AN_netherlands_thumbnail.png',
  mexico: '/assets/images/anationstory/AN_mexico_thumbnail (2).png',
  france: '/assets/images/anationstory/AN_france_thumbnail.png',
  brazil: '/assets/images/anationstory/AN_brazil_thumbnail.png'
};
---
<BaseLayout title={title} description={description}>
  <main class="answer-page">
    <div class="crumb"><a href="/a-nations-story/">A Nation's Story</a><span>/</span><a href={`/a-nations-story/${nation.slug}/`}>{nation.name}</a><span>/</span>Day {dayNumber}</div>

    <header class="hero">
      <div class="hero-copy">
        <div class="hero-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} /></div>
        <div><span class="eyebrow">{nation.flag} {nation.name.toUpperCase()} · DAY {dayNumber} · {day.level ? day.level.toUpperCase() : 'DAILY'}</span><h1>Day {dayNumber}<br><span>answers.</span></h1><p>{day.questions.length} {day.questions.length === 1 ? 'question' : 'questions'} with every A-D option from the published answer set. The correct answer is highlighted so you can get back to FC Mobile fast.</p></div>
      </div>
      <div class="hero-action"><button id="copy-all" type="button">COPY ANSWER KEY</button><button id="toggle-answers" class="ghost" type="button">HIDE ANSWERS</button><small>{day.challenge || 'Daily challenge'} · answer-first mode</small></div>
    </header>

    <nav class="day-nav" aria-label="Day navigation">
      {allDays.map((item) => <a class:list-active={item.id === day.id} href={`/a-nations-story/${nation.slug}/${item.id}/`} aria-current={item.id === day.id ? 'page' : undefined}>{item.id.replace('day-','Day ')}</a>)}
    </nav>

    <div class="quickbar"><span><b>{day.questions.length}</b> questions</span><span><b>4</b> options each</span><span id="solved-count"><b>0</b> solved</span><button id="mark-all" type="button">MARK ALL SOLVED</button></div>

    <section class="questions">
      {day.questions.map((question, index) => {
        const options = getQuestionOptions(nation.slug, day.id, index);
        return <article class="question-card" id={`q-${index + 1}`} data-question={index + 1}>
          <div class="q-head"><span>DAY {dayNumber} · QUESTION {String(index + 1).padStart(2,'0')}</span><div class="q-actions"><button class="copy" type="button" data-answer={question.answer}>COPY</button><button class="solve" type="button" aria-label={`Mark question ${index + 1} solved">✓</button></div></div>
          <h2>{question.question}</h2>
          {question.hint && <p class="hint"><b>HINT</b> {question.hint}</p>}
          <div class="options" role="list">
            {options.map((option, optionIndex) => <button class:list-correct={option === question.answer} class="option" type="button" role="listitem" data-correct={option === question.answer ? 'true' : 'false'}><span class="letter">{String.fromCharCode(65 + optionIndex)}</span><span>{option}</span>{option === question.answer && <strong>✓ CORRECT</strong>}</button>)}
          </div>
          <div class="answer"><span>CORRECT ANSWER</span><strong>{question.answer}</strong></div>
        </article>;
      })}
    </section>

    <section class="after">
      <div><span class="eyebrow">DAY {dayNumber} COMPLETE</span><h2>Need another day?</h2></div>
      <div class="links"><a href={`/a-nations-story/${nation.slug}/`}>← All {nation.name} days</a><a href="/a-nations-story/">All nations →</a></div>
    </section>

    <section class="seo"><span class="eyebrow">FC MOBILE {nation.name.toUpperCase()} DAY {dayNumber} ANSWERS</span><h2>FC Mobile A Nation's Story {nation.name} Day {dayNumber} answers</h2><p>This page is an answer-first reference for {nation.name} Day {dayNumber} in FC Mobile A Nation's Story. It includes the full question, all four answer options and the correct answer so players can find the exact answer they need without replaying the trivia.</p><p>Search engines can index the actual question text, while the day structure matches how FC Mobile players commonly refer to each challenge: Day 1, Day 2, through Day 9.</p><p>Source cross-check: <a href={nation.sourceUrl} target="_blank" rel="nofollow noopener">{nation.source}</a>. TanzimFC is an independent fan reference and is not affiliated with EA.</p></section>
  </main>
</BaseLayout>

<script define:vars={{ nationSlug: nation.slug, dayId: day.id }}>
  const copy = async (text) => { try { await navigator.clipboard.writeText(text); return true; } catch { return false; } };
  const key = `tanzimfc:nation-story:${nationSlug}:${dayId}:solved`;
  const cards = [...document.querySelectorAll('.question-card')];
  const solved = new Set(JSON.parse(localStorage.getItem(key) || '[]'));
  const countEl = document.querySelector('#solved-count b');
  const updateCount = () => { if (countEl) countEl.textContent = String(solved.size); };
  const save = () => localStorage.setItem(key, JSON.stringify([...solved]));
  cards.forEach((card) => {
    const id = card.dataset.question;
    if (solved.has(id)) card.classList.add('is-solved');
    card.querySelector('.solve')?.addEventListener('click', () => {
      solved.has(id) ? solved.delete(id) : solved.add(id);
      card.classList.toggle('is-solved', solved.has(id)); save(); updateCount();
    });
    card.querySelectorAll('.option').forEach((button) => button.addEventListener('click', () => {
      card.querySelectorAll('.option').forEach((item) => item.classList.remove('is-picked'));
      button.classList.add('is-picked');
      if (button.dataset.correct === 'true') { solved.add(id); card.classList.add('is-solved'); save(); updateCount(); }
    }));
  });
  document.querySelectorAll('.copy').forEach((button) => button.addEventListener('click', async () => { const ok = await copy(button.dataset.answer || ''); const old = button.textContent; button.textContent = ok ? 'COPIED ✓' : 'SELECT & COPY'; setTimeout(() => button.textContent = old, 1200); }));
  document.querySelector('#copy-all')?.addEventListener('click', async () => { const answers = cards.map((card, i) => `${i + 1}. ${card.querySelector('.answer strong')?.textContent || ''}`).join('\n'); const ok = await copy(answers); const button = document.querySelector('#copy-all'); if (button) { button.textContent = ok ? 'COPIED KEY ✓' : 'SELECT & COPY'; setTimeout(() => button.textContent = 'COPY ANSWER KEY', 1400); } });
  document.querySelector('#mark-all')?.addEventListener('click', () => { cards.forEach((card) => { solved.add(card.dataset.question); card.classList.add('is-solved'); }); save(); updateCount(); });
  const toggle = document.querySelector('#toggle-answers');
  toggle?.addEventListener('click', () => { document.body.classList.toggle('answers-hidden'); toggle.textContent = document.body.classList.contains('answers-hidden') ? 'SHOW ANSWERS' : 'HIDE ANSWERS'; });
  updateCount();
</script>

<style>
.answer-page{max-width:1060px;margin:auto;padding:0 20px 100px}.crumb{padding-top:25px;color:var(--muted);font:800 8px var(--mono)}.crumb a{color:var(--text);text-decoration:none}.crumb span{padding:0 7px;color:var(--border)}.hero{padding:48px 0 38px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:40px;align-items:end}.hero-copy{display:grid;grid-template-columns:180px 1fr;gap:25px;align-items:center}.hero-media{height:145px;border-radius:16px;overflow:hidden;border:1px solid var(--border);background:var(--surface)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.hero h1{font-size:clamp(48px,7vw,82px);line-height:.9;letter-spacing:-.075em;margin:15px 0}.hero h1 span{color:var(--blue)}.hero p{max-width:650px;color:var(--muted);font-size:11px;line-height:1.8}.hero-action{display:grid;gap:7px;text-align:right;min-width:185px}.hero-action button,.copy,.solve,.quickbar button{border:1px solid var(--blue);background:var(--blue);color:#06131a;border-radius:8px;padding:10px 12px;font:900 7px var(--mono);cursor:pointer}.hero-action .ghost{background:transparent;color:var(--blue)}.hero-action small{color:var(--muted);font:700 7px var(--mono)}.day-nav{display:flex;gap:5px;overflow:auto;padding:13px 0;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:5;background:var(--bg)}.day-nav a{flex:0 0 auto;padding:8px 12px;border:1px solid var(--border);border-radius:7px;color:var(--muted);text-decoration:none;font:900 7px var(--mono)}.day-nav a:hover,.day-nav a.list-active{background:var(--blue);border-color:var(--blue);color:#06131a}.quickbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:12px 0}.quickbar span{padding:7px 9px;border:1px solid var(--border);border-radius:7px;font:800 7px var(--mono);color:var(--muted)}.quickbar b{color:var(--text)}.quickbar button{margin-left:auto;padding:8px 10px}.questions{padding:10px 0 28px;display:grid;gap:12px}.question-card{padding:20px;border:1px solid var(--border);border-radius:15px;background:var(--surface);scroll-margin-top:90px;transition:.18s}.question-card.is-solved{border-color:#55c7f255;box-shadow:0 10px 40px #55c7f208}.q-head{display:flex;justify-content:space-between;gap:15px;align-items:center}.q-head>span{font:900 8px var(--mono);color:var(--blue);letter-spacing:.12em}.q-actions{display:flex;gap:5px}.copy{padding:7px 9px;background:transparent;color:var(--blue)}.solve{padding:6px 9px;background:transparent;color:var(--muted);border-color:var(--border)}.is-solved .solve{background:#55c7f215;border-color:#55c7f255;color:var(--blue)}.question-card h2{font-size:20px;line-height:1.4;letter-spacing:-.025em;margin:17px 0}.hint{font-size:10px;line-height:1.6;color:var(--muted);padding:10px;border-left:2px solid var(--border);margin:0 0 14px}.hint b{font:900 7px var(--mono);color:var(--blue);margin-right:6px}.options{display:grid;grid-template-columns:1fr 1fr;gap:7px}.option{display:grid;grid-template-columns:29px 1fr auto;align-items:center;gap:9px;text-align:left;min-height:48px;padding:9px;border:1px solid var(--border);border-radius:10px;background:transparent;color:var(--text);cursor:pointer;font:600 10px var(--sans);transition:.15s}.option:hover,.option.is-picked{border-color:#55c7f255;background:#55c7f208}.option.list-correct,.option[data-correct="true"]{border-color:#55c7f244}.option .letter{width:29px;height:29px;display:grid;place-items:center;border-radius:7px;background:var(--border);font:900 8px var(--mono);color:var(--muted)}.option strong{font:900 6px var(--mono);color:var(--blue);white-space:nowrap}.answer{margin-top:10px;padding:13px;border-radius:10px;background:#55c7f20a;border:1px solid #55c7f21f}.answer span{display:block;font:900 7px var(--mono);letter-spacing:.12em;color:var(--muted)}.answer strong{display:block;margin-top:4px;color:var(--blue);font-size:18px;line-height:1.25}.answers-hidden .answer,.answers-hidden .option[data-correct="true"]{opacity:.35;filter:blur(4px)}.answers-hidden .option[data-correct="true"] strong{opacity:0}.after{border-top:1px solid var(--border);padding:55px 0;display:flex;justify-content:space-between;gap:30px;align-items:end}.after h2{font-size:35px;letter-spacing:-.06em;margin:9px 0}.links{display:flex;gap:7px;flex-wrap:wrap}.links a{padding:10px 12px;border:1px solid var(--border);border-radius:8px;color:var(--text);text-decoration:none;font:900 8px var(--mono)}.links a:hover{border-color:#55c7f255}.seo{border-top:1px solid var(--border);padding:55px 0 0;max-width:850px}.seo h2{font-size:29px;letter-spacing:-.05em;margin:9px 0 14px}.seo p{font-size:11px;line-height:1.8;color:var(--muted)}.seo a{color:var(--text)}@media(max-width:760px){.answer-page{padding:0 14px 75px}.hero{display:block;padding-top:38px}.hero-copy{grid-template-columns:1fr}.hero-media{height:170px}.hero-action{text-align:left;margin-top:20px}.hero h1{font-size:55px}.options{grid-template-columns:1fr}.quickbar button{margin-left:0}.after{display:block}.links{margin-top:18px}}
</style>
