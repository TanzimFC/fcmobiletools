---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
import { getQuestionOptions } from '../../../data/aNationsStoryOptions.js';

export function getStaticPaths() {
  return NATIONS_STORY.flatMap((nation) => nation.days.map((day) => ({ params: { country: nation.slug, day: day.id }, props: { nation, day } })));
}
const { nation, day } = Astro.props;
const dayNumber = day.id.replace('day-', '');
const title = `FC Mobile ${nation.name} A Nation's Story Day ${dayNumber} Answers | All Questions & Options`;
const description = `FC Mobile A Nation's Story ${nation.name} Day ${dayNumber} answers. See every question, all four options and the correct answer instantly.`;
const allDays = nation.days;
const imageMap = { japan:'/assets/images/anationstory/AN_japan_thumbnail.png', netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png', mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png', france:'/assets/images/anationstory/AN_france_thumbnail.png', brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png' };
const themeMap = { japan:'#d9233f', netherlands:'#f28c28', mexico:'#1c9a5a', france:'#2878d8', brazil:'#16a05d' };
const theme = themeMap[nation.slug] ?? '#55c7f2';
---
<BaseLayout title={title} description={description}>
  <main class="answer-page" style={`--nation:${theme};--nation-soft:${theme}18;--nation-border:${theme}45`}>
    <div class="crumb"><a href="/a-nations-story/">A Nation's Story</a><span>/</span><a href={`/a-nations-story/${nation.slug}/`}>{nation.name}</a><span>/</span>Day {dayNumber}</div>

    <header class="hero">
      <div class="hero-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story Day ${dayNumber}`} /></div>
      <div class="hero-copy"><span class="eyebrow">{nation.flag} {nation.name.toUpperCase()} · A NATION'S STORY</span><h1>Day {dayNumber}<br><span>answers.</span></h1><p>Every question, every option and the answer in one quick glance. No quiz to complete first.</p></div>
      <button id="test-mode" type="button">TEST MODE <span>OFF</span></button>
    </header>

    <nav class="day-nav" aria-label="A Nation's Story day navigation">{allDays.map((item) => <a class:list-active={item.id === day.id} href={`/a-nations-story/${nation.slug}/${item.id}/`} aria-current={item.id === day.id ? 'page' : undefined}>{item.id.replace('day-','Day ')}</a>)}</nav>

    <div class="quickbar"><strong>{day.questions.length} {day.questions.length === 1 ? 'QUESTION' : 'QUESTIONS'}</strong><span>Choose an option to check yourself</span><span class="legend"><i></i> Correct answer</span></div>

    <section class="questions">
      {day.questions.map((question, index) => {
        const options = getQuestionOptions(nation.slug, day.id, index);
        return <article class="question-card" id={`q-${index + 1}`}>
          <div class="q-top"><span>QUESTION {String(index + 1).padStart(2,'0')}</span><b>DAY {dayNumber}</b></div>
          <h2>{question.question}</h2>
          <div class="options" role="list" aria-label={`Options for question ${index + 1}`}>
            {options.map((option, optionIndex) => <button class:list-correct={option === question.answer} class="option" type="button" data-correct={option === question.answer ? 'true' : 'false'}><span class="letter">{String.fromCharCode(65 + optionIndex)}</span><span>{option}</span><span class="tick">✓</span></button>)}
          </div>
          <div class="answer-panel"><div class="answer-line"><span class="answer-check">✓</span><div><small>CORRECT ANSWER</small><strong>{question.answer}</strong></div></div><div class="explanation"><b>Why?</b><span>{question.hint || `For this question, the correct choice is ${question.answer}.`}</span></div></div>
        </article>;
      })}
    </section>

    <section class="after"><div><span class="eyebrow">DAY {dayNumber} COMPLETE</span><h2>Looking for another day?</h2></div><div class="links"><a href={`/a-nations-story/${nation.slug}/`}>All {nation.name} days →</a><a href="/a-nations-story/">All nations →</a></div></section>
    <section class="seo"><span class="eyebrow">FC MOBILE {nation.name.toUpperCase()} DAY {dayNumber}</span><h2>FC Mobile A Nation's Story {nation.name} Day {dayNumber} answers</h2><p>Find the FC Mobile A Nation's Story {nation.name} Day {dayNumber} answers with the complete question set and all four choices. This page follows the way players commonly search for the event: Day 1 through Day 9.</p><p>The answers are presented directly so you can match the wording from FC Mobile and get back to the event quickly.</p></section>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector('.answer-page');
  const testButton = document.querySelector('#test-mode');
  const cards = [...document.querySelectorAll('.question-card')];
  testButton?.addEventListener('click', () => { root?.classList.toggle('test-mode'); const on = root?.classList.contains('test-mode'); if (testButton) testButton.innerHTML = `TEST MODE <span>${on ? 'ON' : 'OFF'}</span>`; });
  cards.forEach((card) => card.querySelectorAll('.option').forEach((option) => option.addEventListener('click', () => { card.querySelectorAll('.option').forEach((item) => item.classList.remove('picked')); option.classList.add('picked'); if (option.dataset.correct === 'true') card.classList.add('got-it'); else card.classList.remove('got-it'); })));
</script>

<style>
.answer-page{max-width:1080px;margin:auto;padding:0 20px 100px}.crumb{padding-top:24px;color:var(--muted);font:800 8px var(--mono)}.crumb a{color:var(--text);text-decoration:none}.crumb span{padding:0 7px;color:var(--border)}.hero{padding:42px 0 34px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:300px 1fr auto;gap:30px;align-items:center}.hero-media{aspect-ratio:16/9;border-radius:16px;overflow:hidden;border:1px solid var(--border);background:var(--surface);box-shadow:0 18px 60px var(--nation-soft)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--nation)}.hero h1{font-size:clamp(48px,7vw,80px);line-height:.88;letter-spacing:-.075em;margin:14px 0}.hero h1 span{color:var(--nation)}.hero p{max-width:600px;color:var(--muted);font-size:12px;line-height:1.75}.hero>button{border:1px solid var(--nation-border);background:var(--nation-soft);color:var(--nation);border-radius:9px;padding:11px 13px;font:900 7px var(--mono);cursor:pointer;white-space:nowrap}.hero>button span{opacity:.7;margin-left:5px}.day-nav{display:flex;gap:5px;overflow:auto;padding:13px 0;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:5;background:var(--bg)}.day-nav a{flex:0 0 auto;padding:9px 13px;border:1px solid var(--border);border-radius:8px;color:var(--muted);text-decoration:none;font:900 7px var(--mono)}.day-nav a:hover,.day-nav a.list-active{background:var(--nation);border-color:var(--nation);color:#fff}.quickbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:14px 0}.quickbar strong{font:900 8px var(--mono);color:var(--nation)}.quickbar span{font:700 9px var(--sans);color:var(--muted)}.legend{margin-left:auto}.legend i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--nation);margin-right:5px}.questions{display:grid;gap:12px}.question-card{padding:22px;border:1px solid var(--border);border-radius:16px;background:var(--surface);scroll-margin-top:80px;transition:.2s}.question-card:focus-within,.question-card.got-it{border-color:var(--nation-border);box-shadow:0 16px 55px var(--nation-soft)}.q-top{display:flex;justify-content:space-between;align-items:center;font:900 8px var(--mono);letter-spacing:.12em}.q-top span{color:var(--nation)}.q-top b{color:var(--muted)}.question-card h2{font-size:20px;line-height:1.4;letter-spacing:-.025em;margin:16px 0 16px}.options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.option{display:grid;grid-template-columns:31px 1fr 20px;align-items:center;gap:9px;min-height:52px;padding:9px 11px;text-align:left;border:1px solid var(--border);border-radius:11px;background:transparent;color:var(--text);cursor:pointer;font:600 10px var(--sans);transition:.15s}.option:hover,.option.picked{border-color:var(--nation-border);background:var(--nation-soft)}.letter{width:31px;height:31px;display:grid;place-items:center;border-radius:8px;background:var(--surface2);font:900 8px var(--mono);color:var(--muted)}.tick{opacity:0;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:var(--nation);color:#fff;font:900 10px var(--mono)}.option.list-correct,.option[data-correct="true"]{border-color:var(--nation-border);background:var(--nation-soft)}.option[data-correct="true"] .tick{opacity:1}.answer-panel{margin-top:12px;border-radius:12px;background:var(--nation-soft);border:1px solid var(--nation-border);overflow:hidden}.answer-line{display:flex;align-items:center;gap:10px;padding:14px}.answer-check{width:28px;height:28px;display:grid;place-items:center;border-radius:50%;background:var(--nation);color:#fff;font:900 13px var(--mono)}.answer-line small{display:block;font:900 7px var(--mono);letter-spacing:.12em;color:var(--muted)}.answer-line strong{display:block;color:var(--nation);font-size:18px;margin-top:3px}.explanation{display:flex;gap:9px;padding:11px 14px;border-top:1px solid var(--nation-border);font-size:10px;line-height:1.6;color:var(--muted)}.explanation b{font:900 7px var(--mono);color:var(--nation);padding-top:2px}.test-mode .answer-line{filter:blur(7px);opacity:.2}.test-mode .explanation{filter:blur(5px);opacity:.25}.test-mode .option[data-correct="true"] .tick{opacity:0}.test-mode .option[data-correct="true"]{background:transparent;border-color:var(--border)}.test-mode .option.picked[data-correct="true"]{border-color:var(--nation-border);background:var(--nation-soft)}.after{border-top:1px solid var(--border);padding:55px 0;display:flex;justify-content:space-between;align-items:end;gap:30px}.after h2{font-size:34px;letter-spacing:-.06em;margin:9px 0}.links{display:flex;gap:7px;flex-wrap:wrap}.links a{padding:10px 12px;border:1px solid var(--border);border-radius:8px;color:var(--text);text-decoration:none;font:900 8px var(--mono)}.links a:hover{border-color:var(--nation-border);color:var(--nation)}.seo{border-top:1px solid var(--border);padding:55px 0 0;max-width:850px}.seo h2{font-size:29px;letter-spacing:-.05em;margin:9px 0 14px}.seo p{font-size:11px;line-height:1.8;color:var(--muted)}@media(max-width:820px){.hero{grid-template-columns:220px 1fr}.hero>button{grid-column:2;justify-self:start}.options{grid-template-columns:1fr}}@media(max-width:620px){.answer-page{padding:0 14px 75px}.hero{display:block;padding-top:34px}.hero-media{width:100%;margin-bottom:20px}.hero>button{margin-top:18px}.hero h1{font-size:54px}.legend{margin-left:0}.after{display:block}.links{margin-top:18px}}
</style>
