---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
export function getStaticPaths(){ return NATIONS_STORY.map((nation)=>({params:{country:nation.slug},props:{nation}})); }
const { nation } = Astro.props;
const count=nation.days.reduce((sum,d)=>sum+d.questions.length,0);
const title=`FC Mobile ${nation.name} A Nation's Story Answers | Day 1 to Day ${nation.days.length}`;
const description=`FC Mobile A Nation's Story ${nation.name} answers from Day 1 to Day ${nation.days.length} with every stored question, all options and correct answers`;
const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
const themeMap={japan:'#d9233f',netherlands:'#f28c28',mexico:'#1c9a5a',france:'#2878d8',brazil:'#f2c400'};
const theme=themeMap[nation.slug]??'#55c7f2';
const searchIndex=nation.days.flatMap(day=>day.questions.map((question,index)=>({day:day.id,dayNumber:day.id.replace('day-',''),challenge:day.challenge||day.title,index:index+1,question:question.question,answer:question.answer})));
---
<BaseLayout title={title} description={description}>
<main class="country-page" style={`--nation:${theme};--nation-soft:${theme}22;--nation-border:${theme}55`}>
<div class="crumb"><a href="/a-nations-story/">A Nation's Story</a><span>/</span>{nation.name}</div>
<section class="hero"><div class="hero-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} /></div><div><div class="flag">{nation.flag}</div><div class="eyebrow">FC MOBILE · A NATION'S STORY · {nation.part.toUpperCase()}</div><h1>{nation.name} <span>answers</span></h1><p>{nation.description} Search the questions below when you remember a player, year, team or phrase, or open the day you need for the full answer set</p><div class="stats"><span><b>{count}</b> questions</span><span><b>{nation.days.length}</b> days</span><span>all options included</span></div></div></section>
<section class="country-search"><div class="search-head"><div><span class="eyebrow">{nation.name.toUpperCase()} ANSWER SEARCH</span><h2>Find a question in {nation.name}</h2></div><p>Search only this nation so the result stays focused on the challenge you are trying to solve</p></div><div class="search-shell"><div class="search-bar"><span>⌕</span><input id="country-finder" autocomplete="off" placeholder={`Search ${nation.name} questions by player, year, team or phrase`} aria-label={`Search ${nation.name} A Nation's Story questions`} /><button id="country-clear" type="button" aria-label="Clear search">×</button></div><div class="search-chips"><button type="button" data-query="World Cup">World Cup</button><button type="button" data-query="2022">2022</button><button type="button" data-query="final">Final</button><button type="button" data-query="scored">Scored</button></div><div id="country-status" class="search-status">Search {count} questions from Day 1 to Day {nation.days.length}</div><div id="country-results" class="search-results" aria-live="polite"></div><div id="country-empty" class="search-empty"><div>⌕</div><strong>Search this nation</strong><span>Results show the exact day and answer before you open the full question page</span></div></div></section>
<section class="days"><div class="section-head"><div><span class="eyebrow">DAY-BY-DAY ANSWERS</span><h2>{nation.name} Day 1 to Day {nation.days.length}</h2></div><p>Open a day when you already know the challenge number, or use the search above when you only remember part of the question</p></div><div class="day-grid">{nation.days.map(day=><a href={`/a-nations-story/${nation.slug}/${day.id}/`} class="day-card"><span>{day.level||'DAILY'}</span><strong>{day.id.replace('day-','Day ')}</strong><h3>{day.title}</h3><p>{day.questions.length} {day.questions.length===1?'question':'questions'} · A-D options</p><b class="go">OPEN DAY {day.id.replace('day-','')} ↗</b></a>)}</div></section>
<section class="content-map"><div><span class="eyebrow">WHAT YOU GET</span><h2>One nation, every stored answer</h2><p>This {nation.name} page is the index for the nation specific A Nation's Story content in FC Mobile Tools</p></div><div class="content-points"><article><b>01</b><strong>Search the clue</strong><p>Match a phrase from the question, a player, a year, a team or the stored answer</p></article><article><b>02</b><strong>Open the day</strong><p>Jump to the exact Day 1 to Day {nation.days.length} page instead of scanning the whole event</p></article><article><b>03</b><strong>Check every option</strong><p>The day page presents the available A-D choices and identifies the correct answer</p></article></div></section>
<section class="seo"><span class="eyebrow">{nation.name.toUpperCase()} DAY ANSWERS</span><h2>FC Mobile A Nation's Story {nation.name} Day 1 to Day {nation.days.length} answers</h2><p>Use this page for FC Mobile {nation.name} A Nation's Story answers when you know the nation but do not know the exact challenge. Search the question or choose a day to reach the relevant answer page</p><p>For specific lookups, this section covers {nation.name} Day 1 answers, {nation.name} Day 2 answers and the later Day 1 to Day {nation.days.length} challenges represented in the current question set</p></section>
</main>
</BaseLayout>
<script define:vars={{searchIndex}}>
const input=document.querySelector('#country-finder'),results=document.querySelector('#country-results'),empty=document.querySelector('#country-empty'),clear=document.querySelector('#country-clear'),status=document.querySelector('#country-status'),data=searchIndex;
const esc=v=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
function render(value){const query=value.trim().toLowerCase();if(!query){results.innerHTML='';empty.hidden=false;status.textContent=`Search ${data.length} questions from Day 1 to Day ${data.length?Math.max(...data.map(item=>Number(item.dayNumber))):0}`;return}const words=query.split(/\s+/).filter(Boolean);const matches=data.filter(item=>{const hay=`${item.dayNumber} ${item.challenge} ${item.question} ${item.answer}`.toLowerCase();return words.every(word=>hay.includes(word))}).slice(0,8);empty.hidden=true;status.textContent=matches.length?`${matches.length} matching answers`:'No matching question found';results.innerHTML=matches.length?matches.map(item=>`<a class="country-result" href="/a-nations-story/${location.pathname.split('/')[2]}/${item.day}/#q-${item.index}"><div class="country-result-day"><b>DAY ${item.dayNumber}</b><span>${esc(item.challenge)}</span></div><div class="country-result-body"><strong>${esc(item.question)}</strong><div><small>ANSWER</small><b>${esc(item.answer)}</b></div></div><i>OPEN ↗</i></a>`).join(''):'<div class="search-no-results"><strong>No exact match yet</strong><span>Try fewer words such as a player name or year</span></div>'}
input?.addEventListener('input',()=>render(input.value));clear?.addEventListener('click',()=>{input.value='';render('');input.focus()});document.querySelectorAll('.search-chips button').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;render(input.value);input.focus()}));
</script>
<style>
.country-page{max-width:1120px;margin:auto;padding:0 20px 100px}.crumb{padding-top:25px;color:var(--muted);font:800 8px var(--mono)}.crumb a{color:var(--text);text-decoration:none}.crumb span{padding:0 7px;color:var(--border)}.hero{padding:42px 0 58px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:390px 1fr;gap:40px;align-items:center}.hero-media{aspect-ratio:16/9;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:var(--surface);box-shadow:0 25px 80px var(--nation-soft)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.flag{font-size:40px;margin-bottom:14px}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--nation)}.hero h1{font-size:clamp(55px,8vw,96px);line-height:.88;letter-spacing:-.075em;margin:17px 0}.hero h1 span{color:var(--nation)}.hero p{max-width:700px;color:var(--muted);font-size:13px;line-height:1.8}.stats{display:flex;gap:7px;margin-top:25px;flex-wrap:wrap}.stats span{padding:9px 11px;border:1px solid var(--border);border-radius:8px;font:800 8px var(--mono);color:var(--muted)}.stats b{color:var(--text);margin-right:4px}.country-search{padding:65px 0 20px}.search-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:18px}.search-head h2{font-size:40px;letter-spacing:-.06em;margin:8px 0}.search-head p{max-width:410px;color:var(--muted);font-size:10px;line-height:1.7}.search-shell{padding:16px;border:1px solid var(--border);border-radius:18px;background:var(--surface);box-shadow:0 25px 75px var(--nation-soft)}.search-bar{display:flex;align-items:center;gap:12px;padding:14px 15px;border:1px solid var(--border);border-radius:13px;background:var(--bg)}.search-bar:focus-within{border-color:var(--nation-border);box-shadow:0 0 0 4px var(--nation-soft)}.search-bar>span{font-size:25px;color:var(--nation)}.search-bar input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font:600 12px var(--sans)}.search-bar button{border:0;background:transparent;color:var(--muted);font-size:21px;cursor:pointer}.search-chips{display:flex;gap:6px;overflow:auto;padding:10px 1px}.search-chips button{flex:0 0 auto;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--muted);font:800 7px var(--mono);cursor:pointer}.search-chips button:hover{border-color:var(--nation-border);color:var(--nation)}.search-status{padding:5px 1px 10px;color:var(--muted);font:700 8px var(--mono)}.search-results{display:grid;gap:6px}.country-result{display:grid;grid-template-columns:115px 1fr 55px;gap:14px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--bg);text-decoration:none;color:var(--text);transition:.16s}.country-result:hover{transform:translateY(-2px);border-color:var(--nation-border);box-shadow:0 12px 30px var(--nation-soft)}.country-result-day{display:flex;flex-direction:column;gap:5px;border-right:1px solid var(--border)}.country-result-day b{font:900 8px var(--mono);color:var(--nation)}.country-result-day span{font:700 7px var(--mono);color:var(--muted);line-height:1.4}.country-result-body>strong{display:block;font-size:12px;line-height:1.5}.country-result-body>div{display:flex;align-items:center;gap:7px;margin-top:8px;padding-top:7px;border-top:1px solid var(--border)}.country-result-body small{font:900 6px var(--mono);color:var(--muted)}.country-result-body b{font-size:10px}.country-result>i{font:900 7px var(--mono);font-style:normal;text-align:center;color:var(--nation)}.search-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:30px 15px 20px;color:var(--muted)}.search-empty[hidden]{display:none}.search-empty>div{display:grid;place-items:center;width:46px;height:46px;border:1px solid var(--nation-border);border-radius:50%;color:var(--nation);font-size:23px;margin-bottom:9px}.search-empty strong{color:var(--text);font-size:12px}.search-empty span{font-size:9px;margin-top:5px}.search-no-results{text-align:center;padding:24px;border:1px dashed var(--border);border-radius:11px;color:var(--muted)}.search-no-results strong,.search-no-results span{display:block}.search-no-results strong{color:var(--text);font-size:11px}.search-no-results span{font-size:9px;margin-top:5px}.days{padding:45px 0 70px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.section-head h2{font-size:40px;letter-spacing:-.06em;margin:8px 0}.section-head p{max-width:430px;color:var(--muted);font-size:10px;line-height:1.7}.day-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.day-card{position:relative;min-height:205px;padding:17px;border:1px solid var(--border);border-radius:13px;background:var(--surface);text-decoration:none;color:var(--text);transition:.2s;overflow:hidden}.day-card:hover{transform:translateY(-3px);border-color:var(--nation-border);box-shadow:0 20px 55px var(--nation-soft)}.day-card>span{font:900 7px var(--mono);color:var(--nation);letter-spacing:.1em}.day-card strong{position:absolute;right:16px;top:16px;font:900 10px var(--mono);color:var(--muted)}.day-card h3{font-size:18px;letter-spacing:-.03em;margin:35px 0 7px}.day-card p{font-size:9px;color:var(--muted)}.go{position:absolute;left:17px;bottom:15px;font:900 7px var(--mono);color:var(--nation)}.content-map{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:65px 0;display:grid;grid-template-columns:.7fr 1.3fr;gap:50px}.content-map h2{font-size:36px;letter-spacing:-.06em;margin:9px 0}.content-map>div>p{color:var(--muted);font-size:10px;line-height:1.8}.content-points{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.content-points article{padding:15px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.content-points b{font:900 7px var(--mono);color:var(--nation)}.content-points strong{display:block;font-size:14px;margin:32px 0 7px}.content-points p{font-size:9px;line-height:1.7;color:var(--muted)}.seo{border-top:1px solid var(--border);padding:58px 0 0;max-width:850px}.seo h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 14px}.seo p{color:var(--muted);font-size:12px;line-height:1.8}@media(max-width:760px){.country-page{padding:0 14px 70px}.hero{grid-template-columns:1fr;gap:22px}.hero-media{width:100%}.search-head,.section-head{display:block}.search-head p,.section-head p{margin-top:10px}.country-result{grid-template-columns:70px 1fr 38px;gap:9px}.country-result-body>strong{font-size:10px}.country-result-body b{font-size:9px}.day-grid{grid-template-columns:1fr}.content-map{grid-template-columns:1fr}.content-points{grid-template-columns:1fr}}
</style>
