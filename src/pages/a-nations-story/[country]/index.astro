---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
export function getStaticPaths(){return NATIONS_STORY.map(nation=>({params:{country:nation.slug},props:{nation}}));}
const {nation}=Astro.props;
const count=nation.days.reduce((sum,d)=>sum+d.questions.length,0);
const title=`FC Mobile ${nation.name} A Nation's Story Answers | Day 1 to Day ${nation.days.length}`;
const description=`FC Mobile A Nation's Story ${nation.name} answers from Day 1 to Day ${nation.days.length} with every stored question and available options`;
const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
const themeMap={japan:'#d9233f',netherlands:'#f28c28',mexico:'#1c9a5a',france:'#2878d8',brazil:'#f2c400'};
const theme=themeMap[nation.slug]??'#55c7f2';
const searchIndex=nation.days.flatMap(day=>day.questions.map((question,index)=>({day:day.id,dayNumber:day.id.replace('day-',''),question:question.question,answer:question.answer,index:index+1})));
---
<BaseLayout title={title} description={description}>
<main class="country-page" style={`--nation:${theme};--nation-soft:${theme}22;--nation-border:${theme}55`}>
<div class="crumb"><a href="/a-nations-story/">A Nation's Story</a><span>/</span>{nation.name}</div>
<section class="hero"><div class="hero-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`}></div><div><div class="flag">{nation.flag}</div><span class="eyebrow">FC MOBILE · A NATION'S STORY</span><h1>{nation.name} <span>answers</span></h1><p>{nation.description} Search this nation when you remember part of a question or go straight to a day</p><div class="stats"><span><b>{count}</b> questions</span><span><b>{nation.days.length}</b> days</span><span>all options included</span></div></div></section>
<section class="country-search"><span class="eyebrow">{nation.name.toUpperCase()} QUESTION SEARCH</span><h2>Search {nation.name} questions</h2><p class="search-note">Find the question you remember and click it to open the exact answer page</p><div class="search-shell"><div class="search-bar"><span>⌕</span><input id="country-finder" autocomplete="off" placeholder={`Search ${nation.name} questions`} aria-label={`Search ${nation.name} A Nation's Story questions`}><button id="country-clear" type="button" aria-label="Clear search">×</button></div><div class="search-chips"><button type="button" data-query="World Cup">World Cup</button><button type="button" data-query="2022">2022</button><button type="button" data-query="final">Final</button><button type="button" data-query="scored">Scored</button></div><div id="country-status" class="search-status">{count} questions across Day 1 to Day {nation.days.length}</div><div id="country-results" class="search-results"></div><div id="country-empty" class="search-empty"><strong>Search a question</strong><span>Results stay focused on {nation.name}</span></div></div></section>
<section class="days"><span class="eyebrow">DAY-BY-DAY ANSWERS</span><h2>{nation.name} Day 1 to Day {nation.days.length}</h2><div class="day-grid">{nation.days.map(day=><a href={`/a-nations-story/${nation.slug}/${day.id}/`} class="day-card"><span>{day.level||'DAILY'}</span><strong>{day.id.replace('day-','Day ')}</strong><h3>{day.title}</h3><p>{day.questions.length} {day.questions.length===1?'question':'questions'} · A-D options</p></a>)}</div></section>
<section class="seo"><span class="eyebrow">{nation.name.toUpperCase()} ANSWERS</span><h2>FC Mobile A Nation's Story {nation.name} Day 1 to Day {nation.days.length} answers</h2><p>Use this {nation.name} answer page when you are searching for a specific A Nation's Story question in FC Mobile  Search the wording you remember or open the day containing the question</p><p>This page covers the stored {nation.name} question set across {nation.days.length} days and keeps each question connected to its exact day page where the available choices and correct answer are shown</p></section>
</main>
</BaseLayout>
<script define:vars={{searchIndex}}>
const input=document.querySelector('#country-finder'),results=document.querySelector('#country-results'),empty=document.querySelector('#country-empty'),clear=document.querySelector('#country-clear'),status=document.querySelector('#country-status'),data=searchIndex;
const esc=v=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
function render(value){const query=value.trim().toLowerCase();if(!query){results.innerHTML='';empty.hidden=false;status.textContent=`${data.length} questions across Day 1 to Day ${data.length?Math.max(...data.map(x=>Number(x.dayNumber))):0}`;return}const words=query.split(/\s+/).filter(Boolean);const matches=data.filter(item=>{const hay=`${item.dayNumber} ${item.question} ${item.answer}`.toLowerCase();return words.every(word=>hay.includes(word))}).slice(0,10);empty.hidden=true;status.textContent=matches.length?`${matches.length} matching questions`:'No matching question';results.innerHTML=matches.length?matches.map(item=>`<a class="country-result" href="/a-nations-story/${location.pathname.split('/')[2]}/${item.day}/#q-${item.index}" style="--nation:${'${theme}'}"><span class="result-day">DAY ${item.dayNumber}</span><span class="result-question">${esc(item.question)}</span><span class="result-arrow">↗</span></a>`).join(''):'<div class="no-results">Try fewer words such as a player name, year or team</div>'}
input?.addEventListener('input',()=>render(input.value));clear?.addEventListener('click',()=>{input.value='';render('');input.focus()});document.querySelectorAll('.search-chips button').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;render(input.value);input.focus()}));
</script>
<style>
.country-page{max-width:1120px;margin:auto;padding:0 20px 100px}.crumb{padding-top:25px;color:var(--muted);font:800 8px var(--mono)}.crumb a{color:var(--text);text-decoration:none}.crumb span{padding:0 7px;color:var(--border)}.hero{padding:42px 0 58px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:390px 1fr;gap:40px;align-items:center}.hero-media{aspect-ratio:16/9;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:var(--surface);box-shadow:0 25px 80px var(--nation-soft)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.flag{font-size:40px;margin-bottom:14px}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--nation)}.hero h1{font-size:clamp(55px,8vw,96px);line-height:.88;letter-spacing:-.075em;margin:17px 0}.hero h1 span{color:var(--nation)}.hero p{max-width:700px;color:var(--muted);font-size:13px;line-height:1.8}.stats{display:flex;gap:7px;margin-top:25px;flex-wrap:wrap}.stats span{padding:9px 11px;border:1px solid var(--border);border-radius:8px;font:800 8px var(--mono);color:var(--muted)}.stats b{color:var(--text);margin-right:4px}.country-search{padding:65px 0}.country-search h2{font-size:40px;letter-spacing:-.06em;margin:8px 0 3px}.search-note{margin:0 0 17px;color:var(--muted);font-size:10px}.search-shell{max-width:900px;padding:14px;border:1px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:0 20px 70px var(--nation-soft)}.search-bar{display:flex;align-items:center;gap:10px;padding:14px 15px;border:1px solid var(--border);border-radius:12px;background:var(--bg)}.search-bar:focus-within{border-color:var(--nation-border);box-shadow:0 0 0 4px var(--nation-soft)}.search-bar>span{font-size:25px;color:var(--nation)}.search-bar input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font:600 12px var(--sans)}.search-bar button{border:0;background:transparent;color:var(--muted);font-size:21px;cursor:pointer}.search-chips{display:flex;gap:6px;overflow:auto;padding:9px 0}.search-chips button{padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--muted);font:800 7px var(--mono);cursor:pointer}.search-chips button:hover{border-color:var(--nation-border);color:var(--nation)}.search-status{padding:3px 0 9px;color:var(--muted);font:700 8px var(--mono)}.search-results{display:grid;gap:5px}.country-result{display:grid;grid-template-columns:72px 1fr 20px;gap:12px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);text-decoration:none;color:var(--text);transition:.15s}.country-result:hover{border-color:var(--nation-border);transform:translateY(-1px)}.result-day{font:900 8px var(--mono);color:var(--nation)}.result-question{font-size:12px;font-weight:700;line-height:1.45}.result-arrow{font-size:17px;color:var(--nation);text-align:center}.search-empty{padding:22px 0;color:var(--muted)}.search-empty[hidden]{display:none}.search-empty strong,.search-empty span{display:block}.search-empty strong{color:var(--text);font-size:12px}.search-empty span{font-size:9px;margin-top:4px}.no-results{padding:18px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:10px}.days{padding:10px 0 75px}.days h2{font-size:40px;letter-spacing:-.06em;margin:8px 0 18px}.day-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.day-card{position:relative;min-height:190px;padding:17px;border:1px solid var(--border);border-radius:13px;background:var(--surface);text-decoration:none;color:var(--text);transition:.2s}.day-card:hover{transform:translateY(-3px);border-color:var(--nation-border);box-shadow:0 20px 55px var(--nation-soft)}.day-card>span{font:900 7px var(--mono);color:var(--nation)}.day-card>strong{position:absolute;right:15px;top:15px;font:900 9px var(--mono);color:var(--muted)}.day-card h3{font-size:17px;margin:35px 0 8px}.day-card p{font-size:9px;color:var(--muted)}.seo{border-top:1px solid var(--border);padding-top:55px;max-width:850px}.seo h2{font-size:31px;letter-spacing:-.05em;margin:9px 0 14px}.seo p{font-size:12px;line-height:1.8;color:var(--muted)}@media(max-width:760px){.country-page{padding:0 14px 70px}.hero{grid-template-columns:1fr;gap:22px}.search-head{display:block}.day-grid{grid-template-columns:1fr 1fr}.country-result{grid-template-columns:58px 1fr 18px}.result-question{font-size:10px}}@media(max-width:500px){.day-grid{grid-template-columns:1fr}}
</style>