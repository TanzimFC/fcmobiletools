---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
export function getStaticPaths(){ return NATIONS_STORY.map((nation)=>({params:{country:nation.slug},props:{nation}})); }
const { nation } = Astro.props;
const count = nation.days.reduce((sum,d)=>sum+d.questions.length,0);
const title = `FC Mobile ${nation.name} A Nation's Story Answers | Day 1 to Day ${nation.days.length}`;
const description = `FC Mobile A Nation's Story ${nation.name} answers from Day 1 to Day ${nation.days.length}. Browse every question, all options and correct answers.`;
const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
const themeMap={japan:'#d9233f',netherlands:'#f28c28',mexico:'#1c9a5a',france:'#2878d8',brazil:'#16a05d'};
---
<BaseLayout title={title} description={description}>
<main class="country-page" style={`--nation:${themeMap[nation.slug] ?? '#55c7f2'};--nation-soft:${themeMap[nation.slug] ?? '#55c7f2'}18;--nation-border:${themeMap[nation.slug] ?? '#55c7f2'}45`}>
<div class="crumb"><a href="/a-nations-story/">A Nation's Story</a><span>/</span>{nation.name}</div>
<section class="hero"><div class="hero-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} /></div><div><div class="flag">{nation.flag}</div><div class="eyebrow">FC MOBILE · A NATION'S STORY · {nation.part.toUpperCase()}</div><h1>{nation.name} <span>answers.</span></h1><p>{nation.description} Pick the day you are looking for and get every option plus the correct answer at a glance.</p><div class="stats"><span><b>{count}</b> answers</span><span><b>{nation.days.length}</b> days</span><span>all options included</span></div></div></section>
<section class="days"><div class="section-head"><div><span class="eyebrow">DAY-BY-DAY ANSWERS</span><h2>Which day are you on?</h2></div><p>Tap Day 1, Day 2 or any later challenge. The answer page is built for a quick scan, not a forced quiz.</p></div><div class="day-grid">{nation.days.map((day)=><a href={`/a-nations-story/${nation.slug}/${day.id}/`} class="day-card"><span>{day.level || 'DAILY'}</span><strong>{day.id.replace('day-','Day ')}</strong><h3>{day.title}</h3><p>{day.questions.length} {day.questions.length===1?'question':'questions'} · A-D options</p><b class="go">OPEN DAY {day.id.replace('day-','')} ↗</b></a>)}</div></section>
<section class="seo"><span class="eyebrow">{nation.name.toUpperCase()} DAY ANSWERS</span><h2>FC Mobile A Nation's Story {nation.name} Day 1 to Day {nation.days.length} answers</h2><p>Looking for an FC Mobile A Nation's Story {nation.name} answer? Use the day links above to jump directly to Day 1 through Day {nation.days.length}. Each day contains the exact question, all four options and the correct answer.</p><p>Players commonly search these challenges as “{nation.name} Day 1 answers”, “{nation.name} Day 2 answers” and “{nation.name} Day 9 answers”, so the page structure follows that language.</p></section>
</main></BaseLayout>
<style>
.country-page{max-width:1120px;margin:auto;padding:0 20px 100px}.crumb{padding-top:25px;color:var(--muted);font:800 8px var(--mono)}.crumb a{color:var(--text);text-decoration:none}.crumb span{padding:0 7px;color:var(--border)}.hero{padding:42px 0 58px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:360px 1fr;gap:40px;align-items:center}.hero-media{aspect-ratio:16/9;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:var(--surface);box-shadow:0 25px 80px var(--nation-soft)}.hero-media img{width:100%;height:100%;object-fit:cover;display:block}.flag{font-size:40px;margin-bottom:14px}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--nation)}.hero h1{font-size:clamp(55px,8vw,96px);line-height:.88;letter-spacing:-.075em;margin:17px 0}.hero h1 span{color:var(--nation)}.hero p{max-width:700px;color:var(--muted);font-size:13px;line-height:1.8}.stats{display:flex;gap:7px;margin-top:25px;flex-wrap:wrap}.stats span{padding:9px 11px;border:1px solid var(--border);border-radius:8px;font:800 8px var(--mono);color:var(--muted)}.stats b{color:var(--text);margin-right:4px}.days{padding:65px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.section-head h2{font-size:40px;letter-spacing:-.06em;margin:8px 0}.section-head p{max-width:430px;color:var(--muted);font-size:10px;line-height:1.7}.day-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.day-card{position:relative;min-height:205px;padding:17px;border:1px solid var(--border);border-radius:13px;background:var(--surface);text-decoration:none;color:var(--text);transition:.2s;overflow:hidden}.day-card:hover{transform:translateY(-3px);border-color:var(--nation-border);box-shadow:0 20px 55px var(--nation-soft)}.day-card>span{font:900 7px var(--mono);color:var(--nation);letter-spacing:.1em}.day-card strong{position:absolute;right:16px;top:16px;font:900 10px var(--mono);color:var(--muted)}.day-card h3{font-size:18px;letter-spacing:-.03em;margin:35px 0 7px}.day-card p{font-size:9px;color:var(--muted)}.go{position:absolute;left:17px;bottom:15px;font:900 7px var(--mono);color:var(--nation)}.seo{border-top:1px solid var(--border);padding:58px 0 0;max-width:850px}.seo h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 14px}.seo p{color:var(--muted);font-size:12px;line-height:1.8}@media(max-width:760px){.country-page{padding:0 14px 70px}.hero{grid-template-columns:1fr;gap:22px}.hero-media{width:100%}.day-grid{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:12px}}
</style>
