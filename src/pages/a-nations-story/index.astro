---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../../data/aNationsStory.js';
const totalDays=NATIONS_STORY.reduce((sum,n)=>sum+n.days.length,0);
const searchIndex=NATIONS_STORY.flatMap(n=>n.days.flatMap(d=>d.questions.map((q,i)=>({nation:n.name,slug:n.slug,day:d.id,dayTitle:`Day ${d.id.replace('day-','')}`,challenge:d.challenge||d.title,index:i+1,question:q.question,answer:q.answer}))));
const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
---
<BaseLayout title="FC Mobile A Nation's Story Answers | Day 1 to Day 9" description="FC Mobile A Nation's Story answers for Japan, Netherlands, Mexico, France and Brazil. Search exact questions and find Day 1 to Day 9 answers with all options instantly.">
<main class="nation-story">
<section class="hero"><div class="eyebrow">FC MOBILE · A NATION'S STORY · ANSWERS</div><div class="hero-grid"><div><h1>Find the answer.<br><span>Skip the struggle.</span></h1><p class="lead">Stuck on a question? Search a phrase, player, year or answer. We take you straight to the right Day and show every option with the correct choice clearly marked.</p><div class="search-wrap"><label for="story-search">Search A Nation's Story</label><div class="search-box"><span>⌕</span><input id="story-search" autocomplete="off" placeholder="Search: Japan Day 7, Keisuke Honda, 1998..." /><kbd>⌘ K</kbd></div><div id="search-results" aria-live="polite"></div></div><div class="hero-pills"><span>ALL OPTIONS</span><span>DAY 1 → DAY 9</span><span>TEST MODE</span></div></div><aside class="stats"><div><strong>{NATIONS_STORY.length}</strong><span>NATIONS</span></div><div><strong>{NATIONS_STORY_QUESTION_COUNT}</strong><span>ANSWERS</span></div><div><strong>{totalDays}</strong><span>DAYS</span></div></aside></div></section>
<section class="nation-list"><div class="section-head"><div><span class="eyebrow">CHOOSE A NATION</span><h2>Pick your story.</h2></div><p>Tap a nation, choose the day you need, then scan the answer. Simple.</p></div><div class="grid">{NATIONS_STORY.map((nation,i)=>{const count=nation.days.reduce((sum,d)=>sum+d.questions.length,0);return <a class="nation-card" href={`/a-nations-story/${nation.slug}/`}><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} loading={i>1?'lazy':'eager'}/><div class="shade"></div><div class="card-top"><span class="flag">{nation.flag}</span><span class="number">0{i+1}</span></div><div class="card-copy"><span class="part">{nation.part}</span><h3>{nation.name}</h3><p>{count} answers across {nation.days.length} days.</p><div class="meta"><span>DAY 1 → DAY {nation.days.length}</span><span>OPEN ↗</span></div></div></a>})}</div></section>
<section class="how"><div class="how-title"><span class="eyebrow">HOW IT WORKS</span><h2>Search.<br>See.<br><span>Go.</span></h2></div><div class="how-steps"><article><b>01</b><h3>Search the question</h3><p>Type the wording you remember, a player, country, competition or year.</p></article><article><b>02</b><h3>Open the day</h3><p>The result jumps directly to the exact question on Day 1 through Day 9.</p></article><article><b>03</b><h3>Read the answer</h3><p>All four choices stay visible and the correct one is marked with a clear tick.</p></article></div></section>
<section class="answer-first"><div><span class="eyebrow">BUILT FOR SEARCH</span><h2>The page should answer the search.</h2></div><div class="copy"><p>When players are stuck, they usually want the answer, not another quiz. The exact question text, all A-D options and the answer are therefore part of the page itself.</p><p>The structure also uses Day 1, Day 2 and Day 9 language because that is how players commonly refer to these challenges.</p></div></section>
<section class="seo-copy"><span class="eyebrow">FC MOBILE ANSWERS</span><h2>FC Mobile A Nation's Story answers</h2><p>A Nation's Story is a football-history event in FC Mobile. This reference currently covers Japan, Netherlands, Mexico, France and Brazil, organized by Day 1 to Day 9.</p></section>
</main></BaseLayout>
<script define:vars={{searchIndex}}>
const input=document.querySelector('#story-search');const results=document.querySelector('#search-results');const data=searchIndex;
const esc=v=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
function render(query){const q=query.trim().toLowerCase();if(!q){results.innerHTML='';return;}const matches=data.filter(x=>`${x.nation} ${x.dayTitle} ${x.challenge} ${x.question} ${x.answer}`.toLowerCase().includes(q)).slice(0,8);if(!matches.length){results.innerHTML='<div class="empty">No exact match. Try a player name, year or fewer words.</div>';return;}results.innerHTML=matches.map(x=>`<a class="result" href="/a-nations-story/${x.slug}/${x.day}/#q-${x.index}"><div class="result-meta"><b>${esc(x.nation)}</b><span>${esc(x.dayTitle)} · Q${x.index}</span></div><p>${esc(x.question)}</p><strong>✓ ${esc(x.answer)}</strong></a>`).join('');}
input?.addEventListener('input',()=>render(input.value));window.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();input?.focus();}});
</script>
<style>
.nation-story{max-width:1180px;margin:auto;padding:0 20px 110px}.hero{padding:78px 0 68px;border-bottom:1px solid var(--border)}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.hero-grid{display:grid;grid-template-columns:1fr 230px;gap:60px;align-items:end}.hero h1{font-size:clamp(55px,7vw,92px);line-height:.88;letter-spacing:-.075em;margin:20px 0}.hero h1 span{color:var(--blue)}.lead{max-width:720px;color:var(--muted);font-size:14px;line-height:1.8}.search-wrap{max-width:760px;margin-top:30px}.search-wrap label{display:block;margin-bottom:8px;color:var(--muted);font:800 8px var(--mono);text-transform:uppercase;letter-spacing:.08em}.search-box{display:flex;align-items:center;gap:10px;padding:15px 16px;border:1px solid var(--border);border-radius:14px;background:var(--surface);box-shadow:0 20px 70px #55c7f20a}.search-box:focus-within{border-color:#55c7f266;box-shadow:0 0 0 4px #55c7f20d}.search-box>span{font-size:21px;color:var(--blue)}.search-box input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font:500 12px var(--sans)}.search-box kbd{font:800 7px var(--mono);color:var(--muted);border:1px solid var(--border);padding:5px 7px;border-radius:5px;white-space:nowrap}.hero-pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:15px}.hero-pills span{padding:7px 9px;border:1px solid var(--border);border-radius:999px;font:900 6px var(--mono);color:var(--muted)}#search-results{display:grid;gap:6px;margin-top:8px;max-height:520px;overflow:auto}.result{display:block;padding:13px 14px;border:1px solid var(--border);border-radius:11px;background:var(--surface);text-decoration:none;color:var(--text);transition:.15s}.result:hover{border-color:#55c7f255;transform:translateX(2px)}.result-meta{display:flex;justify-content:space-between;gap:12px}.result-meta b{font:900 7px var(--mono);color:var(--blue);letter-spacing:.1em}.result-meta span{font:800 7px var(--mono);color:var(--muted)}.result p{font-size:11px;line-height:1.5;margin:8px 0;color:var(--text)}.result strong{display:inline-block;padding:5px 7px;border-radius:6px;background:#55c7f212;color:var(--blue);font:900 8px var(--mono)}.empty{padding:13px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:10px}.stats{display:grid;gap:8px}.stats div{padding:18px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.stats strong{display:block;font:900 42px/1 var(--mono);letter-spacing:-.07em}.stats span{font:900 7px var(--mono);color:var(--muted);letter-spacing:.12em}.nation-list{padding:68px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:22px}.section-head h2{font-size:43px;letter-spacing:-.06em;margin:8px 0}.section-head p{max-width:430px;color:var(--muted);font-size:11px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.nation-card{position:relative;min-height:340px;border:1px solid var(--border);border-radius:14px;background:var(--surface);text-decoration:none;color:#fff;overflow:hidden;transition:.2s}.nation-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.35s}.nation-card:hover{transform:translateY(-5px);border-color:#55c7f255}.nation-card:hover img{transform:scale(1.05)}.shade{position:absolute;inset:0;background:linear-gradient(180deg,#06131a20 0%,#06131ab5 60%,#06131af2 100%)}.card-top{position:relative;padding:17px;display:flex;justify-content:space-between}.flag{font-size:28px}.number{font:900 8px var(--mono);color:#ffffff99}.card-copy{position:absolute;left:17px;right:17px;bottom:15px}.part{font:900 6px var(--mono);letter-spacing:.12em;color:#ffffffaa;text-transform:uppercase}.nation-card h3{font-size:25px;letter-spacing:-.04em;margin:5px 0}.nation-card p{font-size:9px;line-height:1.6;color:#ffffffbb}.meta{padding-top:10px;margin-top:12px;border-top:1px solid #ffffff33;display:flex;justify-content:space-between;font:900 7px var(--mono);color:#fff}.how{border-top:1px solid var(--border);padding:68px 0;display:grid;grid-template-columns:.65fr 1.35fr;gap:70px}.how-title h2{font-size:clamp(55px,6vw,80px);line-height:.82;letter-spacing:-.08em;margin:10px 0}.how-title h2 span{color:var(--blue)}.how-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.how-steps article{padding:18px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.how-steps b{font:900 9px var(--mono);color:var(--blue)}.how-steps h3{font-size:18px;letter-spacing:-.03em;margin:34px 0 8px}.how-steps p{font-size:10px;line-height:1.7;color:var(--muted)}.answer-first{border-top:1px solid var(--border);padding:68px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.answer-first h2{font-size:clamp(35px,4vw,52px);line-height:.95;letter-spacing:-.06em;margin:9px 0}.copy{color:var(--muted);font-size:12px;line-height:1.8}.seo-copy{border-top:1px solid var(--border);padding:60px 0 0;max-width:860px}.seo-copy h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 14px}.seo-copy p{color:var(--muted);font-size:12px;line-height:1.8}@media(max-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero-grid,.answer-first,.how{grid-template-columns:1fr}.stats{display:grid;grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:repeat(2,1fr)}.how-steps{grid-template-columns:1fr 1fr}}@media(max-width:520px){.nation-story{padding:0 14px 80px}.hero{padding-top:55px}.hero h1{font-size:54px}.stats{grid-template-columns:1fr 1fr}.stats div:last-child{grid-column:span 2}.grid,.how-steps{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:12px}.search-box kbd{display:none}}
</style>
