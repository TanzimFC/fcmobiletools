---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../../data/aNationsStory.js';

const imageMap = {
  japan: '/assets/images/anationstory/AN_japan_thumbnail.png',
  netherlands: '/assets/images/anationstory/AN_netherlands_thumbnail.png',
  mexico: '/assets/images/anationstory/AN_mexico_thumbnail (2).png',
  france: '/assets/images/anationstory/AN_france_thumbnail.png',
  brazil: '/assets/images/anationstory/AN_brazil_thumbnail.png'
};
const themeMap = { japan:'#d9233f', netherlands:'#f28c28', mexico:'#1c9a5a', france:'#2878d8', brazil:'#f2c400' };
const searchIndex = NATIONS_STORY.flatMap((nation) => nation.days.flatMap((day) => day.questions.map((question, index) => ({
  nation:nation.name, slug:nation.slug, flag:nation.flag, day:day.id, dayNumber:day.id.replace('day-',''), challenge:day.challenge || day.title, index:index+1, question:question.question, answer:question.answer
}))));
const totalDays = NATIONS_STORY.reduce((sum,nation) => sum + nation.days.length, 0);
---
<BaseLayout title="FC Mobile A Nation's Story Answers | Day 1 to Day 9" description="Find FC Mobile A Nation's Story answers for Japan, Netherlands, Mexico, France and Brazil with every Day 1 to Day 9 question, all options and correct answers">
<main class="story-hub">
  <section class="hero">
    <div class="hero-ring"></div><div class="hero-ring ring-two"></div>
    <div class="hero-inner">
      <div class="eyebrow">FC MOBILE · A NATION'S STORY · ANSWER HUB</div>
      <h1>Find the answer<br><span>and get back to the game</span></h1>
      <p class="hero-sub">Every nation, every day, every question and every option in one fast reference</p>
      <div class="hero-stats"><div><strong>{NATIONS_STORY.length}</strong><span>NATIONS</span></div><div><strong>{totalDays}</strong><span>DAYS</span></div><div><strong>{NATIONS_STORY_QUESTION_COUNT}</strong><span>QUESTIONS</span></div></div>
    </div>
  </section>

  <section class="finder wrap">
    <div class="finder-head"><div><span class="eyebrow">QUESTION FINDER</span><h2>Remember a clue</h2></div><p>Type anything you remember and jump straight to the matching question</p></div>
    <div class="finder-panel">
      <div class="finder-input"><span>⌕</span><input id="question-finder" autocomplete="off" placeholder="Player, year, team, tournament or a few words" aria-label="Find an A Nation's Story question" /><button id="clear-finder" type="button">CLEAR</button></div>
      <div class="finder-chips"><button type="button" data-query="World Cup">World Cup</button><button type="button" data-query="2022">2022</button><button type="button" data-query="final">Final</button><button type="button" data-query="scored">Scored</button><button type="button" data-query="coach">Coach</button></div>
      <div id="finder-results" class="finder-results" aria-live="polite"></div><div id="finder-empty" class="finder-empty">Start with a player, year or a few words you remember</div>
    </div>
  </section>

  <section class="nation-stage wrap">
    <div class="section-line"><span class="eyebrow">CHOOSE YOUR STORY</span><span>05 NATIONS · DAY 1 → DAY 9</span></div>
    <div class="nation-grid">
      {NATIONS_STORY.map((nation,index) => { const count=nation.days.reduce((sum,day)=>sum+day.questions.length,0); const theme=themeMap[nation.slug]; return <a class="nation-card" href={`/a-nations-story/${nation.slug}/`} style={`--nation:${theme};--nation-soft:${theme}22`}>
        <img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} loading={index>1?'lazy':'eager'} /><div class="nation-shade"></div>
        <div class="nation-top"><span>{nation.flag}</span><b>0{index+1}</b></div>
        <div class="nation-copy"><small>{nation.part}</small><h3>{nation.name}</h3><div class="nation-meta"><span>{count} questions</span><span>{nation.days.length} days</span></div><strong>OPEN STORY <i>↗</i></strong></div>
      </a>; })}
    </div>
  </section>

  <section class="day-picker wrap">
    <div class="day-copy"><span class="eyebrow">FAN LANGUAGE</span><h2>Know the day</h2><p>Players call each challenge Day 1 through Day 9, so the navigation does too</p></div>
    <div class="day-area"><div class="day-map">{Array.from({length:9},(_,i)=>i+1).map((day)=><button type="button" data-day={day}>DAY {day}</button>)}</div><div id="day-targets" class="day-targets"><div class="day-placeholder">Pick a day to see that challenge across every nation</div></div></div>
  </section>

  <section class="workflow wrap"><div class="workflow-title"><span class="eyebrow">THE FAST ROUTE</span><h2>Search<br>choose<br><span>solve</span></h2></div><div class="workflow-cards"><article><b>01</b><strong>Search a clue</strong><p>Use the words you remember instead of hunting through every nation</p></article><article><b>02</b><strong>Jump to the day</strong><p>Results take you directly to the exact question on its Day 1 to Day 9 page</p></article><article><b>03</b><strong>Match the option</strong><p>See all four choices with the correct one clearly marked and explained</p></article></div></section>

  <section class="seo wrap"><span class="eyebrow">FC MOBILE ANSWERS</span><h2>FC Mobile A Nation's Story Day 1 to Day 9 answers</h2><p>Use this answer hub for Japan, Netherlands, Mexico, France and Brazil. Each nation is organised by the Day 1 to Day 9 naming players commonly use when looking up the event</p><p>Open a nation when you know the chapter, use the day map when you know the challenge number or use Question Finder when you only remember part of the question</p></section>
</main>
</BaseLayout>

<script define:vars={{searchIndex}}>
const input=document.querySelector('#question-finder');const results=document.querySelector('#finder-results');const empty=document.querySelector('#finder-empty');const clear=document.querySelector('#clear-finder');const data=searchIndex;
const esc=v=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
function render(value){const query=value.trim().toLowerCase();if(!query){results.innerHTML='';empty.hidden=false;return;}const words=query.split(/\s+/).filter(Boolean);const matches=data.filter(item=>{const hay=`${item.nation} ${item.dayNumber} ${item.challenge} ${item.question} ${item.answer}`.toLowerCase();return words.every(word=>hay.includes(word));}).slice(0,8);empty.hidden=true;results.innerHTML=matches.length?matches.map(item=>`<a class="finder-result" href="/a-nations-story/${item.slug}/${item.day}/#q-${item.index}"><span class="result-flag">${item.flag}</span><span class="result-main"><strong>${esc(item.nation)} · Day ${item.dayNumber}</strong><b>${esc(item.question)}</b><small>Answer · ${esc(item.answer)}</small></span><span class="result-arrow">↗</span></a>`).join(''):'<div class="finder-no-results">No match yet · try fewer words</div>';}
input?.addEventListener('input',()=>render(input.value));clear?.addEventListener('click',()=>{input.value='';render('');input.focus();});document.querySelectorAll('.finder-chips button').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;render(input.value);input.focus();}));
const targets=document.querySelector('#day-targets');document.querySelectorAll('.day-map button').forEach(button=>button.addEventListener('click',()=>{const day=button.dataset.day;document.querySelectorAll('.day-map button').forEach(item=>item.classList.toggle('active',item===button));const seen={};data.filter(item=>item.dayNumber===day).forEach(item=>{seen[item.slug]=item;});targets.innerHTML=Object.values(seen).map(item=>`<a href="/a-nations-story/${item.slug}/${item.day}/"><span>${item.flag}</span><strong>${esc(item.nation)}</strong><small>Day ${day}</small><i>Open ↗</i></a>`).join('');}));
</script>
<style>
.story-hub{overflow:hidden}.wrap{width:min(1160px,calc(100% - 36px));margin-inline:auto}.hero{position:relative;min-height:590px;display:flex;align-items:end;overflow:hidden;background:radial-gradient(circle at 80% 28%,#55c7f225,transparent 25%),linear-gradient(115deg,#061118,#0a1b25 58%,#0e2d3b);color:#eef8fc}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#061118,transparent 52%);pointer-events:none}.hero-ring{position:absolute;width:540px;height:540px;border:1px solid #55c7f216;border-radius:50%;right:-80px;top:40px;box-shadow:0 0 0 80px #55c7f208,0 0 0 160px #55c7f203}.ring-two{width:300px;height:300px;right:70px;top:160px;border-color:#55c7f225}.hero-inner{position:relative;z-index:2;width:min(1160px,calc(100% - 36px));margin:auto;padding:100px 0 60px}.eyebrow{font:900 9px var(--mono);letter-spacing:.16em;color:var(--blue)}.hero h1{font-size:clamp(58px,8vw,106px);line-height:.84;letter-spacing:-.08em;margin:20px 0}.hero h1 span{color:#55c7f2}.hero-sub{max-width:670px;color:#a3b6bf;font-size:15px;line-height:1.6}.hero-stats{display:flex;gap:7px;margin-top:40px}.hero-stats div{min-width:120px;padding:15px 18px;border:1px solid #ffffff15;border-radius:12px;background:#ffffff06;backdrop-filter:blur(8px)}.hero-stats strong{display:block;font:900 28px/1 var(--mono)}.hero-stats span{font:900 7px var(--mono);color:#728995;letter-spacing:.12em}.finder{padding:76px 0 88px}.finder-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:18px}.finder-head h2{font-size:44px;letter-spacing:-.06em;margin:8px 0}.finder-head p{max-width:400px;color:var(--muted);font-size:11px;line-height:1.7}.finder-panel{padding:14px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(145deg,var(--surface),var(--surface2));box-shadow:0 30px 90px #55c7f20a}.finder-input{display:flex;align-items:center;gap:12px;padding:16px;border:1px solid var(--border);border-radius:13px;background:var(--bg)}.finder-input:focus-within{border-color:#55c7f255;box-shadow:0 0 0 4px #55c7f20b}.finder-input>span{font-size:25px;color:var(--blue)}.finder-input input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font:600 13px var(--sans)}.finder-input button{border:0;background:transparent;color:var(--muted);font:900 7px var(--mono);cursor:pointer}.finder-input button:hover{color:var(--text)}.finder-chips{display:flex;gap:6px;overflow:auto;padding:11px 2px}.finder-chips button{flex:0 0 auto;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--muted);font:800 7px var(--mono);cursor:pointer}.finder-chips button:hover{border-color:#55c7f255;color:var(--blue)}.finder-results{display:grid;gap:6px}.finder-result{display:grid;grid-template-columns:35px 1fr 22px;gap:10px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:11px;background:var(--bg);color:var(--text);text-decoration:none;transition:.15s}.finder-result:hover{transform:translateX(3px);border-color:#55c7f255}.result-flag{font-size:22px}.result-main strong{display:block;font:900 7px var(--mono);color:var(--blue);text-transform:uppercase}.result-main b{display:block;font-size:12px;line-height:1.4;margin-top:4px}.result-main small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.result-arrow{color:var(--muted);text-align:right}.finder-empty,.finder-no-results{padding:20px 8px 8px;text-align:center;color:var(--muted);font-size:10px}.finder-empty[hidden]{display:none}.nation-stage{padding:0 0 90px}.section-line{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px;font:900 7px var(--mono);color:var(--muted)}.nation-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.nation-card{position:relative;aspect-ratio:4/5;border:1px solid var(--border);border-radius:16px;overflow:hidden;color:#fff;text-decoration:none;background:var(--surface);transition:.25s}.nation-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.45s}.nation-shade{position:absolute;inset:0;background:linear-gradient(180deg,#04101915 20%,#04101935 43%,#041019ee 100%)}.nation-card:hover{transform:translateY(-7px);border-color:var(--nation);box-shadow:0 25px 70px var(--nation-soft)}.nation-card:hover img{transform:scale(1.06)}.nation-top{position:absolute;top:14px;left:14px;right:14px;display:flex;justify-content:space-between;align-items:center}.nation-top span{font-size:27px}.nation-top b{font:900 8px var(--mono);color:#ffffffaa}.nation-copy{position:absolute;left:16px;right:16px;bottom:16px}.nation-copy small{font:900 6px var(--mono);letter-spacing:.13em;color:#ffffff99}.nation-copy h3{font-size:27px;letter-spacing:-.05em;margin:5px 0}.nation-meta{display:flex;gap:10px;color:#ffffffb8;font:700 7px var(--mono)}.nation-copy strong{display:flex;justify-content:space-between;margin-top:14px;padding-top:11px;border-top:1px solid #ffffff30;font:900 7px var(--mono)}.nation-copy i{font-style:normal;color:var(--nation)}.day-picker{padding:85px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);display:grid;grid-template-columns:.65fr 1.35fr;gap:35px}.day-copy h2{font-size:47px;letter-spacing:-.06em;margin:9px 0}.day-copy p{max-width:330px;color:var(--muted);font-size:11px;line-height:1.7}.day-map{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.day-map button{min-height:55px;border:1px solid var(--border);border-radius:11px;background:var(--surface);color:var(--muted);font:900 8px var(--mono);cursor:pointer;transition:.15s}.day-map button:hover,.day-map button.active{background:#55c7f2;color:#06131a;border-color:#55c7f2;transform:translateY(-2px)}.day-targets{display:grid;gap:6px;margin-top:8px}.day-placeholder{padding:18px;border:1px dashed var(--border);border-radius:12px;color:var(--muted);font-size:10px}.day-targets>a{display:grid;grid-template-columns:35px 1fr auto auto;gap:10px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:11px;background:var(--surface);color:var(--text);text-decoration:none}.day-targets>a:hover{border-color:#55c7f255}.day-targets span{font-size:22px}.day-targets strong{font-size:12px}.day-targets small{color:var(--muted);font:800 7px var(--mono)}.day-targets i{font:900 7px var(--mono);color:var(--blue);font-style:normal}.workflow{padding:90px 0;display:grid;grid-template-columns:.65fr 1.35fr;gap:70px}.workflow-title h2{font-size:clamp(56px,6vw,82px);line-height:.82;letter-spacing:-.08em;margin:10px 0}.workflow-title h2 span{color:var(--blue)}.workflow-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.workflow-cards article{min-height:220px;padding:18px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.workflow-cards b{font:900 8px var(--mono);color:var(--blue)}.workflow-cards strong{display:block;font-size:19px;margin:55px 0 9px}.workflow-cards p{font-size:10px;line-height:1.7;color:var(--muted)}.seo{border-top:1px solid var(--border);padding:65px 0 100px;max-width:850px}.seo h2{font-size:32px;letter-spacing:-.05em;margin:9px 0 14px}.seo p{color:var(--muted);font-size:11px;line-height:1.8}@media(max-width:900px){.nation-grid{grid-template-columns:repeat(3,1fr)}.day-picker,.workflow{grid-template-columns:1fr}.workflow-cards{grid-template-columns:1fr 1fr}}@media(max-width:600px){.wrap{width:min(100% - 28px,1160px)}.hero{min-height:600px}.hero-inner{padding:75px 0 42px}.hero h1{font-size:57px}.hero-stats{gap:5px}.hero-stats div{min-width:0;flex:1;padding:13px}.hero-stats strong{font-size:22px}.finder{padding:58px 0}.finder-head{display:block}.finder-head p{margin-top:10px}.finder-input{padding:13px}.finder-input input{font-size:11px}.nation-grid{grid-template-columns:1fr 1fr}.nation-card{aspect-ratio:1/1.25}.day-map{grid-template-columns:repeat(3,1fr)}.day-targets>a{grid-template-columns:30px 1fr auto}.day-targets small{display:none}.workflow-cards{grid-template-columns:1fr}.section-line{display:block}.section-line>span:last-child{display:block;margin-top:8px}}
</style>
