---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../../data/aNationsStory.js';
const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
const themeMap={japan:'#d9233f',netherlands:'#f28c28',mexico:'#1c9a5a',france:'#2878d8',brazil:'#f2c400'};
const searchIndex=NATIONS_STORY.flatMap(nation=>nation.days.flatMap(day=>day.questions.map((question,index)=>({nation:nation.name,slug:nation.slug,flag:nation.flag,day:day.id,question:question.question,answer:question.answer,index:index+1}))));
const totalDays=NATIONS_STORY.reduce((sum,nation)=>sum+nation.days.length,0);
---
<BaseLayout title="FC Mobile A Nation's Story Answers | Day 1 to Day 9" description="Find FC Mobile A Nation's Story answers for Japan, Netherlands, Mexico, France and Brazil with every Day 1 to Day 9 question and all available options">
<main class="story-hub">
<section class="hero"><div class="hero-inner"><span class="eyebrow">FC MOBILE · A NATION'S STORY</span><h1>Find the question<br><span>find the answer</span></h1><p>Search the wording you remember or choose a nation to reach the exact question page</p><div class="stats"><span><b>{NATIONS_STORY.length}</b> nations</span><span><b>{totalDays}</b> days</span><span><b>{NATIONS_STORY_QUESTION_COUNT}</b> questions</span></div></div></section>
<section class="finder wrap"><div class="finder-title"><span class="eyebrow">QUESTION SEARCH</span><h2>Search A Nation's Story</h2><p>Search by a player, year, team or any words you remember</p></div><div class="finder-box"><div class="search-bar"><span>⌕</span><input id="question-finder" autocomplete="off" placeholder="What do you remember about the question?" aria-label="Search A Nation's Story questions"><button id="clear-finder" type="button" aria-label="Clear search">×</button></div><div class="chips"><button type="button" data-query="World Cup">World Cup</button><button type="button" data-query="2022">2022</button><button type="button" data-query="final">Final</button><button type="button" data-query="scored">Scored</button></div><div id="finder-status" class="status">{NATIONS_STORY_QUESTION_COUNT} questions indexed</div><div id="finder-results" class="results"></div><div id="finder-empty" class="empty"><strong>Search when you remember part of the question</strong><span>Your matching questions will appear here</span></div></div></section>
<section class="nations wrap"><div class="section-head"><div><span class="eyebrow">CHOOSE A NATION</span><h2>Open a story</h2></div><span>16:9 thumbnails</span></div><div class="nation-grid">{NATIONS_STORY.map((nation,index)=>{const count=nation.days.reduce((sum,day)=>sum+day.questions.length,0);const theme=themeMap[nation.slug];return <a class="nation-card" href={`/a-nations-story/${nation.slug}/`} style={`--nation:${theme}`}><div class="nation-image"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} loading={index>1?'lazy':'eager'}></div><div class="nation-overlay"></div><div class="nation-info"><div><span>{nation.flag}</span><small>{count} questions · {nation.days.length} days</small></div><h3>{nation.name}</h3><b>VIEW ANSWERS ↗</b></div></a>})}</div></section>
<section class="content wrap"><span class="eyebrow">FC MOBILE ANSWERS</span><h2>A Nation's Story Day 1 to Day 9 answers</h2><p>Use this page when you remember part of an A Nation's Story question from FC Mobile  Search covers the stored question sets for Japan, Netherlands, Mexico, France and Brazil and takes you directly to the matching question</p><div class="content-grid"><article><b>SEARCH</b><h3>Search what you remember</h3><p>Player names, teams, years and phrases from a question can all lead to a match</p></article><article><b>NATION</b><h3>Choose the country</h3><p>Each nation has its own focused answer page with the complete question set</p></article><article><b>QUESTION</b><h3>Open the exact question</h3><p>Click a result to jump straight to that question on its day page</p></article></div></section>
</main>
</BaseLayout>
<script define:vars={{searchIndex,themeMap}}>
const input=document.querySelector('#question-finder'),results=document.querySelector('#finder-results'),empty=document.querySelector('#finder-empty'),clear=document.querySelector('#clear-finder'),status=document.querySelector('#finder-status'),data=searchIndex;
const esc=v=>String(v).replace(/[&<>\\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]||c));
function highlight(text,query){
  const source=esc(text);
  const terms=[...new Set(query.toLowerCase().split(/\\s+/).filter(Boolean))].sort((a,b)=>b.length-a.length);
  if(!terms.length)return source;
  const pattern=new RegExp('('+terms.map(term=>term.replace(/[.*+?^{}()|[\\]\\\\]/g,'\\\\$&')).join('|')+')','ig');
  return source.replace(pattern,'<mark>$1</mark>');
}
function render(value){
  const query=value.trim().toLowerCase();
  if(!query){results.innerHTML='';empty.hidden=false;status.textContent=data.length+' questions indexed';return}
  const words=query.split(/\\s+/).filter(Boolean);
  const matches=data.filter(item=>{const hay=(item.nation+' '+item.question+' '+item.answer).toLowerCase();return words.every(word=>hay.includes(word))}).slice(0,12);
  empty.hidden=true;
  status.textContent=matches.length?matches.length+' matching questions':'No matching question';
  results.innerHTML=matches.length?matches.map(item=>'<a class="result" href="/a-nations-story/'+item.slug+'/'+item.day+'/#q-'+item.index+'" style="--nation:'+themeMap[item.slug]+'"><span class="result-flag">'+item.flag+'</span><span class="result-main"><small>'+esc(item.nation)+' · '+item.day.replace('day-','Day ')+'</small><strong>'+highlight(item.question,query)+'</strong><em>Answer: '+highlight(item.answer,query)+'</em></span><span class="result-arrow">↗</span></a>').join(''):'<div class="no-results">Try fewer words such as a player name, year or team</div>';
}
input?.addEventListener('input',()=>render(input.value));
clear?.addEventListener('click',()=>{input.value='';render('');input.focus()});
document.querySelectorAll('.chips button').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;render(input.value);input.focus()}));
window.addEventListener('keydown',event=>{if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='k'){event.preventDefault();input?.focus()}});
</script>
<style>
.story-hub{overflow:hidden}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}.hero{min-height:500px;display:flex;align-items:end;background:linear-gradient(125deg,#061118,#0b202b);color:#eef8fc}.hero-inner{width:min(1160px,calc(100% - 36px));margin:auto;padding:90px 0 60px}.eyebrow{font:900 9px var(--mono);letter-spacing:.16em;color:var(--blue)}.hero h1{font-size:clamp(56px,8vw,100px);line-height:.86;letter-spacing:-.08em;margin:18px 0}.hero h1 span{color:#55c7f2}.hero p{max-width:620px;color:#9eb1bb;font-size:14px;line-height:1.7}.stats{display:flex;gap:7px;margin-top:30px}.stats span{padding:10px 13px;border:1px solid #ffffff15;border-radius:9px;color:#91a4ae;font:800 8px var(--mono)}.stats b{color:#fff;margin-right:4px}.finder{padding:75px 0}.finder-title h2{font-size:44px;letter-spacing:-.06em;margin:8px 0}.finder-title p{margin:0 0 18px;color:var(--muted);font-size:11px}.finder-box{max-width:900px}.search-bar{display:flex;align-items:center;gap:10px;padding:15px 16px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.search-bar:focus-within{border-color:#55c7f255;box-shadow:0 0 0 4px #55c7f20b}.search-bar>span{font-size:25px;color:var(--blue)}.search-bar input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font:600 13px var(--sans)}.search-bar button{border:0;background:transparent;color:var(--muted);font-size:21px;cursor:pointer}.chips{display:flex;gap:6px;overflow:auto;padding:9px 0}.chips button{border:1px solid var(--border);border-radius:999px;padding:7px 10px;background:transparent;color:var(--muted);font:800 7px var(--mono);cursor:pointer}.chips button:hover{color:var(--blue);border-color:#55c7f255}.status{padding:5px 0 10px;color:var(--muted);font:700 8px var(--mono)}.results{display:grid;gap:9px}.result{display:grid;grid-template-columns:42px 1fr 24px;gap:11px;align-items:center;padding:16px 15px;border:1px solid var(--border);border-radius:12px;background:var(--surface);text-decoration:none;color:var(--text);transition:transform .15s,border-color .15s,box-shadow .15s}.result:hover{border-color:color-mix(in srgb,var(--nation) 45%,transparent);transform:translateY(-1px);box-shadow:0 10px 30px color-mix(in srgb,var(--nation) 12%,transparent)}.result-flag{font-size:22px;text-align:center}.result-main{min-width:0}.result-main small{display:block;margin-bottom:5px;color:var(--nation);font:900 7px var(--mono);text-transform:uppercase}.result-main strong{display:block;font-size:12px;line-height:1.5}.result-arrow{color:var(--nation);font-size:18px;text-align:center}.empty{padding:24px 0;color:var(--muted)}.empty[hidden]{display:none}.empty strong,.empty span{display:block}.empty strong{color:var(--text);font-size:12px}.empty span{margin-top:4px;font-size:10px}.no-results{padding:20px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:10px}.nations{padding:0 0 80px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.section-head h2{font-size:42px;letter-spacing:-.06em;margin:8px 0}.section-head>span{font:800 7px var(--mono);color:var(--muted)}.nation-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.nation-card{position:relative;display:block;aspect-ratio:16/9;border-radius:15px;overflow:hidden;text-decoration:none;color:#fff;background:#111}.nation-image,.nation-image img,.nation-overlay{position:absolute;inset:0;width:100%;height:100%}.nation-image img{object-fit:cover;display:block;transition:transform .35s}.nation-overlay{background:linear-gradient(180deg,#00000008 30%,#000000c4 100%)}.nation-card:hover .nation-image img{transform:scale(1.035)}.nation-info{position:absolute;inset:auto 18px 17px;z-index:2}.nation-info>div{display:flex;align-items:center;gap:8px}.nation-info span{font-size:22px}.nation-info small{font:800 7px var(--mono);color:#d6e2e7}.nation-info h3{font-size:34px;letter-spacing:-.06em;margin:4px 0 5px}.nation-info>b{font:900 7px var(--mono);color:var(--nation)}.content{padding:55px 0 110px;border-top:1px solid var(--border)}.content h2{font-size:38px;letter-spacing:-.06em;margin:9px 0 12px}.content>p{max-width:850px;color:var(--muted);font-size:12px;line-height:1.8}.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:28px}.content-grid article{padding:17px;border:1px solid var(--border);border-radius:12px}.content-grid article>b{font:900 7px var(--mono);color:var(--blue)}.content-grid h3{font-size:15px;margin:25px 0 7px}.content-grid p{font-size:10px;line-height:1.7;color:var(--muted)}@media(max-width:700px){.wrap,.hero-inner{width:min(100% - 28px,1160px)}.hero{min-height:430px}.hero h1{font-size:54px}.stats{flex-wrap:wrap}.nation-grid,.content-grid{grid-template-columns:1fr}.section-head{display:block}.section-head>span{display:block;margin-top:8px}.result{grid-template-columns:34px 1fr 18px}.result-main strong{font-size:11px}}
</style><style>
.story-hub{background:radial-gradient(700px 380px at 76% 34%,rgba(76,201,255,.07),transparent 68%)}.finder{padding-top:82px}.finder-title{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.finder-title h2{font-size:clamp(32px,5vw,54px);letter-spacing:-.06em;margin:7px 0}.finder-title p{margin:0;color:var(--muted);font-size:11px}.finder-box{max-width:none;padding:22px;border:1px solid var(--border);border-radius:22px;background:linear-gradient(145deg,#0f1a26,#0b131d);box-shadow:0 20px 60px rgba(0,0,0,.2)}.search-bar{min-height:62px;padding:0 18px;border-radius:16px;background:#0a141e}.search-bar>span{font-size:28px}.search-bar input{font-size:15px}.search-bar button{width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.04)}.chips{padding:14px 0 9px}.chips button{padding:8px 12px;font-size:8px}.results{grid-template-columns:1fr 1fr}.result{min-width:0;padding:17px;border-radius:15px;background:linear-gradient(145deg,#111f2b,#0c151e);border-color:rgba(255,255,255,.07)}.result:hover{transform:translateY(-2px)}.result-main strong{font-size:13px}.result-main em{display:block;margin-top:7px;color:#778d9b;font:500 10px/1.5 var(--sans);font-style:normal}.result-main mark{padding:0 2px;border-radius:3px;background:rgba(76,201,255,.18);color:#dff8ff}.result-arrow{align-self:start}.status{padding:7px 0 12px}.no-results{margin-top:6px}.section-head h2{font-size:clamp(32px,5vw,50px)}.nation-grid{gap:14px}.nation-card{border:1px solid rgba(255,255,255,.08);box-shadow:0 16px 50px rgba(0,0,0,.18)}.nation-info h3{font-size:clamp(28px,4vw,40px)}@media(max-width:760px){.finder-title{display:block}.finder-box{padding:14px}.results{grid-template-columns:1fr}.search-bar{min-height:56px}.result-main strong{font-size:12px}}
</style>