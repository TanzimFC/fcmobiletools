---
// Old home of A Nation's Story. The content moved into Trivia; this page tells visitors
// (and links, bookmarks, search results) where it went. The canonical points at the new
// hub so ranking signals consolidate there.
import TriviaLayout from '../../layouts/TriviaLayout.astro';
import { NATIONS_STORY } from '../../data/aNationsStory.js';
import { ICONS } from '../../lib/triviaIcons.js';
import { nationImage, nationUrl, NATION_STYLE } from '../../lib/triviaNations.js';
import { NATIONS_ROUTE, OLD_NATIONS_ROUTE } from '../../lib/triviaRoutes.js';

const title = "A Nation's Story Has Moved to Trivia";
const description = "A Nation's Story now lives in its own FC Mobile Trivia collection, with each nation's football-history questions grouped by day.";
---
<TriviaLayout title={title} description={description} canonical={NATIONS_ROUTE} image={nationImage('japan')}>
  <div class="tv-wrap tv-moved">
    <span class="tv-eyebrow">🌍 A Nation's Story</span>
    <h1 class="tv-h1">We moved.<br /><span class="tv-grad">Now part of Trivia.</span></h1>
    <p class="tv-lede">A Nation's Story now has its own collection. Choose a nation, open a day, and see the complete set of questions, four options and correct answers together.</p>
    <div class="tv-route" aria-label="New location">
      <code class="from">{OLD_NATIONS_ROUTE}</code><i class="path"></i><code class="to">{NATIONS_ROUTE}</code>
    </div>
    <div class="tv-actions" style="justify-content:center">
      <a class="tv-btn" href={NATIONS_ROUTE}>View A Nation's Story <span set:html={ICONS.arrow} style="display:contents" /></a>
      <a class="tv-btn ghost" href="/trivia/">Browse all Trivia</a>
    </div>
    <div class="tv-moved-nations" aria-label="Jump to a nation">
      {NATIONS_STORY.map((n) => <a href={nationUrl(n.slug)} style={`--g:${NATION_STYLE[n.slug].glow}`}><span>{n.flag}</span>{n.name}</a>)}
    </div>
  </div>
</TriviaLayout>
