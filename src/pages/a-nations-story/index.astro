---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../../data/aNationsStory.js';
const totalDays = NATIONS_STORY.reduce((sum, nation) => sum + nation.days.length, 0);
const searchIndex = NATIONS_STORY.flatMap((nation) => nation.days.flatMap((day) => day.questions.map((question, index) => ({
  nation: nation.name,
  slug: nation.slug,
  day: day.id,
  dayTitle: day.title,
  index: index + 1,
  question: question.question,
  answer: question.answer
}))));
---
<BaseLayout title="FC Mobile A Nation's Story Answers | Japan, Netherlands, Mexico, France & Brazil" description="FC Mobile A Nation's Story answers. Search Japan, Netherlands, Mexico, France and Brazil questions and get the correct answer instantly, with every challenge organized by nation and day.">
  <main class="nation-story">
    <section class="hero">
      <div class="eyebrow">FC MOBILE · A NATION'S STORY</div>
      <div class="hero-grid">
        <div>
          <h1>Need the answer?<br><span>You're in the right place.</span></h1>
          <p class="lead">A Nation's Story is full of football-history questions. If you are stuck in FC Mobile, search the question and get the answer immediately. No quiz. No guessing. No digging through old guides.</p>
          <div class="search-wrap">
            <label for="story-search">Search a question, player, year or answer</label>
            <div class="search-box"><span>⌕</span><input id="story-search" autocomplete="off" placeholder="e.g. Who scored Japan's first World Cup goal?" /><kbd>⌘ K</kbd></div>
            <div id="search-results" class="search-results" aria-live="polite"></div>
          </div>
        </div>
        <aside class="stats"><div><strong>{NATIONS_STORY.length}</strong><span>NATIONS</span></div><div><strong>{NATIONS_STORY_QUESTION_COUNT}</strong><span>ANSWERS</span></div><div><strong>{totalDays}</strong><span>CHALLENGES</span></div></aside>
      </div>
    </section>

    <section class="nation-list">
      <div class="section-head"><div><span class="eyebrow">CHOOSE YOUR NATION</span><h2>Every answer, organized.</h2></div><p>Open a nation to browse every challenge. Answers are shown directly because this site is built for convenience, not for making you replay the quiz.</p></div>
      <div class="grid">
        {NATIONS_STORY.map((nation, i) => {
          const count = nation.days.reduce((sum, d) => sum + d.questions.length, 0);
          return <a class="nation-card" href={`/a-nations-story/${nation.slug}/`}><div class="flag">{nation.flag}</div><span class="number">{String(i + 1).padStart(2,'0')}</span><h3>{nation.name}</h3><p>{nation.description}</p><div class="meta"><span>{nation.days.length} CHALLENGES</span><span>{count} ANSWERS ↗</span></div></a>;
        })}
      </div>
    </section>

    <section class="answer-first">
      <div><span class="eyebrow">BUILT FOR SEARCH</span><h2>Find the exact question. Get the exact answer.</h2></div>
      <div class="copy"><p>Players usually reach a guide after getting stuck inside the game. That means the page needs to answer the search query immediately, not make the visitor take another quiz first.</p><p>Every challenge page contains the actual question text and answer in the HTML, making it useful for Google searches as well as fast on-page lookup. Search by nation, challenge, player, competition, year or a phrase from the question.</p></div>
    </section>

    <section class="seo-copy">
      <span class="eyebrow">FC MOBILE ANSWERS</span>
      <h2>FC Mobile A Nation's Story answers</h2>
      <p>A Nation's Story is a football-history event in FC Mobile where players answer questions about national teams, World Cups, continental tournaments and famous players. This guide collects the answers for Japan, Netherlands, Mexico, France and Brazil in one place.</p>
      <p>Use the search above when you remember only part of a question. Or open a nation and jump directly to the challenge you need. We keep the content structured so new nations can be added without rebuilding the whole section.</p>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ searchIndex }}>
  const input = document.querySelector('#story-search');
  const results = document.querySelector('#search-results');
  const data = searchIndex;
  const esc = (value) => String(value).replace(/[&<>\"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
  function render(query) {
    const q = query.trim().toLowerCase();
    if (!q) { results.innerHTML = ''; return; }
    const matches = data.filter((item) => `${item.nation} ${item.dayTitle} ${item.question} ${item.answer}`.toLowerCase().includes(q)).slice(0, 12);
    if (!matches.length) { results.innerHTML = '<div class="empty">No matching question yet. Try fewer words, a player name or a year.</div>'; return; }
    results.innerHTML = matches.map((item) => `<a href="/a-nations-story/${item.slug}/${item.day}/#q-${item.index}" class="result"><div><b>${esc(item.nation)}</b><span>${esc(item.dayTitle)} · Question ${item.index}</span></div><strong>${esc(item.answer)}</strong><p>${esc(item.question)}</p></a>`).join('');
  }
  input?.addEventListener('input', () => render(input.value));
  window.addEventListener('keydown', (event) => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); input?.focus(); } });
</script>

<style>
.nation-story{max-width:1180px;margin:auto;padding:0 20px 110px}.hero{padding:78px 0 68px;border-bottom:1px solid var(--border)}.eyebrow{font:900 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.hero-grid{display:grid;grid-template-columns:1fr 230px;gap:60px;align-items:end}.hero h1{font-size:clamp(55px,7vw,92px);line-height:.88;letter-spacing:-.075em;margin:20px 0}.hero h1 span{color:var(--blue)}.lead{max-width:720px;color:var(--muted);font-size:14px;line-height:1.8}.search-wrap{max-width:760px;margin-top:30px}.search-wrap label{display:block;margin-bottom:8px;color:var(--muted);font:800 8px var(--mono);text-transform:uppercase;letter-spacing:.08em}.search-box{display:flex;align-items:center;gap:10px;padding:13px 14px;border:1px solid var(--border);border-radius:12px;background:var(--surface);box-shadow:0 20px 70px #55c7f20a}.search-box:focus-within{border-color:#55c7f266;box-shadow:0 0 0 3px #55c7f212}.search-box span{font-size:22px;color:var(--blue)}.search-box input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font:500 12px var(--sans)}.search-box kbd{font:800 7px var(--mono);color:var(--muted);border:1px solid var(--border);padding:5px 6px;border-radius:5px;white-space:nowrap}.search-results{margin-top:8px;display:grid;gap:5px}.result{display:block;padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--surface);text-decoration:none;color:var(--text)}.result:hover{border-color:#55c7f255}.result>div{display:flex;justify-content:space-between;gap:15px}.result b{font:900 8px var(--mono);color:var(--blue);text-transform:uppercase}.result span{font:700 8px var(--mono);color:var(--muted)}.result strong{display:block;font-size:14px;margin-top:5px;color:var(--blue)}.result p{margin:5px 0 0;font-size:10px;line-height:1.5;color:var(--muted)}.empty{padding:13px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:10px}.stats{display:grid;gap:8px}.stats div{padding:18px;border:1px solid var(--border);border-radius:13px;background:var(--surface)}.stats strong{display:block;font:900 42px/1 var(--mono);letter-spacing:-.07em}.stats span{font:900 7px var(--mono);color:var(--muted);letter-spacing:.12em}.nation-list{padding:68px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:22px}.section-head h2{font-size:43px;letter-spacing:-.06em;margin:8px 0}.section-head p{max-width:430px;color:var(--muted);font-size:11px;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.nation-card{position:relative;min-height:290px;padding:17px;border:1px solid var(--border);border-radius:14px;background:var(--surface);text-decoration:none;color:var(--text);overflow:hidden;transition:.2s}.nation-card:hover{transform:translateY(-4px);border-color:#55c7f255}.flag{font-size:28px}.number{position:absolute;right:15px;top:15px;font:900 8px var(--mono);color:var(--muted)}.nation-card h3{font-size:22px;letter-spacing:-.04em;margin:58px 0 8px}.nation-card p{font-size:9px;line-height:1.7;color:var(--muted)}.meta{position:absolute;left:17px;right:17px;bottom:15px;padding-top:10px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font:900 7px var(--mono);color:var(--muted)}.answer-first{border-top:1px solid var(--border);padding:68px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.answer-first h2{font-size:clamp(35px,4vw,52px);line-height:.95;letter-spacing:-.06em;margin:9px 0}.copy{color:var(--muted);font-size:12px;line-height:1.8}.seo-copy{border-top:1px solid var(--border);padding:60px 0 0;max-width:860px}.seo-copy h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 14px}.seo-copy p{color:var(--muted);font-size:12px;line-height:1.8}@media(max-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero-grid,.answer-first{grid-template-columns:1fr}.stats{display:grid;grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.nation-story{padding:0 14px 80px}.hero{padding-top:55px}.hero h1{font-size:54px}.stats{grid-template-columns:1fr 1fr}.stats div:last-child{grid-column:span 2}.grid{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:12px}.search-box kbd{display:none}}
</style>
