---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../../data/aNationsStory.js';

const imageMap={japan:'/assets/images/anationstory/AN_japan_thumbnail.png',netherlands:'/assets/images/anationstory/AN_netherlands_thumbnail.png',mexico:'/assets/images/anationstory/AN_mexico_thumbnail (2).png',france:'/assets/images/anationstory/AN_france_thumbnail.png',brazil:'/assets/images/anationstory/AN_brazil_thumbnail.png'};
const themeMap={japan:'#d9233f',netherlands:'#f28c28',mexico:'#1c9a5a',france:'#2878d8',brazil:'#f2c400'};
const searchIndex=NATIONS_STORY.flatMap(nation=>nation.days.flatMap(day=>day.questions.map((question,index)=>({nation:nation.name,slug:nation.slug,flag:nation.flag,day:day.id,dayNumber:day.id.replace('day-',''),challenge:day.challenge||day.title,index:index+1,question:question.question,answer:question.answer}))));
const totalDays=NATIONS_STORY.reduce((sum,nation)=>sum+nation.days.length,0);
---
<BaseLayout title="FC Mobile A Nation's Story Answers | Day 1 to Day 9" description="Find FC Mobile A Nation's Story answers for Japan, Netherlands, Mexico, France and Brazil with every Day 1 to Day 9 question, all options and correct answers">
<main class="story-hub">
<section class="hero"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-glow"></div><div class="hero-inner"><div class="eyebrow">FC MOBILE · A NATION'S STORY · ANSWER HUB</div><h1>Find the answer<br><span>get back to the game</span></h1><p class="hero-sub">Search the question you remember, open the right nation or jump straight to a Day 1 to Day 9 answer page</p><div class="hero-stats"><div><strong>{NATIONS_STORY.length}</strong><span>NATIONS</span></div><div><strong>{totalDays}</strong><span>DAYS</span></div><div><strong>{NATIONS_STORY_QUESTION_COUNT}</strong><span>QUESTIONS</span></div></div></div></section>
<section class="finder wrap"><div class="finder-head"><div><span class="eyebrow">ANSWER SEARCH</span><h2>Search the question</h2></div><p>Search across every stored question and answer, then open the exact question on its nation page</p></div><div class="finder-shell"><div class="finder-bar"><span class="search-icon">⌕</span><input id="question-finder" autocomplete="off" placeholder="Search a player, year, team or part of the question" aria-label="Search A Nation's Story questions" /><kbd>Ctrl K</kbd><button id="clear-finder" type="button" aria-label="Clear search">×</button></div><div class="finder-tools"><span>TRY A SEARCH</span><button type="button" data-query="Japan 1998">Japan 1998</button><button type="button" data-query="Germany 2022">Germany 2022</button><button type="button" data-query="World Cup final">World Cup final</button><button type="button" data-query="scored">Scored</button></div><div id="finder-status" class="finder-status">{NATIONS_STORY_QUESTION_COUNT} questions indexed across Japan, Netherlands, Mexico, France and Brazil</div><div id="finder-results" class="finder-results" aria-live="polite"></div><div id="finder-empty" class="finder-empty"><div class="empty-mark">⌕</div><strong>Start typing to find an answer</strong><span>Results show the nation, day, question and answer before you open the exact page</span></div></div></section>
<section class="nation-stage wrap"><div class="section-line"><span class="eyebrow">CHOOSE A NATION</span><span>5 STORIES · 16:9 THUMBNAILS</span></div><div class="nation-grid">{NATIONS_STORY.map((nation,index)=>{const count=nation.days.reduce((sum,day)=>sum+day.questions.length,0);const theme=themeMap[nation.slug];return <a class="nation-card" href={`/a-nations-story/${nation.slug}/`} style={`--nation:${theme};--nation-soft:${theme}22`}><div class="nation-media"><img src={imageMap[nation.slug]} alt={`${nation.name} A Nation's Story`} loading={index>1?'lazy':'eager'}/><div class="nation-shade"></div></div><div class="nation-top"><span>{nation.flag}</span><b>0{index+1}</b></div><div class="nation-copy"><small>{nation.part}</small><h3>{nation.name}</h3><div class="nation-meta"><span>{count} questions</span><span>{nation.days.length} days</span></div><strong>OPEN ANSWERS <i>↗</i></strong></div></a>})}</div></section>
<section class="structure wrap"><div class="structure-intro"><div><span class="eyebrow">EVENT STRUCTURE</span><h2>Real questions organised by nation</h2></div><p>The content follows the stored A Nation's Story question sets, including their actual day counts and question totals</p></div><div class="structure-grid">{NATIONS_STORY.map(nation=>{const questions=nation.days.reduce((sum,day)=>sum+day.questions.length,0);const levels=[...new Set(nation.days.map(day=>day.level).filter(Boolean))];return <article style={`--nation:${themeMap[nation.slug]}`}><div class="structure-top"><span>{nation.flag}</span><b>{nation.name}</b></div><strong>{questions} questions</strong><p>{nation.description}</p><div class="structure-meta"><span>{nation.days.length} days</span><span>{levels.length?levels.join(' · '):'Daily questions'}</span></div></article>})}</div></section>
<section class="seo wrap"><span class="eyebrow">FC MOBILE ANSWERS</span><h2>FC Mobile A Nation's Story answers for Day 1 to Day 9</h2><p>This answer hub brings together Japan, Netherlands, Mexico, France and Brazil so a player can search the question they remember instead of opening every day manually</p><div class="seo-columns"><div><h3>Search by the clue</h3><p>Search matches player names, teams, years, tournaments, question wording and stored answers</p></div><div><h3>Open the exact question</h3><p>Every result links to its nation and day page with the question, available options and correct answer</p></div><div><h3>Use Day 1 to Day 9</h3><p>The answer pages use the Day naming players commonly use when looking for a specific challenge</p></div></div></section>
</main>
</BaseLayout>
<script define:vars={{searchIndex,themeMap}}>
const input=document.querySelector('#question-finder'),results=document.querySelector('#finder-results'),empty=document.querySelector('#finder-empty'),clear=document.querySelector('#clear-finder'),status=document.querySelector('#finder-status'),data=searchIndex;
const esc=v=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c));
function render(value){const query=value.trim().toLowerCase();if(!query){results.innerHTML='';empty.hidden=false;status.textContent=`${data.length} questions indexed across Japan, Netherlands, Mexico, France and Brazil`;return}const words=query.split(/\s+/).filter(Boolean);const matches=data.filter(item=>{const hay=`${item.nation} ${item.dayNumber} ${item.challenge} ${item.question} ${item.answer}`.toLowerCase();return words.every(word=>hay.includes(word))}).slice(0,10);empty.hidden=true;status.textContent=matches.length?`${matches.length} matching answers`:'No matching question found';results.innerHTML=matches.length?matches.map(item=>`<a class="finder-result" href="/a-nations-story/${item.slug}/${item.day}/#q-${item.index}"><div class="result-nation" style="--nation:${themeMap[item.slug]}"><span>${item.flag}</span><small>${esc(item.nation)}</small></div><div class="result-body"><div class="result-meta"><b>DAY ${item.dayNumber}</b><span>${esc(item.challenge)}</span></div><strong>${esc(item.question)}</strong><div class="result-answer"><span>ANSWER</span><b>${esc(item.answer)}</b></div></div><div class="result-open">OPEN<br>↗</div></a>`).join(''):'<div class="no-results"><strong>No exact match yet</strong><span>Try fewer words such as a player name, year or team</span></div>'}
input?.addEventListener('input',()=>render(input.value));clear?.addEventListener('click',()=>{input.value='';render('');input.focus()});document.querySelectorAll('.finder-tools button').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;render(input.value);input.focus()}));window.addEventListener('keydown',event=>{if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='k'){event.preventDefault();input?.focus()}});
</script>
<style>
.story-hub{overflow:hidden}.wrap{width:min(1160px,calc(100% - 36px));margin-inline:auto}.hero{position:relative;min-height:590px;display:flex;align-items:end;overflow:hidden;background:radial-gradient(circle at 75% 35%,#55c7f22a,transparent 24%),linear-gradient(115deg,#061118,#0a1b25 58%,#0e2d3b);color:#eef8fc}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#061118,transparent 52%);pointer-events:none}.hero-orbit{position:absolute;border:1px solid #55c7f21c;border-radius:50%;right:-100px;top:30px;width:620px;height:620px;box-shadow:0 0 0 90px #55c7f207,0 0 0 180px #55c7f203}.orbit-two{right:80px;top:170px;width:330px;height:330px;border-color:#55c7f232}.hero-glow{position:absolute;right:190px;top:285px;width:100px;height:100px;border-radius:50%;background:#55c7f22e;filter:blur(30px)}.hero-inner{position:relative;z-index:2;width:min(1160px,calc(100% - 36px));margin:auto;padding:100px 0 60px}.eyebrow{font:900 9px var(--mono);letter-spacing:.16em;color:var(--blue)}.hero h1{font-size:clamp(58px,8vw,106px);line-height:.84;letter-spacing:-.08em;margin:20px 0}.hero h1 span{color:#55c7f2}.hero-sub{max-width:720px;color:#a3b6bf;font-size:15px;line-height:1.6}.hero-stats{display:flex;gap:7px;margin-top:40px}.hero-stats div{min-width:120px;padding:15px 18px;border:1px solid #ffffff15;border-radius:12px;background:#ffffff06;backdrop-filter:blur(8px)}.hero-stats strong{display:block;font:900 28px/1 var(--mono)}.hero-stats span{font:900 7px var(--mono);color:#728995;letter-spacing:.12em}.finder{padding:76px 0 88px}.finder-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.finder-head h2{font-size:44px;letter-spacing:-.06em;margin:8px 0}.finder-head p{max-width:470px;color:var(--muted);font-size:11px;line-height:1.7}.finder-shell{padding:18px;border:1px solid var(--border);border-radius:22px;background:linear-gradient(145deg,var(--surface),var(--surface2));box-shadow:0 35px 100px #55c7f20b}.finder-bar{display:flex;align-items:center;gap:12px;padding:16px 17px;border:1px solid var(--border);border-radius:15px;background:var(--bg);transition:.18s}.finder-bar:focus-within{border-color:#55c7f260;box-shadow:0 0 0 4px #55c7f20c}.search-icon{font-size:28px;line-height:1;color:var(--blue)}.finder-bar input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font:600 14px var(--sans)}.finder-bar input::placeholder{color:var(--muted)}.finder-bar kbd{padding:5px 7px;border:1px solid var(--border);border-radius:6px;color:var(--muted);font:800 7px var(--mono)}.finder-bar button{border:0;background:transparent;color:var(--muted);font-size:22px;cursor:pointer}.finder-tools{display:flex;align-items:center;gap:7px;overflow:auto;padding:13px 2px 9px}.finder-tools>span{flex:0 0 auto;font:900 7px var(--mono);color:var(--muted);letter-spacing:.08em}.finder-tools button{flex:0 0 auto;padding:7px 10px;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--muted);font:800 7px var(--mono);cursor:pointer}.finder-tools button:hover{border-color:#55c7f255;color:var(--blue)}.finder-status{padding:6px 2px 12px;color:var(--muted);font:700 8px var(--mono)}.finder-results{display:grid;gap:7px}.finder-result{display:grid;grid-template-columns:82px 1fr 55px;gap:14px;align-items:stretch;padding:13px;border:1px solid var(--border);border-radius:14px;background:var(--bg);color:var(--text);text-decoration:none;transition:.18s}.finder-result:hover{transform:translateY(-2px);border-color:#55c7f255;box-shadow:0 12px 30px #00000012}.result-nation{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:7px;border-right:1px solid var(--border);color:var(--nation)}.result-nation span{font-size:27px}.result-nation small{font:900 7px var(--mono);text-transform:uppercase;color:var(--nation)}.result-body{min-width:0}.result-meta{display:flex;align-items:center;gap:8px;margin-bottom:7px}.result-meta b{font:900 7px var(--mono);color:var(--nation)}.result-meta span{font:700 8px var(--mono);color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.result-body>strong{display:block;font-size:13px;line-height:1.5}.result-answer{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid var(--border)}.result-answer span{font:900 7px var(--mono);color:var(--muted)}.result-answer b{font-size:11px}.result-open{display:flex;align-items:center;justify-content:center;text-align:center;border-left:1px solid var(--border);font:900 7px/1.5 var(--mono);color:var(--blue)}.finder-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:35px 20px 28px;color:var(--muted)}.finder-empty[hidden]{display:none}.empty-mark{display:grid;place-items:center;width:50px;height:50px;border:1px solid #55c7f233;border-radius:50%;color:var(--blue);font-size:25px;margin-bottom:10px}.finder-empty strong{color:var(--text);font-size:13px}.finder-empty span{max-width:470px;margin-top:6px;font-size:10px;line-height:1.7}.no-results{padding:28px;text-align:center;border:1px dashed var(--border);border-radius:12px;color:var(--muted)}.no-results strong,.no-results span{display:block}.no-results strong{color:var(--text);font-size:12px}.no-results span{font-size:10px;margin-top:5px}.nation-stage{padding:0 0 90px}.section-line{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px;font:900 7px var(--mono);color:var(--muted)}.nation-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.nation-card{position:relative;aspect-ratio:16/9;border:1px solid var(--border);border-radius:17px;overflow:hidden;color:#fff;text-decoration:none;background:var(--surface);transition:.25s}.nation-media,.nation-media img,.nation-shade{position:absolute;inset:0;width:100%;height:100%}.nation-media img{object-fit:cover;display:block;transition:.45s}.nation-shade{background:linear-gradient(180deg,#04101908 15%,#04101918 40%,#041019ef 100%)}.nation-card:hover{transform:translateY(-5px);border-color:var(--nation);box-shadow:0 25px 70px var(--nation-soft)}.nation-card:hover img{transform:scale(1.045)}.nation-top{position:absolute;top:14px;left:15px;right:15px;display:flex;justify-content:space-between;align-items:center}.nation-top span{font-size:27px}.nation-top b{font:900 8px var(--mono);color:#fff9}.nation-copy{position:absolute;left:18px;right:18px;bottom:17px}.nation-copy small{font:900 6px var(--mono);letter-spacing:.13em;color:#ffffffa8}.nation-copy h3{font-size:31px;letter-spacing:-.05em;margin:5px 0}.nation-meta{display:flex;gap:10px;color:#ffffffc4;font:700 7px var(--mono)}.nation-copy strong{display:flex;justify-content:space-between;margin-top:12px;padding-top:10px;border-top:1px solid #ffffff32;font:900 7px var(--mono)}.nation-copy i{font-style:normal;color:var(--nation)}.structure{padding:85px 0;border-top:1px solid var(--border)}.structure-intro{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.structure-intro h2{font-size:40px;letter-spacing:-.06em;margin:8px 0}.structure-intro p{max-width:360px;color:var(--muted);font-size:10px;line-height:1.7}.structure-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.structure-grid article{min-height:205px;padding:15px;border:1px solid var(--border);border-radius:13px;background:var(--surface);position:relative}.structure-top{display:flex;align-items:center;gap:8px;font:900 8px var(--mono);color:var(--nation)}.structure-top span{font-size:20px}.structure-grid article>strong{display:block;font-size:20px;margin-top:32px}.structure-grid article>p{font-size:9px;line-height:1.65;color:var(--muted);margin:6px 0 25px}.structure-meta{position:absolute;left:15px;right:15px;bottom:14px;display:flex;justify-content:space-between;gap:5px;color:var(--muted);font:700 6px var(--mono)}.seo{border-top:1px solid var(--border);padding:65px 0 100px;max-width:900px}.seo h2{font-size:34px;letter-spacing:-.05em;margin:9px 0 14px}.seo>p{color:var(--muted);font-size:11px;line-height:1.8}.seo-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:35px}.seo-columns h3{font-size:14px;margin:0 0 7px}.seo-columns p{color:var(--muted);font-size:10px;line-height:1.7}@media(max-width:900px){.nation-grid{grid-template-columns:1fr}.structure-grid{grid-template-columns:repeat(2,1fr)}.structure-intro{display:block}.structure-intro p{margin-top:10px}.seo-columns{grid-template-columns:1fr 1fr}}@media(max-width:600px){.wrap{width:min(100% - 28px,1160px)}.hero{min-height:600px}.hero-inner{padding:75px 0 42px}.hero h1{font-size:57px}.hero-stats{gap:5px}.hero-stats div{min-width:0;flex:1;padding:13px}.hero-stats strong{font-size:22px}.finder{padding:58px 0}.finder-head{display:block}.finder-head p{margin-top:10px}.finder-shell{padding:10px}.finder-bar{padding:13px}.finder-bar input{font-size:11px}.finder-bar kbd{display:none}.finder-result{grid-template-columns:48px 1fr 35px;gap:9px;padding:10px}.result-nation small{font-size:6px}.result-body>strong{font-size:11px}.result-answer b{font-size:10px}.result-open{font-size:6px}.nation-card{aspect-ratio:16/9}.nation-copy h3{font-size:24px}.structure-grid{grid-template-columns:1fr}.seo-columns{grid-template-columns:1fr}.section-line{display:block}.section-line>span:last-child{display:block;margin-top:8px}}
</style>
