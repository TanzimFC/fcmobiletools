---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GOALS, ACCENTS, iconSvg } from '../data/siteTools.js';

const description = 'New to FCMOBILETOOLS or FC Mobile? Pick what you want to do and we will point you to the right free tool or guide, with a short plain-English glossary.';

const glossary = [
  { term: 'OVR', text: 'A player’s overall rating, a number from about 40 to 130 that sums up how good they are.' },
  { term: 'Team OVR', text: 'Your whole squad’s rating. It is the average of your starters and subs, plus rank and badge bonuses. Higher means tougher opponents in some modes.' },
  { term: 'Rank Up', text: 'Upgrading a player by spending duplicate players or Rank Up resources to raise their OVR.' },
  { term: 'Training', text: 'Spending XP and fodder players to level up a card and lift its OVR.' },
  { term: 'Star Shards', text: 'A currency collected from events and rewards, spent on exclusive players and items.' },
  { term: 'Redeem code', text: 'A short code you type into the game’s settings to claim a free reward. Codes expire, so check them quickly.' },
  { term: 'Reset', text: 'The daily moment when missions, events and rewards refresh in the game.' },
];

const steps = [
  { n: '1', title: 'Pick a goal', text: 'Choose what you want to do below. You do not need an account.' },
  { n: '2', title: 'Open the tool', text: 'Most tools just ask for a few numbers from your game, like player OVRs.' },
  { n: '3', title: 'Get your answer', text: 'You see the result straight away, with what to do next.' },
];

const faq = [
  { q: 'Do I need an account?', a: 'No. Every calculator and guide works without signing in. An account only adds extras like saved progress, missions and rewards.' },
  { q: 'Is it free?', a: 'Yes. Ads and promotions pay for hosting and new tools.' },
  { q: 'Is this official?', a: 'No. FCMOBILETOOLS is a fan-made project and is not affiliated with EA SPORTS or the game’s publisher.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title="Start here: what do you want to do?" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="st">
    <header class="st-hero">
      <div class="st-wrap">
        <p class="sys-chip"><span class="sys-dot"></span>New here? You are in the right place</p>
        <h1>What do you want to do?</h1>
        <p class="st-lede">Pick a goal. We will show you the one page to open first and what to read next. It takes about a minute.</p>
        <ol class="st-steps" aria-label="How it works">
          {steps.map((s) => (
            <li><span class="st-n">{s.n}</span><span><strong>{s.title}</strong><small>{s.text}</small></span></li>
          ))}
        </ol>
      </div>
    </header>

    <section class="st-wrap" aria-label="Goals">
      <div class="st-goals" data-rv-group>
        {GOALS.map((g) => (
          <article class="st-goal" style={`--ac:${ACCENTS[g.accent]}`}>
            <span class="st-ico" set:html={iconSvg(g.icon)}></span>
            <h2>{g.title}</h2>
            <p>{g.lead}</p>
            <a class="st-first" href={g.first.href}>
              <span>{g.first.label}</span>
              <span set:html={iconSvg('right')}></span>
            </a>
            <ul class="st-then">
              {g.then.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="st-wrap st-gloss" aria-labelledby="st-gloss">
      <div class="st-gloss-head">
        <h2 id="st-gloss">Words you will see</h2>
        <p>Short explanations, so nothing on the site feels like jargon.</p>
      </div>
      <dl class="st-dl" data-rv-group>
        {glossary.map((g) => (
          <div class="st-term"><dt>{g.term}</dt><dd>{g.text}</dd></div>
        ))}
      </dl>
    </section>

    <section class="st-wrap st-faq" aria-labelledby="st-faq">
      <h2 id="st-faq">Quick answers</h2>
      <div class="st-faq-list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="st-more">Want the full list instead? <a class="sys-link" href="/tools/">Browse all tools</a></p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .st{padding-bottom:40px}
  .st-wrap{width:min(var(--content-width),calc(100% - 40px));margin-inline:auto}
  .st-hero{position:relative;padding:clamp(28px,5vw,60px) 0 clamp(20px,3vw,32px)}
  .st-hero h1{margin:16px 0 14px;max-width:14ch}
  .st-lede{margin:0;max-width:52ch;color:var(--muted);font-size:clamp(16px,1.6vw,18px)}
  .st-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:28px 0 0;padding:0;list-style:none}
  .st-steps li{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border:1px solid var(--line-soft);border-radius:var(--r-md);background:rgba(255,255,255,.025)}
  .st-n{display:grid;place-items:center;flex:none;width:28px;height:28px;border-radius:50%;background:var(--primary-soft);border:1px solid rgba(76,201,255,.35);color:#bdeeff;font:700 13px/1 var(--font-display)}
  .st-steps strong{display:block;font:700 15px/1.3 var(--font-body)}
  .st-steps small{display:block;margin-top:3px;color:var(--muted);font:500 13.5px/1.45 var(--font-body)}

  .st-goals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:20px}
  .st-goal{display:flex;flex-direction:column;gap:8px;padding:22px;border:1px solid var(--line-soft);border-radius:var(--r-lg);background:radial-gradient(110% 80% at 100% 0%,color-mix(in srgb,var(--ac) 15%,transparent),transparent 62%),var(--card-fill);box-shadow:var(--card-edge),var(--shadow-sm);transition:transform .35s var(--ease),border-color .25s,box-shadow .35s var(--ease)}
  .st-goal:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--ac) 50%,transparent);box-shadow:var(--card-edge),var(--shadow-md),0 0 50px -28px var(--ac)}
  .st-ico{display:grid;place-items:center;width:46px;height:46px;border-radius:13px;color:var(--ac);background:color-mix(in srgb,var(--ac) 15%,transparent);border:1px solid color-mix(in srgb,var(--ac) 32%,transparent)}
  .st-ico svg{width:23px;height:23px}
  .st-goal h2{margin:8px 0 0;font-size:21px}
  .st-goal p{margin:0;color:var(--muted);font:500 14.5px/1.5 var(--font-body)}
  .st-first{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;min-height:48px;padding:0 16px;border-radius:var(--r-md);border:1px solid color-mix(in srgb,var(--ac) 45%,transparent);background:color-mix(in srgb,var(--ac) 14%,transparent);color:var(--text);font:700 14.5px/1.2 var(--font-body);text-decoration:none;transition:background .2s,transform .25s var(--ease)}
  .st-first svg{width:18px;height:18px;color:var(--ac);flex:none;transition:transform .3s var(--ease)}
  .st-first:hover{background:color-mix(in srgb,var(--ac) 24%,transparent)}
  .st-first:hover svg{transform:translateX(4px)}
  .st-then{display:flex;flex-wrap:wrap;gap:6px 14px;margin:6px 0 0;padding:0;list-style:none}
  .st-then a{color:var(--muted-strong);font:600 13.5px/1.4 var(--font-body);text-decoration:underline;text-decoration-color:rgba(255,255,255,.2);text-underline-offset:3px}
  .st-then a:hover{color:var(--text);text-decoration-color:var(--ac)}

  .st-gloss{margin-top:clamp(40px,6vw,72px)}
  .st-gloss-head{margin-bottom:18px}
  .st-gloss-head h2,.st-faq h2{margin:0 0 6px;font-size:clamp(24px,3vw,30px)}
  .st-gloss-head p{margin:0;color:var(--muted)}
  .st-dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:0}
  .st-term{padding:16px 18px;border:1px solid var(--line-soft);border-radius:var(--r-md);background:rgba(255,255,255,.025)}
  .st-term dt{color:#bdeeff;font:700 15px/1.3 var(--font-display)}
  .st-term dd{margin:5px 0 0;color:var(--muted-strong);font:500 14.5px/1.55 var(--font-body)}

  .st-faq{margin-top:clamp(40px,6vw,72px);max-width:760px}
  .st-faq-list{display:grid;gap:10px;margin-top:16px}
  .st-faq details{border:1px solid var(--line-soft);border-radius:var(--r-md);background:rgba(255,255,255,.025);transition:border-color .2s}
  .st-faq details[open]{border-color:rgba(76,201,255,.3)}
  .st-faq summary{list-style:none;cursor:pointer;padding:16px 18px;font:700 15.5px/1.35 var(--font-body)}
  .st-faq summary::-webkit-details-marker{display:none}
  .st-faq summary::after{content:"+";float:right;color:var(--primary);font:600 20px/1 var(--font-body)}
  .st-faq details[open] summary::after{content:"–"}
  .st-faq details p{margin:0;padding:0 18px 16px;color:var(--muted-strong);font:500 15px/1.6 var(--font-body)}
  .st-more{margin-top:18px;color:var(--muted)}

  @media(max-width:980px){.st-goals{grid-template-columns:repeat(2,minmax(0,1fr))}.st-steps{grid-template-columns:1fr}}
  @media(max-width:640px){.st-wrap{width:calc(100% - 32px)}.st-goals,.st-dl{grid-template-columns:1fr}}
</style>
