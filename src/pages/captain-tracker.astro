 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:20px; }
 article { padding:26px; border-radius:24px; }
 h3 { margin:0 0 10px; font:700 20px/1.15 "Space Grotesk",Inter,sans-serif; letter-spacing:-.04em; }
 p { margin:0; color:#98aebb; font:500 14px/1.7 Inter,sans-serif; }
 { margin-top:26px; padding:24px 4px 0; border-top:1px solid var(--line); color:#6f8898; font:500 13px/1.7 Inter,sans-serif; }
