---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const tracker = FOOTBALL_CENTRE_CONTENT.captainTracker;
const players = tracker.players ?? [];
const tasks = tracker.tasks ?? [];
---

<BaseLayout
  title="Captain OVR Tracker · Premier League Matchday 7"
  description="Track the Matchday 7 captains and every condition on the route to 121 OVR."
>
  <main class="captain-page" data-captain-tracker>
    <header class="tracker-header">
      <div>
        <span class="tracker-kicker"><i></i>{tracker.label}</span>
        <h1>Captain OVR Tracker</h1>
      </div>
      <div class="header-route">
        <span>START</span><strong>{tracker.baseOvr}</strong>
        <b>→</b>
        <span>CEILING</span><strong class="ceiling">121</strong>
      </div>
    </header>

    <section class="captain-feed" aria-label="Captain tracker">
      {players.map((player, index) => {
        const completedCount = tasks.filter((task) => Boolean(player.completed?.[task.id])).length;
        const projected = Number(player.baseOvr ?? tracker.baseOvr) + completedCount;
        const allDone = completedCount === tasks.length;

        return (
          <article
            class:list={['player-feature', index === 1 ? 'is-featured' : '', allDone ? 'is-complete' : '']}
            data-player={player.id}
            style={"--delay:" + index * 70 + "ms"}
          >
            <div class="feature-rail">
              <span>CAPTAIN</span>
              <strong>#{String(index + 1).padStart(2, '0')}</strong>
            </div>

            <div class="feature-card-art">
              <div class="art-glow"></div>
              <div class="art-shadow"></div>
              <img
                src={player.image}
                alt={player.name + ' FC Mobile captain card'}
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="art-tag">
                <small>BASE</small>
                <strong>{player.baseOvr ?? tracker.baseOvr}</strong>
              </div>
              {allDone && <div class="completion-stamp" aria-label="All conditions confirmed"><span>✓</span><b>COMPLETE</b></div>}
            </div>

            <div class="feature-content">
              <div class="feature-head">
                <div class="identity">
                  <span class="club">{player.club}</span>
                  <h2>{player.name}</h2>
                  <p>{player.fixture}</p>
                </div>

                <div class="ovr-lockup" aria-label={'Projected OVR ' + projected}>
                  <span>PROJECTED</span>
                  <strong data-ovr>{projected}</strong>
                  <em>/ 121</em>
                </div>
              </div>

              <div class="conditions" aria-label="Captain conditions">
                {tasks.map((task, taskIndex) => {
                  const done = Boolean(player.completed?.[task.id]);
                  const chance = Number(player.probability?.[task.id] ?? 0);
                  return (
                    <div class:list={['condition', done ? 'is-complete' : '']} data-task={task.id}>
                      <div class="condition-top">
                        <span>{String(taskIndex + 1).padStart(2, '0')}</span>
                        <strong>{task.short}</strong>
                        <b data-chance>{done ? 'CONFIRMED' : chance + '%'}</b>
                      </div>
                      <p>{task.title}</p>
                      <div class="condition-bar" aria-hidden="true">
                        <i style={"width:" + (done ? 100 : chance) + "%"}></i>
                      </div>
                      {done && <span class="check" aria-hidden="true">✓</span>}
                    </div>
                  );
                })}
              </div>

              <details class="analysis">
                <summary>
                  <span>Read {player.name.split(' ')[0]}'s route</span>
                  <i aria-hidden="true"></i>
                </summary>
                <div class="analysis-body">
                  <p>{player.note}</p>
                  <div class="analysis-meta">
                    <span>{completedCount} / {tasks.length} confirmed</span>
                    <span>Matchday 7</span>
                  </div>
                </div>
              </details>
            </div>
          </article>
        );
      })}
    </section>

    <footer class="tracker-footnote">
      <span>FCMOBILETOOLS · MATCHDAY 7</span>
      <p>Percentages are directional estimates. Completed conditions are controlled from the Football Centre admin editor.</p>
    </footer>

    <script type="application/json" id="captain-data">{JSON.stringify({ baseOvr: tracker.baseOvr, tasks, players })}</script>
  </main><script is:inline>
  (() => {
    const root = document.querySelector('[data-captain-tracker]');
    if (!root) return;

    let source = { baseOvr: 116, tasks: [], players: [] };
    try {
      source = JSON.parse(document.getElementById('captain-data')?.textContent || '{}');
    } catch {}

    const tasks = source.tasks || [];

    const updateCard = (player) => {
      const card = root.querySelector('[data-player="' + player.id + '"]');
      if (!card) return;

      let confirmed = 0;

      tasks.forEach((task) => {
        const row = card.querySelector('[data-task="' + task.id + '"]');
        if (!row) return;

        const complete = Boolean(player.completed?.[task.id]);
        const chance = Number(player.probability?.[task.id] || 0);
        if (complete) confirmed += 1;

        row.classList.toggle('is-complete', complete);

        const chanceValue = row.querySelector('[data-chance]');
        const bar = row.querySelector('.condition-bar i');
        if (chanceValue) chanceValue.textContent = complete ? 'CONFIRMED' : chance + '%';
        if (bar) bar.style.width = (complete ? 100 : chance) + '%';

        const check = row.querySelector('.check');
        if (complete && !check) {
          const mark = document.createElement('span');
          mark.className = 'check';
          mark.setAttribute('aria-hidden', 'true');
          mark.textContent = '✓';
          row.appendChild(mark);
        }
        if (!complete && check) check.remove();
      });

      const current = Number(player.baseOvr || source.baseOvr || 116) + confirmed;
      const ovr = card.querySelector('[data-ovr]');
      if (ovr) ovr.textContent = String(current);

      const completeAll = confirmed === tasks.length;
      card.classList.toggle('is-complete', completeAll);

      let stamp = card.querySelector('.completion-stamp');
      const art = card.querySelector('.feature-card-art');
      if (completeAll && !stamp && art) {
        stamp = document.createElement('div');
        stamp.className = 'completion-stamp';
        stamp.setAttribute('aria-label', 'All conditions confirmed');
        stamp.innerHTML = '<span>✓</span><b>COMPLETE</b>';
        art.appendChild(stamp);
      }
      if (!completeAll && stamp) stamp.remove();
    };

    (source.players || []).forEach(updateCard);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, instance) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          instance.unobserve(entry.target);
        });
      }, { threshold: 0.08 });

      root.querySelectorAll('.player-feature').forEach((card) => observer.observe(card));
    } else {
      root.querySelectorAll('.player-feature').forEach((card) => card.classList.add('is-visible'));
    }

    fetch('/api/football?captains=' + Date.now(), { cache: 'no-store' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const live = payload?.content?.captainTracker;
        if (!live?.players) return;
        live.players.forEach(updateCard);
      })
      .catch(() => {});
  })();
</script>

</BaseLayout>
<style>
  :global(html), :global(body) { background:#071018; }

  .captain-page {
    --cyan:#4cc9ff;
    --cyan-soft:#b9efff;
    --success:#47d16c;
    --text:#f5f8fb;
    --muted:#8095a5;
    --line:rgba(255,255,255,.075);
    width:min(1240px,calc(100% - 28px));
    margin:0 auto;
    padding:18px 0 30px;
    color:var(--text);
  }

  .tracker-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    min-height:72px;
    padding:10px 13px 10px 18px;
    border:1px solid rgba(76,201,255,.12);
    border-radius:18px;
    background:
      radial-gradient(440px 110px at 0 0,rgba(76,201,255,.09),transparent 74%),
      linear-gradient(145deg,#0f1d29,#09131c);
    box-shadow:0 16px 48px rgba(0,0,0,.32),inset 0 1px rgba(255,255,255,.025);
    animation:headerIn .5s cubic-bezier(.22,1,.36,1) both;
  }

  .tracker-kicker {
    display:flex;
    align-items:center;
    gap:7px;
    color:#73d9ff;
    font:800 7px Inter,system-ui,sans-serif;
    letter-spacing:.16em;
    text-transform:uppercase;
  }

  .tracker-kicker i {
    width:5px;
    height:5px;
    border-radius:50%;
    background:var(--cyan);
    box-shadow:0 0 15px rgba(76,201,255,.85);
    animation:pulse 2s ease-in-out infinite;
  }

  .tracker-header h1 {
    margin:6px 0 0;
    font:700 clamp(24px,3.4vw,38px)/.95 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.055em;
  }

  .header-route {
    display:flex;
    align-items:baseline;
    gap:7px;
    padding:8px 11px;
    border:1px solid rgba(255,255,255,.06);
    border-radius:11px;
    background:rgba(255,255,255,.022);
  }

  .header-route span {
    color:#526b7b;
    font:800 6px Inter,sans-serif;
    letter-spacing:.12em;
  }

  .header-route strong {
    color:#dce7ed;
    font:700 22px/.9 "Space Grotesk",Inter,sans-serif;
  }

  .header-route b {
    color:#4e6879;
    font:700 10px Inter,sans-serif;
  }

  .header-route .ceiling { color:var(--cyan-soft); }

  .captain-feed {
    display:grid;
    gap:16px;
    margin-top:16px;
  }

  .player-feature {
    --border:rgba(255,255,255,.075);
    position:relative;
    display:grid;
    grid-template-columns:44px minmax(270px,340px) minmax(0,1fr);
    overflow:hidden;
    border:1px solid var(--border);
    border-radius:22px;
    background:
      radial-gradient(600px 380px at 20% 0,rgba(76,201,255,.045),transparent 64%),
      linear-gradient(145deg,#0e1a25,#09131b);
    box-shadow:0 22px 70px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.022);
    opacity:0;
    transform:translateY(17px);
    transition:opacity .55s ease,transform .55s cubic-bezier(.22,1,.36,1),border-color .25s ease,box-shadow .25s ease;
  }

  .player-feature.is-visible {
    opacity:1;
    transform:none;
    transition-delay:var(--delay);
  }

  .player-feature:hover {
    transform:translateY(-3px);
    border-color:rgba(76,201,255,.18);
    box-shadow:0 30px 90px rgba(0,0,0,.42),0 0 55px rgba(76,201,255,.03);
  }

  .player-feature.is-featured {
    --border:rgba(76,201,255,.22);
  }

  .player-feature.is-complete {
    --border:rgba(71,209,108,.28);
    background:
      radial-gradient(600px 380px at 20% 0,rgba(71,209,108,.045),transparent 64%),
      linear-gradient(145deg,#0e1b25,#09131b);
  }

  .feature-rail {
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:space-between;
    padding:18px 0;
    border-right:1px solid rgba(255,255,255,.06);
    background:rgba(0,0,0,.08);
  }

  .feature-rail span {
    color:#526c7d;
    font:800 6px Inter,sans-serif;
    letter-spacing:.14em;
    writing-mode:vertical-rl;
    transform:rotate(180deg);
  }

  .feature-rail strong {
    color:#5e7685;
    font:800 8px Inter,sans-serif;
    letter-spacing:.08em;
  }

  .feature-card-art {
    position:relative;
    display:grid;
    place-items:center;
    align-self:stretch;
    min-height:310px;
    padding:15px 12px 9px;
    overflow:hidden;
    border-right:1px solid rgba(255,255,255,.06);
    background:
      radial-gradient(circle at 50% 25%,rgba(76,201,255,.075),transparent 48%),
      linear-gradient(180deg,rgba(255,255,255,.018),rgba(0,0,0,.08));
  }

  .art-glow {
    position:absolute;
    width:240px;
    aspect-ratio:1;
    border-radius:50%;
    background:rgba(76,201,255,.08);
    filter:blur(50px);
    animation:artPulse 5.5s ease-in-out infinite;
  }

  .art-shadow {
    position:absolute;
    left:50%;
    bottom:13px;
    width:145px;
    height:20px;
    border-radius:50%;
    background:rgba(0,0,0,.62);
    filter:blur(12px);
    transform:translateX(-50%);
  }

  .feature-card-art img {
    position:relative;
    z-index:1;
    display:block;
    width:min(92%,390px);
    height:auto;
    object-fit:contain;
    filter:drop-shadow(0 24px 26px rgba(0,0,0,.67));
    transform:translateY(3px) scale(1.03);
    transition:transform .42s cubic-bezier(.22,1,.36,1),filter .42s ease;
  }

  .player-feature:hover .feature-card-art img {
    transform:translateY(-5px) scale(1.075);
    filter:drop-shadow(0 31px 32px rgba(0,0,0,.74));
  }

  .art-tag {
    position:absolute;
    left:11px;
    bottom:14px;
    z-index:3;
    display:grid;
    gap:2px;
    min-width:50px;
    padding:6px 7px;
    border:1px solid rgba(255,255,255,.065);
    border-radius:9px;
    background:rgba(5,13,19,.62);
    backdrop-filter:blur(8px);
  }

  .art-tag small {
    color:#5f7787;
    font:800 5.5px Inter,sans-serif;
    letter-spacing:.12em;
  }

  .art-tag strong {
    color:#e0e9ed;
    font:700 17px/.88 "Space Grotesk",Inter,sans-serif;
  }

  .completion-stamp {
    position:absolute;
    right:11px;
    bottom:14px;
    z-index:3;
    display:flex;
    align-items:center;
    gap:5px;
    padding:6px 7px;
    border:1px solid rgba(71,209,108,.28);
    border-radius:9px;
    background:rgba(5,24,12,.72);
    color:var(--success);
    box-shadow:0 0 24px rgba(71,209,108,.09);
    backdrop-filter:blur(8px);
    animation:stampIn .35s cubic-bezier(.22,1,.36,1) both;
  }

  .completion-stamp span {
    display:grid;
    place-items:center;
    width:16px;
    height:16px;
    border-radius:50%;
    background:rgba(71,209,108,.14);
    font:800 9px Inter,sans-serif;
  }

  .completion-stamp b {
    font:800 6px Inter,sans-serif;
    letter-spacing:.10em;
  }

  .feature-content {
    min-width:0;
    padding:21px 21px 16px;
  }

  .feature-head {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:20px;
    padding-bottom:16px;
    border-bottom:1px solid rgba(255,255,255,.06);
  }

  .club {
    color:#5f7787;
    font:800 7px Inter,sans-serif;
    letter-spacing:.13em;
    text-transform:uppercase;
  }

  .identity h2 {
    margin:6px 0 4px;
    font:700 clamp(25px,3.15vw,35px)/.95 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.055em;
  }

  .identity p {
    margin:0;
    color:#7f94a3;
    font:600 9px/1.45 Inter,sans-serif;
  }

  .ovr-lockup {
    min-width:94px;
    text-align:right;
  }

  .ovr-lockup span {
    display:block;
    color:#5d7585;
    font:800 6px Inter,sans-serif;
    letter-spacing:.13em;
  }

  .ovr-lockup strong {
    display:inline-block;
    margin-top:5px;
    font:700 50px/.80 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.07em;
    transition:color .25s ease,text-shadow .25s ease;
  }

  .ovr-lockup em {
    color:#657b8b;
    font:700 9px Inter,sans-serif;
    font-style:normal;
  }

  .player-feature.is-complete .ovr-lockup strong {
    color:var(--success);
    text-shadow:0 0 28px rgba(71,209,108,.16);
  }

  .conditions {
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:7px;
    padding-top:13px;
  }

  .condition {
    position:relative;
    min-width:0;
    padding:10px 9px 9px;
    border:1px solid rgba(255,255,255,.055);
    border-radius:11px;
    background:rgba(255,255,255,.018);
    overflow:hidden;
    transition:transform .22s ease,border-color .22s ease,background .22s ease;
  }

  .condition:hover {
    transform:translateY(-2px);
    border-color:rgba(76,201,255,.17);
    background:rgba(76,201,255,.025);
  }

  .condition.is-complete {
    border-color:rgba(71,209,108,.22);
    background:rgba(71,209,108,.035);
  }

  .condition-top {
    display:grid;
    grid-template-columns:auto minmax(0,1fr) auto;
    align-items:center;
    gap:5px;
  }

  .condition-top span {
    color:#4e6677;
    font:800 5.5px Inter,sans-serif;
  }

  .condition-top strong {
    overflow:hidden;
    color:#d8e3e8;
    font:800 8px "Space Grotesk",Inter,sans-serif;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .condition-top b {
    color:#778d9c;
    font:800 6px Inter,sans-serif;
    white-space:nowrap;
  }

  .condition.is-complete .condition-top b {
    color:var(--success);
  }

  .condition p {
    min-height:24px;
    margin:5px 0 8px;
    overflow:hidden;
    color:#657b8b;
    font:600 6.5px/1.35 Inter,sans-serif;
  }

  .condition-bar {
    height:3px;
    border-radius:999px;
    overflow:hidden;
    background:#071018;
  }

  .condition-bar i {
    display:block;
    height:100%;
    border-radius:inherit;
    background:linear-gradient(90deg,#267da4,var(--cyan));
    transition:width .65s cubic-bezier(.22,1,.36,1);
  }

  .condition.is-complete .condition-bar i {
    background:linear-gradient(90deg,#2aa650,var(--success));
    box-shadow:0 0 12px rgba(71,209,108,.2);
  }

  .check {
    position:absolute;
    top:5px;
    right:5px;
    display:grid;
    place-items:center;
    width:15px;
    height:15px;
    border:1px solid rgba(71,209,108,.25);
    border-radius:50%;
    background:rgba(71,209,108,.14);
    color:var(--success);
    font:800 8px Inter,sans-serif;
    box-shadow:0 0 14px rgba(71,209,108,.10);
    animation:checkIn .28s cubic-bezier(.22,1,.36,1) both;
  }

  .analysis {
    margin-top:12px;
    border-top:1px solid rgba(255,255,255,.06);
  }

  .analysis summary {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:11px 0 10px;
    color:#91a5b2;
    font:800 7px Inter,sans-serif;
    letter-spacing:.06em;
    list-style:none;
    cursor:pointer;
  }

  .analysis summary::-webkit-details-marker { display:none; }

  .analysis summary i {
    position:relative;
    width:17px;
    height:17px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:6px;
  }

  .analysis summary i::before,
  .analysis summary i::after {
    content:'';
    position:absolute;
    left:50%;
    top:50%;
    width:7px;
    height:1px;
    background:currentColor;
    transform:translate(-50%,-50%);
    transition:transform .2s ease;
  }

  .analysis summary i::after { transform:translate(-50%,-50%) rotate(90deg); }

  .analysis[open] summary i::after { transform:translate(-50%,-50%) rotate(0); }
  .analysis summary:hover { color:var(--cyan-soft); }

  .analysis-body {
    padding:0 0 4px;
    animation:analysisIn .28s ease both;
  }

  .analysis-body p {
    margin:0;
    color:#8297a5;
    font:600 8.5px/1.65 Inter,sans-serif;
  }

  .analysis-meta {
    display:flex;
    gap:7px;
    margin-top:9px;
  }

  .analysis-meta span {
    padding:5px 7px;
    border:1px solid rgba(255,255,255,.06);
    border-radius:7px;
    color:#5f7686;
    font:800 6px Inter,sans-serif;
    letter-spacing:.06em;
  }

  .tracker-footnote {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:20px;
    margin-top:14px;
    padding-top:11px;
    border-top:1px solid rgba(255,255,255,.05);
  }

  .tracker-footnote span {
    color:#526a7a;
    font:800 6.5px Inter,sans-serif;
    letter-spacing:.11em;
    white-space:nowrap;
  }

  .tracker-footnote p {
    max-width:560px;
    margin:0;
    color:#4c6474;
    font:600 7px/1.5 Inter,sans-serif;
    text-align:right;
  }

  @keyframes headerIn { from{opacity:0;transform:translateY(7px)} to{opacity:1;transform:none} }
  @keyframes pulse { 50%{transform:scale(1.22);box-shadow:0 0 20px rgba(76,201,255,.9)} }
  @keyframes artPulse { 50%{transform:scale(1.08);opacity:.75} }
  @keyframes stampIn { from{opacity:0;transform:scale(.88) translateY(4px)} to{opacity:1;transform:none} }
  @keyframes checkIn { from{opacity:0;transform:scale(.6)} to{opacity:1;transform:scale(1)} }
  @keyframes analysisIn { from{opacity:0;transform:translateY(-3px)} to{opacity:1;transform:none} }

  @media (max-width:1020px) {
    .player-feature { grid-template-columns:38px minmax(300px,34vw) minmax(0,1fr); }
    .conditions { grid-template-columns:repeat(3,minmax(0,1fr)); }
  }

  @media (max-width:760px) {
    .captain-page { width:min(100% - 12px,1240px); padding-top:11px; }
    .tracker-header { min-height:66px; border-radius:15px; padding:9px 9px 9px 13px; }
    .tracker-kicker { font-size:6px; }
    .tracker-header h1 { font-size:24px; }
    .header-route { gap:5px; padding:7px 8px; }
    .header-route span { display:none; }
    .header-route strong { font-size:20px; }
    .captain-feed { gap:12px; margin-top:11px; }
    .player-feature { grid-template-columns:1fr; border-radius:18px; }
