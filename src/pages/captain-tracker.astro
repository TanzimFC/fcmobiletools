/* ==========================================================================
   Keyframes
   ========================================================================== */
@keyframes ctRise { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:none; } }
@keyframes ctPulse { 50% { transform:scale(1.1); opacity:.7; } }
@keyframes ctDriftA { to { transform:translate3d(10vmax,6vmax,0) scale(1.1); } }
@keyframes ctDriftB { to { transform:translate3d(-12vmax,8vmax,0) scale(1.15); } }
@keyframes ctLive { 0% { box-shadow:0 0 0 0 rgba(76,201,255,.65),0 0 12px rgba(76,201,255,.8); } 70%,100% { box-shadow:0 0 0 9px rgba(76,201,255,0),0 0 12px rgba(76,201,255,.8); } }
@keyframes ctLiveRose { 0% { box-shadow:0 0 0 0 rgba(255,122,138,.7); } 70%,100% { box-shadow:0 0 0 8px rgba(255,122,138,0); } }
@keyframes ctClimbY { from { transform:scaleY(0); } to { transform:scaleY(1); } }
@keyframes ctClimbX { from { transform:scaleX(0); } to { transform:scaleX(1); } }
@keyframes ctText { from { color:var(--dim); } 60% { color:var(--ice); } to { color:inherit; } }
@keyframes ctChip {
  0% { transform:scale(.88); }
  60% { transform:scale(1.1); box-shadow:0 0 0 6px rgba(76,201,255,.14),0 0 24px rgba(76,201,255,.55); border-color:rgba(76,201,255,.8); color:var(--ice); }
  100% { transform:none; }
}
@keyframes ctFoil { 0%,100% { background-position:0% 50%; } 50% { background-position:100% 50%; } }
@keyframes ctSpin { to { --ct-angle:360deg; } }
@keyframes ctShimmer { 0% { transform:translateX(-100%); } 55%,100% { transform:translateX(100%); } }
@keyframes ctPop { from { opacity:0; transform:scale(.8); } to { opacity:1; transform:none; } }
@keyframes ctBump { 40% { transform:translateY(-2px) scale(1.04); color:#d8f7ff; } 100% { transform:none; } }
@keyframes ctSweep {
  0% { opacity:0; background-position:0 0,130% 130%; }
  30% { opacity:.85; }
  100% { opacity:0; background-position:0 0,-30% -30%; }
}

