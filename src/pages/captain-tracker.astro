---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
const t=FOOTBALL_CENTRE_CONTENT.captainTracker;
---
<BaseLayout title="Captain OVR Tracker · Premier League Matchday 7" description="Track the FC Mobile captains chasing a potential 121 OVR card from Premier League Matchday 7.">
<main class="cap-page" data-cap-tracker>
<section class="hero"><div><span class="eyebrow">{t.label}</span><h1>{t.title}</h1><p>{t.subtitle}</p><div class="chips"><b>{t.baseOvr} OVR START</b><b>+5 OVR MAX</b><b>6 CAPTAINS</b></div></div><div class="target"><span>121</span><small>MAX OVR</small></div></section>
<section class="verdict"><div><span class="eyebrow">MY READ</span><h2>Bruno Fernandes has the best 121 route</h2><p>He has the strongest attacking path through the set-piece and 3 G/A conditions. Van Dijk is the safer defensive profile, while Dunk becomes very interesting if his injury clears.</p></div><strong>BRUNO<br/><small>MODEL EDGE</small></strong></section>
<section class="tasks"><div class="head"><div><span class="eyebrow">THE FIVE CHECKPOINTS</span><h2>Every +1 OVR condition</h2></div><small>{t.updatedLabel}</small></div><div class="task-grid">{t.tasks.map((x,i)=><article><em>0{i+1}</em><b>{x.short}</b><span>{x.title}</span></article>)}</div></section>
<section class="tracker"><div class="head"><div><span class="eyebrow">LIVE ANALYSIS</span><h2>Who has the cleanest path?</h2><p>Directional estimates, not EA odds. Admin can update each task as results land.</p></div><div class="legend">🟢 Very high &nbsp; 🔵 High &nbsp; 🟡 Possible &nbsp; ⚪ Low</div></div>
<div class="players">{t.players.map((p,i)=><article class:list={["player",i===1?"featured":""]} data-player={p.id}><div class="player-top"><span class="rank">#{i+1}</span><img src={p.image} alt={p.name+" FC Mobile card"} loading={i<3?"eager":"lazy"}><div><h3>{p.flag} {p.name}</h3><p>{p.club} · {p.fixture}</p><small class="availability">{p.availability}</small></div><div class="ovr"><small>PROJECTED</small><b data-ovr>{p.currentOvr}</b><span>/ 121</span></div></div><div class="rows">{t.tasks.map(task=><div class="row" data-task={task.id}><div><b>{task.short}</b><small>{task.title}</small></div><div class="bar"><i style={"--w:"+(p.probability[task.id]||0)+"%"}></i></div><strong data-chance>{p.probability[task.id]||0}%</strong><em data-status class={p.status[task.id]||"low"}>{(p.status[task.id]||"low").replaceAll("-"," ")}</em></div>)}</div><div class="note"><span>SCOUTING NOTE</span><p>{p.note}</p></div></article>)}</div></section>
<section class="bottom"><div><span>01</span><h2>A good +1 candidate is not automatically a 121 candidate.</h2><p>Defenders can have excellent odds for minutes and a clean sheet, but the set-piece and 3 G/A tasks are still massive hurdles. That is why the tracker scores every condition separately.</p></div><div><span>02</span><h2>It stays useful after kick-off.</h2><p>Once a task is confirmed, the admin can mark it completed and this page recalculates the visible OVR without waiting for a rebuild.</p></div></section>
<p class="disclaimer">Independent FCMOBILETOOLS analysis. Player availability, lineups and outcomes can change. Percentages are directional estimates, not official EA confirmation or betting advice.</p>
</main>
<script is:inline>
(()=>{const root=document.querySelector('[data-cap-tracker]');if(!root)return;const fallback={"enabled":true,"matchday":7,"label":"PREMIER LEAGUE · MATCHDAY 7","title":"Captain OVR Tracker","subtitle":"Five performance tasks stand between each captain and a potential 121 OVR card. Track the route, compare the risk and update each result as the matches are played.","baseOvr":116,"updatedLabel":"Analysis baseline · 8 Oct 2026","tasks":[{"id":"minutes","short":"60+ MIN","title":"Play 60+ minutes without a booking"},{"id":"win","short":"WIN","title":"Club wins the next match"},{"id":"cleanSheet","short":"CS","title":"Keep a clean sheet"},{"id":"setPiece","short":"SET PIECE","title":"Contribute to a set-piece goal"},{"id":"threeContrib","short":"3 G/A","title":"Record 3 goal contributions"}],"players":[{"id":"reece-james","name":"Reece James","club":"Chelsea","flag":"🏴🇬🇧","fixture":"Everton vs Chelsea","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441775/James_256_fc_25_download_1.png","baseOvr":116,"currentOvr":116,"availability":"Monitor","probability":{"minutes":72,"win":44,"cleanSheet":22,"setPiece":12,"threeContrib":3},"status":{"minutes":"high","win":"high","cleanSheet":"low","setPiece":"possible","threeContrib":"very-low"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"292 Premier League minutes from four appearances. The 60-minute route is realistic, but the Chelsea away trip and 3 G/A condition make 121 difficult."},{"id":"bruno-fernandes","name":"Bruno Fernandes","club":"Manchester United","flag":"🇵🇹","fixture":"Leeds United vs Manchester United","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441774/Bruno_Fernandes_256_fc_25_download.png","baseOvr":116,"currentOvr":116,"availability":"Watch fitness","probability":{"minutes":82,"win":30,"cleanSheet":18,"setPiece":25,"threeContrib":15},"status":{"minutes":"high","win":"possible","cleanSheet":"low","setPiece":"high","threeContrib":"possible"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"Best attacking route. Bruno has 3 goals and 1 assist in five Premier League starts, plus a free-kick goal and 23 corners taken. Fitness is the main watch."},{"id":"virgil-van-dijk","name":"Virgil van Dijk","club":"Liverpool","flag":"🇳🇱","fixture":"Brentford vs Liverpool","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441775/van_Dijk_256_fc_25_download.png","baseOvr":116,"currentOvr":116,"availability":"Available","probability":{"minutes":86,"win":38,"cleanSheet":55,"setPiece":18,"threeContrib":2},"status":{"minutes":"very-high","win":"possible","cleanSheet":"very-high","setPiece":"possible","threeContrib":"very-low"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"Safest defensive captain. He has started all five league matches, played every minute and already has three clean sheets. He also scored from a corner for the Netherlands."},{"id":"lewis-dunk","name":"Lewis Dunk","club":"Brighton","flag":"🏴🇬🇧","fixture":"Brighton vs Crystal Palace","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441775/Dunk_256_fc_25_download_1.png","baseOvr":116,"currentOvr":116,"availability":"Doubtful","probability":{"minutes":70,"win":54,"cleanSheet":58,"setPiece":12,"threeContrib":2},"status":{"minutes":"possible","win":"very-high","cleanSheet":"very-high","setPiece":"possible","threeContrib":"very-low"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"Brighton's defensive profile makes the win and clean-sheet tasks attractive, and Dunk already has a league goal. His neck injury is the big problem."},{"id":"john-mcginn","name":"John McGinn","club":"Aston Villa","flag":"🏴🇬🇧","fixture":"Newcastle United vs Aston Villa","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441775/McGinn_256_fc_25_download.png","baseOvr":116,"currentOvr":116,"availability":"Available","probability":{"minutes":74,"win":30,"cleanSheet":20,"setPiece":18,"threeContrib":5},"status":{"minutes":"high","win":"possible","cleanSheet":"low","setPiece":"possible","threeContrib":"low"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"Two league assists and set-piece responsibility give him a better attacking route than his role suggests, but Newcastle away is a rough win and clean-sheet combination."},{"id":"ethan-ampadu","name":"Ethan Ampadu","club":"Leeds United","flag":"🏴🇬🇧","fixture":"Leeds United vs Manchester United","image":"https://res.cloudinary.com/b0qikv7n/image/upload/v1791441774/Ampadu_256_fc_25_download.png","baseOvr":116,"currentOvr":116,"availability":"Available","probability":{"minutes":88,"win":48,"cleanSheet":35,"setPiece":7,"threeContrib":1},"status":{"minutes":"very-high","win":"high","cleanSheet":"possible","setPiece":"low","threeContrib":"very-low"},"completed":{"minutes":false,"win":false,"cleanSheet":false,"setPiece":false,"threeContrib":false},"note":"Excellent 60-minute candidate: he has played every available Premier League minute for Leeds. The set-piece and 3 G/A tasks are the real wall."}]};function render(t){(t.players||[]).forEach(p=>{const card=root.querySelector('[data-player="'+p.id+'"]');if(!card)return;let earned=0;(t.tasks||[]).forEach(task=>{const done=!!p.completed?.[task.id];if(done)earned++;const row=card.querySelector('[data-task="'+task.id+'"]');if(!row)return;const v=Number(p.probability?.[task.id]||0),bar=row.querySelector('.bar i'),chance=row.querySelector('[data-chance]'),pill=row.querySelector('[data-status]');if(bar)bar.style.setProperty('--w',v+'%');if(chance)chance.textContent=v+'%';if(pill){const s=done?'completed':(p.status?.[task.id]||'low');pill.className=s;pill.textContent=s.replaceAll('-',' ')}});const o=card.querySelector('[data-ovr]');if(o)o.textContent=Number(p.baseOvr||t.baseOvr||116)+earned})}fetch('/api/football?captains='+Date.now(),{cache:'no-store'}).then(r=>r.ok?r.json():null).then(x=>render(x?.content?.captainTracker||fallback)).catch(()=>render(fallback))})();
</script>
<style>
.cap-page{width:min(1200px,calc(100% - 28px));margin:auto;padding:42px 0;color:#f5f8fb}.hero{position:relative;display:grid;grid-template-columns:1fr 210px;gap:24px;padding:42px;border:1px solid #4cc9ff33;border-radius:28px;overflow:hidden;background:radial-gradient(600px 300px at 0 0,#4cc9ff22,transparent 70%),linear-gradient(145deg,#102131,#09131d);box-shadow:0 30px 90px #0006;animation:rise .7s both}.eyebrow{color:#7ddcff;font:800 10px Inter,sans-serif;letter-spacing:.16em}.hero h1{margin:10px 0;font:700 clamp(40px,6vw,66px)/.95 "Space Grotesk",Inter,sans-serif;letter-spacing:-.06em}.hero p{max-width:760px;color:#a8bac9;line-height:1.7}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}.chips b{padding:8px 11px;border:1px solid #ffffff12;border-radius:99px;background:#ffffff05;color:#c8d8e4;font:800 9px Inter,sans-serif}.target{display:grid;place-items:center;align-content:center;border:1px solid #4cc9ff2b;border-radius:50%;width:180px;height:180px;justify-self:end;box-shadow:0 0 60px #4cc9ff12,inset 0 0 40px #4cc9ff08;animation:pulse 3s ease-in-out infinite}.target span{font:700 58px/1 "Space Grotesk",Inter,sans-serif}.target small{margin-top:7px;color:#6d8495;font:800 9px Inter,sans-serif;letter-spacing:.15em}.verdict{display:grid;grid-template-columns:1fr 190px;gap:20px;margin-top:14px;padding:21px;border:1px solid #4cc9ff18;border-radius:18px;background:#0d1823}.verdict h2{margin:7px 0 5px;font:700 21px "Space Grotesk",Inter,sans-serif}.verdict p,.bottom p{margin:0;color:#879cac;font-size:12.5px;line-height:1.65}.verdict>strong{display:grid;place-items:center;color:#4cc9ff;font:700 27px/1 "Space Grotesk",Inter,sans-serif;text-align:center;border-left:1px solid #ffffff0d}.verdict>strong small{color:#63798a;font:800 8px Inter,sans-serif;letter-spacing:.15em}.tasks,.tracker{margin-top:30px}.head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:13px}.head h2{margin:7px 0 3px;font:700 24px "Space Grotesk",Inter,sans-serif;letter-spacing:-.03em}.head p{margin:0;color:#718697;font-size:11.5px}.head>small,.legend{color:#6f8494;font:700 9px Inter,sans-serif;letter-spacing:.06em}.task-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.task-grid article{min-height:108px;padding:14px;border:1px solid #ffffff0d;border-radius:15px;background:linear-gradient(145deg,#101c28,#0b151e);animation:rise .6s both}.task-grid em{display:block;color:#4d6475;font:800 9px Inter,sans-serif;font-style:normal}.task-grid b{display:block;margin-top:20px;font:800 12px "Space Grotesk",Inter,sans-serif}.task-grid span{display:block;margin-top:5px;color:#6e8393;font-size:9.5px;line-height:1.4}.players{display:grid;gap:13px}.player{border:1px solid #ffffff0d;border-radius:20px;overflow:hidden;background:linear-gradient(145deg,#0f1a26,#09121a);box-shadow:0 18px 55px #0004;animation:rise .6s both}.player.featured{border-color:#4cc9ff4d;box-shadow:0 22px 70px #0005,0 0 45px #4cc9ff0b}.player-top{display:grid;grid-template-columns:34px 105px minmax(0,1fr) 100px;align-items:center;gap:15px;padding:15px 18px;border-bottom:1px solid #ffffff0c}.player-top img{width:105px;height:116px;object-fit:contain;filter:drop-shadow(0 14px 17px #0008);transition:.25s}.player:hover img{transform:translateY(-3px) scale(1.03)}.rank{width:32px;height:32px;display:grid;place-items:center;border:1px solid #ffffff0c;border-radius:9px;color:#708595;font:800 9px Inter,sans-serif}.player h3{margin:0;font:700 20px "Space Grotesk",Inter,sans-serif}.player-top p{margin:6px 0 7px;color:#8195a5;font-size:11px}.availability{display:inline-block;padding:5px 8px;border-radius:99px;background:#ffffff05;border:1px solid #ffffff0d;color:#93a6b5;font:800 8px Inter,sans-serif;text-transform:uppercase;letter-spacing:.08em}.ovr{text-align:right}.ovr small,.ovr span{display:block;color:#5f7485;font:800 8px Inter,sans-serif}.ovr b{display:inline-block;margin:5px 0 2px;font:700 40px/.9 "Space Grotesk",Inter,sans-serif}.rows{padding:3px 18px}.row{display:grid;grid-template-columns:1.25fr 1fr 38px 85px;gap:12px;align-items:center;min-height:54px;border-top:1px solid #ffffff09}.row>div:first-child b,.row>div:first-child small{display:block}.row>div:first-child b{font:800 10px "Space Grotesk",Inter,sans-serif}.row>div:first-child small{margin-top:4px;color:#667d8d;font-size:9px}.bar{height:5px;background:#08121a;border-radius:99px;overflow:hidden}.bar i{display:block;width:var(--w);height:100%;background:linear-gradient(90deg,#2c9fd1,#4cc9ff);border-radius:inherit;transition:width .5s}.row strong{font:800 9px Inter,sans-serif;color:#a9bdca}.row em{justify-self:end;padding:6px 8px;border-radius:99px;border:1px solid #ffffff0d;background:#0a141d;color:#718697;font:800 7px Inter,sans-serif;text-transform:uppercase;font-style:normal;text-align:center;min-width:70px}.row em.very-high{color:#63dc8d}.row em.high{color:#69d9ff}.row em.possible{color:#ffd36d}.row em.completed{color:#03131c;background:#47d16c;border-color:#47d16c}.note{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:13px 18px;border-top:1px solid #ffffff0c;background:#ffffff02}.note span{color:#567082;font:800 8px Inter,sans-serif;letter-spacing:.14em}.note p{margin:0;color:#8094a4;font-size:10.5px;line-height:1.55}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}.bottom>div{padding:19px;border:1px solid #ffffff0d;border-radius:17px;background:#0d1823}.bottom span{color:#4cc9ff;font:800 9px Inter,sans-serif}.bottom h2{margin:8px 0 5px;font:700 17px "Space Grotesk",Inter,sans-serif}.disclaimer{text-align:center;color:#526879;font-size:9.5px;line-height:1.6;margin:17px 0}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@keyframes pulse{50%{box-shadow:0 0 85px #4cc9ff20,inset 0 0 50px #4cc9ff0d}}@media(max-width:850px){.hero{grid-template-columns:1fr;padding:28px}.target{display:none}.task-grid{grid-template-columns:repeat(3,1fr)}.verdict{grid-template-columns:1fr}.verdict>strong{border-left:0;border-top:1px solid #ffffff0d;padding-top:14px}.bottom{grid-template-columns:1fr}}@media(max-width:650px){.cap-page{width:min(100% - 18px,1200px);padding-top:22px}.hero h1{font-size:42px}.task-grid{grid-template-columns:1fr 1fr}.player-top{grid-template-columns:26px 78px minmax(0,1fr);gap:9px;padding:12px}.player-top img{width:78px;height:94px}.ovr{grid-column:3;grid-row:1}.ovr b{font-size:30px}.player h3{font-size:16px}.rows{padding:2px 12px}.row{grid-template-columns:1fr 72px 32px 68px;gap:7px}.row>div:first-child small{display:none}.row em{min-width:0;padding:5px 3px;font-size:6.5px}.note{grid-template-columns:1fr;gap:6px;padding:12px}.head{align-items:flex-start;flex-direction:column}.legend{line-height:1.7}}@media(prefers-reduced-motion:reduce){.hero,.verdict,.task-grid article,.player{animation:none}.target{animation:none}.bar i{transition:none}}
</style>
</BaseLayout>