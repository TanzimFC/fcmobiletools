---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
import { CAPTAIN_ANALYSIS } from '../data/captainAnalysis.js';

const tracker = FOOTBALL_CENTRE_CONTENT.captainTracker ?? {};
const analysis = CAPTAIN_ANALYSIS;
const tasks = (tracker.tasks?.length ? tracker.tasks : analysis.taskOrder.map((id) => ({
  id,
  short: analysis.tasks[id].short,
  title: analysis.tasks[id].title,
})));
const baseOvr = Number(tracker.baseOvr ?? analysis.baseOvr ?? 116);
const ceiling = Number(analysis.ceiling ?? 121);

const analysisById = analysis.players;
const modelTaskId = (id) => id === 'threeContrib' ? 'contributions' : id;
const taskResult = (player, task) => {
  const value = player.result?.[task.id];
  if (value === 'complete' || value === 'failed' || value === 'pending') return value;
  if (player.completed?.[task.id] === true) return 'complete';
  if (player.failed?.[task.id] === true) return 'failed';
  return 'pending';
};
const resolveAnalysis = (player) => {
  const direct = analysisById[player.id];
  if (direct) return direct;
  const name = String(player.name || player.fullName || '').toLowerCase();
  return Object.values(analysisById).find((entry) =>
    (entry.match || []).some((token) => name.includes(token))
  ) || null;
};

const players = (tracker.players ?? []).map((player, index) => {
  const model = resolveAnalysis(player);
  const probability = tasks.reduce((out, task) => {
    out[task.id] = Number(model?.marginal?.[modelTaskId(task.id)] ?? player.probability?.[task.id] ?? 0);
    return out;
  }, {});
  const result = tasks.reduce((out, task) => {
    out[task.id] = taskResult(player, task);
    return out;
  }, {});
  const confirmed = tasks.filter((task) => result[task.id] === 'complete').length;
  const failedCount = tasks.filter((task) => result[task.id] === 'failed').length;
  const projected = Number(player.baseOvr ?? baseOvr) + confirmed;
  const chance121 = Number(model?.climb?.[4] ?? 0);
  const match = model?.matchId ? analysis.matches[model.matchId] : null;
  return {
    ...player,
    index,
    model,
    probability,
    result,
    confirmed,
    failedCount,
    projected,
    chance121,
    match,
    allDone: confirmed === tasks.length,
  };
});

const trackerMatches = (Array.isArray(tracker.matches) && tracker.matches.length
  ? tracker.matches
  : Object.values(analysis.matches).map((match) => ({
      id: match.id,
      home: match.home,
      away: match.away,
      kickoffUtc: match.kickoff,
      status: 'scheduled',
      score: { home: null, away: null },
      updatedAt: null,
    }))
).map((match) => ({ ...match, analysis: analysis.matches[match.id] || null }));

const matchStatus = (match) => {
  if (match.status === 'final') return 'FINAL';
  if (match.status === 'live') return 'LIVE';
  if (Date.parse(match.kickoffUtc || '') > Date.now()) return 'NOT STARTED';
  return 'AWAITING UPDATE';
};

const ranked = [...players].sort((a, b) => b.chance121 - a.chance121);
const pick = ranked[0] || players.find((p) => p.id === 'bruno-fernandes') || players[0];
const max121 = Math.max(0.5, ...ranked.map((p) => p.chance121));
const maxTask = Math.max(
  1,
  ...players.flatMap((player) => tasks.map((task) => Number(player.probability[task.id] || 0)))
);

const fmt = (value) => {
  const n = Number(value || 0);
  if (n >= 10) return Math.round(n).toString();
  if (n >= 1) return n.toFixed(1);
  if (n <= 0) return '0';
  return n.toFixed(2);
};

const heatTone = (value) => {
  const n = Number(value || 0);
  if (n >= 50) return 'heat-high';
  if (n >= 20) return 'heat-mid';
  if (n >= 5) return 'heat-low';
  return 'heat-rare';
};

const barPoints = (values, width = 220, height = 64) => {
  const max = Math.max(1, ...values);
  const step = width / Math.max(1, values.length - 1);
  return values
    .map((value, i) => `${i * step},${height - (Number(value) / max) * (height - 8) - 4}`)
    .join(' ');
};
---

<BaseLayout
  title="Captain OVR Tracker · Premier League Matchday 7"
  description="Live analysis of the Matchday 7 captains racing from 116 to 121 OVR. Modelled chances, task charts and admin-updated completions."
>
  <main class="ct" data-captain-tracker>
    <section class="ct-hero">
      <div class="ct-orb ct-orb-a"></div>
      <div class="ct-orb ct-orb-b"></div>
      <div class="ct-hero-copy">
        <span class="ct-kicker"><i></i>{tracker.label || 'Premier League · Matchday 7'}</span>
        <h1>Captain OVR Tracker</h1>
        <p>
          Six captains. Five conditions. One 121. Modelled from 6,000,000 match simulations,
          then live-updated when admin confirms each task.
        </p>
        <div class="ct-hero-meta">
          <span>Updated {analysis.updatedLabel}</span>
          <span>Base {baseOvr}</span>
          <span>Ceiling {ceiling}</span>
        </div>
      </div>
      <div class="ct-route" aria-label="OVR route">
        <div>
          <small>START</small>
          <strong>{baseOvr}</strong>
        </div>
        <em>→</em>
        <div>
          <small>CEILING</small>
          <strong class="is-cyan">{ceiling}</strong>
        </div>
      </div>
    </section>

    {pick && (
      <section class="ct-verdict" aria-label="Highest 121 chance">
        <div class="ct-verdict-copy">
          <span>Highest chance of 121</span>
          <h2>{pick.model?.name || pick.fullName || pick.name}</h2>
          <p>{analysis.pick?.why || pick.model?.summary}</p>
        </div>
        <div class="ct-verdict-stat">
          <small>MODELLED 121</small>
          <strong data-count={pick.chance121}>{fmt(pick.chance121)}%</strong>
          <em>~1 in {pick.chance121 > 0 ? Math.round(100 / pick.chance121) : '∞'}</em>
        </div>
      </section>
    )}

    <section class="ct-board" aria-label="121 ranking">
      <header>
        <h2>Who reaches 121?</h2>
        <p>Chance of completing all five tasks in Matchday 7. Only Bruno has a non-zero path.</p>
      </header>
      <ol class="ct-rank">
        {ranked.map((player, rank) => (
          <li class:list={[rank === 0 ? 'is-lead' : '']} style={"--delay:" + rank * 70 + "ms"}>
            <b>#{String(rank + 1).padStart(2, '0')}</b>
            <img src={player.image} alt="" />
            <div>
              <strong>{player.fullName || player.name}</strong>
              <span>{player.club} · {player.fixture}</span>
            </div>
            <div class="ct-rank-bar" aria-hidden="true">
              <i style={"width:" + Math.max(4, (player.chance121 / max121) * 100) + "%"}></i>
            </div>
            <em>{fmt(player.chance121)}%</em>
          </li>
        ))}
      </ol>
    </section>

    <section class="ct-live-results ct-heat" aria-label="Live captain task results">
      <header>
        <div>
          <span class="ct-section-kicker">LIVE RESULT BOARD</span>
          <h2>Every task. Every captain.</h2>
          <p>Only confirmed committee results change the live OVR. A blank cell means no result has been reported.</p>
        </div>
        <div class="ct-result-legend" aria-label="Result legend">
          <span><i class="ct-result-dot is-complete">✓</i> Complete</span>
          <span><i class="ct-result-dot is-failed">×</i> Failed</span>
          <span><i class="ct-result-dot is-pending"></i> Awaiting</span>
        </div>
      </header>
      <div class="ct-heat-table ct-results-table">
        <div class="ct-heat-head">
          <span>Captain</span>
          {tasks.map((task) => <span>{task.short}</span>)}
          <span>LIVE OVR</span>
        </div>
        {players.map((player) => (
          <div class="ct-heat-row" data-player-live={player.id}>
            <span>{player.flag || ''} {player.name}</span>
            {tasks.map((task) => {
              const result = player.result[task.id];
              return (
                <b
                  class:list={['ct-cell', 'ct-result-cell', result === 'complete' ? 'is-done' : '', result === 'failed' ? 'is-miss' : '', result === 'pending' ? 'is-pending' : '']}
                  data-task={task.id}
                  title={task.title}
                  aria-label={result === 'complete' ? 'Complete' : result === 'failed' ? 'Failed' : 'Result not updated'}
                >
                  {result === 'complete' ? '✓' : result === 'failed' ? '×' : ''}
                </b>
              );
            })}
            <em class="ct-live-ovr">{player.projected}</em>
          </div>
        ))}
      </div>
    </section>

    <section class="ct-heat ct-model-board" aria-label="Task probability matrix">
      <header>
        <span class="ct-section-kicker">PRE-MATCH MODEL</span>
        <h2>Probability by task</h2>
        <p>These figures are analysis estimates. They do not count as a result until the committee updates the tracker.</p>
      </header>
      <div class="ct-heat-table">
        <div class="ct-heat-head">
          <span>Captain</span>
          {tasks.map((task) => <span>{task.short}</span>)}
          <span>121</span>
        </div>
        {players.map((player) => (
          <div class="ct-heat-row" data-player-heat={player.id}>
            <span>{player.flag || ''} {player.name}</span>
            {tasks.map((task) => {
              const chance = Number(player.probability[task.id] || 0);
              return (
                <b class:list={['ct-cell', heatTone(chance)]} data-task={task.id} title={task.title}>
                  {fmt(chance)}%
                </b>
              );
            })}
            <em>{fmt(player.chance121)}%</em>
          </div>
        ))}
      </div>
    </section>

    <section class="ct-fixtures" aria-label="Tracked match status">
      {trackerMatches.map((match) => {
        const info = match.analysis;
        const score = match.score || {};
        const hasScore = Number.isFinite(Number(score.home)) && Number.isFinite(Number(score.away));
        return (
          <article data-match-live={match.id}>
            <div class="ct-fixture-top">
              <small>{matchStatus(match)}</small>
              {hasScore && <b>{score.home}–{score.away}</b>}
            </div>
            <strong>{match.home} <span class="ct-vs">vs</span> {match.away}</strong>
            <span>{info?.ukTime || new Date(match.kickoffUtc).toLocaleString()} · {info?.venue || 'Matchday fixture'}</span>
          </article>
        );
      })}
    </section>

    <section class="ct-feed" aria-label="Captain dossiers">
      {players.map((player) => {
        const model = player.model;
        const outcomes = model?.outcomes || [];
        const climb = model?.climb || [];
        const line = barPoints(outcomes.length ? outcomes : [0, 0, 0, 0, 0, 0]);
        return (
          <article
            class:list={['ct-card', player.id === pick?.id ? 'is-featured' : '', player.allDone ? 'is-complete' : '']}
            data-player={player.id}
            style={"--delay:" + player.index * 80 + "ms"}
          >
            <div class="ct-art">
              <div class="ct-glow"></div>
              <img
                src={player.image}
                alt={(player.fullName || player.name) + ' FC Mobile captain card'}
                loading={player.index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="ct-art-tag">
                <small>BASE</small>
                <strong>{player.baseOvr ?? baseOvr}</strong>
              </div>
              {player.allDone && <div class="ct-stamp"><span>✓</span><b>COMPLETE</b></div>}
            </div>

            <div class="ct-body">
              <div class="ct-identity">
                <span>{player.flag} {player.club}</span>
                <h2>{player.fullName || player.name}</h2>
                <p>{player.fixture}</p>
                {model && <em>{model.verdict}</em>}
              </div>
              <div class="ct-ovr" aria-label={'Projected OVR ' + player.projected}>
                <span>PROJECTED</span>
                <strong data-ovr>{player.projected}</strong>
                <i>/ {ceiling}</i>
              </div>

              <div class="ct-charts">
                <figure>
                  <figcaption>Task chances</figcaption>
                  <div class="ct-bars">
                    {tasks.map((task) => {
                      const chance = Number(player.probability[task.id] || 0);
                      const done = Boolean(player.completed[task.id]);
                      return (
                        <div class:list={['ct-bar', done ? 'is-done' : '']} data-task={task.id}>
                          <span>{task.short}</span>
                          <div><i style={"width:" + (done ? 100 : (chance / maxTask) * 100) + "%"}></i></div>
                          <b data-chance>{done ? 'CONFIRMED' : fmt(chance) + '%'}</b>
                        </div>
                      );
                    })}
                  </div>
                </figure>
                <figure>
                  <figcaption>Finish distribution {baseOvr}–{ceiling}</figcaption>
                  <svg viewBox="0 0 220 72" class="ct-spark" aria-hidden="true">
                    <polyline points={line} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
                    {outcomes.map((value, i) => {
                      const x = (i / Math.max(1, outcomes.length - 1)) * 220;
                      const y = 68 - (Number(value) / Math.max(1, ...outcomes)) * 56;
                      return <circle cx={x} cy={y} r="2.4" />;
                    })}
                  </svg>
                  <div class="ct-ovr-scale">
                    {outcomes.map((_, i) => <span>{baseOvr + i}</span>)}
                  </div>
                  <div class="ct-climb">
                    <span>119+ {fmt(climb[2] || 0)}%</span>
                    <span>120+ {fmt(climb[3] || 0)}%</span>
                    <span>121 {fmt(climb[4] || 0)}%</span>
                  </div>
                </figure>
              </div>

              <div class="ct-tasks" aria-label="Captain conditions">
                {tasks.map((task, taskIndex) => {
                  const result = player.result[task.id];
                  const done = result === 'complete';
                  const miss = result === 'failed';
                  const chance = Number(player.probability[task.id] || 0);
                  return (
                    <div class:list={['ct-task', done ? 'is-complete' : '', miss ? 'is-failed' : '']} data-task={task.id}>
                      <div class="ct-task-top">
                        <span>{String(taskIndex + 1).padStart(2, '0')}</span>
                        <strong>{task.short}</strong>
                        <b data-chance>{done ? '✓ CONFIRMED' : miss ? '× FAILED' : fmt(chance) + '%'}</b>
                      </div>
                      <p>{model?.notes?.[modelTaskId(task.id)] || task.title}</p>
                    </div>
                  );
                })}
              </div>

              {model && (
                <details class="ct-analysis">
                  <summary>
                    <span>Read {player.name}'s route</span>
                    <i></i>
                  </summary>
                  <div class="ct-analysis-body">
                    <p>{model.summary}</p>
                    <p class="ct-form">{model.form}</p>
                    <ul>
                      {model.risks.map((risk) => <li>{risk}</li>)}
                    </ul>
                    <p class="ct-upside">{model.upside}</p>
                    <div class="ct-stats">
                      {model.stats.map((row) => (
                        <span><small>{row.k}</small>{row.v}</span>
                      ))}
                    </div>
                  </div>
                </details>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <section class="ct-reads">
      {analysis.reads.map((read) => (
        <article>
          <h3>{read.title}</h3>
          <p>{read.body}</p>
        </article>
      ))}
    </section>

    <footer class="ct-note">
      <div>
        {analysis.method.map((item) => (
          <p><strong>{item.title}.</strong> {item.body}</p>
        ))}
      </div>
      <p>{analysis.caveat} Completed conditions are controlled from the Captain Tracker committee control room.</p>
    </footer>

    <script type="application/json" id="captain-data">{JSON.stringify({
      baseOvr,
      ceiling,
      tasks,
      players: players.map((player) => ({
        id: player.id,
        baseOvr: player.baseOvr ?? baseOvr,
        result: player.result,
        completed: player.completed,
        failed: player.failed,
        probability: player.probability,
        chance121: player.chance121,
      })),
      matches: trackerMatches.map((match) => ({
        id: match.id,
        home: match.home,
        away: match.away,
        kickoffUtc: match.kickoffUtc,
        status: match.status,
        score: match.score || { home: null, away: null },
      })),
    })}</script>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-captain-tracker]');
      if (!root) return;

      let source = { baseOvr: 116, ceiling: 121, tasks: [], players: [], matches: [] };
      try {
        source = JSON.parse(document.getElementById('captain-data')?.textContent || '{}');
      } catch {}

      const tasks = source.tasks || [];
      const fmt = (value) => {
        const n = Number(value || 0);
        if (n >= 10) return String(Math.round(n));
        if (n >= 1) return n.toFixed(1);
        if (n <= 0) return '0';
        return n.toFixed(2);
      };

      const updateMatch = (match) => {
        const row = root.querySelector('[data-match-live="' + match.id + '"]');
        if (!row) return;
        const status = row.querySelector('.ct-fixture-top small');
        const score = row.querySelector('.ct-fixture-top b');
        const statusText = match.status === 'final' ? 'FINAL' : match.status === 'live' ? 'LIVE' : (Date.parse(match.kickoffUtc || '') > Date.now() ? 'NOT STARTED' : 'AWAITING UPDATE');
        if (status) status.textContent = statusText;
        if (score && match.score && Number.isFinite(Number(match.score.home)) && Number.isFinite(Number(match.score.away))) {
          score.textContent = String(match.score.home) + '–' + String(match.score.away);
        }
      };

      const updateCard = (player) => {
        const card = root.querySelector('[data-player="' + player.id + '"]');
        const heat = root.querySelector('[data-player-heat="' + player.id + '"]');
        const live = root.querySelector('[data-player-live="' + player.id + '"]');
        if (!card) return;

        let confirmed = 0;
        tasks.forEach((task) => {
          const value = player.result?.[task.id];
          const complete = value === 'complete' || (value === undefined && player.completed?.[task.id] === true);
          const miss = value === 'failed' || (value === undefined && player.failed?.[task.id] === true);
          const pending = !complete && !miss;
          const chance = Number(player.probability?.[task.id] || 0);
          if (complete) confirmed += 1;

          card.querySelectorAll('[data-task="' + task.id + '"]').forEach((row) => {
            row.classList.toggle('is-complete', complete);
            row.classList.toggle('is-done', complete);
            row.classList.toggle('is-failed', miss);
            const label = row.querySelector('[data-chance]');
            if (label) label.textContent = complete ? '✓ CONFIRMED' : miss ? '× FAILED' : fmt(chance) + '%';
            const fill = row.querySelector('i');
            if (fill && row.classList.contains('ct-bar')) fill.style.width = (complete ? 100 : Math.min(100, chance)) + '%';
          });

          heat?.querySelectorAll('[data-task="' + task.id + '"]').forEach((cell) => {
            cell.textContent = fmt(chance) + '%';
          });

          live?.querySelectorAll('[data-task="' + task.id + '"]').forEach((cell) => {
            cell.classList.toggle('is-done', complete);
            cell.classList.toggle('is-miss', miss);
            cell.classList.toggle('is-pending', pending);
            cell.textContent = complete ? '✓' : miss ? '×' : '';
            cell.setAttribute('aria-label', complete ? 'Complete' : miss ? 'Failed' : 'Result not updated');
          });
        });

        const current = Number(player.baseOvr || source.baseOvr || 116) + confirmed;
        const ovr = card.querySelector('[data-ovr]');
        if (ovr) ovr.textContent = String(current);

        const completeAll = confirmed === tasks.length;
        card.classList.toggle('is-complete', completeAll);

        let stamp = card.querySelector('.ct-stamp');
        const art = card.querySelector('.ct-art');
        if (completeAll && !stamp && art) {
          stamp = document.createElement('div');
          stamp.className = 'ct-stamp';
          stamp.innerHTML = '<span>✓</span><b>COMPLETE</b>';
          art.appendChild(stamp);
        }
        if (!completeAll && stamp) stamp.remove();
      };

      (source.players || []).forEach(updateCard);
      (source.matches || []).forEach(updateMatch);

      const reveal = () => {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, instance) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              instance.unobserve(entry.target);
            });
          }, { threshold: 0.08 });
          root.querySelectorAll('.ct-card, .ct-rank li, .ct-verdict, .ct-heat, .ct-board').forEach((node) => observer.observe(node));
        } else {
          root.querySelectorAll('.ct-card, .ct-rank li, .ct-verdict, .ct-heat, .ct-board').forEach((node) => node.classList.add('is-visible'));
        }
      };
      reveal();

      fetch('/api/football?captains=' + Date.now(), { cache: 'no-store' })
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          const live = payload?.content?.captainTracker;
          if (!live?.players) return;
          live.players?.forEach((player) => {
            const current = (source.players || []).find((item) => item.id === player.id) || player;
            updateCard({
              ...current,
              ...player,
              result: player.result || current.result || {},
              completed: player.completed || {},
              failed: player.failed || {},
            });
          });
          live.matches?.forEach(updateMatch);
        })
        .catch(() => {});
    })();
  </script>

  <style>
    :global(html), :global(body) { background:#071018; }

    .ct-section-kicker {
      display:inline-block;
      margin-bottom:7px;
      color:#70d9ff;
      font:800 10px/1 Inter,sans-serif;
      letter-spacing:.16em;
      text-transform:uppercase;
    }
    .ct-live-results header {
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:18px;
      flex-wrap:wrap;
    }
    .ct-live-results h2 { margin-top:0; }
    .ct-result-legend {
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      color:#718795;
      font:700 10px Inter,sans-serif;
      text-transform:uppercase;
      letter-spacing:.06em;
    }
    .ct-result-legend span { display:inline-flex; align-items:center; gap:6px; }
    .ct-result-dot {
      display:inline-grid;
      place-items:center;
      width:20px;
      height:20px;
      border-radius:50%;
      border:1px solid rgba(255,255,255,.08);
      font:900 12px/1 Inter,sans-serif;
    }
    .ct-result-dot.is-complete { background:rgba(71,209,108,.18); color:#79e795; border-color:rgba(71,209,108,.28); }
    .ct-result-dot.is-failed { background:rgba(255,107,122,.16); color:#ff98a5; border-color:rgba(255,107,122,.26); }
    .ct-result-dot.is-pending { background:rgba(255,255,255,.025); }
    .ct-result-cell { font-size:15px !important; min-width:44px; }
    .ct-result-cell.is-pending { background:rgba(255,255,255,.018); border-color:rgba(255,255,255,.05); color:transparent; }
    .ct-result-cell.is-done { background:rgba(71,209,108,.16); color:#79e795; border-color:rgba(71,209,108,.28); }
    .ct-result-cell.is-miss { background:rgba(255,107,122,.14); color:#ff98a5; border-color:rgba(255,107,122,.25); }
    .ct-live-ovr { color:#dff7ff; font:900 12px/1 Inter,sans-serif; }
    .ct-fixture-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
    .ct-fixture-top b { color:#f4fbff; font:900 13px Inter,sans-serif; }
    .ct-vs { color:#526976; font-size:10px; text-transform:uppercase; margin:0 3px; }
    .ct-model-board { margin-top:16px; }

    .ct {
      --cyan:#4cc9ff;
      --cyan-soft:#b9efff;
      --gold:#f0c36a;
      --success:#47d16c;
      --danger:#ff6b7a;
      --text:#f3f7fb;
      --muted:#8aa0b0;
      width:min(1180px, calc(100% - 32px));
      margin:0 auto;
      padding:22px 0 56px;
      color:var(--text);
      font-family:Inter,system-ui,sans-serif;
    }

    .ct-hero, .ct-verdict, .ct-board, .ct-heat, .ct-card, .ct-reads article, .ct-fixtures article {
      position:relative;
      overflow:hidden;
      border:1px solid rgba(76,201,255,.12);
      border-radius:24px;
      background:
        radial-gradient(520px 180px at 0 0, rgba(76,201,255,.1), transparent 70%),
        linear-gradient(160deg, #101d28, #09141c);
      box-shadow:0 24px 70px rgba(0,0,0,.35), inset 0 1px rgba(255,255,255,.04);
    }

    .ct-hero {
      display:grid;
      grid-template-columns:1.4fr auto;
      gap:24px;
      align-items:center;
      min-height:210px;
      padding:28px 30px;
      animation:ctIn .6s cubic-bezier(.22,1,.36,1) both;
    }
    .ct-orb {
      position:absolute;
      border-radius:50%;
      filter:blur(40px);
      pointer-events:none;
    }
    .ct-orb-a { width:220px; height:220px; right:8%; top:-40px; background:rgba(76,201,255,.16); animation:ctPulse 6s ease-in-out infinite; }
    .ct-orb-b { width:160px; height:160px; right:22%; bottom:-50px; background:rgba(240,195,106,.08); animation:ctPulse 7s ease-in-out infinite reverse; }
    .ct-kicker {
      display:inline-flex; align-items:center; gap:8px;
      color:#79dcff; font:800 11px/1 Inter,sans-serif; letter-spacing:.16em; text-transform:uppercase;
    }
    .ct-kicker i {
      width:7px; height:7px; border-radius:50%; background:var(--cyan);
      box-shadow:0 0 16px rgba(76,201,255,.9); animation:ctBlink 1.8s ease-in-out infinite;
    }
    .ct-hero h1 {
      margin:10px 0 10px;
      font:700 clamp(34px,5vw,58px)/.92 "Space Grotesk",Inter,sans-serif;
      letter-spacing:-.06em;
    }
    .ct-hero p { max-width:62ch; margin:0; color:var(--muted); font:500 15px/1.6 Inter,sans-serif; }
    .ct-hero-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
    .ct-hero-meta span, .ct-art-tag, .ct-stamp, .ct-climb span, .ct-identity em {
      padding:6px 10px; border:1px solid rgba(255,255,255,.08); border-radius:999px;
      background:rgba(255,255,255,.03); color:#9fb3c1; font:700 11px Inter,sans-serif;
    }
    .ct-route {
      z-index:1; display:flex; align-items:center; gap:14px;
      padding:16px 18px; border:1px solid rgba(255,255,255,.08); border-radius:18px;
      background:rgba(5,12,18,.45); backdrop-filter:blur(10px);
    }
    .ct-route small { display:block; color:#6d8493; font:800 10px Inter,sans-serif; letter-spacing:.14em; }
    .ct-route strong { font:700 42px/1 "Space Grotesk",Inter,sans-serif; }
    .ct-route .is-cyan { color:var(--cyan-soft); text-shadow:0 0 24px rgba(76,201,255,.25); }
    .ct-route em { color:#56707f; font-style:normal; }

    .ct-verdict, .ct-board, .ct-heat, .ct-card {
      opacity:0; transform:translateY(18px);
      transition:opacity .6s ease, transform .6s cubic-bezier(.22,1,.36,1);
    }
    .ct-verdict.is-visible, .ct-board.is-visible, .ct-heat.is-visible, .ct-card.is-visible,
    .ct-rank li.is-visible { opacity:1; transform:none; }

    .ct-verdict {
      display:grid; grid-template-columns:1fr auto; gap:20px; align-items:center;
      margin-top:16px; padding:22px 26px;
      border-color:rgba(240,195,106,.28);
      background:
        radial-gradient(420px 160px at 100% 0, rgba(240,195,106,.14), transparent 70%),
        linear-gradient(160deg, #16150f, #0c141c);
    }
    .ct-verdict span { color:var(--gold); font:800 11px Inter,sans-serif; letter-spacing:.16em; text-transform:uppercase; }
    .ct-verdict h2 { margin:8px 0 8px; font:700 clamp(28px,4vw,44px)/1 "Space Grotesk",Inter,sans-serif; letter-spacing:-.05em; }
    .ct-verdict p { margin:0; max-width:70ch; color:#c9d5de; font:500 15px/1.65 Inter,sans-serif; }
    .ct-verdict-stat { text-align:right; }
    .ct-verdict-stat small { color:#b79a5a; font:800 10px Inter,sans-serif; letter-spacing:.12em; }
    .ct-verdict-stat strong { display:block; color:var(--gold); font:700 64px/.85 "Space Grotesk",Inter,sans-serif; }
    .ct-verdict-stat em { color:#9a8558; font-style:normal; }

    .ct-board, .ct-heat { margin-top:16px; padding:22px 24px 18px; }
    .ct-board header, .ct-heat header { margin-bottom:16px; }
    .ct-board h2, .ct-heat h2, .ct-reads h3 {
      margin:0 0 6px; font:700 22px/1.1 "Space Grotesk",Inter,sans-serif; letter-spacing:-.04em;
    }
    .ct-board p, .ct-heat p { margin:0; color:var(--muted); font:500 13px/1.5 Inter,sans-serif; }

    .ct-rank { list-style:none; margin:0; padding:0; display:grid; gap:8px; }
    .ct-rank li {
      display:grid; grid-template-columns:42px 42px minmax(0,180px) minmax(80px,1fr) 72px;
      align-items:center; gap:12px; padding:10px 12px; border-radius:14px;
      background:rgba(255,255,255,.025); border:1px solid rgba(255,255,255,.05);
      opacity:0; transform:translateY(10px); transition:opacity .5s ease, transform .5s ease;
    }
    .ct-rank li.is-lead { border-color:rgba(240,195,106,.28); background:rgba(240,195,106,.06); }
    .ct-rank img { width:42px; height:54px; object-fit:contain; filter:drop-shadow(0 8px 10px rgba(0,0,0,.4)); }
    .ct-rank b { color:#6d8493; font:800 12px Inter,sans-serif; }
    .ct-rank strong { display:block; font:700 14px/1.2 Inter,sans-serif; }
    .ct-rank span { color:#7e94a3; font:500 11px/1.3 Inter,sans-serif; }
    .ct-rank em { text-align:right; color:var(--cyan-soft); font:800 16px "Space Grotesk",Inter,sans-serif; font-style:normal; }
    .ct-rank-bar { height:6px; border-radius:99px; background:#071018; overflow:hidden; }
    .ct-rank-bar i { display:block; height:100%; background:linear-gradient(90deg,#8a6a2a,var(--gold)); animation:ctFill .9s cubic-bezier(.22,1,.36,1) both; }

    .ct-heat-table { display:grid; gap:6px; overflow-x:auto; }
    .ct-heat-head, .ct-heat-row {
      display:grid; grid-template-columns:140px repeat(5, minmax(92px,1fr)) 70px;
      gap:6px; align-items:center; min-width:760px;
    }
    .ct-heat-head span { color:#6d8493; font:800 10px Inter,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
    .ct-heat-row span { font:700 13px Inter,sans-serif; }
    .ct-heat-row em { text-align:right; color:var(--gold); font:800 13px "Space Grotesk",Inter,sans-serif; font-style:normal; }
    .ct-cell {
      display:grid; place-items:center; min-height:38px; border-radius:10px;
      font:800 11px Inter,sans-serif; border:1px solid transparent;
    }
    .heat-high { background:rgba(71,209,108,.18); color:#8cf0a8; }
    .heat-mid { background:rgba(76,201,255,.16); color:#b9efff; }
    .heat-low { background:rgba(240,195,106,.12); color:#f0c36a; }
    .heat-rare { background:rgba(255,107,122,.1); color:#ff9aa5; }
    .ct-cell.is-done { background:rgba(71,209,108,.28); color:#8cf0a8; }
    .ct-cell.is-miss { background:rgba(255,107,122,.22); color:#ffb4bc; }

    .ct-fixtures {
      display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; margin-top:16px;
    }
    .ct-fixtures article { padding:14px 14px 12px; }
    .ct-fixtures small { color:#73d9ff; font:800 10px Inter,sans-serif; letter-spacing:.08em; }
    .ct-fixtures strong { display:block; margin:8px 0 6px; font:700 12px/1.4 Inter,sans-serif; }
    .ct-fixtures span { color:#7b919f; font:500 11px Inter,sans-serif; }

    .ct-feed { display:grid; gap:18px; margin-top:18px; }
    .ct-card {
      display:grid; grid-template-columns:minmax(240px,320px) minmax(0,1fr);
      transition:border-color .25s ease, box-shadow .25s ease, transform .35s ease;
    }
    .ct-card.is-visible { transition-delay:var(--delay); }
    .ct-card:hover { transform:translateY(-4px); border-color:rgba(76,201,255,.28); box-shadow:0 28px 80px rgba(0,0,0,.42); }
    .ct-card.is-featured { border-color:rgba(240,195,106,.3); }
    .ct-card.is-complete { border-color:rgba(71,209,108,.32); }

    .ct-art {
      position:relative; display:grid; place-items:center; min-height:420px; padding:24px 12px 18px;
      background:
        radial-gradient(circle at 50% 28%, rgba(76,201,255,.16), transparent 52%),
        linear-gradient(180deg,#12202c,#09131b);
    }
    .ct-glow {
      position:absolute; width:260px; height:260px; border-radius:50%;
      background:rgba(76,201,255,.16); filter:blur(50px); animation:ctPulse 5s ease-in-out infinite;
    }
    .ct-art img {
      position:relative; z-index:1; width:min(92%, 340px); height:auto;
      filter:drop-shadow(0 28px 30px rgba(0,0,0,.7));
      transform:translateY(4px) scale(1.04);
      transition:transform .45s cubic-bezier(.22,1,.36,1);
    }
    .ct-card:hover .ct-art img { transform:translateY(-8px) scale(1.08); }
    .ct-art-tag, .ct-stamp { position:absolute; z-index:2; bottom:16px; display:grid; gap:2px; border-radius:10px; backdrop-filter:blur(8px); }
    .ct-art-tag { left:14px; }
    .ct-art-tag small, .ct-stamp b { font:800 9px Inter,sans-serif; letter-spacing:.1em; }
    .ct-art-tag strong { font:700 20px "Space Grotesk",Inter,sans-serif; }
    .ct-stamp { right:14px; display:flex; align-items:center; gap:6px; color:var(--success); border-color:rgba(71,209,108,.3); animation:ctPop .35s ease both; }

    .ct-body { padding:22px 22px 16px; }
    .ct-identity { padding-right:110px; position:relative; }
    .ct-identity span { color:#7d93a2; font:800 11px Inter,sans-serif; letter-spacing:.12em; text-transform:uppercase; }
    .ct-identity h2 { margin:6px 0 4px; font:700 clamp(26px,3vw,36px)/.95 "Space Grotesk",Inter,sans-serif; letter-spacing:-.05em; }
    .ct-identity p { margin:0 0 8px; color:#8aa0b0; font:500 13px Inter,sans-serif; }
    .ct-identity em { display:inline-block; color:var(--gold); font-style:normal; }
    .ct-ovr { position:absolute; top:0; right:0; text-align:right; }
    .ct-ovr span { display:block; color:#6d8493; font:800 10px Inter,sans-serif; letter-spacing:.12em; }
    .ct-ovr strong { font:700 52px/.8 "Space Grotesk",Inter,sans-serif; }
    .ct-ovr i { color:#6d8493; font-style:normal; }
    .ct-card.is-complete .ct-ovr strong { color:var(--success); }

    .ct-charts { display:grid; grid-template-columns:1.15fr .85fr; gap:14px; margin-top:18px; }
    .ct-charts figure { margin:0; padding:12px; border:1px solid rgba(255,255,255,.06); border-radius:14px; background:rgba(255,255,255,.02); }
    .ct-charts figcaption { margin-bottom:10px; color:#8aa0b0; font:800 10px Inter,sans-serif; letter-spacing:.12em; text-transform:uppercase; }
    .ct-bars { display:grid; gap:8px; }
    .ct-bar { display:grid; grid-template-columns:118px minmax(0,1fr) 72px; gap:8px; align-items:center; }
    .ct-bar span { color:#c5d4de; font:700 11px Inter,sans-serif; }
    .ct-bar b { text-align:right; color:#9fb3c1; font:800 11px Inter,sans-serif; }
    .ct-bar div { height:6px; border-radius:99px; background:#071018; overflow:hidden; }
    .ct-bar i { display:block; height:100%; width:0; background:linear-gradient(90deg,#267da4,var(--cyan)); animation:ctFill .8s cubic-bezier(.22,1,.36,1) both; }
    .ct-bar.is-done i, .ct-bar.is-complete i { background:linear-gradient(90deg,#2aa650,var(--success)); }
    .ct-spark { width:100%; height:72px; color:var(--cyan); }
    .ct-ovr-scale, .ct-climb { display:flex; justify-content:space-between; gap:6px; margin-top:6px; color:#6d8493; font:700 10px Inter,sans-serif; }

    .ct-tasks { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; margin-top:14px; }
    .ct-task {
      min-height:118px; padding:12px; border:1px solid rgba(255,255,255,.06); border-radius:14px;
      background:rgba(255,255,255,.02); transition:transform .2s ease, border-color .2s ease;
    }
    .ct-task:hover { transform:translateY(-2px); border-color:rgba(76,201,255,.2); }
    .ct-task.is-complete { border-color:rgba(71,209,108,.28); background:rgba(71,209,108,.05); }
    .ct-task.is-failed { border-color:rgba(255,107,122,.28); }
    .ct-task-top { display:flex; justify-content:space-between; gap:6px; align-items:center; }
    .ct-task-top span { color:#56707f; font:800 10px Inter,sans-serif; }
    .ct-task-top strong { color:#e8eef2; font:800 12px "Space Grotesk",Inter,sans-serif; }
    .ct-task-top b { color:#8aa0b0; font:800 10px Inter,sans-serif; }
    .ct-task.is-complete .ct-task-top b { color:var(--success); }
    .ct-task p { margin:8px 0 0; color:#7e94a3; font:500 11px/1.45 Inter,sans-serif; }

    .ct-analysis { margin-top:12px; border-top:1px solid rgba(255,255,255,.06); }
    .ct-analysis summary {
      display:flex; justify-content:space-between; align-items:center; padding:12px 0;
      cursor:pointer; list-style:none; color:#9fb3c1; font:800 12px Inter,sans-serif; letter-spacing:.04em;
    }
    .ct-analysis summary::-webkit-details-marker { display:none; }
    .ct-analysis summary i { width:18px; height:18px; border:1px solid rgba(255,255,255,.1); border-radius:6px; position:relative; }
    .ct-analysis summary i::before, .ct-analysis summary i::after {
      content:""; position:absolute; left:50%; top:50%; width:8px; height:1px; background:currentColor; transform:translate(-50%,-50%);
    }
    .ct-analysis summary i::after { transform:translate(-50%,-50%) rotate(90deg); }
    .ct-analysis[open] summary i::after { transform:translate(-50%,-50%) rotate(0); }
    .ct-analysis-body { animation:ctIn .3s ease both; }
    .ct-analysis-body p { color:#93a8b6; font:500 13px/1.65 Inter,sans-serif; }
    .ct-analysis-body ul { margin:0; padding-left:18px; color:#93a8b6; }
    .ct-upside { color:#d7e7b8 !important; }
    .ct-stats { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:12px 0 8px; }
    .ct-stats span { padding:8px 10px; border:1px solid rgba(255,255,255,.06); border-radius:10px; font:600 12px Inter,sans-serif; }
    .ct-stats small { display:block; color:#6d8493; font:800 9px Inter,sans-serif; letter-spacing:.08em; }

    .ct-reads { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:18px; }
    .ct-reads article { padding:18px; }
    .ct-reads p { margin:0; color:#93a8b6; font:500 13px/1.6 Inter,sans-serif; }

    .ct-note { margin-top:18px; color:#6d8493; font:500 12px/1.6 Inter,sans-serif; }
    .ct-note strong { color:#9fb3c1; }

    @keyframes ctIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
    @keyframes ctPulse { 50% { transform:scale(1.08); opacity:.75; } }
    @keyframes ctBlink { 50% { transform:scale(1.25); box-shadow:0 0 22px rgba(76,201,255,.95); } }
    @keyframes ctFill { from { transform:scaleX(0); transform-origin:left; } to { transform:scaleX(1); } }
    @keyframes ctPop { from { opacity:0; transform:scale(.86); } to { opacity:1; transform:none; } }

    @media (max-width:1080px) {
      .ct-hero, .ct-verdict, .ct-card, .ct-charts { grid-template-columns:1fr; }
      .ct-fixtures, .ct-reads { grid-template-columns:1fr 1fr; }
      .ct-tasks { grid-template-columns:1fr 1fr; }
      .ct-identity { padding-right:0; }
      .ct-ovr { position:static; text-align:left; margin-top:10px; }
      .ct-art { min-height:360px; }
    }
    @media (max-width:720px) {
      .ct { width:min(100% - 16px, 1180px); padding-top:14px; }
      .ct-hero { padding:18px 16px; }
      .ct-hero h1 { font-size:32px; }
      .ct-rank li { grid-template-columns:32px 36px minmax(0,1fr) 58px; }
      .ct-rank-bar { display:none; }
      .ct-fixtures, .ct-reads, .ct-tasks, .ct-stats { grid-template-columns:1fr; }
      .ct-bar { grid-template-columns:1fr auto; }
      .ct-bar div { grid-column:1 / -1; }
    }
    @media (prefers-reduced-motion:reduce) {
      .ct-hero, .ct-orb, .ct-kicker i, .ct-glow, .ct-bar i, .ct-rank-bar i, .ct-stamp { animation:none !important; }
      .ct-verdict, .ct-board, .ct-heat, .ct-card, .ct-rank li { opacity:1; transform:none; }
      .ct-card:hover, .ct-art img { transform:none !important; }
    }
  </style>
</BaseLayout>
