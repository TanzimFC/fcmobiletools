---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
import { CAPTAIN_ANALYSIS } from '../data/captainAnalysis.js';
import AccountGateModal from '../components/AccountGateModal.astro';

const tracker = FOOTBALL_CENTRE_CONTENT.captainTracker ?? {};
const analysis = CAPTAIN_ANALYSIS;
const tasks = (tracker.tasks?.length ? tracker.tasks : analysis.taskOrder.map((id) => ({
  id,
  short: analysis.tasks[id].short,
  title: analysis.tasks[id].title,
})));
const baseOvr = Number(tracker.baseOvr ?? analysis.baseOvr ?? 116);
const ceiling = Number(analysis.ceiling ?? 121);

const analysisById = analysis.players;
const modelTaskId = (id) => id === 'threeContrib' ? 'contributions' : id;
const taskResult = (player, task) => {
  const value = player.result?.[task.id];
  if (value === 'complete' || value === 'failed' || value === 'pending') return value;
  if (player.completed?.[task.id] === true) return 'complete';
  if (player.failed?.[task.id] === true) return 'failed';
  return 'pending';
};
const resolveAnalysis = (player) => {
  const direct = analysisById[player.id];
  if (direct) return direct;
  const name = String(player.name || player.fullName || '').toLowerCase();
  return Object.values(analysisById).find((entry) =>
    (entry.match || []).some((token) => name.includes(token))
  ) || null;
};

const players = (tracker.players ?? []).map((player, index) => {
  const model = resolveAnalysis(player);
  const probability = tasks.reduce((out, task) => {
    out[task.id] = Number(model?.marginal?.[modelTaskId(task.id)] ?? player.probability?.[task.id] ?? 0);
    return out;
  }, {});
  const result = tasks.reduce((out, task) => {
    out[task.id] = taskResult(player, task);
    return out;
  }, {});
  const confirmed = tasks.filter((task) => result[task.id] === 'complete').length;
  const failedCount = tasks.filter((task) => result[task.id] === 'failed').length;
  const projected = Number(player.baseOvr ?? baseOvr) + confirmed;
  const chance121 = Number(model?.climb?.[4] ?? 0);
  const match = model?.matchId ? analysis.matches[model.matchId] : null;
  return {
    ...player,
    index,
    model,
    probability,
    result,
    confirmed,
    failedCount,
    projected,
    chance121,
    match,
    allDone: confirmed === tasks.length,
  };
});

const trackerMatches = (Array.isArray(tracker.matches) && tracker.matches.length
  ? tracker.matches
  : Object.values(analysis.matches).map((match) => ({
      id: match.id,
      home: match.home,
      away: match.away,
      kickoffUtc: match.kickoff,
      status: 'scheduled',
      score: { home: null, away: null },
      updatedAt: null,
    }))
).map((match) => ({ ...match, analysis: analysis.matches[match.id] || null }));

const matchStatus = (match) => {
  if (match.status === 'final') return 'FINAL';
  if (match.status === 'live') return 'LIVE';
  if (Date.parse(match.kickoffUtc || '') > Date.now()) return 'NOT STARTED';
  return 'RESULT PENDING';
};

const ranked = [...players].sort((a, b) => b.chance121 - a.chance121);
const pick = ranked[0] || players.find((p) => p.id === 'bruno-fernandes') || players[0];
const max121 = Math.max(0.5, ...ranked.map((p) => p.chance121));
const maxTask = Math.max(
  1,
  ...players.flatMap((player) => tasks.map((task) => Number(player.probability[task.id] || 0)))
);

const fmt = (value) => {
  const n = Number(value || 0);
  if (n >= 10) return Math.round(n).toString();
  if (n >= 1) return n.toFixed(1);
  if (n <= 0) return '0';
  return n.toFixed(2);
};

const heatTone = (value) => {
  const n = Number(value || 0);
  if (n >= 50) return 'heat-high';
  if (n >= 20) return 'heat-mid';
  if (n >= 5) return 'heat-low';
  return 'heat-rare';
};

const barPoints = (values, width = 220, height = 64) => {
  const max = Math.max(1, ...values);
  const step = width / Math.max(1, values.length - 1);
  return values
    .map((value, i) => `${i * step},${height - (Number(value) / max) * (height - 8) - 4}`)
    .join(' ');
};
---

<BaseLayout
  title="Captain OVR Tracker · Premier League Matchday 7"
  description="Live Matchday 7 analysis for six Premier League captain candidates, with task results, fixture updates and community captain picks."
>
  <main class="ct" data-captain-tracker>
    <section class="ct-hero">
      <div class="ct-orb ct-orb-a"></div>
      <div class="ct-orb ct-orb-b"></div>
      <div class="ct-hero-copy">
        <span class="ct-kicker"><i></i>{tracker.label || 'Premier League · Matchday 7'}</span>
        <h1>Captain OVR Tracker</h1>
        <p>
          Six captains. Five conditions. One 121. Modelled from 7,000,000 match simulations,
          then updated throughout Matchday 7 as the fixtures are played.
        </p>
        <div class="ct-hero-meta">
          <span>Updated {analysis.updatedLabel}</span>
          <span>Live task results</span>
          <span>Community captain picks</span>
        </div>
      </div>
    </section>

    <section class="ct-votes" aria-label="Community captain picks including estimated cross-platform support">
      <header class="ct-vote-head">
        <div>
          <span class="ct-section-kicker">COMMUNITY SUPPORT</span>
          <h2>Who are you backing?</h2>
          <p>Pick one of the six captains. You can change your choice until the first fixture begins. The tally includes 757 estimated cross-platform support points based on a cross-platform estimate; it is not a verified voter count.</p>
        </div>
        <div class="ct-vote-total">
          <strong data-vote-total>—</strong>
          <span>combined support</span>
        </div>
      </header>

      <div class="ct-vote-grid">
        {players.map((player, voteIndex) => (
          <button
            class="ct-vote-tile"
            type="button"
            data-vote-player={player.id}
            aria-pressed="false"
            style={"--vote-delay:" + voteIndex * 60 + "ms"}
          >
            <span class="ct-vote-number">{String(voteIndex + 1).padStart(2, '0')}</span>
            <img src={player.image} alt="" loading="lazy" decoding="async" />
            <span class="ct-vote-info">
              <strong>{player.fullName || player.name}</strong>
              <span class="ct-vote-count-row">
                <span data-vote-count>Loading combined support…</span>
                <em data-vote-share>—%</em>
              </span>
              <i
                class="ct-vote-track"
                role="progressbar"
                aria-label={"Vote share for " + (player.fullName || player.name)}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              ><b data-vote-fill style="width:0%"></b></i>
            </span>
            <span class="ct-vote-selected" data-vote-selected hidden>Your pick</span>
          </button>
        ))}
      </div>

      <div class="ct-vote-foot">
        <p class="ct-vote-status" data-vote-status aria-live="polite">
          Sign in to save your pick.
        </p>
        <span class="ct-vote-lock" data-vote-lock>Pick window open</span>
      </div>
    </section>

    {pick && (
      <section class="ct-verdict" aria-label="Highest 121 chance">
        <div class="ct-verdict-copy">
          <span>Highest chance of 121</span>
          <h2>{pick.model?.name || pick.fullName || pick.name}</h2>
          <p>{analysis.pick?.why || pick.model?.summary}</p>
        </div>
        <div class="ct-verdict-stat">
          <small>MODELLED 121</small>
          <strong data-count={pick.chance121}>{fmt(pick.chance121)}%</strong>
          <em>~1 in {pick.chance121 > 0 ? Math.round(100 / pick.chance121) : '∞'}</em>
        </div>
      </section>
    )}

    <section class="ct-board" aria-label="121 ranking">
      <header>
        <h2>Who reaches 121?</h2>
        <p>Chance of completing all five tasks in Matchday 7. Only Bruno has a non-zero path.</p>
      </header>
      <ol class="ct-rank">
        {ranked.map((player, rank) => (
          <li class:list={[rank === 0 ? 'is-lead' : '']} style={"--delay:" + rank * 70 + "ms"}>
            <b>#{String(rank + 1).padStart(2, '0')}</b>
            <img src={player.image} alt="" />
            <div>
              <strong>{player.fullName || player.name}</strong>
              <span>{player.club} · {player.fixture}</span>
            </div>
            <div class="ct-rank-bar" aria-hidden="true">
              <i style={"width:" + Math.max(4, (player.chance121 / max121) * 100) + "%"}></i>
            </div>
            <em>{fmt(player.chance121)}%</em>
          </li>
        ))}
      </ol>
    </section>

    <section class="ct-live-results ct-heat" aria-label="Live captain task results">
      <header>
        <div>
          <span class="ct-section-kicker">MATCHDAY RESULTS</span>
          <h2>Every task. Every captain.</h2>
          <p>Results are updated as the Matchday fixtures are played. A blank cell means the outcome is not available yet.</p>
        </div>
        <div class="ct-result-legend" aria-label="Result legend">
          <span><i class="ct-result-dot is-complete">✓</i> Complete</span>
          <span><i class="ct-result-dot is-failed">×</i> Failed</span>
          <span><i class="ct-result-dot is-pending"></i> Pending</span>
        </div>
      </header>
      <div class="ct-heat-table ct-results-table">
        <div class="ct-heat-head">
          <span>Captain</span>
          {tasks.map((task) => <span>{task.short}</span>)}
        </div>
        {players.map((player) => (
          <div class="ct-heat-row" data-player-live={player.id}>
            <span>{player.flag || ''} {player.name}</span>
            {tasks.map((task) => {
              const result = player.result[task.id];
              return (
                <b
                  class:list={['ct-cell', 'ct-result-cell', result === 'complete' ? 'is-done' : '', result === 'failed' ? 'is-miss' : '', result === 'pending' ? 'is-pending' : '']}
                  data-task={task.id}
                  title={task.title}
                  aria-label={result === 'complete' ? 'Complete' : result === 'failed' ? 'Failed' : 'Result not updated'}
                >
                  {result === 'complete' ? '✓' : result === 'failed' ? '×' : ''}
                </b>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <section class="ct-heat ct-model-board" aria-label="Task probability matrix">
      <header>
        <span class="ct-section-kicker">PRE-MATCH OUTLOOK</span>
        <h2>Chance by task</h2>
        <p>These percentages are pre-match estimates based on the fixture, form and available player data. The actual result comes from what happens on the pitch.</p>
      </header>
      <div class="ct-heat-table">
        <div class="ct-heat-head">
          <span>Captain</span>
          {tasks.map((task) => <span>{task.short}</span>)}
          <span>121</span>
        </div>
        {players.map((player) => (
          <div class="ct-heat-row" data-player-heat={player.id}>
            <span>{player.flag || ''} {player.name}</span>
            {tasks.map((task) => {
              const chance = Number(player.probability[task.id] || 0);
              return (
                <b class:list={['ct-cell', heatTone(chance)]} data-task={task.id} title={task.title}>
                  {fmt(chance)}%
                </b>
              );
            })}
            <em>{fmt(player.chance121)}%</em>
          </div>
        ))}
      </div>
    </section>

    <section class="ct-fixtures" aria-label="Tracked match status">
      {trackerMatches.map((match) => {
        const info = match.analysis;
        const score = match.score || {};
        const hasScore = Number.isFinite(Number(score.home)) && Number.isFinite(Number(score.away));
        return (
          <article data-match-live={match.id}>
            <div class="ct-fixture-top">
              <small>{matchStatus(match)}</small>
              {hasScore && <b>{score.home}–{score.away}</b>}
            </div>
            <strong>{match.home} <span class="ct-vs">vs</span> {match.away}</strong>
            <span>{info?.ukTime || new Date(match.kickoffUtc).toLocaleString()} · {info?.venue || 'Matchday fixture'}</span>
          </article>
        );
      })}
    </section>

    <section class="ct-feed" aria-label="Captain dossiers">
      {players.map((player) => {
        const model = player.model;
        const outcomes = model?.outcomes || [];
        const climb = model?.climb || [];
        const line = barPoints(outcomes.length ? outcomes : [0, 0, 0, 0, 0, 0]);
        return (
          <article
            class:list={['ct-card', player.id === pick?.id ? 'is-featured' : '', player.allDone ? 'is-complete' : '']}
            data-player={player.id}
            style={"--delay:" + player.index * 80 + "ms"}
          >
            <div class="ct-art">
              <div class="ct-glow"></div>
              <img
                src={player.image}
                alt={(player.fullName || player.name) + ' FC Mobile captain card'}
                loading={player.index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {player.allDone && <div class="ct-stamp"><span>✓</span><b>COMPLETE</b></div>}
            </div>

            <div class="ct-body">
              <div class="ct-identity">
                <span>{player.flag} {player.club}</span>
                <h2>{player.fullName || player.name}</h2>
                <p>{player.fixture}</p>
                {model && <em>{model.verdict}</em>}
                <button
                  class="ct-pick-button"
                  type="button"
                  data-vote-player={player.id}
                  aria-pressed="false"
                >
                  <span class="ct-pick-button-icon">+</span>
                  <span data-pick-label>Pick as captain</span>
                  <b data-pick-count>—</b>
                </button>
              </div>

              <div class="ct-charts">
                <figure>
                  <figcaption>Task chances</figcaption>
                  <div class="ct-bars">
                    {tasks.map((task) => {
                      const chance = Number(player.probability[task.id] || 0);
                      const done = Boolean(player.completed[task.id]);
                      return (
                        <div class:list={['ct-bar', done ? 'is-done' : '']} data-task={task.id}>
                          <span>{task.short}</span>
                          <div><i style={"width:" + (done ? 100 : (chance / maxTask) * 100) + "%"}></i></div>
                          <b data-chance>{done ? 'CONFIRMED' : fmt(chance) + '%'}</b>
                        </div>
                      );
                    })}
                  </div>
                </figure>
              </div>

              <div class="ct-tasks" aria-label="Captain conditions">
                {tasks.map((task, taskIndex) => {
                  const result = player.result[task.id];
                  const done = result === 'complete';
                  const miss = result === 'failed';
                  const chance = Number(player.probability[task.id] || 0);
                  return (
                    <div class:list={['ct-task', done ? 'is-complete' : '', miss ? 'is-failed' : '']} data-task={task.id}>
                      <div class="ct-task-top">
                        <span>{String(taskIndex + 1).padStart(2, '0')}</span>
                        <strong>{task.short}</strong>
                        <b data-chance>{done ? '✓ COMPLETE' : miss ? '× FAILED' : fmt(chance) + '%'}</b>
                      </div>
                      <p>{model?.notes?.[modelTaskId(task.id)] || task.title}</p>
                    </div>
                  );
                })}
              </div>

              {model && (
                <details class="ct-analysis">
                  <summary>
                    <span>Read {player.name}'s route</span>
                    <i></i>
                  </summary>
                  <div class="ct-analysis-body">
                    <p>{model.summary}</p>
                    <p class="ct-form">{model.form}</p>
                    <ul>
                      {model.risks.map((risk) => <li>{risk}</li>)}
                    </ul>
                    <p class="ct-upside">{model.upside}</p>
                    <div class="ct-stats">
                      {model.stats.map((row) => (
                        <span><small>{row.k}</small>{row.v}</span>
                      ))}
                    </div>
                  </div>
                </details>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <section class="ct-reads">
      {analysis.reads.map((read) => (
        <article>
          <h3>{read.title}</h3>
          <p>{read.body}</p>
        </article>
      ))}
    </section>

    <footer class="ct-note">
      <div>
        {analysis.method.map((item) => (
          <p><strong>{item.title}.</strong> {item.body}</p>
        ))}
      </div>
      <p>{analysis.caveat}</p>
    </footer>

    <script type="application/json" id="captain-data">{JSON.stringify({
      baseOvr,
      ceiling,
      tasks,
      players: players.map((player) => ({
        id: player.id,
        baseOvr: player.baseOvr ?? baseOvr,
        result: player.result,
        completed: player.completed,
        failed: player.failed,
        probability: player.probability,
        chance121: player.chance121,
      })),
      matches: trackerMatches.map((match) => ({
        id: match.id,
        home: match.home,
        away: match.away,
        kickoffUtc: match.kickoffUtc,
        status: match.status,
        score: match.score || { home: null, away: null },
      })),
    })}</script>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-captain-tracker]');
      if (!root) return;

      let source = { baseOvr: 116, ceiling: 121, tasks: [], players: [], matches: [] };
      try {
        source = JSON.parse(document.getElementById('captain-data')?.textContent || '{}');
      } catch {}

      const tasks = source.tasks || [];
      const fmt = (value) => {
        const n = Number(value || 0);
        if (n >= 10) return String(Math.round(n));
        if (n >= 1) return n.toFixed(1);
        if (n <= 0) return '0';
        return n.toFixed(2);
      };

      const updateMatch = (match) => {
        const row = root.querySelector('[data-match-live="' + match.id + '"]');
        if (!row) return;
        const status = row.querySelector('.ct-fixture-top small');
        const score = row.querySelector('.ct-fixture-top b');
        const statusText = match.status === 'final' ? 'FINAL' : match.status === 'live' ? 'LIVE' : (Date.parse(match.kickoffUtc || '') > Date.now() ? 'NOT STARTED' : 'RESULT PENDING');
        if (status) status.textContent = statusText;
        if (score && match.score && Number.isFinite(Number(match.score.home)) && Number.isFinite(Number(match.score.away))) {
          score.textContent = String(match.score.home) + '–' + String(match.score.away);
        }
      };

      const updateCard = (player) => {
        const card = root.querySelector('[data-player="' + player.id + '"]');
        const heat = root.querySelector('[data-player-heat="' + player.id + '"]');
        const live = root.querySelector('[data-player-live="' + player.id + '"]');
        if (!card) return;

        let confirmed = 0;
        tasks.forEach((task) => {
          const value = player.result?.[task.id];
          const complete = value === 'complete' || (value === undefined && player.completed?.[task.id] === true);
          const miss = value === 'failed' || (value === undefined && player.failed?.[task.id] === true);
          const pending = !complete && !miss;
          const chance = Number(player.probability?.[task.id] || 0);
          if (complete) confirmed += 1;

          card.querySelectorAll('[data-task="' + task.id + '"]').forEach((row) => {
            row.classList.toggle('is-complete', complete);
            row.classList.toggle('is-done', complete);
            row.classList.toggle('is-failed', miss);
            const label = row.querySelector('[data-chance]');
            if (label) label.textContent = complete ? '✓ COMPLETE' : miss ? '× FAILED' : fmt(chance) + '%';
            const fill = row.querySelector('i');
            if (fill && row.classList.contains('ct-bar')) fill.style.width = (complete ? 100 : Math.min(100, chance)) + '%';
          });

          heat?.querySelectorAll('[data-task="' + task.id + '"]').forEach((cell) => {
            cell.textContent = fmt(chance) + '%';
          });

          live?.querySelectorAll('[data-task="' + task.id + '"]').forEach((cell) => {
            cell.classList.toggle('is-done', complete);
            cell.classList.toggle('is-miss', miss);
            cell.classList.toggle('is-pending', pending);
            cell.textContent = complete ? '✓' : miss ? '×' : '';
            cell.setAttribute('aria-label', complete ? 'Complete' : miss ? 'Failed' : 'Result not updated');
          });
        });

        const completeAll = confirmed === tasks.length;
        card.classList.toggle('is-complete', completeAll);

        let stamp = card.querySelector('.ct-stamp');
        const art = card.querySelector('.ct-art');
        if (completeAll && !stamp && art) {
          stamp = document.createElement('div');
          stamp.className = 'ct-stamp';
          stamp.innerHTML = '<span>✓</span><b>COMPLETE</b>';
          art.appendChild(stamp);
        }
        if (!completeAll && stamp) stamp.remove();
      };

      (source.players || []).forEach(updateCard);
      (source.matches || []).forEach(updateMatch);

      const reveal = () => {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries, instance) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              instance.unobserve(entry.target);
            });
          }, { threshold: 0.08 });
          root.querySelectorAll('.ct-card, .ct-rank li, .ct-verdict, .ct-votes, .ct-heat, .ct-board').forEach((node) => observer.observe(node));
        } else {
          root.querySelectorAll('.ct-card, .ct-rank li, .ct-verdict, .ct-votes, .ct-heat, .ct-board').forEach((node) => node.classList.add('is-visible'));
        }
      };
      reveal();

      fetch('/api/football?captains=' + Date.now(), { cache: 'no-store' })
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          const live = payload?.content?.captainTracker;
          if (!live?.players) return;
          live.players?.forEach((player) => {
            const current = (source.players || []).find((item) => item.id === player.id) || player;
            updateCard({
              ...current,
              ...player,
              result: player.result || current.result || {},
              completed: player.completed || {},
              failed: player.failed || {},
            });
          });
          live.matches?.forEach(updateMatch);
        })
        .catch(() => {});
    })();
  </script>


  <script>
    import { accountAuth, accountApi } from '../lib/account-client.js';

    const voteRoot = document.querySelector('[data-captain-tracker]');
    const voteStatus = voteRoot?.querySelector('[data-vote-status]');
    const voteTotal = voteRoot?.querySelector('[data-vote-total]');
    let voteSource = { players: [] };
    try {
      voteSource = JSON.parse(document.getElementById('captain-data')?.textContent || '{"players":[]}');
    } catch {}
    const gateOpen = (title, message) => {
      window.FCAccountGate?.open({
        title,
        message,
        feature: 'your captain pick'
      });
    };

    const setVoteStatus = (text, kind = 'neutral') => {
      if (!voteStatus) return;
      voteStatus.textContent = text;
      voteStatus.dataset.state = kind;
    };

    const animateCount = (node, value) => {
      if (!node) return;
      const previous = Number(node.dataset.lastCount ?? -1);
      node.textContent = value + (value === 1 ? ' support point' : ' support points');
      node.dataset.lastCount = String(value);
      if (previous !== value) {
        node.classList.remove('is-bump');
        void node.offsetWidth;
        node.classList.add('is-bump');
      }
    };

    const voteLock = voteRoot?.querySelector('[data-vote-lock]');
    let voteLocked = false;
    let voteLockAtUtc = null;

    const formatLockTime = (iso) => {
      const timestamp = Date.parse(iso || '');
      if (!Number.isFinite(timestamp)) return '';
      try {
        return new Intl.DateTimeFormat(undefined, {
          dateStyle: 'medium',
          timeStyle: 'short'
        }).format(new Date(timestamp));
      } catch {
        return new Date(timestamp).toLocaleString();
      }
    };

    const applyVoteLockState = () => {
      voteRoot?.querySelectorAll('[data-vote-player]').forEach((node) => {
        node.disabled = voteLocked;
        node.classList.toggle('is-locked', voteLocked);
        node.setAttribute('aria-disabled', voteLocked ? 'true' : 'false');
      });

      if (voteLock) {
        if (voteLocked) {
          const when = formatLockTime(voteLockAtUtc);
          voteLock.textContent = when ? 'Picks locked · ' + when : 'Picks locked';
          voteLock.dataset.state = 'locked';
        } else {
          voteLock.textContent = 'Pick window open';
          voteLock.dataset.state = 'open';
        }
      }
    };

    let currentSelectedVote = null;
    let voteDataLoaded = false;

    const updateVoteUI = (payload) => {
      const counts = payload?.counts || {};
      const selected = Object.prototype.hasOwnProperty.call(payload || {}, 'selected')
        ? (payload.selected || null)
        : currentSelectedVote;
      currentSelectedVote = selected;
      const rawTotal = Number(payload?.total || 0);
      const total = Number.isFinite(rawTotal) ? Math.max(0, Math.floor(rawTotal)) : 0;
      voteDataLoaded = true;
      voteLocked = Boolean(payload?.locked);
      voteLockAtUtc = payload?.lockAtUtc || null;

      if (voteTotal) voteTotal.textContent = String(total);

      // Drive updates from the actual rendered buttons, not only the embedded
      // player-data JSON. This keeps every tile and tracker-card control in sync.
      voteRoot?.querySelectorAll('[data-vote-player]').forEach((node) => {
        const playerId = node.dataset.votePlayer;
        if (!playerId) return;

        const rawCount = Number(counts[playerId] || 0);
        const count = Number.isFinite(rawCount) ? Math.max(0, Math.floor(rawCount)) : 0;
        const share = total > 0 ? (count / total) * 100 : 0;
        const roundedShare = Math.round(share);
        const isTile = node.classList.contains('ct-vote-tile');
        const isSelected = selected === playerId;

        node.classList.toggle('is-selected', isSelected);
        node.setAttribute('aria-pressed', isSelected ? 'true' : 'false');

        if (isTile) {
          animateCount(node.querySelector('[data-vote-count]'), count);
          const shareLabel = node.querySelector('[data-vote-share]');
          if (shareLabel) shareLabel.textContent = total > 0 ? roundedShare + '%' : '—%';

          const fill = node.querySelector('[data-vote-fill]');
          if (fill) {
            fill.style.width = share + '%';
            fill.setAttribute('aria-hidden', 'true');
          }
          const track = node.querySelector('.ct-vote-track');
          if (track) {
            track.setAttribute('aria-valuenow', String(roundedShare));
            track.setAttribute('aria-valuetext', count + ' of ' + total + ' combined support points (' + roundedShare + '%)');
          }
          const selectedLabel = node.querySelector('[data-vote-selected]');
          if (selectedLabel) selectedLabel.hidden = !isSelected;
        } else {
          const label = node.querySelector('[data-pick-label]');
          if (label) label.textContent = isSelected ? 'Your pick' : 'Pick as captain';
          const countNode = node.querySelector('[data-pick-count]');
          if (countNode) countNode.textContent = count + ' pts';
        }
      });

      setVoteStatus(
        voteLocked
          ? (selected
            ? 'Your pick is locked. Matchday 7 voting is closed.'
            : 'Voting is locked because the first Matchday 7 fixture has started.')
          : (selected
            ? 'You picked ' + ((voteSource.players || []).find((player) => player.id === selected)?.name || 'a captain') + '. You can still change it before kickoff.'
            : 'Pick one captain to save your choice.'),
        selected ? 'selected' : (voteLocked ? 'locked' : 'neutral')
      );

      applyVoteLockState();
    };

    const hasVoteStats = (payload) => Boolean(
      payload &&
      typeof payload === 'object' &&
      Number.isFinite(Number(payload.total)) &&
      payload.counts &&
      typeof payload.counts === 'object' &&
      !Array.isArray(payload.counts)
    );

    let voteLoadInProgress = false;
    let queuedPersonalRefresh = false;

    const showVoteUnavailable = () => {
      if (voteTotal) voteTotal.textContent = '—';
      voteRoot?.querySelectorAll('.ct-vote-tile').forEach((tile) => {
        const count = tile.querySelector('[data-vote-count]');
        const fill = tile.querySelector('[data-vote-fill]');
        if (count) count.textContent = 'Vote count unavailable';
        const share = tile.querySelector('[data-vote-share]');
        if (share) share.textContent = '—%';
        const track = tile.querySelector('.ct-vote-track');
        if (track) {
          track.setAttribute('aria-valuenow', '0');
          track.setAttribute('aria-valuetext', 'Vote share unavailable');
        }
        if (fill) fill.style.width = '0%';
      });
    };

    const loadVotes = async ({ quiet = false, includeSelected = false } = {}) => {
      if (voteLoadInProgress) {
        if (includeSelected) queuedPersonalRefresh = true;
        return;
      }
      voteLoadInProgress = true;
      try {
        const endpoint = '/api/captain-votes?tracker=premier-league-matchday-7';
        // Community totals are public. Fetch them without waiting for Supabase
        // Auth so an expired or broken browser session cannot leave every count
        // stuck at the HTML placeholder of zero.
        const response = await fetch(endpoint, {
          method: 'GET',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { accept: 'application/json' }
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Could not load captain picks.');
        if (!hasVoteStats(payload)) {
          throw new Error('The community vote response was incomplete.');
        }

        // A public request intentionally has no per-account selection. Keep the
        // current selection until the optional authenticated request resolves.
        const { selected: ignoredSelection, ...publicPayload } = payload;
        updateVoteUI(publicPayload);

        if (includeSelected) {
          try {
            const sessionResult = await accountAuth.auth.getSession();
            const accessToken = sessionResult?.data?.session?.access_token;
            if (accessToken) {
              const personalResponse = await fetch(endpoint, {
                method: 'GET',
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {
                  accept: 'application/json',
                  authorization: 'Bearer ' + accessToken
                }
              });
              const personalPayload = await personalResponse.json().catch(() => ({}));
              if (personalResponse.ok && hasVoteStats(personalPayload)) {
                updateVoteUI(personalPayload);
              }
            } else {
              currentSelectedVote = null;
              updateVoteUI({ ...publicPayload, selected: null });
            }
          } catch {
            // A personal-session failure must not hide or reset public vote totals.
          }
        }
      } catch (error) {
        if (!voteDataLoaded) showVoteUnavailable();
        if (!quiet) {
          setVoteStatus(error?.message || 'Community votes could not be loaded. Retrying automatically.', 'error');
        }
      } finally {
        voteLoadInProgress = false;
        if (queuedPersonalRefresh) {
          queuedPersonalRefresh = false;
          loadVotes({ quiet: true, includeSelected: true });
        }
      }
    };

    let voteSaveInProgress = false;
    const saveVote = async (playerId, trigger) => {
      if (voteSaveInProgress || voteLocked) return;
      try {
        const session = await accountAuth.auth.getSession();
        if (!session.data?.session) {
          gateOpen(
            'Pick your captain',
            'Create a free FCMobiletools account to save your captain pick and return to the tracker whenever you want.'
          );
          return;
        }

        voteSaveInProgress = true;
        voteRoot?.querySelectorAll('[data-vote-player]').forEach((node) => {
          node.disabled = true;
        });
        if (trigger) trigger.classList.add('is-saving');
        setVoteStatus('Saving your pick…', 'saving');

        const response = await accountApi('/api/captain-votes?tracker=premier-league-matchday-7', {
          method: 'POST',
          body: JSON.stringify({ playerId })
        });
        const payload = await response.json().catch(() => ({}));

        if (response.status === 401) {
          gateOpen(
            'Sign in to save your pick',
            'Your session is not active. Sign in to keep your captain pick attached to your account.'
          );
          return;
        }
        if (response.status === 409 && payload.locked) {
          voteLocked = true;
          voteLockAtUtc = payload.lockAtUtc || voteLockAtUtc;
          applyVoteLockState();
          setVoteStatus(payload.error || 'Captain picks are locked.', 'locked');
          return;
        }
        if (!response.ok) throw new Error(payload.error || 'Could not save your captain pick.');
        if (!hasVoteStats(payload)) {
          throw new Error('Your pick could not be confirmed. Please refresh and check your selection.');
        }

        updateVoteUI(payload);
      } catch (error) {
        setVoteStatus(error?.message || 'Could not save your captain pick.', 'error');
      } finally {
        voteSaveInProgress = false;
        if (trigger) trigger.classList.remove('is-saving');
        applyVoteLockState();
      }
    };

    voteRoot?.querySelectorAll('[data-vote-player]').forEach((button) => {
      button.addEventListener('click', () => {
        const playerId = button.dataset.votePlayer;
        if (playerId) saveVote(playerId, button);
      });
    });

    accountAuth.auth.onAuthStateChange(() => {
      loadVotes({ quiet: true, includeSelected: true });
    });

    // Keep public totals fresh for visitors who already have the page open.
    const refreshVisibleVotes = () => {
      if (!document.hidden) loadVotes({ quiet: true });
    };
    window.setInterval(refreshVisibleVotes, 15000);
    window.addEventListener('focus', refreshVisibleVotes);
    document.addEventListener('visibilitychange', refreshVisibleVotes);

    loadVotes({ includeSelected: true });
  </script>

