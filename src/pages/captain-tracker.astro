.ct-analysis summary::-webkit-details-marker { display:none; }
.ct-analysis summary i {
  position:relative; flex:none; width:26px; height:26px;
  border:1px solid var(--line-2); border-radius:9px;
  transition:background .3s ease,border-color .3s ease,transform .45s var(--ease);
}
.ct-analysis summary i::before, .ct-analysis summary i::after {
  content:''; position:absolute; left:50%; top:50%;
  width:10px; height:1.5px; background:currentColor; border-radius:2px;
  transform:translate(-50%,-50%);
  transition:transform .45s var(--ease);
}
.ct-analysis summary i::after { transform:translate(-50%,-50%) rotate(90deg); }
.ct-analysis[open] summary i { background:rgba(76,201,255,.1); border-color:rgba(76,201,255,.4); transform:rotate(180deg); }
.ct-analysis[open] summary i::after { transform:translate(-50%,-50%) rotate(0); }
.ct-analysis-body { animation:ctRise .5s var(--ease) both; }
.ct-analysis-body p { color:#9ab0bd; font:500 14px/1.7 Inter,sans-serif; max-width:70ch; }
