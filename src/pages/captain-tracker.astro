.ct-stats { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:16px 0 6px; }
.ct-stats span { padding:12px 14px; border:1px solid var(--line); border-radius:14px; background:rgba(255,255,255,.02); color:#e6f0f5; font:600 14px/1.3 Inter,sans-serif; }
.ct-stats small { display:block; margin-bottom:5px; color:#6f8898; font:700 11px/1 Inter,sans-serif; }

/* ==========================================================================
