---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const tracker = FOOTBALL_CENTRE_CONTENT.captainTracker;
const players = tracker.players ?? [];
const tasks = tracker.tasks ?? [];
---

<BaseLayout
  title="Captain OVR Tracker · Premier League Matchday 7"
  description="Track the Matchday 7 captains and every condition on the route to 121 OVR."
>
  <main class="captain-page" data-captain-tracker>
    <header class="tracker-bar">
      <div class="tracker-brand">
        <span class="live-mark"><i></i> {tracker.label}</span>
        <h1>Captain OVR Tracker</h1>
      </div>
      <div class="tracker-target" aria-label="Maximum OVR 121">
        <span>MAX</span>
        <strong>121</strong>
        <small>OVR</small>
      </div>
    </header>

    <section class="captains">
      <div class="section-head">
        <div>
          <span class="section-label">MATCHDAY 7</span>
          <h2>Captain cards</h2>
        </div>
        <p>Green checks mark confirmed conditions.</p>
      </div>

      <div class="captain-grid">
        {players.map((player, index) => {
          const completedCount = tasks.filter((task) => Boolean(player.completed?.[task.id])).length;
          return (
            <article
              class:list={['captain-card', completedCount === tasks.length ? 'is-finished' : '', index === 1 ? 'is-featured' : '']}
              data-player={player.id}
              style={"--delay:" + index * 55 + "ms"}
            >
              <div class="card-sheen"></div>

              <div class="card-topline">
                <span class="player-number">#{String(index + 1).padStart(2, '0')}</span>
                <span class="matchday-label">MATCHDAY 7</span>
              </div>

              <div class="art-stage">
                <div class="art-halo"></div>
                <div class="art-shadow"></div>
                <img
                  src={player.image}
                  alt={player.name + ' FC Mobile captain card'}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <div class="art-corner">
                  <span>BASE</span>
                  <strong>{player.baseOvr ?? tracker.baseOvr}</strong>
                </div>
              </div>

              <div class="identity">
                <div>
                  <span class="club-line">{player.club}</span>
                  <h3>{player.name}</h3>
                  <p>{player.fixture}</p>
                </div>
                <div class="projected">
                  <span data-route-label>PROJECTED</span>
                  <strong data-ovr>{player.baseOvr ? Number(player.baseOvr) + completedCount : (player.currentOvr ?? tracker.baseOvr)}</strong>
                </div>
              </div>

              <div class="route-map" aria-label={player.name + ' condition progress'}>
                {tasks.map((task) => {
                  const done = Boolean(player.completed?.[task.id]);
                  const chance = Number(player.probability?.[task.id] ?? 0);
                  return (
                    <div class:list={['route-node', done ? 'is-complete' : '']} data-task={task.id} title={task.title}>
                      <span class="route-node-icon" data-check aria-hidden="true">
                        {done ? '✓' : String(chance) + '%'}
                      </span>
                      <small>{task.short}</small>
                    </div>
                  );
                })}
              </div>

              <details class="player-brief">
                <summary>
                  <span>Player analysis</span>
                  <span class="summary-arrow" aria-hidden="true">+</span>
                </summary>

                <div class="brief-body">
                  <div class="brief-note" data-note>{player.note}</div>

                  <div class="brief-conditions">
                    {tasks.map((task) => {
                      const chance = Number(player.probability?.[task.id] ?? 0);
                      const done = Boolean(player.completed?.[task.id]);
                      return (
                        <div class:list={['brief-condition', done ? 'is-complete' : '']} data-detail-task={task.id}>
                          <div class="brief-condition-icon" data-detail-check aria-hidden="true">{done ? '✓' : '•'}</div>
                          <div>
                            <strong>{task.short}</strong>
                            <span>{task.title}</span>
                          </div>
                          <b data-detail-chance>{done ? 'CONFIRMED' : chance + '%'}</b>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </details>
            </article>
          );
        })}
      </div>
    </section>

    <footer class="tracker-footer">
      <span>FCMOBILETOOLS · INDEPENDENT MATCH ANALYSIS</span>
      <p>Lineups and results can change. Percentages are directional estimates, not official EA odds or betting advice.</p>
    </footer>

    <script type="application/json" id="captain-data">{JSON.stringify({ baseOvr: tracker.baseOvr, tasks, players })}</script>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-captain-tracker]');
    if (!root) return;

    let source = { baseOvr: 116, tasks: [], players: [] };
    try {
      source = JSON.parse(document.getElementById('captain-data')?.textContent || '{}');
    } catch {}

    const tasks = source.tasks || [];

    const updateCard = (player) => {
      const card = root.querySelector('[data-player="' + player.id + '"]');
      if (!card) return;

      let confirmed = 0;

      tasks.forEach((task) => {
        const complete = Boolean(player.completed?.[task.id]);
        if (complete) confirmed += 1;

        const routeNode = card.querySelector('[data-task="' + task.id + '"]');
        if (routeNode) {
          routeNode.classList.toggle('is-complete', complete);
          const icon = routeNode.querySelector('[data-check]');
          if (icon) icon.textContent = complete ? '✓' : String(Number(player.probability?.[task.id] || 0)) + '%';
        }

        const detail = card.querySelector('[data-detail-task="' + task.id + '"]');
        if (detail) {
          const chance = Number(player.probability?.[task.id] || 0);
          detail.classList.toggle('is-complete', complete);
          const icon = detail.querySelector('[data-detail-check]');
          const value = detail.querySelector('[data-detail-chance]');
          if (icon) icon.textContent = complete ? '✓' : '•';
          if (value) value.textContent = complete ? 'CONFIRMED' : chance + '%';
        }
      });

      const current = Number(player.baseOvr || source.baseOvr || 116) + confirmed;
      const ovr = card.querySelector('[data-ovr]');
      const note = card.querySelector('[data-note]');
      if (ovr) ovr.textContent = String(current);
      if (note && player.note) note.textContent = player.note;
    };

    (source.players || []).forEach(updateCard);

    const cards = [...root.querySelectorAll('.captain-card')];
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, instance) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          instance.unobserve(entry.target);
        });
      }, { threshold: 0.08 });
      cards.forEach((card) => observer.observe(card));
    } else {
      cards.forEach((card) => card.classList.add('is-visible'));
    }

    fetch('/api/football?captains=' + Date.now(), { cache: 'no-store' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const live = payload?.content?.captainTracker;
        if (!live?.players) return;
        live.players.forEach(updateCard);
      })
      .catch(() => {});
  })();
</script>

<style>
  :global(html) { background:#071018; }
  :global(body) { background:#071018; }

  .captain-page {
    --cyan:#4cc9ff;
    --cyan-soft:#b1ecff;
    --success:#47d16c;
    --ink:#f5f8fb;
    --line:rgba(255,255,255,.075);
    width:min(1260px,calc(100% - 30px));
    margin:0 auto;
    padding:22px 0 32px;
    color:var(--ink);
  }

  .tracker-bar {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    min-height:86px;
    padding:12px 14px 12px 20px;
    border:1px solid rgba(76,201,255,.13);
    border-radius:20px;
    background:
      radial-gradient(400px 130px at 0% 0%,rgba(76,201,255,.10),transparent 74%),
      linear-gradient(145deg,#0f1d29,#09131c);
    box-shadow:0 18px 52px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.028);
    animation:enter .52s cubic-bezier(.22,1,.36,1) both;
  }

  .tracker-brand h1 {
    margin:7px 0 0;
    font:700 clamp(25px,3.8vw,40px)/1 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.055em;
  }

  .live-mark {
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:#76dbff;
    font:800 8px Inter,system-ui,sans-serif;
    letter-spacing:.15em;
    text-transform:uppercase;
  }

  .live-mark i {
    width:6px;
    height:6px;
    border-radius:50%;
    background:var(--cyan);
    box-shadow:0 0 16px rgba(76,201,255,.8);
    animation:pulse 2s ease-in-out infinite;
  }

  .tracker-target {
    display:grid;
    grid-template-columns:auto auto auto;
    align-items:baseline;
    gap:7px;
    padding:10px 14px;
    border:1px solid rgba(76,201,255,.17);
    border-radius:13px;
    background:rgba(76,201,255,.035);
    white-space:nowrap;
  }

  .tracker-target span,
  .tracker-target small {
    color:#597181;
    font:800 7px Inter,sans-serif;
    letter-spacing:.12em;
  }

  .tracker-target strong {
    color:var(--cyan-soft);
    font:700 30px/.85 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.06em;
  }

  .captains { margin-top:18px; }

  .section-head {
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:18px;
    margin:0 0 11px;
  }

  .section-label {
    color:#72d9ff;
    font:800 8px Inter,system-ui,sans-serif;
    letter-spacing:.16em;
    text-transform:uppercase;
  }

  .section-head h2 {
    margin:5px 0 0;
    font:700 clamp(20px,2.7vw,27px)/1 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.045em;
  }

  .section-head p {
    margin:0;
    color:#61788a;
    font:600 8px/1.45 Inter,sans-serif;
    text-align:right;
  }

  .captain-grid {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:15px;
  }

  .captain-card {
    position:relative;
    overflow:hidden;
    border:1px solid var(--line);
    border-radius:22px;
    background:
      radial-gradient(500px 330px at 50% 0%,rgba(76,201,255,.055),transparent 66%),
      linear-gradient(145deg,#0f1a26,#09131b);
    box-shadow:0 22px 65px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.024);
    opacity:0;
    transform:translateY(15px);
    transition:transform .45s cubic-bezier(.22,1,.36,1),opacity .45s ease,border-color .25s ease,box-shadow .25s ease;
  }

  .captain-card.is-visible {
    opacity:1;
    transform:none;
    transition-delay:var(--delay);
  }

  .captain-card:hover {
    transform:translateY(-4px);
    border-color:rgba(76,201,255,.19);
    box-shadow:0 30px 80px rgba(0,0,0,.4),0 0 52px rgba(76,201,255,.035);
  }

  .captain-card.is-featured {
    border-color:rgba(76,201,255,.25);
    background:
      radial-gradient(520px 340px at 50% 0%,rgba(76,201,255,.085),transparent 67%),
      linear-gradient(145deg,#102130,#09131b);
  }

  .captain-card.is-finished {
    border-color:rgba(71,209,108,.34);
    box-shadow:0 26px 75px rgba(0,0,0,.38),0 0 45px rgba(71,209,108,.05);
  }

  .card-sheen {
    position:absolute;
    inset:0 0 auto;
    height:140px;
    pointer-events:none;
    background:linear-gradient(180deg,rgba(255,255,255,.03),transparent);
  }

  .card-topline {
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:13px 14px 0;
  }

  .player-number,
  .matchday-label {
    color:#50697a;
    font:800 7px Inter,sans-serif;
    letter-spacing:.12em;
  }

  .art-stage {
    position:relative;
    display:grid;
    place-items:center;
    padding:8px 18px 0;
    overflow:hidden;
  }

  .art-halo {
    position:absolute;
    width:290px;
    height:290px;
    border-radius:50%;
    background:rgba(76,201,255,.07);
    filter:blur(58px);
    animation:halo 5s ease-in-out infinite;
  }

  .art-shadow {
    position:absolute;
    left:50%;
    bottom:10px;
    width:180px;
    height:24px;
    border-radius:50%;
    background:rgba(0,0,0,.60);
    filter:blur(14px);
    transform:translateX(-50%);
  }

  .art-stage img {
    position:relative;
    z-index:1;
    display:block;
    width:min(380px,100%);
    height:auto;
    object-fit:contain;
    transform:translateY(5px) scale(1.035);
    filter:drop-shadow(0 25px 28px rgba(0,0,0,.68));
    transition:transform .45s cubic-bezier(.22,1,.36,1),filter .45s ease;
  }

  .captain-card:hover .art-stage img {
    transform:translateY(-7px) scale(1.075);
    filter:drop-shadow(0 32px 34px rgba(0,0,0,.74));
  }

  .art-corner {
    position:absolute;
    z-index:3;
    left:14px;
    bottom:17px;
    display:grid;
    gap:2px;
    min-width:54px;
    padding:7px 8px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:10px;
    background:rgba(5,13,19,.60);
    backdrop-filter:blur(9px);
  }

  .art-corner span {
    color:#5d7383;
    font:800 6px Inter,sans-serif;
    letter-spacing:.13em;
  }

  .art-corner strong {
    color:#dce8ed;
    font:700 18px/.9 "Space Grotesk",Inter,sans-serif;
  }

  .identity {
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:15px;
    align-items:end;
    padding:0 16px 15px;
  }

  .club-line {
    color:#607887;
    font:800 7px Inter,sans-serif;
    letter-spacing:.12em;
    text-transform:uppercase;
  }

  .identity h3 {
    margin:6px 0 3px;
    font:700 clamp(21px,2.55vw,29px)/1 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.05em;
  }

  .identity p {
    margin:0;
    color:#7d92a0;
    font:600 9px/1.4 Inter,sans-serif;
  }

  .projected { text-align:right; }

  .projected span {
    display:block;
    color:#5d7484;
    font:800 6px Inter,sans-serif;
    letter-spacing:.13em;
  }

  .projected strong {
    display:block;
    margin-top:5px;
    color:#f4f8fa;
    font:700 clamp(37px,4vw,49px)/.82 "Space Grotesk",Inter,sans-serif;
    letter-spacing:-.07em;
    transition:color .25s ease,text-shadow .25s ease;
  }

  .captain-card.is-finished .projected strong {
    color:var(--success);
    text-shadow:0 0 26px rgba(71,209,108,.18);
  }

  .route-map {
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:7px;
    padding:11px 14px 12px;
    border-top:1px solid rgba(255,255,255,.06);
    border-bottom:1px solid rgba(255,255,255,.06);
    background:rgba(0,0,0,.09);
  }

  .route-node {
    display:grid;
    justify-items:center;
    gap:5px;
    min-width:0;
  }

  .route-node-icon {
    display:grid;
    place-items:center;
    width:31px;
    height:31px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:50%;
    background:rgba(255,255,255,.025);
    color:#7790a0;
    font:800 7px Inter,sans-serif;
    transition:transform .22s ease,background .22s ease,border-color .22s ease,color .22s ease;
  }

  .route-node small {
    max-width:100%;
    overflow:hidden;
    color:#536b7b;
    font:800 6px Inter,sans-serif;
    letter-spacing:.05em;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .route-node.is-complete .route-node-icon {
    border-color:rgba(71,209,108,.52);
    background:rgba(71,209,108,.13);
    color:var(--success);
    box-shadow:0 0 21px rgba(71,209,108,.14);
    transform:scale(1.07);
  }

  .route-node.is-complete small { color:rgba(71,209,108,.82); }

  .player-brief { border:0; }

  .player-brief summary {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:12px 14px 13px;
    color:#8ea2b0;
    font:800 8px Inter,sans-serif;
    letter-spacing:.055em;
    list-style:none;
    cursor:pointer;
    transition:color .2s ease,background .2s ease;
  }

  .player-brief summary::-webkit-details-marker { display:none; }
  .player-brief summary:hover { color:var(--cyan-soft); background:rgba(76,201,255,.023); }

  .summary-arrow {
    display:grid;
    place-items:center;
    width:21px;
    height:21px;
    border:1px solid rgba(255,255,255,.07);
    border-radius:7px;
    color:#6b8190;
    font:400 14px/1 Inter,sans-serif;
    transition:transform .25s ease,color .25s ease,border-color .25s ease;
  }

  .player-brief[open] .summary-arrow {
    transform:rotate(45deg);
    border-color:rgba(76,201,255,.23);
    color:var(--cyan);
  }

  .brief-body { padding:0 14px 15px; }

  .brief-note {
    padding:11px 12px;
    border:1px solid rgba(255,255,255,.06);
    border-radius:12px;
    background:rgba(255,255,255,.018);
    color:#8499a8;
    font:600 9px/1.62 Inter,sans-serif;
  }

  .brief-conditions {
    display:grid;
    gap:6px;
    margin-top:8px;
  }

  .brief-condition {
    display:grid;
    grid-template-columns:22px minmax(0,1fr) auto;
    gap:8px;
    align-items:center;
    padding:8px 9px;
    border:1px solid rgba(255,255,255,.045);
    border-radius:10px;
    background:rgba(255,255,255,.014);
  }

  .brief-condition-icon {
    display:grid;
    place-items:center;
    width:20px;
    height:20px;
    border-radius:50%;
    background:rgba(255,255,255,.035);
    color:#6d8392;
    font:800 10px Inter,sans-serif;
  }

  .brief-condition strong,
  .brief-condition span { display:block; }

  .brief-condition strong {
    color:#dbe4e9;
    font:800 8px "Space Grotesk",Inter,sans-serif;
  }

  .brief-condition span {
    margin-top:2px;
    color:#647b8b;
    font:600 7.5px/1.35 Inter,sans-serif;
  }

  .brief-condition b {
    color:#8297a5;
    font:800 7px Inter,sans-serif;
    white-space:nowrap;
  }

  .brief-condition.is-complete {
    border-color:rgba(71,209,108,.18);
    background:rgba(71,209,108,.028);
  }

  .brief-condition.is-complete .brief-condition-icon {
    background:rgba(71,209,108,.11);
    color:var(--success);
    box-shadow:0 0 14px rgba(71,209,108,.10);
  }

  .brief-condition.is-complete strong,
  .brief-condition.is-complete b { color:var(--success); }

  .tracker-footer {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:18px;
    margin-top:17px;
    padding-top:12px;
    border-top:1px solid rgba(255,255,255,.055);
  }

  .tracker-footer span {
    color:#52697a;
    font:800 7px Inter,sans-serif;
    letter-spacing:.12em;
    white-space:nowrap;
  }

  .tracker-footer p {
    max-width:520px;
    margin:0;
    color:#4e6575;
    font:600 7.5px/1.5 Inter,sans-serif;
    text-align:right;
  }

  @keyframes enter {
    from { opacity:0; transform:translateY(10px); }
    to { opacity:1; transform:none; }
  }

  @keyframes pulse {
    50% { transform:scale(1.22); box-shadow:0 0 23px rgba(76,201,255,.92); }
  }

  @keyframes halo {
    50% { transform:scale(1.08); opacity:.8; }
  }

  @media (max-width:940px) {
    .captain-grid { grid-template-columns:1fr; }
    .art-stage img { width:min(420px,72vw); }
  }

  @media (max-width:680px) {
    .captain-page { width:min(100% - 14px,1260px); padding-top:14px; }
    .tracker-bar { min-height:79px; padding:11px 11px 11px 14px; border-radius:17px; }
    .tracker-brand h1 { font-size:24px; }
    .live-mark { font-size:6.5px; letter-spacing:.11em; }
    .tracker-target { padding:8px 10px; }
    .tracker-target span,.tracker-target small { display:none; }
    .tracker-target strong { font-size:25px; }
    .captains { margin-top:15px; }
    .section-head { margin-bottom:9px; }
    .section-head h2 { font-size:21px; }
    .section-head p { font-size:7px; }
    .captain-card { border-radius:19px; }
    .art-stage { padding:5px 12px 0; }
    .art-stage img { width:min(360px,86vw); }
    .art-corner { left:11px; bottom:15px; }
    .identity { grid-template-columns:minmax(0,1fr) auto; padding:0 12px 12px; gap:10px; }
    .identity h3 { font-size:23px; }
    .projected strong { font-size:38px; }
    .route-map { gap:4px; padding:10px 9px 11px; }
    .route-node-icon { width:28px; height:28px; }
    .route-node small { font-size:5.5px; }
    .player-brief summary { padding:11px 12px 12px; }
    .brief-body { padding:0 12px 12px; }
    .tracker-footer { flex-direction:column; gap:7px; }
    .tracker-footer p { text-align:left; }
  }

  @media (max-width:430px) {
    .art-stage img { width:min(315px,83vw); }
    .identity { grid-template-columns:1fr; gap:8px; }
    .projected { text-align:left; padding-top:8px; border-top:1px solid rgba(255,255,255,.055); }
    .projected strong { font-size:36px; }
  }

  @media (prefers-reduced-motion:reduce) {
    .tracker-bar,.captain-card,.live-mark i,.art-halo { animation:none !important; }
    .captain-card { opacity:1; transform:none; }
    .captain-card:hover { transform:none; }
    .art-stage img,.route-node-icon,.summary-arrow { transition:none !important; }
  }
</style>
