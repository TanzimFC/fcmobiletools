.ct.is-ready .ct-heat.is-visible, .ct.is-ready .ct-card.is-visible, .ct.is-ready .ct-fixtures article.is-visible,
.ct.is-ready .ct-reads article.is-visible, .ct.is-ready .ct-note.is-visible { opacity:1; transform:none; }
.ct.is-ready .ct-card.is-visible { transition-delay:calc(var(--delay,0ms) * .35); }
.ct-fixtures article:nth-child(2), .ct-reads article:nth-child(2) { transition-delay:.07s !important; }
.ct-fixtures article:nth-child(3), .ct-reads article:nth-child(3) { transition-delay:.14s !important; }
.ct-fixtures article:nth-child(4) { transition-delay:.21s !important; }
.ct-fixtures article:nth-child(5) { transition-delay:.28s !important; }

/* ---------- Section headings ------------------------------------------- */
.ct-section-kicker {
  display:inline-flex; align-items:center; gap:8px;
  margin-bottom:10px;
  color:var(--cyan);
  font:700 12px/1 Inter,sans-serif;
  letter-spacing:.02em;
}
.ct-section-kicker::before {
  content:''; width:18px; height:1px;
  background:linear-gradient(90deg,transparent,var(--cyan));
}
.ct-votes h2, .ct-board h2, .ct-heat h2 {
  margin:0 0 8px;
  font:700 clamp(24px,2.6vw,30px)/1.05 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.045em;
}
.ct-board p, .ct-heat p, .ct-vote-head p {
  margin:0; max-width:68ch;
  color:var(--muted);
  font:500 14px/1.6 Inter,sans-serif;
}

/* ==========================================================================
   Hero
   ========================================================================== */
.ct-hero {
  display:grid;
  grid-template-columns:minmax(0,1.5fr) minmax(250px,.62fr);
  gap:36px;
  align-items:center;
  min-height:330px;
  padding:clamp(28px,4.2vw,52px);
  border-radius:32px;
  background:
    radial-gradient(640px 280px at 0 0,rgba(76,201,255,.14),transparent 70%),
    radial-gradient(520px 260px at 100% 100%,rgba(246,196,83,.09),transparent 70%),
    var(--panel);
}
.ct-hero > * { position:relative; z-index:2; }
.ct-orb { position:absolute; border-radius:50%; filter:blur(48px); pointer-events:none; z-index:0 !important; }
.ct-orb-a { width:260px; height:260px; right:14%; top:-70px; background:rgba(76,201,255,.18); animation:ctPulse 7s ease-in-out infinite; }
.ct-orb-b { width:190px; height:190px; right:30%; bottom:-70px; background:rgba(246,196,83,.1); animation:ctPulse 8s ease-in-out infinite reverse; }
.ct-hero-numeral {
  position:absolute !important;
  right:-1%; bottom:-22%;
  z-index:0 !important;
  font:700 clamp(220px,34vw,440px)/.8 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.09em;
  color:transparent;
  -webkit-text-stroke:1px rgba(246,196,83,.15);
  background:linear-gradient(180deg,rgba(246,196,83,.07),transparent 70%);
  -webkit-background-clip:text; background-clip:text;
  pointer-events:none; user-select:none;
}
.ct-kicker {
  display:inline-flex; align-items:center; gap:10px;
  padding:7px 14px 7px 11px;
  border:1px solid rgba(76,201,255,.2);
  border-radius:999px;
  background:rgba(76,201,255,.07);
  color:var(--ice);
  font:700 12px/1 Inter,sans-serif;
  letter-spacing:.02em;
}
.ct-kicker i {
  width:7px; height:7px; border-radius:50%;
  background:var(--cyan);
  box-shadow:0 0 0 0 rgba(76,201,255,.7),0 0 14px rgba(76,201,255,.9);
  animation:ctLive 2s ease-out infinite;
}
.ct-hero h1 {
  margin:20px 0 18px;
  font:700 clamp(42px,6.6vw,88px)/.9 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.06em;
  background:linear-gradient(180deg,#fff 25%,#9fbccd 100%);
  -webkit-background-clip:text; background-clip:text;
  -webkit-text-fill-color:transparent;
}
.ct-hero p { max-width:56ch; margin:0; color:var(--muted); font:500 16px/1.65 Inter,sans-serif; }
.ct-hero-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:26px; }
.ct-hero-meta span {
  padding:8px 13px;
  border:1px solid var(--line);
  border-radius:999px;
  background:rgba(255,255,255,.035);
  color:#a9bdca;
  font:600 12px/1 Inter,sans-serif;
}

/* hero load sequence — one orchestrated moment */
.ct-kicker, .ct-hero h1, .ct-hero p, .ct-hero-meta {
  animation:ctRise 1s var(--ease) both;
}
.ct-hero h1 { animation-delay:.08s; }
.ct-hero p { animation-delay:.18s; }
.ct-hero-meta { animation-delay:.28s; }
.ct-hero .ct-ladder { animation:ctRise 1s var(--ease) .2s both; }

/* ---------- OVR ladder --------------------------------------------------- */
.ct-ladder {
  justify-self:end;
  width:min(100%,290px);
  padding:20px 20px 18px;
  border:1px solid var(--line);
  border-radius:22px;
  background:linear-gradient(170deg,rgba(6,15,22,.7),rgba(6,15,22,.4));
  box-shadow:0 30px 60px -30px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.05);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}
.ct-ladder-title {
  display:block; margin-bottom:14px;
  color:var(--muted);
  font:700 12px/1 Inter,sans-serif;
  letter-spacing:.02em;
}
.ct-ladder ol { position:relative; list-style:none; margin:0; padding:0; display:grid; gap:8px; }
.ct-ladder ol::before, .ct-ladder ol::after {
  content:'';
  position:absolute; left:23px; top:17px; bottom:17px; width:2px;
  border-radius:2px;
}
.ct-ladder ol::before { background:rgba(255,255,255,.07); }
.ct-ladder ol::after {
  background:linear-gradient(0deg,var(--cyan),var(--ice) 55%,var(--gold));
  box-shadow:0 0 12px rgba(76,201,255,.5);
  transform-origin:50% 100%;
  animation:ctClimbY 1.25s cubic-bezier(.65,0,.35,1) .6s both;
}
.ct-ladder li {
  position:relative; z-index:1;
  display:grid; grid-template-columns:48px 1fr; align-items:center; gap:14px;
  color:var(--dim);
  font:600 12px/1.2 Inter,sans-serif;
  animation:ctText .5s ease both;
  animation-delay:calc(.6s + var(--step) * .2s);
}
.ct-ladder li b {
  display:grid; place-items:center;
  height:36px;
  border:1px solid var(--line-2);
  border-radius:12px;
  background:#0a1a25;
  color:#6f8a9b;
  font:700 16px/1 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.02em;
  animation:ctChip .55s var(--ease) both;
  animation-delay:calc(.6s + var(--step) * .2s);
}
.ct-ladder li.is-base b { color:var(--ice); border-color:rgba(76,201,255,.4); background:#0b2230; }
.ct-ladder li.is-peak b {
  position:relative; overflow:hidden;
  border-color:rgba(255,230,163,.7);
  background:var(--foil); background-size:220% 100%;
  color:#1b1303;
  box-shadow:0 0 0 1px rgba(246,196,83,.25),0 10px 30px -6px rgba(246,196,83,.55);
  animation:ctChip .55s var(--ease) both,ctFoil 5s ease-in-out 2.4s infinite;
  animation-delay:calc(.6s + var(--step) * .2s),2.4s;
}
.ct-ladder li.is-peak { color:var(--gold-hi); }

/* ==========================================================================
   Community vote
   ========================================================================== */
.ct-votes { margin-top:18px; padding:clamp(22px,3vw,32px); }
.ct-vote-head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; }
.ct-vote-total {
  min-width:140px; padding:12px 16px;
  border:1px solid rgba(76,201,255,.2);
  border-radius:16px;
  background:linear-gradient(160deg,rgba(76,201,255,.1),rgba(76,201,255,.03));
  text-align:right;
}
.ct-vote-total strong {
  display:block;
  background:linear-gradient(180deg,#fff,var(--ice));
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
  font:700 32px/1 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.04em;
}
.ct-vote-total span { display:block; margin-top:6px; color:var(--dim); font:600 12px/1 Inter,sans-serif; }

.ct-vote-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
.ct-vote-tile {
  position:relative;
  display:grid;
  grid-template-columns:26px 58px minmax(0,1fr);
  align-items:center;
  gap:12px;
  min-width:0; min-height:112px;
  padding:14px 16px;
  border:1px solid var(--line);
  border-radius:20px;
  background:
    radial-gradient(200px 120px at 0 0,rgba(76,201,255,.09),transparent 72%),
    linear-gradient(150deg,rgba(21,42,58,.95),rgba(8,19,28,.98));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 14px 30px -18px rgba(0,0,0,.8);
  color:inherit; text-align:left; font:inherit;
  cursor:pointer; overflow:hidden; isolation:isolate;
  transition:transform .35s var(--ease),border-color .3s ease,box-shadow .35s ease,background .3s ease;
  animation:ctRise .7s var(--ease) var(--vote-delay) both;
}
.ct-vote-tile::before {
  content:''; position:absolute; inset:0; z-index:-1;
  background:radial-gradient(240px circle at var(--mx,0%) var(--my,0%),rgba(120,214,255,.14),transparent 65%);
  opacity:0; transition:opacity .3s ease;
}
.ct-vote-tile::after {
  content:''; position:absolute; inset:0; pointer-events:none;
  background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.08) 50%,transparent 65%);
  transform:translateX(-120%);
  transition:transform .8s var(--ease);
}
.ct-vote-tile:hover { transform:translateY(-3px); border-color:rgba(76,201,255,.38); box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 22px 40px -16px rgba(0,0,0,.85); }
.ct-vote-tile:hover::before { opacity:1; }
.ct-vote-tile:hover::after { transform:translateX(120%); }
.ct-vote-tile:active { transform:translateY(-1px) scale(.992); }
.ct-vote-tile.is-selected {
  border-color:transparent;
  background:
    linear-gradient(150deg,#0e2a3b,#08151f) padding-box,
    conic-gradient(from var(--ct-angle),#4cc9ff,#d9f8ff,#4cc9ff 38%,#1d6f94 62%,#4cc9ff) border-box;
  box-shadow:0 0 0 1px rgba(76,201,255,.1),0 24px 50px -18px rgba(76,201,255,.28);
  animation:ctSpin 6s linear infinite;
}
.ct-vote-number {
  display:grid; place-items:center;
  width:24px; height:24px;
  border:1px solid var(--line);
  border-radius:8px;
  background:rgba(255,255,255,.03);
  color:#6c889a;
  font:700 10px/1 Inter,sans-serif;
}
.ct-vote-tile img {
  width:58px; height:76px; object-fit:contain;
  filter:drop-shadow(0 10px 14px rgba(0,0,0,.55));
  transition:transform .45s var(--ease);
}
.ct-vote-tile:hover img, .ct-vote-tile.is-selected img { transform:translateY(-4px) scale(1.07) rotate(-1.5deg); }
.ct-vote-info { min-width:0; display:grid; gap:8px; }
.ct-vote-info strong {
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  color:#f5fafd;
  font:700 14px/1.2 Inter,sans-serif;
  letter-spacing:-.015em;
}
.ct-vote-count-row { display:flex; align-items:center; justify-content:space-between; gap:8px; min-width:0; }
.ct-vote-count-row [data-vote-count] {
  min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  color:#8aa5b6; font:600 11px/1.2 Inter,sans-serif;
}
.ct-vote-count-row [data-vote-share] {
  flex:0 0 auto; color:#9fe8ff;
  font:700 12px/1 Inter,sans-serif; font-style:normal;
}
.ct-vote-track {
  position:relative; display:block; height:6px; overflow:hidden;
  border-radius:999px;
  background:#030a10;
  box-shadow:inset 0 1px 2px rgba(0,0,0,.8),0 0 0 1px rgba(118,181,207,.08);
}
.ct-vote-track b {
  position:relative; display:block; width:0; height:100%;
  border-radius:inherit; overflow:hidden;
  background:linear-gradient(90deg,#1a739c,#2eb6e8 56%,#9aeaff);
  box-shadow:0 0 12px rgba(76,201,255,.45);
  transition:width .9s var(--ease);
}
.ct-vote-track b::after {
  content:''; position:absolute; inset:0;
  background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);
  transform:translateX(-100%);
  animation:ctShimmer 3.4s ease-in-out 1.2s infinite;
}
.ct-vote-selected {
  position:absolute; top:10px; right:10px;
  display:inline-flex; align-items:center; gap:5px;
  padding:5px 9px 5px 7px;
  border:1px solid rgba(76,201,255,.4);
  border-radius:999px;
  background:rgba(4,16,24,.85);
  color:#9fe8ff;
  font:700 10px/1 Inter,sans-serif;
  animation:ctPop .4s var(--ease) both;
}
.ct-vote-selected::before { content:'✓'; font-weight:900; }
.ct-vote-selected[hidden] { display:none; }
.ct-vote-foot { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-top:20px; }
.ct-vote-status { margin:0; color:#8199a9; font:600 13px/1.4 Inter,sans-serif; }
.ct-vote-status[data-state="selected"] { color:#8fe3ff; }
.ct-vote-status[data-state="error"] { color:#ffa3ad; }
.ct-vote-status[data-state="saving"] { color:#d4e1ea; }
.ct-vote-lock {
  display:inline-flex; align-items:center; gap:8px;
  min-height:32px; padding:0 13px;
  border:1px solid rgba(76,201,255,.2);
  border-radius:999px;
  background:rgba(76,201,255,.07);
  color:#92e2ff;
  font:700 12px/1 Inter,sans-serif;
  white-space:nowrap;
}
.ct-vote-lock::before { content:''; width:6px; height:6px; border-radius:50%; background:currentColor; box-shadow:0 0 10px currentColor; }
.ct-vote-lock[data-state="open"]::before { animation:ctLive 2s ease-out infinite; }
.ct-vote-lock[data-state="locked"] { border-color:rgba(78,224,160,.25); background:rgba(78,224,160,.07); color:#88f0c0; }
.ct-vote-tile.is-locked { cursor:not-allowed; opacity:.9; }
.ct-vote-tile:disabled { cursor:not-allowed; }
.is-bump { animation:ctBump .45s var(--ease); }

/* ==========================================================================
   Verdict — gold foil
   ========================================================================== */
.ct-verdict {
  display:grid; grid-template-columns:minmax(0,1fr) auto; gap:28px; align-items:center;
  margin-top:18px;
  padding:clamp(24px,3.4vw,40px);
  border:1px solid transparent;
  background:
    radial-gradient(520px 200px at 100% 0,rgba(246,196,83,.16),transparent 70%),
    linear-gradient(160deg,#17150d,#0b141c) padding-box,
    conic-gradient(from var(--ct-angle),rgba(246,196,83,.15),rgba(255,240,189,.85),rgba(246,196,83,.15) 30%,rgba(168,121,28,.4) 55%,rgba(246,196,83,.15)) border-box;
  animation:ctSpin 10s linear infinite;
}
.ct-verdict::after { display:none; }
.ct-verdict-copy > span {
  display:inline-flex; align-items:center; gap:8px;
  color:var(--gold);
  font:700 13px/1 Inter,sans-serif;
  letter-spacing:.01em;
}
.ct-verdict-copy > span::before { content:'★'; font-size:12px; }
.ct-verdict h2 {
  margin:12px 0 12px;
  font:700 clamp(32px,4.6vw,54px)/.95 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.055em;
  background:linear-gradient(180deg,#fff 20%,#e9d7a3);
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
}
.ct-verdict p { margin:0; max-width:64ch; color:#c5d0d9; font:500 15px/1.7 Inter,sans-serif; }
.ct-verdict-stat { text-align:right; }
.ct-verdict-stat small { display:block; color:#b79a5a; font:700 12px/1 Inter,sans-serif; letter-spacing:.02em; }
.ct-verdict-stat strong {
  display:block; margin:10px 0 8px;
  background:var(--foil); background-size:220% 100%;
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
  font:700 clamp(56px,8vw,92px)/.85 "Space Grotesk",Inter,sans-serif;
  letter-spacing:-.06em;
  animation:ctFoil 6s ease-in-out infinite;
  filter:drop-shadow(0 8px 30px rgba(246,196,83,.25));
}
.ct-verdict-stat em { color:#a8915a; font:600 14px/1 Inter,sans-serif; font-style:normal; }

/* ==========================================================================
   Ranking
   ========================================================================== */
.ct-board, .ct-heat { margin-top:18px; padding:clamp(22px,3vw,32px); }
.ct-board header, .ct-heat header { margin-bottom:22px; }
.ct-rank { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
.ct-rank li {
  position:relative;
  display:grid; grid-template-columns:44px 46px minmax(0,190px) minmax(80px,1fr) 78px;
  align-items:center; gap:14px;
  padding:12px 16px;
  border:1px solid var(--line);
  border-radius:18px;
  background:rgba(255,255,255,.022);
  transition:background .3s ease,border-color .3s ease,transform .35s var(--ease);
}
.ct-rank li:hover { background:rgba(255,255,255,.04); border-color:var(--line-2); transform:translateX(3px); }
.ct-rank li.is-lead {
  border-color:rgba(246,196,83,.32);
  background:linear-gradient(90deg,rgba(246,196,83,.11),rgba(246,196,83,.02) 60%);
  box-shadow:0 18px 40px -26px rgba(246,196,83,.5);
}
.ct-rank li.is-lead::before {
  content:''; position:absolute; left:0; top:14%; bottom:14%; width:3px; border-radius:3px;
  background:var(--foil);
}
.ct-rank img { width:44px; height:58px; object-fit:contain; filter:drop-shadow(0 8px 10px rgba(0,0,0,.5)); }
.ct-rank b { color:#6b8696; font:700 13px/1 "Space Grotesk",Inter,sans-serif; }
.ct-rank li.is-lead b { color:var(--gold); }
.ct-rank strong { display:block; font:700 15px/1.2 Inter,sans-serif; letter-spacing:-.01em; }
.ct-rank span { display:block; margin-top:3px; color:#7c93a2; font:500 12px/1.3 Inter,sans-serif; }
.ct-rank em {
  text-align:right; color:var(--ice);
  font:700 20px/1 "Space Grotesk",Inter,sans-serif; font-style:normal; letter-spacing:-.03em;
}
.ct-rank li.is-lead em { color:var(--gold-hi); }
.ct-rank-bar { height:6px; border-radius:99px; background:#040b11; overflow:hidden; box-shadow:inset 0 1px 2px rgba(0,0,0,.7); }
.ct-rank-bar i {
  display:block; height:100%; border-radius:inherit;
  background:linear-gradient(90deg,#4a6b7d,var(--cyan));
  transform-origin:0 50%;
  transition:transform 1.2s var(--ease) .25s;
}
.ct-rank li.is-lead .ct-rank-bar i { background:var(--foil); box-shadow:0 0 14px rgba(246,196,83,.45); }
.ct.is-ready .ct-rank li:not(.is-visible) .ct-rank-bar i { transform:scaleX(0); }
.ct.is-ready .ct-rank li { opacity:0; transform:translateY(10px); transition:opacity .6s ease,transform .6s var(--ease),background .3s,border-color .3s; }
.ct.is-ready .ct-rank li.is-visible { opacity:1; transform:none; }
.ct.is-ready .ct-rank li.is-visible { transition-delay:var(--delay,0ms),var(--delay,0ms),0s,0s; }
.ct.is-ready .ct-rank li.is-visible:hover { transform:translateX(3px); transition-delay:0s; }

/* ==========================================================================
   Result + probability matrices
   ========================================================================== */
.ct-live-results header {
  display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap;
}
.ct-result-legend { display:flex; gap:14px; flex-wrap:wrap; align-items:center; color:#7d95a5; font:600 12px/1 Inter,sans-serif; }
.ct-result-legend span { display:inline-flex; align-items:center; gap:7px; }
.ct-result-dot {
  display:inline-grid; place-items:center;
  width:20px; height:20px; border-radius:7px;
  border:1px solid var(--line);
  font:900 12px/1 Inter,sans-serif; font-style:normal;
}
.ct-result-dot.is-complete { background:rgba(78,224,160,.16); color:#8cf2c6; border-color:rgba(78,224,160,.32); }
.ct-result-dot.is-failed { background:rgba(255,122,138,.14); color:#ffa8b2; border-color:rgba(255,122,138,.3); }
.ct-result-dot.is-pending { border-style:dashed; }

.ct-heat-table { display:grid; gap:6px; overflow-x:auto; padding-bottom:4px; scrollbar-width:thin; scrollbar-color:rgba(255,255,255,.14) transparent; }
.ct-heat-head, .ct-heat-row {
  display:grid; grid-template-columns:150px repeat(5,minmax(92px,1fr)) 74px;
  gap:6px; align-items:center; min-width:780px;
}
.ct-heat-head { margin-bottom:2px; }
.ct-heat-head span { padding:0 4px 4px; color:#6f8898; font:700 12px/1.3 Inter,sans-serif; }
.ct-heat-row { padding:3px 0; border-radius:14px; transition:background .25s ease; }
.ct-heat-row:hover { background:rgba(255,255,255,.028); }
.ct-heat-row > span:first-child {
  position:sticky; left:0; z-index:2;
  padding:0 8px 0 4px;
  background:linear-gradient(90deg,#0b1821 70%,transparent);
  font:700 14px/1.2 Inter,sans-serif; white-space:nowrap;
}
.ct-heat-row em {
  text-align:right; padding-right:6px;
  background:var(--foil); background-size:220% 100%;
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
  font:700 16px/1 "Space Grotesk",Inter,sans-serif; font-style:normal;
}
.ct-cell {
  display:grid; place-items:center;
  min-height:42px;
  border:1px solid transparent; border-radius:12px;
  font:700 12px/1 Inter,sans-serif;
  transition:transform .25s var(--ease),filter .25s ease;
}
