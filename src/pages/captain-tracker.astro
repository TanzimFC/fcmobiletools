---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const tracker = FOOTBALL_CENTRE_CONTENT.captainTracker;
const players = tracker.players ?? [];
const tasks = tracker.tasks ?? [];
const featuredPlayer = players[1] ?? players[0];
---

<BaseLayout
  title="Captain OVR Tracker · Premier League Matchday 7"
  description="Follow the FC Mobile Matchday 7 captains, their five upgrade conditions and the route to 121 OVR."
>
  <main class="captain-page" data-captain-tracker>
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <section class="hero">
      <div class="hero-copy">
        <div class="kicker"><span class="kicker-dot"></span>{tracker.label}</div>
        <h1>Five conditions.<br /><span>One 121 OVR chase.</span></h1>
        <p class="hero-lede">
          Each captain starts at {tracker.baseOvr} OVR. Every confirmed condition adds +1. This tracker follows the
          route as Matchday 7 plays out.
        </p>
        <div class="hero-stats" aria-label="Tracker summary">
          <div><strong>{players.length}</strong><span>Captains</span></div>
          <div><strong>{tasks.length}</strong><span>Conditions</span></div>
          <div><strong>116 → 121</strong><span>OVR route</span></div>
        </div>
      </div>

      <div class="hero-target" aria-label="Maximum OVR 121">
        <div class="target-orbit"></div>
        <div class="target-core"><span>121</span><small>MAX OVR</small></div>
      </div>
    </section>

    <section class="editorial-callout">
      <div class="callout-index">01</div>
      <div class="callout-main">
        <span class="section-label">OUR READ</span>
        <h2>{featuredPlayer?.name} has the cleanest 121 route.</h2>
        <p>{featuredPlayer?.note}</p>
      </div>
      <div class="callout-metric">
        <small>TOP ROUTE</small>
        <strong>{featuredPlayer?.name?.split(' ')[0]}</strong>
        <span>{featuredPlayer?.club}</span>
      </div>
    </section>

    <section class="conditions">
      <div class="section-head">
        <div>
          <span class="section-label">THE UPGRADE ROUTE</span>
          <h2>Every condition that adds +1 OVR.</h2>
        </div>
        <span class="section-meta">{tracker.updatedLabel}</span>
      </div>

      <div class="condition-grid">
        {tasks.map((task, index) => (
          <article class="condition">
            <span class="condition-number">{String(index + 1).padStart(2, '0')}</span>
            <div><strong>{task.short}</strong><p>{task.title}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="tracker-section">
      <div class="section-head tracker-heading">
        <div>
          <span class="section-label">MATCHDAY 7</span>
          <h2>The captains, side by side.</h2>
          <p>Percentages are directional estimates. Confirmed results replace estimates as matches finish.</p>
        </div>
        <div class="tracker-key">
          <span><i class="key-line"></i>Estimated chance</span>
          <span><i class="key-dot"></i>Confirmed</span>
        </div>
      </div>

      <div class="player-list">
        {players.map((player, index) => (
          <article
            class:list={['player-card', player.id === featuredPlayer?.id ? 'is-featured' : '']}
            data-player={player.id}
            style={"--card-delay:" + index * 70 + "ms"}
          >
            <div class="player-card-glow"></div>
            <div class="player-rank"><span>#{String(index + 1).padStart(2, '0')}</span></div>

            <div class="player-art">
              <div class="art-floor"></div>
              <img
                src={player.image}
                alt={player.name + ' FC Mobile captain card'}
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>

            <div class="player-main">
              <div class="player-heading">
                <div>
                  <span class="mini-label">CAPTAIN</span>
                  <h3>{player.name}</h3>
                  <p>{player.club} <span>·</span> {player.fixture}</p>
                </div>
                <div class="ovr-block">
                  <span>ROUTE</span>
                  <div><strong data-ovr>{player.currentOvr}</strong><em>→ 121</em></div>
                  <small data-progress>0 / {tasks.length} confirmed</small>
                </div>
              </div>

              <div class="condition-list">
                {tasks.map((task) => {
                  const probability = Number(player.probability?.[task.id] ?? 0);
                  const done = Boolean(player.completed?.[task.id]);
                  return (
                    <div class:list={['condition-row', done ? 'is-complete' : '']} data-task={task.id}>
                      <div class="condition-copy">
                        <strong>{task.short}</strong><span>{task.title}</span>
                      </div>
                      <div class="chance-track" aria-hidden="true"><i style={"--chance:" + probability + "%"}></i></div>
                      <strong class="chance-value" data-chance>{probability}%</strong>
                      <span class="condition-state" data-state>{done ? 'CONFIRMED' : 'OPEN'}</span>
                    </div>
                  );
                })}
              </div>

              <div class="player-footer">
                <p>{player.note}</p>
                <button type="button" class="brief-button" data-open-brief={player.id}>
                  <span>Player brief</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5 12.5 10 7 15.5" /></svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="tracker-note">
      <div>
        <span class="section-label">HOW TO READ IT</span>
        <h2>One strong condition does not make a 121 card.</h2>
      </div>
      <p>
        A defender can own the clean-sheet route and still fall short because the attacking conditions remain open.
        The tracker keeps each condition separate so the OVR projection changes only when a result is actually
        confirmed.
      </p>
    </section>

    <p class="disclaimer">
      Independent FCMOBILETOOLS analysis. Player availability, lineups and match outcomes can change. Percentages are
      directional estimates, not official EA odds or betting advice.
    </p>

    <dialog class="brief-modal" data-brief-modal aria-label="Player brief">
      <div class="modal-shell">
        <button class="modal-close" type="button" data-close-brief aria-label="Close player brief">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
        </button>
        <div class="modal-hero">
          <div class="modal-art"><img data-modal-image alt="" /></div>
          <div class="modal-identity">
            <span class="section-label">PLAYER BRIEF</span>
            <h2 data-modal-name></h2>
            <p data-modal-fixture></p>
            <div class="modal-ovr"><span>START</span><strong data-modal-ovr>116</strong><em>→ 121</em></div>
          </div>
        </div>
        <div class="modal-section">
          <span class="section-label">THE READ</span>
          <p class="modal-note" data-modal-note></p>
        </div>
        <div class="modal-section">
          <span class="section-label">CONDITION MAP</span>
          <div class="modal-condition-list" data-modal-conditions></div>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="captain-data">{JSON.stringify({ baseOvr: tracker.baseOvr, tasks, players })}</script>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-captain-tracker]');
    if (!root) return;

    let source = { baseOvr: 116, tasks: [], players: [] };
    try {
      source = JSON.parse(document.getElementById('captain-data')?.textContent || '{}');
    } catch {}

    const playerMap = new Map((source.players || []).map((player) => [player.id, player]));
    const tasks = source.tasks || [];
    const modal = root.querySelector('[data-brief-modal]');
    const modalImage = modal?.querySelector('[data-modal-image]');
    const modalName = modal?.querySelector('[data-modal-name]');
    const modalFixture = modal?.querySelector('[data-modal-fixture]');
    const modalOvr = modal?.querySelector('[data-modal-ovr]');
    const modalNote = modal?.querySelector('[data-modal-note]');
    const modalConditions = modal?.querySelector('[data-modal-conditions]');

    const updateCard = (player) => {
      const card = root.querySelector('[data-player="' + player.id + '"]');
      if (!card) return;

      let confirmed = 0;
      tasks.forEach((task) => {
        const row = card.querySelector('[data-task="' + task.id + '"]');
        if (!row) return;
        const complete = Boolean(player.completed?.[task.id]);
        if (complete) confirmed += 1;

        const chance = Number(player.probability?.[task.id] || 0);
        const bar = row.querySelector('.chance-track i');
        const value = row.querySelector('[data-chance]');
        const state = row.querySelector('[data-state]');

        if (bar) bar.style.setProperty('--chance', chance + '%');
        if (value) value.textContent = chance + '%';
        row.classList.toggle('is-complete', complete);
        if (state) state.textContent = complete ? 'CONFIRMED' : 'OPEN';
      });

      const ovr = card.querySelector('[data-ovr]');
      const progress = card.querySelector('[data-progress]');
      const projected = Number(player.baseOvr || source.baseOvr || 116) + confirmed;
      if (ovr) ovr.textContent = String(projected);
      if (progress) progress.textContent = confirmed + ' / ' + tasks.length + ' confirmed';
    };

    (source.players || []).forEach(updateCard);

    const openBrief = (id, replaceHash = true) => {
      const player = playerMap.get(id);
      if (!player || !modal) return;

      const confirmed = tasks.filter((task) => Boolean(player.completed?.[task.id])).length;
      const currentOvr = Number(player.baseOvr || source.baseOvr || 116) + confirmed;

      if (modalImage) {
        modalImage.src = player.image;
        modalImage.alt = player.name + ' FC Mobile captain card';
      }
      if (modalName) modalName.textContent = player.name;
      if (modalFixture) modalFixture.textContent = player.club + ' · ' + player.fixture;
      if (modalOvr) modalOvr.textContent = String(currentOvr);
      if (modalNote) modalNote.textContent = player.note;

      if (modalConditions) {
        modalConditions.innerHTML = tasks.map((task) => {
          const chance = Number(player.probability?.[task.id] || 0);
          const complete = Boolean(player.completed?.[task.id]);
          return '<div class="modal-condition' + (complete ? ' is-complete' : '') + '">' +
            '<div><strong>' + task.short + '</strong><span>' + task.title + '</span></div>' +
            '<div class="modal-probability"><div class="modal-track"><i style="width:' + chance + '%"></i></div>' +
            '<b>' + (complete ? 'CONFIRMED' : chance + '%') + '</b></div></div>';
        }).join('');
      }

      modal.showModal();
      document.body.classList.add('captain-modal-open');
      if (replaceHash) history.replaceState(null, '', '#' + encodeURIComponent(id));
    };

    const closeBrief = (clearHash = true) => {
      if (!modal) return;
      modal.close();
      document.body.classList.remove('captain-modal-open');
      if (clearHash) history.replaceState(null, '', window.location.pathname + window.location.search);
    };

    root.addEventListener('click', (event) => {
      const button = event.target.closest('[data-open-brief]');
      if (button) openBrief(button.getAttribute('data-open-brief'));
      if (event.target.closest('[data-close-brief]')) closeBrief();
    });

    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeBrief();
    });

    window.addEventListener('hashchange', () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (id && playerMap.has(id)) openBrief(id, false);
      else if (modal?.open) closeBrief(false);
    });

    const initialId = decodeURIComponent(window.location.hash.slice(1));
    if (initialId && playerMap.has(initialId)) requestAnimationFrame(() => openBrief(initialId, false));

    const cards = [...root.querySelectorAll('.player-card')];
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, instance) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          instance.unobserve(entry.target);
        });
      }, { threshold: 0.12 });
      cards.forEach((card) => observer.observe(card));
    } else {
      cards.forEach((card) => card.classList.add('is-visible'));
    }

    fetch('/api/football?captains=' + Date.now(), { cache: 'no-store' })
      .then((response) => response.ok ? response.json() : null)
      .then((payload) => {
        const live = payload?.content?.captainTracker;
        if (!live?.players) return;
        live.players.forEach((player) => playerMap.set(player.id, player));
        live.players.forEach(updateCard);
      })
      .catch(() => {});
  })();
</script>

<style>
  :global(body.captain-modal-open) { overflow: hidden; }

  .captain-page {
    --cyan: #4cc9ff;
    --cyan-soft: #a4e8ff;
    --success: #47d16c;
    --text: #f5f8fb;
    --muted: #8ca0b0;
    position: relative;
    width: min(1220px, calc(100% - 32px));
    margin: 0 auto;
    padding: 46px 0 36px;
    color: var(--text);
    isolation: isolate;
  }

  .captain-page::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% -10%, rgba(76,201,255,.13), transparent 34%),
      linear-gradient(180deg, #071018 0%, #071018 58%, #08121b 100%);
  }

  .captain-page::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    opacity: .2;
    background-image:
      linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000, rgba(0,0,0,.2) 66%, transparent);
  }

  .ambient {
    position: absolute;
    z-index: -1;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    filter: blur(70px);
    opacity: .14;
    pointer-events: none;
    animation: ambientFloat 9s ease-in-out infinite;
  }
  .ambient-one { top: 250px; left: -190px; background: #168cca; }
  .ambient-two { top: 980px; right: -210px; background: #2358a7; animation-delay: -4s; }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0,1fr) 260px;
    gap: 28px;
    overflow: hidden;
    padding: clamp(30px,5vw,56px);
    border: 1px solid rgba(76,201,255,.18);
    border-radius: 30px;
    background:
      radial-gradient(580px 340px at 0% 0%, rgba(76,201,255,.16), transparent 68%),
      radial-gradient(420px 280px at 100% 100%, rgba(61,117,194,.09), transparent 70%),
      linear-gradient(145deg, rgba(17,32,46,.98), rgba(8,17,25,.98));
    box-shadow: 0 30px 90px rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.03);
    animation: heroEnter .8s cubic-bezier(.22,1,.36,1) both;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(115deg, rgba(255,255,255,.05), transparent 22%, transparent 75%, rgba(255,255,255,.025));
  }

  .kicker,
  .section-label,
  .section-meta,
  .mini-label,
  .tracker-key,
  .player-rank,
  .ovr-block span,
  .ovr-block small,
  .disclaimer {
    font-family: Inter, system-ui, sans-serif;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--cyan-soft);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .17em;
  }

  .kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 20px rgba(76,201,255,.75);
    animation: dotPulse 2s ease-in-out infinite;
  }

  .hero h1 {
    max-width: 820px;
    margin: 15px 0 19px;
    font: 700 clamp(44px,6.1vw,78px)/.93 "Space Grotesk", Inter, sans-serif;
    letter-spacing: -.065em;
  }

  .hero h1 span {
    color: var(--cyan-soft);
    text-shadow: 0 0 42px rgba(76,201,255,.16);
  }

  .hero-lede {
    max-width: 760px;
    margin: 0;
    color: #9eb0bf;
    font-size: 15px;
    line-height: 1.72;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .hero-stats div {
    min-width: 142px;
    padding: 11px 14px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 13px;
    background: rgba(255,255,255,.025);
    backdrop-filter: blur(8px);
  }
  .hero-stats strong, .hero-stats span { display: block; }
  .hero-stats strong { font: 700 16px "Space Grotesk", Inter, sans-serif; }
  .hero-stats span {
    margin-top: 3px;
    color: #6f8493;
    font: 700 8px Inter, sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero-target {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 250px;
  }

  .target-core {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    align-content: center;
    width: 188px;
    height: 188px;
    border: 1px solid rgba(76,201,255,.34);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(76,201,255,.10), rgba(7,16,24,.75) 68%);
    box-shadow: 0 0 70px rgba(76,201,255,.09), inset 0 0 42px rgba(76,201,255,.05);
  }

  .target-core::after {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 50%;
  }
  .target-core span { font: 700 66px/.86 "Space Grotesk", Inter, sans-serif; letter-spacing: -.07em; }
  .target-core small {
    margin-top: 10px;
    color: #708697;
    font: 800 9px Inter, sans-serif;
    letter-spacing: .17em;
  }

  .target-orbit {
    position: absolute;
    width: 244px;
    height: 244px;
    border: 1px dashed rgba(76,201,255,.17);
    border-radius: 50%;
    animation: orbit 14s linear infinite;
  }
  .target-orbit::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d8f7ff;
    box-shadow: 0 0 20px rgba(76,201,255,.95);
    transform: translateX(-50%);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 14px;
  }

  .section-label {
    color: #74d8ff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .17em;
  }

  .section-head h2, .tracker-note h2 {
    margin: 7px 0 0;
    font: 700 clamp(22px,3vw,30px)/1.08 "Space Grotesk", Inter, sans-serif;
    letter-spacing: -.045em;
  }

  .section-meta {
    color: #637a8b;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .07em;
    white-space: nowrap;
  }

  .editorial-callout {
    display: grid;
    grid-template-columns: 48px minmax(0,1fr) 180px;
    gap: 20px;
    align-items: center;
    margin-top: 14px;
    padding: 21px 23px;
    border: 1px solid rgba(76,201,255,.14);
    border-radius: 20px;
    background: linear-gradient(105deg, rgba(76,201,255,.055), transparent 52%), rgba(11,22,32,.9);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
  }

  .callout-index {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(76,201,255,.18);
    border-radius: 11px;
    color: var(--cyan);
    font: 800 9px Inter, sans-serif;
  }

  .callout-main h2 {
    margin: 6px 0 5px;
    font: 700 19px "Space Grotesk", Inter, sans-serif;
    letter-spacing: -.03em;
  }
  .callout-main p, .tracker-heading p, .tracker-note p {
    margin: 0;
    color: #7f94a4;
    font-size: 12px;
    line-height: 1.65;
  }

  .callout-metric {
    min-height: 72px;
    padding-left: 20px;
    border-left: 1px solid rgba(255,255,255,.08);
  }
  .callout-metric small, .callout-metric span {
    display: block;
    font: 800 8px Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .callout-metric small { color: #52697a; }
  .callout-metric strong {
    display: block;
    margin: 7px 0 3px;
    color: var(--cyan-soft);
    font: 700 22px "Space Grotesk", Inter, sans-serif;
  }
  .callout-metric span { color: #6d8392; letter-spacing: .04em; }

  .conditions, .tracker-section { margin-top: 38px; }

  .condition-grid {
    display: grid;
    grid-template-columns: repeat(5,minmax(0,1fr));
    gap: 9px;
  }

  .condition {
    min-height: 120px;
    padding: 16px;
    border: 1px solid rgba(255,255,255,.065);
    border-radius: 16px;
    background: linear-gradient(145deg,#101e2a,#0a141d);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.022);
    transition: transform .28s ease, border-color .28s ease, background .28s ease;
  }
  .condition:hover {
    transform: translateY(-4px);
    border-color: rgba(76,201,255,.2);
    background: linear-gradient(145deg,#122536,#0b151e);
  }
  .condition-number {
    display: block;
    color: #4f687a;
    font: 800 8px Inter, sans-serif;
    letter-spacing: .12em;
  }
  .condition strong {
    display: block;
    margin-top: 21px;
    font: 800 11px "Space Grotesk", Inter, sans-serif;
  }
  .condition p {
    margin: 5px 0 0;
    color: #708597;
    font-size: 9.5px;
    line-height: 1.42;
  }

  .tracker-heading { margin-bottom: 18px; }

  .tracker-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
    color: #64798a;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .tracker-key span { display: inline-flex; align-items: center; gap: 7px; }
  .key-line { width: 21px; height: 4px; border-radius: 999px; background: linear-gradient(90deg,#238bb8,var(--cyan)); }
  .key-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 14px rgba(71,209,108,.42); }

  .player-list { display: grid; gap: 14px; }

  .player-card {
    --card-border: rgba(255,255,255,.075);
    position: relative;
    display: grid;
    grid-template-columns: 42px 180px minmax(0,1fr);
    overflow: hidden;
    border: 1px solid var(--card-border);
    border-radius: 23px;
    background: radial-gradient(500px 240px at 0% 100%, rgba(76,201,255,.035), transparent 72%), linear-gradient(145deg,#0f1b27,#09131c);
    box-shadow: 0 20px 65px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.02);
    opacity: 0;
