<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Player database admin | FCMOBILETOOLS</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap');
:root{color-scheme:dark;--bg:#070b10;--panel:#0d141b;--line:#223743;--text:#f1f8fb;--muted:#91a7b3;--cyan:#61d9ff;--blue:#7393ff;--good:#67e7a6;--bad:#ff968b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(780px 450px at 5% 0,#56d6ff12,transparent 62%),radial-gradient(700px 460px at 97% 3%,#4f7dff12,transparent 60%),var(--bg);color:var(--text);font:14px Manrope,system-ui,sans-serif}.wrap{width:min(1200px,calc(100% - 32px));margin:auto;padding:34px 0 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:27px}.brand{font:700 11px 'IBM Plex Mono',monospace;letter-spacing:.14em;color:var(--cyan)}.top a,.button{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 13px;border:1px solid #2a4553;border-radius:10px;background:#0a161e;color:#d9f3fa;text-decoration:none;font:700 11px Manrope,system-ui,sans-serif;cursor:pointer}.hero{margin-bottom:22px}.eyebrow{margin:0 0 8px;color:var(--cyan);font:700 10px 'IBM Plex Mono',monospace;letter-spacing:.15em}h1{margin:0;font:700 clamp(30px,5vw,48px)/1.05 Sora,system-ui,sans-serif;letter-spacing:-.05em}h2{margin:0;font-size:16px}.hero p:last-child{max-width:720px;color:var(--muted);line-height:1.7}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel{min-width:0;padding:20px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#101a22,#0b1218)}.panel.wide{grid-column:1/-1}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.muted,.hint{color:var(--muted);font-size:12px;line-height:1.65}.row{display:flex;gap:8px;flex-wrap:wrap}.field{display:grid;gap:7px;margin:12px 0}.field span{color:#b7c9d1;font-size:11px;font-weight:700}input,textarea{width:100%;border:1px solid #29414e;border-radius:10px;background:#071117;color:#effaff;padding:11px 12px;font:12px 'IBM Plex Mono',monospace;outline:none}input:focus,textarea:focus{border-color:var(--cyan);box-shadow:0 0 0 3px #56d6ff12}textarea{min-height:260px;resize:vertical;line-height:1.5}.button.primary{border-color:#68dbff;background:linear-gradient(135deg,#67ddff,#43a9e6);color:#03131c}.button.danger{border-color:#5d3738;color:#ffb0a6}.status{min-height:22px;margin-top:10px;color:var(--muted);font-size:12px}.status.error{color:var(--bad)}.status.success{color:var(--good)}.file{max-width:100%;padding:9px;background:#071117;border:1px dashed #385767;border-radius:10px;color:#c7dce5}.preview{margin-top:12px;padding:12px;border-radius:10px;background:#071117;color:#bad0da;font:11px 'IBM Plex Mono',monospace;white-space:pre-wrap}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th,td{padding:10px 8px;border-bottom:1px solid #1f333e;text-align:left;font-size:11px}th{color:#81a1b0;font:700 9px 'IBM Plex Mono',monospace;letter-spacing:.12em}td{color:#d7e8ee}.table-actions{display:flex;gap:6px}.table-actions .button{min-height:30px;padding:0 9px;font-size:10px}.note{margin-top:16px;padding:12px;border:1px solid #4a402b;border-radius:10px;background:#211b111f;color:#d8c99e;font-size:11px;line-height:1.6}@media(max-width:800px){.grid{grid-template-columns:1fr}.panel.wide{grid-column:auto}.top{align-items:flex-start;flex-direction:column}.wrap{padding-top:22px}}
</style></head><body><main class="wrap">
<header class="top"><div class="brand">FCMOBILETOOLS · PLAYER DATABASE ADMIN</div><a href="/admin/">Back to admin workspace</a></header>
<section class="hero"><p class="eyebrow">CATALOG CONTROL</p><h1>Players</h1><p>Add or edit player records, inspect the current catalog, and import validated JSON or CSV in bounded batches. Empty stats and abilities remain empty until verified source data is available.</p></section>
<div class="grid">
<section class="panel"><div class="panel-head"><h2>Add or edit a player</h2><span class="muted">JSON record</span></div><label class="field"><span>Player JSON</span><textarea id="player-json" spellcheck="false">{
  "player_id": 0,
  "name": "",
  "ovr": 1,
  "position": "ST",
  "event": "",
  "alternate_positions": [],
  "stats": {},
  "ranks": [],
  "playstyles": [],
  "traits": []
}</textarea></label><div class="row"><button class="button primary" id="save-player">Save player</button><button class="button" id="clear-player">New record</button></div><div class="status" id="edit-status" role="status"></div></section>
<section class="panel"><div class="panel-head"><h2>Bulk import</h2><span class="muted">JSON or CSV · 100 rows per request</span></div><input class="file" id="import-file" type="file" accept=".json,.csv,application/json,text/csv"><div class="preview" id="import-preview">Choose a file to preview its row count before importing.</div><div class="row"><button class="button primary" id="import-button" disabled>Import validated rows</button></div><div class="status" id="import-status" role="status"></div><p class="hint">JSON accepts an array of players or an object with a <code>players</code> array. CSV uses column headers such as player_id, name, ovr, position, event, club, league and nation. JSON-valued CSV columns can contain stats, ranks, playstyles, traits and assets.</p></section>
<section class="panel wide"><div class="panel-head"><h2>Player catalog</h2><form class="row" id="search-form"><input id="search" type="search" placeholder="Search player, club, or event" aria-label="Search player catalog"><button class="button" type="submit">Search</button><button class="button" id="refresh" type="button">Refresh</button></form></div><div class="table-wrap"><table><thead><tr><th>PLAYER</th><th>OVR</th><th>POSITION</th><th>EVENT</th><th>ACTIONS</th></tr></thead><tbody id="players"><tr><td colspan="5">Loading catalog…</td></tr></tbody></table></div><div class="status" id="list-status" role="status"></div></section>
</div>
<p class="note">Artwork is loaded through the player asset registry. Add only assets whose reuse is approved, and record source, attribution, and license information in each asset mapping.</p>
</main>
<script type="module">
const $=(selector)=>document.querySelector(selector), esc=(value='')=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(path,options={}){const response=await fetch('/api/admin/player-database'+path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});const body=await response.json().catch(()=>({}));if(!response.ok)throw new Error(body.error||'Player database request failed.');return body}
function status(node,message,type=''){node.textContent=message;node.className='status '+type}
async function loadPlayers(){const body=$('#players');status($('#list-status'),'Loading catalog…');try{const query=new URLSearchParams({limit:'50',q:$('#search').value.trim()});const data=await api('?'+query);body.innerHTML=(data.players||[]).map(player=>'<tr><td><b>'+esc(player.name)+'</b><br><small>'+esc(player.player_id)+'</small></td><td>'+esc(player.ovr)+'</td><td>'+esc(player.position)+'</td><td>'+esc(player.event||'—')+'</td><td><div class="table-actions"><button class="button" data-edit="'+esc(player.player_id)+'">Edit</button><button class="button danger" data-archive="'+esc(player.player_id)+'">Archive</button></div></td></tr>').join('')||'<tr><td colspan="5">No active player records found.</td></tr>';status($('#list-status'),(data.players||[]).length+' records shown.')}catch(error){body.innerHTML='<tr><td colspan="5">Catalog unavailable.</td></tr>';status($('#list-status'),error.message,'error')}}
$('#search-form').addEventListener('submit',event=>{event.preventDefault();loadPlayers()});$('#refresh').addEventListener('click',loadPlayers);
$('#players').addEventListener('click',async event=>{const edit=event.target.closest('[data-edit]'),archive=event.target.closest('[data-archive]');try{if(edit){const player=await api('/'+edit.dataset.edit);$('#player-json').value=JSON.stringify(player,null,2);status($('#edit-status'),'Loaded '+player.name+'.')}if(archive&&confirm('Archive this player from public search?')){await api('/'+archive.dataset.archive,{method:'DELETE'});status($('#list-status'),'Player archived.','success');loadPlayers()}}catch(error){status($('#list-status'),error.message,'error')}});
$('#save-player').addEventListener('click',async()=>{try{const player=JSON.parse($('#player-json').value);const result=await api('',{method:'POST',body:JSON.stringify(player)});status($('#edit-status'),'Saved player '+result.player_ids[0]+'.','success');loadPlayers()}catch(error){status($('#edit-status'),error.message,'error')}});
$('#clear-player').addEventListener('click',()=>{$('#player-json').value=JSON.stringify({player_id:0,name:'',ovr:1,position:'ST',event:'',alternate_positions:[],stats:{},ranks:[],playstyles:[],traits:[]},null,2);status($('#edit-status'),'Ready for a new record.')});
function parseCsv(text){const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const ch=text[i];if(quoted){if(ch==='"'&&text[i+1]==='"'){cell+='"';i++}else if(ch==='"')quoted=false;else cell+=ch}else if(ch==='"')quoted=true;else if(ch===','){row.push(cell);cell=''}else if(ch==='\n'){row.push(cell.replace(/\r$/,''));rows.push(row);row=[];cell=''}else cell+=ch}if(quoted)throw Error('CSV ends inside a quoted value.');if(cell.length||row.length){row.push(cell.replace(/\r$/,''));rows.push(row)}const headers=(rows.shift()||[]).map(x=>x.trim().toLowerCase().replace(/[\s-]+/g,'_'));return rows.filter(r=>r.some(v=>v.trim())).map(values=>Object.fromEntries(headers.map((key,i)=>[key,values[i]??'']))).map(row=>{for(const key of ['stats','ranks','playstyles','traits','assets','alternate_positions'])if(row[key]){try{row[key]=JSON.parse(row[key])}catch{if(key==='alternate_positions')row[key]=row[key].split(/[|;]/).map(x=>x.trim()).filter(Boolean);else throw Error('CSV '+key+' cells must contain valid JSON.')}}for(const key of ['player_id','ovr','skill_moves','weak_foot','height_cm','weight_kg'])if(row[key]!==undefined&&row[key]!=='')row[key]=Number(row[key]);return row})}
let imported=[];$('#import-file').addEventListener('change',async event=>{imported=[];$('#import-button').disabled=true;try{const file=event.target.files?.[0];if(!file)return;const text=await file.text();imported=file.name.toLowerCase().endsWith('.csv')?parseCsv(text):(()=>{const parsed=JSON.parse(text);return Array.isArray(parsed)?parsed:parsed.players})()||[];if(!Array.isArray(imported)||!imported.length)throw Error('File must contain at least one player row.');$('#import-preview').textContent=imported.length+' rows detected. Preview: '+JSON.stringify(imported.slice(0,2),null,2).slice(0,1500);$('#import-button').disabled=false;status($('#import-status'),'Review the preview before importing.')}catch(error){$('#import-preview').textContent='Import preview failed.';status($('#import-status'),error.message,'error')}});
$('#import-button').addEventListener('click',async()=>{if(!imported.length)return;const button=$('#import-button');button.disabled=true;let total=0;try{for(let i=0;i<imported.length;i+=100){const result=await api('',{method:'POST',body:JSON.stringify({players:imported.slice(i,i+100)})});total+=result.imported;status($('#import-status'),'Imported '+total+' of '+imported.length+' rows…')}status($('#import-status'),'Imported '+total+' player records.','success');$('#import-preview').textContent='Import complete: '+total+' rows.';loadPlayers()}catch(error){status($('#import-status'),'Stopped after '+total+' rows: '+error.message,'error')}finally{button.disabled=false}});
loadPlayers();
</script></body></html>
