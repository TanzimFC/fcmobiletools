---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromPath, localizeHref, namespace } from '../i18n/index.js';
import { TOPIC_KEYS } from '../lib/pushCore.js';
import { pushIcon } from '../lib/pushIcons.js';

const locale = getLocaleFromPath(Astro.url.pathname);
const P = namespace(locale, 'push');
const topics = TOPIC_KEYS.map((key) => ({ key, ...P.topics[key] }));
---

<BaseLayout title={P.page.title} description={P.page.description} robots="noindex,nofollow" googlebot="noindex,nofollow">
  <main class="push-page" data-push-page>
    <div class="push-shell">
      <a class="push-back" href={localizeHref('/', locale)}>{'\u2190 ' + P.page.back}</a>

      <header class="push-hero">
        <span class="push-eyebrow"><span class="push-live-dot"></span> {P.page.eyebrow}</span>
        <h1>{P.page.h1}</h1>
        <p>{P.page.lede}</p>
        <div class="push-promise"><span aria-hidden="true">{'\u2713'}</span> {P.page.promise}</div>
      </header>

      <section class="push-panel" aria-labelledby="push-panel-title">
        <div class="push-panel-head">
          <div>
            <span class="push-kicker">{P.page.eyebrow}</span>
            <h2 id="push-panel-title">{P.page.panelTitle}</h2>
            <p>{P.page.panelSub}</p>
          </div>
          <span class="push-status" id="pushStatus" data-state="idle" role="status"><i aria-hidden="true"></i><span>{P.panel.off}</span></span>
        </div>

        <p class="push-note" id="pushNote" hidden></p>

        <div class="push-topic-list" id="pushTopics" data-pending="true">
          {topics.map((topic) => (
            <label class="push-topic">
              <span class="push-topic-icon" aria-hidden="true" set:html={pushIcon(topic.key, 18, 1.9)}></span>
              <span class="push-topic-copy"><strong>{topic.label}</strong><small>{topic.blurb}</small></span>
              <input type="checkbox" data-push-topic={topic.key} />
              <span class="push-switch" aria-hidden="true"></span>
            </label>
          ))}
        </div>

        <div class="push-actions">
          <button class="push-btn push-primary" id="pushEnable" type="button">{P.panel.enable}</button>
          <button class="push-btn push-quiet" id="pushPause" type="button" hidden>{P.panel.pause}</button>
        </div>
        <p class="push-flash" id="pushFlash" role="status" aria-live="polite"></p>
      </section>

      <div class="push-detail-grid">
        <section class="push-detail"><span class="push-detail-number">01</span><h3>{P.page.b1t}</h3><p>{P.page.b1d}</p></section>
        <section class="push-detail"><span class="push-detail-number">02</span><h3>{P.page.b2t}</h3><p>{P.page.b2d}</p></section>
        <section class="push-detail"><span class="push-detail-number">03</span><h3>{P.page.b3t}</h3><p>{P.page.b3d}</p></section>
      </div>
    </div>
  </main>
  <script type="application/json" id="push-page-i18n" is:inline set:html={JSON.stringify({ panel: P.panel, states: P.states }).replace(/</g, '\\u003c')}></script>
  <script>import '../scripts/push-page.js';</script>
</BaseLayout>

<style>
.push-page{--push-line:rgba(255,255,255,.09);--push-muted:#9cabb9;min-height:72vh;padding:clamp(28px,5vw,62px) 18px 24px;color:#f5f8fb}
.push-shell{width:min(1050px,100%);margin:0 auto}
.push-back{display:inline-flex;align-items:center;gap:8px;color:#9aaaba;text-decoration:none;font:700 12px/1.2 var(--font-body);transition:color .2s}
.push-back:hover{color:#8fe3ff}
.push-hero{padding:clamp(35px,6vw,64px) 0 34px;max-width:790px}
.push-eyebrow,.push-kicker{display:inline-flex;align-items:center;gap:9px;color:#7edaff;font:800 10px/1.3 var(--font-body);letter-spacing:.16em;text-transform:uppercase}
.push-live-dot{width:7px;height:7px;border-radius:50%;background:#47d16c;box-shadow:0 0 14px rgba(71,209,108,.48)}
.push-hero h1{max-width:700px;margin:18px 0 15px;font:800 clamp(38px,7vw,68px)/.98 var(--font-display);letter-spacing:-.055em}
.push-hero>p{max-width:660px;margin:0;color:#aab8c7;font:500 clamp(14px,2vw,16px)/1.8 var(--font-body)}
.push-promise{display:inline-flex;align-items:center;gap:8px;margin-top:22px;padding:10px 13px;border:1px solid rgba(76,201,255,.2);border-radius:var(--r-md);background:rgba(76,201,255,.06);color:#c8eefa;font:700 11px/1.3 var(--font-body)}
.push-promise span{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;background:rgba(71,209,108,.15);color:#73e696}
.push-panel{position:relative;padding:clamp(20px,4vw,32px);border:1px solid var(--push-line);border-radius:var(--r-lg);background:linear-gradient(145deg,rgba(18,34,49,.96),rgba(8,18,27,.98));box-shadow:0 28px 80px rgba(0,0,0,.24),0 1px 0 rgba(255,255,255,.04) inset;overflow:hidden}
.push-panel:before{content:"";position:absolute;left:7%;right:7%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(76,201,255,.65),transparent)}
.push-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding-bottom:23px;border-bottom:1px solid var(--push-line)}
.push-panel h2,.push-not-ready h2{margin:8px 0 7px;font:800 clamp(23px,3vw,31px)/1.1 var(--font-display);letter-spacing:-.035em}
.push-panel-head p,.push-not-ready>p{max-width:510px;margin:0;color:var(--push-muted);font:500 12.5px/1.65 var(--font-body)}
.push-status{display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;padding:9px 11px;border:1px solid rgba(255,255,255,.09);border-radius:999px;background:rgba(255,255,255,.035);color:#aab8c7;font:800 10px/1 var(--font-body);white-space:nowrap}
.push-status i{width:6px;height:6px;border-radius:50%;background:#8b9cad}
.push-status[data-state="ready"]{border-color:rgba(76,201,255,.23);background:rgba(76,201,255,.08);color:#9de7ff}
.push-status[data-state="ready"] i{background:#4cc9ff;box-shadow:0 0 10px rgba(76,201,255,.65)}
.push-status[data-state="on"]{border-color:rgba(71,209,108,.24);background:rgba(71,209,108,.08);color:#8ce9a8}
.push-status[data-state="on"] i{background:#47d16c;box-shadow:0 0 10px rgba(71,209,108,.6)}
.push-status[data-state="error"]{border-color:rgba(255,125,125,.23);background:rgba(255,125,125,.07);color:#ffadad}
.push-status[data-state="error"] i{background:#ff8181}
.push-topic-list{display:grid;gap:9px;margin-top:21px}
.push-topic{position:relative;display:flex;align-items:center;gap:13px;min-height:76px;padding:14px 16px;border:1px solid rgba(255,255,255,.065);border-radius:var(--r-lg);background:rgba(255,255,255,.022);cursor:pointer;transition:border-color .2s,background .2s,transform .2s}
.push-topic:hover{border-color:rgba(76,201,255,.22);background:rgba(76,201,255,.035);transform:translateY(-1px)}
.push-topic:has(input:checked){border-color:rgba(76,201,255,.23);background:linear-gradient(110deg,rgba(76,201,255,.075),rgba(255,255,255,.015))}
.push-topic-icon{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:var(--r-md);background:rgba(76,201,255,.08);color:#8fe3ff;font:700 18px/1 var(--font-display)}
.push-topic-copy{display:grid;gap:5px;min-width:0;flex:1}
.push-topic-copy strong{color:#f3f7fa;font:800 12.5px/1.2 var(--font-body)}
.push-topic-copy small{color:#8fa1b1;font:500 11.5px/1.5 var(--font-body)}
.push-topic input{position:absolute;width:1px;height:1px;opacity:0}
.push-switch{position:relative;flex:0 0 43px;width:43px;height:25px;border:1px solid rgba(255,255,255,.13);border-radius:99px;background:#192836;transition:background .2s,border-color .2s}
.push-switch:after{content:"";position:absolute;left:3px;top:3px;width:17px;height:17px;border-radius:50%;background:#7d8d9c;transition:transform .22s,background .2s}
.push-topic input:checked~.push-switch{border-color:rgba(76,201,255,.5);background:rgba(76,201,255,.24)}
.push-topic input:checked~.push-switch:after{transform:translateX(18px);background:#8fe3ff}
.push-topic input:focus-visible~.push-switch{outline:2px solid #4cc9ff;outline-offset:3px}
.push-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}
.push-btn{min-height:45px;padding:0 16px;border:1px solid var(--push-line);border-radius:var(--r-md);background:rgba(255,255,255,.035);color:#dfe8ef;font:800 11.5px/1 var(--font-body);cursor:pointer;transition:transform .2s,border-color .2s,background .2s,opacity .2s}
.push-btn:hover:not(:disabled){transform:translateY(-1px);border-color:rgba(76,201,255,.3)}
.push-btn:disabled{opacity:.42;cursor:not-allowed}
.push-primary{border-color:transparent;background:linear-gradient(135deg,#a3eaff,#4cc9ff 60%,#2daee8);color:#06131b;box-shadow:0 10px 28px rgba(76,201,255,.12)}
.push-secondary{background:rgba(76,201,255,.08);border-color:rgba(76,201,255,.18)}
.push-quiet{margin-left:auto;background:transparent;color:#9cabb9}
.push-message{min-height:20px;margin:15px 0 0;color:#9bb0be;font:600 11px/1.55 var(--font-body)}
.push-message[data-state="success"]{color:#83e49e}
.push-message[data-state="error"]{color:#ffadad}
.push-footnote{margin:11px 0 0;color:#76899a;font:500 10.5px/1.6 var(--font-body)}
.push-not-ready{margin-bottom:0}
.push-not-ready h2{margin-top:10px}
.push-detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}
.push-detail{padding:20px 19px;border:1px solid rgba(255,255,255,.065);border-radius:var(--r-lg);background:rgba(14,26,38,.62)}
.push-detail-number{color:#5fcfff;font:800 10px/1 var(--font-body);letter-spacing:.12em}
.push-detail h3{margin:13px 0 7px;color:#eaf1f6;font:800 13px/1.2 var(--font-body)}
.push-detail p{margin:0;color:#8b9dad;font:500 11.5px/1.65 var(--font-body)}
@media(max-width:700px){.push-page{padding-inline:13px}.push-panel-head{flex-direction:column}.push-detail-grid{grid-template-columns:1fr}.push-detail{padding:17px}.push-quiet{margin-left:0}.push-actions{display:grid;grid-template-columns:1fr 1fr}.push-primary{grid-column:1/-1}.push-topic{gap:10px;padding:12px}.push-topic-icon{width:32px;height:32px;flex-basis:32px}}
@media(prefers-reduced-motion:reduce){.push-topic,.push-btn,.push-switch,.push-switch:after{transition:none!important}}

.push-ios{margin:18px 0 0;padding:16px 18px;border:1px solid rgba(255,189,89,.3);border-radius:var(--r-lg);background:rgba(255,189,89,.07);color:#ffd9a0;font:600 12.5px/1.65 var(--font-body)}
.push-note{margin:16px 0 0;padding:12px 14px;border:1px solid rgba(255,189,89,.28);border-radius:var(--r-md);background:rgba(255,189,89,.07);color:#ffd9a0;font:600 12.5px/1.6 var(--font-body)}
.push-note[hidden],.push-ios[hidden]{display:none}
.push-topic-list[data-pending="true"] .push-topic{opacity:.74}
.push-topic input:disabled~.push-switch{opacity:.5}
.push-flash{min-height:20px;margin:14px 0 0;font:600 12px/1.55 var(--font-body);color:#9bb0be}
.push-flash[data-tone="good"]{color:#83e49e}.push-flash[data-tone="bad"]{color:#ffadad}
.push-status[data-state="paused"],.push-status[data-state="blocked"]{border-color:rgba(255,189,89,.28);background:rgba(255,189,89,.07);color:#ffd9a0}
</style>
