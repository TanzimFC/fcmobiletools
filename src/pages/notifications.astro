---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ONESIGNAL_APP_ID, ONESIGNAL_ENABLED } from '../config/siteNotifications.js';
---

<BaseLayout
  title="Push Alerts | FCMobiletools"
  description="Choose which FC Mobile Tools updates can reach your browser through optional push alerts."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="push-page" data-onesignal-app-id={ONESIGNAL_APP_ID}>
    <div class="push-shell">
      <a class="push-back" href="/">← Back to FCMOBILETOOLS</a>

      <header class="push-hero">
        <span class="push-eyebrow"><span class="push-live-dot"></span> FCMOBILETOOLS / ALERTS</span>
        <h1>Only the alerts you choose.</h1>
        <p>Get new redeem codes and live-event updates without checking the site every time. You control the topics, and the browser permission prompt appears only when you press Enable.</p>
        <div class="push-promise"><span aria-hidden="true">✓</span> Site updates only. No third-party push ads.</div>
      </header>

      {ONESIGNAL_ENABLED ? (
        <section class="push-panel" aria-labelledby="push-panel-title">
          <div class="push-panel-head">
            <div>
              <span class="push-kicker">YOUR PREFERENCES</span>
              <h2 id="push-panel-title">Choose your alerts</h2>
              <p>Choose your topics, save them, then enable alerts for this browser.</p>
            </div>
            <span class="push-status" id="pushStatus" data-state="idle" role="status">
              <i aria-hidden="true"></i><span>Connecting</span>
            </span>
          </div>

          <div class="push-topic-list">
            <label class="push-topic">
              <span class="push-topic-icon" aria-hidden="true">⌁</span>
              <span class="push-topic-copy"><strong>Redeem codes</strong><small>New code drops and important code status changes.</small></span>
              <input type="checkbox" data-push-topic="notify_redeem_codes" checked />
              <span class="push-switch" aria-hidden="true"></span>
            </label>
            <label class="push-topic">
              <span class="push-topic-icon" aria-hidden="true">◷</span>
              <span class="push-topic-copy"><strong>Live events</strong><small>New events, schedule changes and reset reminders.</small></span>
              <input type="checkbox" data-push-topic="notify_live_events" checked />
              <span class="push-switch" aria-hidden="true"></span>
            </label>
            <label class="push-topic">
              <span class="push-topic-icon" aria-hidden="true">✦</span>
              <span class="push-topic-copy"><strong>Giveaways</strong><small>Giveaway openings, draw results and winner notices.</small></span>
              <input type="checkbox" data-push-topic="notify_giveaways" />
              <span class="push-switch" aria-hidden="true"></span>
            </label>
            <label class="push-topic">
              <span class="push-topic-icon" aria-hidden="true">↗</span>
              <span class="push-topic-copy"><strong>New tools and site updates</strong><small>Major feature releases, not routine site activity.</small></span>
              <input type="checkbox" data-push-topic="notify_site_updates" />
              <span class="push-switch" aria-hidden="true"></span>
            </label>
          </div>

          <div class="push-actions">
            <button class="push-btn push-primary" id="pushEnable" type="button" disabled>Enable push alerts</button>
            <button class="push-btn push-secondary" id="pushSave" type="button" disabled>Save topics</button>
            <button class="push-btn push-quiet" id="pushPause" type="button" disabled>Pause alerts</button>
          </div>
          <p class="push-message" id="pushMessage" aria-live="polite">Loading notification controls. No permission prompt has been shown.</p>
          <p class="push-footnote">Alerts are optional. You can pause them here or block them in your browser’s site settings. Topic choices are saved on this device and synced to OneSignal when available.</p>
        </section>
      ) : (
        <section class="push-panel push-not-ready" aria-labelledby="push-panel-title">
          <span class="push-kicker">SETUP PENDING</span>
          <h2 id="push-panel-title">Push alerts are not active yet.</h2>
          <p>OneSignal has not been configured for this production build. No browser prompt will appear. This page activates after the site owner adds the public OneSignal App ID to the build settings.</p>
        </section>
      )}

      <div class="push-detail-grid">
        <section class="push-detail">
          <span class="push-detail-number">01</span>
          <h3>You choose the topics</h3>
          <p>Redeem codes and live events are selected by default. Giveaways and product updates stay off until you choose them.</p>
        </section>
        <section class="push-detail">
          <span class="push-detail-number">02</span>
          <h3>No surprise prompts</h3>
          <p>Opening the site does not request browser permission. You must press Enable on this page first.</p>
        </section>
        <section class="push-detail">
          <span class="push-detail-number">03</span>
          <h3>Pause whenever</h3>
          <p>Use Pause alerts to stop delivery to this browser, or change the site permission in your browser settings.</p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
.push-page{--push-line:rgba(255,255,255,.09);--push-muted:#9cabb9;min-height:72vh;padding:clamp(28px,5vw,62px) 18px 24px;color:#f5f8fb}
.push-shell{width:min(1050px,100%);margin:0 auto}
.push-back{display:inline-flex;align-items:center;gap:8px;color:#9aaaba;text-decoration:none;font:700 12px/1.2 var(--font-body);transition:color .2s}
.push-back:hover{color:#8fe3ff}
.push-hero{padding:clamp(35px,6vw,64px) 0 34px;max-width:790px}
.push-eyebrow,.push-kicker{display:inline-flex;align-items:center;gap:9px;color:#7edaff;font:800 10px/1.3 var(--font-body);letter-spacing:.16em;text-transform:uppercase}
.push-live-dot{width:7px;height:7px;border-radius:50%;background:#47d16c;box-shadow:0 0 14px rgba(71,209,108,.48)}
.push-hero h1{max-width:700px;margin:18px 0 15px;font:800 clamp(38px,7vw,68px)/.98 var(--font-display);letter-spacing:-.055em}
.push-hero>p{max-width:660px;margin:0;color:#aab8c7;font:500 clamp(14px,2vw,16px)/1.8 var(--font-body)}
.push-promise{display:inline-flex;align-items:center;gap:8px;margin-top:22px;padding:10px 13px;border:1px solid rgba(76,201,255,.2);border-radius:12px;background:rgba(76,201,255,.06);color:#c8eefa;font:700 11px/1.3 var(--font-body)}
.push-promise span{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;background:rgba(71,209,108,.15);color:#73e696}
.push-panel{position:relative;padding:clamp(20px,4vw,32px);border:1px solid var(--push-line);border-radius:26px;background:linear-gradient(145deg,rgba(18,34,49,.96),rgba(8,18,27,.98));box-shadow:0 28px 80px rgba(0,0,0,.24),0 1px 0 rgba(255,255,255,.04) inset;overflow:hidden}
.push-panel:before{content:"";position:absolute;left:7%;right:7%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(76,201,255,.65),transparent)}
.push-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding-bottom:23px;border-bottom:1px solid var(--push-line)}
.push-panel h2,.push-not-ready h2{margin:8px 0 7px;font:800 clamp(23px,3vw,31px)/1.1 var(--font-display);letter-spacing:-.035em}
.push-panel-head p,.push-not-ready>p{max-width:510px;margin:0;color:var(--push-muted);font:500 12.5px/1.65 var(--font-body)}
.push-status{display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;padding:9px 11px;border:1px solid rgba(255,255,255,.09);border-radius:999px;background:rgba(255,255,255,.035);color:#aab8c7;font:800 10px/1 var(--font-body);white-space:nowrap}
.push-status i{width:6px;height:6px;border-radius:50%;background:#8b9cad}
.push-status[data-state="ready"]{border-color:rgba(76,201,255,.23);background:rgba(76,201,255,.08);color:#9de7ff}
.push-status[data-state="ready"] i{background:#4cc9ff;box-shadow:0 0 10px rgba(76,201,255,.65)}
.push-status[data-state="on"]{border-color:rgba(71,209,108,.24);background:rgba(71,209,108,.08);color:#8ce9a8}
.push-status[data-state="on"] i{background:#47d16c;box-shadow:0 0 10px rgba(71,209,108,.6)}
.push-status[data-state="error"]{border-color:rgba(255,125,125,.23);background:rgba(255,125,125,.07);color:#ffadad}
.push-status[data-state="error"] i{background:#ff8181}
.push-topic-list{display:grid;gap:9px;margin-top:21px}
.push-topic{position:relative;display:flex;align-items:center;gap:13px;min-height:76px;padding:14px 16px;border:1px solid rgba(255,255,255,.065);border-radius:16px;background:rgba(255,255,255,.022);cursor:pointer;transition:border-color .2s,background .2s,transform .2s}
.push-topic:hover{border-color:rgba(76,201,255,.22);background:rgba(76,201,255,.035);transform:translateY(-1px)}
.push-topic:has(input:checked){border-color:rgba(76,201,255,.23);background:linear-gradient(110deg,rgba(76,201,255,.075),rgba(255,255,255,.015))}
.push-topic-icon{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;border-radius:12px;background:rgba(76,201,255,.08);color:#8fe3ff;font:700 18px/1 var(--font-display)}
.push-topic-copy{display:grid;gap:5px;min-width:0;flex:1}
.push-topic-copy strong{color:#f3f7fa;font:800 12.5px/1.2 var(--font-body)}
.push-topic-copy small{color:#8fa1b1;font:500 11.5px/1.5 var(--font-body)}
.push-topic input{position:absolute;width:1px;height:1px;opacity:0}
.push-switch{position:relative;flex:0 0 43px;width:43px;height:25px;border:1px solid rgba(255,255,255,.13);border-radius:99px;background:#192836;transition:background .2s,border-color .2s}
.push-switch:after{content:"";position:absolute;left:3px;top:3px;width:17px;height:17px;border-radius:50%;background:#7d8d9c;transition:transform .22s,background .2s}
.push-topic input:checked~.push-switch{border-color:rgba(76,201,255,.5);background:rgba(76,201,255,.24)}
.push-topic input:checked~.push-switch:after{transform:translateX(18px);background:#8fe3ff}
.push-topic input:focus-visible~.push-switch{outline:2px solid #4cc9ff;outline-offset:3px}
.push-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}
.push-btn{min-height:45px;padding:0 16px;border:1px solid var(--push-line);border-radius:13px;background:rgba(255,255,255,.035);color:#dfe8ef;font:800 11.5px/1 var(--font-body);cursor:pointer;transition:transform .2s,border-color .2s,background .2s,opacity .2s}
.push-btn:hover:not(:disabled){transform:translateY(-1px);border-color:rgba(76,201,255,.3)}
.push-btn:disabled{opacity:.42;cursor:not-allowed}
.push-primary{border-color:transparent;background:linear-gradient(135deg,#a3eaff,#4cc9ff 60%,#2daee8);color:#06131b;box-shadow:0 10px 28px rgba(76,201,255,.12)}
.push-secondary{background:rgba(76,201,255,.08);border-color:rgba(76,201,255,.18)}
.push-quiet{margin-left:auto;background:transparent;color:#9cabb9}
.push-message{min-height:20px;margin:15px 0 0;color:#9bb0be;font:600 11px/1.55 var(--font-body)}
.push-message[data-state="success"]{color:#83e49e}
.push-message[data-state="error"]{color:#ffadad}
.push-footnote{margin:11px 0 0;color:#76899a;font:500 10.5px/1.6 var(--font-body)}
.push-not-ready{margin-bottom:0}
.push-not-ready h2{margin-top:10px}
.push-detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:14px}
.push-detail{padding:20px 19px;border:1px solid rgba(255,255,255,.065);border-radius:18px;background:rgba(14,26,38,.62)}
.push-detail-number{color:#5fcfff;font:800 10px/1 var(--font-body);letter-spacing:.12em}
.push-detail h3{margin:13px 0 7px;color:#eaf1f6;font:800 13px/1.2 var(--font-body)}
.push-detail p{margin:0;color:#8b9dad;font:500 11.5px/1.65 var(--font-body)}
@media(max-width:700px){.push-page{padding-inline:13px}.push-panel-head{flex-direction:column}.push-detail-grid{grid-template-columns:1fr}.push-detail{padding:17px}.push-quiet{margin-left:0}.push-actions{display:grid;grid-template-columns:1fr 1fr}.push-primary{grid-column:1/-1}.push-topic{gap:10px;padding:12px}.push-topic-icon{width:32px;height:32px;flex-basis:32px}}
@media(prefers-reduced-motion:reduce){.push-topic,.push-btn,.push-switch,.push-switch:after{transition:none!important}}
</style>

<script define:vars={{ appId: ONESIGNAL_APP_ID }}>
(() => {
  const page = document.querySelector('.push-page[data-onesignal-app-id]');
  if (!page || !appId) return;

  const statusEl = document.getElementById('pushStatus');
  const statusText = statusEl?.querySelector('span');
  const messageEl = document.getElementById('pushMessage');
  const enableButton = document.getElementById('pushEnable');
  const saveButton = document.getElementById('pushSave');
  const pauseButton = document.getElementById('pushPause');
  const topicInputs = [...document.querySelectorAll('[data-push-topic]')];
  const preferenceKey = 'fcmt:push-preferences:v1';
  const defaultPreferences = {
    notify_redeem_codes: true,
    notify_live_events: true,
    notify_giveaways: false,
    notify_site_updates: false
  };
  let oneSignal = null;

  const permission = () => ('Notification' in window ? Notification.permission : 'unsupported');
  const currentPreferences = () => Object.fromEntries(topicInputs.map((input) => [input.dataset.pushTopic, input.checked]));
  const readPreferences = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(preferenceKey) || 'null');
      return { ...defaultPreferences, ...(saved && typeof saved === 'object' ? saved : {}) };
    } catch {
      return { ...defaultPreferences };
    }
  };
  const setMessage = (message, state = 'idle') => {
    if (!messageEl) return;
    messageEl.textContent = message;
    messageEl.dataset.state = state;
  };
  const setStatus = (message, state = 'idle') => {
    if (!statusEl || !statusText) return;
    statusText.textContent = message;
    statusEl.dataset.state = state;
  };

  const loadPreferencesIntoForm = () => {
    const saved = readPreferences();
    topicInputs.forEach((input) => { input.checked = saved[input.dataset.pushTopic] !== false; });
  };

  const applyTopicTags = async () => {
    if (!oneSignal?.User?.addTags) return;
    const preferences = currentPreferences();
    await oneSignal.User.addTags(Object.fromEntries(
      Object.entries(preferences).map(([key, enabled]) => [key, enabled ? 'true' : 'false'])
    ));
  };

  const refreshStatus = () => {
    const optedIn = Boolean(oneSignal?.User?.PushSubscription?.optedIn);
    const currentPermission = permission();
    if (currentPermission === 'unsupported') {
      setStatus('Not supported', 'error');
      setMessage('This browser does not expose the notification permission API. Try a current version of Chrome, Edge, Firefox or Safari.', 'error');
    } else if (currentPermission === 'denied') {
      setStatus('Blocked in browser', 'error');
      setMessage('Notifications are blocked for this site in your browser settings. Change that permission there before trying again.', 'error');
    } else if (optedIn) {
      setStatus('Alerts enabled', 'on');
      setMessage('This browser is subscribed. Your selected topics are saved.', 'success');
    } else if (currentPermission === 'granted') {
      setStatus('Permission granted', 'ready');
      setMessage('Browser permission is available. Press Enable to resume delivery on this device.', 'idle');
    } else {
      setStatus('Not enabled', 'idle');
      setMessage('No notifications will be sent until you enable them and grant browser permission.', 'idle');
    }
    if (enableButton) {
      enableButton.disabled = !oneSignal || currentPermission === 'unsupported' || currentPermission === 'denied' || optedIn;
      enableButton.textContent = optedIn ? 'Alerts are enabled' : currentPermission === 'granted' ? 'Resume push alerts' : 'Enable push alerts';
    }
    if (pauseButton) pauseButton.disabled = !oneSignal || !optedIn;
    if (saveButton) saveButton.disabled = !oneSignal;
  };

  const sdkReady = new Promise((resolve, reject) => {
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    window.OneSignalDeferred.push(async (OneSignal) => {
      try {
        await OneSignal.init({
          appId,
          serviceWorkerPath: 'onesignal/OneSignalSDKWorker.js',
          serviceWorkerParam: { scope: '/onesignal/' }
        });
        oneSignal = OneSignal;
        resolve(OneSignal);
      } catch (error) {
        reject(error);
      }
    });

    const script = document.createElement('script');
    script.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
    script.async = true;
    script.onerror = () => reject(new Error('The OneSignal library could not be loaded.'));
    document.head.appendChild(script);
  });

  topicInputs.forEach((input) => {
    input.addEventListener('change', () => setMessage('Topic edits are not saved yet. Select Save topics to apply them.', 'idle'));
  });

  saveButton?.addEventListener('click', async () => {
    if (!oneSignal) return;
    saveButton.disabled = true;
    try {
      const preferences = currentPreferences();
      localStorage.setItem(preferenceKey, JSON.stringify(preferences));
      await applyTopicTags();
      setMessage('Your topic preferences have been saved on this device.', 'success');
    } catch {
      setMessage('Preferences were saved on this device, but OneSignal could not sync them. Try again.', 'error');
    } finally {
      refreshStatus();
    }
  });

  enableButton?.addEventListener('click', async () => {
    if (!oneSignal) return;
    enableButton.disabled = true;
    try {
      if (permission() !== 'granted') await oneSignal.Notifications.requestPermission();
      if (permission() !== 'granted') {
        refreshStatus();
        setMessage('Permission was not granted. Nothing was enabled.', 'idle');
        return;
      }
      await oneSignal.User.PushSubscription.optIn();
      localStorage.setItem('fcmt:onesignal:active:v1', '1');
      await applyTopicTags();
      refreshStatus();
      setMessage('Push alerts are enabled for this browser. You can pause them here at any time.', 'success');
    } catch (error) {
      refreshStatus();
      setMessage(error?.message || 'Could not enable push alerts. Please try again.', 'error');
    }
  });

  pauseButton?.addEventListener('click', async () => {
    if (!oneSignal) return;
    pauseButton.disabled = true;
    try {
      await oneSignal.User.PushSubscription.optOut();
      localStorage.setItem('fcmt:onesignal:active:v1', '0');
      refreshStatus();
      setMessage('Alerts are paused on this browser. Browser permission has not been changed.', 'success');
    } catch (error) {
      refreshStatus();
      setMessage(error?.message || 'Could not pause alerts. Please try again.', 'error');
    }
  });

  loadPreferencesIntoForm();
  setStatus('Connecting', 'idle');
  setMessage('Loading notification controls. No permission prompt has been shown.', 'idle');

  sdkReady.then(async () => {
    if (permission() !== 'unsupported') {
      try { await applyTopicTags(); } catch {}
    }
    refreshStatus();
    if (permission() !== 'denied') {
      setMessage('Notification controls are ready. No browser prompt has been shown.', 'success');
    }
  }).catch(() => {
    setStatus('Unavailable', 'error');
    setMessage('The notification service could not be reached. You can keep using the site; no permission was requested.', 'error');
    if (enableButton) enableButton.disabled = true;
    if (saveButton) saveButton.disabled = true;
    if (pauseButton) pauseButton.disabled = true;
  });
})();
</script>
