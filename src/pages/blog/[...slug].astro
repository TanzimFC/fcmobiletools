---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WarningBox from '../../components/article/WarningBox.astro';
import { getCollection, render } from 'astro:content';

const slugify=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft))
  .sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));

export async function getStaticPaths(){
  const postsForPaths=await getCollection('blog',({data})=>data.status==='published'&&!data.draft);
  return postsForPaths.map((post)=>({params:{slug:post.slug},props:{post}}));
}

const {post}=Astro.props;
const {Content}=await render(post);
const others=posts.filter((item)=>item.slug!==post.slug);
const related=others.filter((item)=>{
  const tags=(item.data.tags??[]);
  const own=(post.data.tags??[]);
  return item.data.type===post.data.type || item.data.category===post.data.category || tags.some((tag)=>own.includes(tag));
}).slice(0,6);
const featured=others.filter((item)=>item.data.featured).slice(0,4);
const toolCatalog={
  '/redeem-codes':{title:'Redeem Codes',label:'Live tool',description:'Check current FC Mobile codes and move straight to redemption.'},
  '/team-ovr':{title:'Team OVR Calculator',label:'Calculator',description:'Work out your squad OVR before changing the lineup.'},
  '/training-calculator':{title:'Training Calculator',label:'Calculator',description:'Plan XP, fodder, levels and excess XP before spending resources.'},
  '/rank-up-calculator':{title:'Rank Up Calculator',label:'Calculator',description:'Compare Rank Up Point routes and see the effect before committing.'},
  '/football-centre':{title:'Football Centre',label:'Live tool',description:'Track matches, points, rewards and event resources in one place.'},
  '/gauntlet-planner':{title:'Gauntlet Mode Planner',label:'Planner',description:'Plan match-by-match rotations and track player availability.'},
  '/a-nations-story':{title:"A Nation's Story",label:'Event tool',description:'Find event answers without digging through the full quest flow.'}
};
const inlineTools=(post.data.relatedTools??[]).map((value)=>{
  const raw=String(value??'').trim();
  if(!raw) return null;
  const href=raw.startsWith('/')?raw:'/'+raw.replace(/^\/+/, '');
  const fallbackTitle=raw.replace(/^\/+|\/$/g,'').split('/').pop()?.replaceAll('-',' ')||'Useful tool';
  return {href,...(toolCatalog[href]??{title:fallbackTitle,label:'Tool',description:'Open this tool alongside the article.'})};
}).filter(Boolean);

const firstInline=(item)=>String(item.body||'').match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1]??'';
const coverOf=(item)=>item.data.image||firstInline(item);
const cloud=(url,tf)=>{
  const v=String(url??'');
  return v.includes('res.cloudinary.com')&&v.includes('/image/upload/')?v.replace('/image/upload/','/image/upload/'+tf+'/'):v;
};
const coverImage=coverOf(post);
const heroImage=cloud(coverImage,'f_auto,q_auto,w_1800,h_900,c_fill,g_auto');
const readingTimeOf=(item)=>item.data.readingTime??Math.max(1,Math.ceil((item.body?.split(/\s+/).filter(Boolean).length??0)/220));
const readingTime=readingTimeOf(post);
const date=(value,opts={month:'short',day:'numeric',year:'numeric'})=>value?value.toLocaleDateString('en-US',opts):'';
const categoryFor=(item)=>{
  const t=item.data.type;
  if(t==='leaks') return 'Leaks';
  if(t==='news') return 'Updates';
  if(t==='analysis') return 'Analysis';
  if(t==='player-review') return 'Reviews';
  if(t==='opinion') return 'Tactics';
  return 'Guides';
};
const accentFor=(key)=>({updates:'#67dbff',leaks:'#b7a0ff',guides:'#72e1ad',analysis:'#ffd18a',reviews:'#f3ca76',tactics:'#f29bd2'}[key]??'#67dbff');
const category=categoryFor(post);
const categoryKey=category.toLowerCase();
const accent=accentFor(categoryKey);
const cap=(s)=>String(s??'').replace(/^./,(c)=>c.toUpperCase());
const factLabel=post.data.factStatus==='community-reported'?'Unconfirmed':cap(String(post.data.factStatus??'').replaceAll('-',' '));
const relatedItems=[related[0]??others[0],...related.slice(1,3)].filter(Boolean);
const toc=(post.body??'').split('\n').map(line=>{
  const match=line.match(/^##\s+(.+)$/);
  if(!match) return null;
  const text=match[1].trim();
  return {text,id:slugify(text)};
}).filter(Boolean);
const site=Astro.site??'https://fcmobiletools.online';
const articleType=post.data.type==='news'?'NewsArticle':'Article';
const articleUrl=new URL('/blog/'+post.slug+'/',site).toString();
const articleSchema={
  '@context':'https://schema.org',
  '@type':articleType,
  headline:post.data.title,
  description:post.data.seoDescription??post.data.description,
  datePublished:post.data.publishedAt?.toISOString(),
  dateModified:(post.data.updatedAt??post.data.publishedAt)?.toISOString(),
  author:{'@type':'Person',name:post.data.author,url:new URL('/blog/author/'+slugify(post.data.author)+'/',site).toString()},
  publisher:{'@type':'Organization',name:'FCMOBILETOOLS',url:new URL('/',site).toString(),logo:{'@type':'ImageObject',url:new URL('/assets/images/favicon.png',site).toString()}},
  image:coverImage?[{'@type':'ImageObject',url:coverImage,caption:post.data.imageCaption??post.data.title}]:undefined,
  mainEntityOfPage:{'@type':'WebPage','@id':articleUrl},
  articleSection:category,
  keywords:post.data.tags?.length?post.data.tags:undefined
};
const breadcrumbSchema={
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Home',item:new URL('/',site).toString()},
    {'@type':'ListItem',position:2,name:'Articles',item:new URL('/blog/',site).toString()},
    {'@type':'ListItem',position:3,name:category,item:new URL('/blog/category/'+categoryKey+'/',site).toString()},
    {'@type':'ListItem',position:4,name:post.data.title,item:articleUrl}
  ]
};
const shareUrl=articleUrl;
const shareText=post.data.title+' — FCMOBILETOOLS';
---
<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.seoDescription ?? post.data.description} image={coverImage} type="article" publishedTime={post.data.publishedAt?.toISOString()} modifiedTime={(post.data.updatedAt ?? post.data.publishedAt)?.toISOString()} section={category} author={post.data.author}>
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
<div class="article-progress"><span id="articleProgress"></span></div>

<main class="article-reader" data-article-page style={'--accent:' + accent}>
  <section class="article-hero" data-cover-image={coverImage}>
    <div class="wrap hero-text">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Articles</a><span>/</span><a href={'/blog/category/' + categoryKey + '/'}>{category}</a>
      </nav>

      <div class="article-kicker">
        <a href={'/blog/category/' + categoryKey + '/'}><i></i>{category}</a>
        {post.data.factStatus ? <span class:list={{ confirmed:post.data.factStatus==='verified', uncertain:post.data.factStatus!=='verified' }}>{factLabel}</span> : null}
      </div>

      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.subtitle ?? post.data.description}</p>

      <div class="article-meta" aria-label="Article metadata">
        <span class="meta-avatar" aria-hidden="true">{post.data.author.slice(0,1).toUpperCase()}</span>
        <a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a>
        <span>{post.data.updatedAt ? 'Updated ' + date(post.data.updatedAt) : date(post.data.publishedAt)}</span>
        <span>{readingTime} min read</span>
      </div>
    </div>

    {heroImage ? <div class="wrap">
      <figure class="hero-frame">
        <img class="article-hero-media" src={heroImage} alt={post.data.imageAlt ?? post.data.title} width="1800" height="900" loading="eager" fetchpriority="high" decoding="async" />
        {post.data.imageCaption ? <figcaption>{post.data.imageCaption}</figcaption> : null}
      </figure>
    </div> : null}
  </section>

  <div class="reader-topbar-wrap">
    <div class="wrap reader-topbar" data-share-title={shareText} data-share-url={shareUrl}>
      <a class="back-link" href="/blog">← All articles</a>
      <div class="share-tools" aria-label="Share article">
        <a class="share-chip" href={'https://x.com/intent/post?text=' + encodeURIComponent(shareText) + '&url=' + encodeURIComponent(shareUrl)} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
        <a class="share-chip" href={'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + shareUrl)} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">WhatsApp</a>
        <button class="share-chip" type="button" id="nativeShare" hidden>Share</button>
        <button class="share-chip" type="button" id="copyLink">Copy link</button>
      </div>
    </div>
  </div>

  <div class="wrap reader-shell">
    {post.data.factStatus==='community-reported' ? <WarningBox label="Unconfirmed">This article uses community reports, footage or screenshots and is not presented as confirmed game information.</WarningBox> : null}

    <div class="reader-grid">
      <article class="article-content" id="articleContent">
        <Content />
        {inlineTools.length ? <div class="inline-tools" data-inline-tools>
          <div class="inline-tools-heading"><strong>Useful with this article</strong><span>Open alongside the guide</span></div>
          <div class="inline-tool-grid">
            {inlineTools.map((tool)=>(
              <a class="inline-tool-card" href={tool.href}>
                <span class="tool-mark">{tool.label}</span>
                <strong>{tool.title}</strong>
                <p>{tool.description}</p>
                <b>Open tool ↗</b>
              </a>
            ))}
          </div>
        </div> : null}
      </article>

      <aside class="reader-sidebar" aria-label="Article navigation">
        {toc.length ? <section class="side-card toc-card">
          <div class="side-heading"><span>On this page</span><b>{toc.length} sections</b></div>
          <nav>{toc.map((item)=><a class="toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav>
        </section> : null}

        <section class="side-card author-side">
          <div class="author-avatar">{post.data.author.slice(0,1).toUpperCase()}</div>
          <div><span>Written by</span><a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a><p>FC Mobile creator and contributor.</p></div>
        </section>

        {featured.length ? <section class="side-card">
          <div class="side-heading"><span>Featured</span></div>
          <div class="side-list">{featured.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{categoryFor(item)}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {post.data.tags?.length ? <section class="side-card">
          <div class="side-heading"><span>Topics</span></div>
          <div class="tag-list">{post.data.tags.map((tag)=><span>{tag}</span>)}</div>
        </section> : null}

        {post.data.sources?.length ? <section class="side-card">
          <div class="side-heading"><span>Sources</span><b>{post.data.sources.length}</b></div>
          <div class="source-list">{post.data.sources.map((source,i)=><a href={source} target="_blank" rel="noopener noreferrer">Source {i+1} ↗</a>)}</div>
        </section> : null}
      </aside>
    </div>

    {relatedItems.length ? <section class="related-end" aria-labelledby="relatedHeading">
      <div class="related-heading">
        <h2 id="relatedHeading">Keep reading</h2>
        <a href="/blog">Browse all articles</a>
      </div>
      <div class="related-grid">
        {relatedItems.map((item)=>(
          <a class="related-card" href={'/blog/' + item.slug + '/'} style={'--accent:' + accentFor(categoryFor(item).toLowerCase())}>
            <div class="related-media">
              {coverOf(item) ? <img src={cloud(coverOf(item),'f_auto,q_auto,dpr_auto,w_760')} alt={item.data.imageAlt ?? ''} width="760" height="475" loading="lazy" decoding="async" /> : <span aria-hidden="true">FC</span>}
            </div>
            <div class="related-body">
              <span class="chip"><i></i>{categoryFor(item)}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.excerpt ?? item.data.description}</p>
              <span class="related-meta">{date(item.data.publishedAt,{month:'short',day:'numeric'})} · {readingTimeOf(item)} min read</span>
            </div>
          </a>
        ))}
      </div>
    </section> : null}

    <footer class="article-end">
      <a href="/blog">← Back to all articles</a>
      <a href="/creator">Meet the creators ↗</a>
    </footer>
  </div>

  <div class="article-lightbox" id="articleLightbox" hidden aria-hidden="true">
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-shell" role="dialog" aria-modal="true" aria-label="Image viewer">
      <div class="lightbox-topbar">
        <span id="lightboxCount">01 / 01</span>
        <button type="button" id="lightboxClose" aria-label="Close image viewer">×</button>
      </div>
      <div class="lightbox-stage">
        <button type="button" class="lightbox-nav prev" id="lightboxPrev" aria-label="Previous image">‹</button>
        <figure>
          <img id="lightboxImage" alt="" />
          <figcaption id="lightboxCaption"></figcaption>
        </figure>
        <button type="button" class="lightbox-nav next" id="lightboxNext" aria-label="Next image">›</button>
      </div>
    </div>
  </div>

  {toc.length ? <div class="mobile-toc" data-mobile-toc>
    <button class="mobile-toc-toggle" id="mobileTocToggle" type="button" aria-expanded="false" aria-controls="mobileTocSheet">
      <span>On this page</span><b>{toc.length}</b><i aria-hidden="true">⌃</i>
    </button>
    <div class="mobile-toc-backdrop" id="mobileTocBackdrop" hidden></div>
    <aside class="mobile-toc-sheet" id="mobileTocSheet" aria-hidden="true">
      <div class="mobile-toc-handle" aria-hidden="true"></div>
      <div class="mobile-toc-heading"><span>On this page</span><button id="mobileTocClose" type="button" aria-label="Close table of contents">Close</button></div>
      <nav>{toc.map((item)=><a class="mobile-toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav>
    </aside>
  </div> : null}
</main>

<script is:inline>
const content=document.querySelector('#articleContent');
const progress=document.querySelector('#articleProgress');
const copy=document.querySelector('#copyLink');
const hero=document.querySelector('[data-cover-image]');
const heroImage=hero?.querySelector('.article-hero-media');
if(heroImage){
  heroImage.classList.add('image-loading');
  heroImage.addEventListener('load',()=>heroImage.classList.remove('image-loading'),{once:true});
  if(heroImage.complete) heroImage.classList.remove('image-loading');
}
const normalizeUrl=(value)=>{
  try{const url=new URL(value,location.href);url.hash='';url.search='';return url.href;}
  catch{return String(value||'');}
};

const headings=[...(content?.querySelectorAll('h2')||[])];
headings.forEach((heading)=>{
  if(!heading.id){
    heading.id=heading.textContent?.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
  }
});

const links=[...document.querySelectorAll('[data-toc-link]')];
const setActive=(id)=>links.forEach((link)=>link.classList.toggle('active',link.dataset.tocLink===id));
if(headings.length){
  const observer=new IntersectionObserver((entries)=>{
    const visible=entries.filter((e)=>e.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);
    if(visible[0]) setActive(visible[0].target.id);
  },{rootMargin:'-18% 0px -64% 0px',threshold:0});
  headings.forEach((h)=>observer.observe(h));
  setActive(headings[0].id);
}

const updateProgress=()=>{
  if(!content||!progress) return;
  const rect=content.getBoundingClientRect();
  const total=Math.max(1,content.offsetHeight-window.innerHeight);
  const current=Math.min(total,Math.max(0,-rect.top));
  progress.style.width=((current/total)*100)+'%';
};
window.addEventListener('scroll',updateProgress,{passive:true});
updateProgress();

const shareBar=document.querySelector('.reader-topbar');
const nativeShare=document.querySelector('#nativeShare');
const shareData={
  title:shareBar?.dataset.shareTitle||document.title,
  text:shareBar?.dataset.shareTitle||document.title,
  url:shareBar?.dataset.shareUrl||location.href
};
if(nativeShare && navigator.share) nativeShare.hidden=false;
nativeShare?.addEventListener('click',async()=>{try{await navigator.share(shareData);}catch{}});
copy?.addEventListener('click',async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    copy.textContent='Copied';
    setTimeout(()=>copy.textContent='Copy link',1300);
  }catch{copy.textContent='Copy failed';}
});

const coverSrc=normalizeUrl(hero?.dataset.coverImage||'');
headings.forEach((heading)=>{
  if(heading.textContent?.trim().toLowerCase()==='timeline'){
    const list=heading.nextElementSibling;
    if(list && (list.tagName==='UL'||list.tagName==='OL')) list.classList.add('article-timeline');
  }
});

const inlineToolBlock=document.querySelector('[data-inline-tools]');
if(inlineToolBlock && headings[1]){
  const anchor=headings[1].nextElementSibling;
  (anchor||headings[1]).insertAdjacentElement('afterend',inlineToolBlock);
}

[...(content?.querySelectorAll('table')||[])].forEach((table)=>{
  if(table.parentElement?.classList.contains('article-table-wrap')) return;
  const wrap=document.createElement('div');
  wrap.className='article-table-wrap';
  wrap.setAttribute('role','region');
  wrap.setAttribute('aria-label','Scrollable article table');
  wrap.tabIndex=0;
  table.parentElement?.insertBefore(wrap,table);
  wrap.appendChild(table);
});

const articleImages=[...(content?.querySelectorAll('img')||[])];
const lightbox=document.querySelector('#articleLightbox');
const lightboxImage=document.querySelector('#lightboxImage');
const lightboxCaption=document.querySelector('#lightboxCaption');
const lightboxCount=document.querySelector('#lightboxCount');
const lightboxClose=document.querySelector('#lightboxClose');
const lightboxPrev=document.querySelector('#lightboxPrev');
const lightboxNext=document.querySelector('#lightboxNext');
let galleryImages=[];
let galleryIndex=0;

const setLightboxImage=(index)=>{
  if(!galleryImages.length || !lightboxImage) return;
  galleryIndex=(index+galleryImages.length)%galleryImages.length;
  const item=galleryImages[galleryIndex];
  lightboxImage.src=item.src;
  lightboxImage.alt=item.alt||'';
  if(lightboxCaption) lightboxCaption.textContent=item.caption||'';
  if(lightboxCount) lightboxCount.textContent=String(galleryIndex+1).padStart(2,'0')+' / '+String(galleryImages.length).padStart(2,'0');
};
const closeLightbox=()=>{
  if(!lightbox) return;
  lightbox.hidden=true;
  lightbox.setAttribute('aria-hidden','true');
  document.documentElement.classList.remove('lightbox-open');
  if(lightboxImage) lightboxImage.removeAttribute('src');
};
const openLightbox=(index)=>{
  if(!lightbox || !galleryImages.length) return;
  setLightboxImage(index);
  lightbox.hidden=false;
  lightbox.setAttribute('aria-hidden','false');
  document.documentElement.classList.add('lightbox-open');
  lightboxClose?.focus();
};

articleImages.forEach((img,index)=>{
  img.loading='lazy';
  img.decoding='async';
  img.classList.add('image-loading');
  img.addEventListener('load',()=>img.classList.remove('image-loading'),{once:true});
  if(img.complete) img.classList.remove('image-loading');
  if(!img.getAttribute('width')) img.setAttribute('width','1400');
  if(!img.getAttribute('height')) img.setAttribute('height','788');

  if(index===0 && coverSrc && normalizeUrl(img.currentSrc||img.src)===coverSrc){
    img.closest('p')?.remove();
    return;
  }

  const figure=img.closest('figure');
  const caption=figure?.querySelector('figcaption')?.textContent?.trim() || img.alt?.trim() || '';
  galleryImages.push({src:img.currentSrc||img.src,alt:img.alt||'',caption});
  img.classList.add('zoomable-image');
  img.setAttribute('tabindex','0');
  img.setAttribute('role','button');
  img.setAttribute('aria-label','Open image viewer');
  const open=()=>openLightbox(galleryImages.findIndex((item)=>item.src===(img.currentSrc||img.src)));
  img.addEventListener('click',open);
  img.addEventListener('keydown',(event)=>{
    if(event.key==='Enter'||event.key===' '){event.preventDefault();open();}
  });

  const parent=img.parentElement;
  if(parent?.tagName==='P' && parent.childElementCount===1 && !parent.textContent?.trim()){
    const fig=document.createElement('figure');
    fig.className='article-figure';
    parent.replaceWith(fig);
    fig.appendChild(img);
    if(img.alt?.trim()){
      const cap=document.createElement('figcaption');
      cap.textContent=img.alt.trim();
      fig.appendChild(cap);
    }
  }
});

const mobileToggle=document.querySelector('#mobileTocToggle');
const mobileSheet=document.querySelector('#mobileTocSheet');
const mobileBackdrop=document.querySelector('#mobileTocBackdrop');
const mobileClose=document.querySelector('#mobileTocClose');
const setMobileToc=(open)=>{
  if(!mobileSheet||!mobileToggle) return;
  mobileSheet.setAttribute('aria-hidden',String(!open));
  mobileToggle.setAttribute('aria-expanded',String(open));
  if(mobileBackdrop) mobileBackdrop.hidden=!open;
  document.documentElement.classList.toggle('toc-open',open);
};
mobileToggle?.addEventListener('click',()=>setMobileToc(mobileSheet?.getAttribute('aria-hidden')==='true'));
mobileClose?.addEventListener('click',()=>setMobileToc(false));
mobileBackdrop?.addEventListener('click',()=>setMobileToc(false));
document.querySelectorAll('.mobile-toc-link').forEach((link)=>link.addEventListener('click',()=>setMobileToc(false)));

lightboxPrev?.addEventListener('click',()=>setLightboxImage(galleryIndex-1));
lightboxNext?.addEventListener('click',()=>setLightboxImage(galleryIndex+1));
lightboxClose?.addEventListener('click',closeLightbox);
lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click',closeLightbox);

window.addEventListener('keydown',(event)=>{
  if(event.key==='Escape'){setMobileToc(false);closeLightbox();}
  if(lightbox && !lightbox.hidden){
    if(event.key==='ArrowLeft') setLightboxImage(galleryIndex-1);
    if(event.key==='ArrowRight') setLightboxImage(galleryIndex+1);
  }
});
</script>

<style>
.article-reader{--accent:var(--primary,#4cc9ff);position:relative;min-height:70vh;overflow:clip;background:var(--bg);color:var(--text)}
.article-progress{position:fixed;top:94px;left:0;right:0;height:3px;z-index:1100;pointer-events:none}
.article-progress span{display:block;width:0;height:100%;background:var(--accent);box-shadow:0 0 18px color-mix(in srgb,var(--accent) 60%,transparent)}
.wrap{position:relative;width:min(1180px,calc(100% - 40px));margin-inline:auto}

/* hero */
.article-hero{position:relative;padding:36px 0 0;isolation:isolate}
.article-hero:before{content:"";position:absolute;inset:0 0 auto;height:640px;z-index:-1;pointer-events:none;background:radial-gradient(55% 60% at 80% 0%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 70%),radial-gradient(40% 40% at 0% 20%,#7a6bff10,transparent 70%)}
.hero-text{max-width:980px;margin-inline:max(20px,calc((100% - 1180px)/2))}
.article-breadcrumbs{display:flex;gap:8px;align-items:center;flex-wrap:wrap;color:#6f8893;font-size:14px}
.article-breadcrumbs a{color:#8fa9b4;text-decoration:none}.article-breadcrumbs a:hover{color:#e4f8ff}
.article-kicker{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:38px}
