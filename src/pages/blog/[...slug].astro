---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogEffects from '../../components/blog/BlogEffects.astro';
import '../../styles/blog.css';
import { render } from 'astro:content';
import { relatedTo, resolveTools, seriesIn, img, fmtDate, iso, hostOf, initial, getPosts } from '../../lib/blog.js';


export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { slug: post.slug } }));
}

const posts = await getPosts();
const slug = String(Astro.props?.slug || Astro.params.slug || '').replace(/\/$/,'');
const foundPost = posts.find((p) => p.slug === slug);
if (!foundPost) throw new Error('Local article not found: ' + slug);
const { Content, headings } = await render(foundPost.entry);
const post = foundPost || {
  slug,
  href:'/blog/'+slug+'/',
  title:'Article not found',
  subtitle:'',
  description:'This article is not available.',
  cover:'',
  imageAlt:'',
  imageCaption:'',
  author:'FCMOBILETOOLS',
  authorSlug:'tanzimfc',
  section:{key:'guide',label:'Guides',slug:'guides',accent:'#72e1ad'},
  category:'Guides',tags:[],featured:false,series:'',seriesOrder:null,
  date:null,updated:null,minutes:1,words:0,fact:null,sources:[],lastReviewed:null,
  entry:{data:{title:'Article not found',description:'This article is not available.',type:'guide',category:'Guides',author:'FCMOBILETOOLS',tags:[],relatedTools:[],sources:[],factStatus:'verified'},body:''},
  toc:[],bodyHtml:''
};
const d = post.entry.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ text: h.text, id: h.slug, depth: h.depth }));
const tools = post ? resolveTools(d.relatedTools) : [];
const related = post ? relatedTo(post, posts, 3) : [];

// Series navigation (falls back to newer / older when the post is not in a series)
const seriesObj = post?.series ? seriesIn(posts).find((s) => s.name === post.series) : null;
const partIndex = seriesObj ? seriesObj.parts.findIndex((p) => p.slug === post.slug) : -1;
const inSeries = seriesObj && seriesObj.count > 1 && partIndex >= 0;
const chrono = post ? posts.findIndex((p) => p.slug === post.slug) : -1;
const prev = inSeries ? seriesObj.parts[partIndex - 1] : posts[chrono + 1];
const next = inSeries ? seriesObj.parts[partIndex + 1] : posts[chrono - 1];

const site = Astro.site ?? new URL('https://fcmobiletools.online');
const url = new URL(post?.href || ('/blog/' + slug + '/'), site).toString();
const shareText = (post?.title || 'Article not found') + ' — FCMOBILETOOLS';
const heroSrc = post?.cover ? img(post.cover, 1600) : '';
const authorHref = '/blog/author/' + (post?.authorSlug || 'tanzimfc') + '/';
const sectionHref = '/blog/category/' + (post?.section?.slug || 'guides') + '/';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': d.type === 'news' ? 'NewsArticle' : 'Article',
  headline: post.title,
  description: d.seoDescription ?? post.description,
  datePublished: post.date?.toISOString(),
  dateModified: (post.updated ?? post.date)?.toISOString(),
  inLanguage: 'en',
  wordCount: post.words,
  author: { '@type': 'Person', name: post.author, url: new URL(authorHref, site).toString() },
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS', url: new URL('/', site).toString(), logo: { '@type': 'ImageObject', url: new URL('/assets/images/favicon.png', site).toString() } },
  image: post.cover ? [post.cover] : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: post.section.label,
  keywords: post.tags.length ? post.tags : undefined,
  isPartOf: post.series ? { '@type': 'CreativeWorkSeries', name: post.series } : undefined
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', site).toString() },
    { '@type': 'ListItem', position: 3, name: post.section.label, item: new URL(sectionHref, site).toString() },
    { '@type': 'ListItem', position: 4, name: post.title, item: url }
  ]
};
---
<BaseLayout title={d.seoTitle ?? post?.title ?? 'Article not found'} description={d.seoDescription ?? post?.description ?? 'This article is not available.'} image={post?.cover || undefined} type="article" publishedTime={post?.date?.toISOString()} modifiedTime={(post?.updated ?? post?.date)?.toISOString()} section={post?.section?.label} author={post?.author}>
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
<div class="bl-progress" aria-hidden="true"><span id="blProgress"></span></div>

<main class="bl bl-post" style={'--bl-accent:' + (post?.section?.accent || '#67dbff')} data-post-page data-cover={post.cover} data-title={shareText} data-url={url}>
  <BlogEffects />

  <header class="bl-article-hero">
    <div class="bl-article-wrap">
      <div class="bl-article-head">
        <nav class="bl-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Articles</a><span aria-hidden="true">/</span><a href={sectionHref}>{post?.section?.label || 'Guides'}</a>
        </nav>

        <div class="bl-kicker">
          <a class="bl-tag" href={sectionHref}><i></i>{post.section.label}</a>
          {post.fact ? <span class={`bl-fact-pill bl-fact-pill--${post.fact.tone}`}>{post.fact.label}</span> : null}
        </div>

        <h1>{post?.title}</h1>
        <p class="bl-dek">{post?.subtitle || post?.description}</p>

        <div class="bl-byline">
          <a class="bl-byline-author" href={authorHref}>
            <span class="bl-avatar" aria-hidden="true">{initial(post?.author)}</span>
            <span><b>{post?.author}</b><small>Author</small></span>
          </a>
          <div class="bl-byline-facts">
            <span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4.5" width="14" height="12.5" rx="2.5"/><path d="M3 8.5h14M7 2.5v3M13 2.5v3"/></svg>
              <time datetime={iso(post.date)}>{fmtDate(post?.date, 'long')}</time>
            </span>
            {post.updated ? <span>Updated <time datetime={iso(post.updated)}>{fmtDate(post.updated, 'medium')}</time></span> : null}
            <span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="7.2"/><path d="M10 5.8V10l2.8 1.8"/></svg>
              {post?.minutes || 1} min read
            </span>
          </div>
          <div class="bl-share-top">
            <a class="bl-share-btn" href={'https://x.com/intent/post?text=' + encodeURIComponent(shareText) + '&url=' + encodeURIComponent(url)} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
            <a class="bl-share-btn" href={'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + url)} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">WhatsApp</a>
            <button class="bl-share-btn" type="button" data-copy>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 11.5a3.5 3.5 0 0 0 5 0l2.5-2.5a3.5 3.5 0 0 0-5-5l-.9.9"/><path d="M11.5 8.5a3.5 3.5 0 0 0-5 0L4 11a3.5 3.5 0 0 0 5 5l.9-.9"/></svg>
              <span data-copy-label>Copy link</span>
            </button>
          </div>
        </div>
      </div>

      {heroSrc ? (
        <figure class="bl-hero-figure">
          <img class="is-loading" data-hero-img src={heroSrc} alt={post.imageAlt || post.title} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
          {post.imageCaption ? <figcaption>{post.imageCaption}</figcaption> : null}
        </figure>
      ) : null}
    </div>
  </header>

  <div class="bl-article-wrap">
    <div class="bl-read">
      <article id="blArticle">
        {inSeries ? (
          <div class="bl-series-note">
            <div><small>Part {partIndex + 1} of {seriesObj.count}</small><strong>{seriesObj.name}</strong></div>
            <a class="bl-link" href={'/blog/series/' + seriesObj.slug + '/'}>View the series →</a>
          </div>
        ) : null}

        {post.fact && post.fact.tone !== 'verified' ? (
          <aside class="bl-fact-panel" data-tone={post.fact.tone} aria-label="How confident we are">
            <svg viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {post.fact.tone === 'verified'
                ? <><circle cx="18" cy="18" r="13"/><path d="m12 18.5 4.2 4.2L24.5 14"/></>
                : post.fact.tone === 'partial'
                  ? <><circle cx="18" cy="18" r="13"/><path d="M18 5a13 13 0 0 1 0 26z" fill="currentColor" fill-opacity=".25"/></>
                  : <><path d="M18 5 32 30H4z"/><path d="M18 14v7M18 25.5v.5"/></>}
            </svg>
            <div>
              <strong>{post.fact.title}</strong>
              <p>{post.fact.note}</p>
              {(post.lastReviewed || post.sources.length) ? (
                <small>
                  {post.lastReviewed ? 'Last reviewed ' + fmtDate(post.lastReviewed, 'medium') : ''}
                  {post.lastReviewed && post.sources.length ? ' · ' : ''}
                  {post.sources.length ? post.sources.length + (post.sources.length === 1 ? ' source' : ' sources') + ' listed below' : ''}
                </small>
              ) : null}
            </div>
          </aside>
        ) : null}

        <div class="bl-prose" id="blProse">
          {/* Articles saved with front matter only would otherwise render a blank page */}
          <Content />
        </div>

        {tools.length ? (
          <aside class="bl-inline-tools" data-inline-tools>
            <header><strong>Useful with this article</strong><span>Open alongside the guide</span></header>
            <div class="bl-tools">
              {tools.map((t) => <a class="bl-tool" href={t.href}><em>{t.label}</em><strong>{t.title}</strong><span>{t.description}</span><b>Open tool →</b></a>)}
            </div>
          </aside>
        ) : null}

        <div class="bl-end">
          {post.tags.length ? <div class="bl-tags" aria-label="Topics">{post.tags.map((t) => <span>{t}</span>)}</div> : null}

          {post.sources.length ? (
            <section class="bl-sources" aria-labelledby="sourcesHeading">
              <h2 id="sourcesHeading">Sources</h2>
              <ol>{post.sources.map((s) => <li><a href={s} target="_blank" rel="noopener noreferrer">{hostOf(s)}<span aria-hidden="true"> ↗</span></a></li>)}</ol>
            </section>
          ) : null}

          <section class="bl-author-card" aria-label="About the author">
            <span class="bl-avatar" aria-hidden="true">{initial(post.author)}</span>
            <div>
              <small>Written by</small>
              <strong>{post.author}</strong>
              <p>Writes FC Mobile updates, guides and analysis for FCMOBILETOOLS.</p>
            </div>
            <a class="bl-btn" href={authorHref}>More from {post.author}</a>
          </section>

          {(prev || next) ? (
            <nav class="bl-pager" aria-label={inSeries ? 'Series navigation' : 'More articles'}>
              {prev ? <a href={prev.href}><small>{inSeries ? '← Previous part' : '← Older'}</small><strong>{prev.title}</strong></a> : <span class="is-empty"></span>}
              {next ? <a href={next.href}><small>{inSeries ? 'Next part →' : 'Newer →'}</small><strong>{next.title}</strong></a> : <span class="is-empty"></span>}
            </nav>
          ) : null}
        </div>
      </article>

      <aside class="bl-side" aria-label="Article tools">
        {toc.length ? (
          <section class="bl-panel">
            <div class="bl-panel-head"><span>On this page</span><b id="blPercent">0%</b></div>
            <div class="bl-meter" aria-hidden="true"><span id="blMeter"></span></div>
            <nav class="bl-toc" aria-label="Table of contents">{toc.map((t) => <a href={'#' + t.id} data-toc={t.id} data-depth={t.depth}>{t.text}</a>)}</nav>
          </section>
        ) : null}
        <section class="bl-panel">
          <div class="bl-panel-head"><span>Share</span></div>
          <div class="bl-share">
            <a class="bl-share-btn" href={'https://x.com/intent/post?text=' + encodeURIComponent(shareText) + '&url=' + encodeURIComponent(url)} target="_blank" rel="noopener noreferrer">X</a>
            <a class="bl-share-btn" href={'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + url)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <button class="bl-share-btn" type="button" data-copy><span data-copy-label>Copy link</span></button>
          </div>
        </section>
        <section class="bl-panel bl-side-author">
          <span class="bl-avatar" aria-hidden="true">{initial(post.author)}</span>
          <div><small>Written by</small><a href={authorHref}>{post.author}</a></div>
        </section>
      </aside>
    </div>

    {related.length ? (
      <section class="bl-related" aria-labelledby="relatedHeading" data-reveal>
        <div class="bl-block-head"><h2 id="relatedHeading">Keep reading</h2><a href="/blog">Browse all articles →</a></div>
        <div class="bl-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    ) : null}
  </div>

  <!-- mobile dock + contents sheet -->
  <div class="bl-dock" role="toolbar" aria-label="Article actions">
    {toc.length ? (
      <button class="bl-dock-main" type="button" id="blTocOpen" aria-expanded="false" aria-controls="blSheet">
        <span>On this page</span><b id="blDockPct">0%</b>
      </button>
    ) : null}
    <button type="button" data-native-share hidden aria-label="Share">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 12.5V3M6.5 6.2 10 2.7l3.5 3.5M4.5 10v5.5a1.5 1.5 0 0 0 1.5 1.5h8a1.5 1.5 0 0 0 1.5-1.5V10"/></svg>
    </button>
    <button type="button" id="blTop" aria-label="Back to top">
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 16V4M4.5 9.5 10 4l5.5 5.5"/></svg>
    </button>
  </div>
  <div class="bl-sheet-backdrop" id="blBackdrop" hidden></div>
  <aside class="bl-sheet" id="blSheet" aria-hidden="true" aria-label="Table of contents">
    <div class="bl-sheet-handle" aria-hidden="true"></div>
    <div class="bl-sheet-head"><span>On this page</span><button type="button" id="blTocClose">Close</button></div>
    <nav class="bl-toc">{toc.map((t) => <a href={'#' + t.id} data-toc={t.id} data-depth={t.depth}>{t.text}</a>)}</nav>
    <div class="bl-share">
      <button class="bl-share-btn" type="button" data-copy><span data-copy-label>Copy link</span></button>
      <a class="bl-share-btn" href={'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + url)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </aside>

  <div class="bl-lightbox" id="blLightbox" hidden aria-hidden="true">
    <div class="bl-lightbox-backdrop" data-lb-close></div>
    <div class="bl-lightbox-shell" role="dialog" aria-modal="true" aria-label="Image viewer">
      <div class="bl-lightbox-top"><span id="lbCount">1 / 1</span><button type="button" id="lbClose" aria-label="Close image viewer">×</button></div>
      <div class="bl-lightbox-stage">
        <button type="button" class="bl-lightbox-nav prev" id="lbPrev" aria-label="Previous image">‹</button>
        <figure><img id="lbImage" alt="" /><figcaption id="lbCaption"></figcaption></figure>
        <button type="button" class="bl-lightbox-nav next" id="lbNext" aria-label="Next image">›</button>
      </div>
    </div>
  </div>
</main>

<script is:inline>
(() => {
  const root = document.querySelector('[data-post-page]');
  const prose = document.querySelector('#blProse');
  if (!root || !prose) return;
  const $ = (s) => document.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const norm = (v) => { try { const u = new URL(v, location.href); u.hash = ''; u.search = ''; return u.href; } catch { return String(v || ''); } };

  /* hero image fade-in */
  const hero = $('[data-hero-img]');
  if (hero) {
    const done = () => hero.classList.remove('is-loading');
    hero.addEventListener('load', done, { once: true });
    if (hero.complete) done();
  }

  /* headings: anchors + timeline treatment */
  const headings = $$('h2[id], h3[id]', prose);
  headings.forEach((h) => {
    const a = document.createElement('a');
    a.className = 'bl-anchor';
    a.href = '#' + h.id;
    a.setAttribute('aria-label', 'Link to this section');
    a.textContent = '#';
    h.appendChild(a);
    if (h.tagName === 'H2' && h.textContent.replace('#', '').trim().toLowerCase() === 'timeline') {
      const list = h.nextElementSibling;
      if (list && (list.tagName === 'UL' || list.tagName === 'OL')) list.classList.add('bl-timeline');
    }
  });

  /* tables scroll inside their own container */
  $$('table', prose).forEach((table) => {
    if (table.parentElement.classList.contains('bl-table')) return;
    const wrap = document.createElement('div');
    wrap.className = 'bl-table';
    wrap.setAttribute('role', 'region');
    wrap.setAttribute('aria-label', 'Scrollable table');
    wrap.tabIndex = 0;
    table.before(wrap);
    wrap.appendChild(table);
  });

  /* related tools sit after the first section, not buried at the end */
  const tools = $('[data-inline-tools]');
  const h2s = $$('h2', prose);
  if (tools && h2s[1]) h2s[1].before(tools);

  /* images -> figures + lightbox */
  const coverSrc = norm(root.dataset.cover || '');
  const gallery = [];
  const box = $('#blLightbox'), boxImg = $('#lbImage'), boxCap = $('#lbCaption'), boxCount = $('#lbCount');
  let idx = 0;
  const show = (i) => {
    if (!gallery.length) return;
    idx = (i + gallery.length) % gallery.length;
    const g = gallery[idx];
    boxImg.src = g.src; boxImg.alt = g.alt; boxCap.textContent = g.caption;
    boxCount.textContent = (idx + 1) + ' / ' + gallery.length;
  };
  const closeBox = () => { box.hidden = true; box.setAttribute('aria-hidden', 'true'); document.documentElement.classList.remove('bl-lock'); boxImg.removeAttribute('src'); };
  const openBox = (i) => { show(i); box.hidden = false; box.setAttribute('aria-hidden', 'false'); document.documentElement.classList.add('bl-lock'); $('#lbClose').focus(); };

  $$('img', prose).forEach((img, n) => {
    img.loading = 'lazy'; img.decoding = 'async';
    img.classList.add('is-loading');
    img.addEventListener('load', () => img.classList.remove('is-loading'), { once: true });
    if (img.complete) img.classList.remove('is-loading');
    if (!img.getAttribute('width')) img.setAttribute('width', '1400');
    if (!img.getAttribute('height')) img.setAttribute('height', '788');
    // don't show the cover twice when the body opens with the same image
    if (n === 0 && coverSrc && norm(img.currentSrc || img.src) === coverSrc) { (img.closest('p') || img).remove(); return; }

    const fig = img.closest('figure');
    const caption = fig?.querySelector('figcaption')?.textContent?.trim() || img.alt?.trim() || '';
    const at = gallery.push({ src: img.currentSrc || img.src, alt: img.alt || '', caption }) - 1;
    img.tabIndex = 0; img.setAttribute('role', 'button'); img.setAttribute('aria-label', 'Open image viewer');
    img.addEventListener('click', () => openBox(at));
    img.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openBox(at); } });

    const p = img.parentElement;
    if (p?.tagName === 'P' && p.childElementCount === 1 && !p.textContent.trim()) {
      const f = document.createElement('figure');
      f.className = 'bl-figure';
      p.replaceWith(f);
      f.appendChild(img);
      const alt = img.alt?.trim();
      // only promote alt text to a caption when it reads like a sentence, not a filename
      if (alt && /\s/.test(alt) && !/\.(png|jpe?g|webp|gif)$/i.test(alt)) {
        const c = document.createElement('figcaption'); c.textContent = alt; f.appendChild(c);
      }
    }
  });
  $('#lbPrev').addEventListener('click', () => show(idx - 1));
  $('#lbNext').addEventListener('click', () => show(idx + 1));
  $('#lbClose').addEventListener('click', closeBox);
  box.querySelector('[data-lb-close]').addEventListener('click', closeBox);

  /* reading progress */
  const bar = $('#blProgress'), meter = $('#blMeter'), pct = $('#blPercent'), dockPct = $('#blDockPct');
  const article = $('#blArticle');
  const update = () => {
    const r = prose.getBoundingClientRect();
    const total = Math.max(1, r.height - innerHeight * 0.6);
    const p = Math.min(1, Math.max(0, -r.top / total));
    const v = Math.round(p * 100);
    if (bar) bar.style.width = v + '%';
    if (meter) meter.style.width = v + '%';
    if (pct) pct.textContent = v + '%';
    if (dockPct) dockPct.textContent = v + '%';
  };
  addEventListener('scroll', update, { passive: true }); addEventListener('resize', update); update();

  /* table of contents: active section */
  const links = $$('[data-toc]');
  const setActive = (id) => links.forEach((l) => l.classList.toggle('is-active', l.dataset.toc === id));
  if (headings.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (vis[0]) setActive(vis[0].target.id);
    }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
    headings.forEach((h) => io.observe(h));
    setActive(headings[0].id);
  }

  /* mobile contents sheet */
  const sheet = $('#blSheet'), backdrop = $('#blBackdrop'), open = $('#blTocOpen');
  const setSheet = (on) => {
    if (!sheet) return;
    sheet.setAttribute('aria-hidden', String(!on));
    open?.setAttribute('aria-expanded', String(on));
    backdrop.hidden = !on;
    document.documentElement.classList.toggle('bl-lock', on);
  };
  open?.addEventListener('click', () => setSheet(true));
  $('#blTocClose')?.addEventListener('click', () => setSheet(false));
  backdrop?.addEventListener('click', () => setSheet(false));
  $$('.bl-sheet .bl-toc a').forEach((a) => a.addEventListener('click', () => setSheet(false)));
  $('#blTop')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

  /* share */
  const shareData = { title: root.dataset.title, text: root.dataset.title, url: root.dataset.url };
  const native = $('[data-native-share]');
  if (native && navigator.share) { native.hidden = false; native.addEventListener('click', () => navigator.share(shareData).catch(() => {})); }
  $$('[data-copy]').forEach((btn) => btn.addEventListener('click', async () => {
    const label = btn.querySelector('[data-copy-label]');
    try { await navigator.clipboard.writeText(root.dataset.url); label.textContent = 'Copied'; }
    catch { label.textContent = 'Copy failed'; }
    setTimeout(() => { label.textContent = 'Copy link'; }, 1400);
  }));

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { setSheet(false); if (!box.hidden) closeBox(); }
    if (!box.hidden) { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); }
  });
})();
</script>
</BaseLayout>
