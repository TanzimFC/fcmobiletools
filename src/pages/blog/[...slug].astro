/* lightbox */
.article-lightbox{position:fixed;inset:0;z-index:4000}.article-lightbox[hidden]{display:none}
.lightbox-backdrop{position:absolute;inset:0;background:#01060ae0;backdrop-filter:blur(16px)}
.lightbox-shell{position:relative;width:min(1280px,calc(100% - 28px));height:min(92vh,900px);margin:4vh auto;display:grid;grid-template-rows:auto 1fr;border:1px solid #ffffff1a;border-radius:22px;background:linear-gradient(180deg,#0b1821,#050b10);box-shadow:0 40px 120px #000a;overflow:hidden}
.lightbox-topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid #ffffff12;color:#87a0ab;font:600 14px var(--font-body)}
.lightbox-topbar button{width:36px;height:36px;border:1px solid #ffffff1a;border-radius:50%;background:#0b1d27;color:#bcebf7;font-size:20px;cursor:pointer}
