.article-kicker>span.uncertain{color:#f0cc79;border-color:rgba(240,204,121,.28);background:rgba(49,39,17,.62)}
.article-hero h1{max-width:980px;margin:17px 0 15px;font:800 clamp(50px,7vw,92px)/.92 var(--font-display);letter-spacing:-.075em;text-wrap:balance}
