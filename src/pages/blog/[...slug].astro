---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const slugify=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft))
  .sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));

export async function getStaticPaths(){
  const postsForPaths=await getCollection('blog',({data})=>data.status==='published'&&!data.draft);
  return postsForPaths.map((post)=>({params:{slug:post.slug},props:{post}}));
}

const {post}=Astro.props;
const {Content}=await render(post);
const others=posts.filter((item)=>item.slug!==post.slug);
const related=others.filter((item)=>{
  const tags=(item.data.tags??[]);
  const own=(post.data.tags??[]);
  return item.data.type===post.data.type || item.data.category===post.data.category || tags.some((tag)=>own.includes(tag));
}).slice(0,5);
const featured=others.filter((item)=>item.data.featured).slice(0,4);
const firstInlineImage=String(post.body??'').match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1]??'';\nconst coverImage=post.data.image||firstInlineImage;
const readingTime=post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\s+/).filter(Boolean).length??0)/220));
const date=(value)=>value?value.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}):'';
const categoryOf=()=>{
  if(post.data.type==='leaks') return 'Leaks';
  if(post.data.type==='news') return 'Updates';
  if(post.data.type==='analysis') return 'Analysis';
  if(post.data.type==='player-review') return 'Reviews';
  if(post.data.type==='opinion') return 'Tactics';
  return 'Guides';
};
const category=categoryOf();
const categoryKey=category.toLowerCase();
const toc=(post.body??'').split('\n').map(line=>{
  const match=line.match(/^##\s+(.+)$/);
  if(!match) return null;
  const text=match[1].trim();
  return {text,id:slugify(text)};
}).filter(Boolean);
const articleType=post.data.type==='news'?'NewsArticle':'Article';
const articleSchema={
  '@context':'https://schema.org',
  '@type':articleType,
  headline:post.data.title,
  description:post.data.seoDescription??post.data.description,
  datePublished:post.data.publishedAt?.toISOString(),
  dateModified:(post.data.updatedAt??post.data.publishedAt)?.toISOString(),
  author:{'@type':'Person',name:post.data.author},
  publisher:{'@type':'Person',name:'TanzimFC'},
  image:coverImage?[coverImage]:undefined,
  mainEntityOfPage:new URL('/blog/'+post.slug+'/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString()
};
---
<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.seoDescription ?? post.data.description} image={coverImage} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
<div class="article-progress"><span id="articleProgress"></span></div>
<main class="article-reader" data-article-page>
  <div class="reader-glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="reader-topbar">
      <a class="back-link" href="/blog">← Back to articles</a>
      <div class="share-tools"><span>{category}</span><button type="button" id="copyLink">Copy link</button></div>
    </div>

    <header class="article-header">
      <div class="article-kicker">
        <a href={'/blog/category/' + categoryKey + '/'}>{category}</a>
        {post.data.factStatus ? <span class:list={{ confirmed:post.data.factStatus==='verified', uncertain:post.data.factStatus!=='verified' }}>{post.data.factStatus==='community-reported'?'UNCONFIRMED':post.data.factStatus.replaceAll('-',' ')}</span> : null}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.subtitle ? <p class="article-subtitle">{post.data.subtitle}</p> : null}
      <p class="article-lede">{post.data.description}</p>
      <div class="article-byline">
        <a href={'/blog/author/' + slugify(post.data.author) + '/'}>By {post.data.author}</a>
        <span>{date(post.data.publishedAt)}</span>
        <span>{readingTime} min read</span>
        {post.data.updatedAt ? <span>Updated {date(post.data.updatedAt)}</span> : null}
      </div>
    </header>

    {post.data.factStatus==='community-reported' ? <div class="uncertain-notice"><span>UNCONFIRMED</span><p>This article uses community reports, footage or screenshots and is not presented as confirmed game information.</p></div> : null}

    <div class="reader-grid">
      <article class="article-content" id="articleContent">
        <Content />
        {post.data.relatedTools?.length ? <div class="inline-tools"><span>USEFUL WITH THIS ARTICLE</span>{post.data.relatedTools.map((tool)=><a href={tool.startsWith('/')?tool:'/'+tool}>{tool.replaceAll('-',' ')}</a>)}</div> : null}
      </article>

      <aside class="reader-sidebar">
        <section class="side-card author-side">
          <div class="author-avatar">{post.data.author.slice(0,1).toUpperCase()}</div>
          <div><span>WRITTEN BY</span><a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a><p>FC Mobile creator and contributor.</p></div>
        </section>

        {toc.length ? <section class="side-card toc-card">
          <div class="side-heading"><span>ON THIS PAGE</span><b>{toc.length}</b></div>
          <nav>{toc.map((item)=><a href={'#'+item.id}>{item.text}</a>)}</nav>
        </section> : null}

        {related.length ? <section class="side-card">
          <div class="side-heading"><span>KEEP READING</span><b>{related.length}</b></div>
          <div class="side-list">{related.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {featured.length ? <section class="side-card">
          <div class="side-heading"><span>FEATURED</span><b>READ</b></div>
          <div class="side-list">{featured.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {post.data.tags?.length ? <section class="side-card">
          <div class="side-heading"><span>TOPICS</span><b>{post.data.tags.length}</b></div>
          <div class="topic-list">{post.data.tags.map((tag)=><span>{tag}</span>)}</div>
        </section> : null}

        {post.data.sources?.length ? <section class="side-card">
          <div class="side-heading"><span>SOURCES</span><b>LINKS</b></div>
          <div class="source-list">{post.data.sources.map((source)=><a href={source} target="_blank" rel="noopener">Open source ↗</a>)}</div>
        </section> : null}
      </aside>
    </div>

    <footer class="article-end">
      <a href="/blog">← Back to all articles</a>
      <a href="/creator">Meet the creators ↗</a>
    </footer>
  </div>
</main>
<script is:inline>
const page=document.querySelector('[data-article-page]');
const progress=document.querySelector('#articleProgress');
const content=document.querySelector('#articleContent');
const glow=document.querySelector('.reader-glow');
const copy=document.querySelector('#copyLink');
const headings=[...(content?.querySelectorAll('h2,h3')||[])];

headings.forEach((heading)=>{
  if(!heading.id){
    heading.id=heading.textContent.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
  }
});

const updateProgress=()=>{
  if(!content||!progress) return;
  const rect=content.getBoundingClientRect();
  const total=Math.max(1,content.offsetHeight-window.innerHeight);
  const current=Math.min(total,Math.max(0,-rect.top));
  progress.style.width=((current/total)*100)+'%';
};
window.addEventListener('scroll',updateProgress,{passive:true});
updateProgress();

copy?.addEventListener('click',async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    copy.textContent='Copied';
    setTimeout(()=>copy.textContent='Copy link',1300);
  }catch{copy.textContent='Copy failed';}
});

window.addEventListener('pointermove',(event)=>{
  if(glow) glow.style.transform='translate3d('+(event.clientX-170)+'px,'+(event.clientY-170)+'px,0)';
},{passive:true});
</script>
<style>
.article-reader{position:relative;background:radial-gradient(circle at 82% 4%,#55c7f20a,transparent 28%),var(--bg);overflow:hidden}
.article-progress{position:fixed;top:0;left:0;right:0;height:2px;background:transparent;z-index:1300}
.article-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),#bdefff);box-shadow:0 0 18px #55c7f266;transition:width .08s linear}
.reader-glow{position:fixed;width:340px;height:340px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,#55c7f20f,transparent 68%);filter:blur(8px);transform:translate3d(-999px,-999px,0);z-index:0}
.wrap{position:relative;width:min(1180px,calc(100% - 32px));margin:auto;z-index:1}
.reader-topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:23px 0 15px;border-bottom:1px solid #182a33}
.back-link{color:#87defd;text-decoration:none;font:900 8px var(--mono);letter-spacing:.04em}
.back-link:hover{color:#dff9ff}
.share-tools{display:flex;gap:8px;align-items:center}
.share-tools span{padding:6px 8px;border:1px solid #294554;border-radius:999px;color:#77aec4;font:800 7px var(--mono);text-transform:uppercase}
.share-tools button{padding:6px 8px;border:1px solid #243b47;border-radius:999px;background:#0a151c;color:#8098a4;font:800 7px var(--mono);cursor:pointer}
.share-tools button:hover{color:#e5f8ff;border-color:#3b6a7f}
.article-header{padding:52px 0 28px;max-width:930px}
.article-kicker{display:flex;gap:8px;align-items:center}
.article-kicker>a{color:var(--blue);text-decoration:none;font:900 8px var(--mono);letter-spacing:.14em;text-transform:uppercase}
.article-kicker>span{padding:6px 8px;border-radius:999px;border:1px solid #2a414d;color:#708792;background:#0a151c;font:800 7px var(--mono);text-transform:uppercase}
.article-kicker>span.confirmed{color:#76e2a8;border-color:#255b43;background:#0d2219}
.article-kicker>span.uncertain{color:#f0cc79;border-color:#67542a;background:#1d1709}
.article-header h1{margin:16px 0 12px;max-width:900px;font-size:clamp(48px,6.6vw,88px);line-height:.91;letter-spacing:-.078em}
.article-subtitle{max-width:900px;margin:0 0 10px;color:#bdd0d6;font-size:18px;line-height:1.38;font-weight:700}
.article-lede{max-width:880px;margin:0;color:#8499a5;font-size:12px;line-height:1.85}
.article-byline{display:flex;flex-wrap:wrap;gap:7px 17px;margin-top:18px;color:#617985;font:700 7px var(--mono)}
.article-byline a{color:#94defc;text-decoration:none}
.article-cover{margin:3px 0 22px}
.article-cover img{display:block;width:100%;max-height:610px;object-fit:cover;border:1px solid #2b4654;border-radius:20px;box-shadow:0 35px 110px #000b}
.article-cover figcaption{margin-top:8px;color:#58727f;font:700 7px var(--mono)}
.uncertain-notice{display:flex;gap:12px;align-items:center;margin:0 0 28px;padding:12px 14px;border:1px solid #665128;border-radius:12px;background:#171207}
.uncertain-notice span{color:#f0cd7e;font:900 7px var(--mono);white-space:nowrap}
.uncertain-notice p{margin:0;color:#a28e63;font-size:9px;line-height:1.6}
.reader-grid{display:grid;grid-template-columns:minmax(0,800px) 300px;gap:52px;align-items:start}
.article-content{min-width:0;color:#d5e2e7;font-size:16px;line-height:1.94;position:relative}
.article-content h2{margin:48px 0 15px;font-size:31px;line-height:1.08;letter-spacing:-.045em;color:#eff8fb;scroll-margin-top:110px}
.article-content h3{margin:34px 0 12px;font-size:22px;line-height:1.18;color:#e4f1f5;scroll-margin-top:110px}
.article-content p{margin:0 0 22px;transition:background .2s,transform .2s;border-radius:7px;padding:0 3px;margin-left:-3px}.article-content p:hover{background:#55c7f205}
.article-content ul,.article-content ol{margin:0 0 24px;padding-left:24px}
.article-content li{margin:7px 0}
.article-content a{color:#93defc;text-decoration:underline;text-decoration-color:#55c7f24a;text-underline-offset:3px}
.article-content strong{color:#f0f8fa}
.article-content blockquote{margin:30px 0;padding:19px 21px;border-left:3px solid var(--blue);border-radius:0 12px 12px 0;background:linear-gradient(90deg,#55c7f20c,transparent);color:#b9ced5;font-size:17px;line-height:1.65}
.article-content img{display:block;width:100%;max-height:650px;object-fit:contain;margin:28px 0;border:1px solid #29424e;border-radius:14px;background:#071017;box-shadow:0 24px 70px #0008}
.article-content hr{border:0;border-top:1px solid #233740;margin:42px 0}
.article-content table{width:100%;border-collapse:collapse;margin:26px 0;border:1px solid #263e49;border-radius:12px;overflow:hidden;display:table}
.article-content th,.article-content td{padding:11px 12px;border-bottom:1px solid #20323b;text-align:left}
.article-content th{color:#b9e6f7;font:900 8px var(--mono);text-transform:uppercase;background:#0a171e}
.article-content td{color:#b6c8cf;font-size:11px}
.inline-tools{display:grid;gap:9px;margin:42px 0;padding:17px;border:1px solid #2a4654;border-radius:14px;background:#09151c}
.inline-tools>span{color:#5e7885;font:900 7px var(--mono);letter-spacing:.12em}
.inline-tools a{width:max-content;text-decoration:none;color:#a7e5fb;font:800 9px var(--mono)}
.reader-sidebar{display:grid;gap:11px;position:sticky;top:92px;align-self:start}
.side-card{padding:15px;border:1px solid var(--border);border-radius:16px;background:#09131a;box-shadow:0 20px 58px #0005}
.author-side{display:grid;grid-template-columns:43px 1fr;gap:10px;align-items:center}
.author-avatar{width:43px;height:43px;border-radius:13px;display:grid;place-items:center;border:1px solid #2d5569;background:#0a1a22;color:var(--blue);font:900 15px var(--mono)}
.author-side span{display:block;color:#56727f;font:900 6.5px var(--mono);letter-spacing:.12em}
.author-side a{display:block;margin-top:3px;color:#d4edf4;text-decoration:none;font:800 11px var(--display)}
.author-side p{margin:2px 0 0;color:#728894;font-size:8px;line-height:1.5}
.side-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px;padding-bottom:9px;border-bottom:1px solid #1b2e38}
.side-heading span{color:#5f7785;font:900 7px var(--mono);letter-spacing:.13em}
.side-heading b{color:#506975;font:800 6.5px var(--mono)}
.toc-card nav{display:grid;gap:2px}
.toc-card a{padding:7px 6px;border-left:2px solid transparent;color:#8097a2;text-decoration:none;font-size:8.5px;line-height:1.4;transition:.18s}
.toc-card a:hover{color:#dff8ff;border-left-color:var(--blue);background:#55c7f208}
.side-list{display:grid}
.side-list a{display:grid;gap:4px;padding:11px 0;border-bottom:1px solid #1a2b34;color:var(--text);text-decoration:none}
.side-list a:last-child{border-bottom:0}
.side-list small{color:var(--blue);font:800 6.5px var(--mono);text-transform:uppercase}
.side-list strong{font-size:9.5px;line-height:1.35}
.topic-list{display:flex;flex-wrap:wrap;gap:6px}
.topic-list span{padding:6px 8px;border:1px solid #284452;border-radius:999px;color:#76929f;font:800 7px var(--mono)}
.source-list{display:grid;gap:6px}
.source-list a{color:#8fdcff;text-decoration:none;font:800 8px var(--mono)}
.article-end{display:flex;justify-content:space-between;gap:20px;margin:60px 0 30px;padding-top:18px;border-top:1px solid #1b2e38}
.article-end a{color:#7ba0ae;text-decoration:none;font:800 8px var(--mono)}
.article-end a:hover{color:#dff8ff}
::selection{background:#55c7f244;color:#f4fdff}
@media(max-width:1000px){.reader-grid{grid-template-columns:minmax(0,1fr) 255px;gap:28px}}
@media(max-width:800px){.article-header{padding-top:40px}.reader-grid{grid-template-columns:1fr}.reader-sidebar{position:static;grid-template-columns:1fr 1fr}.author-side{grid-column:span 1}.toc-card{grid-column:1/-1}.article-content{font-size:15px}}
@media(max-width:560px){.wrap{width:calc(100% - 20px)}.reader-topbar{align-items:flex-start;flex-direction:column}.share-tools{width:100%;justify-content:space-between}.article-header h1{font-size:clamp(42px,11vw,62px)}.article-subtitle{font-size:16px}.article-content{font-size:15px;line-height:1.84}.reader-sidebar{grid-template-columns:1fr}.article-end{align-items:flex-start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){.reader-glow{display:none}.article-progress span{transition:none}}
</style>
</main>
</BaseLayout>