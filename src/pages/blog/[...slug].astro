---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WarningBox from '../../components/article/WarningBox.astro';
import { getCollection, render } from 'astro:content';

const slugify=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft))
  .sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));

export async function getStaticPaths(){
  const postsForPaths=await getCollection('blog',({data})=>data.status==='published'&&!data.draft);
  return postsForPaths.map((post)=>({params:{slug:post.slug},props:{post}}));
}

const {post}=Astro.props;
const {Content}=await render(post);
const others=posts.filter((item)=>item.slug!==post.slug);
const related=others.filter((item)=>{
  const tags=(item.data.tags??[]);
  const own=(post.data.tags??[]);
  return item.data.type===post.data.type || item.data.category===post.data.category || tags.some((tag)=>own.includes(tag));
}).slice(0,6);
const featured=others.filter((item)=>item.data.featured).slice(0,4);
const toolCatalog={
  '/redeem-codes':{title:'Redeem Codes',label:'LIVE TOOL',description:'Check current FC Mobile codes and move straight to redemption.'},
  '/team-ovr':{title:'Team OVR Calculator',label:'CALCULATOR',description:'Work out your squad OVR before changing the lineup.'},
  '/training-calculator':{title:'Training Calculator',label:'CALCULATOR',description:'Plan XP, fodder, levels and excess XP before spending resources.'},
  '/rank-up-calculator':{title:'Rank Up Calculator',label:'CALCULATOR',description:'Compare Rank Up Point routes and see the effect before committing.'},
  '/football-centre':{title:'Football Centre',label:'LIVE TOOL',description:'Track matches, points, rewards and event resources in one place.'},
  '/gauntlet-planner':{title:'Gauntlet Mode Planner',label:'PLANNER',description:'Plan match-by-match rotations and track player availability.'},
  '/a-nations-story':{title:"A Nation's Story",label:'EVENT TOOL',description:'Find event answers without digging through the full quest flow.'}
};
const inlineTools=(post.data.relatedTools??[]).map((value)=>{
  const raw=String(value??'').trim();
  if(!raw) return null;
  const href=raw.startsWith('/')?raw:'/'+raw.replace(/^\/+/, '');
  const fallbackTitle=raw.replace(/^\/+|\/$/g,'').split('/').pop()?.replaceAll('-',' ')||'Useful tool';
  return {href,...(toolCatalog[href]??{title:fallbackTitle,label:'TOOL',description:'Open this tool alongside the article.'})};
}).filter(Boolean);
const relatedLead=related[0]??others[0];
const relatedSupport=related.filter((item)=>item.slug!==relatedLead?.slug).slice(0,2);
const firstImageMatch=String(post.body||'').match(/!\[[^\]]*\]\(([^)]+)\)/);
const firstInlineImage=firstImageMatch ? firstImageMatch[1] : '';
const coverImage=post.data.image||firstInlineImage;
const heroImage=String(coverImage||'').includes('res.cloudinary.com') && String(coverImage).includes('/image/upload/')
  ? String(coverImage).replace('/image/upload/','/image/upload/f_auto,q_auto,w_1600,h_900,c_fill,g_auto/')
  : coverImage;
const readingTime=post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\s+/).filter(Boolean).length??0)/220));
const date=(value)=>value?value.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'';
const categoryOf=()=>{
  if(post.data.type==='leaks') return 'Leaks';
  if(post.data.type==='news') return 'Updates';
  if(post.data.type==='analysis') return 'Analysis';
  if(post.data.type==='player-review') return 'Reviews';
  if(post.data.type==='opinion') return 'Tactics';
  return 'Guides';
};
const category=categoryOf();
const categoryKey=category.toLowerCase();
const toc=(post.body??'').split('\n').map(line=>{
  const match=line.match(/^##\s+(.+)$/);
  if(!match) return null;
  const text=match[1].trim();
  return {text,id:slugify(text)};
}).filter(Boolean);
const articleType=post.data.type==='news'?'NewsArticle':'Article';
const articleUrl=new URL('/blog/'+post.slug+'/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString();
const articleSchema={
  '@context':'https://schema.org',
  '@type':articleType,
  headline:post.data.title,
  description:post.data.seoDescription??post.data.description,
  datePublished:post.data.publishedAt?.toISOString(),
  dateModified:(post.data.updatedAt??post.data.publishedAt)?.toISOString(),
  author:{'@type':'Person',name:post.data.author},
  publisher:{'@type':'Person',name:'TanzimFC'},
  image:coverImage?[{'@type':'ImageObject',url:coverImage,caption:post.data.imageCaption??post.data.title}]:undefined,
  mainEntityOfPage:articleUrl
};
const breadcrumbSchema={
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString()},
    {'@type':'ListItem',position:2,name:'Articles',item:new URL('/blog/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString()},
    {'@type':'ListItem',position:3,name:category,item:new URL('/blog/category/'+categoryKey+'/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString()},
    {'@type':'ListItem',position:4,name:post.data.title,item:articleUrl}
  ]
};
const shareUrl=articleUrl;
const shareText=post.data.title+' — FCMOBILETOOLS';
---
<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.seoDescription ?? post.data.description} image={coverImage} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
<div class="article-progress"><span id="articleProgress"></span></div>

<main class="article-reader" data-article-page>
  <section class="article-hero" data-cover-image={coverImage}>
    {heroImage ? <img
      class="article-hero-media"
      src={heroImage}
      alt={post.data.imageAlt ?? post.data.title}
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    /> : null}
    <div class="article-hero-overlay" aria-hidden="true"></div>

    <div class="wrap article-hero-inner">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Articles</a><span>/</span><a href={'/blog/category/' + categoryKey + '/'}>{category}</a><span>/</span><span aria-current="page">{post.data.title}</span>
      </nav>

      <div class="article-hero-content">
        <div class="article-kicker">
          <a href={'/blog/category/' + categoryKey + '/'}>{category}</a>
          {post.data.factStatus ? <span class:list={{ confirmed:post.data.factStatus==='verified', uncertain:post.data.factStatus!=='verified' }}>{post.data.factStatus==='community-reported'?'UNCONFIRMED':post.data.factStatus.replaceAll('-',' ')}</span> : null}
        </div>

        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.subtitle ?? post.data.description}</p>

        <div class="article-meta" aria-label="Article metadata">
          <a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a>
          <span aria-hidden="true">·</span>
          <span>{post.data.updatedAt ? 'Updated ' + date(post.data.updatedAt) : 'Published ' + date(post.data.publishedAt)}</span>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap reader-topbar" data-share-title={shareText} data-share-url={shareUrl}>
    <a class="back-link" href="/blog">← Back to articles</a>
    <div class="share-tools" aria-label="Share article">
      <span class="share-category">{category}</span>
      <a class="share-chip share-x" href={'https://x.com/intent/post?text=' + encodeURIComponent(shareText) + '&url=' + encodeURIComponent(shareUrl)} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
      <a class="share-chip share-whatsapp" href={'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + shareUrl)} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">WhatsApp</a>
      <button class="share-chip" type="button" id="nativeShare" hidden>Share</button>
      <button class="share-chip" type="button" id="copyLink">Copy</button>
    </div>
  </div>

  <div class="wrap reader-shell">
    {post.data.factStatus==='community-reported' ? <WarningBox label="Unconfirmed">This article uses community reports, footage or screenshots and is not presented as confirmed game information.</WarningBox> : null}

    <div class="reader-grid">
      <article class="article-content" id="articleContent">
        <Content />
        {inlineTools.length ? <div class="inline-tools" data-inline-tools>
          <div class="inline-tools-heading"><span>USEFUL WITH THIS ARTICLE</span><strong>Open alongside the guide</strong></div>
          <div class="inline-tool-grid">
            {inlineTools.map((tool)=>(
              <a class="inline-tool-card" href={tool.href}>
                <span class="tool-mark">{tool.label}</span>
                <strong>{tool.title}</strong>
                <p>{tool.description}</p>
                <b>Open tool ↗</b>
              </a>
            ))}
          </div>
        </div> : null}
      </article>

      <aside class="reader-sidebar" aria-label="Article navigation and related reading">
        {toc.length ? <section class="side-card toc-card">
          <div class="side-heading"><span>ON THIS PAGE</span><b>{toc.length} sections</b></div>
          <nav>{toc.map((item)=><a class="toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav>
        </section> : null}

        <section class="side-card author-side">
          <div class="author-avatar">{post.data.author.slice(0,1).toUpperCase()}</div>
          <div><span>WRITTEN BY</span><a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a><p>FC Mobile creator and contributor.</p></div>
        </section>

        {related.length ? <section class="side-card">
          <div class="side-heading"><span>KEEP READING</span><b>{related.length}</b></div>
          <div class="side-list">{related.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {featured.length ? <section class="side-card">
          <div class="side-heading"><span>FEATURED</span><b>READ</b></div>
          <div class="side-list">{featured.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {post.data.tags?.length ? <section class="side-card">
          <div class="side-heading"><span>TOPICS</span><b>{post.data.tags.length}</b></div>
          <div class="topic-list">{post.data.tags.map((tag)=><span>{tag}</span>)}</div>
        </section> : null}

        {post.data.sources?.length ? <section class="side-card">
          <div class="side-heading"><span>SOURCES</span><b>LINKS</b></div>
          <div class="source-list">{post.data.sources.map((source)=><a href={source} target="_blank" rel="noopener noreferrer">Open source ↗</a>)}</div>
        </section> : null}
      </aside>
    </div>

    <footer class="article-end">
      <a href="/blog">← Back to all articles</a>
      <a href="/creator">Meet the creators ↗</a>
    </footer>
  </div>

  <div class="article-lightbox" id="articleLightbox" hidden aria-hidden="true">
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-shell" role="dialog" aria-modal="true" aria-label="Image viewer">
      <div class="lightbox-topbar">
        <span id="lightboxCount">01 / 01</span>
        <button type="button" id="lightboxClose" aria-label="Close image viewer">×</button>
      </div>
      <div class="lightbox-stage">
        <button type="button" class="lightbox-nav prev" id="lightboxPrev" aria-label="Previous image">‹</button>
        <figure>
          <img id="lightboxImage" alt="" />
          <figcaption id="lightboxCaption"></figcaption>
        </figure>
        <button type="button" class="lightbox-nav next" id="lightboxNext" aria-label="Next image">›</button>
      </div>
    </div>
  </div>

  {toc.length ? <div class="mobile-toc" data-mobile-toc>
    <button class="mobile-toc-toggle" id="mobileTocToggle" type="button" aria-expanded="false" aria-controls="mobileTocSheet">
      <span>On this page</span><b>{toc.length}</b><i aria-hidden="true">⌃</i>
    </button>
    <div class="mobile-toc-backdrop" id="mobileTocBackdrop" hidden></div>
    <aside class="mobile-toc-sheet" id="mobileTocSheet" aria-hidden="true">
      <div class="mobile-toc-handle" aria-hidden="true"></div>
      <div class="mobile-toc-heading"><span>ON THIS PAGE</span><button id="mobileTocClose" type="button" aria-label="Close table of contents">Close</button></div>
      <nav>{toc.map((item)=><a class="mobile-toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav>
    </aside>
  </div> : null}
</main>

<script is:inline>
const content=document.querySelector('#articleContent');
const progress=document.querySelector('#articleProgress');
const copy=document.querySelector('#copyLink');
const hero=document.querySelector('[data-cover-image]');
const heroImage=hero?.querySelector('.article-hero-media');
if(heroImage){
  heroImage.classList.add('image-loading');
  heroImage.addEventListener('load',()=>heroImage.classList.remove('image-loading'),{once:true});
  if(heroImage.complete) heroImage.classList.remove('image-loading');
}
const normalizeUrl=(value)=>{
  try{
    const url=new URL(value,location.href);
    url.hash='';
    url.search='';
    return url.href;
  }catch{return String(value||'');}
};

const headings=[...(content?.querySelectorAll('h2')||[])];
headings.forEach((heading)=>{
  if(!heading.id){
    heading.id=heading.textContent?.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
  }
});

const links=[...document.querySelectorAll('[data-toc-link]')];
const setActive=(id)=>{
  links.forEach((link)=>link.classList.toggle('active',link.dataset.tocLink===id));
};

if(headings.length){
  const observer=new IntersectionObserver((entries)=>{
    const visible=entries.filter((entry)=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);
    if(visible[0]) setActive(visible[0].target.id);
  },{rootMargin:'-18% 0px -64% 0px',threshold:0});
  headings.forEach((heading)=>observer.observe(heading));
  setActive(headings[0].id);
}

const updateProgress=()=>{
  if(!content||!progress) return;
  const rect=content.getBoundingClientRect();
  const total=Math.max(1,content.offsetHeight-window.innerHeight);
  const current=Math.min(total,Math.max(0,-rect.top));
  progress.style.width=((current/total)*100)+'%';
};
window.addEventListener('scroll',updateProgress,{passive:true});
updateProgress();

const shareBar=document.querySelector('.reader-topbar');
const nativeShare=document.querySelector('#nativeShare');
const shareData={
  title:shareBar?.dataset.shareTitle||document.title,
  text:shareBar?.dataset.shareTitle||document.title,
  url:shareBar?.dataset.shareUrl||location.href
};
if(nativeShare && !navigator.share) nativeShare.hidden=true;
nativeShare?.addEventListener('click',async()=>{
  try{ await navigator.share(shareData); }catch{}
});
copy?.addEventListener('click',async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    copy.textContent='Copied';
    setTimeout(()=>copy.textContent='Copy',1300);
  }catch{copy.textContent='Copy failed';}
});

const coverSrc=normalizeUrl(hero?.dataset.coverImage||'');
const headingsForEnhancements=[...(content?.querySelectorAll('h2')||[])];
headingsForEnhancements.forEach((heading)=>{
  if(heading.textContent?.trim().toLowerCase()==='timeline'){
    const list=heading.nextElementSibling;
    if(list && (list.tagName==='UL'||list.tagName==='OL')) list.classList.add('article-timeline');
  }
});

const inlineToolBlock=document.querySelector('[data-inline-tools]');
if(inlineToolBlock && headingsForEnhancements[1]){
  const anchor=headingsForEnhancements[1].nextElementSibling;
  (anchor||headingsForEnhancements[1]).insertAdjacentElement('afterend',inlineToolBlock);
}

const articleTables=[...(content?.querySelectorAll('table')||[])];
articleTables.forEach((table)=>{
  if(table.parentElement?.classList.contains('article-table-wrap')) return;
  const wrap=document.createElement('div');
  wrap.className='article-table-wrap';
  wrap.setAttribute('role','region');
  wrap.setAttribute('aria-label','Scrollable article table');
  wrap.tabIndex=0;
  table.parentElement?.insertBefore(wrap,table);
  wrap.appendChild(table);
});
const articleImages=[...(content?.querySelectorAll('img')||[])];
const lightbox=document.querySelector('#articleLightbox');
const lightboxImage=document.querySelector('#lightboxImage');
const lightboxCaption=document.querySelector('#lightboxCaption');
const lightboxCount=document.querySelector('#lightboxCount');
const lightboxClose=document.querySelector('#lightboxClose');
const lightboxPrev=document.querySelector('#lightboxPrev');
const lightboxNext=document.querySelector('#lightboxNext');
let galleryImages=[];
let galleryIndex=0;

const setLightboxImage=(index)=>{
  if(!galleryImages.length || !lightboxImage) return;
  galleryIndex=(index+galleryImages.length)%galleryImages.length;
  const item=galleryImages[galleryIndex];
  lightboxImage.src=item.src;
  lightboxImage.alt=item.alt||'';
  if(lightboxCaption) lightboxCaption.textContent=item.caption||'';
  if(lightboxCount) lightboxCount.textContent=String(galleryIndex+1).padStart(2,'0')+' / '+String(galleryImages.length).padStart(2,'0');
};
const closeLightbox=()=>{
  if(!lightbox) return;
  lightbox.hidden=true;
  lightbox.setAttribute('aria-hidden','true');
  document.documentElement.classList.remove('lightbox-open');
  if(lightboxImage) lightboxImage.removeAttribute('src');
};
const openLightbox=(index)=>{
  if(!lightbox || !galleryImages.length) return;
  setLightboxImage(index);
  lightbox.hidden=false;
  lightbox.setAttribute('aria-hidden','false');
  document.documentElement.classList.add('lightbox-open');
  lightboxClose?.focus();
};

articleImages.forEach((img,index)=>{
  img.loading='lazy';
  img.decoding='async';
  img.classList.add('image-loading');
  img.addEventListener('load',()=>img.classList.remove('image-loading'),{once:true});
  if(img.complete) img.classList.remove('image-loading');
  if(!img.getAttribute('width')) img.setAttribute('width','1400');
  if(!img.getAttribute('height')) img.setAttribute('height','788');

  if(index===0 && coverSrc && normalizeUrl(img.currentSrc||img.src)===coverSrc){
    img.closest('p')?.remove();
    return;
  }

  const figure=img.closest('figure');
  const caption=figure?.querySelector('figcaption')?.textContent?.trim() || img.alt?.trim() || '';
  galleryImages.push({src:img.currentSrc||img.src,alt:img.alt||'',caption});
  img.classList.add('zoomable-image');
  img.setAttribute('tabindex','0');
  img.setAttribute('role','button');
  img.setAttribute('aria-label','Open image viewer');
  img.addEventListener('click',()=>{
    const i=galleryImages.findIndex((item)=>item.src===(img.currentSrc||img.src));
    openLightbox(i);
  });
  img.addEventListener('keydown',(event)=>{
    if(event.key==='Enter'||event.key===' '){
      event.preventDefault();
      const i=galleryImages.findIndex((item)=>item.src===(img.currentSrc||img.src));
      openLightbox(i);
    }
  });

  const parent=img.parentElement;
  if(parent?.tagName==='P' && parent.childElementCount===1 && !parent.textContent?.trim()){
    const figure=document.createElement('figure');
    figure.className='article-figure';
    parent.replaceWith(figure);
    figure.appendChild(img);
    if(img.alt?.trim()){
      const caption=document.createElement('figcaption');
      caption.textContent=img.alt.trim();
      figure.appendChild(caption);
    }
  }
});

const mobileToggle=document.querySelector('#mobileTocToggle');
const mobileSheet=document.querySelector('#mobileTocSheet');
const mobileBackdrop=document.querySelector('#mobileTocBackdrop');
const mobileClose=document.querySelector('#mobileTocClose');

const setMobileToc=(open)=>{
  if(!mobileSheet||!mobileToggle) return;
  mobileSheet.setAttribute('aria-hidden',String(!open));
  mobileToggle.setAttribute('aria-expanded',String(open));
  if(mobileBackdrop) mobileBackdrop.hidden=!open;
  document.documentElement.classList.toggle('toc-open',open);
};

mobileToggle?.addEventListener('click',()=>setMobileToc(mobileSheet?.getAttribute('aria-hidden')==='true'));
mobileClose?.addEventListener('click',()=>setMobileToc(false));
mobileBackdrop?.addEventListener('click',()=>setMobileToc(false));
document.querySelectorAll('.mobile-toc-link').forEach((link)=>link.addEventListener('click',()=>setMobileToc(false)));

lightboxPrev?.addEventListener('click',()=>setLightboxImage(galleryIndex-1));
lightboxNext?.addEventListener('click',()=>setLightboxImage(galleryIndex+1));
lightboxClose?.addEventListener('click',closeLightbox);
lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click',closeLightbox);

window.addEventListener('keydown',(event)=>{
  if(event.key==='Escape'){
    setMobileToc(false);
    closeLightbox();
  }
  if(lightbox && !lightbox.hidden){
    if(event.key==='ArrowLeft') setLightboxImage(galleryIndex-1);
    if(event.key==='ArrowRight') setLightboxImage(galleryIndex+1);
  }
});
</script>

<style>
.article-reader{background:linear-gradient(180deg,#07121b 0%,#071018 17%,var(--bg) 55%);min-height:70vh;overflow:clip}
.article-progress{position:fixed;top:94px;left:0;right:0;height:3px;background:transparent;z-index:1100;pointer-events:none}
.article-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--primary),#a8edff);box-shadow:0 0 22px rgba(76,201,255,.55);transition:width .08s linear;transform-origin:left center}

.wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}
.article-hero{position:relative;min-height:640px;display:flex;align-items:flex-end;isolation:isolate;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.08);background:#071018}
.article-hero-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-3;filter:saturate(.9) contrast(1.04);transition:filter .55s ease,transform .55s ease}.article-hero-media.image-loading{filter:saturate(.82) blur(16px);transform:scale(1.035)}
.article-hero-overlay{position:absolute;inset:0;z-index:-2;background:
  linear-gradient(90deg,rgba(3,10,15,.98) 0%,rgba(3,10,15,.86) 31%,rgba(3,10,15,.42) 66%,rgba(3,10,15,.56) 100%),
  linear-gradient(0deg,rgba(3,10,15,.98) 0%,rgba(3,10,15,.7) 25%,rgba(3,10,15,.15) 68%,rgba(3,10,15,.5) 100%)}
.article-hero:after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at 78% 12%,rgba(76,201,255,.16),transparent 24%),linear-gradient(120deg,transparent 35%,rgba(76,201,255,.035) 100%);pointer-events:none}
.article-hero-inner{padding:32px 0 58px}
.article-breadcrumbs{display:flex;gap:9px;align-items:center;max-width:100%;overflow:hidden;color:rgba(225,239,245,.48);font:700 8px/1.4 var(--font-body);letter-spacing:.04em}
.article-breadcrumbs a{color:#8edcfa;text-decoration:none;white-space:nowrap}.article-breadcrumbs span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.article-breadcrumbs span[aria-current="page"]{color:rgba(225,239,245,.58)}
.article-hero-content{max-width:1020px;padding-top:145px}
.article-kicker{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.article-kicker>a{display:inline-flex;align-items:center;padding:7px 9px;border:1px solid rgba(76,201,255,.32);border-radius:999px;background:rgba(6,20,30,.62);color:#92e1ff;text-decoration:none;font:900 7px/1 var(--font-body);letter-spacing:.15em;text-transform:uppercase;backdrop-filter:blur(10px)}
.article-kicker>span{padding:7px 9px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(6,15,22,.58);color:#89a3ad;font:800 7px/1 var(--font-body);letter-spacing:.1em;text-transform:uppercase;backdrop-filter:blur(10px)}
.article-kicker>span.confirmed{color:#77e5a8;border-color:rgba(71,209,108,.28);background:rgba(11,42,26,.6)}
.article-kicker>span.uncertain{color:#f0cc79;border-color:rgba(240,204,121,.28);background:rgba(49,39,17,.62)}
.article-hero h1{max-width:980px;margin:17px 0 15px;font:800 clamp(50px,7vw,92px)/.92 var(--font-display);letter-spacing:-.075em;text-wrap:balance}
.article-dek{max-width:830px;margin:0;color:#d5e5ea;font:500 clamp(16px,1.8vw,21px)/1.48 var(--font-body)}
.article-meta{display:flex;flex-wrap:wrap;gap:7px 12px;align-items:center;margin-top:22px;color:rgba(207,225,232,.64);font:700 8px/1.4 var(--font-body);letter-spacing:.02em}
.article-meta a{color:#a6e6ff;text-decoration:none}.article-meta span[aria-hidden="true"]{color:rgba(207,225,232,.25)}

.reader-topbar{position:sticky;top:94px;z-index:80;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.07);background:linear-gradient(180deg,rgba(7,16,24,.97),rgba(7,16,24,.88));backdrop-filter:blur(14px);box-shadow:0 12px 30px rgba(0,0,0,.12)}
.back-link{color:#7fd9fa;text-decoration:none;font:800 8px/1 var(--font-body);letter-spacing:.04em}.back-link:hover{color:#e4faff}
.share-tools{display:flex;gap:6px;align-items:center;min-width:0;overflow-x:auto;scrollbar-width:none}.share-tools::-webkit-scrollbar{display:none}.share-tools span,.share-tools button,.share-tools a{padding:7px 9px;border:1px solid rgba(255,255,255,.09);border-radius:999px;background:rgba(12,24,34,.72);color:#7895a1;font:800 7px/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase;text-decoration:none;white-space:nowrap}.share-tools .share-category{color:#88d7f6}.share-tools .share-x{color:#dfecef}.share-tools .share-whatsapp{color:#83dfa8}.share-tools button{cursor:pointer}.share-tools button:hover,.share-tools a:hover{color:#e6fbff;border-color:rgba(76,201,255,.3);transform:translateY(-1px)}

.reader-shell{padding:30px 0 88px}
.reader-grid{display:grid;grid-template-columns:minmax(0,740px) 270px;gap:52px;align-items:start}
.article-content{min-width:0;color:#cedee4;font:400 16px/1.92 var(--font-body);letter-spacing:-.003em}
.article-content h2{margin:62px 0 17px;color:#eef9fc;font:700 clamp(28px,3.1vw,34px)/1.08 var(--font-display);letter-spacing:-.045em;scroll-margin-top:112px}
.article-content h3{margin:39px 0 12px;color:#e0f0f4;font:700 clamp(20px,2.2vw,23px)/1.2 var(--font-display);letter-spacing:-.025em;scroll-margin-top:112px}
.article-content>p:first-of-type{font-size:18px;line-height:1.82;color:#dcebf0;letter-spacing:-.012em}
.article-content>p:first-of-type::first-letter{color:#8fdef7}
.article-content p{max-width:740px;margin:0 0 25px}
.article-content ul,.article-content ol{max-width:720px;margin:0 0 29px;padding-left:25px;color:#b7cbd2}
.article-content li{margin:9px 0;padding-left:3px}.article-content li::marker{color:#63d5f6;font-weight:800}.article-content a{color:#90defb;text-decoration:underline;text-decoration-color:rgba(76,201,255,.35);text-underline-offset:4px}
.article-content a:hover{color:#d7f7ff;text-decoration-color:rgba(76,201,255,.75)}
.article-content strong{color:#edf8fb;font-weight:750}
.article-content em{color:#c4d8de}
.article-content mark{padding:.08em .25em;border-radius:.35em;background:#d9f26a;color:#10160d}
.article-content code{padding:.17em .35em;border:1px solid rgba(76,201,255,.12);border-radius:6px;background:#0a1a23;color:#9de7ff;font:700 .82em var(--mono)}
.article-content pre{max-width:740px;margin:30px 0;padding:18px 20px;overflow:auto;border:1px solid rgba(255,255,255,.08);border-radius:16px;background:#050c11;color:#cfe9f0;box-shadow:0 18px 46px rgba(0,0,0,.22)}
.article-content pre code{padding:0;border:0;background:transparent;color:inherit;font:500 12px/1.7 var(--mono)}
.article-content blockquote{max-width:720px;margin:34px 0;padding:20px 22px;border:1px solid rgba(76,201,255,.12);border-left:3px solid var(--primary);border-radius:0 16px 16px 0;background:linear-gradient(135deg,rgba(76,201,255,.10),rgba(76,201,255,.02));color:#c4dbe2;font:600 17px/1.68 var(--font-display);box-shadow:0 18px 48px rgba(0,0,0,.16)}
.article-content blockquote p:last-child{margin-bottom:0}
.article-content hr{margin:48px 0;border:0;border-top:1px solid rgba(255,255,255,.08)}
.article-content table{width:100%;margin:34px 0 38px;border:1px solid rgba(76,201,255,.12);border-radius:18px;border-collapse:separate;border-spacing:0;background:linear-gradient(145deg,#091720,#071118);box-shadow:0 18px 55px rgba(0,0,0,.18);overflow:hidden}.article-content table th,.article-content table td{padding:14px 15px;border-right:1px solid rgba(255,255,255,.045);border-bottom:1px solid rgba(255,255,255,.065);text-align:left;vertical-align:top;overflow-wrap:anywhere}.article-content table th:last-child,.article-content table td:last-child{border-right:0}.article-content table tr:last-child td{border-bottom:0}.article-content table th{color:#a9e8fa;background:linear-gradient(180deg,#102633,#0d202b);font:900 8px/1.35 var(--font-body);letter-spacing:.1em;text-transform:uppercase}.article-content table td{color:#b8cbd1;font-size:12px;line-height:1.6}.article-content table tbody tr:nth-child(even) td{background:rgba(255,255,255,.014)}.article-table-wrap{width:100%;margin:34px 0 38px;overflow:auto;border:1px solid rgba(76,201,255,.12);border-radius:18px;background:linear-gradient(145deg,#091720,#071118);box-shadow:0 18px 55px rgba(0,0,0,.18);-webkit-overflow-scrolling:touch}
.article-table-wrap table{width:100%;min-width:560px;margin:0;border:0;border-collapse:separate;border-spacing:0;overflow:visible}
.article-table-wrap th,.article-table-wrap td{padding:14px 15px;border-right:1px solid rgba(255,255,255,.045);border-bottom:1px solid rgba(255,255,255,.065);text-align:left;vertical-align:top}
.article-table-wrap th:last-child,.article-table-wrap td:last-child{border-right:0}
.article-table-wrap tr:last-child td{border-bottom:0}
.article-table-wrap th{position:sticky;top:0;z-index:2;color:#a9e8fa;background:linear-gradient(180deg,#102633,#0d202b);font:900 8px/1.35 var(--font-body);letter-spacing:.1em;text-transform:uppercase;box-shadow:0 1px 0 rgba(76,201,255,.12)}
.article-table-wrap td{color:#b8cbd1;font-size:12px;line-height:1.6}
.article-table-wrap tbody tr:nth-child(even) td{background:rgba(255,255,255,.014)}
.article-table-wrap tbody tr:hover td{background:rgba(76,201,255,.035);color:#e1f4f8}.article-table-wrap:focus-visible{outline:2px solid rgba(76,201,255,.75);outline-offset:3px}.article-table-wrap::-webkit-scrollbar{height:9px}.article-table-wrap::-webkit-scrollbar-track{background:#061017}.article-table-wrap::-webkit-scrollbar-thumb{background:rgba(103,196,226,.24);border-radius:999px}.article-table-wrap caption{padding:10px 14px;color:#7fa7b4;text-align:left;font:800 8px/1.4 var(--font-body);letter-spacing:.08em;text-transform:uppercase;background:rgba(76,201,255,.035);border-bottom:1px solid rgba(255,255,255,.06)}
.article-table-wrap td strong{color:#e7f7fa}
.article-figure{margin:34px 0 36px}.article-figure img{display:block;width:100%;height:auto;max-height:680px;object-fit:contain;transition:filter .45s ease,transform .35s ease,box-shadow .35s ease;background:#071119;border:1px solid rgba(255,255,255,.09);border-radius:17px;box-shadow:0 26px 70px rgba(0,0,0,.28);content-visibility:auto;cursor:zoom-in}.article-figure img:hover{transform:translateY(-2px);box-shadow:0 30px 80px rgba(0,0,0,.36),0 0 0 1px rgba(76,201,255,.12)}.article-figure img.image-loading{filter:blur(14px);transform:scale(1.015)}
.article-figure figcaption{margin-top:9px;padding:0 2px;color:#67828e;font:600 8px/1.55 var(--font-body);letter-spacing:.02em}
.article-content>p>img{display:block;width:100%;height:auto;margin:34px 0;border:1px solid rgba(255,255,255,.09);border-radius:17px;cursor:zoom-in;transition:transform .35s ease,box-shadow .35s ease}.article-content>p>img:hover{transform:translateY(-2px);box-shadow:0 30px 80px rgba(0,0,0,.3)}

.side-card{padding:15px;border:1px solid rgba(255,255,255,.08);border-radius:17px;background:linear-gradient(145deg,rgba(14,26,37,.95),rgba(8,17,25,.97));box-shadow:0 18px 55px rgba(0,0,0,.18)}
.reader-sidebar{position:sticky;top:92px;display:grid;gap:11px;align-self:start;max-height:calc(100vh - 112px)}
.toc-card{min-height:0}.side-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:9px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.07)}
.side-heading span{color:#64808d;font:900 7px/1 var(--font-body);letter-spacing:.14em}.side-heading b{color:#55717d;font:800 6.5px/1 var(--font-body)}
.toc-card nav{display:grid;gap:2px;max-height:56vh;overflow:auto;padding-right:3px;scrollbar-width:thin}
.toc-link{padding:8px 7px;border-left:2px solid transparent;border-radius:0 8px 8px 0;color:#839ca7;text-decoration:none;font:600 8.5px/1.45 var(--font-body);transition:background .18s ease,color .18s ease,border-color .18s ease}
.toc-link:hover{color:#dff9ff;background:rgba(76,201,255,.05)}.toc-link.active{color:#e9fbff;border-left-color:var(--primary);background:linear-gradient(90deg,rgba(76,201,255,.1),transparent)}
.side-empty{margin:0;color:#6e8792;font:400 9px/1.65 var(--font-body)}

.author-side{display:grid;grid-template-columns:42px 1fr;gap:10px;align-items:center}
.author-avatar{width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.22);border-radius:13px;background:linear-gradient(145deg,#0c2635,#091620);color:#8edffc;font:800 14px/1 var(--font-display)}
.author-side span{display:block;color:#567682;font:900 6.5px/1 var(--font-body);letter-spacing:.13em}.author-side a{display:block;margin-top:4px;color:#d5eff5;font:700 11px/1.2 var(--font-display)}.author-side p{margin:3px 0 0;color:#718b96;font:400 8px/1.5 var(--font-body)}
.side-list{display:grid}.side-list a{display:grid;gap:5px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.06);color:var(--text);text-decoration:none}.side-list a:last-child{border-bottom:0}.side-list small{color:#7cd8f7;font:800 6.5px/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase}.side-list strong{color:#d5e7ec;font:700 9.5px/1.38 var(--font-display)}
.topic-list{display:flex;flex-wrap:wrap;gap:6px}.topic-list span{padding:6px 8px;border:1px solid rgba(255,255,255,.08);border-radius:999px;color:#76939f;background:rgba(255,255,255,.02);font:700 7px/1 var(--font-body)}
.source-list{display:grid;gap:7px}.source-list a{color:#8dddfa;text-decoration:none;font:800 8px/1.35 var(--font-body)}

.inline-tools{display:grid;gap:11px;margin:43px 0 22px;padding:18px;border:1px solid rgba(76,201,255,.15);border-radius:18px;background:linear-gradient(145deg,rgba(10,31,43,.9),rgba(8,19,28,.96));box-shadow:0 20px 52px rgba(0,0,0,.18)}
.inline-tools-heading{display:flex;justify-content:space-between;gap:14px;align-items:end;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.07)}
.inline-tools-heading span{color:#5f7c88;font:900 7px/1 var(--font-body);letter-spacing:.13em}
.inline-tools-heading strong{color:#88b4c1;font:700 7px/1.3 var(--font-body)}
.inline-tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px}
.inline-tool-card{display:grid;gap:6px;min-height:125px;padding:13px;border:1px solid rgba(255,255,255,.07);border-radius:14px;background:rgba(7,18,26,.72);color:var(--text);text-decoration:none;transition:.2s}
.inline-tool-card:hover{transform:translateY(-2px);border-color:rgba(76,201,255,.28);background:#0a1b25}
.inline-tool-card .tool-mark{color:#67d7f6;font:900 6.5px/1 var(--font-body);letter-spacing:.12em}
.inline-tool-card>strong{color:#e0f5fa;font:700 12px/1.2 var(--font-display)}
.inline-tool-card p{margin:0;color:#708a95;font:400 8.5px/1.55 var(--font-body)}
.inline-tool-card>b{align-self:end;color:#8fdff9;font:800 7px/1 var(--font-body);text-transform:uppercase}

.article-timeline{position:relative;display:grid;gap:0;list-style:none;margin:25px 0 34px!important;padding:0 0 0 22px!important}
.article-timeline:before{content:"";position:absolute;left:6px;top:7px;bottom:7px;width:1px;background:linear-gradient(180deg,rgba(76,201,255,.62),rgba(76,201,255,.08))}
.article-timeline>li{position:relative;margin:0!important;padding:0 0 22px 18px!important;color:#b8ccd3}
.article-timeline>li:last-child{padding-bottom:0!important}
.article-timeline>li:before{content:"";position:absolute;left:-20px;top:4px;width:8px;height:8px;border:2px solid #67d7f6;border-radius:50%;background:#071018;box-shadow:0 0 0 5px rgba(76,201,255,.07),0 0 18px rgba(76,201,255,.22)}
.article-timeline>li>strong:first-child{display:block;margin-bottom:5px;color:#72dafa;font:900 7px/1 var(--font-body);letter-spacing:.1em;text-transform:uppercase}
.article-timeline>li>strong:first-child+*{margin-top:0}

.related-end{margin:72px 0 10px;padding-top:30px;border-top:1px solid rgba(255,255,255,.08)}
.related-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:16px}
.related-heading h2{margin:9px 0 0;font:700 clamp(28px,3vw,39px)/.98 var(--font-display);letter-spacing:-.055em}
.related-heading h2 em{font-style:normal;color:var(--primary)}
.related-heading>a{color:#7fd9fa;text-decoration:none;font:800 8px/1 var(--font-body)}
.related-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:10px}
.related-lead,.related-side>a{border:1px solid rgba(255,255,255,.08);border-radius:18px;background:linear-gradient(145deg,#0b1a23,#071119);color:var(--text);text-decoration:none;overflow:hidden;transition:.24s}
.related-lead{display:grid;grid-template-columns:1fr 1fr}
.related-lead:hover,.related-side>a:hover{transform:translateY(-3px);border-color:rgba(76,201,255,.28);box-shadow:0 24px 65px rgba(0,0,0,.3)}
.related-media{position:relative;min-height:260px;background:#0a181f;overflow:hidden}
.related-media img,.related-side-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s ease}
.related-lead:hover .related-media img,.related-side>a:hover .related-side-media img{transform:scale(1.04)}
.related-media i{position:absolute;left:13px;top:13px;padding:6px 8px;border:1px solid rgba(76,201,255,.25);border-radius:999px;background:rgba(5,16,24,.78);color:#8bdffb;font:900 6.5px/1 var(--font-body);font-style:normal;text-transform:uppercase}
.related-lead-body{display:flex;flex-direction:column;justify-content:center;padding:22px}
.related-lead-body small{color:#5f7c88;font:900 6.5px/1 var(--font-body);letter-spacing:.13em}
.related-lead-body h3{margin:9px 0 8px;color:#e4f5f8;font:700 24px/1.06 var(--font-display);letter-spacing:-.04em}
.related-lead-body p{margin:0;color:#76909b;font:400 9px/1.65 var(--font-body)}
.related-lead-body>b{margin-top:17px;color:#8edff9;font:800 7px/1 var(--font-body);text-transform:uppercase}
.related-side{display:grid;gap:10px}
.related-side>a{display:grid;grid-template-columns:110px 1fr;min-height:140px}
.related-side-media{background:#0a181f;overflow:hidden}
.related-side>a>div:last-child{padding:14px;display:flex;flex-direction:column}
.related-side small{color:#6bd8f7;font:900 6px/1 var(--font-body);text-transform:uppercase}
.related-side strong{margin-top:7px;color:#d7e9ee;font:700 11px/1.3 var(--font-display)}
.related-side b{margin-top:auto;color:#7795a1;font:800 6.5px/1 var(--font-body)}

.article-lightbox{position:fixed;inset:0;z-index:4000}.article-lightbox[hidden]{display:none}.lightbox-backdrop{position:absolute;inset:0;background:rgba(1,6,10,.88);backdrop-filter:blur(16px)}.lightbox-shell{position:relative;width:min(1280px,calc(100% - 28px));height:min(92vh,900px);margin:4vh auto;display:grid;grid-template-rows:auto 1fr;border:1px solid rgba(255,255,255,.1);border-radius:22px;background:linear-gradient(180deg,#0b1821,#050b10);box-shadow:0 40px 120px rgba(0,0,0,.58);overflow:hidden}.lightbox-topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 15px;border-bottom:1px solid rgba(255,255,255,.07);color:#6f8994;font:900 7px/1 var(--font-body);letter-spacing:.12em}.lightbox-topbar button{width:32px;height:32px;border:1px solid rgba(255,255,255,.1);border-radius:50%;background:#0b1d27;color:#bcebf7;font:900 18px/1 var(--font-body);cursor:pointer}.lightbox-stage{position:relative;display:grid;place-items:center;min-height:0;padding:24px 70px}.lightbox-stage figure{display:grid;place-items:center;min-width:0;max-width:100%;max-height:100%;margin:0}.lightbox-stage img{display:block;max-width:100%;max-height:calc(92vh - 110px);width:auto;height:auto;object-fit:contain;border-radius:14px;box-shadow:0 28px 90px rgba(0,0,0,.5)}.lightbox-stage figcaption{max-width:760px;margin-top:10px;text-align:center;color:#7d98a3;font:500 9px/1.5 var(--font-body)}.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border:1px solid rgba(255,255,255,.1);border-radius:50%;background:rgba(9,25,34,.86);color:#d4f4fb;font:700 28px/1 var(--font-display);cursor:pointer;z-index:2}.lightbox-nav:hover{border-color:rgba(76,201,255,.35);background:#0c2632}.lightbox-nav.prev{left:16px}.lightbox-nav.next{right:16px}.lightbox-nav:disabled{opacity:.35;cursor:default}

.article-end
.article-end a{color:#7897a3;text-decoration:none;font:800 8px/1 var(--font-body)}.article-end a:hover{color:#e3f8ff}

.mobile-toc{display:none}
:global(html.toc-open),:global(html.toc-open body),:global(html.lightbox-open),:global(html.lightbox-open body){overflow:hidden}

@media(max-width:1040px){
  .reader-grid{grid-template-columns:minmax(0,1fr) 250px;gap:32px}.article-content{font-size:15.5px}.article-hero{min-height:590px}
}
@media(max-width:820px){
  .wrap{width:min(100% - 28px,740px)}
  .article-hero{min-height:600px}.article-hero-inner{padding-bottom:42px}.article-hero-content{padding-top:95px}
  .article-hero h1{font-size:clamp(45px,9.3vw,70px)}
  .reader-topbar{top:58px}.reader-grid{display:block}.reader-sidebar{display:none}
  .reader-shell{padding-top:23px}.article-content{font-size:15.5px;line-height:1.9}
  .mobile-toc{display:block}
  .mobile-toc-toggle{position:fixed;left:14px;right:14px;bottom:14px;z-index:1180;display:flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:12px 15px;border:1px solid rgba(76,201,255,.2);border-radius:15px;background:rgba(8,19,28,.9);color:#dbf8ff;font:800 10px/1 var(--font-body);box-shadow:0 18px 48px rgba(0,0,0,.36);backdrop-filter:blur(18px)}
  .mobile-toc-toggle b{min-width:20px;padding:4px 6px;border:1px solid rgba(76,201,255,.16);border-radius:999px;color:#74d6f5;font:800 7px/1 var(--font-body)}
  .mobile-toc-toggle i{font-style:normal;color:#6c8a96;transform:translateY(-1px)}
  .mobile-toc-backdrop{position:fixed;inset:0;z-index:1185;background:rgba(1,7,11,.66);backdrop-filter:blur(5px)}
  .mobile-toc-sheet{position:fixed;left:0;right:0;bottom:0;z-index:1190;max-height:min(74vh,620px);overflow:auto;padding:9px 18px 24px;border-top:1px solid rgba(76,201,255,.17);border-radius:22px 22px 0 0;background:linear-gradient(180deg,#0c1b26,#071119);box-shadow:0 -30px 90px rgba(0,0,0,.5);transform:translateY(110%);transition:transform .25s ease}
  .mobile-toc-sheet[aria-hidden="false"]{transform:translateY(0)}.mobile-toc-handle{width:42px;height:4px;margin:0 auto 13px;border-radius:999px;background:#385460}.mobile-toc-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px}.mobile-toc-heading span{color:#6c8793;font:900 7px/1 var(--font-body);letter-spacing:.14em}.mobile-toc-heading button{border:0;background:transparent;color:#88d7f6;font:800 8px/1 var(--font-body);cursor:pointer}
  .mobile-toc-sheet nav{display:grid;gap:2px}.mobile-toc-link{padding:11px 8px;border-left:2px solid transparent;border-radius:0 9px 9px 0;color:#88a2ad;text-decoration:none;font:600 10px/1.45 var(--font-body)}.mobile-toc-link.active{color:#effcff;border-left-color:var(--primary);background:rgba(76,201,255,.07)}
}
@media(max-width:820px){
  .related-grid{grid-template-columns:1fr}
  .related-lead{grid-template-columns:1fr}
  .related-media{min-height:220px}
