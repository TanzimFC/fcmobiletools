.topic-list{display:flex;flex-wrap:wrap;gap:6px}.topic-list span{padding:6px 8px;border:1px solid rgba(255,255,255,.08);border-radius:999px;color:#76939f;background:rgba(255,255,255,.02);font:700 7px/1 var(--font-body)}
.source-list{display:grid;gap:7px}.source-list a{color:#8dddfa;text-decoration:none;font:800 8px/1.35 var(--font-body)}

.inline-tools{display:grid;gap:9px;margin:43px 0 16px;padding:17px;border:1px solid rgba(76,201,255,.15);border-radius:16px;background:linear-gradient(145deg,rgba(10,31,43,.88),rgba(8,19,28,.92));box-shadow:0 20px 52px rgba(0,0,0,.18)}
