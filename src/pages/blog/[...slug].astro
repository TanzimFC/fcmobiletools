---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WarningBox from '../../components/article/WarningBox.astro';
import { getCollection, render } from 'astro:content';

const slugify=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft))
  .sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));

export async function getStaticPaths(){
  const postsForPaths=await getCollection('blog',({data})=>data.status==='published'&&!data.draft);
  return postsForPaths.map((post)=>({params:{slug:post.slug},props:{post}}));
}

const {post}=Astro.props;
const {Content}=await render(post);
const others=posts.filter((item)=>item.slug!==post.slug);
const related=others.filter((item)=>{
  const tags=(item.data.tags??[]);
  const own=(post.data.tags??[]);
  return item.data.type===post.data.type || item.data.category===post.data.category || tags.some((tag)=>own.includes(tag));
}).slice(0,5);
const featured=others.filter((item)=>item.data.featured).slice(0,4);
const firstImageMatch=String(post.body||'').match(/!\[[^\]]*\]\(([^)]+)\)/);
const firstInlineImage=firstImageMatch ? firstImageMatch[1] : '';
const coverImage=post.data.image||firstInlineImage;
const heroImage=String(coverImage||'').includes('res.cloudinary.com') && String(coverImage).includes('/image/upload/')
  ? String(coverImage).replace('/image/upload/','/image/upload/f_auto,q_auto,w_1600,h_900,c_fill,g_auto/')
  : coverImage;
const readingTime=post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\s+/).filter(Boolean).length??0)/220));
const date=(value)=>value?value.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}):'';
const categoryOf=()=>{
  if(post.data.type==='leaks') return 'Leaks';
  if(post.data.type==='news') return 'Updates';
  if(post.data.type==='analysis') return 'Analysis';
  if(post.data.type==='player-review') return 'Reviews';
  if(post.data.type==='opinion') return 'Tactics';
  return 'Guides';
};
const category=categoryOf();
const categoryKey=category.toLowerCase();
const toc=(post.body??'').split('\n').map(line=>{
  const match=line.match(/^##\s+(.+)$/);
  if(!match) return null;
  const text=match[1].trim();
  return {text,id:slugify(text)};
}).filter(Boolean);
const articleType=post.data.type==='news'?'NewsArticle':'Article';
const articleSchema={
  '@context':'https://schema.org',
  '@type':articleType,
  headline:post.data.title,
  description:post.data.seoDescription??post.data.description,
  datePublished:post.data.publishedAt?.toISOString(),
  dateModified:(post.data.updatedAt??post.data.publishedAt)?.toISOString(),
  author:{'@type':'Person',name:post.data.author},
  publisher:{'@type':'Person',name:'TanzimFC'},
  image:coverImage?[coverImage]:undefined,
  mainEntityOfPage:new URL('/blog/'+post.slug+'/',Astro.site??'https://tanzimfc.fcmobiletools.workers.dev').toString()
};
---
<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.seoDescription ?? post.data.description} image={coverImage} type="article">
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
<div class="article-progress"><span id="articleProgress"></span></div>

<main class="article-reader" data-article-page>
  <section class="article-hero" data-cover-image={coverImage}>
    {heroImage ? <img
      class="article-hero-media"
      src={heroImage}
      alt={post.data.imageAlt ?? post.data.title}
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    /> : null}
    <div class="article-hero-overlay" aria-hidden="true"></div>

    <div class="wrap article-hero-inner">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog">Articles</a><span>/</span><a href={'/blog/category/' + categoryKey + '/'}>{category}</a><span>/</span><span aria-current="page">{post.data.title}</span>
      </nav>

      <div class="article-hero-content">
        <div class="article-kicker">
          <a href={'/blog/category/' + categoryKey + '/'}>{category}</a>
          {post.data.factStatus ? <span class:list={{ confirmed:post.data.factStatus==='verified', uncertain:post.data.factStatus!=='verified' }}>{post.data.factStatus==='community-reported'?'UNCONFIRMED':post.data.factStatus.replaceAll('-',' ')}</span> : null}
        </div>

        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.subtitle ?? post.data.description}</p>

        <div class="article-meta" aria-label="Article metadata">
          <a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a>
          <span aria-hidden="true">·</span>
          <span>{post.data.updatedAt ? 'Updated ' + date(post.data.updatedAt) : 'Published ' + date(post.data.publishedAt)}</span>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap reader-topbar">
    <a class="back-link" href="/blog">← Back to articles</a>
    <div class="share-tools">
      <span>{category}</span>
      <button type="button" id="copyLink">Copy link</button>
    </div>
  </div>

  <div class="wrap reader-shell">
    {post.data.factStatus==='community-reported' ? <WarningBox label="Unconfirmed">This article uses community reports, footage or screenshots and is not presented as confirmed game information.</WarningBox> : null}

    <div class="reader-grid">
      <article class="article-content" id="articleContent">
        <Content />
        {post.data.relatedTools?.length ? <div class="inline-tools"><span>USEFUL WITH THIS ARTICLE</span>{post.data.relatedTools.map((tool)=><a href={tool.startsWith('/')?tool:'/'+tool}>{tool.replaceAll('-',' ')}</a>)}</div> : null}
      </article>

      <aside class="reader-sidebar" aria-label="Article navigation and related reading">
        <section class="side-card toc-card">
          <div class="side-heading"><span>ON THIS PAGE</span><b>{toc.length} sections</b></div>
          {toc.length ? <nav>{toc.map((item)=><a class="toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav> : <p class="side-empty">This article is best read from top to bottom.</p>}
        </section>

        <section class="side-card author-side">
          <div class="author-avatar">{post.data.author.slice(0,1).toUpperCase()}</div>
          <div><span>WRITTEN BY</span><a href={'/blog/author/' + slugify(post.data.author) + '/'}>{post.data.author}</a><p>FC Mobile creator and contributor.</p></div>
        </section>

        {related.length ? <section class="side-card">
          <div class="side-heading"><span>KEEP READING</span><b>{related.length}</b></div>
          <div class="side-list">{related.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {featured.length ? <section class="side-card">
          <div class="side-heading"><span>FEATURED</span><b>READ</b></div>
          <div class="side-list">{featured.map((item)=><a href={'/blog/' + item.slug + '/'}><small>{item.data.category}</small><strong>{item.data.title}</strong></a>)}</div>
        </section> : null}

        {post.data.tags?.length ? <section class="side-card">
          <div class="side-heading"><span>TOPICS</span><b>{post.data.tags.length}</b></div>
          <div class="topic-list">{post.data.tags.map((tag)=><span>{tag}</span>)}</div>
        </section> : null}

        {post.data.sources?.length ? <section class="side-card">
          <div class="side-heading"><span>SOURCES</span><b>LINKS</b></div>
          <div class="source-list">{post.data.sources.map((source)=><a href={source} target="_blank" rel="noopener noreferrer">Open source ↗</a>)}</div>
        </section> : null}
      </aside>
    </div>

    <footer class="article-end">
      <a href="/blog">← Back to all articles</a>
      <a href="/creator">Meet the creators ↗</a>
    </footer>
  </div>

  {toc.length ? <div class="mobile-toc" data-mobile-toc>
    <button class="mobile-toc-toggle" id="mobileTocToggle" type="button" aria-expanded="false" aria-controls="mobileTocSheet">
      <span>On this page</span><b>{toc.length}</b><i aria-hidden="true">⌃</i>
    </button>
    <div class="mobile-toc-backdrop" id="mobileTocBackdrop" hidden></div>
    <aside class="mobile-toc-sheet" id="mobileTocSheet" aria-hidden="true">
      <div class="mobile-toc-handle" aria-hidden="true"></div>
      <div class="mobile-toc-heading"><span>ON THIS PAGE</span><button id="mobileTocClose" type="button" aria-label="Close table of contents">Close</button></div>
      <nav>{toc.map((item)=><a class="mobile-toc-link" data-toc-link={item.id} href={'#'+item.id}>{item.text}</a>)}</nav>
    </aside>
  </div> : null}
</main>

<script is:inline>
const content=document.querySelector('#articleContent');
const progress=document.querySelector('#articleProgress');
const copy=document.querySelector('#copyLink');
const hero=document.querySelector('[data-cover-image]');
const normalizeUrl=(value)=>{
  try{
    const url=new URL(value,location.href);
    url.hash='';
    url.search='';
    return url.href;
  }catch{return String(value||'');}
};

const headings=[...(content?.querySelectorAll('h2')||[])];
headings.forEach((heading)=>{
  if(!heading.id){
    heading.id=heading.textContent?.toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
  }
});

const links=[...document.querySelectorAll('[data-toc-link]')];
const setActive=(id)=>{
  links.forEach((link)=>link.classList.toggle('active',link.dataset.tocLink===id));
};

if(headings.length){
  const observer=new IntersectionObserver((entries)=>{
    const visible=entries.filter((entry)=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);
    if(visible[0]) setActive(visible[0].target.id);
  },{rootMargin:'-18% 0px -64% 0px',threshold:0});
  headings.forEach((heading)=>observer.observe(heading));
  setActive(headings[0].id);
}

const updateProgress=()=>{
  if(!content||!progress) return;
  const rect=content.getBoundingClientRect();
  const total=Math.max(1,content.offsetHeight-window.innerHeight);
  const current=Math.min(total,Math.max(0,-rect.top));
  progress.style.width=((current/total)*100)+'%';
};
window.addEventListener('scroll',updateProgress,{passive:true});
updateProgress();

copy?.addEventListener('click',async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    copy.textContent='Copied';
    setTimeout(()=>copy.textContent='Copy link',1300);
  }catch{copy.textContent='Copy failed';}
});

const coverSrc=normalizeUrl(hero?.dataset.coverImage||'');
const articleImages=[...(content?.querySelectorAll('img')||[])];
articleImages.forEach((img,index)=>{
  img.loading='lazy';
  img.decoding='async';
  if(!img.getAttribute('width')) img.setAttribute('width','1400');
  if(!img.getAttribute('height')) img.setAttribute('height','788');

  if(index===0 && coverSrc && normalizeUrl(img.currentSrc||img.src)===coverSrc){
    img.closest('p')?.remove();
    return;
  }

  const parent=img.parentElement;
  if(parent?.tagName==='P' && parent.childElementCount===1 && !parent.textContent?.trim()){
    const figure=document.createElement('figure');
    figure.className='article-figure';
    parent.replaceWith(figure);
    figure.appendChild(img);
    if(img.alt?.trim()){
      const caption=document.createElement('figcaption');
      caption.textContent=img.alt.trim();
      figure.appendChild(caption);
    }
  }
});

const mobileToggle=document.querySelector('#mobileTocToggle');
const mobileSheet=document.querySelector('#mobileTocSheet');
const mobileBackdrop=document.querySelector('#mobileTocBackdrop');
const mobileClose=document.querySelector('#mobileTocClose');

const setMobileToc=(open)=>{
  if(!mobileSheet||!mobileToggle) return;
  mobileSheet.setAttribute('aria-hidden',String(!open));
  mobileToggle.setAttribute('aria-expanded',String(open));
  if(mobileBackdrop) mobileBackdrop.hidden=!open;
  document.documentElement.classList.toggle('toc-open',open);
};

mobileToggle?.addEventListener('click',()=>setMobileToc(mobileSheet?.getAttribute('aria-hidden')==='true'));
mobileClose?.addEventListener('click',()=>setMobileToc(false));
mobileBackdrop?.addEventListener('click',()=>setMobileToc(false));
document.querySelectorAll('.mobile-toc-link').forEach((link)=>link.addEventListener('click',()=>setMobileToc(false)));
window.addEventListener('keydown',(event)=>{if(event.key==='Escape') setMobileToc(false)});
</script>

<style>
