.article-kicker>span{padding:7px 9px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(6,15,22,.58);color:#89a3ad;font:800 7px/1 var(--font-body);letter-spacing:.1em;text-transform:uppercase;backdrop-filter:blur(10px)}
