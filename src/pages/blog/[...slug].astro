  linear-gradient(90deg,rgba(3,10,15,.98) 0%,rgba(3,10,15,.86) 31%,rgba(3,10,15,.42) 66%,rgba(3,10,15,.56) 100%),
  linear-gradient(0deg,rgba(3,10,15,.98) 0%,rgba(3,10,15,.7) 25%,rgba(3,10,15,.15) 68%,rgba(3,10,15,.5) 100%)}
.article-hero:after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(circle at 78% 12%,rgba(76,201,255,.16),transparent 24%),linear-gradient(120deg,transparent 35%,rgba(76,201,255,.035) 100%);pointer-events:none}
.article-hero-inner{padding:32px 0 58px}
.article-breadcrumbs{display:flex;gap:9px;align-items:center;max-width:100%;overflow:hidden;color:rgba(225,239,245,.48);font:700 8px/1.4 var(--font-body);letter-spacing:.04em}
.article-breadcrumbs a{color:#8edcfa;text-decoration:none;white-space:nowrap}.article-breadcrumbs span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.article-breadcrumbs span[aria-current="page"]{color:rgba(225,239,245,.58)}
