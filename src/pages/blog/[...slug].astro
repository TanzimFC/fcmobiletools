.article-meta a{color:#a6e6ff;text-decoration:none}.article-meta span[aria-hidden="true"]{color:rgba(207,225,232,.25)}

.reader-topbar{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:19px 0 18px;border-bottom:1px solid rgba(255,255,255,.07)}
.back-link{color:#7fd9fa;text-decoration:none;font:800 8px/1 var(--font-body);letter-spacing:.04em}.back-link:hover{color:#e4faff}
.share-tools{display:flex;gap:8px;align-items:center}.share-tools span,.share-tools button{padding:7px 9px;border:1px solid rgba(255,255,255,.09);border-radius:999px;background:rgba(12,24,34,.72);color:#7895a1;font:800 7px/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase}
