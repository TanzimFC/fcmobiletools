.article-content hr{margin:45px 0;border:0;border-top:1px solid rgba(255,255,255,.08)}
.article-content table{width:100%;margin:31px 0;border:1px solid rgba(255,255,255,.08);border-radius:14px;border-collapse:separate;border-spacing:0;overflow:hidden}
.article-content th,.article-content td{padding:12px 13px;border-bottom:1px solid rgba(255,255,255,.06);text-align:left}
.article-content tr:last-child td{border-bottom:0}.article-content th{color:#bdeafb;background:rgba(15,34,46,.75);font:800 8px/1.3 var(--font-body);letter-spacing:.09em;text-transform:uppercase}.article-content td{color:#afc3ca;font-size:12px;line-height:1.55}
.article-figure{margin:34px 0 36px}.article-figure img{display:block;width:100%;height:auto;max-height:680px;object-fit:contain;background:#071119;border:1px solid rgba(255,255,255,.09);border-radius:17px;box-shadow:0 26px 70px rgba(0,0,0,.28);content-visibility:auto}
.article-figure figcaption{margin-top:9px;padding:0 2px;color:#67828e;font:600 8px/1.55 var(--font-body);letter-spacing:.02em}
.article-content>p>img{display:block;width:100%;height:auto;margin:34px 0;border:1px solid rgba(255,255,255,.09);border-radius:17px}

.side-card{padding:15px;border:1px solid rgba(255,255,255,.08);border-radius:17px;background:linear-gradient(145deg,rgba(14,26,37,.95),rgba(8,17,25,.97));box-shadow:0 18px 55px rgba(0,0,0,.18)}
