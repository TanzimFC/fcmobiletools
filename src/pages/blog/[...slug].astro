.lightbox-stage figcaption{max-width:760px;margin-top:12px;text-align:center;color:#87a0ab;font-size:14px;line-height:1.5}
.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border:1px solid #ffffff1a;border-radius:50%;background:#091922e0;color:#d4f4fb;font-size:28px;line-height:1;cursor:pointer;z-index:2}
.lightbox-nav:hover{border-color:var(--accent)}.lightbox-nav.prev{left:16px}.lightbox-nav.next{right:16px}
.share-chip:focus-visible,.back-link:focus-visible,.related-card:focus-visible,.inline-tool-card:focus-visible,.zoomable-image:focus-visible,.toc-link:focus-visible,.lightbox-nav:focus-visible,.lightbox-topbar button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

.mobile-toc{display:none}
:global(html.toc-open),:global(html.toc-open body),:global(html.lightbox-open),:global(html.lightbox-open body){overflow:hidden}

@media(max-width:1040px){
