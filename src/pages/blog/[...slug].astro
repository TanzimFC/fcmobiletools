.toc-card{min-height:0}.side-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:9px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.07)}
.side-heading span{color:#64808d;font:900 7px/1 var(--font-body);letter-spacing:.14em}.side-heading b{color:#55717d;font:800 6.5px/1 var(--font-body)}
.toc-card nav{display:grid;gap:2px;max-height:56vh;overflow:auto;padding-right:3px;scrollbar-width:thin}
.toc-link{padding:8px 7px;border-left:2px solid transparent;border-radius:0 8px 8px 0;color:#839ca7;text-decoration:none;font:600 8.5px/1.45 var(--font-body);transition:background .18s ease,color .18s ease,border-color .18s ease}
.toc-link:hover{color:#dff9ff;background:rgba(76,201,255,.05)}.toc-link.active{color:#e9fbff;border-left-color:var(--primary);background:linear-gradient(90deg,rgba(76,201,255,.1),transparent)}
.side-empty{margin:0;color:#6e8792;font:400 9px/1.65 var(--font-body)}

.author-side{display:grid;grid-template-columns:42px 1fr;gap:10px;align-items:center}
.author-avatar{width:42px;height:42px;display:grid;place-items:center;border:1px solid rgba(76,201,255,.22);border-radius:13px;background:linear-gradient(145deg,#0c2635,#091620);color:#8edffc;font:800 14px/1 var(--font-display)}
.author-side span{display:block;color:#567682;font:900 6.5px/1 var(--font-body);letter-spacing:.13em}.author-side a{display:block;margin-top:4px;color:#d5eff5;font:700 11px/1.2 var(--font-display)}.author-side p{margin:3px 0 0;color:#718b96;font:400 8px/1.5 var(--font-body)}
