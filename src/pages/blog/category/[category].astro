---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft))
  .sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0));

const labels = {
  updates: 'Updates',
  leaks: 'Leaks & Intel',
  guides: 'Guides',
  'event-guides': 'Event Guides',
  analysis: 'Analysis',
  reviews: 'Reviews',
  tactics: 'Tactics',
  rankings: 'Rankings'
};

const typeMap = {
  updates: 'news',
  leaks: 'leaks',
  guides: 'guide',
  'event-guides': 'event-guide',
  analysis: 'analysis',
  reviews: 'player-review',
  tactics: 'opinion',
  rankings: 'ranking'
};

export async function getStaticPaths() {
  return Object.keys(labels).map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const label = labels[category] ?? category;
const type = typeMap[category];
const categoryPosts = posts.filter((post) => {
  const normalized = String(post.data.category ?? '').toLowerCase();
  return normalized === label.toLowerCase() || post.data.type === type;
});
const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
const picks = posts.filter((post) => post.data.featured).slice(0, 4);
---
<BaseLayout title={label + ' — FC Mobile Articles'} description={'FC Mobile ' + label.toLowerCase() + ' from FCMOBILETOOLS.'}>
<main class="hub-page">
  <section class="hub-hero"><div class="wrap"><p class="eyebrow">ARTICLES / {label.toUpperCase()}</p><h1>{label}</h1><p>{categoryPosts.length} published {categoryPosts.length === 1 ? 'article' : 'articles'} in this section.</p></div></section>
  <div class="wrap hub-layout">
    <section class="hub-main">
      <div class="hub-heading"><div><p class="eyebrow">LATEST</p><h2>{label} articles</h2></div><a href="/blog">All articles ↗</a></div>
      <div class="cards">
        {categoryPosts.map((post) => <a class="card" href={'/blog/' + post.slug + '/'}><div class="media">{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <span>FC</span>}</div><div class="body"><div class="meta"><span>{post.data.author}</span><span>{readingTime(post)} min</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt ?? post.data.description}</p></div></a>)}
        {!categoryPosts.length ? <div class="empty">No published articles in this section yet.</div> : null}
      </div>
    </section>
    <aside class="sidebar">
      <div class="sidebox"><span>EXPLORE</span><a href="/blog">All articles</a><a href="/creator">Creators</a><a href="/blog/author/tanzimfc/">TanzimFC</a></div>
      <div class="sidebox"><span>FEATURED</span>{picks.map((post)=><a class="side-article" href={'/blog/' + post.slug + '/'}><small>{post.data.category}</small><b>{post.data.title}</b></a>)}</div>
    </aside>
  </div>
</main>
</BaseLayout>
<style>
.hub-page{background:var(--bg);min-height:65vh}.wrap{width:min(1160px,calc(100% - 28px));margin:auto}.hub-hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 78% 0,#55c7f218,transparent 32%),#07121a}.hub-hero .wrap{padding:75px 0}.eyebrow{color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em;margin:0}.hub-hero h1{font-size:clamp(55px,7vw,85px);letter-spacing:-.07em;margin:15px 0 8px}.hub-hero p:last-child{color:#8297a3;font-size:11px}.hub-layout{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:42px;padding:40px 0 85px}.hub-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:17px}.hub-heading h2{margin:7px 0 0;font-size:27px}.hub-heading>a{color:#83dcff;text-decoration:none;font:800 7px var(--mono)}.cards{display:grid;grid-template-columns:1fr 1fr;gap:11px}.card{display:grid;grid-template-columns:150px 1fr;min-height:190px;overflow:hidden;border:1px solid var(--border);border-radius:15px;background:#09141b;color:var(--text);text-decoration:none;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#2d586c}.media{background:#0a1a22;min-height:190px}.media img{display:block;width:100%;height:100%;object-fit:cover}.media span{display:grid;place-items:center;height:100%;color:var(--blue);font:900 28px var(--mono)}.body{padding:15px}.meta{display:flex;gap:9px;color:#6d8390;font:800 7px var(--mono);text-transform:uppercase}.body h3{font-size:15px;line-height:1.08;margin:10px 0 7px}.body p{color:#7d929e;font-size:9px;line-height:1.65;margin:0}.sidebar{display:grid;align-content:start;gap:12px}.sidebox{display:grid;gap:5px;padding:14px;border:1px solid var(--border);border-radius:13px;background:#09131a}.sidebox>span{color:#5f7785;font:900 7px var(--mono);letter-spacing:.13em;margin-bottom:5px}.sidebox>a{color:#8ba0ab;text-decoration:none;font:700 9px var(--mono);padding:7px;border-radius:7px}.sidebox>a:hover{color:#dff7ff;background:#55c7f20a}.side-article{display:grid!important;gap:4px!important;border-top:1px solid #1b2c35;border-radius:0!important;padding:11px 0!important}.side-article small{color:var(--blue);font:800 6px var(--mono)}.side-article b{font-size:10px;color:#cfe0e7}.empty{padding:35px;border:1px dashed #2a3d48;border-radius:13px;color:#718793;grid-column:1/-1;font-size:10px}
@media(max-width:820px){.hub-layout{grid-template-columns:1fr}.sidebar{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr}}@media(max-width:520px){.sidebar{grid-template-columns:1fr}.card{grid-template-columns:110px 1fr}}
</style>