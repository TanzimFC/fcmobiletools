---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubHero from '../../../components/blog/HubHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import BlogEffects from '../../../components/blog/BlogEffects.astro';
import '../../../styles/blog.css';
import { categoryPages, sectionsIn, fmtDate, SECTIONS, sectionOf } from '../../../lib/blog.js';
import { getPublishedPosts } from '../../../lib/blog-supabase.js';

export const prerender = false;

const posts = await getPublishedPosts();
const requestedSlug = String(Astro.params.category || '').replace(/\/$/,'');
const pages = categoryPages(posts);
const known = Object.values(SECTIONS).find((s) => s.slug === requestedSlug);
const page = pages.find((c) => c.slug === requestedSlug) || {slug:requestedSlug,label:known?.label||requestedSlug.replaceAll('-',' '),accent:known?.accent||sectionOf('guide').accent,blurb:known?.blurb||`Every published article filed under ${requestedSlug.replaceAll('-',' ')}.`,posts:[]};
const sections = sectionsIn(posts);
const [lead, ...rest] = page.posts;
const minutes = page.posts.reduce((n, p) => n + p.minutes, 0);
const site = Astro.site ?? new URL('https://fcmobiletools.online');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.label + ' — FC Mobile Articles',
  url: new URL('/blog/category/' + page.slug + '/', site).toString(),
  mainEntity: { '@type': 'ItemList', itemListElement: page.posts.slice(0, 20).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(p.href, site).toString(), name: p.title })) }
};
---
<BaseLayout title={page.label + ' — FC Mobile Articles'} description={'FC Mobile ' + page.label.toLowerCase() + ' from FCMOBILETOOLS. ' + page.blurb}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<main class="bl bl-category" style={'--bl-accent:' + page.accent}>
  <BlogEffects />
  <HubHero
    eyebrow="Section"
    title={page.label}
    blurb={page.blurb}
    accent={page.accent}
    crumbs={[{ href: '/blog/category/' + page.slug + '/', label: page.label }]}
    stats={[
      { value: page.posts.length, label: page.posts.length === 1 ? 'Article' : 'Articles' },
      { value: minutes, label: 'Minutes of reading' },
      { value: fmtDate(page.posts[0]?.date, 'short') || '—', label: 'Latest' }
    ]}
  />

  <div class="bl-wrap">
    <nav class="bl-switch" aria-label="Sections">
      <a class="bl-topic" href="/blog">All articles</a>
      {sections.map((s) => (
        <a class="bl-topic" href={'/blog/category/' + s.slug + '/'} aria-current={s.slug === page.slug ? 'page' : undefined} style={'--bl-accent:' + s.accent}><i></i>{s.label}<b>{s.count}</b></a>
      ))}
    </nav>
  </div>

  <section class="bl-wrap bl-block" aria-label={page.label + ' articles'}>
    {lead ? (
      <div class="bl-lead-grid">
        <PostCard post={lead} variant="lead" eager />
        {rest.length ? <div class="bl-grid" data-reveal>{rest.map((p) => <PostCard post={p} />)}</div> : null}
      </div>
    ) : (
      <div class="bl-empty"><strong>Nothing here yet.</strong><span>No published articles in this section.</span><a class="bl-btn" href="/blog">Browse all articles</a></div>
    )}
  </section>
</main>
</BaseLayout>
