---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubHero from '../../../components/blog/HubHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import BlogEffects from '../../../components/blog/BlogEffects.astro';
import '../../../styles/blog.css';
import { seriesIn, getPosts } from '../../../lib/blog.js';


const posts = await getPosts();
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(seriesIn(posts).map((s) => s.slug))].map((series) => ({ params: { series } }));
}
const requestedSlug = String(Astro.params.series || '').replace(/\/$/,'');
const series = seriesIn(posts).find((s) => s.slug === requestedSlug);
const first = series?.parts?.[0];
const site = Astro.site ?? new URL('https://fcmobiletools.online');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: series?.name || 'Series',
  url: new URL('/blog/series/' + requestedSlug + '/', site).toString(),
  hasPart: (series?.parts || []).map((p) => ({ '@type': 'Article', headline: p.title, url: new URL(p.href, site).toString() }))
};
---
<BaseLayout title={(series?.name || 'Article series') + ' — FC Mobile Series'} description={'The ' + (series?.name || 'requested') + ' article series on FCMOBILETOOLS: ' + (series?.count || 0) + ' ' + ((series?.count || 0) === 1 ? 'part' : 'parts') + ' to read in order.'}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<main class="bl bl-series-page" style={'--bl-accent:' + (series?.accent || '#67dbff')}>
  <BlogEffects />
  <HubHero
    eyebrow="Article series"
    title={series?.name || 'Series not found'}
    blurb="Read the story in order, from the first announcement to the latest details."
    accent={series?.accent || '#67dbff'}
    crumbs={[{ href: '/blog/series/' + requestedSlug + '/', label: series?.name || 'Series' }]}
    stats={[
      { value: series?.count || 0, label: (series?.count || 0) === 1 ? 'Part' : 'Parts' },
      { value: series?.minutes || 0, label: 'Minutes in total' }
    ]}
  >
    {first ? <a slot="actions" class="bl-btn bl-btn--primary" href={first.href}>Start with part 1 →</a> : null}
  </HubHero>

  <section class="bl-wrap bl-block" aria-label={(series?.name || 'Series') + ' parts'}>
    {(series?.parts || []).length ? (
      <ol class="bl-parts">
        {(series?.parts || []).map((p, i) => (
          <li class="bl-part" data-reveal>
            <span class="bl-part-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <PostCard post={p} variant="row" />
          </li>
        ))}
      </ol>
    ) : (
      <div class="bl-empty"><strong>Series not found.</strong><span>There are no published articles in this series.</span><a class="bl-btn" href="/blog">Browse all articles</a></div>
    )}
  </section>/main>
</BaseLayout>
