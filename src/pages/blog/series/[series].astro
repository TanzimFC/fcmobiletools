---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubHero from '../../../components/blog/HubHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import BlogEffects from '../../../components/blog/BlogEffects.astro';
import '../../../styles/blog.css';
import { getPosts, seriesIn } from '../../../lib/blog.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return seriesIn(posts).map((s) => ({ params: { series: s.slug }, props: { slug: s.slug } }));
}

const posts = await getPosts();
const series = seriesIn(posts).find((s) => s.slug === Astro.props.slug);
const first = series.parts[0];
const site = Astro.site ?? new URL('https://fcmobiletools.online');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: series.name,
  url: new URL('/blog/series/' + series.slug + '/', site).toString(),
  hasPart: series.parts.map((p) => ({ '@type': 'Article', headline: p.title, url: new URL(p.href, site).toString() }))
};
---
<BaseLayout title={series.name + ' — FC Mobile Series'} description={'The ' + series.name + ' article series on FCMOBILETOOLS: ' + series.count + ' ' + (series.count === 1 ? 'part' : 'parts') + ' to read in order.'}>
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<main class="bl bl-series-page" style={'--bl-accent:' + series.accent}>
  <BlogEffects />
  <HubHero
    eyebrow="Article series"
    title={series.name}
    blurb="Read the story in order, from the first announcement to the latest details."
    accent={series.accent}
    crumbs={[{ href: '/blog/series/' + series.slug + '/', label: series.name }]}
    stats={[
      { value: series.count, label: series.count === 1 ? 'Part' : 'Parts' },
      { value: series.minutes, label: 'Minutes in total' }
    ]}
  >
    <a slot="actions" class="bl-btn bl-btn--primary" href={first.href}>Start with part 1 →</a>
  </HubHero>

  <section class="bl-wrap bl-block" aria-label={series.name + ' parts'}>
    <ol class="bl-parts">
      {series.parts.map((p, i) => (
        <li class="bl-part" data-reveal>
          <span class="bl-part-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <PostCard post={p} variant="row" />
        </li>
      ))}
    </ol>
  </section>
</main>
</BaseLayout>
