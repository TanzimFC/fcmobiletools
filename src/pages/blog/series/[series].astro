---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const slugify=(v)=>String(v||'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft));
const series=[...new Set(posts.map(p=>p.data.series).filter(Boolean))];
export async function getStaticPaths(){return series.map(name=>({params:{series:slugify(name)},props:{name}}))}
const {name}=Astro.props;
const seriesPosts=posts.filter(p=>p.data.series===name).sort((a,b)=>(a.data.seriesOrder??0)-(b.data.seriesOrder??0));
---
<BaseLayout title={name + ' — FC Mobile Series'} description={'The ' + name + ' FC Mobile article series on FCMOBILETOOLS.'}>
<main class="series-page"><section class="hero"><div class="wrap"><p class="eyebrow">ARTICLE SERIES</p><h1>{name}</h1><p>{seriesPosts.length} articles in this series.</p></div></section><section class="wrap content"><div class="series-list">{seriesPosts.map((post,index)=><a class="item" href={'/blog/' + post.slug + '/'}><span class="number">{String(index+1).padStart(2,'0')}</span><div><small>{post.data.category}</small><h2>{post.data.title}</h2><p>{post.data.excerpt??post.data.description}</p></div><b>Read →</b></a>)}</div></section></main></BaseLayout>
<style>
.series-page{background:var(--bg)}.wrap{width:min(1000px,calc(100% - 28px));margin:auto}.hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 85% 0,#55c7f218,transparent 35%),#07121a}.hero .wrap{padding:75px 0}.eyebrow{color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em}.hero h1{font-size:clamp(48px,7vw,78px);line-height:.92;letter-spacing:-.07em;margin:15px 0 8px}.hero p{color:#8498a5;font-size:11px}.content{padding:50px 0 90px}.series-list{border-top:1px solid #1c2c35}.item{display:grid;grid-template-columns:60px 1fr 70px;align-items:center;gap:18px;padding:22px 0;border-bottom:1px solid #1c2c35;color:var(--text);text-decoration:none;transition:.18s}.item:hover{padding-left:7px;border-color:#31576a}.number{color:#55c7f2;font:900 18px var(--mono)}.item small{color:#66818e;font:800 7px var(--mono)}.item h2{font-size:18px;margin:5px 0}.item p{margin:0;color:#7d919e;font-size:9px;line-height:1.6}.item>b{color:#8bdfff;font:900 7px var(--mono)}@media(max-width:600px){.item{grid-template-columns:40px 1fr}.item>b{display:none}}
</style>