---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const slugify=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft)).sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));
const authors=[...new Set(posts.map((post)=>post.data.author).filter(Boolean))];
export async function getStaticPaths(){
  const slugifyPath=(value)=>String(value??'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
  const postsForPaths=await getCollection('blog',({data})=>data.status==='published'&&!data.draft);
  const authorsForPaths=[...new Set(postsForPaths.map((post)=>post.data.author).filter(Boolean))];
  return authorsForPaths.map((author)=>({params:{author:slugifyPath(author)},props:{author}}));
}
const {author}=Astro.props;
const authorPosts=posts.filter((post)=>slugify(post.data.author)===slugify(author));
const readingTime=(post)=>post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\s+/).filter(Boolean).length??0)/220));
---
<BaseLayout title={author + ' — FC Mobile Articles'} description={'Articles by ' + author + ' on FCMOBILETOOLS.'}>
<main class="author-hub">
<section class="author-hero"><div class="wrap"><p class="eyebrow">CREATOR PROFILE / {author.toUpperCase()}</p><div class="hero-grid"><div><h1>{author}</h1><p>Articles, guides and updates published by {author}.</p><div class="hero-links"><span>{authorPosts.length} articles</span><a href="/creator">All creators ↗</a></div></div><div class="creator-mark">{author.slice(0,1).toUpperCase()}</div></div></div></section>
<section class="wrap author-body"><div class="author-main"><div class="section-head"><div><p class="eyebrow">PUBLISHED WORK</p><h2>Latest from {author}</h2></div></div><div class="author-stream">{authorPosts.map((post)=><a class="author-card" href={'/blog/' + post.slug + '/'}><div class="thumb">{post.data.image?<img src={post.data.image} alt={post.data.imageAlt??''} loading="lazy" />:<span>FC</span>}</div><div><div class="meta"><span>{post.data.category}</span><span>{readingTime(post)} min</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt??post.data.description}</p></div></a>)}</div></div><aside class="author-side"><section class="sidebox"><span>ABOUT THE CREATOR</span><p>{author} contributes FC Mobile articles and practical game information to the site.</p><a href="/creator">View creator space ↗</a></section><section class="sidebox"><span>EXPLORE</span><a href="/blog">All articles</a><a href="/blog/category/guides/">Guides</a><a href="/blog/category/analysis/">Analysis</a></section></aside></section>
</main>
<style>
.author-hub{background:var(--bg);min-height:70vh;overflow:hidden}.wrap{width:min(1140px,calc(100% - 28px));margin:auto}.author-hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 80% 5%,#55c7f21a,transparent 35%),#07131b}.author-hero .wrap{padding:70px 0}.eyebrow{margin:0;color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em}.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 160px;align-items:end;gap:30px}.hero-grid h1{margin:16px 0 10px;font-size:clamp(58px,8vw,94px);line-height:.88;letter-spacing:-.08em}.hero-grid p{margin:0;color:#8399a5;font-size:12px}.hero-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.hero-links span,.hero-links a{padding:7px 9px;border:1px solid #294655;border-radius:999px;color:#718995;text-decoration:none;font:800 7px var(--mono)}.hero-links a{color:#8fdffc}.creator-mark{width:150px;height:150px;border:1px solid #2c5569;border-radius:30px;display:grid;place-items:center;background:#0a1922;color:var(--blue);font:900 36px var(--mono);box-shadow:0 30px 70px #0008}.author-body{display:grid;grid-template-columns:minmax(0,1fr) 275px;gap:34px;padding:40px 0 90px}.section-head h2{margin:7px 0 17px;font-size:29px;letter-spacing:-.05em}.author-stream{display:grid;gap:9px}.author-card{display:grid;grid-template-columns:165px 1fr;min-height:175px;overflow:hidden;border:1px solid var(--border);border-radius:15px;background:#09141b;color:var(--text);text-decoration:none;transition:.22s}.author-card:hover{transform:translateX(3px);border-color:#375e72}.author-card .thumb{background:#0a181f;overflow:hidden}.author-card img{width:100%;height:100%;object-fit:cover;transition:.5s}.author-card:hover img{transform:scale(1.04)}.author-card .thumb span{display:grid;place-items:center;height:100%;color:var(--blue);font:900 27px var(--mono)}.author-card>div:last-child{padding:16px}.meta{display:flex;gap:10px;color:#688390;font:800 7px var(--mono);text-transform:uppercase}.meta span:first-child{color:var(--blue)}.author-card h3{font-size:16px;line-height:1.1;margin:9px 0 7px}.author-card p{margin:0;color:#7e939f;font-size:9px;line-height:1.65}.author-side{display:grid;gap:11px}.sidebox{display:grid;gap:7px;padding:15px;border:1px solid var(--border);border-radius:15px;background:#09131a}.sidebox>span{color:#5e7785;font:900 7px var(--mono);letter-spacing:.13em}.sidebox p{margin:0;color:#7e929d;font-size:9px;line-height:1.7}.sidebox a{color:#8edffc;text-decoration:none;font:800 8px var(--mono)}@media(max-width:800px){.author-body{grid-template-columns:1fr}.author-side{grid-template-columns:1fr 1fr}.creator-mark{width:100px;height:100px;border-radius:22px}}@media(max-width:560px){.hero-grid{grid-template-columns:1fr}.creator-mark{display:none}.author-side{grid-template-columns:1fr}.author-card{grid-template-columns:105px 1fr}}
</style>
</main>
</BaseLayout>