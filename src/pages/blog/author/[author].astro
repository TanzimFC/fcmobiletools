---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const slugify=(v)=>String(v||'').toLowerCase().trim().replace(/[^a-z0-9\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
const posts=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft)).sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));
const authors=[...new Set(posts.map(p=>p.data.author).filter(Boolean))];
export async function getStaticPaths(){return authors.map(author=>({params:{author:slugify(author)},props:{author}}))}
const {author}=Astro.props;
const authorPosts=posts.filter(p=>slugify(p.data.author)===slugify(author));
const latest=authorPosts.slice(0,8);
---
<BaseLayout title={author + ' — FC Mobile Articles'} description={'Articles by ' + author + ' on FCMOBILETOOLS.'}>
<main class="author-page"><section class="hero"><div class="wrap"><p class="eyebrow">CREATOR PROFILE / {author.toUpperCase()}</p><div class="hero-grid"><div><h1>{author}</h1><p>FC Mobile articles, guides and updates published by {author}.</p><div class="stats"><span>{authorPosts.length} articles</span><a href="/creator">All creators ↗</a></div></div><div class="avatar">FC</div></div></div></section><section class="wrap content"><div class="section-head"><div><p class="eyebrow">PUBLISHED WORK</p><h2>Latest from {author}</h2></div></div><div class="grid">{latest.map(post=><a class="card" href={'/blog/' + post.slug + '/'}><div class="card-media">{post.data.image?<img src={post.data.image} alt="" loading="lazy" />:<span>FC</span>}</div><div><div class="meta">{post.data.category}</div><h3>{post.data.title}</h3><p>{post.data.excerpt??post.data.description}</p></div></a>)}</div></section></main></BaseLayout>
<style>
.author-page{background:var(--bg)}.wrap{width:min(1120px,calc(100% - 28px));margin:auto}.hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 80% 10%,#55c7f219,transparent 34%),#07121a}.hero .wrap{padding:72px 0}.eyebrow{color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em;margin:0}.hero-grid{display:grid;grid-template-columns:1fr 170px;align-items:end;gap:30px}.hero h1{font-size:clamp(58px,8vw,90px);line-height:.9;letter-spacing:-.075em;margin:17px 0 10px}.hero p{color:#869ba7;font-size:12px;line-height:1.7}.stats{display:flex;gap:9px;align-items:center;margin-top:20px}.stats span,.stats a{padding:8px 10px;border:1px solid #294454;border-radius:8px;color:#78909d;font:800 7px var(--mono);text-decoration:none}.stats a{color:#8edfff}.avatar{width:150px;height:150px;display:grid;place-items:center;border:1px solid #294454;border-radius:30px;background:#0a1922;color:var(--blue);font:900 30px var(--mono)}.content{padding:60px 0 90px}.section-head h2{font-size:30px;letter-spacing:-.045em;margin:7px 0 17px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.card{display:grid;grid-template-columns:165px 1fr;min-height:190px;overflow:hidden;border:1px solid var(--border);border-radius:14px;background:#09141b;color:var(--text);text-decoration:none;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#2d586c}.card-media{background:#0a1a22}.card-media img{width:100%;height:100%;object-fit:cover}.card-media span{display:grid;place-items:center;height:100%;color:var(--blue);font:900 28px var(--mono)}.card>div:last-child{padding:15px}.meta{color:var(--blue);font:800 7px var(--mono);text-transform:uppercase}.card h3{font-size:15px;line-height:1.1;margin:10px 0 7px}.card p{margin:0;color:#7e929e;font-size:9px;line-height:1.65}@media(max-width:800px){.grid{grid-template-columns:1fr}}@media(max-width:560px){.hero-grid{grid-template-columns:1fr}.avatar{width:92px;height:92px;border-radius:18px}.card{grid-template-columns:110px 1fr}}
</style>