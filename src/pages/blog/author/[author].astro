---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubHero from '../../../components/blog/HubHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import BlogEffects from '../../../components/blog/BlogEffects.astro';
import '../../../styles/blog.css';
import { getPosts, initial } from '../../../lib/blog.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.map((p) => p.authorSlug))].map((slug) => ({ params: { author: slug }, props: { slug } }));
}

const posts = await getPosts();
const items = posts.filter((p) => p.authorSlug === Astro.props.slug);
const name = items[0].author;
const [lead, ...rest] = items;
const minutes = items.reduce((n, p) => n + p.minutes, 0);
const sectionCount = new Set(items.map((p) => p.section.key)).size;
const accent = lead.section.accent;
---
<BaseLayout title={name + ' — FC Mobile Articles'} description={'Articles, guides and updates written by ' + name + ' on FCMOBILETOOLS.'} author={name}>
<main class="bl bl-author" style={'--bl-accent:' + accent}>
  <BlogEffects />
  <HubHero
    eyebrow="Creator"
    title={name}
    blurb={'Articles, guides and updates published by ' + name + '.'}
    accent={accent}
    crumbs={[{ href: '/blog/author/' + Astro.props.slug + '/', label: name }]}
    stats={[
      { value: items.length, label: items.length === 1 ? 'Article' : 'Articles' },
      { value: sectionCount, label: sectionCount === 1 ? 'Section' : 'Sections' },
      { value: minutes, label: 'Minutes of reading' }
    ]}
  >
    <a slot="actions" class="bl-btn" href="/creator">Meet the creators</a>
    <div slot="aside" class="bl-monogram" aria-hidden="true">{initial(name)}</div>
  </HubHero>

  <section class="bl-wrap bl-block" aria-label={'Articles by ' + name}>
    <div class="bl-lead-grid">
      <PostCard post={lead} variant="lead" eager />
      {rest.length ? <div class="bl-grid" data-reveal>{rest.map((p) => <PostCard post={p} />)}</div> : null}
    </div>
  </section>
</main>
</BaseLayout>
