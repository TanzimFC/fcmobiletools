---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogEffects from '../../components/blog/BlogEffects.astro';
import '../../styles/blog.css';
import { sectionsIn, seriesIn, TOOLS, fmtDate, iso } from '../../lib/blog.js';
import { getPublishedPosts } from '../../lib/blog-supabase.js';

export const prerender = false;
Astro.response.headers.set('Cache-Control','no-store, max-age=0, must-revalidate');
const posts = await getPublishedPosts();
const sections = sectionsIn(posts);
const series = seriesIn(posts).filter((s) => s.count > 1);

// Featured stories first, then newest. Up to three fill the top bento.
const picks = [];
for (const post of [...posts.filter((p) => p.featured), ...posts]) {
  if (picks.length < 3 && !picks.includes(post)) picks.push(post);
}
const [lead, ...side] = picks;
const heroSlugs = picks.map((p) => p.slug);
const latest = posts[0]?.updated ?? posts[0]?.date;

const toolPicks = ['/redeem-codes', '/team-ovr', '/training-calculator', '/rank-up-calculator'].map((href) => ({ href, ...TOOLS[href] }));

const site = Astro.site ?? new URL('https://fcmobiletools.online');
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'FC Mobile Articles',
  url: new URL('/blog/', site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.slice(0, 20).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(p.href, site).toString(), name: p.title }))
  }
};
---
<BaseLayout title="FC Mobile Articles" description="FC Mobile updates, leaks, guides, analysis and reviews from FCMOBILETOOLS. Anything unconfirmed is clearly labelled.">
<script type="application/ld+json" set:html={JSON.stringify(listSchema)}></script>
<main class="bl bl-index" data-blog-index data-hero-slugs={JSON.stringify(heroSlugs)}>
  <BlogEffects />

  <header class="bl-masthead">
    <div class="bl-wrap bl-masthead-grid">
      <div>
        <p class="bl-eyebrow"><i></i>The FCMOBILETOOLS Journal</p>
        <h1>Everything worth knowing about <em>FC Mobile</em>.</h1>
        <p class="bl-lede">Updates, leaks, guides and analysis for players who like to know before they spend. Anything unconfirmed is labelled as such.</p>
      </div>
      <ul class="bl-glance" aria-label="Journal at a glance">
        <li><b>{posts.length}</b><span>Articles</span></li>
        <li><b>{sections.length}</b><span>Sections</span></li>
        <li><b>{fmtDate(latest, 'short') || '—'}</b><span>Last update</span></li>
      </ul>
    </div>
  </header>

  {lead ? (
    <section class:list={['bl-wrap', 'bl-bento', { 'is-solo': side.length === 0, 'is-duo': side.length === 1 }]} id="featured" aria-label="Featured articles">
      <PostCard post={lead} variant="lead" eager />
      {side.map((post) => <PostCard post={post} variant="tile" />)}
    </section>
  ) : null}

  <div class="bl-bar">
    <div class="bl-wrap bl-bar-inner">
      <nav class="bl-topics" aria-label="Filter articles by section">
        <a class="bl-topic is-active" data-topic="all" href="/blog" aria-current="true">All<b>{posts.length}</b></a>
        {sections.map((s) => (
          <a class="bl-topic" data-topic={s.slug} href={'/blog/category/' + s.slug + '/'} style={'--bl-accent:' + s.accent}><i></i>{s.label}<b>{s.count}</b></a>
        ))}
      </nav>
      <label class="bl-search" for="blSearch">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="5.5"/><path d="M13.5 13.5 17 17"/></svg>
        <input id="blSearch" type="search" placeholder="Search articles" autocomplete="off" aria-label="Search articles" />
        <kbd aria-hidden="true">/</kbd>
        <button id="blClear" type="button" aria-label="Clear search" hidden>×</button>
      </label>
    </div>
  </div>

  {series.length ? (
    <section class="bl-wrap bl-block" id="seriesRail" aria-labelledby="seriesHeading" data-reveal>
      <div class="bl-block-head">
        <h2 id="seriesHeading">Ongoing series</h2>
        <p>Read a story in order, start to finish.</p>
      </div>
      <div class="bl-rail">
        {series.map((s) => (
          <a class="bl-series" href={'/blog/series/' + s.slug + '/'} style={'--bl-accent:' + s.accent}>
            <small>Series</small>
            <h3>{s.name}</h3>
            <div class="bl-dots" aria-hidden="true">{s.parts.map(() => <i></i>)}</div>
            <p>{s.count} parts · {s.minutes} min total</p>
            <b>Start the series →</b>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  <section class="bl-wrap bl-block" aria-labelledby="feedHeading">
    <div class="bl-block-head">
      <h2 id="feedHeading"><span id="blLabel">Latest articles</span></h2>
      <span class="bl-count" id="blCount" aria-live="polite">{posts.length} articles</span>
    </div>
    <div class="bl-grid" id="blGrid">
      {posts.map((post) => <PostCard post={post} filterable />)}
    </div>
    <div class="bl-empty" id="blEmpty" hidden aria-live="polite">
      <strong>No articles match that.</strong>
      <span>Try another section or clear the search.</span>
      <button class="bl-btn" type="button" id="blReset">Show all articles</button>
    </div>
    <div class="bl-more"><button class="bl-btn" type="button" id="blMore" hidden></button></div>
  </section>

  <section class="bl-wrap bl-block" aria-labelledby="toolsHeading" data-reveal>
    <div class="bl-block-head">
      <h2 id="toolsHeading">Put the reading to work</h2>
      <a href="/">All tools →</a>
    </div>
    <div class="bl-tools">
      {toolPicks.map((t) => (
        <a class="bl-tool" href={t.href}><em>{t.label}</em><strong>{t.title}</strong><span>{t.description}</span><b>Open tool →</b></a>
      ))}
    </div>
  </section>
</main>

<script is:inline>
(() => {
  const root = document.querySelector('[data-blog-index]');
  if (!root) return;
  const PAGE = 9;
  const heroSlugs = new Set(JSON.parse(root.dataset.heroSlugs || '[]'));
  const cards = [...root.querySelectorAll('[data-post]')];
  const topics = [...root.querySelectorAll('[data-topic]')];
  const $ = (id) => root.querySelector(id);
  const search = $('#blSearch'), clear = $('#blClear'), count = $('#blCount'), label = $('#blLabel');
  const empty = $('#blEmpty'), more = $('#blMore'), reset = $('#blReset');
  const gated = [$('#featured'), $('#seriesRail')].filter(Boolean);
  let topic = 'all', limit = PAGE;

  const labelFor = (key) => topics.find((t) => t.dataset.topic === key)?.textContent.replace(/\d+$/, '').trim() || key;

  const setTopic = (key) => {
    topic = key;
    topics.forEach((t) => {
      const on = t.dataset.topic === key;
      t.classList.toggle('is-active', on);
      on ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current');
    });
  };

  const syncUrl = () => {
    const p = new URLSearchParams();
    if (topic !== 'all') p.set('topic', topic);
    const q = search.value.trim();
    if (q) p.set('q', q);
    const s = p.toString();
    history.replaceState({}, '', s ? '/blog?' + s : '/blog');
  };

  const render = (writeUrl = true) => {
    const q = search.value.trim().toLowerCase();
    const filtered = topic !== 'all' || !!q;
    // Unfiltered, stories already featured above are not repeated in the grid.
    const matches = cards.filter((c) =>
      (topic === 'all' || c.dataset.section === topic) &&
      (!q || c.dataset.search.includes(q)) &&
      (filtered || !heroSlugs.has(c.dataset.slug)));
    const visible = new Set(matches.slice(0, limit));
    cards.forEach((c) => { c.hidden = !visible.has(c); });
    gated.forEach((el) => { el.hidden = filtered; });
    count.textContent = matches.length + (matches.length === 1 ? ' article' : ' articles');
    label.textContent = q ? 'Results for “' + search.value.trim() + '”' : topic === 'all' ? 'Latest articles' : labelFor(topic);
    clear.hidden = !q;
    empty.hidden = matches.length > 0;
    const left = matches.length - visible.size;
    more.hidden = left <= 0;
    more.textContent = 'Show ' + Math.min(PAGE, left) + ' more · ' + left + ' left';
    if (writeUrl) syncUrl();
  };

  topics.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); limit = PAGE; setTopic(t.dataset.topic); render(); }));
  search.addEventListener('input', () => { limit = PAGE; render(); });
  clear.addEventListener('click', () => { search.value = ''; search.focus(); limit = PAGE; render(); });
  reset.addEventListener('click', () => { search.value = ''; limit = PAGE; setTopic('all'); render(); });
  more.addEventListener('click', () => { limit += PAGE; render(false); });

  addEventListener('keydown', (e) => {
    const tag = document.activeElement?.tagName;
    if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) { e.preventDefault(); search.focus(); }
    if (e.key === 'Escape' && document.activeElement === search) { search.value = ''; limit = PAGE; render(); search.blur(); }
  });

  const params = new URLSearchParams(location.search);
  const t0 = params.get('topic') || params.get('type');
  if (t0 && topics.some((t) => t.dataset.topic === t0)) setTopic(t0);
  if (params.get('q')) search.value = params.get('q');
  render(false);
})();
</script>
</BaseLayout>
