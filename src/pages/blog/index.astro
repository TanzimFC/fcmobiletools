.support-story{display:grid;grid-template-rows:auto 1fr;min-height:0}
.support-media{min-height:0}
.support-media img{aspect-ratio:16/9}
.support-index{position:absolute;left:10px;bottom:10px;color:#d9f8ff;font:900 9px var(--mono);z-index:2;text-shadow:0 2px 12px #000}
.support-copy{display:flex;flex-direction:column;justify-content:center;padding:17px;z-index:4}
.support-copy h3{margin:9px 0 0;font-size:18px;line-height:1.06;letter-spacing:-.035em}
.latest-section{margin-top:66px}
.latest-label{padding-bottom:18px;border-bottom:1px solid #1a2c35}
.latest-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:12px}
.latest-card{display:grid;grid-template-rows:auto 1fr;min-height:0}
.latest-media{min-height:0;aspect-ratio:16/9}
.latest-media img{height:100%}
.card-arrow{position:absolute;right:13px;top:13px;display:grid;place-items:center;width:30px;height:30px;border:1px solid #ffffff1c;border-radius:50%;background:#07131bd1;color:#9edff0;font:900 12px var(--mono);z-index:2;transition:.2s}
.story-card:hover .card-arrow{transform:translate(2px,-2px);background:#0b202a;color:#d7f9ff}
.latest-body{padding:18px 18px 19px;z-index:4}
.latest-body h3{margin:11px 0 8px;font-size:20px;line-height:1.08;letter-spacing:-.035em}
.latest-body p{margin:0;color:#7d939d;font-size:10px;line-height:1.7}
.empty-state{display:grid;gap:5px;padding:35px;margin-top:12px;border:1px dashed #2c4754;border-radius:16px;text-align:center;color:#6d858f;background:#08141b}
.empty-state strong{color:#cceaf1;font-size:13px}
.empty-state span{font-size:9px}
.archive-strip{display:grid;grid-template-columns:290px minmax(0,1fr);gap:45px;margin-top:76px;padding:32px 0 10px;border-top:1px solid #1a2b34}
.archive-strip h2{margin:9px 0 0;font-size:clamp(31px,3.6vw,45px);line-height:.94;letter-spacing:-.06em}
.topic-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.topic-directory a{display:grid;grid-template-columns:38px 1fr 20px;align-items:center;gap:12px;padding:12px;border:1px solid #1b303a;border-radius:14px;background:#08131a;color:var(--text);text-decoration:none;transition:.2s}
.topic-directory a:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 50%,#20343d);background:#0a171f}
.directory-count{color:var(--accent);font:900 10px var(--mono)}
.topic-directory b{display:block;font-size:11px}
.topic-directory small{display:block;margin-top:3px;color:#607983;font:700 7px var(--mono);text-transform:uppercase}
.topic-directory strong{color:#63808c;font:900 13px var(--mono)}
[hidden]{display:none!important}
@media(max-width:1020px){
  .intro-grid{grid-template-columns:1fr}
  .library-stats{max-width:380px}
  .discovery-bar{align-items:stretch;flex-direction:column}
  .article-search{flex:1 1 auto;width:min(100%,360px)}
  .editorial-grid{grid-template-columns:1fr 1fr;grid-template-rows:auto auto}
  .lead-story{grid-column:1 / -1;grid-row:auto}
  .support-story{min-height:0}
  .archive-strip{grid-template-columns:1fr}
}
@media(max-width:720px){
  .wrap{width:min(calc(100% - 28px),1240px)}
  .hub-intro{padding:58px 0 42px}
  .intro-copy-wrap h1{font-size:clamp(45px,12vw,72px)}
  .library-stats{grid-template-columns:1fr 1fr}
  .discovery-shell{padding-top:16px}
  .discovery-bar{top:58px}
  .topic-list{margin-right:-2px}
  .article-search{width:100%}
  .discovery-status{align-items:start;flex-direction:column;gap:8px}
  .section-label{align-items:start;flex-direction:column;gap:12px}
  .editorial-grid{grid-template-columns:1fr}
  .lead-story{grid-column:auto}
  .support-story{min-height:155px}
  .latest-grid{grid-template-columns:1fr}
  .archive-strip{gap:24px}
}
@media(max-width:520px){
  .wrap{width:calc(100% - 20px)}
  .intro-points{display:grid;gap:8px}
  .topic{padding:8px 9px}
  .topic b{display:none}
  .lead-media{min-height:0}
  .lead-copy{padding:19px}
  .lead-copy h2{font-size:29px}
  .support-story{grid-template-rows:auto 1fr}
  .support-copy{padding:14px}
  .support-copy h3{font-size:15px}
  .latest-card{grid-template-rows:auto 1fr;min-height:0}
  .latest-media{min-height:0;aspect-ratio:16/9}
  .latest-body{padding:15px}
  .latest-body h3{font-size:18px}
  .topic-directory{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
  .story-card,.lead-media img,.support-media img,.latest-media img,.card-arrow{transition:none}
}
</style>
</main>
</BaseLayout>
