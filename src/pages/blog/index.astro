---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft))
  .sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0));

const firstInlineImage = (post) => String(post.body ?? '').match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1] ?? '';
const coverImage = (post) => post.data.image || firstInlineImage(post);
const optimizeCloudinary = (url,width) => {
  const value = String(url ?? '');
  return value.includes('res.cloudinary.com') && value.includes('/image/upload/')
    ? value.replace('/image/upload/','/image/upload/f_auto,q_auto,dpr_auto,w_'+width+'/')
    : value;
};
const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));

const categoryOf = (post) => {
  if (post.data.type === 'leaks') return 'Leaks';
  if (post.data.type === 'news') return 'Updates';
  if (post.data.type === 'analysis') return 'Analysis';
  if (post.data.type === 'player-review') return 'Reviews';
  if (post.data.type === 'opinion') return 'Tactics';
  return 'Guides';
};

const categoryKey = (post) => categoryOf(post).toLowerCase();
const categoryHref = (label) => '/blog/category/' + label.toLowerCase().replace(/\s+/g,'-') + '/';
const categoryAccent = (label) => ({
  updates: '#67dbff',
  leaks: '#b7a0ff',
  guides: '#72e1ad',
  analysis: '#ffd18a',
  reviews: '#f3ca76',
  tactics: '#f29bd2'
}[label] ?? '#67dbff');

const categoryLabels = ['Updates','Leaks','Guides','Analysis','Reviews','Tactics'];
const categoryLinks = [
  { label: 'All', key: 'all', href: '/blog' },
  ...categoryLabels.map((label) => ({ label, key: label.toLowerCase(), href: categoryHref(label) }))
];

const featured = posts.filter((post) => post.data.featured);
const editorial = [];
const editorialSeen = new Set();

for (const post of [...featured, ...posts]) {
  if (!editorialSeen.has(post.slug) && editorial.length < 3) {
    editorial.push(post);
    editorialSeen.add(post.slug);
  }
}

const featuredLead = editorial[0];
const featuredSupport = editorial.slice(1,3);
const latest = posts.filter((post) => !editorialSeen.has(post.slug));

const categoryCounts = Object.fromEntries(
  categoryLabels.map((label) => [label.toLowerCase(), posts.filter((post) => categoryOf(post) === label).length])
);
---
<BaseLayout title="FC Mobile Articles" description="FC Mobile updates, leaks, guides, analysis, reviews and tactics from FCMOBILETOOLS.">
<main class="blog-hub" data-blog-page>
  <section class="hub-intro">
    <div class="wrap">
      <div class="intro-grid">
        <div class="intro-copy-wrap">
          <p class="eyebrow">FCMOBILETOOLS / ARTICLES</p>
          <h1>What matters,<br /><em>when it matters.</em></h1>
          <p class="intro-copy">A focused FC Mobile newsroom for updates, guides, leaks and analysis. Browse by topic or search the full library without leaving the page.</p>
          <div class="intro-points">
            <span><i></i> Published &amp; reviewed</span>
            <span><i></i> Uncertain info is labelled</span>
            <span><i></i> Built for FC Mobile players</span>
          </div>
        </div>
        <div class="library-stats" aria-label="Article library stats">
          <article>
            <span>LIBRARY</span>
            <strong>{posts.length}</strong>
            <small>published articles</small>
          </article>
          <article>
            <span>TOPICS</span>
            <strong>{categoryLabels.filter((label) => categoryCounts[label.toLowerCase()] > 0).length}</strong>
            <small>active sections</small>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap discovery-shell">
    <div class="discovery-bar" aria-label="Article discovery controls">
      <div class="topic-list" role="tablist" aria-label="Filter articles by topic">
        {categoryLinks.map((item) => (
          <a
            class:list={{ topic: true, active: item.key === 'all', disabled: item.key !== 'all' && categoryCounts[item.key] === 0 }}
            data-topic={item.key}
            href={item.href}
            role="tab"
            aria-selected={item.key === 'all' ? 'true' : 'false'}
            aria-disabled={item.key !== 'all' && categoryCounts[item.key] === 0 ? 'true' : 'false'}
          >
            <span>{item.label}</span>
            <b>{item.key !== 'all' ? categoryCounts[item.key] : posts.length}</b>
          </a>
        ))}
      </div>

      <label class="article-search" for="articleSearch">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input id="articleSearch" type="search" placeholder="Search articles" autocomplete="off" aria-label="Search articles" />
        <kbd>/</kbd>
        <button id="clearSearch" type="button" aria-label="Clear article search" hidden>×</button>
      </label>
    </div>

    <div class="discovery-status">
      <div><span class="eyebrow">ARTICLE LIBRARY</span><strong id="resultLabel">Showing all published articles</strong></div>
      <span id="resultCount">{posts.length} stories</span>
    </div>

    <section class="editorial-section" id="editorialSection" aria-labelledby="featuredHeading">
      <div class="section-label">
        <div>
          <span class="eyebrow">01 / EDITOR'S DESK</span>
          <h2 id="featuredHeading">Start with the stories<br /><em>worth opening.</em></h2>
        </div>
        <p>Hand-picked highlights sit above the live feed so the page has a clear editorial hierarchy instead of a wall of equal cards.</p>
      </div>

      {featuredLead ? (
        <div class="editorial-grid">
          <a
            class="lead-story story-card"
            href={'/blog/' + featuredLead.slug + '/'}
            data-story
            data-category={categoryKey(featuredLead)}
            data-title={(featuredLead.data.title + ' ' + (featuredLead.data.description ?? '') + ' ' + categoryOf(featuredLead)).toLowerCase()}
            style={'--accent:' + categoryAccent(categoryKey(featuredLead))}
          >
            <div class="lead-media">
              {coverImage(featuredLead) ? <img src={optimizeCloudinary(coverImage(featuredLead), 1100)} alt={featuredLead.data.imageAlt ?? ''} width="1100" height="620" loading="eager" fetchpriority="high" decoding="async" /> : <span>FC</span>}
              <span class="feature-tag">FEATURED</span>
              <span class="image-fade" aria-hidden="true"></span>
            </div>
            <div class="lead-copy">
              <div class="story-meta"><span class="category-label">{categoryOf(featuredLead)}</span><time>{featuredLead.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span>{readingTime(featuredLead)} min read</span></div>
              <h2>{featuredLead.data.title}</h2>
              {featuredLead.data.subtitle ? <p class="lead-subtitle">{featuredLead.data.subtitle}</p> : null}
              <p class="story-description">{featuredLead.data.excerpt ?? featuredLead.data.description}</p>
              <span class="story-link">Open story <b>↗</b></span>
            </div>
          </a>

          {featuredSupport.map((post, index) => (
            <a
              class="support-story story-card"
              href={'/blog/' + post.slug + '/'}
              data-story
              data-category={categoryKey(post)}
              data-title={(post.data.title + ' ' + (post.data.description ?? '') + ' ' + categoryOf(post)).toLowerCase()}
              style={'--accent:' + categoryAccent(categoryKey(post))}
            >
              <div class="support-media">
                {coverImage(post) ? <img src={optimizeCloudinary(coverImage(post), 760)} alt={post.data.imageAlt ?? ''} width="760" height="430" loading="lazy" decoding="async" /> : <span>FC</span>}
                <span class="support-index">0{index + 2}</span>
              </div>
              <div class="support-copy">
                <div class="story-meta"><span class="category-label">{categoryOf(post)}</span><time>{post.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</time></div>
                <h3>{post.data.title}</h3>
                <span class="story-link">Read ↗</span>
              </div>
            </a>
          ))}
        </div>
      ) : null}
    </section>

    <section class="latest-section" id="latestSection" aria-labelledby="latestHeading">
      <div class="section-label latest-label">
        <div>
          <span class="eyebrow">02 / THE LATEST</span>
          <h2 id="latestHeading">Fresh from the desk.</h2>
        </div>
        <p>Every published story appears here. Search and topic filters update the feed instantly.</p>
      </div>

      <div class="latest-grid" id="articleStream">
        {latest.map((post) => (
          <a
            class="latest-card story-card"
            href={'/blog/' + post.slug + '/'}
            data-story
            data-category={categoryKey(post)}
            data-title={(post.data.title + ' ' + (post.data.description ?? '') + ' ' + (post.data.excerpt ?? '') + ' ' + categoryOf(post)).toLowerCase()}
            style={'--accent:' + categoryAccent(categoryKey(post))}
          >
            <div class="latest-media">
              {coverImage(post) ? <img src={optimizeCloudinary(coverImage(post), 760)} alt={post.data.imageAlt ?? ''} width="760" height="430" loading="lazy" decoding="async" /> : <span>FC</span>}
              <span class="media-shade" aria-hidden="true"></span>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="latest-body">
              <div class="story-meta">
                <span class="category-label">{categoryOf(post)}</span>
                <time>{post.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</time>
                <span>{readingTime(post)} min</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt ?? post.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="empty-state" id="emptyState" hidden aria-live="polite"></div>
    </section>

    <section class="archive-strip" aria-label="Browse article topics">
      <div>
        <span class="eyebrow">03 / BROWSE TOPICS</span>
        <h2>Find the section<br /><em>you need.</em></h2>
      </div>
      <div class="topic-directory">
        {categoryLabels.filter((label) => categoryCounts[label.toLowerCase()] > 0).map((label) => (
          <a href={categoryHref(label)} style={'--accent:' + categoryAccent(label.toLowerCase())}>
            <span class="directory-count">{String(categoryCounts[label.toLowerCase()]).padStart(2,'0')}</span>
            <span><b>{label}</b><small>Explore {label.toLowerCase()}</small></span>
            <strong>↗</strong>
          </a>
        ))}
      </div>
    </section>
  </section>
</main>

<script is:inline>
const blogRoot = document.querySelector('[data-blog-page]');
const storyCards = [...(blogRoot?.querySelectorAll('[data-story]') || [])];
const search = blogRoot?.querySelector('#articleSearch');
const clearSearch = blogRoot?.querySelector('#clearSearch');
const count = blogRoot?.querySelector('#resultCount');
const resultLabel = blogRoot?.querySelector('#resultLabel');
const empty = blogRoot?.querySelector('#emptyState');
const editorialSection = blogRoot?.querySelector('#editorialSection');
let activeTopic = 'all';

const setQueryUrl = () => {
  const params = new URLSearchParams();
  if (activeTopic !== 'all') params.set('topic', activeTopic);
  const query = (search?.value || '').trim();
  if (query) params.set('q', query);
  const next = params.toString();
  window.history?.replaceState({}, '', next ? '/blog?' + next : '/blog');
};

const updateResults = ({ updateUrl = true } = {}) => {
  const query = (search?.value || '').trim().toLowerCase();
  let visible = 0;
  let visibleEditorial = 0;

  storyCards.forEach((card) => {
    const matchesTopic = activeTopic === 'all' || card.dataset.category === activeTopic;
    const matchesSearch = !query || (card.dataset.title || card.textContent || '').toLowerCase().includes(query);
    const show = matchesTopic && matchesSearch;
    card.hidden = !show;
    if (show) {
      visible++;
      if (card.closest('.editorial-section')) visibleEditorial++;
    }
  });

  if (editorialSection) editorialSection.hidden = visibleEditorial === 0;
  if (count) count.textContent = visible + ' stor' + (visible === 1 ? 'y' : 'ies');

  if (resultLabel) {
    resultLabel.textContent =
      query
        ? 'Matching “' + query + '”'
        : activeTopic === 'all'
          ? 'Showing all published articles'
          : 'Showing ' + activeTopic[0].toUpperCase() + activeTopic.slice(1);
  }

  if (clearSearch) clearSearch.hidden = !query;

  if (empty) {
    empty.hidden = visible > 0;
    if (visible === 0) {
      empty.innerHTML = '<strong>No stories match this view.</strong><span>Try another topic or clear your search.</span>';
    }
  }

  if (updateUrl) setQueryUrl();
};

blogRoot?.querySelectorAll('[data-topic]').forEach((link) => {
  link.addEventListener('click', (event) => {
    if (link.classList.contains('disabled')) {
      event.preventDefault();
      return;
    }
    event.preventDefault();
    activeTopic = link.dataset.topic || 'all';
    blogRoot.querySelectorAll('[data-topic]').forEach((item) => {
      const active = item === link;
      item.classList.toggle('active', active);
      item.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    updateResults();
  });
});

search?.addEventListener('input', () => updateResults());
clearSearch?.addEventListener('click', () => {
  if (!search) return;
  search.value = '';
  search.focus();
  updateResults();
});

window.addEventListener('keydown', (event) => {
  if (event.key === '/' && !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) {
    event.preventDefault();
    search?.focus();
  }
  if (event.key === 'Escape' && document.activeElement === search) {
    search.value = '';
    updateResults();
  }
});

const initialParams = new URLSearchParams(window.location.search);
const initialTopic = initialParams.get('topic') || initialParams.get('type');
const initialQuery = initialParams.get('q') || '';

if (initialTopic && blogRoot?.querySelector('[data-topic="' + CSS.escape(initialTopic) + '"]')) {
  activeTopic = initialTopic;
  const selected = blogRoot.querySelector('[data-topic="' + CSS.escape(initialTopic) + '"]');
  blogRoot.querySelectorAll('[data-topic]').forEach((item) => {
    const active = item === selected;
    item.classList.toggle('active', active);
    item.setAttribute('aria-selected', active ? 'true' : 'false');
  });
}
if (search && initialQuery) search.value = initialQuery;
updateResults({ updateUrl: false });
</script>

<style>
.blog-hub{position:relative;min-height:70vh;background:var(--bg);overflow:hidden}
.blog-hub:before{content:"";position:absolute;inset:0 0 auto;height:660px;pointer-events:none;background:radial-gradient(circle at 82% 8%,#55c7f21b,transparent 31%),radial-gradient(circle at 8% 28%,#55c7f209,transparent 26%);opacity:.9}
.wrap{position:relative;width:min(1240px,calc(100% - 36px));margin:auto}
.hub-intro{position:relative;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#06121a,#061018 92%,transparent);padding:76px 0 52px}
.intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:64px;align-items:end}
.eyebrow{display:block;margin:0;color:var(--blue);font:900 8px var(--mono);letter-spacing:.17em;text-transform:uppercase}
.intro-copy-wrap h1{max-width:890px;margin:17px 0 18px;font-size:clamp(56px,7.4vw,94px);line-height:.88;letter-spacing:-.085em}
.intro-copy-wrap h1 em,.section-label h2 em,.archive-strip h2 em{font-style:normal;color:var(--blue)}
.intro-copy{max-width:690px;margin:0;color:#8ea2ac;font-size:13px;line-height:1.85}
.intro-points{display:flex;gap:18px;flex-wrap:wrap;margin-top:21px;color:#607883;font:800 7px var(--mono);letter-spacing:.03em}
.intro-points i{display:inline-block;width:5px;height:5px;margin-right:6px;border-radius:50%;background:#6fe0a7;box-shadow:0 0 0 4px #6fe0a711}
.library-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.library-stats article{padding:17px;border:1px solid #203744;border-radius:18px;background:linear-gradient(145deg,#0a1820,#071219);box-shadow:0 24px 60px #0008}
.library-stats span,.library-stats small{display:block;color:#5d7681;font:800 7px var(--mono);letter-spacing:.12em;text-transform:uppercase}
.library-stats strong{display:block;margin:7px 0 3px;color:#dff8ff;font:800 34px var(--display);letter-spacing:-.06em}
.discovery-shell{padding:26px 0 110px}
.discovery-bar{position:sticky;top:64px;z-index:30;display:flex;align-items:center;gap:12px;padding:10px 0 16px;background:linear-gradient(180deg,var(--bg) 74%,transparent);backdrop-filter:blur(10px)}
.topic-list{display:flex;align-items:center;gap:6px;min-width:0;overflow-x:auto;scrollbar-width:none}
.topic-list::-webkit-scrollbar{display:none}
.topic{display:inline-flex;align-items:center;gap:7px;flex:0 0 auto;padding:8px 10px;border:1px solid #213540;border-radius:999px;color:#728894;text-decoration:none;background:#071118;box-shadow:inset 0 1px 0 #fff009;transition:.2s}
