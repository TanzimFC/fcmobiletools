.lead-story{grid-row:1 / span 2;display:grid;grid-template-rows:auto 1fr}
.lead-media,.support-media,.latest-media{position:relative;overflow:hidden;background:#0a181f;aspect-ratio:16/9}
.lead-media{min-height:0}
.lead-media img,.support-media img,.latest-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .35s}
