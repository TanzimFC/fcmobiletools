.section-label{display:flex;justify-content:space-between;align-items:end;gap:40px;padding:6px 0 18px}
.section-label h2{margin:9px 0 0;font-size:clamp(32px,4vw,48px);line-height:.94;letter-spacing:-.065em}
.section-label>p{max-width:390px;margin:0;color:#6e858f;font-size:10px;line-height:1.75}
.editorial-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(290px,.65fr);grid-template-rows:1fr 1fr;gap:11px}
.story-card{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#09141b;color:var(--text);text-decoration:none;transition:transform .28s,border-color .28s,box-shadow .28s}
.story-card:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(420px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--accent) 11%,transparent),transparent 48%);opacity:0;transition:opacity .25s;z-index:3}
.story-card:hover{border-color:color-mix(in srgb,var(--accent) 50%,#203944);box-shadow:0 26px 70px #0008}
