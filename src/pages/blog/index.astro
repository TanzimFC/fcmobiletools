---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft))
  .sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0));

const firstInlineImage = (post) => String(post.body ?? '').match(/!\[[^\]]*\]\(([^)]+)\)/)?.[1] ?? '';\nconst coverImage = (post) => post.data.image || firstInlineImage(post);\nconst readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
const categoryOf = (post) => {
  if (post.data.type === 'leaks') return 'Leaks';
  if (post.data.type === 'news') return 'Updates';
  if (post.data.type === 'analysis') return 'Analysis';
  if (post.data.type === 'player-review') return 'Reviews';
  if (post.data.type === 'opinion') return 'Tactics';
  return 'Guides';
};
const categoryHref = (label) => '/blog/category/' + label.toLowerCase().replace(/\s+/g,'-') + '/';
const featured = posts.filter((post) => post.data.featured).slice(0, 5);
const lead = featured[0] ?? posts[0];
const feed = posts.filter((post) => post.slug !== lead?.slug);
const sideReads = featured.slice(1, 5);
const categoryLinks = [
  { label: 'All', href: '/blog' },
  { label: 'Updates', href: '/blog/category/updates/' },
  { label: 'Leaks', href: '/blog/category/leaks/' },
  { label: 'Guides', href: '/blog/category/guides/' },
  { label: 'Analysis', href: '/blog/category/analysis/' },
  { label: 'Reviews', href: '/blog/category/reviews/' },
  { label: 'Tactics', href: '/blog/category/tactics/' }
];
---
<BaseLayout title="FC Mobile Articles" description="Fast FC Mobile updates, leaks, guides, analysis, reviews and tactics from FCMOBILETOOLS.">
<main class="blog-hub" data-blog-page>
  <div class="cursor-glow" aria-hidden="true"></div>

  <section class="hub-intro">
    <div class="wrap">
      <div class="intro-top">
        <div>
          <p class="eyebrow">FCMOBILETOOLS / ARTICLES</p>
          <h1>Useful information,<br /><em>without the noise.</em></h1>
          <p class="intro-copy">Current updates when the game changes. Guides when you need an answer. Analysis when the details matter.</p>
        </div>
        <div class="hub-metrics">
          <div><span>LIVE LIBRARY</span><strong>{posts.length}</strong><small>published articles</small></div>
          <div><span>FORMAT</span><strong>06</strong><small>core sections</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap hub-body">
    <div class="topic-bar" data-topic-bar>
      {categoryLinks.map((item, index) => <a class:list={{ active: index === 0 }} data-topic={item.label.toLowerCase()} href={item.href}>{item.label}</a>)}
      <label class="article-search"><span>⌕</span><input id="articleSearch" type="search" placeholder="Search articles" /></label>
    </div>

    <div class="hub-grid">
      <div class="hub-main">
        {lead ? <a class="lead-story spotlight-card" href={'/blog/' + lead.slug + '/'} data-card data-category={categoryOf(lead).toLowerCase()}>
          <div class="lead-media">{coverImage(lead) ? <img src={lead.data.image} alt={lead.data.imageAlt ?? ''} /> : <span>FC</span>}<i>FEATURED</i></div>
          <div class="lead-copy">
            <div class="story-meta"><span>{categoryOf(lead)}</span><time>{lead.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span>{readingTime(lead)} min read</span></div>
            <h2>{lead.data.title}</h2>
            {lead.data.subtitle ? <p class="lead-subtitle">{lead.data.subtitle}</p> : null}
            <p>{lead.data.excerpt ?? lead.data.description}</p>
            <span class="read-link">Read the article <b>↗</b></span>
          </div>
        </a> : null}

        <section class="stream-section">
          <div class="stream-head">
            <div><p class="eyebrow">THE LATEST</p><h2>Fresh from the desk</h2></div>
            <span id="resultCount">{feed.length} articles</span>
          </div>
          <div class="article-stream" id="articleStream">
            {feed.map((post) => <a class="stream-card spotlight-card" href={'/blog/' + post.slug + '/'} data-card data-category={categoryOf(post).toLowerCase()} data-title={(post.data.title + ' ' + (post.data.description ?? '') + ' ' + categoryOf(post)).toLowerCase()}>
              <div class="stream-media">{coverImage(post) ? <img src={coverImage(post)} alt={post.data.imageAlt ?? ''} loading="lazy" /> : <span>FC</span>}</div>
              <div class="stream-body">
                <div class="story-meta"><span>{categoryOf(post)}</span><time>{post.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</time><span>{readingTime(post)} min</span></div>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt ?? post.data.description}</p>
              </div>
              <span class="arrow">↗</span>
            </a>)}
          </div>
          <div class="empty-state" id="emptyState" hidden>No articles match that search.</div>
        </section>
      </div>

      <aside class="hub-sidebar">
        <section class="side-module sticky-module">
          <div class="side-title"><span>EXPLORE</span><a href="/creator">Creators ↗</a></div>
          <nav class="side-nav">
            <a href="/blog">All articles</a>
            <a href="/blog/category/updates/">Latest updates</a>
            <a href="/blog/category/guides/">Guides & event help</a>
            <a href="/blog/category/analysis/">Analysis</a>
            <a href="/blog/category/reviews/">Reviews</a>
          </nav>
        </section>

        {sideReads.length ? <section class="side-module">
          <div class="side-title"><span>FEATURED READS</span><small>Curated</small></div>
          <div class="side-stories">
            {sideReads.map((post, index) => <a href={'/blog/' + post.slug + '/'} class="side-story">
              <strong>{String(index + 1).padStart(2,'0')}</strong>
              <div><small>{categoryOf(post)}</small><b>{post.data.title}</b></div>
            </a>)}
          </div>
        </section> : null}

        <section class="side-module signal-module">
          <span class="signal-dot"></span>
          <p class="eyebrow">WHY THIS SECTION EXISTS</p>
          <h3>Less searching.<br />More answers.</h3>
          <p>Articles stay focused on things players can actually use — and uncertain information is labelled instead of dressed up as fact.</p>
        </section>
      </aside>
    </div>
  </section>
</main>

<script is:inline>
const blogRoot=document.querySelector('[data-blog-page]');
const glow=blogRoot?.querySelector('.cursor-glow');
const cards=[...(blogRoot?.querySelectorAll('[data-card]')||[])];
const search=blogRoot?.querySelector('#articleSearch');
const count=blogRoot?.querySelector('#resultCount');
const empty=blogRoot?.querySelector('#emptyState');
let activeTopic='all';

const updateResults=()=>{
  const q=(search?.value||'').trim().toLowerCase();
  let visible=0;
  cards.forEach((card)=>{
    const topic=card.dataset.category||'';
    const matchesTopic=activeTopic==='all'||topic===activeTopic;
    const matchesSearch=!q||(card.dataset.title||card.textContent||'').toLowerCase().includes(q);
    const show=matchesTopic&&matchesSearch;
    card.hidden=!show;
    if(show) visible++;
  });
  if(count) count.textContent=visible+' article'+(visible===1?'':'s');
  if(empty) empty.hidden=visible>0;
};

blogRoot?.querySelectorAll('[data-topic]').forEach((link)=>{
  link.addEventListener('click',(event)=>{
    const target=link.dataset.topic;
    if(target==='all' || target==='updates' || target==='leaks' || target==='guides' || target==='analysis' || target==='reviews' || target==='tactics'){
      if(target!=='all' && link.getAttribute('href') !== '/blog'){ event.preventDefault(); }
      activeTopic=target;
      blogRoot.querySelectorAll('[data-topic]').forEach((item)=>item.classList.toggle('active',item===link));
      updateResults();
      if(window.history?.replaceState) window.history.replaceState({},'',target==='all'?'/blog':'/blog?type='+target);
    }
  });
});

const initialType=new URLSearchParams(location.search).get('type');
if(initialType && blogRoot.querySelector('[data-topic="'+initialType+'"]')){
  activeTopic=initialType;
  const selected=blogRoot.querySelector('[data-topic="'+initialType+'"]');
  blogRoot.querySelectorAll('[data-topic]').forEach((item)=>item.classList.toggle('active',item===selected));
}
search?.addEventListener('input',updateResults);

window.addEventListener('pointermove',(event)=>{
  if(glow){glow.style.transform='translate3d('+(event.clientX-180)+'px,'+(event.clientY-180)+'px,0)';}
  const target=event.target?.closest?.('[data-card]');
  if(target){
    const rect=target.getBoundingClientRect();
    target.style.setProperty('--mx',((event.clientX-rect.left)/rect.width*100)+'%');
    target.style.setProperty('--my',((event.clientY-rect.top)/rect.height*100)+'%');
  }
},{passive:true});

updateResults();
</script>

<style>
.blog-hub{position:relative;background:var(--bg);min-height:70vh;overflow:hidden}
.wrap{width:min(1220px,calc(100% - 34px));margin:auto}
.cursor-glow{position:fixed;inset:auto 0 0 auto;width:360px;height:360px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,#55c7f215 0%,#55c7f207 26%,transparent 68%);filter:blur(10px);z-index:0;transform:translate3d(-999px,-999px,0);transition:transform .08s linear}
.hub-intro{position:relative;padding:74px 0 48px;border-bottom:1px solid var(--border);background:radial-gradient(circle at 77% 10%,#55c7f217,transparent 30%),linear-gradient(180deg,#07131b,#061018)}
.intro-top{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:50px;align-items:end}
.eyebrow{margin:0;color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em;text-transform:uppercase}
.intro-top h1{margin:18px 0 16px;font-size:clamp(56px,7.1vw,92px);line-height:.88;letter-spacing:-.08em;max-width:900px}
.intro-top h1 em{font-style:normal;color:var(--blue)}
.intro-copy{max-width:680px;margin:0;color:#879ca8;font-size:13px;line-height:1.85}
.hub-metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.hub-metrics div{padding:15px;border:1px solid #233a46;border-radius:16px;background:#09151c;box-shadow:0 18px 55px #0006}
.hub-metrics span,.hub-metrics small{display:block;color:#5e7785;font:800 7px var(--mono);letter-spacing:.1em;text-transform:uppercase}
.hub-metrics strong{display:block;margin:6px 0 2px;color:#dff8ff;font:800 30px var(--display);letter-spacing:-.05em}
.hub-body{position:relative;padding:24px 0 100px;z-index:1}
.topic-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;padding:10px 0 25px;position:sticky;top:72px;z-index:20;background:linear-gradient(180deg,var(--bg) 72%,transparent);backdrop-filter:blur(5px)}
.topic-bar>a{padding:8px 10px;border:1px solid #213540;border-radius:999px;color:#718793;text-decoration:none;font:800 7px var(--mono);transition:.22s}
.topic-bar>a:hover,.topic-bar>a.active{color:#dff8ff;border-color:#3a657a;background:#55c7f20d;box-shadow:0 0 30px #55c7f20d}
.article-search{margin-left:auto;display:flex;align-items:center;gap:8px;min-width:210px;padding:7px 10px;border:1px solid #243b46;border-radius:999px;background:#081219}
.article-search span{color:#537180;font:900 15px var(--mono)}
.article-search input{width:100%;border:0;outline:0;background:transparent;color:#cfe4eb;font:700 9px var(--mono)}
.article-search input::placeholder{color:#516975}
.hub-grid{display:grid;grid-template-columns:minmax(0,1fr) 285px;gap:34px}
.hub-main{min-width:0}
.lead-story{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);border:1px solid #294554;border-radius:22px;overflow:hidden;background:linear-gradient(145deg,#0b1a22,#071219);color:var(--text);text-decoration:none;box-shadow:0 28px 80px #0008;transition:transform .3s,border-color .3s,box-shadow .3s}
.spotlight-card{position:relative}
.spotlight-card:before{content:"";position:absolute;inset:0;background:radial-gradient(500px circle at var(--mx,50%) var(--my,50%),#55c7f215,transparent 42%);pointer-events:none;opacity:.9}
.lead-story:hover{transform:translateY(-4px);border-color:#3d6e84;box-shadow:0 34px 90px #000a}
.lead-media{position:relative;min-height:360px;background:#09171e;overflow:hidden}
.lead-media img,.stream-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .4s}
.lead-story:hover .lead-media img,.stream-card:hover .stream-media img{transform:scale(1.045);filter:saturate(1.08)}
.lead-media>span,.stream-media>span{display:grid;place-items:center;height:100%;color:var(--blue);font:900 30px var(--mono)}
.lead-media>i{position:absolute;top:16px;left:16px;padding:7px 9px;border:1px solid #55c7f24a;border-radius:999px;background:#07131bd9;color:#8fdefe;font:900 7px var(--mono);font-style:normal;letter-spacing:.1em}
.lead-copy{position:relative;padding:30px 30px 28px;align-self:center}
.story-meta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;color:#6f8794;font:800 7px var(--mono);text-transform:uppercase}
.story-meta span:first-child{color:var(--blue)}
.lead-copy h2{margin:15px 0 10px;max-width:700px;font-size:clamp(30px,3.3vw,50px);line-height:.99;letter-spacing:-.06em}
.lead-copy p{margin:0;color:#8197a3;font-size:11px;line-height:1.78}
.lead-copy .lead-subtitle{margin-bottom:8px;color:#b9cbd2;font-weight:700}
.read-link{display:inline-flex;gap:7px;align-items:center;margin-top:21px;color:#c7effd;font:900 8px var(--mono)}
.read-link b{font-size:13px}
.stream-section{margin-top:48px}
.stream-head{display:flex;align-items:end;justify-content:space-between;gap:15px;padding-bottom:14px;border-bottom:1px solid #1b2c35}
.stream-head h2{margin:7px 0 0;font-size:28px;letter-spacing:-.045em}
.stream-head>span{color:#566f7c;font:800 7px var(--mono)}
.article-stream{display:grid;gap:9px;margin-top:10px}
.stream-card{display:grid;grid-template-columns:170px minmax(0,1fr) 42px;min-height:155px;align-items:stretch;position:relative;overflow:hidden;border:1px solid var(--border);border-radius:16px;background:#09141b;color:var(--text);text-decoration:none;transition:.24s}
.stream-card:hover{transform:translateX(3px);border-color:#365d70;box-shadow:0 18px 55px #0007}
.stream-media{background:#09171e;overflow:hidden}
.stream-body{position:relative;padding:17px 17px 16px;z-index:1}
.stream-body h3{margin:10px 0 7px;font-size:17px;line-height:1.08;letter-spacing:-.02em}
.stream-body p{margin:0;color:#7e949f;font-size:9.5px;line-height:1.65;max-width:760px}
.arrow{position:relative;z-index:1;align-self:center;justify-self:center;color:#6f9aaa;font:900 15px var(--mono);transition:.2s}
.stream-card:hover .arrow{color:#bfefff;transform:translate(2px,-2px)}
.hub-sidebar{display:grid;gap:12px;align-content:start}
.side-module{padding:15px;border:1px solid var(--border);border-radius:16px;background:#09131a;box-shadow:0 18px 50px #0005}
.sticky-module{position:sticky;top:130px}
.side-title{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:10px;border-bottom:1px solid #1a2b34}
.side-title span{color:#5f7785;font:900 7px var(--mono);letter-spacing:.14em}
.side-title a,.side-title small{color:#6f8a98;text-decoration:none;font:800 7px var(--mono)}
.side-nav{display:grid;margin-top:7px}
.side-nav a{padding:9px 7px;border-radius:8px;color:#8399a4;text-decoration:none;font:800 9px var(--mono);transition:.18s}
.side-nav a:hover{color:#dff8ff;background:#55c7f20b}
.side-stories{display:grid}
.side-story{display:grid;grid-template-columns:28px 1fr;gap:9px;padding:12px 0;border-bottom:1px solid #1a2b34;color:var(--text);text-decoration:none}
.side-story:last-child{border-bottom:0}
.side-story>strong{color:#3a5f70;font:900 9px var(--mono)}
.side-story small{display:block;color:var(--blue);font:800 6.5px var(--mono);text-transform:uppercase;margin-bottom:4px}
.side-story b{display:block;color:#d0e0e6;font-size:10px;line-height:1.35}
.signal-module{position:relative;overflow:hidden;padding:20px;background:radial-gradient(circle at 0 0,#55c7f214,transparent 52%),#09131a}
.signal-dot{position:absolute;right:15px;top:15px;width:8px;height:8px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 7px #55c7f20f,0 0 30px #55c7f24a;animation:pulse 2.5s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 11px #55c7f200,0 0 40px #55c7f278}}
.signal-module h3{margin:12px 0 9px;font-size:22px;line-height:1.02;letter-spacing:-.05em}
.signal-module>p:last-child{margin:0;color:#7d929e;font-size:9px;line-height:1.7}
.empty-state{margin-top:12px;padding:30px;text-align:center;border:1px dashed #2d4754;border-radius:14px;color:#657f8b;font-size:10px}
[hidden]{display:none!important}
@media(max-width:1000px){.intro-top{grid-template-columns:1fr}.hub-metrics{max-width:390px}.hub-grid{grid-template-columns:1fr}.hub-sidebar{grid-template-columns:1fr 1fr}.sticky-module{position:static}.signal-module{grid-column:1/-1}}
@media(max-width:720px){.topic-bar{top:58px}.article-search{width:100%;margin-left:0}.lead-story{grid-template-columns:1fr}.lead-media{min-height:260px}.lead-copy{padding:23px}.stream-card{grid-template-columns:110px minmax(0,1fr) 28px}.stream-body{padding:13px}.stream-body h3{font-size:14px}.hub-sidebar{grid-template-columns:1fr}.hub-metrics{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.wrap{width:min(100% - 20px,1220px)}.hub-intro{padding:55px 0 38px}.intro-top h1{font-size:clamp(45px,12.5vw,66px)}.hub-body{padding-top:14px}.topic-bar{overflow-x:auto;flex-wrap:nowrap;padding-bottom:18px}.topic-bar>a{flex:0 0 auto}.lead-media{min-height:220px}.lead-copy h2{font-size:30px}.stream-card{grid-template-columns:92px minmax(0,1fr)}.arrow{display:none}}
@media(prefers-reduced-motion:reduce){.cursor-glow,.signal-dot{animation:none}.lead-story,.stream-card,.lead-media img,.stream-media img{transition:none}}
</style>
</main>
</BaseLayout>