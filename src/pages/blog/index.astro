.topic.active b{color:var(--blue)}
.topic.disabled{cursor:not-allowed;opacity:.42}
.article-search{position:relative;display:flex;align-items:center;gap:8px;flex:0 0 255px;height:38px;padding:0 9px;border:1px solid #26404d;border-radius:999px;background:#08141b;box-shadow:inset 0 1px 0 #fff008,0 12px 28px #0004}
.search-icon{color:#68828e;font:900 15px var(--mono)}
.article-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#d7edf3;font:700 9px var(--mono)}
.article-search input::placeholder{color:#536b77}
.article-search kbd{display:grid;place-items:center;width:19px;height:19px;border:1px solid #304a56;border-radius:6px;color:#64808c;font:800 7px var(--mono)}
.article-search button{width:20px;height:20px;padding:0;border:0;border-radius:50%;background:#12303d;color:#a9ddec;font:900 14px/1 var(--mono);cursor:pointer}
.discovery-status{display:flex;justify-content:space-between;align-items:end;gap:20px;padding:10px 0 24px}
