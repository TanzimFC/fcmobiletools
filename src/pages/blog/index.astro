.lead-media:after,.support-media:after,.media-shade{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(180deg,transparent,#061017e8)}
.image-fade{position:absolute;inset:0;background:linear-gradient(120deg,#04101810 30%,#04101880 100%)}
.feature-tag{position:absolute;left:16px;top:16px;padding:7px 9px;border:1px solid color-mix(in srgb,var(--accent) 50%,#29424d);border-radius:999px;background:#07131dd9;color:#bdefff;font:900 7px var(--mono);letter-spacing:.1em;z-index:2}
.lead-copy{position:relative;padding:23px 24px 24px;z-index:4}
.story-meta{display:flex;align-items:center;gap:9px;flex-wrap:wrap;color:#657d88;font:800 7px var(--mono);letter-spacing:.02em;text-transform:uppercase}
.category-label{color:var(--accent)!important}
.lead-copy h2{margin:12px 0 8px;max-width:760px;font-size:clamp(30px,3vw,45px);line-height:.98;letter-spacing:-.06em}
.story-description,.lead-subtitle{margin:0;color:#7f949e;font-size:10px;line-height:1.7}
.lead-subtitle{margin-bottom:6px;color:#b8cbd2;font-weight:700}
.story-link{display:inline-flex;align-items:center;gap:7px;margin-top:16px;color:#c8effa;font:900 7px var(--mono);letter-spacing:.05em;text-transform:uppercase}
