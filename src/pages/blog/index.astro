---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft))
  .sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0));

const categories = [
  { label: 'Updates', href: '/blog/category/updates/' },
  { label: 'Leaks & Intel', href: '/blog/category/leaks/' },
  { label: 'Guides', href: '/blog/category/guides/' },
  { label: 'Event Guides', href: '/blog/category/event-guides/' },
  { label: 'Analysis', href: '/blog/category/analysis/' },
  { label: 'Reviews', href: '/blog/category/reviews/' },
  { label: 'Tactics', href: '/blog/category/tactics/' },
  { label: 'Rankings', href: '/blog/category/rankings/' }
];

const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
const featured = posts.filter((post) => post.data.featured).slice(0, 5);
const latest = posts.slice(0, 8);
const more = posts.slice(8);
---
<BaseLayout title="FC Mobile Articles" description="FC Mobile updates, leaks, guides, event guides, analysis, reviews, tactics and rankings.">
<main class="articles-page">
  <section class="articles-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">FCMOBILETOOLS / ARTICLES</p>
        <h1>Everything worth<br /><em>reading about FC Mobile.</em></h1>
        <p class="hero-copy">Fast updates when things change. Deep guides when you need answers. Reviews, tactics and analysis when the details matter.</p>
      </div>
      <div class="hero-stats">
        <div><span>ARTICLES</span><strong>{posts.length}</strong></div>
        <div><span>SECTIONS</span><strong>08</strong></div>
      </div>
    </div>
  </section>

  <div class="wrap articles-shell">
    <aside class="category-rail">
      <div class="rail-card">
        <span class="rail-title">BROWSE</span>
        <a class="active" href="/blog">All articles</a>
        {categories.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="rail-card community-card">
        <span class="rail-title">COMMUNITY</span>
        <a href="/creator">Creators</a>
        <a href="/creator">Creator profiles</a>
        <a href="/legal/contact">Write with us</a>
      </div>
    </aside>

    <section class="article-main">
      {featured.length ? <section class="featured-section">
        <div class="section-heading"><div><p class="eyebrow">EDITOR'S PICKS</p><h2>Start here</h2></div><span>{featured.length} featured</span></div>
        <div class="featured-grid">
          {featured.slice(0,3).map((post, index) => (
            <a class:list={{'featured-card': true, 'featured-large': index === 0}} href={'/blog/' + post.slug + '/'}>
              <div class="card-media">{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <span>FC</span>}</div>
              <div class="featured-body">
                <div class="meta"><span>{post.data.category}</span><span>{readingTime(post)} min read</span></div>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt ?? post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section> : null}

      <section class="latest-section">
        <div class="section-heading">
          <div><p class="eyebrow">LATEST</p><h2>What changed recently</h2></div>
          <a href="/blog">All articles</a>
        </div>
        <div class="latest-grid">
          {latest.map((post) => (
            <a class="latest-card" href={'/blog/' + post.slug + '/'}>
              <div class="latest-media">{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <span>FC</span>}</div>
              <div class="latest-body">
                <div class="meta"><span>{post.data.category}</span><time>{post.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</time><span>{readingTime(post)} min</span></div>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt ?? post.data.description}</p>
                <b>Read article →</b>
              </div>
            </a>
          ))}
        </div>
      </section>

      {more.length ? <section class="archive-section">
        <div class="section-heading"><div><p class="eyebrow">ARCHIVE</p><h2>More from the library</h2></div></div>
        <div class="archive-list">
          {more.map((post) => (
            <a href={'/blog/' + post.slug + '/'}>
              <span>{post.data.category}</span>
              <strong>{post.data.title}</strong>
              <small>{post.data.publishedAt?.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</small>
            </a>
          ))}
        </div>
      </section> : null}
    </section>
  </div>
</main>
</BaseLayout>

<style>
.articles-page{background:var(--bg);overflow:hidden}.wrap{width:min(1210px,calc(100% - 30px));margin:auto}.articles-hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 84% 8%,#55c7f21c,transparent 30%),linear-gradient(180deg,#08141c,#061018);position:relative;overflow:hidden}.articles-hero:after{content:"";position:absolute;width:470px;height:470px;right:-210px;top:-245px;border:1px solid #55c7f216;border-radius:50%;box-shadow:0 0 0 70px #55c7f205,0 0 0 140px #55c7f203;animation:orbit 18s linear infinite}@keyframes orbit{to{transform:rotate(360deg)}}.hero-grid{min-height:480px;padding:72px 0;display:grid;grid-template-columns:minmax(0,1fr) 250px;align-items:end;gap:55px;position:relative;z-index:1}.eyebrow{margin:0;color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em}.hero-grid h1{font-size:clamp(55px,7.5vw,88px);line-height:.88;letter-spacing:-.075em;margin:16px 0}.hero-grid h1 em{font-style:normal;color:var(--blue)}.hero-copy{max-width:720px;color:#91a4af;font-size:13px;line-height:1.8}.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hero-stats div{padding:16px;border:1px solid #29404c;border-radius:14px;background:#09151c}.hero-stats span{display:block;color:#5f7784;font:800 7px var(--mono);letter-spacing:.12em}.hero-stats strong{display:block;margin-top:5px;color:#dff8ff;font-size:25px}.articles-shell{display:grid;grid-template-columns:215px minmax(0,1fr);gap:42px;padding:42px 0 90px}.category-rail{display:flex;flex-direction:column;gap:12px}.rail-card{position:sticky;top:90px;display:grid;gap:3px;padding:12px;border:1px solid var(--border);border-radius:15px;background:#09131a}.rail-card+.rail-card{top:390px}.rail-title{padding:8px;color:#59717f;font:900 7px var(--mono);letter-spacing:.15em}.rail-card a{padding:9px;color:#8296a2;text-decoration:none;border-radius:8px;font:800 9px var(--mono);transition:.18s}.rail-card a:hover,.rail-card a.active{color:#dff8ff;background:#55c7f20b}.community-card{position:relative}.article-main{min-width:0}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:16px}.section-heading h2{margin:7px 0 0;font-size:28px;letter-spacing:-.045em}.section-heading>span,.section-heading>a{color:#607985;text-decoration:none;font:800 7px var(--mono)}.featured-grid{display:grid;grid-template-columns:1.25fr .875fr;grid-auto-rows:1fr;gap:11px}.featured-card{overflow:hidden;display:grid;grid-template-columns:175px 1fr;border:1px solid var(--border);border-radius:15px;background:#09141b;color:var(--text);text-decoration:none;transition:.22s}.featured-large{grid-row:span 2;display:block}.featured-card:hover,.latest-card:hover{transform:translateY(-3px);border-color:#2d596e;box-shadow:0 20px 55px #0007}.card-media{min-height:165px;background:#0a1a22;overflow:hidden}.featured-large .card-media{height:255px}.card-media img,.latest-media img{width:100%;height:100%;object-fit:cover;transition:.35s}.featured-card:hover img,.latest-card:hover img{transform:scale(1.04)}.card-media span,.latest-media span{display:grid;place-items:center;height:100%;color:var(--blue);font:900 30px var(--mono)}.featured-body{padding:17px}.meta{display:flex;gap:9px;flex-wrap:wrap;color:var(--blue);font:900 7px var(--mono);text-transform:uppercase}.meta span:last-child{color:#6d838e}.featured-body h3{font-size:17px;line-height:1.08;margin:10px 0 7px}.featured-large .featured-body h3{font-size:28px;line-height:.98}.featured-body p{margin:0;color:#7e929e;font-size:9.5px;line-height:1.65}.latest-section{margin-top:48px;padding-top:34px;border-top:1px solid var(--border)}.latest-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.latest-card{display:grid;grid-template-columns:135px 1fr;min-height:165px;overflow:hidden;border:1px solid var(--border);border-radius:14px;background:#09141b;color:var(--text);text-decoration:none;transition:.22s}.latest-media{background:#0a1a22;min-height:165px}.latest-body{padding:15px}.latest-body h3{margin:9px 0 7px;font-size:15px;line-height:1.08}.latest-body p{margin:0;color:#7d919d;font-size:9px;line-height:1.6}.latest-body b{display:block;margin-top:12px;color:#8cddff;font:900 7px var(--mono)}.archive-section{margin-top:48px;padding-top:34px;border-top:1px solid var(--border)}.archive-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #1b2c35}.archive-list a{display:grid;grid-template-columns:95px 1fr 95px;gap:12px;padding:14px 0;border-bottom:1px solid #1b2c35;text-decoration:none;color:#cfe0e7;align-items:center}.archive-list a:nth-child(odd){padding-right:22px}.archive-list a:nth-child(even){padding-left:22px}.archive-list span{color:var(--blue);font:900 7px var(--mono);text-transform:uppercase}.archive-list strong{font-size:11px}.archive-list small{color:#607783;text-align:right;font:700 7px var(--mono)}
@media(max-width:900px){.articles-shell{grid-template-columns:1fr}.category-rail{display:none}.hero-grid{grid-template-columns:1fr;min-height:430px}.hero-stats{max-width:280px}.featured-grid,.latest-grid{grid-template-columns:1fr}.featured-large{grid-row:auto}.featured-large .card-media{height:220px}}
@media(max-width:560px){.wrap{width:calc(100% - 20px)}.hero-grid{padding:55px 0}.hero-grid h1{font-size:clamp(46px,13vw,68px)}.featured-card,.latest-card{grid-template-columns:112px 1fr}.featured-large{display:block}.featured-large .card-media{height:190px}.archive-list{grid-template-columns:1fr}.archive-list a:nth-child(even),.archive-list a:nth-child(odd){padding-inline:0}.archive-list a{grid-template-columns:85px 1fr}.archive-list small{display:none}}
</style>