---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft)).sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0));
const categories=[...new Set(posts.map(p=>p.data.category).filter(Boolean))].sort();
const readingTime=post=>post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\s+/).filter(Boolean).length??0)/220));
const searchableText=post=>[post.data.title,post.data.description,post.data.excerpt,post.data.subtitle,post.data.category,post.data.type,...(post.data.tags??[]),...(post.data.relatedEvents??[]),...(post.data.relatedPlayers??[])].filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout title="Blog & Guides" description="FC Mobile event guides, strategies, analysis and practical resources from TanzimFC.">
<section class="wrap page-hero"><p class="eyebrow">FC MOBILE CONTENT</p><h1>Guides, analysis<br /><span>and the latest playbook.</span></h1><p>Find FC Mobile guides, event answers, strategy, reviews and useful explainers without digging through the whole archive</p></section>
<section class="wrap content-controls" aria-label="Blog search and filters">
<div class="search-panel"><label class="article-search"><span>⌕</span><input id="article-search" type="search" placeholder="Search guides, players, events or topics" autocomplete="off" /><kbd>⌘ K</kbd></label><div class="search-suggestions" id="search-suggestions"><button type="button" data-query="Numero">Numero</button><button type="button" data-query="A Nation's Story">A Nation's Story</button><button type="button" data-query="event">Events</button><button type="button" data-query="guide">Guides</button></div></div>
<div class="toolbar"><div class="article-filters" role="group" aria-label="Filter by category"><button type="button" class="article-filter active" data-category="all">All</button>{categories.map(category=><button type="button" class="article-filter" data-category={category}>{category}</button>)}</div><label class="article-sort"><span>Sort</span><select id="article-sort"><option value="newest">Newest</option><option value="updated">Recently updated</option><option value="relevant">Most relevant</option></select></label></div>
<div class="search-summary" id="search-summary">{posts.length} articles</div>
</section>
<section class="wrap blog-list" id="article-list" aria-live="polite">
{posts.length?posts.map(post=><a class="blog-card article-item" href={`/blog/${post.slug}/`} data-category={post.data.category} data-search={searchableText(post)} data-published={post.data.publishedAt?.valueOf()??0} data-updated={post.data.updatedAt?.valueOf()??post.data.publishedAt?.valueOf()??0}>
{post.data.image?<img src={post.data.image} alt="" loading="lazy" />:<div class="blog-placeholder"><span>{post.data.type==='player-review'?'REV':'FC'}</span></div>}
<div class="blog-card-body"><div class="blog-meta"><span>{post.data.category}</span><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time><span>{readingTime(post)} min read</span></div><h2>{post.data.title}</h2><p>{post.data.excerpt??post.data.description}</p><strong>Read article →</strong></div>
</a>):<div class="empty-state"><p class="eyebrow">NO ARTICLES</p><h2>Nothing published yet.</h2></div>}
<div class="article-no-results" id="article-no-results" hidden><p class="eyebrow">NO MATCH</p><h2>No articles found</h2><p>Try a player, event, topic or a shorter phrase</p></div>
</section>
</BaseLayout>
<style>
.content-controls{margin-bottom:28px}.search-panel{max-width:860px}.article-search{height:56px;display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:0 15px;box-shadow:0 10px 35px rgba(0,0,0,.035)}.article-search:focus-within{border-color:var(--blue);box-shadow:0 0 0 4px var(--blue3)}.article-search>span{font-size:22px;color:var(--blue)}.article-search input{border:0;outline:0;background:transparent;color:var(--text);width:100%;font:700 12px var(--sans)}.article-search kbd{white-space:nowrap;border:1px solid var(--border);border-radius:6px;padding:4px 6px;color:var(--muted);font:700 7px var(--mono)}.search-suggestions{display:flex;gap:7px;flex-wrap:wrap;padding:9px 0}.search-suggestions button,.article-filter{height:34px;padding:0 10px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--muted);font:800 8px var(--mono);cursor:pointer}.search-suggestions button:hover,.article-filter.active,.article-filter:hover{color:var(--blue);border-color:var(--blue);background:var(--blue3)}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:15px;border-top:1px solid var(--border);padding-top:14px}.article-filters{display:flex;gap:6px;flex-wrap:wrap}.article-sort{display:flex;align-items:center;gap:7px}.article-sort span{font:800 8px var(--mono);color:var(--muted)}.article-sort select{height:34px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font:800 8px var(--mono);padding:0 9px;outline:0}.search-summary{padding-top:12px;color:var(--muted);font:700 8px var(--mono)}.article-no-results{text-align:center;padding:70px 20px;grid-column:1/-1}.article-no-results h2{margin:7px 0}.article-no-results p:last-child{color:var(--muted);font-size:11px}.blog-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.blog-meta span:last-child{color:var(--muted)}
@media(max-width:700px){.article-search{height:50px}.article-search kbd{display:none}.toolbar{display:grid;grid-template-columns:1fr}.article-sort{justify-content:space-between}.search-suggestions{overflow:auto;flex-wrap:nowrap;padding-bottom:10px}}
</style>
<script>
const articlePage=document.querySelector('#article-list');
if(articlePage){const items=[...articlePage.querySelectorAll('.article-item')],search=document.querySelector('#article-search'),filters=[...document.querySelectorAll('.article-filter')],sort=document.querySelector('#article-sort'),empty=document.querySelector('#article-no-results'),summary=document.querySelector('#search-summary'),suggestions=[...document.querySelectorAll('.search-suggestions button')];let category='all';
const tokenize=s=>s.toLowerCase().trim().split(/\s+/).filter(Boolean);
const relevance=(text,q)=>{const words=tokenize(q);if(!words.length)return 0;return words.reduce((score,w)=>score+(text.includes(w)?(text.startsWith(w)?8:3):0),0)};
const render=()=>{const q=(search?.value||'').trim().toLowerCase(),visible=items.filter(item=>(category==='all'||item.dataset.category===category)&&(!q||tokenize(q).every(w=>item.dataset.search.includes(w))));visible.sort((a,b)=>{if(sort?.value==='updated')return Number(b.dataset.updated)-Number(a.dataset.updated);if(sort?.value==='relevant')return relevance(b.dataset.search,q)-relevance(a.dataset.search,q)||Number(b.dataset.published)-Number(a.dataset.published);return Number(b.dataset.published)-Number(a.dataset.published)});visible.forEach(item=>articlePage.appendChild(item));items.forEach(item=>item.hidden=!visible.includes(item));if(empty)empty.hidden=visible.length!==0;if(summary)summary.textContent=q?`${visible.length} matching ${visible.length===1?'article':'articles'}`:`${visible.length} articles`;};
filters.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category;filters.forEach(x=>x.classList.toggle('active',x===b));render()}));suggestions.forEach(b=>b.addEventListener('click',()=>{search.value=b.dataset.query;render();search.focus()}));search?.addEventListener('input',render);sort?.addEventListener('change',render);window.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();search?.focus()}});render();}
</script>