---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOURNAMENT_PUBLICATIONS } from '../data/tournaments.js';
const tournaments = TOURNAMENT_PUBLICATIONS.filter((t) => t.isPublic && ['published','in_progress','completed'].includes(t.status));
---
<BaseLayout title="FCMOBILETOOLS Tournaments" description="Official FC Mobile tournaments organized by FCMOBILETOOLS.">
  <main class="tournaments-page">
    <section class="tour-hero">
      <div>
        <span class="eyebrow">FCMOBILETOOLS ORGANIZED</span>
        <h1>Tournaments</h1>
        <p>Official brackets, match results and tournament progress in one place.</p>
      </div>
      <span class="tour-count">{tournaments.length} tournament{tournaments.length === 1 ? '' : 's'}</span>
    </section>
    {tournaments.length ? (
      <section class="tour-grid">
        {tournaments.map((t) => (
          <a class="tour-card" href={`/tournament/${t.slug}/`}>
            <div class="tour-card-top"><span>{t.format} PLAYERS</span><b>{String(t.status).replace('_',' ')}</b></div>
            <h2>{t.name}</h2>
            <p>{t.description}</p>
            <div class="tour-card-foot"><span>{t.startsAt ? new Date(t.startsAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : 'Schedule TBA'}</span><strong>View bracket →</strong></div>
          </a>
        ))}
      </section>
    ) : (
      <section class="empty-tour"><span>NO ACTIVE TOURNAMENTS</span><h2>The next competition is being prepared.</h2><p>Check back when FCMOBILETOOLS publishes the next official bracket.</p></section>
    )}
  </main>
</BaseLayout>
<style>
.tournaments-page{max-width:1180px;margin:0 auto;padding:120px 24px 90px}.tour-hero{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}.eyebrow,.tour-card-top,.tour-card-foot,.tour-count,.empty-tour>span{font:700 10px/1.2 'Space Grotesk',sans-serif;letter-spacing:.12em;text-transform:uppercase}.eyebrow{color:#4cc9ff}.tour-hero h1{margin:8px 0 8px;font:700 clamp(42px,7vw,76px)/.95 'Space Grotesk',sans-serif;letter-spacing:-.06em}.tour-hero p{margin:0;color:#a7b4c3;font-size:15px}.tour-count{padding:10px 13px;border:1px solid rgba(255,255,255,.08);border-radius:999px;color:#a7b4c3;background:#0f1a26}.tour-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.tour-card{display:block;padding:24px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:linear-gradient(145deg,#0f1a26,#09131c);color:#f5f8fb;text-decoration:none;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.tour-card:hover{transform:translateY(-3px);border-color:#4cc9ff66;box-shadow:0 24px 60px #0006}.tour-card-top,.tour-card-foot{display:flex;justify-content:space-between;gap:12px;color:#718497}.tour-card-top b{color:#47d16c}.tour-card h2{margin:28px 0 8px;font:700 25px 'Space Grotesk',sans-serif}.tour-card p{min-height:44px;margin:0;color:#a7b4c3;line-height:1.65}.tour-card-foot{margin-top:26px}.tour-card-foot strong{color:#4cc9ff}.empty-tour{padding:55px 30px;border:1px dashed #294150;border-radius:20px;text-align:center;background:#0b151e}.empty-tour>span{color:#718497}.empty-tour h2{margin:12px 0 6px;font:700 28px 'Space Grotesk',sans-serif}.empty-tour p{margin:0;color:#a7b4c3}@media(max-width:700px){.tour-hero{align-items:start;flex-direction:column}.tour-grid{grid-template-columns:1fr}.tournaments-page{padding-top:95px}}
</style>
