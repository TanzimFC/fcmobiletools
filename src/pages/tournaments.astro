---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/tournament/Crest.astro';
import { TOURNAMENT_PUBLICATIONS } from '../data/tournaments.js';
import { ROUND_OF_16_SAMPLE } from '../data/tournament-samples.js';
import { progressOf, tournamentState, championOf, nextMatch, formatLabel, formatDate } from '../lib/tournamentView.js';

const rank = { live: 0, upcoming: 1, finished: 2 };
const PUBLIC_TOURNAMENTS = [...TOURNAMENT_PUBLICATIONS, ROUND_OF_16_SAMPLE];
const list = PUBLIC_TOURNAMENTS
  .filter((t) => t.isPublic && ['published', 'in_progress', 'completed'].includes(t.status))
  .map((t) => ({ t, state: tournamentState(t), progress: progressOf(t), champion: championOf(t), next: nextMatch(t) }))
  .sort((a, b) => rank[a.state.key] - rank[b.state.key] || String(b.t.startsAt || '').localeCompare(String(a.t.startsAt || '')));

const [featured, ...rest] = list;
const liveCount = list.filter((x) => x.state.key === 'live').length;
const totalPlayers = list.reduce((n, x) => n + Number(x.t.participantCount || 0), 0);
const totalPlayed = list.reduce((n, x) => n + x.progress.done, 0);
---
<BaseLayout title="Tournaments" description="Official FC Mobile tournaments run by FCMOBILETOOLS. Follow brackets, group tables and results as they happen.">
  <main class="tl">
    <header class="head">
      <div class="wrap head-grid">
        <div>
          <h1>Tournaments</h1>
          <p class="lede">Official FC Mobile competitions run by FCMOBILETOOLS. Follow every bracket, table and result as it happens.</p>
        </div>
        {list.length ? (
          <dl class="totals">
            <div><dt>Tournaments</dt><dd>{list.length}</dd></div>
            <div><dt>Live now</dt><dd class:list={{ on: liveCount > 0 }}>{liveCount}</dd></div>
            <div><dt>Players</dt><dd>{totalPlayers}</dd></div>
            <div><dt>Matches played</dt><dd>{totalPlayed}</dd></div>
          </dl>
        ) : null}
      </div>
    </header>

    <div class="wrap body">
      {featured ? (
        <a class="featured" href={`/tournament/${featured.t.slug}/`}>
          <div class="f-main">
            <span class={`state ${featured.state.key}`}><i></i>{featured.state.label}</span>
            <h2>{featured.t.name}</h2>
            {featured.t.description ? <p>{featured.t.description}</p> : null}
            <ul class="meta">
              <li>{formatLabel(featured.t.formatKey)}</li>
              <li>{featured.t.participantCount} players</li>
              {featured.t.startsAt ? <li>{formatDate(featured.t.startsAt)}</li> : null}
            </ul>
            <span class="cta">Open bracket</span>
          </div>
          <div class="f-side">
            {featured.champion ? (
              <div class="spot gold">
                <p>Champion</p>
                <div class="who"><Crest player={featured.champion} size={52} ring /><strong>{featured.champion.displayName}</strong></div>
              </div>
            ) : featured.next ? (
              <div class="spot">
                <p>Next match</p>
                <div class="duel">
                  <div><Crest player={featured.next.match.player1} size={44} /><b>{featured.next.match.player1.displayName}</b></div>
                  <span>vs</span>
                  <div><Crest player={featured.next.match.player2} size={44} /><b>{featured.next.match.player2.displayName}</b></div>
                </div>
                <div class="meter" style={`--p:${featured.progress.pct}%`}><span></span></div>
                <small>{featured.progress.done} of {featured.progress.total} matches played</small>
              </div>
            ) : (
              <div class="spot">
                <p>Players</p>
                <div class="stack">{featured.t.players.slice(0, 8).map((p) => <Crest player={p} size={38} />)}</div>
                <small>{featured.t.participantCount} players in the draw</small>
              </div>
            )}
          </div>
        </a>
      ) : (
        <section class="empty">
          <h2>No tournaments are open yet</h2>
          <p>When the next official bracket is published, it will show up here with live results. Follow FCMOBILETOOLS on social media to hear about it first.</p>
          <a href="/events/">See what is on in FC Mobile</a>
        </section>
      )}

      {rest.length ? (
        <section class="more" aria-label="More tournaments">
          <div class="more-head">
            <h2>More tournaments</h2>
            {rest.length >= 3 ? (
              <div class="chips" role="group" aria-label="Filter tournaments">
                <button type="button" data-f="all" aria-pressed="true">All</button>
                <button type="button" data-f="live" aria-pressed="false">Live</button>
                <button type="button" data-f="upcoming" aria-pressed="false">Upcoming</button>
                <button type="button" data-f="finished" aria-pressed="false">Finished</button>
              </div>
            ) : null}
          </div>
          <ul class="rows">
            {rest.map(({ t, state, progress, champion }) => (
              <li data-state={state.key}>
                <a href={`/tournament/${t.slug}/`}>
                  <span class="r-name"><b>{t.name}</b><small>{formatLabel(t.formatKey)}, {t.participantCount} players</small></span>
                  <span class="r-info">{champion ? <><Crest player={champion} size={22} /><em>{champion.displayName}</em></> : progress.total ? <em>{progress.done} of {progress.total} played</em> : <em>{formatDate(t.startsAt) || 'Date to be announced'}</em>}</span>
                  <span class={`state ${state.key}`}><i></i>{state.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </div>
  </main>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.chips button');
  const rows = document.querySelectorAll<HTMLLIElement>('.rows li');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    rows.forEach((row) => { row.hidden = btn.dataset.f !== 'all' && row.dataset.state !== btn.dataset.f; });
  }));
</script>

<style>
  .tl{--line:rgba(255,255,255,.08);--cyan:#4cc9ff;--gold:#e9c46a;--live:#47d16c;--muted:#8fa1b1;color:#f5f8fb;padding-bottom:110px}
  .wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,32px)}
  .head{padding:clamp(104px,14vw,140px) 0 38px}
  .head-grid{display:flex;justify-content:space-between;align-items:end;gap:36px;flex-wrap:wrap}
  h1{margin:0;font:700 clamp(46px,8vw,92px)/.92 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.06em}
  .lede{max-width:46ch;margin:20px 0 0;font:400 17px/1.65 'Inter',system-ui,sans-serif;color:#a7b4c3}
  .totals{display:flex;gap:34px;margin:0}
  .totals div{display:grid;gap:6px}
  .totals dt{font:500 12.5px/1 'Inter',system-ui,sans-serif;color:#6f8294}
  .totals dd{margin:0;font:700 30px/1 'Space Grotesk',system-ui,sans-serif;font-variant-numeric:tabular-nums}
  .totals dd.on{color:var(--live)}

  .state{display:inline-flex;align-items:center;gap:8px;padding:6px 12px 6px 10px;border-radius:999px;font:600 12.5px/1 'Inter',system-ui,sans-serif;border:1px solid var(--line);color:var(--muted);background:rgba(255,255,255,.03);white-space:nowrap}
  .state i{width:7px;height:7px;border-radius:50%;background:currentColor}
  .state.live{color:var(--live);border-color:rgba(71,209,108,.35);background:rgba(71,209,108,.08)}
  .state.live i{animation:ping 1.8s infinite}
  .state.finished{color:var(--gold);border-color:rgba(233,196,106,.35);background:rgba(233,196,106,.07)}
  .state.upcoming{color:var(--cyan);border-color:rgba(76,201,255,.3);background:rgba(76,201,255,.07)}

  .featured{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:0;border:1px solid var(--line);border-radius:28px;background:radial-gradient(90% 120% at 0 0,rgba(76,201,255,.1),transparent 60%),linear-gradient(160deg,#0f1d2b,#08121b);color:inherit;text-decoration:none;overflow:hidden;transition:border-color .2s,box-shadow .2s}
  .featured:hover{border-color:rgba(76,201,255,.4);box-shadow:0 40px 90px -40px rgba(76,201,255,.35)}
  .f-main{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(24px,4vw,44px)}
  .f-main h2{margin:22px 0 0;font:700 clamp(32px,4.6vw,52px)/1 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.045em;text-wrap:balance}
  .f-main p{max-width:52ch;margin:14px 0 0;font:400 15.5px/1.65 'Inter',system-ui,sans-serif;color:#a7b4c3}
  .meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin:22px 0 0;padding:0;list-style:none;font:500 14px 'Inter',system-ui,sans-serif;color:#cfdae4}
  .cta{margin-top:30px;padding:13px 22px;border-radius:12px;background:linear-gradient(135deg,#69ddff,#2aa8e8);color:#04131c;font:700 14.5px 'Inter',system-ui,sans-serif;transition:transform .15s}
  .featured:hover .cta{transform:translateY(-1px)}
  .f-side{display:grid;place-items:center;padding:28px;border-left:1px solid var(--line);background:rgba(3,9,14,.35)}
  .spot{width:100%;max-width:340px}
  .spot>p{margin:0 0 20px;font:600 13px/1 'Inter',system-ui,sans-serif;color:var(--muted)}
  .spot small{display:block;margin-top:12px;font:400 13px 'Inter',system-ui,sans-serif;color:var(--muted)}
  .spot.gold>p{color:var(--gold)}
  .spot .who{display:flex;align-items:center;gap:16px}
  .spot .who strong{font:700 28px/1.05 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.03em}
  .duel{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center}
  .duel div{display:grid;justify-items:center;gap:9px;text-align:center;min-width:0}
  .duel b{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 14px 'Inter',system-ui,sans-serif}
  .duel span{font:500 13px 'Inter',system-ui,sans-serif;color:#566a7c}
  .meter{height:4px;margin-top:24px;border-radius:4px;background:rgba(255,255,255,.07);overflow:hidden}
  .meter span{display:block;width:var(--p);height:100%;background:linear-gradient(90deg,#2aa8e8,var(--cyan))}
  .stack{display:flex;flex-wrap:wrap;gap:8px}

  .more{margin-top:56px}
  .more-head{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:16px}
  .more h2{margin:0;font:700 24px 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.03em}
  .chips{display:flex;gap:6px}
  .chips button{padding:8px 14px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--muted);font:600 13px 'Inter',system-ui,sans-serif;cursor:pointer}
  .chips button[aria-pressed="true"]{background:rgba(76,201,255,.12);border-color:rgba(76,201,255,.4);color:#eafaff}
  .rows{margin:0;padding:0;list-style:none;border:1px solid var(--line);border-radius:20px;overflow:hidden;background:#09131c}
  .rows li{border-top:1px solid var(--line)}
  .rows li:first-child{border-top:0}
  .rows li[hidden]{display:none}
  .rows a{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) auto;align-items:center;gap:20px;padding:18px 22px;color:inherit;text-decoration:none;transition:background .15s}
  .rows a:hover{background:rgba(76,201,255,.05)}
  .r-name{display:grid;gap:5px;min-width:0}
  .r-name b{font:700 17px/1.2 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.02em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .r-name small{font:400 13px 'Inter',system-ui,sans-serif;color:#6f8294}
  .r-info{display:flex;align-items:center;gap:10px;min-width:0}
  .r-info em{font:500 13.5px 'Inter',system-ui,sans-serif;font-style:normal;color:#b9c7d2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  .empty{padding:clamp(40px,7vw,80px) clamp(22px,5vw,60px);border:1px dashed #2a4354;border-radius:28px;background:radial-gradient(70% 100% at 50% 0,rgba(76,201,255,.07),transparent 70%)}
  .empty h2{margin:0;font:700 clamp(28px,4vw,40px)/1.1 'Space Grotesk',system-ui,sans-serif;letter-spacing:-.04em}
  .empty p{max-width:52ch;margin:14px 0 0;font:400 16px/1.65 'Inter',system-ui,sans-serif;color:#a7b4c3}
  .empty a{display:inline-block;margin-top:24px;color:var(--cyan);font:600 15px 'Inter',system-ui,sans-serif}

  a:focus-visible,button:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
  @keyframes ping{0%{box-shadow:0 0 0 0 rgba(71,209,108,.6)}70%,100%{box-shadow:0 0 0 8px rgba(71,209,108,0)}}
  @media(prefers-reduced-motion:reduce){.state.live i{animation:none}.featured,.cta{transition:none}}
  @media(max-width:860px){.featured{grid-template-columns:1fr}.f-side{border-left:0;border-top:1px solid var(--line);justify-items:start}.totals{gap:26px}}
  @media(max-width:620px){.rows a{grid-template-columns:1fr auto;gap:10px 14px;padding:16px}.r-info{grid-column:1/-1;order:3}}
</style>
