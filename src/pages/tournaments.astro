---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/tournament-premium.css';
import { DISCORD_URL } from '../data/tournamentConfig.js';
import Crest from '../components/tournament/Crest.astro';
import { TOURNAMENT_PUBLICATIONS } from '../data/tournaments.js';
import { progressOf, tournamentState, championOf, nextMatch, formatLabel, formatDate } from '../lib/tournamentView.js';

const rank = { live: 0, upcoming: 1, finished: 2 };
const list = TOURNAMENT_PUBLICATIONS
  .filter((t) => t.isPublic && !/^(?:format-test-|fcmobiletools-sample-championship$)/i.test(t.slug || '') && ['published', 'in_progress', 'completed'].includes(t.status))
  .map((t) => ({ t, state: tournamentState(t), progress: progressOf(t), champion: championOf(t), next: nextMatch(t) }))
  .sort((a, b) => rank[a.state.key] - rank[b.state.key] || String(b.t.startsAt || '').localeCompare(String(a.t.startsAt || '')));

const [featured, ...rest] = list;
const liveCount = list.filter((x) => x.state.key === 'live').length;
const totalPlayers = list.reduce((n, x) => n + Number(x.t.participantCount || 0), 0);
const totalPlayed = list.reduce((n, x) => n + x.progress.done, 0);
---
<BaseLayout title="Tournaments" description="Official FC Mobile tournaments by FCMOBILETOOLS. Play your match, upload proof, advance. Live brackets, tables and results.">
  <main class="tp">
    <header class="tp-hero"><div class="tp-wrap">
      <span class="tp-eyebrow" data-reveal><i></i>{liveCount ? `${liveCount} live now` : 'Season open'}</span>
      <h1 class="tp-title" data-reveal>Compete. <span class="tp-shine">Be remembered.</span></h1>
      <p class="tp-lede" data-reveal>Official FC Mobile tournaments where you run your own match day: agree a time, play, upload proof, move on. Admins step in only when needed.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px" data-reveal>
        <a class="tp-btn" href="/match-center/">Open my Match Center</a>
        <a class="tp-btn ghost" href="/host-a-tournament/">Host with us</a>
      </div>
      <dl class="tp-stats" data-reveal>
        <div><b data-count={list.length}>0</b><span>Tournaments</span></div>
        <div><b data-count={liveCount}>0</b><span>Live now</span></div>
        <div><b data-count={totalPlayers}>0</b><span>Players</span></div>
        <div><b data-count={totalPlayed}>0</b><span>Matches played</span></div>
      </dl>
    </div></header>

    <div class="tp-wrap">
      {featured ? (
        <a class="tp-glass gold" data-tilt data-reveal href={`/tournament/${featured.t.slug}/`} style="display:block;text-decoration:none;color:inherit">
          <div class="in-c f-grid">
            <div>
              <span class={`tp-pill ${featured.state.key}`}><i></i>{featured.state.label}</span>
              <h2 style="font-size:clamp(34px,5vw,60px);margin:20px 0 12px">{featured.t.name}</h2>
              {featured.t.description ? <p class="muted">{featured.t.description}</p> : null}
              <p class="muted">{formatLabel(featured.t.formatKey)} · {featured.t.participantCount} players{featured.t.startsAt ? ` · ${formatDate(featured.t.startsAt)}` : ''}</p>
              <span class="tp-btn sm" style="margin-top:14px">Enter the arena →</span>
            </div>
            <div class="spot">
              {featured.champion ? (<><small>Champion</small><Crest player={featured.champion} size={72} ring /><strong>{featured.champion.displayName}</strong></>)
              : featured.next ? (<><small>Next match</small>
                <div class="duel"><Crest player={featured.next.match.player1} size={52} /><em>VS</em><Crest player={featured.next.match.player2} size={52} /></div>
                <b>{featured.next.match.player1.displayName} <i>vs</i> {featured.next.match.player2.displayName}</b></>)
              : (<><small>The field</small><div class="stack">{featured.t.players.slice(0, 8).map((p) => <Crest player={p} size={40} />)}</div></>)}
              <div class="tp-meter" style={`--p:${featured.progress.pct}%;width:100%`}><span></span></div>
              <small>{featured.progress.done} of {featured.progress.total} matches played</small>
            </div>
          </div>
        </a>
      ) : (
        <section class="tp-glass" data-reveal><div class="in-c" style="text-align:center;padding:60px 24px">
          <h2>The next arena is being built</h2><p class="muted">Join our Discord to get first access when registration opens.</p>
          <a class="tp-btn discord" style="margin-top:18px" href={DISCORD_URL}>Join Discord</a></div></section>
      )}

      {rest.length ? (
        <section class="tp-sec"><div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap"><h2>More tournaments</h2>
          <div class="tp-chips" role="group" aria-label="Filter">{['all','live','upcoming','finished'].map((k, i) => <button type="button" data-f={k} aria-pressed={String(i === 0)}>{k[0].toUpperCase() + k.slice(1)}</button>)}</div></div>
          <div class="tp-grid" style="margin-top:22px">
            {rest.map(({ t, state, progress, champion }) => (
              <a class="tp-glass cardx" data-tilt data-reveal data-state={state.key} href={`/tournament/${t.slug}/`} style="text-decoration:none;color:inherit"><div class="in-c">
                <span class={`tp-pill ${state.key}`}><i></i>{state.label}</span>
                <h3 style="font-size:24px;margin:16px 0 6px">{t.name}</h3>
                <p class="muted">{formatLabel(t.formatKey)} · {t.participantCount} players</p>
                <div class="tp-meter" style={`--p:${progress.pct}%;margin:18px 0 10px`}><span></span></div>
                <small class="muted">{champion ? `Champion: ${champion.displayName}` : progress.total ? `${progress.done}/${progress.total} played` : (formatDate(t.startsAt) || 'Date to be announced')}</small>
              </div></a>
            ))}
          </div></section>
      ) : null}

      <section class="tp-sec"><h2>How a match day works</h2>
        <ol class="tp-steps">
          <li data-reveal><b>Meet your opponent</b><p>Share Discord and in-game UID inside the match room. Propose a time that suits you both.</p></li>
          <li data-reveal><b>Play it</b><p>Kick off in FC Mobile. Take a screenshot of the full-time scoreboard.</p></li>
          <li data-reveal><b>Report with proof</b><p>Upload the screenshot and score. Your opponent gets 24 hours to confirm.</p></li>
          <li data-reveal><b>Advance</b><p>Both agree and the bracket updates. Disagree and an admin reviews the evidence.</p></li>
        </ol></section>

      <section class="tp-glass gold tp-sec" data-reveal><div class="in-c" style="text-align:center;padding:clamp(36px,6vw,64px)">
        <h2 style="font-size:clamp(28px,4.4vw,48px)">Want to host a tournament with us?</h2>
        <p class="muted" style="max-width:50ch;margin:14px auto 24px">Bring your community. We bring the brackets, verification and the premium experience.</p>
        <a class="tp-btn discord" href={DISCORD_URL}>Talk to us on Discord</a> <a class="tp-btn ghost" href="/host-a-tournament/">See what hosts get</a></div></section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initFx } from '../lib/tournamentFx.js';
  initFx();
  const b = document.querySelectorAll<HTMLButtonElement>('.tp-chips button'), c = document.querySelectorAll<HTMLElement>('.cardx');
  b.forEach((x) => x.addEventListener('click', () => { b.forEach((y) => y.setAttribute('aria-pressed', String(y === x))); c.forEach((e) => { e.hidden = x.dataset.f !== 'all' && e.dataset.state !== x.dataset.f; }); }));
</script>

<style is:global>
  .tp .muted{color:#9bacbd;font-size:15.5px;line-height:1.65;margin:0 0 6px}
  .tp .f-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:30px}
  .tp .spot{display:grid;gap:14px;align-content:center;justify-items:center;text-align:center;padding:24px;border-radius:20px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07)}
  .tp .duel{display:flex;align-items:center;gap:14px}.tp .duel em{font:700 13px 'Space Grotesk';color:var(--gold)}
  .tp .stack{display:flex}.tp .stack .crest{margin-left:-8px}
  .tp .spot i{color:var(--gold);font-style:normal}
  @media(max-width:820px){.tp .f-grid{grid-template-columns:1fr}}
</style>
