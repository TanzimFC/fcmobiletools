---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Reset Time Countdown | FCMOBILETOOLS',
  description: 'Live FC Mobile daily reset countdown with the next reset shown in your local time.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://tanzimfc.fcmobiletools.workers.dev').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout
  title="FC Mobile Reset Time Countdown | FCMOBILETOOLS"
  description="Live FC Mobile daily reset countdown with the next reset shown in your local time. The counter rolls into the next reset automatically."
>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="reset-page">
    <div class="reset-glow glow-one"></div>
    <div class="reset-glow glow-two"></div>

    <section class="reset-hero" aria-labelledby="reset-title">
      <div class="reset-eyebrow"><span></span> FC MOBILE / DAILY RESET</div>
      <h1 id="reset-title">FC Mobile <em>Reset Time</em></h1>
      <p class="reset-intro">A live countdown to the next daily reset, calculated from the game reset clock and displayed in your local time.</p>

      <div class="countdown-shell">
        <div class="countdown-top">
          <span>NEXT RESET IN</span>
          <span class="live-dot"><i></i> LIVE</span>
        </div>
        <div class="countdown" aria-label="Time until the next FC Mobile daily reset">
          <div class="time-part"><strong id="hours">--</strong><span>HOURS</span></div>
          <b>:</b>
          <div class="time-part"><strong id="minutes">--</strong><span>MINUTES</span></div>
          <b>:</b>
          <div class="time-part"><strong id="seconds">--</strong><span>SECONDS</span></div>
        </div>
        <div class="reset-progress" aria-hidden="true"><span id="progress"></span></div>
        <div class="countdown-meta">
          <div><span>NEXT RESET</span><strong id="next-reset">Loading…</strong></div>
          <div><span>YOUR LOCAL TIME</span><strong id="local-time">Loading…</strong></div>
        </div>
      </div>

      <div class="reset-facts" aria-label="Reset information">
        <div><span class="fact-index">01</span><div><strong>01:00 UTC</strong><small>Daily reset reference time</small></div></div>
        <div><span class="fact-index">02</span><div><strong>Every day</strong><small>Automatically rolls to the next reset</small></div></div>
        <div><span class="fact-index">03</span><div><strong>Your timezone</strong><small>Next reset is shown in local time</small></div></div>
      </div>
    </section>

    <section class="reset-info" aria-labelledby="how-title">
      <div>
        <span class="section-kicker">HOW THE COUNTER WORKS</span>
        <h2 id="how-title">It keeps counting without a refresh</h2>
      </div>
      <p>The countdown recalculates the next daily reset from the current clock instead of simply subtracting one second from a stored number. When the reset arrives, it immediately moves to the following day and continues counting.</p>
    </section>

    <section class="reset-note" aria-label="Reset time note">
      <span>RESET CLOCK</span>
      <p>FC Mobile daily reset is tracked at <strong>01:00 UTC</strong>. Different game activities can have their own refresh schedules, so this counter is specifically for the daily reset cycle</p>
    </section>
  </main>
</BaseLayout>

<style>
.reset-page{position:relative;min-height:calc(100vh - 70px);overflow:hidden;padding:clamp(56px,8vw,100px) 20px 90px;background:#06090e;color:#f4f7fb}.reset-glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(90px);opacity:.13;pointer-events:none}.glow-one{top:70px;left:-260px;background:#35bdf2}.glow-two{right:-280px;top:300px;background:#526dff}.reset-hero{position:relative;z-index:1;max-width:1060px;margin:0 auto;text-align:center}.reset-eyebrow{display:inline-flex;align-items:center;gap:9px;color:#7e8da2;font:800 10px/1 var(--mono,monospace);letter-spacing:.18em}.reset-eyebrow span{width:7px;height:7px;border-radius:50%;background:#55c7f2;box-shadow:0 0 14px #55c7f2}.reset-hero h1{margin:20px 0 14px;font-size:clamp(42px,7vw,82px);line-height:.94;letter-spacing:-.055em;font-weight:900}.reset-hero h1 em{font-style:normal;color:#55c7f2}.reset-intro{max-width:650px;margin:0 auto;color:#8996a9;font-size:15px;line-height:1.75}.countdown-shell{position:relative;max-width:900px;margin:48px auto 0;padding:28px clamp(18px,4vw,46px) 30px;border:1px solid #1b2735;border-radius:22px;background:linear-gradient(145deg,#0b1119,#080c12);box-shadow:0 30px 90px #0008,inset 0 1px #ffffff08}.countdown-top{display:flex;justify-content:space-between;align-items:center;color:#6e7c8f;font:800 9px var(--mono,monospace);letter-spacing:.17em}.live-dot{display:flex;align-items:center;gap:7px;color:#6ed6a0}.live-dot i{width:6px;height:6px;border-radius:50%;background:#62d99a;box-shadow:0 0 10px #62d99a}.countdown{display:flex;align-items:center;justify-content:center;gap:clamp(9px,2vw,24px);margin:28px 0 25px}.time-part{min-width:145px}.time-part strong{display:block;font:800 clamp(48px,9vw,92px)/.9 var(--mono,monospace);letter-spacing:-.08em;color:#f7fbff}.time-part span{display:block;margin-top:12px;color:#536276;font:800 8px var(--mono,monospace);letter-spacing:.16em}.countdown>b{font:700 clamp(35px,6vw,64px)/1 var(--mono,monospace);color:#2e3b4d;align-self:flex-start;margin-top:2px}.reset-progress{height:2px;background:#151f2c;border-radius:99px;overflow:hidden}.reset-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#3aaed9,#667cff);box-shadow:0 0 12px #55c7f2;transition:width .8s linear}.countdown-meta{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px;text-align:left}.countdown-meta div{padding:13px 15px;border-left:1px solid #263445;background:#ffffff02}.countdown-meta span{display:block;color:#59677a;font:800 8px var(--mono,monospace);letter-spacing:.13em}.countdown-meta strong{display:block;margin-top:6px;color:#dce4ee;font-size:13px}.reset-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:900px;margin:14px auto 0;text-align:left}.reset-facts>div{display:flex;gap:14px;align-items:flex-start;padding:18px 16px;border:1px solid #182331;border-radius:14px;background:#080d14}.fact-index{color:#4f6278;font:800 9px var(--mono,monospace)}.reset-facts strong{display:block;color:#dfe7f1;font-size:13px}.reset-facts small{display:block;margin-top:4px;color:#68768a;font-size:11px;line-height:1.45}.reset-info{position:relative;z-index:1;display:grid;grid-template-columns:minmax(260px,.8fr) 1.2fr;gap:50px;max-width:900px;margin:90px auto 0;padding-top:30px;border-top:1px solid #17212e}.section-kicker{color:#55c7f2;font:800 9px var(--mono,monospace);letter-spacing:.16em}.reset-info h2{margin:12px 0 0;font-size:clamp(25px,4vw,38px);line-height:1.05;letter-spacing:-.035em}.reset-info p{margin:0;color:#7d8a9d;font-size:13px;line-height:1.8}.reset-note{position:relative;z-index:1;max-width:900px;margin:34px auto 0;padding:18px 20px;border:1px solid #172433;border-radius:12px;background:#091018}.reset-note>span{display:block;color:#52657b;font:800 8px var(--mono,monospace);letter-spacing:.16em}.reset-note p{margin:8px 0 0;color:#748297;font-size:11px;line-height:1.65}.reset-note strong{color:#b9d9e9}@media(max-width:760px){.countdown{gap:7px}.time-part{min-width:0;flex:1}.countdown>b{font-size:32px}.reset-facts{grid-template-columns:1fr}.reset-info{grid-template-columns:1fr;gap:18px;margin-top:65px}.countdown-meta{grid-template-columns:1fr}.countdown-shell{border-radius:17px}}@media(max-width:480px){.reset-page{padding-inline:14px}.reset-hero h1{font-size:43px}.countdown{margin-top:25px}.time-part strong{font-size:43px}.time-part span{font-size:7px}.countdown>b{font-size:25px}.countdown-shell{padding:22px 14px 22px}.reset-facts>div{padding:15px}}
</style>

<script>
  const RESET_HOUR_UTC = 1;
  const hoursEl = document.querySelector('#hours');
  const minutesEl = document.querySelector('#minutes');
  const secondsEl = document.querySelector('#seconds');
  const nextResetEl = document.querySelector('#next-reset');
  const localTimeEl = document.querySelector('#local-time');
  const progressEl = document.querySelector('#progress');

  const pad = (value) => String(value).padStart(2, '0');

  const getNextReset = (now = new Date()) => {
    const target = new Date(now);
    target.setUTCHours(RESET_HOUR_UTC, 0, 0, 0);
    if (target.getTime() <= now.getTime()) target.setUTCDate(target.getUTCDate() + 1);
    return target;
  };

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    weekday: 'short', month: 'short', day: 'numeric', year: 'numeric',
    hour: 'numeric', minute: '2-digit', timeZoneName: 'short'
  });

  const timeFormatter = new Intl.DateTimeFormat(undefined, {
    hour: 'numeric', minute: '2-digit', second: '2-digit', timeZoneName: 'short'
  });

  const update = () => {
    const now = new Date();
    const next = getNextReset(now);
    let remaining = Math.max(0, next.getTime() - now.getTime());
    const totalSeconds = Math.floor(remaining / 1000);
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    hoursEl.textContent = pad(hours);
    minutesEl.textContent = pad(minutes);
    secondsEl.textContent = pad(seconds);
    nextResetEl.textContent = dateFormatter.format(next);
    localTimeEl.textContent = timeFormatter.format(now);

    const dayStart = new Date(next);
    dayStart.setUTCDate(dayStart.getUTCDate() - 1);
    const elapsed = Math.min(86400000, Math.max(0, now.getTime() - dayStart.getTime()));
    progressEl.style.width = `${(elapsed / 86400000) * 100}%`;
  };

  update();
  const timer = window.setInterval(update, 250);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) update();
  });
  window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
</script>
