.gift-links a{color:var(--cyan);font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap}
.gift-links a:hover{text-decoration:underline}

.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.06em;background:rgba(5,12,17,.72);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);color:#d5e8ee;white-space:nowrap}
.badge.live{color:#9af0c6;border-color:rgba(88,224,166,.4)}

/* sections */
.block{margin-top:72px;scroll-margin-top:96px}
.block-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:24px}
.sec-kicker{color:var(--cyan);font-size:12px;font-weight:700;letter-spacing:.03em;margin-bottom:6px}
.block-head h2{font-size:clamp(26px,3vw,36px);letter-spacing:-.04em;text-wrap:balance}
.block-head p{color:var(--mute);font-size:14px;margin-top:6px}
.sync{color:#5bbf98!important;font-weight:600}

/* filter tabs */
.filter-tabs{display:inline-flex;flex-wrap:wrap;gap:6px;padding:4px;border-radius:12px;border:1px solid var(--line);background:rgba(11,23,31,.8)}
.filter-btn{
  padding:8px 14px;border:0;border-radius:9px;background:transparent;color:var(--mute);
  font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;transition:background .16s ease,color .16s ease;
}
.filter-btn:hover{color:var(--ink)}
.filter-btn.is-active{background:rgba(98,217,255,.15);color:var(--cyan)}

/* event cards: identical structure and size, own accent colour */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{--acc:var(--cyan);position:relative;display:flex;flex-direction:column;border-radius:22px;overflow:hidden;background:linear-gradient(170deg,#0e1d27,#08131a);border:1px solid var(--line);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.card[hidden]{display:none}
.card::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:linear-gradient(90deg,var(--acc),transparent);z-index:2}
.card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--acc) 55%,var(--line));box-shadow:0 30px 70px rgba(0,0,0,.4)}
.card-media{position:relative;aspect-ratio:16/10;background:#071117;overflow:hidden}
.card-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}
.card:hover .card-media img{transform:scale(1.03)}
.card-fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,13,19,.15) 0%,rgba(6,13,19,.05) 40%,rgba(8,19,26,.96) 100%)}
.card-date{position:absolute;left:20px;bottom:14px;display:flex;align-items:baseline;gap:8px}
.card-date b{font:800 54px/.9 var(--num);letter-spacing:-.06em;color:#fff;text-shadow:0 8px 28px rgba(0,0,0,.5);font-variant-numeric:tabular-nums}
.card-date span{font-size:15px;font-weight:700;color:var(--acc)}
.card .badge{position:absolute;top:16px;right:16px}
.card .badge.soon{color:var(--acc);border-color:color-mix(in srgb,var(--acc) 40%,transparent)}
.card .badge.live{color:#9af0c6}
.card-body{display:flex;flex-direction:column;gap:8px;flex:1;padding:20px 22px 22px}
.card-focus{color:var(--acc);font-size:12px;font-weight:700}
.card-body h3{font-size:23px;letter-spacing:-.035em;line-height:1.15}
.card-body p{color:var(--mute);font-size:14px;line-height:1.55}
.card-count{margin-top:auto;padding-top:14px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-end;gap:10px}
.card-count small{display:block;color:var(--mute);font-size:11.5px}
.card-local-time{display:block;font-style:normal;color:#6c8d99;font-size:11.5px;margin-top:2px;font-variant-numeric:tabular-nums}
.card-count strong{font:800 24px/1 var(--num);letter-spacing:-.05em;color:var(--ink);font-variant-numeric:tabular-nums}
.card-links{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding-top:12px;margin-top:8px;border-top:1px solid rgba(24,53,66,.6);
}
.card-link{font-size:12.5px;font-weight:700;text-decoration:none;white-space:nowrap}
.card-link--primary{color:var(--acc)}
.card-link--primary:hover{text-decoration:underline}
.card-link--sub{color:var(--mute)}
.card-link--sub:hover{color:var(--ink)}

/* resets */
.resets{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.reset{padding:28px;border-radius:22px;border:1px solid var(--line);background:linear-gradient(160deg,#0d1b24,#08131a);display:flex;flex-direction:column}
.reset.accent{border-color:rgba(98,217,255,.35);background:linear-gradient(160deg,#0c2230,#08151d)}
.reset-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.reset-top h3{font-size:19px;letter-spacing:-.02em}
.reset-top span{color:var(--mute);font-size:13px}
.big{display:block;margin:18px 0 14px;font:800 clamp(36px,4.8vw,52px)/1 var(--num);letter-spacing:-.06em;font-variant-numeric:tabular-nums}
.accent .big{color:var(--cyan)}
.cycle-bar{height:6px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden;margin-bottom:18px}
.cycle-bar span{display:block;height:100%;width:45%;background:linear-gradient(90deg,var(--cyan),var(--green));border-radius:inherit}
.reset dl{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-top:16px;border-top:1px solid var(--line)}
.reset dt{color:#5f8290;font-size:12px}
.reset dd{margin-top:6px;font:600 13px/1.4 var(--num);color:#d6eaf0;font-variant-numeric:tabular-nums}
.reset-links{
  margin-top:16px;padding-top:14px;border-top:1px solid rgba(24,53,66,.65);
  display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font-size:12.5px;color:var(--mute);
}
.reset-links a{color:var(--cyan);font-weight:700;text-decoration:none;white-space:nowrap}
.reset-links a:hover{text-decoration:underline}

/* Daily routine checklist */
.routine-panel{
  margin-top:20px;padding:26px 28px;border-radius:22px;border:1px solid var(--line);
  background:linear-gradient(165deg,#0c1a24,#081219);
}
.routine-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:18px}
.routine-head h3{font-size:21px;letter-spacing:-.03em}
.routine-head p{color:var(--mute);font-size:13.5px;margin-top:4px}
.routine-actions{display:flex;align-items:center;gap:12px}
.routine-progress{font-family:var(--num);font-size:13px;font-weight:700;color:var(--green);font-variant-numeric:tabular-nums}
.routine-reset-btn{
  padding:7px 12px;border-radius:10px;border:1px solid var(--line);background:rgba(255,255,255,.04);
  color:var(--mute);font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;
}
.routine-reset-btn:hover{color:var(--ink);border-color:rgba(98,217,255,.35)}
.routine-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.routine-row{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:14px 16px;border-radius:15px;border:1px solid rgba(24,53,66,.85);background:rgba(6,14,20,.65);
  transition:border-color .16s ease,background .16s ease;
}
.routine-row.is-done{border-color:rgba(88,224,166,.35);background:rgba(88,224,166,.05)}
.routine-check{display:flex;align-items:flex-start;gap:12px;cursor:pointer;flex:1;min-width:0}
.routine-check input{width:18px;height:18px;margin-top:2px;accent-color:var(--green);cursor:pointer;flex:0 0 18px}
.routine-text{display:grid;gap:3px;min-width:0}
.routine-text strong{font-size:14.5px;color:var(--ink)}
.routine-row.is-done .routine-text strong{text-decoration:line-through;color:var(--mute)}
.routine-text small{color:var(--mute);font-size:12.5px;line-height:1.4}
.routine-link{
  padding:8px 14px;border-radius:10px;border:1px solid rgba(98,217,255,.28);background:rgba(98,217,255,.08);
  color:var(--cyan);font-size:12.5px;font-weight:700;text-decoration:none;white-space:nowrap;
}
.routine-link:hover{background:rgba(98,217,255,.16)}

/* Active Event Trackers */
.trackers-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.tracker-card{
  padding:28px;border-radius:22px;border:1px solid var(--line);
  background:linear-gradient(165deg,#0d1c26,#08131a);display:flex;flex-direction:column;gap:14px;
}
.tracker-card--cyan{border-color:rgba(98,217,255,.28)}
.tracker-card--gold{border-color:rgba(255,211,110,.28)}
.tracker-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.tracker-meta{color:var(--mute);font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}
.tracker-card h3{font-size:24px;letter-spacing:-.035em}
.tracker-card p{color:var(--mute);font-size:14px;line-height:1.55}
.tracker-stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:14px;
  border-radius:15px;border:1px solid rgba(24,53,66,.85);background:rgba(6,13,19,.65);
}
.tracker-stats small{display:block;color:var(--mute);font-size:11px}
.tracker-stats strong{display:block;margin-top:4px;font:700 14px/1.2 var(--num);color:var(--ink);font-variant-numeric:tabular-nums}
.tracker-sublinks{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:8px}
.tracker-sublinks a{
  padding:9px 13px;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.03);
  color:var(--ink);font-size:12.5px;font-weight:700;text-decoration:none;white-space:nowrap;
}
.tracker-sublinks a.primary-sublink{background:var(--cyan);color:#04141d;border-color:var(--cyan)}
.tracker-sublinks a:hover{border-color:var(--cyan)}

.nation-quick-search{display:flex;gap:8px}
.nation-quick-search input{
  flex:1;min-width:0;padding:10px 14px;border-radius:12px;border:1px solid var(--line);
  background:rgba(6,13,19,.8);color:var(--ink);font-size:13.5px;outline:none;
}
.nation-quick-search input:focus{border-color:var(--gold)}
.nation-quick-search button{
  padding:10px 16px;border-radius:12px;border:1px solid rgba(255,211,110,.45);
  background:rgba(255,211,110,.14);color:var(--gold);font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;
}
.nation-pills{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:auto}
.nation-pills a{
  display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 8px;
  border-radius:13px;border:1px solid var(--line);background:rgba(6,13,19,.65);
  color:var(--ink);text-decoration:none;text-align:center;transition:border-color .16s ease,transform .16s ease;
}
.nation-pills a:hover{border-color:var(--gold);transform:translateY(-2px)}
.nation-pills span{font-size:18px}
.nation-pills b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.nation-pills small{color:var(--mute);font-size:10.5px}

/* Spotlight side-event guides */
.spotlight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:20px}
.spotlight-card{
  padding:20px;border-radius:18px;border:1px solid var(--line);background:rgba(11,23,31,.72);
  display:flex;flex-direction:column;gap:8px;
}
.spotlight-card h3{font-size:17px;letter-spacing:-.02em;line-height:1.25}
.spotlight-card h3 a{color:var(--ink);text-decoration:none}
.spotlight-card h3 a:hover{color:var(--cyan)}
.spotlight-card p{color:var(--mute);font-size:13px;line-height:1.55;flex:1}
.spotlight-links{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-top:10px;border-top:1px solid rgba(24,53,66,.65);font-size:12.5px;font-weight:700}
.spot-primary{color:var(--cyan);text-decoration:none;white-space:nowrap}
.spot-sub{color:var(--mute);text-decoration:none;white-space:nowrap}
.spot-sub:hover{color:var(--ink)}

/* Editorial Event Guides */
.guides-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.guide-card{
  display:flex;flex-direction:column;border-radius:20px;overflow:hidden;
  border:1px solid var(--line);background:linear-gradient(170deg,#0d1b24,#081219);
  color:var(--ink);text-decoration:none;transition:transform .18s ease,border-color .18s ease;
}
.guide-card[hidden]{display:none}
.guide-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--post-acc,var(--cyan)) 55%,var(--line))}
.guide-media{aspect-ratio:16/9;background:#071117;overflow:hidden}
.guide-media img{width:100%;height:100%;object-fit:cover;display:block}
.guide-fallback{width:100%;height:100%;display:grid;place-items:center;color:var(--mute);font-weight:800;font-size:13px}
.guide-body{padding:18px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.guide-meta{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mute)}
.guide-meta span:first-child{color:var(--post-acc,var(--cyan));font-weight:700}
.guide-body h3{font-size:17.5px;line-height:1.25;letter-spacing:-.02em}
.guide-body p{color:var(--mute);font-size:13.5px;line-height:1.55;flex:1;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.guide-read{color:var(--cyan);font-size:12.5px;font-weight:700;margin-top:4px}
.guides-foot{
  margin-top:18px;padding:16px 20px;border-radius:16px;border:1px solid rgba(24,53,66,.75);
  background:rgba(11,23,31,.55);display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;font-size:13px;color:var(--mute);
}
.guides-foot a{color:var(--cyan);font-weight:700;text-decoration:none;white-space:nowrap}
.guides-foot a:hover{text-decoration:underline}

/* Event Preparation Toolkit */
.toolkit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.toolkit-card{
  display:flex;flex-direction:column;gap:8px;padding:22px;border-radius:20px;
  border:1px solid var(--line);background:linear-gradient(165deg,#0d1b24,#081219);
  color:var(--ink);text-decoration:none;transition:transform .18s ease,border-color .18s ease;
}
.toolkit-card:hover{transform:translateY(-3px);border-color:rgba(98,217,255,.45)}
.toolkit-tag{color:var(--cyan);font-size:12px;font-weight:700}
.toolkit-card h3{font-size:19px;letter-spacing:-.025em}
.toolkit-card p{color:var(--mute);font-size:13.5px;line-height:1.55;flex:1}
.toolkit-cta{color:var(--cyan);font-size:13px;font-weight:700;margin-top:6px}

@media (max-width:1020px){
  .status-strip{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gift-bar{grid-template-columns:1fr;gap:14px}
  .gift-links{align-items:flex-start;flex-direction:row;flex-wrap:wrap;gap:16px}
  .cards{grid-template-columns:1fr 1fr}
  .cards .card:last-child{grid-column:1/-1}
  .cards .card:last-child .card-media{aspect-ratio:21/9}
  .trackers-grid{grid-template-columns:1fr}
  .spotlight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .guides-grid,.toolkit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:760px){
  .hub{padding:24px 16px 72px}
  .top{grid-template-columns:1fr;gap:24px}
  .clock{grid-template-columns:1fr 1fr;min-width:0}
  .clock>div+div{border-top:0;border-left:1px solid var(--line)}
  .status-strip{grid-template-columns:1fr}
  .hero,.hero-body{min-height:400px}
  .hero-body{padding:26px 20px}
  .hero-shade{background:linear-gradient(0deg,rgba(4,10,15,.95) 0%,rgba(4,10,15,.65) 65%,rgba(4,10,15,.25) 100%)}
  .hero-foot .ext-link{margin-left:0}
  .cards,.resets,.spotlight-grid,.guides-grid,.toolkit-grid{grid-template-columns:1fr}
  .cards .card:last-child .card-media{aspect-ratio:16/10}
  .block{margin-top:52px}
  .reset dl{grid-template-columns:1fr}
  .routine-row{flex-direction:column;align-items:flex-start}
  .routine-link{align-self:flex-start}
  .tracker-stats{grid-template-columns:1fr 1fr}
  .nation-pills{grid-template-columns:repeat(3,minmax(0,1fr))}
  .nation-quick-search{flex-direction:column}
}
@media (prefers-reduced-motion:reduce){
  .card,.card-media img,.status-cell,.guide-card,.toolkit-card{transition:none}
  .card:hover,.status-cell:hover,.guide-card:hover,.toolkit-card:hover{transform:none}
  .card:hover .card-media img{transform:none}
}
</style>
</BaseLayout>
