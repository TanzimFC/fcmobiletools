---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/events/EventCard.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { summarizeRedeemPayload } from '../lib/redeem-summary.js';
import { safeScriptJson } from '../lib/redeem.js';
import { getPosts, img, fmtDate } from '../lib/blog.js';

const FC = FOOTBALL_CENTRE_CONTENT;
const DAY = 864e5;
const now = Date.now();
const DEV_REDEEM_SUMMARY = import.meta.env.DEV
  ? { ...summarizeRedeemPayload({ codes: REDEEM_CODES, serverDate: new Date().toISOString().slice(0, 10) }), developmentFallback: true }
  : null;

/* ------------------------------------------------------------------ helpers */
const pad = (n) => String(Math.max(0, Math.floor(n))).padStart(2, '0');
const parts = (ms) => {
  let s = Math.max(0, Math.floor(ms / 1000));
  const d = Math.floor(s / 86400); s %= 86400;
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60);
  return { d, h, m, s: s % 60 };
};
const clockText = (ms) => {
  const p = parts(ms);
  return (p.d > 0 ? p.d + 'd ' : '') + pad(p.h) + ':' + pad(p.m) + ':' + pad(p.s);
};
const utcFmt = (ms, withTime = false) =>
  new Intl.DateTimeFormat('en-GB', {
    timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short',
    ...(withTime ? { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' } : {})
  }).format(ms);
const norm = (s) => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const slug = (s) => String(s ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const initials = (s) => {
  const w = String(s).replace(/[^A-Za-z0-9' ]/g, '').split(/\s+/).filter(Boolean);
  return (w.length > 1 ? w[0][0] + w[1][0] : (w[0] || 'FC').slice(0, 2)).toUpperCase();
};

/* ------------------------------------------------- catalog + admin overrides
   eventsCatalog is the source of truth. The admin "Events & Reset" panel edits
   eventCountdown / secondaryEvent, and upcomingEvents is edited in code. Those
   legacy objects override start time and banner of the matching catalog entry
   (matched by title), and an event that has no catalog entry is added so
   nothing the admin sets ever goes missing from the hub. */
const catalog = (Array.isArray(FC.eventsCatalog) ? FC.eventsCatalog : []).map((e) => ({ ...e }));
const legacy = [
  FC.eventCountdown?.enabled ? FC.eventCountdown : null,
  FC.secondaryEvent?.enabled ? FC.secondaryEvent : null,
  ...(Array.isArray(FC.upcomingEvents) ? FC.upcomingEvents : [])
].filter((l) => l?.title && l.startUtc);

for (const l of legacy) {
  const hit = catalog.find((c) => norm(c.title) === norm(l.title) || (l.id && c.id === l.id));
  if (hit) {
    hit.startUtc = l.startUtc || hit.startUtc;
    if (l.banner) hit.banner = l.banner;
  } else {
    catalog.push({
      id: l.id || slug(l.title),
      tier: 'side',
      title: l.title,
      kicker: 'Event',
      startUtc: l.startUtc,
      endUtc: l.endUtc || '',
      summary: l.subtitle || 'Details are being added. Check the latest news for what it includes.',
      banner: l.banner || '',
      accent: '#62d9ff',
      highlights: [],
      href: '/blog/',
      hrefLabel: 'Latest event news'
    });
  }
}

const events = catalog
  .map((e) => {
    const start = Date.parse(e.startUtc);
    const end = e.endUtc ? Date.parse(e.endUtc) : NaN;
    if (!Number.isFinite(start)) return null;
    const hasEnd = Number.isFinite(end);
    const state = now < start ? 'upcoming' : hasEnd && now >= end ? 'ended' : 'live';
    const total = hasEnd ? Math.max(1, Math.round((end - start) / DAY)) : 0;
    const dayIdx = Math.min(total || 99, Math.floor((now - start) / DAY) + 1);
    const pct = hasEnd ? Math.min(100, Math.max(0, ((now - start) / (end - start)) * 100)) : 0;
    let label = 'Ends in', clock = hasEnd ? clockText(end - now) : 'Ongoing', dayText = '';
    if (state === 'upcoming') { label = 'Starts in'; clock = clockText(start - now); dayText = utcFmt(start); }
    else if (state === 'ended') { label = 'Ended'; clock = utcFmt(end); dayText = total ? total + '-day event' : ''; }
    else { dayText = hasEnd ? `Day ${dayIdx} of ${total}` : 'No end date'; }
    return {
      ...e, start, end: hasEnd ? end : 0, hasEnd, state, total, dayIdx, pct, label, clock, dayText,
      tn: norm(e.title), mono: initials(e.title),
      startLabel: utcFmt(start), endLabel: hasEnd ? utcFmt(end) : '',
      highlights: Array.isArray(e.highlights) ? e.highlights : []
    };
  })
  .filter(Boolean);

const byStart = (a, b) => b.start - a.start;
const liveAll = events.filter((e) => e.state === 'live');
const hero =
  [...liveAll].filter((e) => e.tier === 'main').sort(byStart)[0] ||
  [...liveAll].sort(byStart)[0] ||
  [...events].filter((e) => e.state === 'upcoming').sort((a, b) => a.start - b.start)[0] ||
  [...events].sort((a, b) => b.end - a.end)[0] ||
  null;

const rest = events.filter((e) => e !== hero);
const liveCards = rest.filter((e) => e.state === 'live').sort((a, b) => (a.end || 9e15) - (b.end || 9e15));
const upcomingCards = rest.filter((e) => e.state === 'upcoming').sort((a, b) => a.start - b.start);
const endedCards = rest.filter((e) => e.state === 'ended').sort((a, b) => b.end - a.end).slice(0, 9);
// Cards that start out hidden still render, so the clock can move them in when their time comes.
const endedPool = rest.filter((e) => e.state === 'ended').sort((a, b) => b.end - a.end);

/* ------------------------------------------------------------ drop timeline */
const accentOf = Object.fromEntries(events.map((e) => [e.id, e.accent || '#62d9ff']));
const timeline = (Array.isArray(FC.eventsTimeline) ? FC.eventsTimeline : [])
  .map((t) => ({ ...t, ms: Date.parse(t.utc) }))
  .filter((t) => Number.isFinite(t.ms))
  .sort((a, b) => a.ms - b.ms);
const nextDrop = timeline.find((t) => t.ms > now) || null;

/* -------------------------------------------------------------------- resets */
const rivals = FC.divisionRivalsReset ?? {};
const schedule = FC.schedule ?? {};
const rivalsAnchor = Date.parse(rivals.anchorUtc || '');
const rivalsCycle = Math.max(1, Number(rivals.cycleDays) || 28) * DAY;
const nextRivals = Number.isFinite(rivalsAnchor)
  ? now < rivalsAnchor ? rivalsAnchor : rivalsAnchor + (Math.floor((now - rivalsAnchor) / rivalsCycle) + 1) * rivalsCycle
  : NaN;
const [rh, rm] = String(schedule.dailyResetUtc || '01:00').split(':').map((n) => Number(n) || 0);
const nextDailyMs = (t) => {
  const d = new Date(t);
  const target = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), rh, rm);
  return t < target ? target : target + DAY;
};
const nextDaily = nextDailyMs(now);

/* --------------------------------------------------------------------- codes
   The homepage, Events hub and Redeem Codes page use one D1-backed live source. */

/* ------------------------------------------------------------------ coverage */
const allPosts = await getPosts();
const coverageSlugs = [
  'fc-mobile-unbreakable-2026-drafts',
  'fc-mobile-conmebol-libertadores-2026-coming-soon',
  'fc-mobile-27-stellar-libra-event',
  'fc-mobile-anniversary-week-4-final-week',
  'fc-mobile-hall-of-fut-explained'
];
const coverage = coverageSlugs.map((s) => allPosts.find((p) => p.slug === s)).filter(Boolean).slice(0, 4);

const alwaysOn = [
  { name: 'Daily Challenge', note: 'Resets daily', icon: '◷' },
  { name: 'Star Scout', note: 'Daily', icon: '★' },
  { name: 'Extra Time', note: 'Daily trivia & tokens', icon: '⏱', href: '/trivia/' },
  { name: 'Scouting Camp', note: 'Daily', icon: '◎' },
  { name: 'Hero Chronicles', note: 'Daily', icon: '⚔' },
  { name: 'Club Challenge', note: 'Daily', icon: '⚑' },
  { name: 'Weekend Challenge', note: 'Sat & Sun', icon: '✦' },
  { name: 'Football Centre', note: 'Weekly Showdowns', icon: '⚽', href: '/football-centre' },
  { name: 'Gauntlet Mode', note: 'Permanent PvE mode', icon: '⛨', href: '/gauntlet-planner' },
  { name: 'Zlatan & Beckham Chronicles', note: 'One-time quests', icon: '❖' }
];

const desc =
  'Live FC Mobile events and resets: Ballon d’Or, Unbreakable and CONMEBOL Libertadores countdowns, upcoming Draft drops, Division Rivals and daily reset timers, plus every recently ended event.';
const toSchema = (e) => ({
  '@type': 'Event',
  name: 'FC Mobile ' + e.title,
  description: e.summary,
  startDate: e.startUtc,
  ...(e.hasEnd ? { endDate: e.endUtc } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: { '@type': 'VirtualLocation', url: 'https://fcmobiletools.online/events/' }
});
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'FC Mobile Events & Reset Hub',
  description: desc,
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.online').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: events.filter((e) => e.state !== 'ended').map((e, i) => ({ '@type': 'ListItem', position: i + 1, item: toSchema(e) }))
  }
};

const heroPct = hero?.hasEnd ? hero.pct : 0;
const hp = hero?.hasEnd && hero.state === 'live' ? parts(hero.end - now) : hero?.state === 'upcoming' ? parts(hero.start - now) : { d: 0, h: 0, m: 0, s: 0 };
---
<BaseLayout title="FC Mobile Events & Reset Hub" description={desc}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="hub" style={hero ? '--hero:' + hero.accent : ''}>
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">

      <!-- ====================================================== PAGE HEAD -->
      <header class="head">
        <div>
          <p class="eyebrow"><i class="dot"></i> FC Mobile 27 · Event hub</p>
          <h1>Events &amp; resets</h1>
        </div>
        <div class="head-meta">
          <span class="chip"><i class="dot"></i><span id="syncLabel">Live clock</span></span>
          <span class="chip chip--tz" title="All times on this page are shown in your timezone">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span id="tzLabel">Your local time</span>
          </span>
        </div>
      </header>

      <!-- ============================================================ HERO -->
      {hero && (
        <section
          class="hero"
          id="top-event"
          data-ev
          data-hero
          data-id={hero.id}
          data-tn={hero.tn}
          data-start={hero.startUtc}
          data-end={hero.endUtc || ''}
          data-state={hero.state}
          aria-labelledby="hero-title"
        >
          {hero.banner && (
            <img
              class="hero-img"
              src={img(hero.banner, 1800)}
              alt=""
              width="1800"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.style.display='none'"
            />
          )}
          <div class="hero-shade"></div>
          <div class="hero-grain"></div>

          <div class="hero-body">
            <div class="hero-top">
              <span class="state" data-pill><i></i><span data-pill-text>{hero.state === 'live' ? 'Live now' : hero.state === 'upcoming' ? 'Starting soon' : 'Ended'}</span></span>
              <span class="hero-kicker">{hero.kicker}</span>
            </div>

            <h2 id="hero-title">{hero.title}</h2>
            <p class="hero-sum">{hero.summary}</p>

            <div class="cd" role="timer" aria-label="Countdown">
              <div class="cd-label" data-label>{hero.state === 'upcoming' ? 'Starts in' : hero.state === 'ended' ? 'Ended' : 'Ends in'}</div>
              <div class="cd-grid" data-cd>
                <div><b data-cd-d>{pad(hp.d)}</b><small>Days</small></div>
                <div><b data-cd-h>{pad(hp.h)}</b><small>Hours</small></div>
                <div><b data-cd-m>{pad(hp.m)}</b><small>Min</small></div>
                <div><b data-cd-s>{pad(hp.s)}</b><small>Sec</small></div>
              </div>
            </div>

            {hero.hasEnd && (
              <div class="hero-prog">
                <div class="hero-prog-top">
                  <span data-day>{hero.dayText}</span>
                  <span>
                    <time data-t={hero.startUtc} data-f="day">{hero.startLabel}</time>
                    <span aria-hidden="true"> → </span>
                    <time data-t={hero.endUtc} data-f="day">{hero.endLabel}</time>
                  </span>
                </div>
                <div class="hero-bar"><i data-bar style={'width:' + heroPct + '%'}></i></div>
              </div>
            )}

            <div class="hero-actions">
              <a class="hb hb-primary" href={hero.href}>{hero.hrefLabel || 'Latest news'} <span>→</span></a>
              {hero.guide && <a class="hb hb-ghost" href={hero.guide} target="_blank" rel="noopener noreferrer">{hero.guideLabel || 'Guide'} ↗</a>}
            </div>
          </div>

          {hero.highlights.length > 0 && (
            <aside class="hero-side" aria-label={hero.title + ' highlights'}>
              <p class="hero-side-h">What’s in it</p>
              <ul>
                {hero.highlights.slice(0, 4).map((h, i) => (
                  <li><b>{String(i + 1).padStart(2, '0')}</b><span>{h}</span></li>
                ))}
              </ul>
            </aside>
          )}
        </section>
      )}

      <!-- ======================================================= AT A GLANCE -->
      <section class="glance" aria-label="At a glance">
        <a class="tile" href="#resets">
          <small>Daily reset</small>
          <strong id="gDaily" role="timer">{clockText(nextDaily - now)}</strong>
          <em>{pad(rh)}:{pad(rm)} UTC · every day</em>
        </a>
        <a class="tile" href="#next-drops">
          <small>Next drop</small>
          <strong id="gDrop" role="timer">{nextDrop ? clockText(nextDrop.ms - now) : '—'}</strong>
          <em id="gDropLabel">{nextDrop ? nextDrop.label : 'Nothing scheduled yet'}</em>
        </a>
        <a class="tile" href="#resets">
          <small>Rivals reset</small>
          <strong id="gRivals" role="timer">{Number.isFinite(nextRivals) ? clockText(nextRivals - now) : '—'}</strong>
          <em id="gRivalsDate">{Number.isFinite(nextRivals) ? utcFmt(nextRivals) : ''}</em>
        </a>
        <a class="tile tile--codes" href="/redeem-codes/" data-fcmt-events-code-tile>
          <small>Redeem codes</small>
          <strong data-fcmt-code-count>Live status loading</strong>
          <em data-fcmt-code-latest>Open the full code list →</em>
        </a>
      </section>

      <!-- ========================================================= SUB NAV -->
      <nav class="subnav" aria-label="Page sections">
        <a href="#live" class="is-on">Live now</a>
        <a href="#next-drops">Next drops</a>
        <a href="#resets">Resets</a>
        <a href="#ended">Recently ended</a>
        <a href="#always-on">Always on</a>
        <a href="#coverage">News &amp; tools</a>
      </nav>

      <!-- =========================================================== LIVE -->
      <section class="section" id="live" aria-labelledby="live-h" data-bucket-section="live" hidden={liveCards.length === 0}>
        <div class="sec-head">
          <div><p class="eyebrow">Playable right now</p><h2 id="live-h">Also live</h2></div>
          <p class="sec-note">Everything running alongside the main event.</p>
        </div>
        <div class="grid grid--3" data-bucket="live">
          {liveCards.map((e) => <EventCard e={e} />)}
        </div>
      </section>

      <!-- ========================================================= UPCOMING -->
      <section class="section" id="upcoming" aria-labelledby="up-h" data-bucket-section="upcoming" hidden={upcomingCards.length === 0}>
        <div class="sec-head">
          <div><p class="eyebrow">On the way</p><h2 id="up-h">Coming up</h2></div>
        </div>
        <div class="grid grid--3" data-bucket="upcoming">
          {upcomingCards.map((e) => <EventCard e={e} />)}
        </div>
      </section>

      <!-- ====================================================== NEXT DROPS -->
      <section class="section" id="next-drops" aria-labelledby="drops-h">
        <div class="sec-head">
          <div><p class="eyebrow">Plan ahead</p><h2 id="drops-h">What drops next</h2></div>
          <p class="sec-note">Draft pools and deadlines, in your local time. <span class="tag tag--leak">Leaked</span> items come from community leakers and can change.</p>
        </div>

        <ol class="timeline" id="timeline">
          {timeline.map((t, i) => (
            <li
              class={'tl' + (t.kind === 'end' ? ' tl--end' : '') + (nextDrop && t === nextDrop ? ' is-next' : '')}
              data-utc={t.utc}
              hidden={t.ms <= now}
              style={'--acc:' + (accentOf[t.event] || '#62d9ff')}
            >
              <div class="tl-date">
                <time data-t={t.utc} data-f="dayShort">{utcFmt(t.ms)}</time>
                <small data-tl-count>{clockText(t.ms - now)}</small>
              </div>
              <div class="tl-dot" aria-hidden="true"></div>
              <div class="tl-card">
                <div class="tl-row">
                  <h3>{t.label}</h3>
                  {t.confidence === 'community' && <span class="tag tag--leak">Leaked</span>}
                  {t.kind === 'end' && <span class="tag tag--end">Deadline</span>}
                </div>
                <p>{t.detail}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="empty" id="timelineEmpty" hidden={timeline.some((t) => t.ms > now)}>No more scheduled drops. New ones appear here as soon as they’re announced.</p>
      </section>

      <!-- ============================================================ RESETS -->
      <section class="section" id="resets" aria-labelledby="reset-h">
        <div class="sec-head">
          <div><p class="eyebrow">Timing</p><h2 id="reset-h">Know the reset</h2></div>
        </div>

        <div class="grid grid--2">
          <article class="reset">
            <div class="reset-top">
              <div><small>Every day</small><h3>Daily reset</h3></div>
              <span class="reset-badge">{pad(rh)}:{pad(rm)} UTC</span>
            </div>
            <strong class="reset-count" id="dailyCountdown" role="timer">{clockText(nextDaily - now)}</strong>
            <div class="reset-times">
              <div><small>Your time</small><strong id="dailyLocal">—</strong></div>
              <div><small>UTC</small><strong id="dailyUtc">{utcFmt(nextDaily, true)}</strong></div>
            </div>
            <a href="/redeem-codes">Check Redeem Codes after reset →</a>
          </article>

          <article class="reset reset--hi">
            <div class="reset-top">
              <div><small>Every {Math.round(rivalsCycle / DAY)} days</small><h3>Division Rivals reset</h3></div>
              <span class="reset-badge">{Number.isFinite(nextRivals) ? utcFmt(nextRivals).replace(/^\w+, /, '') : '—'}</span>
            </div>
            <strong class="reset-count" id="rivalsCountdown" role="timer">{Number.isFinite(nextRivals) ? clockText(nextRivals - now) : '—'}</strong>
            <div class="reset-times">
              <div><small>Your time</small><strong id="rivalsLocal">—</strong></div>
              <div><small>UTC</small><strong id="rivalsUtc">{Number.isFinite(nextRivals) ? utcFmt(nextRivals, true) : '—'}</strong></div>
            </div>
            <a href="/team-ovr">Check Team OVR before reset →</a>
          </article>
        </div>
      </section>

      <!-- ============================================================ ENDED -->
      <section class="section" id="ended" aria-labelledby="end-h" data-bucket-section="ended" hidden={endedCards.length === 0}>
        <div class="sec-head">
          <div><p class="eyebrow">Archive</p><h2 id="end-h">Recently ended</h2></div>
          <p class="sec-note">Missed one? Guides and answers stay available.</p>
        </div>
        <div class="grid grid--3" data-bucket="ended">
          {endedPool.map((e, i) => <EventCard e={e} />)}
        </div>
      </section>

      <!-- ======================================================== ALWAYS ON -->
      <section class="section" id="always-on" aria-labelledby="on-h">
        <div class="sec-head">
          <div><p class="eyebrow">Never expires</p><h2 id="on-h">Always on</h2></div>
          <p class="sec-note">Daily, weekly and permanent activities that sit alongside every event.</p>
        </div>
        <ul class="evergreen">
          {alwaysOn.map((a) => (
            <li>
              {a.href ? <a href={a.href}><span class="eg-i" aria-hidden="true">{a.icon}</span><span><strong>{a.name}</strong><small>{a.note}</small></span><b aria-hidden="true">→</b></a>
                : <div><span class="eg-i" aria-hidden="true">{a.icon}</span><span><strong>{a.name}</strong><small>{a.note}</small></span></div>}
            </li>
          ))}
        </ul>
      </section>

      <!-- ========================================================= COVERAGE -->
      {coverage.length > 0 && (
        <section class="section" id="coverage" aria-labelledby="cov-h">
          <div class="sec-head">
            <div><p class="eyebrow">Connected coverage</p><h2 id="cov-h">Read the event. Then act on it.</h2></div>
            <a class="sec-link" href="/blog/">All articles →</a>
          </div>
          <div class="grid grid--4">
            {coverage.map((post) => (
              <a class="news" href={post.href}>
                <div class="news-media">
                  {post.cover ? (
                    <img src={img(post.cover, 700)} alt={post.imageAlt || post.title} loading="lazy" decoding="async" />
                  ) : (<span>FC MOBILE 27</span>)}
                </div>
                <div class="news-body">
                  <div><span>{post.section?.label || post.category || 'Article'}</span><small>{fmtDate(post.date, 'short')}</small></div>
                  <h3>{post.title}</h3>
                  <p>{post.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section" id="tools" aria-labelledby="tools-h">
        <div class="sec-head">
          <div><p class="eyebrow">Useful before you play</p><h2 id="tools-h">Tools that pair with events</h2></div>
        </div>
        <div class="tools">
          <a href="/team-ovr"><span>01</span><strong>Team OVR</strong><small>Check the XI</small></a>
          <a href="/rank-up-calculator"><span>02</span><strong>Rank Up Calculator</strong><small>Plan upgrade costs</small></a>
          <a href="/training-calculator"><span>03</span><strong>Training Calculator</strong><small>Plan XP &amp; fodder</small></a>
          <a href="/investment-calculator"><span>04</span><strong>Investment Calculator</strong><small>Run market maths</small></a>
          <a href="/gauntlet-planner"><span>05</span><strong>Gauntlet Planner</strong><small>Plan rotations</small></a>
        </div>
      </section>

      <p class="fine">
        Events switch over at the daily reset (01:00 UTC). Dates and rewards come from in-game calendars, EA announcements and
        community guides, and can change. Unreleased Draft pools are community leaks, not confirmed.
      </p>
    </div>
  </main>

