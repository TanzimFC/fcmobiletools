---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { NATIONS_STORY, NATIONS_STORY_QUESTION_COUNT } from '../data/aNationsStory.js';
import { getPosts, img, fmtDate, iso } from '../lib/blog.js';

const anniversary = FOOTBALL_CENTRE_CONTENT.eventCountdown ?? {};
const secondary = FOOTBALL_CENTRE_CONTENT.secondaryEvent ?? {};
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset ?? {};
const schedule = FOOTBALL_CENTRE_CONTENT.schedule ?? {};
const maintenanceGift = FOOTBALL_CENTRE_CONTENT.maintenanceGift?.enabled ? FOOTBALL_CENTRE_CONTENT.maintenanceGift : null;
const fcCycle = FOOTBALL_CENTRE_CONTENT.cycle ?? {};
const fcScoring = FOOTBALL_CENTRE_CONTENT.settings?.scoring ?? { played: 80, worldClass: 20, correctPrediction: 400 };
const upcomingEvents = Array.isArray(FOOTBALL_CENTRE_CONTENT.upcomingEvents) ? FOOTBALL_CENTRE_CONTENT.upcomingEvents : [];

const buildTime = Date.now();
const activeCodes = REDEEM_CODES.filter(
  (c) => c.status === 'active' && (!c.expiryDate || Date.parse(c.expiryDate + 'T23:59:59Z') > buildTime)
);
const featuredCode = activeCodes[0] ?? REDEEM_CODES[0] ?? null;

const allPosts = await getPosts();
const eventPosts = allPosts.slice(0, 6);

const cl = (url, w) => (url || '').replace('/image/upload/', `/image/upload/f_auto,q_auto,dpr_auto,w_${w}/`);
const banner = (id) => upcomingEvents.find((e) => e.id === id)?.banner || '';

const anniversaryBanner = cl(anniversary.banner || 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323719/fc-mobile-tools/qrtvtote0squixmcts6u.jpg', 1800);
const unbreakableBanner = cl(secondary.banner || 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323741/fc-mobile-tools/nql89jl6h2udu51cquje.jpg', 1000);
const anniversaryLogo = anniversary.logo || 'https://sappurit.github.io/s10img/png/2026-09-17/anniversary27_topup_ANNI27_LOGO.png';

// All upcoming events share one card design and one size, enriched with direct links to companion guides and tools.
const upcoming = [
  {
    id: 'unbreakable',
    dropGroup: 'oct-15',
    title: secondary.title || 'Unbreakable',
    text: secondary.subtitle || 'Major October event featuring dedicated Draft mechanics and high-OVR player pools.',
    focus: 'Draft Vouchers · Major Promo',
    day: '15',
    month: 'Oct',
    img: unbreakableBanner,
    acc: '#8b93ff',
    guideHref: '/blog/fc-mobile-unbreakable-2026-drafts/',
    guideLabel: 'Unbreakable & Drafts Guide',
    toolHref: '/redeem-codes',
    toolLabel: 'Claim Draft Vouchers',
  },
  {
    id: 'conmebol-libertadores',
    dropGroup: 'oct-15',
    title: 'CONMEBOL Libertadores',
    text: 'Starts on the same day as Unbreakable with South American club contenders and themed rewards.',
    focus: 'South American Clubs · Oct 15',
    day: '15',
    month: 'Oct',
    img: cl(banner('conmebol-libertadores'), 1000),
    acc: '#4fe3a3',
    guideHref: '/blog/fc-mobile-conmebol-libertadores-2026-coming-soon/',
    guideLabel: 'Libertadores 2026 Preview',
    toolHref: '/team-ovr',
    toolLabel: 'Plan Squad OVR',
  },
  {
    id: 'ballon-dor',
    dropGroup: 'oct-22',
    title: "Ballon d'Or",
    text: 'Launches alongside the October 22 Division Rivals Season Reset as a headline celebration.',
    focus: 'Season Reset Day · Oct 22',
    day: '22',
    month: 'Oct',
    img: cl(banner('ballon-dor'), 1000),
    acc: '#ffd36e',
    guideHref: '/blog/fc-mobile-27-everything-we-know-so-far/',
    guideLabel: 'Season 27 Roadmap',
    toolHref: '/investment-calculator',
    toolLabel: 'Market Tax Calculator',
  },
];

const dailyRoutine = [
  {
    id: 'codes',
    title: 'Check working Redeem Codes',
    detail: featuredCode ? `Active code ${featuredCode.code} (${featuredCode.reward})` : 'Check for new Draft Voucher & Rank Up codes',
    href: '/redeem-codes',
    cta: 'Redeem Codes',
  },
  {
    id: 'nations',
    title: "Complete A Nation's Story trivia",
    detail: `Search all ${NATIONS_STORY_QUESTION_COUNT} verified answers across Japan, Netherlands, Mexico, France & Brazil`,
    href: '/a-nations-story',
    cta: 'Answer Hub',
  },
  {
    id: 'centre',
    title: 'Lock in Football Centre Showdown picks',
    detail: `Earn +${fcScoring.played} played, +${fcScoring.worldClass} World Class & +${fcScoring.correctPrediction} correct pick toward 4,000 PTS`,
    href: '/football-centre/matches',
    cta: 'Showdowns',
  },
  {
    id: 'gauntlet',
    title: 'Plan Gauntlet Mode squad rotation',
    detail: 'Track 1-appearance goalkeepers and outfield appearance caps across rounds',
    href: '/gauntlet-planner',
    cta: 'Gauntlet Planner',
  },
  {
    id: 'ovr',
    title: 'Check Team OVR & Rank Up next step',
    detail: 'Find the cheapest Base OVR or Rank Up step before Division Rivals rewards lock',
    href: '/team-ovr',
    cta: 'Team OVR',
  },
];

const spotlightGuides = [
  {
    kicker: 'Stellar Series · Live Guide',
    title: 'Stellar Libra Event & Token Math',
    desc: 'How Stellar Libra works, token milestones, and optimal reward paths.',
    href: '/blog/fc-mobile-27-stellar-libra-event/',
    subHref: '/blog/stellar-libra-tokens-fc-mobile/',
    subLabel: 'Token Breakdown →',
  },
  {
    kicker: 'Draft Mechanics · Resource Guide',
    title: 'Stellar Draft Vouchers Explained',
    desc: 'Where to get Draft Vouchers and how they carry into upcoming October events.',
    href: '/blog/stellar-draft-voucher-fc-mobile/',
    subHref: '/blog/fc-mobile-unbreakable-2026-drafts/',
    subLabel: 'Unbreakable Drafts →',
  },
  {
    kicker: 'Numero Series · Weeks 1–3',
    title: 'FC Mobile Numero Event Tracker',
    desc: 'Complete breakdown of Numero Week 1 (No. 7), Week 2 (No. 4) and Week 3 (No. 10).',
    href: '/blog/fc-mobile-numero-week-3-number-10/',
    subHref: '/blog/fc-mobile-numero-week-2-number-4/',
    subLabel: 'Week 2 Recap →',
  },
  {
    kicker: 'Mechanics & Market Alert',
    title: 'Hall of FUT & Rare Removed Nations',
    desc: 'How Hall of FUT works and why 16 removed national teams could become rare collectibles.',
    href: '/blog/fc-mobile-hall-of-fut-explained/',
    subHref: '/blog/16-nations-removed-from-fc-mobile-27-international-player-cards-could-become-rare-collecti/',
    subLabel: '16 Nations Alert →',
  },
];

const prepToolkit = [
  {
    href: '/team-ovr',
    tag: 'Squad Rating',
    title: 'Team OVR Calculator',
    desc: 'Test how a new event player or Rank Up changes your 11-starter + bench average before spending resources.',
    cta: 'Open Team OVR',
  },
  {
    href: '/rank-up-calculator',
    tag: 'Base → Orange',
    title: 'Rank Up Calculator',
    desc: 'Plan your 1,333 maintenance gift Rank Up Points and compare step-by-step costs across OVR brackets.',
    cta: 'Plan Rank Ups',
  },
  {
    href: '/training-calculator',
    tag: 'Levels 1 → 30',
    title: 'Training Calculator',
    desc: 'Calculate exact XP, coins and fodder cards required before transferring or feeding trained players.',
    cta: 'Calculate XP',
  },
  {
    href: '/investment-calculator',
    tag: '10% Market Tax',
    title: 'Investment Calculator',
    desc: 'Model after-tax net return, ROI and break-even sell prices ahead of the Oct 15 and Oct 22 market shifts.',
    cta: 'Run Market Math',
  },
  {
    href: '/gauntlet-planner',
    tag: 'Squad Depth',
    title: 'Gauntlet Mode Planner',
    desc: 'Spread player appearance limits across escalating PvE rounds without running out of goalkeepers or starters.',
    cta: 'Build Rotation',
  },
  {
    href: '/fc-mobile-27',
    tag: 'Season 27 Hub',
    title: 'FC Mobile 27 Update Guide',
    desc: 'Review Game Plans, Mentalities, new PlayStyles, patch notes and the official Android installation path.',
    cta: 'Open Update Hub',
  },
];

const desc = 'FC Mobile event schedule and live hub covering 3rd Anniversary, Unbreakable, CONMEBOL Libertadores, Ballon d’Or, Daily Reset, Division Rivals reset, active trackers and guides.';
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events & Reset | FCMOBILETOOLS',
  description: desc,
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.online').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Events & Reset | FCMOBILETOOLS" description={desc}>
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<main class="hub">
  <div class="wrap">

    <!-- Breadcrumb & section quick-jump bar -->
    <div class="hub-nav-bar">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">FCMOBILETOOLS</a>
        <span aria-hidden="true">/</span>
        <span>Events &amp; Reset Hub</span>
      </nav>
      <nav class="jump-nav" aria-label="Page sections">
        <a href="#live-now">Live Event</a>
        <a href="#october-schedule">October Drops</a>
        <a href="#resets">Resets &amp; Routine</a>
        <a href="#event-trackers">Live Trackers</a>
        <a href="#event-guides">Event Guides</a>
        <a href="#event-toolkit">Squad Toolkit</a>
      </nav>
    </div>

    <header class="top">
      <div class="top-copy">
        <p class="tag"><i class="dot"></i>FC Mobile 27 · Events, resets &amp; live trackers</p>
        <h1>Every date that matters,<br />connected in one place.</h1>
        <p class="lede">Live events, the October drops, daily &amp; Division Rivals resets, and the companion trackers and guides you use to plan every reward.</p>
      </div>
      <div class="clock" aria-label="Current local and UTC time">
        <div><small>Your time</small><strong id="localClock">--:--:--</strong><em id="zoneLabel">Local</em></div>
        <div><small>UTC</small><strong id="utcClock">--:--:--</strong></div>
      </div>
    </header>

    <!-- At-a-glance interconnected status ribbon -->
    <section class="status-strip" aria-label="Live FC Mobile status at a glance">
      <a class="status-cell" href="#live-now">
        <small>Active Major Event</small>
        <strong>3rd Anniversary <span id="anniversaryElapsed">· Live</span></strong>
        <em>Season 27 launch event →</em>
      </a>
      <a class="status-cell" href="#october-schedule">
        <small>Next Major Drops</small>
        <strong>15 Oct · Double Launch</strong>
        <em>Unbreakable + Libertadores →</em>
      </a>
      <a class="status-cell" href="#resets">
        <small>Next Daily Reset (01:00 UTC)</small>
        <strong id="stripDailyCountdown">--:--:--</strong>
        <em>View reset routine →</em>
      </a>
      <div class="status-cell status-cell--code">
        <small>Active Redeem Code</small>
        {featuredCode ? (
          <div class="strip-code-row">
            <button type="button" class="strip-copy-btn" data-copy-code={featuredCode.code} aria-label={`Copy redeem code ${featuredCode.code}`}>
              <b>{featuredCode.code}</b>
              <span data-copy-label>Copy</span>
            </button>
            <a class="strip-code-link" href="/redeem-codes">All codes →</a>
          </div>
        ) : (
          <a class="strip-code-link" href="/redeem-codes">Check redeem codes →</a>
        )}
        <em>{featuredCode ? featuredCode.reward : 'Verified codes & EA link'}</em>
      </div>
    </section>

    <!-- LIVE HERO -->
    <section id="live-now" class="live-section" aria-label="Currently live major event">
      <article class="hero" id="anniversaryCard">
        <img id="anniversaryImage" class="hero-img" src={anniversaryBanner} alt="FC Mobile 3rd Anniversary" width="1800" height="800" loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" />
        <div class="hero-shade"></div>
        <div class="hero-body">
          <div class="hero-badges">
            <span class="badge live"><i class="dot"></i><span id="anniversaryState">LIVE NOW</span></span>
            <span class="hero-kicker-text">Season 27 · 4-Week Celebration</span>
          </div>
          <img id="anniversaryLogo" class="hero-logo" src={anniversaryLogo} alt="FC Mobile Anniversary 27 logo" decoding="async" referrerpolicy="no-referrer" />
          <h2>Anniversary Event</h2>
          <p id="anniversarySubtitle">Live alongside the FC Mobile 27 Season Update.</p>

          <div class="hero-actions">
            <a class="hero-btn hero-btn--primary" href="/fc-mobile-27">FC Mobile 27 Update Hub →</a>
            <a class="hero-btn hero-btn--ghost" href="/blog/fc-mobile-27-launch-third-anniversary/">Launch Guide</a>
            <a class="hero-btn hero-btn--ghost" href="/blog/fc-mobile-3rd-anniversary-leaked-player-pools-weeks-1-4/">Weeks 1–4 Player Pools</a>
          </div>

          <div class="hero-foot">
            <div><small>Started</small><strong id="anniversaryStart">24 Sep 2026</strong></div>
            <div><small>Active Code</small><strong><a href="/redeem-codes">{featuredCode ? featuredCode.code : 'Check Codes'}</a></strong></div>
            <div><small>Companion Mode</small><strong><a href="/gauntlet-planner">Gauntlet Planner</a></strong></div>
            <a class="ext-link" href="https://www.ea.com/games/ea-sports-fc/fc-mobile/news/3rd-anniversary" target="_blank" rel="noopener noreferrer">Read the EA announcement ↗</a>
          </div>
        </div>
      </article>

      {maintenanceGift && (
        <aside class="gift-bar" aria-label={maintenanceGift.title}>
          <div class="gift-bar__info">
            <span class="gift-kicker">Season 27 Bonus · Claimable In-Game</span>
            <h3>{maintenanceGift.title}</h3>
            <p>{maintenanceGift.note} Pair these rewards with active redeem codes to accelerate your squad upgrades.</p>
          </div>
          <ul class="gift-items" aria-label="Maintenance gift rewards">
            {(maintenanceGift.items ?? []).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="gift-links">
            <a href="/rank-up-calculator">Plan 1,333 Rank Up Points →</a>
            <a href="/redeem-codes">Claim Draft Vouchers →</a>
          </div>
        </aside>
      )}
    </section>

    <!-- UPCOMING: three equal cards with filter bar and internal guide/tool links -->
    <section class="block" id="october-schedule" aria-labelledby="upTitle">
      <div class="block-head">
        <div>
          <p class="sec-kicker">01 · Event Radar</p>
          <h2 id="upTitle">Coming in October</h2>
          <p>Three major launches across two key October dates, counted down in your local time zone.</p>
        </div>
        <div class="filter-tabs" role="group" aria-label="Filter October events">
          <button type="button" class="filter-btn is-active" data-event-filter="all">All Drops (3)</button>
          <button type="button" class="filter-btn" data-event-filter="oct-15">15 Oct Double Drop (2)</button>
          <button type="button" class="filter-btn" data-event-filter="oct-22">22 Oct Reset Drop (1)</button>
        </div>
      </div>

      <div class="cards">
        {upcoming.map((e) => (
          <article class="card" data-event-id={e.id} data-drop-group={e.dropGroup} style={`--acc:${e.acc}`}>
            <div class="card-media">
              {e.img && <img src={e.img} alt={e.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
              <div class="card-fade"></div>
              <div class="card-date"><b>{e.day}</b><span>{e.month}</span></div>
              <span class="badge soon" data-state>Upcoming</span>
            </div>
            <div class="card-body">
              <p class="card-focus">{e.focus}</p>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
              <div class="card-count">
                <div>
                  <small>Starts in</small>
                  <em class="card-local-time" data-local-start>15 Oct 2026 · UTC</em>
                </div>
                <strong data-countdown>--:--:--</strong>
              </div>
              <div class="card-links">
                <a class="card-link card-link--primary" href={e.guideHref}>{e.guideLabel} →</a>
                <a class="card-link card-link--sub" href={e.toolHref}>{e.toolLabel} ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- RESETS & DAILY ROUTINE CHECKLIST -->
    <section class="block" id="resets" aria-labelledby="rsTitle">
      <div class="block-head">
        <div>
          <p class="sec-kicker">02 · Timers &amp; Cycles</p>
          <h2 id="rsTitle">Resets &amp; Daily Routine</h2>
          <p>Track the daily 01:00 UTC refresh and the 28-day Division Rivals season cycle.</p>
        </div>
        <p id="syncLabel" class="sync">Syncing…</p>
      </div>

      <div class="resets">
        <article class="reset">
          <div class="reset-top">
            <h3>Daily reset</h3>
            <span>Every day · 01:00 UTC</span>
          </div>
          <strong class="big" id="dailyCountdown">--:--:--</strong>
          <div class="cycle-bar" aria-hidden="true"><span id="dailyProgressBar"></span></div>
          <dl>
            <div><dt>Your time</dt><dd id="dailyLocal">—</dd></div>
            <div><dt>UTC</dt><dd id="dailyUtc">—</dd></div>
          </dl>
          <div class="reset-links">
            <span>Check after reset:</span>
            <a href="/redeem-codes">Redeem Codes</a>
            <span aria-hidden="true">·</span>
            <a href="/a-nations-story">A Nation's Story</a>
            <span aria-hidden="true">·</span>
            <a href="/gauntlet-planner">Gauntlet Planner</a>
          </div>
        </article>

        <article class="reset accent">
          <div class="reset-top">
            <h3>Division Rivals · Season reset</h3>
            <span>22 Oct · 28-day cycle</span>
          </div>
          <strong class="big" id="rivalsCountdown">--:--:--</strong>
          <div class="cycle-bar" aria-hidden="true"><span id="rivalsProgressBar"></span></div>
          <dl>
            <div><dt>Your time</dt><dd id="rivalsLocal">22 Oct 2026</dd></div>
            <div><dt>UTC</dt><dd id="rivalsUtc">22 Oct 2026 · 01:00 UTC</dd></div>
          </dl>
          <div class="reset-links">
            <span>Prepare before reset:</span>
            <a href="/team-ovr">Team OVR</a>
            <span aria-hidden="true">·</span>
            <a href="/rank-up-calculator">Rank Up Calc</a>
            <span aria-hidden="true">·</span>
            <a href="/training-calculator">Training Calc</a>
          </div>
        </article>
      </div>

      <!-- Interactive Daily Reset Routine Checklist -->
      <div class="routine-panel" data-routine-panel>
        <div class="routine-head">
          <div>
            <span class="sec-kicker">Interactive Checklist · Saved in Browser</span>
            <h3>Your Daily FC Mobile Reset Checklist</h3>
            <p>Check off your daily priorities and jump straight to the matching tool. Automatically resets at 01:00 UTC.</p>
          </div>
          <div class="routine-actions">
            <span class="routine-progress" id="routineProgressLabel">0 / {dailyRoutine.length} done</span>
            <button type="button" class="routine-reset-btn" id="routineResetBtn">Reset checklist</button>
          </div>
        </div>
        <ul class="routine-list">
          {dailyRoutine.map((item) => (
            <li class="routine-row" data-routine-item={item.id}>
              <label class="routine-check">
                <input type="checkbox" data-routine-checkbox={item.id} />
                <span class="routine-text">
                  <strong>{item.title}</strong>
                  <small>{item.detail}</small>
                </span>
              </label>
              <a class="routine-link" href={item.href}>{item.cta} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ACTIVE IN-GAME EVENT TRACKERS & HUBS -->
    <section class="block" id="event-trackers" aria-labelledby="trTitle">
      <div class="block-head">
        <div>
          <p class="sec-kicker">03 · Interactive Event Hubs</p>
          <h2 id="trTitle">Active In-Game Event Trackers</h2>
          <p>Dedicated tools built for the events running inside FC Mobile right now.</p>
        </div>
      </div>

      <div class="trackers-grid">
        <!-- Football Centre Hub Card -->
        <article class="tracker-card tracker-card--cyan">
          <div class="tracker-top">
            <span class="sec-kicker">{fcCycle.label || 'SEPTEMBER 2026 · ACTIVE CYCLE'}</span>
            <span class="tracker-meta">8 Showdowns · 4,000 PTS Target</span>
          </div>
          <h3>Football Centre Hub</h3>
          <p>{fcCycle.description || 'Track weekly Showdown predictions, real match results, points balance and reward claims in one place.'}</p>

          <div class="tracker-stats">
            <div><small>Played Match</small><strong>+{fcScoring.played} PTS</strong></div>
            <div><small>World Class</small><strong>+{fcScoring.worldClass} PTS</strong></div>
            <div><small>Correct Pick</small><strong>+{fcScoring.correctPrediction} PTS</strong></div>
            <div><small>Top Reward</small><strong>120–122 OVR</strong></div>
          </div>

          <nav class="tracker-sublinks" aria-label="Football Centre sections">
            <a class="primary-sublink" href="/football-centre">Open Overview →</a>
            <a href="/football-centre/matches">Matches (8)</a>
            <a href="/football-centre/rewards">Rewards</a>
            <a href="/football-centre/analysis">Analysis</a>
            <a href="/football-centre/totw">TOTW Status</a>
          </nav>
        </article>

        <!-- A Nation's Story Answer Hub Card -->
        <article class="tracker-card tracker-card--gold">
          <div class="tracker-top">
            <span class="sec-kicker">CHRONICLES · TRIVIA DATABASE</span>
            <span class="tracker-meta">{NATIONS_STORY.length} Nations · {NATIONS_STORY_QUESTION_COUNT} Answers</span>
          </div>
          <h3>A Nation's Story Answer Finder</h3>
          <p>Every Day 1 to Day 9 trivia question and verified answer for Japan, Netherlands, Mexico, France and Brazil.</p>

          <form class="nation-quick-search" action="/a-nations-story" method="get" data-nation-jump-form>
            <label class="sr-only" for="eventsNationQuery">Search A Nation's Story question</label>
            <input id="eventsNationQuery" type="search" placeholder="Type a player, year or country (e.g. Zidane, 2022, Pelé)…" autocomplete="off" />
            <button type="submit">Find Answer →</button>
          </form>

          <nav class="nation-pills" aria-label="A Nation's Story countries">
            {NATIONS_STORY.map((n) => (
              <a href={`/a-nations-story/${n.slug}/`}>
                <span>{n.flag}</span>
                <b>{n.name}</b>
                <small>9 days</small>
              </a>
            ))}
          </nav>
        </article>
      </div>

      <!-- Active Side-Events & Mechanics Spotlight -->
      <div class="spotlight-grid">
        {spotlightGuides.map((g) => (
          <article class="spotlight-card">
            <span class="sec-kicker">{g.kicker}</span>
            <h3><a href={g.href}>{g.title}</a></h3>
            <p>{g.desc}</p>
            <div class="spotlight-links">
              <a class="spot-primary" href={g.href}>Read guide →</a>
              <a class="spot-sub" href={g.subHref}>{g.subLabel}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- EVENT GUIDES, LEAKS & SEASON 27 COVERAGE -->
    <section class="block" id="event-guides" aria-labelledby="gdTitle">
      <div class="block-head">
        <div>
          <p class="sec-kicker">04 · Editorial Desk</p>
          <h2 id="gdTitle">Event Guides, Leaks &amp; Update Coverage</h2>
          <p>Deep dives, leaked player pools, token math and patch breakdowns connected to current events.</p>
        </div>
