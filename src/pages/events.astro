  <script>import '../scripts/current-redeem-code.js';</script>

  <script define:vars={{ rivalsAnchorUtc: rivals.anchorUtc, rivalsCycleDays: rivals.cycleDays, dailyResetUtc: schedule.dailyResetUtc || '01:00' }}>
  (() => {
    const DAY = 864e5;
    const $ = (id) => document.getElementById(id);
    const set = (id, v) => { const n = $(id); if (n && n.textContent !== v) n.textContent = v; };
    const pad = (v) => String(Math.max(0, Math.floor(Number(v) || 0))).padStart(2, '0');
    const split = (ms) => {
      let s = Math.max(0, Math.floor(ms / 1000));
      const d = Math.floor(s / 86400); s %= 86400;
      const h = Math.floor(s / 3600); s %= 3600;
      const m = Math.floor(s / 60);
      return { d, h, m, s: s % 60 };
    };
    const clock = (ms) => { const p = split(ms); return (p.d > 0 ? p.d + 'd ' : '') + pad(p.h) + ':' + pad(p.m) + ':' + pad(p.s); };
    const norm = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');

    const F = {
      day: new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short' }),
      dayShort: new Intl.DateTimeFormat(undefined, { weekday: 'short', day: 'numeric', month: 'short' }),
      full: new Intl.DateTimeFormat(undefined, { weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })
    };
    const UTC = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
    const UTCDAY = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short' });

    let tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch {}
    if (tz) set('tzLabel', tz.replace(/_/g, ' '));

    const cfg = {
      rivalsAnchor: Date.parse(rivalsAnchorUtc || ''),
      rivalsCycle: (Number(rivalsCycleDays) || 28) * DAY,
      dailyReset: String(dailyResetUtc || '01:00')
    };

    const nextDaily = (now) => {
      const p = cfg.dailyReset.split(':').map(Number);
      const h = Number.isFinite(p[0]) ? p[0] : 1, m = Number.isFinite(p[1]) ? p[1] : 0;
      const d = new Date(now);
      const t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m);
      return now < t ? t : t + DAY;
    };
    const nextRivals = (now) => {
      if (!Number.isFinite(cfg.rivalsAnchor)) return NaN;
      return now < cfg.rivalsAnchor ? cfg.rivalsAnchor : cfg.rivalsAnchor + (Math.floor((now - cfg.rivalsAnchor) / cfg.rivalsCycle) + 1) * cfg.rivalsCycle;
    };

    /* local-time labels (re-run whenever dates change) */
    const localize = () => {
      document.querySelectorAll('time[data-t]').forEach((t) => {
        const ms = Date.parse(t.getAttribute('data-t'));
        if (!Number.isFinite(ms)) return;
        const f = F[t.getAttribute('data-f')] || F.day;
        t.textContent = f.format(ms);
        t.setAttribute('datetime', new Date(ms).toISOString());
      });
    };

    const buckets = {};
    document.querySelectorAll('[data-bucket]').forEach((b) => { buckets[b.getAttribute('data-bucket')] = b; });
    const sections = {};
    document.querySelectorAll('[data-bucket-section]').forEach((s) => { sections[s.getAttribute('data-bucket-section')] = s; });

    const PILL = { live: 'Live', upcoming: 'Upcoming', ended: 'Ended' };
    const HERO_PILL = { live: 'Live now', upcoming: 'Starting soon', ended: 'Ended' };

    const renderEvent = (el, now) => {
      const start = Date.parse(el.getAttribute('data-start'));
      const endRaw = el.getAttribute('data-end');
      const end = endRaw ? Date.parse(endRaw) : NaN;
      if (!Number.isFinite(start)) return;
      const hasEnd = Number.isFinite(end);
      const state = now < start ? 'upcoming' : hasEnd && now >= end ? 'ended' : 'live';
      const isHero = el.hasAttribute('data-hero');
      if (el.getAttribute('data-state') !== state) {
        el.setAttribute('data-state', state);
        const pill = el.querySelector('[data-pill-text]');
        if (pill) pill.textContent = (isHero ? HERO_PILL : PILL)[state];
        if (!isHero && buckets[state] && el.parentElement !== buckets[state]) {
          // keep each bucket sorted the way the server sorts it
          const kids = [...buckets[state].children];
          const key = (n) => state === 'ended' ? -Date.parse(n.getAttribute('data-end') || 0) : state === 'upcoming' ? Date.parse(n.getAttribute('data-start')) : (Date.parse(n.getAttribute('data-end')) || 9e15);
          const mine = key(el);
          const before = kids.find((k) => key(k) > mine);
          buckets[state].insertBefore(el, before || null);
        }
      }
      const total = hasEnd ? Math.max(1, Math.round((end - start) / DAY)) : 0;
      const label = el.querySelector('[data-label]');
      const clk = el.querySelector('[data-clock]');
      const day = el.querySelector('[data-day]');
      const bar = el.querySelector('[data-bar]');
      let lab = 'Ends in', txt = hasEnd ? clock(end - now) : 'Ongoing', dtxt = '';
      if (state === 'upcoming') { lab = 'Starts in'; txt = clock(start - now); dtxt = UTCDAY.format(start); }
      else if (state === 'ended') { lab = 'Ended'; txt = F.day.format(end); dtxt = total ? total + '-day event' : ''; }
      else { dtxt = hasEnd ? 'Day ' + Math.min(total, Math.floor((now - start) / DAY) + 1) + ' of ' + total : 'No end date'; }
      if (label) label.textContent = lab;
      if (clk) clk.textContent = txt;
      if (day) day.textContent = dtxt;
      if (bar && hasEnd) bar.style.width = Math.min(100, Math.max(0, ((now - start) / (end - start)) * 100)).toFixed(2) + '%';
      if (isHero) {
        const ms = state === 'upcoming' ? start - now : state === 'live' && hasEnd ? end - now : 0;
        const p = split(ms);
        const q = (s) => el.querySelector(s);
        const set2 = (s, v) => { const n = q(s); if (n && n.textContent !== v) n.textContent = v; };
        set2('[data-cd-d]', pad(p.d)); set2('[data-cd-h]', pad(p.h)); set2('[data-cd-m]', pad(p.m)); set2('[data-cd-s]', pad(p.s));
        el.querySelector('[data-cd]')?.classList.toggle('is-urgent', state === 'live' && hasEnd && ms < DAY);
      }
    };

    const tidySections = () => {
      Object.entries(sections).forEach(([k, s]) => { s.hidden = !(buckets[k] && buckets[k].children.length); });
    };

    const renderTimeline = (now) => {
      const rows = [...document.querySelectorAll('#timeline .tl')];
      let first = null;
      rows.forEach((r) => {
        const ms = Date.parse(r.getAttribute('data-utc'));
        const past = ms <= now;
        if (r.hidden !== past) r.hidden = past;
        r.classList.remove('is-next');
        if (!past && !first) first = r;
        const c = r.querySelector('[data-tl-count]');
        if (c && !past) c.textContent = clock(ms - now);
      });
      if (first) {
        first.classList.add('is-next');
        const ms = Date.parse(first.getAttribute('data-utc'));
        set('gDrop', clock(ms - now));
        set('gDropLabel', first.querySelector('h3')?.textContent || '');
      } else {
        set('gDrop', '—');
        set('gDropLabel', 'Nothing scheduled yet');
      }
      const empty = $('timelineEmpty');
      if (empty) empty.hidden = !!first;
    };

    const render = () => {
      const now = Date.now();
      document.querySelectorAll('[data-ev]').forEach((el) => renderEvent(el, now));
      tidySections();
      renderTimeline(now);

      const d = nextDaily(now);
      set('dailyCountdown', clock(d - now)); set('gDaily', clock(d - now));
      set('dailyLocal', F.full.format(d)); set('dailyUtc', UTC.format(d));

      const r = nextRivals(now);
      if (Number.isFinite(r)) {
        set('rivalsCountdown', clock(r - now)); set('gRivals', clock(r - now));
        set('rivalsLocal', F.full.format(r)); set('rivalsUtc', UTC.format(r));
        set('gRivalsDate', F.dayShort.format(r));
      }
    };

    /* pick up admin changes (start times, banners, resets) without a rebuild */
    const sync = async () => {
      try {
        const res = await fetch('/api/football?live=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
        if (!res.ok) throw new Error('sync');
        const c = (await res.json())?.content || {};
        const legacy = [c.eventCountdown?.enabled ? c.eventCountdown : null, c.secondaryEvent?.enabled ? c.secondaryEvent : null, ...(Array.isArray(c.upcomingEvents) ? c.upcomingEvents : [])].filter((l) => l && l.title && l.startUtc);
        legacy.forEach((l) => {
          const el = document.querySelector('[data-ev][data-tn="' + norm(l.title) + '"]');
          if (!el) return;
          el.setAttribute('data-start', l.startUtc);
          el.querySelectorAll('time[data-t]').forEach((t, i) => { if (i === 0) t.setAttribute('data-t', l.startUtc); });
          const im = el.querySelector('img');
          if (l.banner && im && !im.src.includes(l.banner.split('/upload/')[1] || '@@')) {
            im.src = l.banner.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_' + (el.hasAttribute('data-hero') ? 1800 : 900) + '/');
          }
        });
        const dr = c.divisionRivalsReset;
        if (dr) {
          cfg.rivalsAnchor = Date.parse(dr.anchorUtc || '') || cfg.rivalsAnchor;
          cfg.rivalsCycle = (Number(dr.cycleDays) || 28) * DAY;
        }
        if (c.schedule?.dailyResetUtc) cfg.dailyReset = c.schedule.dailyResetUtc;
        set('syncLabel', 'Live · synced');
      } catch {
        set('syncLabel', 'Live · auto clock');
      }
      localize();
      render();
    };

    /* section nav: highlight the last section that has passed the reading line */
    const links = [...document.querySelectorAll('.subnav a')];
    const spy = links.map((a) => ({ a, t: document.querySelector(a.getAttribute('href')) })).filter((x) => x.t);
    let spyBusy = false, spyCurrent = null;
    const runSpy = () => {
      spyBusy = false;
      const line = innerHeight * 0.4;
      let cur = spy[0];
      spy.forEach((x) => { if (!x.t.hidden && x.t.getBoundingClientRect().top <= line) cur = x; });
      if (!cur || cur === spyCurrent) return;
      spyCurrent = cur;
      links.forEach((a) => a.classList.toggle('is-on', a === cur.a));
      const bar = cur.a.parentElement;
      if (bar && bar.scrollWidth > bar.clientWidth) bar.scrollTo({ left: cur.a.offsetLeft - 16, behavior: 'smooth' });
    };
    const onScroll = () => { if (!spyBusy) { spyBusy = true; requestAnimationFrame(runSpy); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    runSpy();

    localize();
    render();
    sync();
    setInterval(render, 1000);
    setInterval(sync, 30000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); sync(); } });
  })();
  </script>

