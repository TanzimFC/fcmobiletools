---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { getPosts, img, fmtDate } from '../lib/blog.js';

const anniversary = FOOTBALL_CENTRE_CONTENT.eventCountdown ?? {};
const secondary = FOOTBALL_CENTRE_CONTENT.secondaryEvent ?? {};
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset ?? {};
const schedule = FOOTBALL_CENTRE_CONTENT.schedule ?? {};
const maintenanceGift = FOOTBALL_CENTRE_CONTENT.maintenanceGift?.enabled
  ? FOOTBALL_CENTRE_CONTENT.maintenanceGift
  : null;
const upcomingEvents = Array.isArray(FOOTBALL_CENTRE_CONTENT.upcomingEvents)
  ? FOOTBALL_CENTRE_CONTENT.upcomingEvents
  : [];

const buildTime = Date.now();
const activeCodes = REDEEM_CODES.filter(
  (code) =>
    code.status === 'active' &&
    (!code.expiryDate || Date.parse(code.expiryDate + 'T23:59:59Z') > buildTime)
);
const featuredCode = activeCodes[0] ?? null;

const allPosts = await getPosts();
const eventPostSlugs = [
  'fc-mobile-unbreakable-2026-drafts',
  'fc-mobile-conmebol-libertadores-2026-coming-soon',
  'fc-mobile-hall-of-fut-explained',
  'fc-mobile-3rd-anniversary-leaked-player-pools-weeks-1-4'
];
const eventPosts = eventPostSlugs
  .map((slug) => allPosts.find((post) => post.slug === slug))
  .filter(Boolean);

const cl = (url, width) =>
  (url || '').replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_' + width + '/');

const banner = (id) => upcomingEvents.find((event) => event.id === id)?.banner || '';

const anniversaryBanner = cl(
  anniversary.banner ||
    'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323719/fc-mobile-tools/qrtvtote0squixmcts6u.jpg',
  1800
);
const unbreakableBanner = cl(
  secondary.banner ||
    'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323741/fc-mobile-tools/nql89jl6h2udu51cquje.jpg',
  1000
);
const anniversaryLogo =
  anniversary.logo ||
  'https://sappurit.github.io/s10img/png/2026-09-17/anniversary27_topup_ANNI27_LOGO.png';

const upcoming = [
  {
    id: 'unbreakable',
    title: secondary.title || 'Unbreakable',
    text: 'Expected October 15. The first reported Draft pools are already being covered on the site.',
    day: '15',
    month: 'Oct',
    img: unbreakableBanner,
    acc: '#9b8cff',
    href: '/blog/fc-mobile-unbreakable-2026-drafts/',
    label: 'Unbreakable leaks'
  },
  {
    id: 'conmebol-libertadores',
    title: 'CONMEBOL Libertadores',
    text: 'Expected October 15 alongside Unbreakable, with reported Draft pools and more coverage to come.',
    day: '15',
    month: 'Oct',
    img: cl(banner('conmebol-libertadores'), 1000),
    acc: '#58dca8',
    href: '/blog/fc-mobile-conmebol-libertadores-2026-coming-soon/',
    label: 'Libertadores preview'
  },
  {
    id: 'ballon-dor',
    title: "Ballon d'Or",
    text: 'Expected October 22, on the same date as the next Division Rivals season reset.',
    day: '22',
    month: 'Oct',
    img: cl(banner('ballon-dor'), 1000),
    acc: '#ffd56f',
    href: '/blog/',
    label: 'Latest event news'
  }
];

const desc =
  'FC Mobile events and reset hub with live event timing, October event countdowns, Division Rivals reset timing and connected event coverage.';
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events & Reset',
  description: desc,
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.online').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' }
};
---
<BaseLayout title="FC Mobile Events & Reset" description={desc}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  <main class="hub">
    <div class="wrap">
      <div class="crumb">
        <a href="/">FCMOBILETOOLS</a>
        <span>/</span>
        <strong>Events</strong>
      </div>

      <header class="page-head">
        <div>
          <p class="eyebrow"><i class="dot"></i> FC Mobile 27 · Event hub</p>
          <h1>What’s live.<br />What’s next.</h1>
          <p class="lede">
            Live event timing, the next major drops and reset dates, with the guides and tools
            you actually use around them.
          </p>
        </div>

        <div class="head-links" aria-label="Event shortcuts">
          <a href="/redeem-codes">Redeem Codes <span>→</span></a>
          <a href="/football-centre">Football Centre <span>→</span></a>
        </div>
      </header>

      <section class="hero" id="live-now" aria-labelledby="live-title">
        <img
          class="hero-img"
          id="anniversaryImage"
          src={anniversaryBanner}
          alt="FC Mobile 3rd Anniversary"
          width="1800"
          height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <div class="hero-shade"></div>

        <div class="hero-body">
          <div class="hero-topline">
            <span class="badge live"><i class="dot"></i><span id="anniversaryState">LIVE NOW</span></span>
            <span>Season 27 · Third Anniversary</span>
          </div>

          <img
            class="hero-logo"
            id="anniversaryLogo"
            src={anniversaryLogo}
            alt="FC Mobile Anniversary 27"
            decoding="async"
            referrerpolicy="no-referrer"
          />

          <h2 id="live-title">Anniversary Event</h2>
          <p id="anniversarySubtitle">
            Live alongside the FC Mobile 27 Season Update.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="/blog/fc-mobile-3rd-anniversary-leaked-player-pools-weeks-1-4/">
              Anniversary player pools <span>→</span>
            </a>
            <a class="btn btn-ghost" href="/fc-mobile-27">Season 27 hub</a>
          </div>

          <div class="hero-meta">
            <div>
              <small>Started</small>
              <strong id="anniversaryStart">24 Sep 2026</strong>
            </div>
            <div>
              <small>Latest code</small>
              <strong>
                <a href="/redeem-codes">{featuredCode?.code || 'Check codes'}</a>
              </strong>
            </div>
            <a
              class="official"
              href="https://www.ea.com/games/ea-sports-fc/fc-mobile/news/3rd-anniversary"
              target="_blank"
              rel="noopener noreferrer"
            >EA announcement ↗</a>
          </div>
        </div>
      </section>

      {maintenanceGift && (
        <aside class="gift">
          <div>
            <span class="gift-kicker">Season 27 bonus</span>
            <strong>{maintenanceGift.title}</strong>
            <p>{maintenanceGift.note}</p>
          </div>
          <div class="gift-items">
            {(maintenanceGift.items ?? []).map((item) => <span>{item}</span>)}
          </div>
          <div class="gift-actions">
            <a href="/rank-up-calculator">Plan Rank Up Points →</a>
            <a href="/redeem-codes">Check codes →</a>
          </div>
        </aside>
      )}

      <section class="section" id="october" aria-labelledby="oct-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Next up</p>
            <h2 id="oct-title">October events</h2>
          </div>
          <p>Counted down in your local time.</p>
        </div>

        <div class="event-grid">
          {upcoming.map((event) => (
            <article
              class="event-card"
              data-event-id={event.id}
              style={'--acc:' + event.acc}
            >
              <div class="event-media">
                {event.img && (
                  <img
                    src={event.img}
                    alt={event.title}
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                )}
                <div class="event-fade"></div>
                <div class="event-date">
                  <b>{event.day}</b>
                  <span>{event.month}</span>
                </div>
                <span class="event-state" data-state>Upcoming</span>
              </div>

              <div class="event-body">
                <h3>{event.title}</h3>
                <p>{event.text}</p>

                <div class="event-count">
                  <div>
                    <small>Starts in</small>
                    <em data-local-start>15 Oct 2026</em>
                  </div>
                  <strong data-countdown>--:--:--</strong>
                </div>

                <a class="event-link" href={event.href}>
                  {event.label} <span>→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section reset-section" id="resets" aria-labelledby="reset-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Timing</p>
            <h2 id="reset-title">Know the reset</h2>
          </div>
          <span class="sync" id="syncLabel">Syncing…</span>
        </div>

        <div class="reset-grid">
          <article class="reset-card">
            <div class="reset-top">
              <div>
                <small>Every day</small>
                <h3>Daily reset</h3>
              </div>
              <span>01:00 UTC</span>
            </div>
            <strong class="reset-count" id="dailyCountdown">--:--:--</strong>
            <div class="reset-times">
              <div><small>Your time</small><strong id="dailyLocal">—</strong></div>
              <div><small>UTC</small><strong id="dailyUtc">—</strong></div>
            </div>
            <a href="/redeem-codes">Check Redeem Codes after reset →</a>
          </article>

          <article class="reset-card reset-card--featured">
            <div class="reset-top">
              <div>
                <small>Next season cycle</small>
                <h3>Division Rivals reset</h3>
              </div>
              <span>22 Oct</span>
            </div>
            <strong class="reset-count" id="rivalsCountdown">--:--:--</strong>
            <div class="reset-times">
              <div><small>Your time</small><strong id="rivalsLocal">22 Oct 2026</strong></div>
              <div><small>UTC</small><strong id="rivalsUtc">22 Oct 2026 · 01:00 UTC</strong></div>
            </div>
            <a href="/team-ovr">Check Team OVR before reset →</a>
          </article>
        </div>
      </section>

      {eventPosts.length > 0 && (
        <section class="section coverage" id="coverage" aria-labelledby="coverage-title">
          <div class="section-head">
            <div>
              <p class="eyebrow">Connected coverage</p>
              <h2 id="coverage-title">Read the event. Then act on it.</h2>
            </div>
            <a class="section-link" href="/blog/">All articles →</a>
          </div>

          <div class="coverage-grid">
            {eventPosts.map((post) => (
              <a class="coverage-card" href={post.href}>
                <div class="coverage-media">
                  {post.cover ? (
                    <img
                      src={img(post.cover, 700)}
                      alt={post.imageAlt || post.title}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span>FC MOBILE 27</span>
                  )}
                </div>
                <div class="coverage-body">
                  <div>
                    <span>{post.section?.label || post.category || 'Article'}</span>
                    <small>{fmtDate(post.date, 'short')}</small>
                  </div>
                  <h3>{post.title}</h3>
                  <p>{post.excerpt}</p>
                  <strong>Read article →</strong>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section tools" id="tools" aria-labelledby="tools-title">
        <div class="section-head">
          <div>
            <p class="eyebrow">Useful before you play</p>
            <h2 id="tools-title">The tools that pair with events</h2>
          </div>
        </div>

        <div class="tool-links">
          <a href="/team-ovr"><span>01</span><strong>Team OVR</strong><small>Check the XI</small><b>→</b></a>
          <a href="/rank-up-calculator"><span>02</span><strong>Rank Up Calculator</strong><small>Plan upgrade costs</small><b>→</b></a>
          <a href="/training-calculator"><span>03</span><strong>Training Calculator</strong><small>Plan XP & fodder</small><b>→</b></a>
          <a href="/investment-calculator"><span>04</span><strong>Investment Calculator</strong><small>Run market maths</small><b>→</b></a>
          <a href="/gauntlet-planner"><span>05</span><strong>Gauntlet Planner</strong><small>Plan rotations</small><b>→</b></a>
        </div>
      </section>
    </div>
  </main>

  <script define:vars={{
    anniversaryStartUtc: anniversary.startUtc,
    anniversarySubtitle: anniversary.subtitle,
    unbreakableStartUtc: secondary.startUtc,
    rivalsAnchorUtc: rivals.anchorUtc,
    rivalsCycleDays: rivals.cycleDays,
    dailyResetUtc: schedule.dailyResetUtc || '01:00',
    upcomingEventsData: upcomingEvents
  }}>
  (() => {
    const $ = (id) => document.getElementById(id);
    const set = (id, value) => {
      const node = $(id);
      if (node) node.textContent = value;
    };

    const DAY = 86400000;
    const pad = (value) => String(Math.max(0, Math.floor(Number(value) || 0))).padStart(2, '0');

    const formatCountdown = (ms) => {
      let total = Math.max(0, Math.floor(ms / 1000));
      const days = Math.floor(total / 86400);
      total %= 86400;
      const hours = Math.floor(total / 3600);
      total %= 3600;
      const minutes = Math.floor(total / 60);
      const seconds = total % 60;
      return (days > 0 ? days + 'd ' : '') + pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
    };

    const localDate = new Intl.DateTimeFormat(undefined, {
      weekday: 'short',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short'
    });

    const utcDate = new Intl.DateTimeFormat('en-GB', {
      weekday: 'short',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'UTC',
      timeZoneName: 'short'
    });

    let cfg = {
      anniversaryStartUtc,
      anniversarySubtitle,
      unbreakableStartUtc,
      rivalsAnchorUtc,
      rivalsCycleDays: Number(rivalsCycleDays) || 28,
      dailyResetUtc,
      upcomingEvents: Array.isArray(upcomingEventsData) ? upcomingEventsData : []
    };

    const nextDaily = (now) => {
      const parts = String(cfg.dailyResetUtc || '01:00').split(':').map(Number);
      const hour = Number.isFinite(parts[0]) ? Math.max(0, Math.min(23, parts[0])) : 1;
      const minute = Number.isFinite(parts[1]) ? Math.max(0, Math.min(59, parts[1])) : 0;
      const d = new Date(now);
      const target = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), hour, minute);
      return now < target ? target : target + DAY;
    };

    const nextRivals = (now) => {
      const anchor = Date.parse(cfg.rivalsAnchorUtc || '');
      const cycle = Math.max(1, Number(cfg.rivalsCycleDays) || 28) * DAY;
      if (!Number.isFinite(anchor)) return NaN;
      return now < anchor ? anchor : anchor + (Math.floor((now - anchor) / cycle) + 1) * cycle;
    };

    const startFor = (id) => {
      const raw =
        id === 'unbreakable'
          ? cfg.unbreakableStartUtc
          : cfg.upcomingEvents.find((event) => event.id === id)?.startUtc;
      return Date.parse(raw || '');
    };

    const render = () => {
      const now = Date.now();

      const anniversaryStart = Date.parse(cfg.anniversaryStartUtc || '');
      const annivLive = !Number.isFinite(anniversaryStart) || now >= anniversaryStart;
      set('anniversaryState', annivLive ? 'LIVE NOW' : 'UPCOMING');
      set('anniversarySubtitle', cfg.anniversarySubtitle || 'Third Anniversary celebration.');

      if (Number.isFinite(anniversaryStart)) {
        set('anniversaryStart', localDate.format(anniversaryStart).replace(',', ''));
      }

      document.querySelectorAll('.event-card[data-event-id]').forEach((card) => {
        const start = startFor(card.getAttribute('data-event-id'));
        if (!Number.isFinite(start)) return;

        const live = now >= start;
        const countdown = card.querySelector('[data-countdown]');
        const state = card.querySelector('[data-state]');
        const local = card.querySelector('[data-local-start]');

        if (countdown) countdown.textContent = live ? 'LIVE NOW' : formatCountdown(start - now);
        if (state) {
          state.textContent = live ? 'Live now' : 'Upcoming';
          state.classList.toggle('is-live', live);
        }
        if (local) local.textContent = localDate.format(start);
      });

      const daily = nextDaily(now);
      set('dailyCountdown', formatCountdown(daily - now));
      set('dailyLocal', localDate.format(daily));
      set('dailyUtc', utcDate.format(daily));

      const rivalsReset = nextRivals(now);
      if (Number.isFinite(rivalsReset)) {
        set('rivalsCountdown', formatCountdown(rivalsReset - now));
        set('rivalsLocal', localDate.format(rivalsReset));
        set('rivalsUtc', utcDate.format(rivalsReset));
      }
    };

    const sync = async () => {
      try {
        const response = await fetch('/api/football?live=' + Date.now(), {
          cache: 'no-store',
          credentials: 'same-origin'
        });
        if (!response.ok) throw new Error('sync failed');

        const content = (await response.json())?.content || {};
        const eventCountdown = content.eventCountdown;
        const secondaryEvent = content.secondaryEvent;
        const divisionRivals = content.divisionRivalsReset;

        if (eventCountdown) {
          cfg.anniversaryStartUtc = eventCountdown.startUtc || cfg.anniversaryStartUtc;
          cfg.anniversarySubtitle = eventCountdown.subtitle || cfg.anniversarySubtitle;

          if (eventCountdown.banner && $('anniversaryImage')) {
            $('anniversaryImage').src = eventCountdown.banner.replace(
              '/image/upload/',
              '/image/upload/f_auto,q_auto,dpr_auto,w_1800/'
            );
          }
          if (eventCountdown.logo && $('anniversaryLogo')) {
            $('anniversaryLogo').src = eventCountdown.logo;
          }
        }

        if (secondaryEvent) {
          cfg.unbreakableStartUtc = secondaryEvent.startUtc || cfg.unbreakableStartUtc;
          const image = document.querySelector('[data-event-id="unbreakable"] img');
          if (secondaryEvent.banner && image) {
            image.src = secondaryEvent.banner.replace(
              '/image/upload/',
              '/image/upload/f_auto,q_auto,dpr_auto,w_1000/'
            );
          }
        }

        if (divisionRivals) {
          cfg.rivalsAnchorUtc = divisionRivals.anchorUtc || cfg.rivalsAnchorUtc;
          cfg.rivalsCycleDays = Number(divisionRivals.cycleDays) || cfg.rivalsCycleDays;
        }

        if (content.schedule?.dailyResetUtc) {
          cfg.dailyResetUtc = content.schedule.dailyResetUtc;
        }
        if (Array.isArray(content.upcomingEvents)) {
          cfg.upcomingEvents = content.upcomingEvents;
        }

        set('syncLabel', 'Live · synced');
      } catch {
        set('syncLabel', 'Live · auto clock');
      }

      render();
    };

    render();
    sync();
    setInterval(render, 1000);
    setInterval(sync, 30000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        render();
        sync();
      }
    });
  })();
  </script>

  <style>
    .hub{
      --bg:#060d13;
      --panel:#0b171f;
      --panel-2:#0e1d27;
      --line:#183542;
      --ink:#f1fbff;
      --mute:#87a2ad;
      --cyan:#62d9ff;
      --green:#58e0a6;
      --gold:#ffd36e;
      --num:var(--mono,ui-monospace,SFMono-Regular,Menlo,Consolas,monospace);
      min-height:100vh;
      padding:30px 24px 88px;
      background:
        radial-gradient(950px 500px at 8% -5%,rgba(50,185,235,.12),transparent 62%),
        radial-gradient(850px 500px at 100% 35%,rgba(110,100,255,.07),transparent 62%),
        var(--bg);
      color:var(--ink);
      overflow:hidden;
    }
    .wrap{max-width:1180px;margin:0 auto}
    .hub :is(h1,h2,h3,p){margin:0}
    .crumb{
      display:flex;
      align-items:center;
      gap:9px;
      color:#6f8d99;
      font-size:12px;
      margin-bottom:28px;
    }
    .crumb a{color:#8eabb6;text-decoration:none}
    .crumb a:hover{color:var(--cyan)}
    .page-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-end;
      gap:36px;
      padding-bottom:32px;
    }
    .eyebrow{
      color:var(--cyan);
      font-size:11px;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .dot{
      display:inline-block;
      width:7px;
      height:7px;
      border-radius:50%;
      background:var(--green);
      box-shadow:0 0 0 4px rgba(88,224,166,.12),0 0 13px rgba(88,224,166,.45);
    }
    .page-head h1{
      margin-top:15px;
      font-size:clamp(42px,6.3vw,76px);
      line-height:.94;
      letter-spacing:-.05em;
      font-weight:800;
      text-wrap:balance;
    }
    .lede{
      margin-top:17px!important;
      max-width:56ch;
      color:var(--mute);
      font-size:15px;
      line-height:1.65;
    }
    .head-links{
      display:flex;
      flex-wrap:wrap;
      justify-content:flex-end;
      gap:9px;
    }
    .head-links a{
      display:inline-flex;
      gap:8px;
      align-items:center;
      padding:10px 13px;
      border:1px solid var(--line);
      border-radius:12px;
      background:rgba(11,23,31,.72);
      color:#d6f1f8;
      text-decoration:none;
      font-size:12px;
      font-weight:800;
    }
    .head-links a:hover{border-color:rgba(98,217,255,.44);background:#0d202b}
    .head-links span{color:var(--cyan)}

    .hero{
      position:relative;
      min-height:450px;
      overflow:hidden;
      border:1px solid rgba(98,217,255,.25);
      border-radius:26px;
      box-shadow:0 36px 90px rgba(0,0,0,.4);
      isolation:isolate;
    }
    .hero-img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      z-index:-2;
    }
    .hero-shade{
      position:absolute;
      inset:0;
      z-index:-1;
      background:
        linear-gradient(90deg,rgba(4,10,15,.94) 0%,rgba(4,10,15,.7) 50%,rgba(4,10,15,.16) 100%),
        linear-gradient(0deg,rgba(4,10,15,.75),transparent 58%);
    }
    .hero-body{
      min-height:450px;
      max-width:720px;
      padding:40px;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      align-items:flex-start;
      gap:14px;
    }
    .hero-topline{
      display:flex;
      align-items:center;
      flex-wrap:wrap;
      gap:10px 14px;
      color:#a9c4ce;
      font-size:12px;
      font-weight:600;
    }
    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 11px;
      border-radius:999px;
      background:rgba(5,12,17,.76);
      border:1px solid rgba(255,255,255,.16);
      color:#d7e8ee;
      font-size:11px;
      font-weight:800;
      letter-spacing:.05em;
    }
    .badge.live{color:#9bf0c7;border-color:rgba(88,224,166,.38)}
    .hero-logo{
      width:min(65%,255px);
      max-height:95px;
      object-fit:contain;
      object-position:left;
      filter:drop-shadow(0 8px 25px rgba(0,0,0,.42));
    }
    .hero h2{
      font-size:clamp(30px,4.2vw,46px);
      line-height:1;
      letter-spacing:-.045em;
    }
    .hero p{
      max-width:47ch;
      color:#b6cbd3;
      font-size:15px;
      line-height:1.55;
    }
    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:9px;
      margin-top:3px;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:10px 14px;
      border-radius:11px;
      text-decoration:none;
      font-size:12.5px;
      font-weight:800;
      transition:transform .16s ease,border-color .16s ease,background .16s ease;
    }
    .btn:hover{transform:translateY(-1px)}
    .btn-primary{
      background:var(--cyan);
      color:#05151d;
      border:1px solid var(--cyan);
    }
    .btn-primary:hover{background:#82e2ff}
    .btn-ghost{
      background:rgba(6,15,22,.65);
      color:var(--ink);
      border:1px solid rgba(255,255,255,.2);
    }
    .btn-ghost:hover{border-color:var(--cyan);color:var(--cyan)}
    .btn span{font-size:16px}
    .hero-meta{
      display:flex;
      align-items:end;
      flex-wrap:wrap;
      gap:17px 28px;
      width:100%;
      margin-top:8px;
      padding-top:16px;
      border-top:1px solid rgba(255,255,255,.13);
    }
    .hero-meta small,.reset-top small{
      display:block;
      color:#78929d;
      font-size:10.5px;
    }
    .hero-meta strong{
      display:block;
      margin-top:5px;
      font:700 12px/1.2 var(--num);
    }
    .hero-meta a{color:var(--cyan);text-decoration:none}
    .hero-meta a:hover{text-decoration:underline}
    .official{
      margin-left:auto;
      font-size:12px;
      white-space:nowrap;
    }

    .gift{
      display:grid;
      grid-template-columns:1.2fr 1fr auto;
      gap:20px;
      align-items:center;
      margin-top:14px;
      padding:17px 20px;
      border:1px solid rgba(88,224,166,.24);
      border-radius:18px;
      background:linear-gradient(160deg,rgba(12,31,37,.92),rgba(8,18,24,.96));
    }
    .gift-kicker{
      display:block;
      margin-bottom:4px;
      color:var(--green);
      font-size:10px;
      font-weight:800;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .gift strong{font-size:15px}
    .gift p{margin-top:4px!important;color:var(--mute);font-size:12px;line-height:1.45}
    .gift-items{
      display:flex;
      flex-wrap:wrap;
      gap:7px 14px;
    }
    .gift-items span{
      color:#d8f4e7;
      font-size:12px;
      font-weight:700;
      white-space:nowrap;
    }
    .gift-items span::before{content:"✓";margin-right:6px;color:var(--green)}
    .gift-actions{
      display:flex;
      flex-direction:column;
      gap:5px;
      align-items:flex-end;
    }
    .gift-actions a{
      color:var(--cyan);
      font-size:11.5px;
      font-weight:800;
      text-decoration:none;
      white-space:nowrap;
    }
    .gift-actions a:hover{text-decoration:underline}

    .section{
      margin-top:62px;
      scroll-margin-top:96px;
    }
    .section-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:18px;
      margin-bottom:20px;
    }
    .section-head h2{
      margin-top:6px;
      font-size:clamp(25px,3.2vw,35px);
      line-height:1.05;
      letter-spacing:-.04em;
    }
    .section-head > p{
      color:var(--mute);
      font-size:12.5px;
    }
    .section-link{
      color:var(--cyan);
      font-size:12.5px;
      font-weight:800;
      text-decoration:none;
    }
    .section-link:hover{text-decoration:underline}
    .sync{color:#6ad0a4!important;font-size:12px!important;font-weight:700}

    .event-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }
    .event-card{
      --acc:var(--cyan);
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:20px;
      background:linear-gradient(165deg,#0d1b24,#081219);
      transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease;
    }
    .event-card:hover{
      transform:translateY(-3px);
      border-color:color-mix(in srgb,var(--acc) 48%,var(--line));
      box-shadow:0 24px 56px rgba(0,0,0,.28);
    }
    .event-media{position:relative;aspect-ratio:16/9;background:#071117;overflow:hidden}
    .event-media img{display:block;width:100%;height:100%;object-fit:cover}
    .event-fade{
      position:absolute;
      inset:0;
      background:linear-gradient(180deg,rgba(4,10,15,.08),rgba(4,10,15,.14) 42%,rgba(8,18,25,.96));
    }
    .event-date{
      position:absolute;
      left:18px;
      bottom:12px;
      display:flex;
      align-items:baseline;
      gap:7px;
    }
    .event-date b{
      color:#fff;
      font:800 48px/.9 var(--num);
      letter-spacing:-.06em;
      text-shadow:0 7px 24px rgba(0,0,0,.5);
    }
    .event-date span{color:var(--acc);font-size:13px;font-weight:800}
    .event-state{
      position:absolute;
      right:14px;
      top:14px;
      padding:7px 9px;
      border-radius:999px;
      border:1px solid color-mix(in srgb,var(--acc) 38%,transparent);
      background:rgba(4,10,15,.76);
      color:var(--acc);
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
    }
    .event-state.is-live{color:#9bf0c7;border-color:rgba(88,224,166,.38)}
    .event-body{display:flex;flex-direction:column;gap:9px;padding:18px}
    .event-body h3{font-size:21px;letter-spacing:-.03em}
    .event-body p{color:var(--mute);font-size:13px;line-height:1.5}
    .event-count{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:12px;
      padding-top:13px;
      border-top:1px solid var(--line);
      margin-top:3px;
    }
    .event-count small{display:block;color:#718b96;font-size:10.5px}
    .event-count em{
      display:block;
      margin-top:3px;
      color:#78939d;
      font-style:normal;
      font-size:10.5px;
    }
    .event-count strong{
      color:var(--ink);
      font:800 21px/1 var(--num);
      letter-spacing:-.05em;
      font-variant-numeric:tabular-nums;
      white-space:nowrap;
    }
    .event-link{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      padding-top:2px;
      color:var(--acc);
      font-size:12px;
      font-weight:800;
      text-decoration:none;
    }
    .event-link span{font-size:16px}
    .event-link:hover{text-decoration:underline}

    .reset-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:18px;
    }
    .reset-card{
      padding:24px;
      border:1px solid var(--line);
      border-radius:20px;
      background:linear-gradient(165deg,#0d1b24,#081219);
    }
    .reset-card--featured{
      border-color:rgba(98,217,255,.28);
      background:linear-gradient(165deg,#0c222e,#08141b);
    }
    .reset-top{
      display:flex;
      justify-content:space-between;
      align-items:start;
      gap:12px;
    }
    .reset-top h3{margin-top:4px;font-size:18px;letter-spacing:-.025em}
    .reset-top > span{color:var(--mute);font-size:11.5px;font-weight:700}
    .reset-count{
      display:block;
      margin:21px 0 17px;
      color:var(--ink);
      font:800 clamp(32px,4.3vw,49px)/1 var(--num);
      letter-spacing:-.06em;
      font-variant-numeric:tabular-nums;
    }
    .reset-card--featured .reset-count{color:var(--cyan)}
    .reset-times{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
      padding-top:14px;
      border-top:1px solid var(--line);
    }
    .reset-times strong{
      display:block;
      margin-top:5px;
      color:#d7ebf1;
      font:600 11.5px/1.4 var(--num);
      font-variant-numeric:tabular-nums;
    }
    .reset-card > a{
      display:inline-block;
      margin-top:16px;
      color:var(--cyan);
      font-size:11.5px;
      font-weight:800;
      text-decoration:none;
    }
    .reset-card > a:hover{text-decoration:underline}

    .coverage-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:14px;
    }
    .coverage-card{
      display:flex;
      flex-direction:column;
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:18px;
      background:linear-gradient(165deg,#0d1b24,#081219);
      color:inherit;
      text-decoration:none;
      transition:transform .18s ease,border-color .18s ease;
    }
    .coverage-card:hover{transform:translateY(-3px);border-color:rgba(98,217,255,.4)}
    .coverage-media{aspect-ratio:16/9;background:#071117;overflow:hidden;display:grid;place-items:center}
    .coverage-media img{width:100%;height:100%;object-fit:cover;display:block}
    .coverage-media span{color:#7b98a3;font:800 12px var(--num)}
    .coverage-body{
      display:flex;
      flex-direction:column;
      gap:7px;
      flex:1;
      padding:15px 16px 17px;
    }
    .coverage-body > div{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      color:var(--mute);
      font-size:10.5px;
    }
    .coverage-body > div span{color:var(--cyan);font-weight:800}
    .coverage-body h3{font-size:15.5px;line-height:1.25;letter-spacing:-.02em}
    .coverage-body p{
      color:var(--mute);
      font-size:11.5px;
      line-height:1.45;
      display:-webkit-box;
      -webkit-box-orient:vertical;
      -webkit-line-clamp:3;
      overflow:hidden;
    }
    .coverage-body > strong{margin-top:auto;color:var(--cyan);font-size:11.5px}

    .tool-links{
      display:grid;
      grid-template-columns:repeat(5,1fr);
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
    }
    .tool-links a{
      display:grid;
      grid-template-columns:auto 1fr auto;
      column-gap:10px;
      align-items:center;
      min-height:82px;
      padding:14px 16px;
      border-right:1px solid var(--line);
      color:inherit;
      text-decoration:none;
      background:rgba(11,23,31,.35);
      transition:background .18s ease;
    }
    .tool-links a:last-child{border-right:0}
    .tool-links a:hover{background:rgba(15,32,43,.82)}
    .tool-links span{color:#658490;font:700 10px var(--num)}
    .tool-links strong{font-size:12.5px}
    .tool-links small{grid-column:2;color:var(--mute);font-size:10.5px;margin-top:2px}
    .tool-links b{grid-row:1/3;grid-column:3;color:var(--cyan);font-size:16px}

    @media(max-width:1020px){
      .page-head{align-items:flex-start}
      .event-grid{grid-template-columns:1fr 1fr}
      .event-card:last-child{grid-column:1/-1}
      .event-card:last-child .event-media{aspect-ratio:21/9}
      .coverage-grid{grid-template-columns:1fr 1fr}
      .tool-links{grid-template-columns:1fr 1fr}
      .tool-links a:nth-child(2n){border-right:0}
      .tool-links a{border-bottom:1px solid var(--line)}
      .gift{grid-template-columns:1fr;gap:12px}
      .gift-actions{align-items:flex-start;flex-direction:row;flex-wrap:wrap;gap:15px}
    }
    @media(max-width:760px){
      .hub{padding:22px 16px 68px}
      .page-head{display:block;padding-bottom:26px}
      .head-links{justify-content:flex-start;margin-top:18px}
      .hero,.hero-body{min-height:400px}
      .hero-body{padding:25px 20px}
      .hero-shade{
        background:
          linear-gradient(0deg,rgba(4,10,15,.96) 0%,rgba(4,10,15,.7) 62%,rgba(4,10,15,.22) 100%);
      }
      .hero-logo{width:min(74%,220px)}
      .official{margin-left:0}
      .event-grid,.reset-grid,.coverage-grid{grid-template-columns:1fr}
      .event-card:last-child{grid-column:auto}
      .event-card:last-child .event-media{aspect-ratio:16/9}
      .reset-times{grid-template-columns:1fr}
      .tool-links{grid-template-columns:1fr}
      .tool-links a{border-right:0!important}
      .tool-links a:last-child{border-bottom:0}
      .section{margin-top:52px}
    }
    @media(prefers-reduced-motion:reduce){
      .event-card,.coverage-card,.btn{transition:none}
      .event-card:hover,.coverage-card:hover,.btn:hover{transform:none}
    }
  </style>
</BaseLayout>
