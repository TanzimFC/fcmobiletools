---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const anniversary = FOOTBALL_CENTRE_CONTENT.eventCountdown ?? {};
const secondary = FOOTBALL_CENTRE_CONTENT.secondaryEvent ?? {};
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset ?? {};
const schedule = FOOTBALL_CENTRE_CONTENT.schedule ?? {};
const upcomingEvents = Array.isArray(FOOTBALL_CENTRE_CONTENT.upcomingEvents) ? FOOTBALL_CENTRE_CONTENT.upcomingEvents : [];

const cl = (url, w) => (url || '').replace('/image/upload/', `/image/upload/f_auto,q_auto,dpr_auto,w_${w}/`);
const banner = (id) => upcomingEvents.find((e) => e.id === id)?.banner || '';

const anniversaryBanner = cl(anniversary.banner || 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323719/fc-mobile-tools/qrtvtote0squixmcts6u.jpg', 1800);
const unbreakableBanner = cl(secondary.banner || 'https://res.cloudinary.com/b0qikv7n/image/upload/v1790323741/fc-mobile-tools/nql89jl6h2udu51cquje.jpg', 1000);
const anniversaryLogo = anniversary.logo || 'https://sappurit.github.io/s10img/png/2026-09-17/anniversary27_topup_ANNI27_LOGO.png';

// All upcoming events share one card design and one size.
const upcoming = [
  { id: 'unbreakable', title: secondary.title || 'Unbreakable', text: secondary.subtitle || 'Major FC Mobile event.', day: '15', month: 'Oct', img: unbreakableBanner, acc: '#8b93ff' },
  { id: 'conmebol-libertadores', title: 'CONMEBOL Libertadores', text: 'Starts on the same day as Unbreakable.', day: '15', month: 'Oct', img: cl(banner('conmebol-libertadores'), 1000), acc: '#4fe3a3' },
  { id: 'ballon-dor', title: "Ballon d'Or", text: 'Starts on Season Reset day.', day: '22', month: 'Oct', img: cl(banner('ballon-dor'), 1000), acc: '#ffd36e' },
];

const desc = 'FC Mobile event schedule covering Anniversary, Unbreakable, CONMEBOL Libertadores, Ballon d’Or, Daily Reset and the October 22 season reset.';
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events & Reset | FCMOBILETOOLS',
  description: desc,
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.online').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Events & Reset | FCMOBILETOOLS" description={desc}>
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<main class="hub">
  <div class="wrap">

    <header class="top">
      <div class="top-copy">
        <p class="tag"><i class="dot"></i>FC Mobile 27 · Events &amp; reset</p>
        <h1>Every date that matters,<br />in one place.</h1>
        <p class="lede">Live events, the October drops and the next resets, all counted down to the second in your own time zone.</p>
      </div>
      <div class="clock" aria-label="Current local and UTC time">
        <div><small>Your time</small><strong id="localClock">--:--:--</strong><em id="zoneLabel">Local</em></div>
        <div><small>UTC</small><strong id="utcClock">--:--:--</strong></div>
      </div>
    </header>

    <!-- LIVE -->
    <article class="hero" id="anniversaryCard">
      <img id="anniversaryImage" class="hero-img" src={anniversaryBanner} alt="FC Mobile 3rd Anniversary" width="1800" height="800" loading="eager" fetchpriority="high" decoding="async" />
      <div class="hero-shade"></div>
      <div class="hero-body">
        <span class="badge live"><i class="dot"></i><span id="anniversaryState">LIVE NOW</span></span>
        <img id="anniversaryLogo" class="hero-logo" src={anniversaryLogo} alt="FC Mobile Anniversary 27 logo" decoding="async" />
        <h2>Anniversary Event</h2>
        <p id="anniversarySubtitle">Live alongside the FC Mobile 27 Season Update.</p>
        <div class="hero-foot">
          <div><small>Started</small><strong id="anniversaryStart">24 Sep 2026</strong></div>
          <a href="https://www.ea.com/games/ea-sports-fc/fc-mobile/news/3rd-anniversary" target="_blank" rel="noopener noreferrer">Read the EA announcement ↗</a>
        </div>
      </div>
    </article>

    <!-- UPCOMING: three equal cards -->
    <section class="block" aria-labelledby="upTitle">
      <div class="block-head">
        <h2 id="upTitle">Coming in October</h2>
        <p>Three launches, two dates.</p>
      </div>

      <div class="cards">
        {upcoming.map((e) => (
          <article class="card" data-event-id={e.id} style={`--acc:${e.acc}`}>
            <div class="card-media">
              {e.img && <img src={e.img} alt={e.title} loading="lazy" decoding="async" />}
              <div class="card-fade"></div>
              <div class="card-date"><b>{e.day}</b><span>{e.month}</span></div>
              <span class="badge soon" data-state>Upcoming</span>
            </div>
            <div class="card-body">
              <h3>{e.title}</h3>
              <p>{e.text}</p>
              <div class="card-count">
                <small>Starts in</small>
                <strong data-countdown>--:--:--</strong>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- RESETS -->
    <section class="block" aria-labelledby="rsTitle">
      <div class="block-head">
        <h2 id="rsTitle">Resets</h2>
        <p id="syncLabel" class="sync">Syncing…</p>
      </div>

      <div class="resets">
        <article class="reset">
          <div class="reset-top"><h3>Daily reset</h3><span>Every day · 01:00 UTC</span></div>
          <strong class="big" id="dailyCountdown">--:--:--</strong>
          <dl>
            <div><dt>Your time</dt><dd id="dailyLocal">—</dd></div>
            <div><dt>UTC</dt><dd id="dailyUtc">—</dd></div>
          </dl>
        </article>

        <article class="reset accent">
          <div class="reset-top"><h3>Division Rivals · Season reset</h3><span>22 Oct</span></div>
          <strong class="big" id="rivalsCountdown">--:--:--</strong>
          <dl>
            <div><dt>Your time</dt><dd id="rivalsLocal">22 Oct 2026</dd></div>
            <div><dt>UTC</dt><dd id="rivalsUtc">22 Oct 2026 · 01:00 UTC</dd></div>
          </dl>
        </article>
      </div>
    </section>

  </div>
</main>

<script define:vars={{
  anniversaryStartUtc: anniversary.startUtc,
  anniversarySubtitle: anniversary.subtitle,
  unbreakableStartUtc: secondary.startUtc,
  rivalsAnchorUtc: rivals.anchorUtc,
  rivalsCycleDays: rivals.cycleDays,
  dailyResetUtc: schedule.dailyResetUtc || '01:00',
  upcomingEventsData: upcomingEvents,
}}>
(() => {
  const $ = (id) => document.getElementById(id);
  const set = (id, v) => { const n = $(id); if (n) n.textContent = v; };
  const DAY = 86400000;
  const pad = (v) => String(Math.max(0, Math.floor(Number(v) || 0))).padStart(2, '0');
  const fmt = (ms) => {
    let t = Math.max(0, Math.floor(ms / 1000));
    const d = Math.floor(t / 86400); t %= 86400;
    const h = Math.floor(t / 3600); t %= 3600;
    const m = Math.floor(t / 60), s = t % 60;
    return (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
  };

  const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  const localClock = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short' });
  const utcClock = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
  const localDate = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
  const utcDate = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });

  let cfg = {
    anniversaryStartUtc, anniversarySubtitle, unbreakableStartUtc,
    rivalsAnchorUtc, rivalsCycleDays: Number(rivalsCycleDays) || 28,
    dailyResetUtc,
    upcomingEvents: Array.isArray(upcomingEventsData) ? upcomingEventsData : [],
  };

  const nextDaily = (now) => {
    const p = String(cfg.dailyResetUtc || '01:00').split(':').map(Number);
    const h = Number.isFinite(p[0]) ? Math.max(0, Math.min(23, p[0])) : 1;
    const m = Number.isFinite(p[1]) ? Math.max(0, Math.min(59, p[1])) : 0;
    const d = new Date(now);
    const t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m);
    return now < t ? t : t + DAY;
  };
  const nextRivals = (now) => {
    const a = Date.parse(cfg.rivalsAnchorUtc || '');
    const c = Math.max(1, Number(cfg.rivalsCycleDays) || 28) * DAY;
    if (!Number.isFinite(a)) return NaN;
    return now < a ? a : a + (Math.floor((now - a) / c) + 1) * c;
  };
  const startFor = (id) => {
    const raw = id === 'unbreakable' ? cfg.unbreakableStartUtc : cfg.upcomingEvents.find((e) => e.id === id)?.startUtc;
    return Date.parse(raw || '');
  };

  const render = () => {
    const now = Date.now();
    set('localClock', localClock.format(now));
    set('utcClock', utcClock.format(now));
    set('zoneLabel', zone);

    const a = Date.parse(cfg.anniversaryStartUtc || '');
    set('anniversaryState', Number.isFinite(a) && now < a ? 'UPCOMING' : 'LIVE NOW');
    set('anniversarySubtitle', cfg.anniversarySubtitle || 'Third Anniversary celebration.');
    if (Number.isFinite(a)) set('anniversaryStart', localDate.format(a).replace(',', ''));

    document.querySelectorAll('.card[data-event-id]').forEach((card) => {
      const start = startFor(card.getAttribute('data-event-id'));
      if (!Number.isFinite(start)) return;
      const live = now >= start;
      const c = card.querySelector('[data-countdown]');
      const s = card.querySelector('[data-state]');
      if (c) c.textContent = live ? 'LIVE NOW' : fmt(start - now);
      if (s) { s.textContent = live ? 'Live now' : 'Upcoming'; s.classList.toggle('live', live); }
    });

    const d = nextDaily(now);
    set('dailyCountdown', fmt(d - now));
    set('dailyLocal', localDate.format(d));
    set('dailyUtc', utcDate.format(d));

    const r = nextRivals(now);
    if (Number.isFinite(r)) {
      set('rivalsCountdown', fmt(r - now));
      set('rivalsLocal', localDate.format(r));
      set('rivalsUtc', utcDate.format(r));
    }
  };

  const sync = async () => {
    try {
      const res = await fetch('/api/football?live=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
      if (!res.ok) throw new Error('sync');
      const c = (await res.json())?.content || {};
      const ec = c.eventCountdown, se = c.secondaryEvent, dr = c.divisionRivalsReset;
      if (ec) {
        cfg.anniversaryStartUtc = ec.startUtc || cfg.anniversaryStartUtc;
        cfg.anniversarySubtitle = ec.subtitle || cfg.anniversarySubtitle;
        if (ec.banner && $('anniversaryImage')) $('anniversaryImage').src = ec.banner.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_1800/');
        if (ec.logo && $('anniversaryLogo')) $('anniversaryLogo').src = ec.logo;
      }
      if (se) {
        cfg.unbreakableStartUtc = se.startUtc || cfg.unbreakableStartUtc;
        const img = document.querySelector('[data-event-id="unbreakable"] img');
        if (se.banner && img) img.src = se.banner.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_1000/');
      }
      if (dr) {
        cfg.rivalsAnchorUtc = dr.anchorUtc || cfg.rivalsAnchorUtc;
        cfg.rivalsCycleDays = Number(dr.cycleDays) || cfg.rivalsCycleDays;
      }
      if (c.schedule?.dailyResetUtc) cfg.dailyResetUtc = c.schedule.dailyResetUtc;
      if (Array.isArray(c.upcomingEvents)) cfg.upcomingEvents = c.upcomingEvents;
      set('syncLabel', 'Live · synced');
    } catch {
      set('syncLabel', 'Live · auto clock');
    }
    render();
  };

  render();
  sync();
  setInterval(render, 1000);
  setInterval(sync, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); sync(); } });
})();
</script>

<style>
.hub{
  --bg:#060d13; --panel:#0b171f; --line:#183542; --ink:#f1fbff; --mute:#87a2ad; --cyan:#62d9ff; --green:#58e0a6; --gold:#ffd36e;
  --num:var(--mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
  background:
    radial-gradient(900px 500px at 8% -5%, rgba(50,185,235,.14), transparent 60%),
    radial-gradient(800px 500px at 100% 30%, rgba(110,100,255,.09), transparent 60%),
    var(--bg);
  color:var(--ink); min-height:100vh; padding:48px 24px 96px; overflow:hidden;
}
.wrap{max-width:1180px;margin:0 auto}
.hub :is(h1,h2,h3,p,dl,dd){margin:0}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px rgba(88,224,166,.12),0 0 14px rgba(88,224,166,.5)}

/* header */
.top{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;padding-bottom:36px}
.tag{display:flex;align-items:center;gap:10px;color:var(--mute);font-size:13px;letter-spacing:.02em}
.top h1{margin-top:18px;font-size:clamp(38px,6vw,76px);line-height:1;letter-spacing:-.045em;font-weight:800}
.lede{margin-top:18px;max-width:52ch;color:var(--mute);font-size:16px;line-height:1.6}
.clock{display:grid;gap:0;min-width:230px;border:1px solid var(--line);border-radius:18px;background:rgba(11,23,31,.7);backdrop-filter:blur(8px);overflow:hidden}
.clock>div{display:grid;gap:6px;padding:16px 20px}
.clock>div+div{border-top:1px solid var(--line)}
.clock small{color:var(--mute);font-size:12px}
.clock strong{font:700 24px/1 var(--num);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.clock em{font-style:normal;color:#5d7f8c;font-size:12px}

/* hero */
.hero{position:relative;min-height:440px;border-radius:26px;overflow:hidden;border:1px solid rgba(98,217,255,.28);box-shadow:0 40px 100px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.02) inset;isolation:isolate}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(4,10,15,.92) 0%,rgba(4,10,15,.55) 45%,rgba(4,10,15,.05) 100%),linear-gradient(0deg,rgba(4,10,15,.7),transparent 50%)}
.hero-body{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:14px;min-height:440px;padding:40px;max-width:640px}
.hero-logo{width:min(70%,280px);max-height:110px;object-fit:contain;object-position:left;filter:drop-shadow(0 8px 24px rgba(0,0,0,.4))}
.hero h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.04em;line-height:1}
.hero p{color:#b8ced6;font-size:16px;line-height:1.55;max-width:44ch}
.hero-foot{display:flex;flex-wrap:wrap;align-items:center;gap:14px 32px;margin-top:8px;padding-top:18px;border-top:1px solid rgba(255,255,255,.14);width:100%}
.hero-foot small{display:block;color:#8ba7b1;font-size:12px}
.hero-foot strong{display:block;margin-top:5px;font:700 14px/1 var(--num)}
.hero-foot a{color:var(--cyan);font-size:14px;text-decoration:none;border-bottom:1px solid rgba(98,217,255,.35);padding-bottom:2px}
.hero-foot a:hover{border-color:var(--cyan)}
.hero-foot a:focus-visible,.card:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}

.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.06em;background:rgba(5,12,17,.72);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(6px);color:#d5e8ee}
.badge.live{color:#9af0c6;border-color:rgba(88,224,166,.4)}

/* sections */
.block{margin-top:72px}
.block-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:24px}
.block-head h2{font-size:clamp(26px,3vw,36px);letter-spacing:-.04em}
.block-head p{color:var(--mute);font-size:14px}
.sync{color:#5bbf98!important}

/* event cards: identical structure and size, own accent colour */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{--acc:var(--cyan);position:relative;display:flex;flex-direction:column;border-radius:22px;overflow:hidden;background:linear-gradient(170deg,#0e1d27,#08131a);border:1px solid var(--line);transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
.card::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:linear-gradient(90deg,var(--acc),transparent);z-index:2}
.card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--acc) 55%,var(--line));box-shadow:0 30px 70px rgba(0,0,0,.4),0 0 40px color-mix(in srgb,var(--acc) 14%,transparent)}
.card-media{position:relative;aspect-ratio:16/10;background:#071117;overflow:hidden}
.card-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s ease}
.card:hover .card-media img{transform:scale(1.04)}
.card-fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,13,19,.15) 0%,rgba(6,13,19,.05) 40%,rgba(8,19,26,.96) 100%)}
.card-date{position:absolute;left:20px;bottom:14px;display:flex;align-items:baseline;gap:8px}
.card-date b{font:800 56px/.9 var(--num);letter-spacing:-.06em;color:#fff;text-shadow:0 8px 28px rgba(0,0,0,.5)}
.card-date span{font-size:15px;font-weight:700;color:var(--acc)}
.card .badge{position:absolute;top:16px;right:16px}
.card .badge.soon{color:var(--acc);border-color:color-mix(in srgb,var(--acc) 40%,transparent)}
.card .badge.live{color:#9af0c6}
.card-body{display:flex;flex-direction:column;gap:8px;flex:1;padding:22px 22px 24px}
.card-body h3{font-size:24px;letter-spacing:-.035em;line-height:1.1}
.card-body p{color:var(--mute);font-size:14px;line-height:1.55;min-height:44px}
.card-count{margin-top:auto;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.card-count small{color:var(--mute);font-size:12px}
.card-count strong{font:800 26px/1 var(--num);letter-spacing:-.05em;color:var(--ink);font-variant-numeric:tabular-nums}

/* resets */
.resets{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.reset{padding:28px;border-radius:22px;border:1px solid var(--line);background:linear-gradient(160deg,#0d1b24,#08131a)}
.reset.accent{border-color:rgba(98,217,255,.35);background:linear-gradient(160deg,#0c2230,#08151d)}
.reset-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.reset-top h3{font-size:19px;letter-spacing:-.02em}
.reset-top span{color:var(--mute);font-size:13px}
.big{display:block;margin:22px 0 24px;font:800 clamp(38px,5vw,56px)/1 var(--num);letter-spacing:-.06em;font-variant-numeric:tabular-nums}
.accent .big{color:var(--cyan)}
.reset dl{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-top:18px;border-top:1px solid var(--line)}
.reset dt{color:#5f8290;font-size:12px}
.reset dd{margin-top:6px;font:600 13px/1.4 var(--num);color:#d6eaf0}

@media (max-width:980px){
  .cards{grid-template-columns:1fr 1fr}
  .cards .card:last-child{grid-column:1/-1}
  .cards .card:last-child .card-media{aspect-ratio:21/9}
}
@media (max-width:760px){
  .hub{padding:32px 16px 72px}
  .top{grid-template-columns:1fr;gap:24px}
  .clock{grid-template-columns:1fr 1fr;min-width:0}
  .clock>div+div{border-top:0;border-left:1px solid var(--line)}
  .hero,.hero-body{min-height:400px}
  .hero-body{padding:26px 22px}
  .hero-shade{background:linear-gradient(0deg,rgba(4,10,15,.95) 0%,rgba(4,10,15,.55) 60%,rgba(4,10,15,.2) 100%)}
  .cards,.resets{grid-template-columns:1fr}
  .cards .card:last-child .card-media{aspect-ratio:16/10}
  .block{margin-top:56px}
  .reset dl{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  .card,.card-media img{transition:none}
  .card:hover{transform:none}
  .card:hover .card-media img{transform:none}
}
</style>
</BaseLayout>
