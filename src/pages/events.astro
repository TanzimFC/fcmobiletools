<script define:vars={{
  anniversaryStartUtc: anniversary.startUtc,
  anniversarySubtitle: anniversary.subtitle,
  unbreakableStartUtc: secondary.startUtc,
  rivalsAnchorUtc: rivals.anchorUtc,
  rivalsCycleDays: rivals.cycleDays,
  dailyResetUtc: schedule.dailyResetUtc || '01:00',
  upcomingEventsData: upcomingEvents,
}}>
(() => {
  const $ = (id) => document.getElementById(id);
  const set = (id, v) => { const n = $(id); if (n) n.textContent = v; };
  const DAY = 86400000;
  const pad = (v) => String(Math.max(0, Math.floor(Number(v) || 0))).padStart(2, '0');
  const fmt = (ms) => {
    let t = Math.max(0, Math.floor(ms / 1000));
    const d = Math.floor(t / 86400); t %= 86400;
    const h = Math.floor(t / 3600); t %= 3600;
    const m = Math.floor(t / 60), s = t % 60;
    return (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
  };

  const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  const localClock = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short' });
  const utcClock = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
  const localDate = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
  const utcDate = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });

  let cfg = {
    anniversaryStartUtc, anniversarySubtitle, unbreakableStartUtc,
    rivalsAnchorUtc, rivalsCycleDays: Number(rivalsCycleDays) || 28,
    dailyResetUtc,
    upcomingEvents: Array.isArray(upcomingEventsData) ? upcomingEventsData : [],
  };

  const nextDaily = (now) => {
    const p = String(cfg.dailyResetUtc || '01:00').split(':').map(Number);
    const h = Number.isFinite(p[0]) ? Math.max(0, Math.min(23, p[0])) : 1;
    const m = Number.isFinite(p[1]) ? Math.max(0, Math.min(59, p[1])) : 0;
    const d = new Date(now);
    const t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), h, m);
    return now < t ? t : t + DAY;
  };
  const nextRivals = (now) => {
    const a = Date.parse(cfg.rivalsAnchorUtc || '');
    const c = Math.max(1, Number(cfg.rivalsCycleDays) || 28) * DAY;
    if (!Number.isFinite(a)) return NaN;
    return now < a ? a : a + (Math.floor((now - a) / c) + 1) * c;
  };
  const startFor = (id) => {
    const raw = id === 'unbreakable' ? cfg.unbreakableStartUtc : cfg.upcomingEvents.find((e) => e.id === id)?.startUtc;
    return Date.parse(raw || '');
  };

  const render = () => {
    const now = Date.now();
    set('localClock', localClock.format(now));
    set('utcClock', utcClock.format(now));
    set('zoneLabel', zone);

    const a = Date.parse(cfg.anniversaryStartUtc || '');
    const isAnnivLive = !Number.isFinite(a) || now >= a;
    set('anniversaryState', isAnnivLive ? 'LIVE NOW' : 'UPCOMING');
    set('anniversarySubtitle', cfg.anniversarySubtitle || 'Third Anniversary celebration.');
    if (Number.isFinite(a)) {
      set('anniversaryStart', localDate.format(a).replace(',', ''));
      if (now >= a) {
        const dayNum = Math.floor((now - a) / DAY) + 1;
        set('anniversaryElapsed', `· Day ${dayNum}`);
      } else {
        set('anniversaryElapsed', `· Starts ${fmt(a - now)}`);
      }
    }

    document.querySelectorAll('.card[data-event-id]').forEach((card) => {
      const start = startFor(card.getAttribute('data-event-id'));
      if (!Number.isFinite(start)) return;
      const live = now >= start;
      const c = card.querySelector('[data-countdown]');
      const s = card.querySelector('[data-state]');
      const l = card.querySelector('[data-local-start]');
      if (c) c.textContent = live ? 'LIVE NOW' : fmt(start - now);
      if (s) { s.textContent = live ? 'Live now' : 'Upcoming'; s.classList.toggle('live', live); }
      if (l) l.textContent = localDate.format(start);
    });

    const d = nextDaily(now);
    const dailyLeft = d - now;
    const dailyFormatted = fmt(dailyLeft);
    set('dailyCountdown', dailyFormatted);
    set('stripDailyCountdown', dailyFormatted);
    set('dailyLocal', localDate.format(d));
    set('dailyUtc', utcDate.format(d));
    const dailyBar = $('dailyProgressBar');
    if (dailyBar) {
      const pct = Math.min(100, Math.max(0, (1 - dailyLeft / DAY) * 100));
      dailyBar.style.width = pct.toFixed(1) + '%';
    }

    const r = nextRivals(now);
    if (Number.isFinite(r)) {
      const cycleMs = Math.max(1, Number(cfg.rivalsCycleDays) || 28) * DAY;
      const rivalsLeft = r - now;
      set('rivalsCountdown', fmt(rivalsLeft));
      set('rivalsLocal', localDate.format(r));
      set('rivalsUtc', utcDate.format(r));
      const rivalsBar = $('rivalsProgressBar');
      if (rivalsBar) {
        const pct = Math.min(100, Math.max(0, (1 - rivalsLeft / cycleMs) * 100));
        rivalsBar.style.width = pct.toFixed(1) + '%';
      }
    }
  };

  const sync = async () => {
    try {
      const res = await fetch('/api/football?live=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' });
      if (!res.ok) throw new Error('sync');
      const c = (await res.json())?.content || {};
      const ec = c.eventCountdown, se = c.secondaryEvent, dr = c.divisionRivalsReset;
      if (ec) {
        cfg.anniversaryStartUtc = ec.startUtc || cfg.anniversaryStartUtc;
        cfg.anniversarySubtitle = ec.subtitle || cfg.anniversarySubtitle;
        if (ec.banner && $('anniversaryImage')) $('anniversaryImage').src = ec.banner.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_1800/');
        if (ec.logo && $('anniversaryLogo')) $('anniversaryLogo').src = ec.logo;
      }
      if (se) {
        cfg.unbreakableStartUtc = se.startUtc || cfg.unbreakableStartUtc;
        const img = document.querySelector('[data-event-id="unbreakable"] img');
        if (se.banner && img) img.src = se.banner.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_1000/');
      }
      if (dr) {
        cfg.rivalsAnchorUtc = dr.anchorUtc || cfg.rivalsAnchorUtc;
        cfg.rivalsCycleDays = Number(dr.cycleDays) || cfg.rivalsCycleDays;
      }
      if (c.schedule?.dailyResetUtc) cfg.dailyResetUtc = c.schedule.dailyResetUtc;
      if (Array.isArray(c.upcomingEvents)) cfg.upcomingEvents = c.upcomingEvents;
      set('syncLabel', 'Live · synced');
    } catch {
      set('syncLabel', 'Live · auto clock');
    }
    render();
  };

  /* ── Copy active redeem code button ── */
  document.querySelectorAll('[data-copy-code]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-copy-code') || '';
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(code);
        if (label) label.textContent = 'Copied!';
      } catch {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.cssText = 'position:fixed;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); if (label) label.textContent = 'Copied!'; } catch {}
        ta.remove();
      }
      setTimeout(() => { if (label) label.textContent = 'Copy'; }, 2000);
    });
  });

  /* ── Filter October event drops ── */
  const eventFilterBtns = document.querySelectorAll('[data-event-filter]');
  const eventCards = document.querySelectorAll('.card[data-event-id]');
  eventFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-event-filter') || 'all';
      eventFilterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      eventCards.forEach((card) => {
        const group = card.getAttribute('data-drop-group');
        card.hidden = filter !== 'all' && group !== filter;
      });
    });
  });

  /* ── Filter Editorial Event Guides ── */
  const postFilterBtns = document.querySelectorAll('[data-post-filter]');
  const postCards = document.querySelectorAll('.guide-card[data-post-type]');
  postFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-post-filter') || 'all';
      postFilterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      postCards.forEach((card) => {
        const type = card.getAttribute('data-post-type');
        const match = filter === 'all' || type === filter || (filter === 'event-guide' && (type === 'event-guide' || type === 'guide'));
        card.hidden = !match;
      });
    });
  });

  /* ── Daily Reset Routine Checklist (persisted per UTC reset day) ── */
  const routineKey = () => {
    const next = nextDaily(Date.now());
    const cycleDay = new Date(next - DAY).toISOString().slice(0, 10);
    return `fcmobiletools_daily_routine_${cycleDay}`;
  };
  const checkboxes = [...document.querySelectorAll('[data-routine-checkbox]')];
  const progressEl = $('routineProgressLabel');
  const loadRoutine = () => {
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(routineKey()) || '{}') || {}; } catch {}
    let done = 0;
    checkboxes.forEach((cb) => {
      const id = cb.getAttribute('data-routine-checkbox');
      const checked = !!saved[id];
      cb.checked = checked;
      cb.closest('[data-routine-item]')?.classList.toggle('is-done', checked);
      if (checked) done += 1;
    });
    if (progressEl) progressEl.textContent = `${done} / ${checkboxes.length} done`;
  };
  const saveRoutine = () => {
    const state = {};
    let done = 0;
    checkboxes.forEach((cb) => {
      const id = cb.getAttribute('data-routine-checkbox');
      state[id] = cb.checked;
      cb.closest('[data-routine-item]')?.classList.toggle('is-done', cb.checked);
      if (cb.checked) done += 1;
    });
    try { localStorage.setItem(routineKey(), JSON.stringify(state)); } catch {}
    if (progressEl) progressEl.textContent = `${done} / ${checkboxes.length} done`;
  };
  checkboxes.forEach((cb) => cb.addEventListener('change', saveRoutine));
  $('routineResetBtn')?.addEventListener('click', () => {
    checkboxes.forEach((cb) => { cb.checked = false; });
    saveRoutine();
  });
  loadRoutine();

  /* ── Quick jump to A Nation's Story search ── */
  const nationForm = document.querySelector('[data-nation-jump-form]');
  nationForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = document.getElementById('eventsNationQuery')?.value?.trim() || '';
    window.location.href = q ? `/a-nations-story/?q=${encodeURIComponent(q)}` : '/a-nations-story/';
  });

  render();
  sync();
  setInterval(render, 1000);
  setInterval(sync, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { render(); sync(); } });
})();
</script>

