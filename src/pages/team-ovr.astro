---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  RANK_OPTIONS,
  STARTING_XI_SIZE,
  MAX_SQUAD_SIZE,
  MAX_BADGE_SLOTS,
  BASE_OVR_MIN,
  BASE_OVR_MAX,
} from '../lib/teamOvr.js';

const POSITIONS = [
  ['GK', 50, 88], ['LB', 18, 68], ['CB', 38, 73], ['CB', 62, 73], ['RB', 82, 68],
  ['CM', 30, 49], ['CM', 50, 45], ['CM', 70, 49], ['LW', 17, 25], ['ST', 50, 18], ['RW', 83, 25],
];
---
<BaseLayout
  title="FC Mobile Team OVR Calculator"
  description="Calculate and optimize FC Mobile Team OVR from Base OVR, Rank and Team OVR bonuses."
>
  <section class="ovr-tool">
    <div class="wrap">
      <header class="head">
        <div class="eyebrow">FC MOBILE TOOLS / TEAM OVR</div>
        <h1>Team OVR <span>Calculator</span></h1>
        <p>Build your squad, watch the rating update live, then plan the next upgrade.</p>
      </header>

      <section class="result-card" aria-live="polite">
        <div class="result-main">
          <div class="result-kicker"><span class="live-dot"></span><small id="result-label">LIVE ESTIMATE</small></div>
          <strong id="result-number">--</strong>
          <p id="result-status">Enter a Base OVR to start the estimate.</p>
        </div>
        <div class="breakdown" aria-label="Live OVR breakdown">
          <div><span>BASE OVR</span><b id="base-avg">--</b></div>
          <div><span>RANK</span><b id="rank-avg">--</b></div>
          <div><span>BONUS</span><b id="badge-avg">+0</b></div>
        </div>
      </section>

      <section class="workspace">
        <div class="left-col">
          <section class="block pitch-block">
            <div class="block-head">
              <div>
                <small>01</small>
                <div>
                  <h2>Starting XI</h2>
                  <p>4-3-3 formation</p>
                </div>
              </div>
              <b id="starter-count">0 / 11</b>
            </div>
            <p class="hint">Enter Base OVR and Rank for each player. The headline estimate updates as you type.</p>

            <div class="pitch">
              <img src="/assets/images/field.png" alt="FC Mobile football pitch" />
              <div class="formation" id="formation">
                {POSITIONS.map(([pos, x, y], i) => (
                  <article class="card" data-index={i} style={'--x:' + x + '%;--y:' + y + '%'}>
                    <div class="card-top">
                      <span class="position">{pos}</span>
                      <span>Player {i + 1}</span>
                    </div>
                    <input
                      data-field="baseOVR"
                      type="number"
                      min={BASE_OVR_MIN}
                      max={BASE_OVR_MAX}
                      inputmode="numeric"
                      placeholder="Base OVR"
                      aria-label={'Player ' + (i + 1) + ' Base OVR'}
                    />
                    <select data-field="rank" aria-label={'Player ' + (i + 1) + ' Rank'}>
                      <option value="">Rank</option>
                      {RANK_OPTIONS.map((rank) => <option value={rank}>Rank {rank}</option>)}
                    </select>
                    <div class="card-ovr" data-card-ovr>--</div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        </div>

        <div class="right-col">
          <section class="block overview">
            <div class="block-head">
              <div>
                <small>02</small>
                <div>
                  <h2>OVR Breakdown</h2>
                  <p>See exactly what is moving the number.</p>
                </div>
              </div>
            </div>
            <div class="ovr-lines">
              <div><span>Base OVR contribution</span><b id="break-base">--</b></div>
              <div><span>Rank contribution</span><b id="break-rank">--</b></div>
              <div><span>Badge bonus</span><b id="break-badge">+0</b></div>
              <div class="total"><span>Team OVR</span><b id="break-total">--</b></div>
            </div>
            <details>
              <summary>How was this calculated?</summary>
              <div id="math">Enter players to see the live calculation.</div>
            </details>
          </section>

          <section class="block subs-block">
            <div class="sub-heading">
              <div>
                <div class="section-kicker">03 / SQUAD DEPTH</div>
                <h2>Substitutes</h2>
                <p>Optional players are added to the same squad average.</p>
              </div>
              <div class="sub-counter">
                <strong id="sub-count">0</strong>
                <span>OF 7</span>
              </div>
            </div>

            <div class="sub-empty" id="sub-empty">
              <div class="sub-empty-icon">+</div>
              <div>
                <strong>Build your bench</strong>
                <span>Add substitutes when you want them included in the Team OVR average.</span>
              </div>
            </div>

            <div class="subs" id="subs"></div>

            <button class="add add-sub-btn" id="add-sub" type="button">
              <span>+</span>
              <b>Add Substitute</b>
              <small>MAX 7</small>
            </button>
          </section>

          <section class="block badges-block">
            <div class="block-head">
              <div>
                <small>04</small>
                <div>
                  <h2>Badges</h2>
                  <p>Each active badge contributes +1 OVR.</p>
                </div>
              </div>
              <b id="badge-total">+0 OVR</b>
            </div>
            <div class="badges">
              {Array.from({ length: MAX_BADGE_SLOTS }, (_, i) => (
                <label class="badge">
                  <input type="checkbox" data-badge={i} />
                  <span class="badge-index">0{i + 1}</span>
                  <span class="badge-copy">
                    <strong>Badge {i + 1}</strong>
                    <small>Team OVR bonus</small>
                  </span>
                  <b>+1</b>
                </label>
              ))}
            </div>
          </section>

          <section class="block planner">
            <div class="block-head">
              <div>
                <small>05</small>
                <div>
                  <h2>Reach X OVR</h2>
                  <p>Find the smallest upgrade path.</p>
                </div>
              </div>
              <span class="target-label">GOAL PLANNER</span>
            </div>
            <div class="target-row">
              <label>
                Target Team OVR
                <input id="target-ovr" type="number" min="1" max="138" value="120" inputmode="numeric" />
              </label>
              <div class="target-current">
                <small>CURRENT</small>
                <strong id="planner-current">--</strong>
              </div>
            </div>
            <div id="planner">
              <div class="planner-empty">Enter player values to calculate routes.</div>
            </div>
          </section>

          <section class="block next">
            <div class="block-head">
              <div>
                <small>06</small>
                <div>
                  <h2>Next OVR</h2>
                  <p>See what changes can move the live number.</p>
                </div>
              </div>
            </div>
            <div class="meter">
              <div class="meter-track"><span id="meter-fill"></span></div>
              <div class="meter-copy">
                <strong id="next-number">--</strong>
                <span id="next-needed">Enter player values</span>
              </div>
            </div>
            <div id="next-routes" class="next-routes"></div>
          </section>

          <section class="block bottleneck">
            <div class="block-head">
              <div>
                <small>07</small>
                <div>
                  <h2>Biggest OVR Bottleneck</h2>
                  <p>Lowest entered Base OVR.</p>
                </div>
              </div>
            </div>
            <div id="bottleneck">
              <div class="planner-empty">Enter a Base OVR to find the lowest player.</div>
            </div>
          </section>
        </div>
      </section>

      <section class="ovr-guide" aria-labelledby="ovr-guide-title">
        <div class="guide-intro">
          <div>
            <span class="guide-kicker">TEAM OVR / FIELD GUIDE</span>
            <h2 id="ovr-guide-title">Understand the number before you upgrade a player</h2>
            <p>Team OVR is not the same thing as the rating shown on one player card. It is a squad-level result, so replacing one player, adding a rank, or activating a Team Badge can change the headline even when the change looks small on the card itself.</p>
            <p>EA describes Team OVR as being based on the OVR of the players in the team together with ranks and boosts. The calculator above turns those inputs into a transparent squad calculation and keeps a live estimate visible while you build the lineup.</p>
          </div>
          <div class="guide-note">
            <span class="guide-note-label">METHOD</span>
            <strong>Live estimate first. Exact result when the included squad is complete.</strong>
            <small>Method reviewed 29 September 2026</small>
          </div>
        </div>

        <div class="guide-grid">
          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>01</span>
              <h3>What the calculator measures</h3>
            </div>
            <p><strong>Base OVR</strong> is the starting value entered for each included player. The calculator averages the Base OVR values and rounds that average up. This gives you the base portion of the Team OVR calculation.</p>
            <p><strong>Rank</strong> is entered separately because a ranked player contributes additional OVR. The calculator averages the entered rank values and rounds that average up once rank data is available.</p>
            <p><strong>Badges</strong> are represented as the selectable Team OVR bonus slots in this tool. Each active slot contributes +1 to the calculator's displayed bonus.</p>
          </article>

          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>02</span>
              <h3>Why a single upgrade can change the result</h3>
            </div>
            <p>The averages are rounded, so the visible Team OVR does not have to move one point for every one-point player upgrade. Sometimes an upgrade sits inside the same rounding boundary and the headline stays unchanged. The next upgrade can then push the average across that boundary and increase Team OVR by one.</p>
            <p>That is why the <strong>Next OVR</strong> panel and <strong>Biggest OVR Bottleneck</strong> panel look at the squad as a whole instead of simply telling you to upgrade the lowest card.</p>
          </article>

          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>03</span>
              <h3>A worked example</h3>
            </div>
            <div class="example-table" role="table" aria-label="Worked Team OVR example">
              <div role="row" class="example-row example-head"><span role="columnheader">Input</span><span role="columnheader">Squad average</span><span role="columnheader">Result</span></div>
              <div role="row" class="example-row"><span role="cell">Base OVR</span><b role="cell">112.18</b><strong role="cell">113</strong></div>
              <div role="row" class="example-row"><span role="cell">Rank</span><b role="cell">1.27</b><strong role="cell">2</strong></div>
              <div role="row" class="example-row"><span role="cell">Badge bonus</span><b role="cell">+1</b><strong role="cell">+1</strong></div>
              <div role="row" class="example-row example-total"><span role="cell">Displayed Team OVR</span><b role="cell">113 + 2 + 1</b><strong role="cell">116</strong></div>
            </div>
            <p class="guide-caption">The decimals above are deliberately shown so you can see why the displayed components become 113 and 2 after rounding up. The same rounding effect is what the calculator's upgrade planner is designed to account for.</p>
          </article>

          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>04</span>
              <h3>Rank and training are different</h3>
            </div>
            <p>Ranking a player increases the player's OVR. Training is different: EA explains that training increases player attributes, while ranking increases OVR and unlocks higher training levels.</p>
            <p>For that reason, the Team OVR calculator asks for <strong>Rank</strong>, not Training Level. Your training work can still matter a lot on the pitch, but it is not substituted for the rank value in this Team OVR calculation.</p>
          </article>

          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>05</span>
              <h3>How to use the live estimate correctly</h3>
            </div>
            <p>Start by entering the Base OVR for the players you already know. The headline updates immediately from the values entered so far. Add ranks as you verify them. This is useful when you are checking a screenshot, rebuilding a lineup, or comparing several possible replacements without having to finish every field first.</p>
            <p>Treat a partial result as a <strong>working estimate</strong>. Once every included player has both Base OVR and Rank, the tool switches to the exact calculation for that squad size.</p>
          </article>

          <article class="guide-panel">
            <div class="guide-panel-head">
              <span>06</span>
              <h3>Where to look for the next upgrade</h3>
            </div>
            <p>Use <strong>Biggest OVR Bottleneck</strong> to identify the lowest entered Base OVR. Then check <strong>Next OVR</strong> to see how much change is needed to cross the next displayed rating boundary.</p>
            <p>For a finished squad, <strong>Reach X OVR</strong> compares Base OVR, Rank, and mixed routes. That makes the planner more useful than a generic “upgrade your lowest player” rule because it shows the arithmetic behind the target.</p>
          </article>
        </div>

        <div class="guide-deep">
          <div class="guide-deep-copy">
            <span class="guide-kicker">THE CALCULATION</span>
            <h3>The formula used by this tool</h3>
            <p>For a complete squad, the tool uses the following transparent model:</p>
            <div class="formula">
              <code>Team OVR = ceil(total Base OVR ÷ squad size) + ceil(total Rank ÷ squad size) + Badge Bonus</code>
            </div>
            <p>Substitutes are included when you add them because this calculator treats them as part of the included squad average. With no complete squad, the headline intentionally remains a live estimate based on the values you have entered rather than pretending missing data is zero.</p>
            <p>This presentation is designed to make the arithmetic inspectable. EA's current help guidance describes Team OVR as the average of player OVR, ranks and boosts, while the official FC Mobile training guidance confirms that ranking a player raises their OVR.</p>
          </div>
          <div class="guide-deep-card">
            <span>OFFICIAL REFERENCE</span>
            <strong>What EA confirms</strong>
            <p>EA's current help page says Team OVR uses player OVR together with ranks and boosts. EA's ranking guide also explains that every five Training Levels allows a player to be ranked, with a +1 OVR increase per rank step.</p>
            <div class="guide-links">
              <a href="https://help.ea.com/en/articles/ea-sports-fc/fc-mobile/how-to-rank-up-players/" target="_blank" rel="noopener">EA Help · Rank Up Players ↗</a>
              <a href="https://www.ea.com/ea-originals/news/fc-mobile-training-deep-dive" target="_blank" rel="noopener">EA · Training Deep Dive ↗</a>
            </div>
          </div>
        </div>

        <div class="guide-faq">
          <div class="guide-faq-head">
            <span class="guide-kicker">FAQ</span>
            <h3>Team OVR questions that actually affect the calculation</h3>
          </div>

          <details>
            <summary>Why does my Team OVR sometimes stay the same after upgrading a player?</summary>
            <p>The calculator rounds the Base OVR and Rank averages up. An upgrade can increase a component's underlying average without crossing the next whole-number boundary. When the average finally crosses that boundary, the displayed Team OVR moves.</p>
          </details>

          <details>
            <summary>Do I need to enter all 11 players before I can see a Team OVR?</summary>
            <p>No. The headline is intentionally a live partial estimate. One valid Base OVR is enough to start it. The exact result is shown after every included player has valid Base OVR and Rank data.</p>
          </details>

          <details>
            <summary>Are substitutes included?</summary>
            <p>Yes. In this calculator, every substitute you add becomes part of the included squad average. An unfinished substitute is not treated as a completed player until both Base OVR and Rank are entered.</p>
          </details>

          <details>
            <summary>Does Training Level increase Team OVR in this calculator?</summary>
            <p>Training Level is not a Team OVR input here. EA distinguishes training from ranking: training improves attributes, while ranking increases a player's OVR. The calculator therefore asks for Rank rather than Training Level.</p>
          </details>

          <details>
            <summary>Why is the result labelled LIVE ESTIMATE before the squad is complete?</summary>
            <p>Because missing fields are not secretly converted into zeroes. The tool shows what can be calculated from the data you have entered and labels it as an estimate. That keeps the partial result useful without presenting incomplete data as a finished squad calculation.</p>
          </details>
        </div>
      </section>

      <div class="reset-row">
        <button class="reset" id="reset" type="button"><span>↺</span>Reset Squad</button>
      </div>
    </div>
  </section>

  <style>
    .ovr-tool{padding:46px 0 82px;background:var(--bg)}
    .ovr-tool .wrap{width:min(1220px,calc(100% - 30px));margin:auto}
    .head{margin-bottom:24px}
    .eyebrow,.section-kicker{font:800 9px var(--mono);letter-spacing:.16em;color:var(--blue)}
    .head h1{margin:11px 0 9px;font-size:clamp(42px,6vw,70px);line-height:.93;letter-spacing:-.06em}
    .head h1 span{color:var(--blue)}
    .head p{margin:0;color:var(--muted);font-size:13px}
    .result-card,.block{border:1px solid var(--border);border-radius:20px;background:linear-gradient(145deg,var(--surface2),var(--surface));box-shadow:0 18px 45px rgba(0,0,0,.18)}
    .result-card{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:28px;padding:20px 24px;margin-bottom:20px}
    .result-main{min-width:0}
    .result-kicker{display:flex;align-items:center;gap:8px}
    .result-kicker small{font:800 9px var(--mono);letter-spacing:.15em;color:var(--blue)}
    .live-dot{width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(107,207,242,.08)}
    .result-card strong{display:block;margin:5px 0 6px;font:900 clamp(60px,7vw,86px)/.9 var(--mono);letter-spacing:-.07em}
    .result-card p{margin:0;color:var(--muted);font-size:10px}
    .breakdown{display:grid;grid-template-columns:repeat(3,minmax(80px,1fr));min-width:360px;border-left:1px solid var(--border)}
    .breakdown div{padding:8px 18px;text-align:center}
    .breakdown div+div{border-left:1px solid var(--border)}
    .breakdown span,.ovr-lines span{display:block;font:700 7px var(--mono);color:var(--muted);letter-spacing:.08em}
    .breakdown b{display:block;margin-top:6px;font:900 18px var(--mono)}
    .workspace{display:grid;grid-template-columns:minmax(0,1.34fr) minmax(350px,.66fr);gap:20px;align-items:start}
    .left-col,.right-col{min-width:0}
    .block{padding:18px;margin-bottom:20px}
    .block-head{display:flex;align-items:center;justify-content:space-between;gap:14px}
    .block-head>div{display:flex;align-items:flex-start;gap:11px;min-width:0}
    .block-head>div>div{min-width:0}
    .block-head small{font:800 8px var(--mono);color:var(--blue);padding-top:3px}
    .block h2{margin:0;font-size:18px;letter-spacing:-.02em}
    .block-head p{margin:4px 0 0;color:var(--muted);font-size:9px}
    .block-head>b{font:900 9px var(--mono);color:var(--blue);padding:8px 9px;border:1px solid rgba(107,207,242,.28);background:var(--blue3);border-radius:9px;white-space:nowrap}
    .hint{margin:7px 0 15px;color:var(--muted);font-size:10px;line-height:1.6}
    .pitch{position:relative;width:100%;aspect-ratio:2/3;overflow:visible;border:1px solid #2c644a;border-radius:18px;background:#145335;box-shadow:inset 0 0 0 1px rgba(255,255,255,.03),0 18px 45px rgba(0,0,0,.22)}
    .pitch>img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:fill;border-radius:17px}
    .formation{position:absolute;inset:0;overflow:visible}
    .card{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:clamp(72px,12.5%,116px);padding:8px;border:1px solid rgba(107,207,242,.45);border-radius:12px;background:linear-gradient(145deg,rgba(6,18,28,.98),rgba(8,23,31,.92));box-shadow:0 12px 26px rgba(0,0,0,.34),inset 0 1px 0 rgba(255,255,255,.04);backdrop-filter:blur(8px);transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}
    .card:focus-within{transform:translate(-50%,-52%);border-color:var(--blue);box-shadow:0 16px 30px rgba(0,0,0,.38),0 0 0 3px rgba(107,207,242,.07)}
    .card-top{display:flex;align-items:center;justify-content:space-between;gap:4px;margin-bottom:6px}
    .position{font:900 9px var(--mono);color:#83dfff}
    .card-top span:last-child{font:700 6px var(--mono);color:#728995;white-space:nowrap}
    .card input,.card select{width:100%;height:30px;border:1px solid #294655;border-radius:7px;background:#0b1a24;color:#effaff;padding:0 6px;outline:0;font:800 9px var(--mono)}
    .card input{height:31px;font-size:10px;margin-bottom:5px}
    .card input::placeholder{color:#64808e}
    .card-ovr{margin-top:6px;text-align:center;color:#91e6ff;font:900 17px var(--mono);letter-spacing:-.04em}
    .ovr-lines{margin-top:12px}
    .ovr-lines>div{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
    .ovr-lines b{font:900 18px var(--mono)}
    .ovr-lines .total{padding-top:17px;border-bottom:0}
    .ovr-lines .total b{font-size:31px;color:var(--blue)}
    details{border-top:1px solid var(--border);margin-top:4px;padding-top:11px}
    details summary{cursor:pointer;list-style:none;font-size:10px;font-weight:800;color:var(--text)}
    details summary::-webkit-details-marker{display:none}
    #math{margin:12px 0 0;padding:11px;border:1px solid var(--border);border-radius:10px;background:rgba(0,0,0,.12);white-space:pre-wrap;font:700 9px/1.75 var(--mono);color:var(--muted)}
    .sub-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;padding-bottom:14px;border-bottom:1px solid var(--border)}
    .sub-heading h2{margin:4px 0 0}
    .sub-heading p{margin:4px 0 0;color:var(--muted);font-size:9px}
    .sub-counter{min-width:58px;padding:8px 9px;border:1px solid var(--border);border-radius:11px;background:rgba(0,0,0,.12);text-align:center}
    .sub-counter strong{display:block;color:var(--blue);font:900 21px/1 var(--mono)}
    .sub-counter span{display:block;margin-top:4px;color:var(--muted);font:800 6px var(--mono);letter-spacing:.08em}
    .sub-empty{display:flex;align-items:center;gap:12px;margin-top:13px;padding:13px;border:1px dashed #315061;border-radius:14px;background:linear-gradient(145deg,rgba(12,28,38,.74),rgba(8,19,27,.64))}
    .sub-empty[hidden]{display:none!important}
    .sub-empty-icon{flex:0 0 34px;width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--blue3);color:var(--blue);font:900 20px var(--mono)}
    .sub-empty strong{display:block;font-size:11px}
    .sub-empty span{display:block;margin-top:3px;color:var(--muted);font-size:9px;line-height:1.45}
    .subs{display:grid;grid-template-columns:1fr;gap:9px;margin-top:13px}
    .sub{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:13px;border:1px solid var(--border);border-radius:14px;background:linear-gradient(150deg,#0b1821,#09141b);overflow:hidden}
    .sub:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--blue);opacity:.65}
    .sub-top{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:2px}
    .sub-top-left{display:flex;align-items:center;gap:9px}
    .sub-top-left small{font:800 7px var(--mono);color:var(--blue);letter-spacing:.1em}
    .sub-top-left b{font:900 10px var(--mono)}
    .sub-status{font:800 6px var(--mono);color:var(--muted);letter-spacing:.07em;margin-left:auto;margin-right:8px}
    .sub-remove{width:28px;height:28px;border:1px solid var(--border);border-radius:8px;background:rgba(255,255,255,.02);color:#76909b;cursor:pointer;font:700 16px/1 var(--mono);transition:.15s}
    .sub-remove:hover{color:var(--text);border-color:var(--blue);background:var(--blue3)}
    .sub-field{min-width:0}
    .sub-field label{display:block;font:700 7px var(--mono);color:var(--muted);letter-spacing:.08em}
    .sub input,.sub select{display:block;width:100%;height:38px;margin-top:6px;border:1px solid #2a4351;border-radius:9px;background:#0b1b25;color:var(--text);padding:0 9px;font:800 11px var(--mono);outline:0}
    .sub input:focus,.sub select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(107,207,242,.06)}
    .sub-foot{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:1px;padding-top:9px;border-top:1px solid var(--border)}
    .sub-foot-copy span{display:block;color:var(--muted);font:700 7px var(--mono);letter-spacing:.08em}
    .sub-foot-copy small{display:block;margin-top:3px;color:#6f8793;font-size:8px}
    .sub-foot strong{color:var(--blue);font:900 21px var(--mono)}
    .add{width:100%;min-height:46px;border:1px dashed #365565;border-radius:12px;background:linear-gradient(145deg,rgba(13,29,39,.55),rgba(7,18,25,.45));color:var(--text);cursor:pointer;transition:.16s}
    .add-sub-btn{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:10px}
    .add-sub-btn span{display:grid;place-items:center;width:22px;height:22px;border-radius:7px;background:var(--blue3);color:var(--blue);font:900 17px/1 var(--mono)}
    .add-sub-btn b{font-size:10px}
    .add-sub-btn small{margin-left:auto;margin-right:10px;color:var(--muted);font:800 6px var(--mono);letter-spacing:.08em}
    .add:hover{border-color:var(--blue);background:var(--blue3)}
    .add:disabled{cursor:not-allowed;opacity:.55}
    .badges{display:grid;gap:8px;margin-top:13px}
    .badge{display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:9px;padding:11px 12px;border:1px solid var(--border);border-radius:12px;background:rgba(8,19,27,.48);cursor:pointer;transition:.15s}
    .badge:hover{border-color:#355569}
    .badge input{width:17px;height:17px;margin:0;accent-color:var(--blue);cursor:pointer}
    .badge-index{font:800 7px var(--mono);color:#67828f}
    .badge-copy strong{display:block;font-size:9px}
    .badge-copy small{display:block;margin-top:2px;color:var(--muted);font-size:7px}
    .badge>b{font:900 12px var(--mono);color:var(--blue)}
    .target-label{font:800 7px var(--mono);color:var(--blue);white-space:nowrap}
    .target-row{display:grid;grid-template-columns:1fr 110px;gap:10px;margin-top:13px;align-items:end}
    .target-row label{font-size:9px;font-weight:800;color:var(--muted)}
    .target-row input{display:block;width:100%;height:44px;margin-top:6px;border:1px solid var(--border);border-radius:10px;background:rgba(0,0,0,.12);color:var(--text);padding:0 10px;outline:0;font:900 18px var(--mono)}
    .target-row input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(107,207,242,.06)}
    .target-current{height:44px;padding:5px 8px;border:1px solid var(--border);border-radius:10px;background:rgba(0,0,0,.12);text-align:center}
    .target-current small{font:700 6px var(--mono);color:var(--muted);letter-spacing:.1em}
    .target-current strong{display:block;margin-top:3px;font:900 18px var(--mono)}
    .planner-empty{padding:13px;border:1px dashed #315061;border-radius:11px;color:var(--muted);background:rgba(8,19,27,.36);font-size:9px;line-height:1.6;margin-top:12px}
    .route{padding:12px;margin-top:9px;border:1px solid var(--border);border-radius:11px;background:rgba(8,19,27,.55)}
    .route.best{border-color:var(--blue);box-shadow:0 0 0 1px rgba(107,207,242,.05)}
    .route-title{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px;font-weight:900}
    .route-title span{font:800 7px var(--mono);color:var(--blue)}
    .route p{margin:7px 0 0;color:var(--muted);font-size:9px;line-height:1.6}
    .meter{padding-top:11px}
    .meter-track{height:10px;border:1px solid var(--border);border-radius:99px;background:rgba(0,0,0,.14);overflow:hidden}
    .meter-track span{display:block;width:0;height:100%;background:var(--blue);transition:width .2s ease}
    .meter-copy{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:9px}
    .meter-copy strong{font:900 22px var(--mono)}
    .meter-copy span{color:var(--muted);font-size:8px;text-align:right}
    .next-routes{margin-top:9px;color:var(--muted);font-size:9px;line-height:1.65}
    .bottleneck-card{display:flex;align-items:center;gap:12px;padding:12px;margin-top:12px;border:1px solid var(--border);border-radius:11px;background:rgba(8,19,27,.5)}
    .bottleneck-ovr{min-width:48px;color:var(--blue);font:900 24px var(--mono)}
    .bottleneck-card strong{font-size:10px}
    .bottleneck-card p{margin:3px 0 0;color:var(--muted);font-size:8px;line-height:1.5}
    .reset-row{display:flex;justify-content:flex-end;margin-top:2px}
    .reset{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 14px;border:1px solid var(--border);border-radius:11px;background:var(--surface);color:var(--muted);cursor:pointer;font-weight:800}
    .reset span{font-size:15px;color:var(--blue)}
    .reset:hover{color:var(--text);border-color:var(--blue)}
    @media(max-width:980px){
      .workspace{grid-template-columns:1fr}
      .pitch{width:min(100%,660px);margin-inline:auto}
      .right-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
      .right-col .block{margin-bottom:0}
      .right-col .overview,.right-col .subs-block{grid-column:1/-1}
    }
    @media(max-width:720px){
      .ovr-tool{padding-top:28px}
      .ovr-tool .wrap{width:calc(100% - 18px)}
      .head h1{font-size:clamp(40px,12vw,61px)}
      .result-card{display:block;padding:17px 16px;border-radius:17px}
      .result-card strong{font-size:56px}
      .breakdown{min-width:0;margin-top:14px;border-left:0;border-top:1px solid var(--border);padding-top:10px}
      .breakdown div{padding:5px 8px}
      .workspace{gap:14px}
      .block{padding:14px;border-radius:16px}
      .right-col{display:block}
      .right-col .block{margin-bottom:14px}
      .pitch{aspect-ratio:2/3}
      .card{width:clamp(61px,18vw,83px);padding:5px}
      .card-top{margin-bottom:4px}
      .card-top span:last-child{font-size:5.5px}
      .card input{height:27px;font-size:9px}
      .card select{height:23px;font-size:7px}
      .card-ovr{margin-top:4px;font-size:12px}
      .sub{grid-template-columns:1fr 1fr;padding:12px}
      .target-row{grid-template-columns:1fr 92px}
      .reset-row{justify-content:stretch}
      .reset{width:100%}
    }
    @media(max-width:390px){
      .ovr-tool .wrap{width:calc(100% - 14px)}
      .block{padding:12px}
      .pitch{min-height:490px}
      .card{width:57px;padding:4px}
      .card input{height:25px;font-size:8px}
      .card select{height:21px;font-size:6.5px}
      .card-top span:last-child{font-size:5px}
      .card-ovr{font-size:11px}
      .sub{padding:11px}
    }
  </style>
  <script src="../scripts/team-ovr.js"></script>
</BaseLayout>
