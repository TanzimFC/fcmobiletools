---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANK_OPTIONS, STARTING_XI_SIZE, MAX_SQUAD_SIZE, MAX_BADGE_SLOTS, BASE_OVR_MIN, BASE_OVR_MAX } from '../lib/teamOvr.js';
const POSITIONS=[['GK',50,88],['LB',18,68],['CB',38,73],['CB',62,73],['RB',82,68],['CM',30,49],['CM',50,45],['CM',70,49],['LW',17,25],['ST',50,18],['RW',83,25]];
const POSITION_OPTIONS=['GK','LB','CB','RB','CDM','CM','CAM','LM','RM','LW','RW','CF','ST'];
const MAX_SUBS=MAX_SQUAD_SIZE-STARTING_XI_SIZE;
---
<BaseLayout title="FC Mobile Team OVR Calculator" description="Calculate FC Mobile Team OVR from Base OVR, Rank and Team OVR bonuses.">
<section class="ovr-tool"><div class="wrap">
<header class="head"><div class="eyebrow">TANZIMFC TOOL / FC MOBILE</div><h1>Team OVR <span>Calculator</span></h1><p>Build your squad in a 4-3-3 formation and see your Team OVR update instantly.</p></header>
<section class="result-card"><div><small id="result-label">LIVE ESTIMATE</small><strong id="result-number">--</strong><p id="result-status">Enter a Base OVR to start the estimate.</p></div><div class="breakdown"><div><span>BASE AVG</span><b id="base-avg">--</b></div><div><span>RANK AVG</span><b id="rank-avg">--</b></div><div><span>BADGES</span><b id="badge-avg">+0</b></div></div></section>
<section class="block"><div class="block-head"><div><small>01</small><h2>Starting XI</h2></div><b id="starter-count">0 / 11</b></div><p class="hint">Default formation: 4-3-3. Enter Base OVR and Rank. The result changes immediately.</p>
<div class="pitch"><img src="/assets/images/field.png" alt="FC Mobile football pitch"/><div class="formation" id="formation">{POSITIONS.map(([pos,x,y],i)=><article class="card" data-index={i} style={`--x:${x}%;--y:${y}%`}><div class="card-top"><select data-field="position" aria-label={`Position ${i+1}`}>{POSITION_OPTIONS.map(p=><option value={p} selected={p===pos}>{p}</option>)}</select><span>{i+1}</span></div><input data-field="baseOVR" type="number" min={BASE_OVR_MIN} max={BASE_OVR_MAX} inputmode="numeric" placeholder="OVR" aria-label={`Base OVR ${i+1}`}/><select data-field="rank" aria-label={`Rank ${i+1}`}><option value="">Rank</option>{RANK_OPTIONS.map(r=><option value={r}>Rank {r}</option>)}</select><div class="card-ovr" data-card-ovr>--</div></article>)}</div></div></section>
<section class="block"><div class="block-head"><div><small>02</small><h2>Substitutes <i>Optional</i></h2></div><b id="sub-count">0 included</b></div><p class="hint">Add up to 7. Completed substitutes are included in the squad average and change the divisor.</p><div class="subs" id="subs"></div><button class="add" id="add-sub" type="button">+ Add Substitute</button></section>
<section class="block"><div class="block-head"><div><small>03</small><h2>Badges</h2></div><b id="badge-total">+0 OVR</b></div><p class="hint">Three simple bonus ticks. Each enabled badge adds exactly +1 Team OVR.</p><div class="badges">{Array.from({length:MAX_BADGE_SLOTS},(_,i)=><label class="badge"><input type="checkbox" data-badge={i}/><span>Badge {i+1}</span><b>+1 OVR</b></label>)}</div></section>
<details class="how block"><summary>How is my Team OVR calculated?</summary><div id="math">Enter players to see the live calculation.</div><p>Final Team OVR = rounded-up Base OVR average + rounded-up Rank average + enabled Badge bonuses. For a complete squad, the divisor is the number of players in the squad.</p></details>
<button class="reset" id="reset" type="button">Reset Squad</button>
</div></section>
</BaseLayout>
<style>
.ovr-tool{padding:48px 0 80px}.wrap{width:min(1080px,calc(100% - 28px));margin:auto}.head{margin-bottom:24px}.eyebrow{font:800 10px var(--mono);letter-spacing:.16em;color:var(--blue)}.head h1{font-size:clamp(38px,6vw,66px);line-height:.95;letter-spacing:-.055em;margin:12px 0}.head h1 span{color:var(--blue)}.head p{color:var(--muted);margin:0;font-size:14px}.result-card,.block{border:1px solid var(--border);background:var(--surface);border-radius:18px}.result-card{position:sticky;top:10px;z-index:10;padding:18px 20px;margin-bottom:24px;display:flex;justify-content:space-between;align-items:center;gap:20px;background:linear-gradient(135deg,var(--surface2),var(--surface))}.result-card small{font:800 9px var(--mono);letter-spacing:.16em;color:var(--blue)}.result-card strong{display:block;font:900 56px/.95 var(--mono);letter-spacing:-.06em;margin:7px 0}.result-card p{margin:0;color:var(--muted);font-size:11px}.breakdown{display:grid;grid-template-columns:repeat(3,1fr);min-width:260px;border-left:1px solid var(--border)}.breakdown div{text-align:center;padding:5px 14px}.breakdown div+div{border-left:1px solid var(--border)}.breakdown span{display:block;font:700 8px var(--mono);color:var(--muted)}.breakdown b{display:block;font:900 16px var(--mono);margin-top:5px}.block{padding:18px;margin:22px 0}.block-head{display:flex;align-items:center;justify-content:space-between;gap:15px}.block-head>div{display:flex;align-items:center;gap:11px}.block-head small{font:800 9px var(--mono);color:var(--blue)}.block h2{margin:0;font-size:19px}.block h2 i{font:700 8px var(--mono);color:var(--muted);font-style:normal;margin-left:5px}.block-head>b{font:800 9px var(--mono);color:var(--blue);background:var(--blue3);padding:8px 9px;border-radius:8px}.hint{font-size:11px;color:var(--muted);margin:6px 0 15px}.pitch{position:relative;aspect-ratio:1.5/1;border-radius:16px;overflow:hidden;border:1px solid #2d6249;background:#145335}.pitch>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.formation{position:absolute;inset:0}.card{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:105px;padding:7px;background:#07131de8;border:1px solid #6bcff2;border-radius:10px;box-shadow:0 8px 20px #0008;backdrop-filter:blur(5px)}.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}.card-top select,.card>input,.card>select{width:100%;height:27px;border:1px solid #294657;border-radius:6px;background:#0c1c27;color:#effaff;font:800 9px var(--mono);padding:0 5px;outline:0}.card-top select{width:65px}.card-top span{font:700 7px var(--mono);color:#6c8494}.card>input{height:31px;font-size:13px;margin-bottom:4px}.card-ovr{text-align:center;font:900 10px var(--mono);color:#79ddff;margin-top:4px}.card input:focus,.card select:focus{border-color:var(--blue);outline:none}.subs{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.sub{border:1px solid var(--border);background:var(--surface2);border-radius:12px;padding:10px}.sub-top{display:flex;justify-content:space-between;margin-bottom:7px}.sub-top b{font:800 8px var(--mono);color:var(--muted)}.sub-remove{border:0;background:none;color:var(--muted);cursor:pointer}.sub input,.sub select{width:100%;height:36px;margin-top:5px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text);padding:0 8px}.add,.reset{width:100%;min-height:44px;border:1px dashed var(--border);border-radius:11px;background:transparent;color:var(--muted);font-weight:800;cursor:pointer}.add{margin-top:11px}.add:hover,.reset:hover{border-color:var(--blue);color:var(--text)}.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.badge{display:flex;align-items:center;gap:10px;padding:15px;border:1px solid var(--border);border-radius:12px;background:var(--surface2);cursor:pointer}.badge input{width:18px;height:18px;accent-color:var(--blue)}.badge span{font-weight:800;font-size:13px;flex:1}.badge b{font:900 10px var(--mono);color:var(--blue)}.how summary{cursor:pointer;font-weight:800}.how #math{font:700 11px/1.8 var(--mono);color:var(--muted);white-space:pre-wrap;margin:15px 0}.how p{font-size:11px;line-height:1.7;color:var(--muted);border-left:2px solid var(--blue);padding-left:10px}.reset{margin-top:14px;background:var(--surface);border-style:solid}@media(max-width:760px){.result-card{position:relative;top:auto;display:block}.breakdown{margin-top:14px;border-left:0;border-top:1px solid var(--border);padding-top:10px}.pitch{aspect-ratio:1/1.3}.card{width:82px;padding:5px}.card-top select{width:53px}.card>input{height:27px;font-size:11px}.card-top select,.card>select{height:24px;font-size:7px}.card-ovr{font-size:8px}.subs{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.wrap{width:calc(100% - 18px)}.head h1{font-size:39px}.pitch{aspect-ratio:.75/1}.card{width:72px}.card-top select{width:46px}.badges{grid-template-columns:1fr}.breakdown div{padding:5px 6px}}
</style>
<script>
import {calculateTeamOVR,isValidBaseOVR,isValidRank} from '../lib/teamOvr.js';
const formation=document.getElementById('formation'),subsEl=document.getElementById('subs'),addSub=document.getElementById('add-sub'),reset=document.getElementById('reset');
const state={starters:POSITIONS.map(()=>({baseOVR:null,rank:null})),subs:[],badges:Array(MAX_BADGE_SLOTS).fill(false)};let subId=0;
formation.querySelectorAll('.card').forEach((el,i)=>{const p=state.starters[i];el.querySelector('[data-field="baseOVR"]').addEventListener('input',e=>{p.baseOVR=e.target.value===''?null:Number(e.target.value);recompute()});el.querySelector('[data-field="rank"]').addEventListener('change',e=>{p.rank=e.target.value===''?null:Number(e.target.value);recompute()})});
function renderSubs(){subsEl.innerHTML='';state.subs.forEach((s,i)=>{const el=document.createElement('article');el.className='sub';el.innerHTML=`<div class="sub-top"><b>SUB ${i+1}</b><button class="sub-remove" type="button">×</button></div><label>Base OVR<input data-base type="number" min="${BASE_OVR_MIN}" max="${BASE_OVR_MAX}" placeholder="OVR"></label><label>Rank<select data-rank><option value="">Rank</option>${RANK_OPTIONS.map(r=>`<option value="${r}">Rank ${r}</option>`).join('')}</select></label>`;el.querySelector('[data-base]').addEventListener('input',e=>{s.baseOVR=e.target.value===''?null:Number(e.target.value);recompute()});el.querySelector('[data-rank]').addEventListener('change',e=>{s.rank=e.target.value===''?null:Number(e.target.value);recompute()});el.querySelector('.sub-remove').addEventListener('click',()=>{state.subs=state.subs.filter(x=>x!==s);renderSubs();recompute()});subsEl.appendChild(el)});addSub.disabled=state.subs.length>=MAX_SUBS;addSub.textContent=state.subs.length>=MAX_SUBS?'Maximum substitutes reached':'+ Add Substitute'}
addSub.addEventListener('click',()=>{if(state.subs.length>=MAX_SUBS)return;subId++;state.subs.push({id:subId,baseOVR:null,rank:null});renderSubs();recompute()});
document.querySelectorAll('[data-badge]').forEach((el,i)=>el.addEventListener('change',()=>{state.badges[i]=el.checked;recompute()}));
function valid(p){return isValidBaseOVR(p.baseOVR)&&isValidRank(p.rank)}
function recompute(){const all=[...state.starters,...state.subs],completePlayers=all.filter(valid),basePlayers=all.filter(p=>isValidBaseOVR(p.baseOVR)),rankPlayers=all.filter(p=>isValidRank(p.rank)),badgeBonus=state.badges.filter(Boolean).length,baseAvg=basePlayers.length?Math.ceil(basePlayers.reduce((s,p)=>s+p.baseOVR,0)/basePlayers.length):null,rankAvg=rankPlayers.length?Math.ceil(rankPlayers.reduce((s,p)=>s+p.rank,0)/rankPlayers.length):0,exact=state.starters.every(valid)&&state.subs.every(valid),result=calculateTeamOVR({players:completePlayers,selectedBadges:state.badges.map(enabled=>({enabled})),requiredCount:completePlayers.length}),total=baseAvg===null?null:baseAvg+rankAvg+badgeBonus;
document.getElementById('starter-count').textContent=`${state.starters.filter(valid).length} / ${STARTING_XI_SIZE}`;document.getElementById('sub-count').textContent=`${state.subs.length} included`;document.getElementById('badge-total').textContent=`+${badgeBonus} OVR`;document.getElementById('base-avg').textContent=baseAvg===null?'--':baseAvg;document.getElementById('rank-avg').textContent=rankAvg;document.getElementById('badge-avg').textContent=`+${badgeBonus}`;document.getElementById('result-number').textContent=total===null?'--':total;document.getElementById('result-label').textContent=exact?'YOUR TEAM OVR':'LIVE ESTIMATE';document.getElementById('result-status').textContent=exact?`${all.length}-player squad · Exact formula`:`Based on ${basePlayers.length} Base OVR${basePlayers.length===1?'':'s'} entered so far`;
formation.querySelectorAll('.card').forEach((el,i)=>{const p=state.starters[i],shown=isValidBaseOVR(p.baseOVR)&&isValidRank(p.rank)?p.baseOVR+p.rank:(isValidBaseOVR(p.baseOVR)?p.baseOVR:'--');el.querySelector('[data-card-ovr]').textContent=shown});document.getElementById('math').textContent=exact&&result.complete?`Base OVR\n${result.totalBase} ÷ ${result.squadSize} = ${(result.totalBase/result.squadSize).toFixed(2)} → ${result.baseAverage}\n\nRank\n${result.totalRank} ÷ ${result.squadSize} = ${(result.totalRank/result.squadSize).toFixed(2)} → ${result.rankAverage}\n\nBadges\n+${result.badgeBonus}\n\nFinal\n${result.baseAverage} + ${result.rankAverage} + ${result.badgeBonus} = ${result.teamOVR}`:total===null?'Enter a Base OVR to see the estimate.':`Live estimate\nBase average: ${baseAvg}\nRank average: ${rankAvg}\nBadges: +${badgeBonus}\n\nEstimated Team OVR: ${total}`}
reset.addEventListener('click',()=>{if(!confirm('Reset the squad?'))return;state.starters.forEach(p=>{p.baseOVR=null;p.rank=null});state.subs=[];state.badges.fill(false);formation.querySelectorAll('[data-field="baseOVR"]').forEach(x=>x.value='');formation.querySelectorAll('[data-field="rank"]').forEach(x=>x.value='');document.querySelectorAll('[data-badge]').forEach(x=>x.checked=false);renderSubs();recompute()});renderSubs();recompute();
</script>
