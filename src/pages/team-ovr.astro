---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  FORMATIONS,
  DEFAULT_FORMATION,
  getFormation,
  RANK_OPTIONS,
  STARTING_XI_SIZE,
  MAX_BENCH_SIZE,
  MAX_BADGE_SLOTS,
  BASE_OVR_MIN,
  BASE_OVR_MAX,
} from '../lib/teamOvr.js';

const formation = getFormation(DEFAULT_FORMATION);
const svg = (body, size = 16, sw = 2) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
const ico = {
  share: svg('<path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/>'),
  paste: svg('<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 14h6M9 18h4"/>'),
  reset: svg('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>'),
  prev: svg('<path d="M15 6l-6 6 6 6"/>', 18, 2.4),
  next: svg('<path d="M9 6l6 6-6 6"/>', 18, 2.4),
  close: svg('<path d="M6 6l12 12M18 6L6 18"/>', 18, 2.4),
  bolt: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>',
  check: svg('<path d="M5 12.5 10 17.5 19 7"/>', 14, 3.2),
};
---
<BaseLayout
  title="FC Mobile Team OVR Calculator"
  description="Calculate your FC Mobile Team OVR from Base OVR, Rank and Team Badges, then see the cheapest upgrades to reach your target rating."
>
  <main class="tovr" id="tovr" data-min={BASE_OVR_MIN} data-max={BASE_OVR_MAX}>
    <div class="tovr-wrap">

      <header class="t-head">
        <span class="t-eyebrow">FC MOBILE TOOLS <i></i> TEAM OVR</span>
        <h1>Team OVR <em>Calculator</em></h1>
        <p>Drop in your squad, watch the rating update live, and see the cheapest way to reach your next target.</p>
      </header>

      <!-- ============ RESULT ============ -->
      <section class="hero" id="hero" data-state="empty" aria-label="Team OVR result">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="gauge" aria-live="polite" aria-atomic="true">
          <svg class="ring" viewBox="0 0 200 200" aria-hidden="true">
            <defs>
              <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#B6EEFF" />
                <stop offset="1" stop-color="#2FB6F5" />
              </linearGradient>
            </defs>
            <circle class="ring-track" cx="100" cy="100" r="88" pathLength="100" />
            <circle class="ring-arc" id="ring-arc" cx="100" cy="100" r="88" pathLength="100" transform="rotate(-90 100 100)" />
          </svg>
          <div class="gauge-core">
            <small>TEAM OVR</small>
            <strong id="hero-number">--</strong>
            <span class="pill" id="hero-state" data-state="empty">Waiting for players</span>
          </div>
        </div>

        <div class="hero-side">
          <div class="equation" aria-label="How the Team OVR is made up">
            <div class="eq-tile">
              <span>Base</span>
              <b id="eq-base">--</b>
              <small id="eq-base-sub">avg --</small>
            </div>
            <div class="eq-op" aria-hidden="true">+</div>
            <div class="eq-tile">
              <span>Rank</span>
              <b id="eq-rank">--</b>
              <small id="eq-rank-sub">avg --</small>
            </div>
            <div class="eq-op" aria-hidden="true">+</div>
            <div class="eq-tile">
              <span>Badges</span>
              <b id="eq-badge">0</b>
              <small id="eq-badge-sub">0 of {MAX_BADGE_SLOTS}</small>
            </div>
          </div>

          <div class="next-hint" id="next-hint">
            <div class="next-copy">
              <span class="next-kicker">NEXT UP</span>
              <p id="next-text">Add your starting XI to see what the next point costs.</p>
            </div>
            <button type="button" class="btn btn-ghost" id="next-plan" hidden>Plan it</button>
          </div>
        </div>
      </section>

      <!-- ============ WORKSPACE ============ -->
      <div class="layout">
        <div class="col-main">
          <section class="panel squad" id="squad" aria-labelledby="squad-title">
            <div class="panel-head">
              <div>
                <h2 id="squad-title">Your squad</h2>
                <p><b id="squad-count">0 / {STARTING_XI_SIZE}</b> starters entered · <span id="bench-count">0</span> on the bench</p>
              </div>
              <div class="seg seg-view" role="group" aria-label="Squad view">
                <button type="button" data-view="pitch" aria-pressed="true">Pitch</button>
                <button type="button" data-view="list" aria-pressed="false">List</button>
              </div>
            </div>

            <div class="toolbar">
              <label class="select">
                <span class="sr-only">Formation</span>
                <select id="formation-select" aria-label="Formation">
                  {FORMATIONS.map((f) => <option value={f.id} selected={f.id === DEFAULT_FORMATION}>{f.label}</option>)}
                </select>
              </label>
              <button type="button" class="btn btn-ghost" id="quick-open"><span set:html={ico.paste}></span>Quick fill</button>
              <button type="button" class="btn btn-ghost" id="share"><span set:html={ico.share}></span>Share</button>
              <button type="button" class="btn btn-ghost btn-danger" id="reset"><span set:html={ico.reset}></span><span id="reset-label">Reset</span></button>
            </div>

            <!-- Pitch view -->
            <div class="view" id="view-pitch">
              <div class="pitch" id="pitch">
                <svg class="pitch-lines" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true">
                  <g fill="none" stroke="currentColor" stroke-width="1.2" vector-effect="non-scaling-stroke">
                    <rect x="4" y="4" width="92" height="132" rx="1.5" vector-effect="non-scaling-stroke" />
                    <path d="M4 70h92" vector-effect="non-scaling-stroke" />
                    <circle cx="50" cy="70" r="12" vector-effect="non-scaling-stroke" />
                    <rect x="22" y="4" width="56" height="21" vector-effect="non-scaling-stroke" />
                    <rect x="36" y="4" width="28" height="8" vector-effect="non-scaling-stroke" />
                    <path d="M39 25a12 12 0 0 0 22 0" vector-effect="non-scaling-stroke" />
                    <rect x="22" y="115" width="56" height="21" vector-effect="non-scaling-stroke" />
                    <rect x="36" y="128" width="28" height="8" vector-effect="non-scaling-stroke" />
                    <path d="M39 115a12 12 0 0 1 22 0" vector-effect="non-scaling-stroke" />
                  </g>
                </svg>
                <div class="chips" id="chips">
                  {formation.slots.map((slot, i) => (
                    <button
                      type="button"
                      class="chip"
                      data-group="starter"
                      data-index={i}
                      data-tier="empty"
                      style={`--x:${slot.x};--y:${slot.y}`}
                      aria-label={`Starter ${i + 1}, ${slot.pos}, empty`}
                    >
                      <span class="chip-pos" data-pos>{slot.pos}</span>
                      <span class="chip-ovr" data-ovr>--</span>
                      <span class="chip-pips" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                    </button>
                  ))}
                </div>
              </div>

              <div class="bench">
                <div class="bench-head">
                  <h3>Bench</h3>
                  <p>Any sub with a Base OVR joins the squad average. Leave a slot empty to exclude it.</p>
                </div>
                <div class="bench-grid" id="bench-grid">
                  {Array.from({ length: MAX_BENCH_SIZE }, (_, i) => (
                    <button
                      type="button"
                      class="chip chip--bench"
                      data-group="bench"
                      data-index={i}
                      data-tier="empty"
                      aria-label={`Substitute ${i + 1}, empty`}
                    >
                      <span class="chip-pos" data-pos>SUB {i + 1}</span>
                      <span class="chip-ovr" data-ovr>--</span>
                      <span class="chip-pips" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <!-- List view (rows are built by the script) -->
            <div class="view" id="view-list" hidden>
              <div class="list" id="list"></div>
            </div>

            <p class="saved" id="saved"><span class="dot"></span>Saved automatically on this device</p>
          </section>

          <section class="panel badges" aria-labelledby="badges-title">
            <div class="panel-head">
              <div>
                <h2 id="badges-title">Team Badges</h2>
                <p>Each active badge adds +1 to Team OVR.</p>
              </div>
              <b class="total-pill" id="badge-total">+0</b>
            </div>
            <div class="badge-list">
              {Array.from({ length: MAX_BADGE_SLOTS }, (_, i) => (
                <button type="button" class="badge" data-badge={i} aria-pressed="false">
                  <span class="badge-check" aria-hidden="true" set:html={ico.check}></span>
                  <span class="badge-copy"><b>Badge {i + 1}</b><small>Team OVR bonus</small></span>
                  <em>+1</em>
                </button>
              ))}
            </div>
          </section>
        </div>

        <!-- Player editor: docked on desktop, bottom sheet on mobile -->
        <section class="panel editor" id="editor" data-open="false" aria-labelledby="ed-title">
          <div class="ed-grab" aria-hidden="true"></div>
          <header class="ed-head">
            <div class="ed-who">
              <span class="ed-kicker" id="ed-kicker">STARTER 1</span>
              <h2 id="ed-title">GK</h2>
            </div>
            <div class="ed-nav">
              <button type="button" class="icon-btn" id="ed-prev" aria-label="Previous player"><span set:html={ico.prev}></span></button>
              <button type="button" class="icon-btn" id="ed-next-icon" aria-label="Next player"><span set:html={ico.next}></span></button>
              <button type="button" class="icon-btn ed-close" id="ed-close" aria-label="Close editor"><span set:html={ico.close}></span></button>
            </div>
          </header>

          <div class="ed-body">
            <div class="field">
              <label for="ed-base">Base OVR</label>
              <div class="stepper">
                <button type="button" class="step" id="ed-minus" aria-label="Decrease Base OVR">−</button>
                <input id="ed-base" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="e.g. 117" maxlength="3" aria-describedby="ed-msg" />
                <button type="button" class="step" id="ed-plus" aria-label="Increase Base OVR">+</button>
              </div>
              <p class="field-msg" id="ed-msg" role="status">Between {BASE_OVR_MIN} and {BASE_OVR_MAX}. Press Enter for the next player.</p>
            </div>

            <div class="field">
              <span class="label" id="ed-rank-label">Rank</span>
              <div class="seg seg-rank" id="ed-rank" role="group" aria-labelledby="ed-rank-label">
                {RANK_OPTIONS.map((r) => <button type="button" data-rank={r} aria-pressed={r === 0 ? 'true' : 'false'}>{r}</button>)}
              </div>
            </div>

            <div class="ed-preview">
              <div>
                <span class="label">Player OVR</span>
                <p>Base OVR plus Rank</p>
              </div>
              <strong id="ed-ovr" data-tier="empty">--</strong>
            </div>
          </div>

          <footer class="ed-foot">
            <button type="button" class="btn btn-ghost" id="ed-clear">Clear</button>
            <button type="button" class="btn btn-primary" id="ed-next">Next player <span set:html={ico.next}></span></button>
          </footer>
        </section>
      </div>

      <div class="lower">
        <section class="panel planner" id="planner" aria-labelledby="planner-title">
          <div class="panel-head">
            <div>
              <h2 id="planner-title">Upgrade planner</h2>
              <p>The fewest upgrades to hit your target.</p>
            </div>
            <span class="tag"><span set:html={ico.bolt}></span>Goal</span>
          </div>

          <div class="target">
            <div class="target-ctl">
              <button type="button" class="step" id="t-minus" aria-label="Lower target">−</button>
              <label class="target-box">
                <span>Target OVR</span>
                <input id="t-input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="3" autocomplete="off" />
              </label>
              <button type="button" class="step" id="t-plus" aria-label="Raise target">+</button>
            </div>
            <div class="jumps" role="group" aria-label="Quick targets">
              <button type="button" data-jump="1">+1</button>
              <button type="button" data-jump="2">+2</button>
              <button type="button" data-jump="3">+3</button>
              <button type="button" data-jump="5">+5</button>
            </div>
          </div>

          <div id="routes" class="routes" aria-live="polite"></div>
        </section>

        <section class="panel weak" aria-labelledby="weak-title">
          <div class="panel-head">
            <div>
              <h2 id="weak-title">Weakest links</h2>
              <p>Lowest Base OVR in your squad, glowing red on the pitch.</p>
            </div>
          </div>
          <div id="weak-list" class="weak-list"></div>
        </section>
      </div>

      <!-- ============ GUIDE ============ -->
      <section class="guide" aria-labelledby="guide-title">
        <div class="guide-intro">
          <div>
            <span class="t-eyebrow">TEAM OVR <i></i> FIELD GUIDE</span>
            <h2 id="guide-title">Understand the number before you upgrade a player</h2>
            <p>Team OVR is not the same thing as the rating on a single player card. It is a squad-level result, so replacing one player, adding a rank, or activating a Team Badge can change the headline even when the change looks small on the card itself.</p>
            <p>EA describes Team OVR as being based on the OVR of the players in the team together with ranks and boosts. This calculator turns those inputs into a transparent squad calculation and keeps a live estimate on screen while you build the lineup.</p>
          </div>
          <div class="guide-note">
            <span>METHOD</span>
            <strong>Live estimate first. Exact result once all 11 starters are in.</strong>
            <small>Method reviewed 29 September 2026</small>
          </div>
        </div>

        <div class="guide-grid">
          <article>
            <h3><i>01</i>What the calculator measures</h3>
            <p><strong>Base OVR</strong> is the starting rating you enter for each player. The calculator averages the Base OVR values and rounds that average up.</p>
            <p><strong>Rank</strong> is entered separately because a ranked player contributes additional OVR. The rank values are averaged and rounded up the same way.</p>
            <p><strong>Badges</strong> are the selectable Team OVR bonus slots. Each active slot adds +1.</p>
          </article>

          <article>
            <h3><i>02</i>Why one upgrade can change nothing</h3>
            <p>Both averages are rounded up, so the headline does not move one point for every one-point upgrade. Sometimes an upgrade stays inside the same rounding boundary and the headline holds. The next upgrade then pushes the average over the line and Team OVR goes up by one.</p>
            <p>That is why <strong>Next up</strong> and the <strong>Upgrade planner</strong> look at the squad as a whole instead of just telling you to upgrade your lowest card.</p>
          </article>

          <article>
            <h3><i>03</i>A worked example</h3>
            <div class="example" role="table" aria-label="Worked Team OVR example">
              <div role="row" class="ex-head"><span role="columnheader">Input</span><span role="columnheader">Squad average</span><span role="columnheader">Result</span></div>
              <div role="row"><span role="cell">Base OVR</span><b role="cell">112.18</b><strong role="cell">113</strong></div>
              <div role="row"><span role="cell">Rank</span><b role="cell">1.27</b><strong role="cell">2</strong></div>
              <div role="row"><span role="cell">Badge bonus</span><b role="cell">+1</b><strong role="cell">+1</strong></div>
              <div role="row" class="ex-total"><span role="cell">Team OVR</span><b role="cell">113 + 2 + 1</b><strong role="cell">116</strong></div>
            </div>
            <p class="caption">The decimals are shown on purpose so you can see why 112.18 and 1.27 become 113 and 2. This is the same rounding the planner works around.</p>
          </article>

          <article>
            <h3><i>04</i>Rank and training are different</h3>
            <p>Ranking a player increases the player's OVR. Training is different: EA explains that training increases player attributes, while ranking increases OVR and unlocks higher training levels.</p>
            <p>That is why this calculator asks for <strong>Rank</strong>, not Training Level. Training still matters on the pitch, but it is not a Team OVR input here.</p>
          </article>

          <article>
            <h3><i>05</i>Using the live estimate</h3>
            <p>Start with the Base OVR of the players you already know. The headline updates as you type, and Rank defaults to 0 until you set it. Use <strong>Quick fill</strong> to paste a whole lineup at once, for example <code>117 116/2 118</code>, where the number after the slash is the Rank.</p>
            <p>Treat a partial result as a <strong>working estimate</strong>. Once all 11 starters have a Base OVR, the calculator switches to the exact result for your squad size.</p>
          </article>

          <article>
            <h3><i>06</i>Finding the next upgrade</h3>
            <p><strong>Weakest links</strong> lists your lowest Base OVR players, and they glow red on the pitch. <strong>Next up</strong> shows what it costs to move the headline by one point.</p>
            <p>For bigger goals, the <strong>Upgrade planner</strong> compares Base-only, Rank-only and mixed routes and names the exact players to upgrade, so you can see the arithmetic behind the target.</p>
          </article>
        </div>

        <div class="guide-deep">
          <div class="deep-copy">
            <span class="t-eyebrow">THE CALCULATION</span>
            <h3>The formula used by this tool</h3>
            <p>For a complete squad, the tool uses this model:</p>
            <div class="formula"><code>Team OVR = ceil(total Base OVR ÷ squad size) + ceil(total Rank ÷ squad size) + Badge Bonus</code></div>
            <p>Bench players are included whenever they have a Base OVR, because this calculator treats them as part of the squad average. Until all 11 starters are in, the headline stays a labelled estimate based on the players you have entered, and missing players are never counted as zeros.</p>
            <p>The goal is to make the arithmetic inspectable. EA's help guidance describes Team OVR as the average of player OVR, ranks and boosts, and the official training guidance confirms that ranking a player raises their OVR.</p>
          </div>
          <div class="deep-card">
            <span>OFFICIAL REFERENCE</span>
            <strong>What EA confirms</strong>
            <p>EA's help page says Team OVR uses player OVR together with ranks and boosts. EA's ranking guide also explains that every five Training Levels allows a player to be ranked, with a +1 OVR increase per rank step.</p>
            <div class="deep-links">
              <a href="https://help.ea.com/en/articles/ea-sports-fc/fc-mobile/how-to-rank-up-players/" target="_blank" rel="noopener">EA Help · Rank Up Players ↗</a>
              <a href="https://www.ea.com/ea-originals/news/fc-mobile-training-deep-dive" target="_blank" rel="noopener">EA · Training Deep Dive ↗</a>
            </div>
          </div>
        </div>

        <div class="faq">
          <span class="t-eyebrow">FAQ</span>
          <h3>Team OVR questions that actually affect the calculation</h3>

          <details>
            <summary>Why does my Team OVR sometimes stay the same after upgrading a player?</summary>
            <p>The calculator rounds the Base OVR and Rank averages up. An upgrade can raise a component's underlying average without crossing the next whole number. When the average finally crosses that boundary, the displayed Team OVR moves.</p>
          </details>
          <details>
            <summary>Do I need to enter all 11 players before I see a Team OVR?</summary>
            <p>No. One valid Base OVR is enough to start a live estimate. The exact result appears once all 11 starters have a Base OVR, and the upgrade planner unlocks at the same point.</p>
          </details>
          <details>
            <summary>Are substitutes included?</summary>
            <p>Yes. Every bench slot that has a Base OVR becomes part of the squad average. Slots you leave empty are ignored, so you can model a squad of anywhere from 11 to 18 players.</p>
          </details>
          <details>
            <summary>Does Training Level increase Team OVR in this calculator?</summary>
            <p>Training Level is not a Team OVR input here. EA distinguishes training from ranking: training improves attributes, while ranking increases a player's OVR. That is why the calculator asks for Rank.</p>
          </details>
          <details>
            <summary>Does the formation change my Team OVR?</summary>
            <p>No. The formation picker only changes how your squad is laid out on the pitch. Team OVR is calculated from the players' ratings, not from where they play.</p>
          </details>
          <details>
            <summary>Why is the result labelled an estimate before the squad is complete?</summary>
            <p>Because missing players are not secretly converted into zeros. The tool shows what can be calculated from the data you have entered and labels it as an estimate, so a partial result stays useful without pretending to be a finished squad calculation.</p>
          </details>
        </div>
      </section>
    </div>

    <!-- Mobile result bar: shows when the main result scrolls out of view -->
    <div class="dock" id="dock" aria-hidden="true">
      <span>TEAM OVR</span>
      <strong id="dock-number">--</strong>
      <small id="dock-state">Estimate</small>
    </div>

    <dialog class="qf" id="quick-dialog" aria-labelledby="quick-title">
      <form method="dialog" class="qf-card">
        <h2 id="quick-title">Quick fill</h2>
        <p>Paste Base OVRs in order: starters first, then the bench. Add a Rank after a slash, like <b>116/2</b>. Existing values are overwritten from Starter 1 onward.</p>
        <textarea id="quick-text" rows="5" spellcheck="false" placeholder="117 117/1 116/2 118 ..."></textarea>
        <p class="qf-msg" id="quick-msg" role="status"></p>
        <div class="qf-actions">
          <button type="submit" class="btn btn-ghost" value="cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="quick-apply">Fill squad</button>
        </div>
      </form>
    </dialog>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </main>

  <style is:global>
    /* =====================================================
       Team OVR, premium redesign. Everything is scoped under .tovr
       ===================================================== */
    .tovr{
      --c:#4CC9FF; --c-hi:#9BE7FF; --c-lo:#2FB6F5;
      --gold:#FFC857; --mint:#47D1A3; --red:#FF6B7A;
      --ink:#F5F8FB; --sub:#A7B4C3; --dim:#7D8FA0;
      --line:rgba(255,255,255,.08); --line-2:rgba(255,255,255,.14);
      --glass:linear-gradient(180deg,rgba(24,40,58,.74),rgba(11,21,32,.82));
      --r-lg:24px; --r-md:16px; --r-sm:12px;
      position:relative;display:block;padding:112px 0 120px;color:var(--ink);overflow-x:clip;
      font-variant-numeric:tabular-nums;
    }
    .tovr *{box-sizing:border-box}
    .tovr button{font-family:inherit;color:inherit;-webkit-tap-highlight-color:transparent}
    .tovr h1,.tovr h2,.tovr h3{margin:0}
    .tovr p{margin:0}
    .tovr [hidden]{display:none!important}
    .tovr .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);border:0}
    .tovr-wrap{width:min(1240px,calc(100% - 32px));margin:0 auto}
    .tovr :focus-visible{outline:2px solid var(--c);outline-offset:2px}

    /* ---------- Header ---------- */
    .t-head{margin-bottom:26px}
    .t-eyebrow{display:inline-flex;align-items:center;gap:10px;font:700 12px/1 var(--font-body);letter-spacing:.18em;color:var(--c)}
    .t-eyebrow i{width:4px;height:4px;border-radius:50%;background:var(--c);opacity:.6}
    .t-head h1{margin:14px 0 12px;font:700 clamp(40px,6.2vw,72px)/.98 var(--font-display);letter-spacing:-.045em}
    .t-head h1 em{font-style:normal;background:linear-gradient(100deg,var(--c-hi),var(--c) 55%,#2d9fe0);-webkit-background-clip:text;background-clip:text;color:transparent}
    .t-head p{max-width:560px;color:var(--sub);font-size:clamp(15px,1.6vw,17px);line-height:1.6}

    /* ---------- Panels ---------- */
    .tovr .panel{position:relative;border:1px solid var(--line);border-radius:var(--r-lg);background:var(--glass);box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 30px 70px -34px rgba(0,0,0,.75);padding:22px}
    .panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:18px}
    .panel-head h2{font:700 20px/1.2 var(--font-display);letter-spacing:-.02em}
    .panel-head p{margin-top:5px;color:var(--sub);font-size:13.5px;line-height:1.5}
    .panel-head p b{color:var(--ink);font-weight:700}
    .tag{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 12px;border-radius:999px;border:1px solid rgba(76,201,255,.28);background:rgba(76,201,255,.08);color:var(--c-hi);font:700 12px/1 var(--font-body);letter-spacing:.04em;white-space:nowrap}
    .total-pill{display:grid;place-items:center;min-width:46px;height:30px;padding:0 12px;border-radius:999px;border:1px solid var(--line-2);font:700 14px/1 var(--font-display);color:var(--c-hi)}

    /* ---------- Buttons ---------- */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:42px;padding:0 16px;border:1px solid var(--line-2);border-radius:13px;background:rgba(255,255,255,.04);color:var(--ink);font:600 13.5px/1 var(--font-body);cursor:pointer;transition:background .18s,border-color .18s,transform .15s,box-shadow .18s}
    .btn:hover{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.22)}
    .btn:active{transform:scale(.97)}
    .btn-primary{border-color:transparent;color:#04121b;font-weight:700;background:linear-gradient(180deg,#8fe3ff,#4cc9ff 60%,#35b3ec);box-shadow:0 1px 0 rgba(255,255,255,.55) inset,0 12px 28px -10px rgba(76,201,255,.7)}
    .btn-primary:hover{background:linear-gradient(180deg,#a5eaff,#63d4ff 60%,#42bdf3);border-color:transparent}
    .btn-danger[data-armed="true"]{border-color:rgba(255,107,122,.6);background:rgba(255,107,122,.14);color:#ffc1c8}
    .icon-btn{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--line-2);border-radius:12px;background:rgba(255,255,255,.04);cursor:pointer;color:#D4DEE7;transition:background .18s,border-color .18s}
    .icon-btn:hover{background:rgba(255,255,255,.09)}

    /* Segmented controls */
    .seg{display:inline-flex;padding:4px;gap:4px;border:1px solid var(--line);border-radius:14px;background:rgba(0,0,0,.28)}
    .seg button{min-width:44px;height:36px;padding:0 14px;border:0;border-radius:10px;background:transparent;color:var(--sub);font:600 13.5px/1 var(--font-body);cursor:pointer;transition:background .18s,color .18s,box-shadow .18s}
    .seg button:hover{color:var(--ink)}
    .seg button[aria-pressed="true"]{color:#04121b;font-weight:700;background:linear-gradient(180deg,#8fe3ff,#4cc9ff);box-shadow:0 6px 16px -6px rgba(76,201,255,.8)}
    .seg-rank{display:grid;grid-template-columns:repeat(6,1fr);width:100%}
    .seg-rank button{min-width:0;height:44px;padding:0;font:700 16px/1 var(--font-display)}

    /* ---------- Hero ---------- */
    .hero{position:relative;display:grid;grid-template-columns:auto 1fr;align-items:center;gap:clamp(24px,4vw,56px);margin-bottom:22px;padding:clamp(22px,3vw,34px);border:1px solid var(--line);border-radius:30px;overflow:hidden;background:radial-gradient(700px 320px at 0% 0%,rgba(76,201,255,.14),transparent 62%),var(--glass);box-shadow:0 1px 0 rgba(255,255,255,.07) inset,0 40px 90px -40px rgba(0,0,0,.85)}
    .hero-glow{position:absolute;left:-60px;top:-80px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(76,201,255,.22),transparent 68%);filter:blur(10px);pointer-events:none}
    .gauge{position:relative;width:clamp(210px,24vw,280px);aspect-ratio:1}
    .ring{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
    .ring-track{fill:none;stroke:rgba(255,255,255,.07);stroke-width:7}
    .ring-arc{fill:none;stroke:url(#ringGrad);stroke-width:7;stroke-linecap:round;stroke-dasharray:0 100;transition:stroke-dasharray .7s cubic-bezier(.2,.8,.2,1);filter:drop-shadow(0 0 10px rgba(76,201,255,.55))}
    .hero[data-state="exact"] .ring-arc{filter:drop-shadow(0 0 16px rgba(76,201,255,.8))}
    .gauge-core{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center}
    .gauge-core small{font:700 12px/1 var(--font-body);letter-spacing:.22em;color:var(--sub)}
    .gauge-core strong{font:700 clamp(68px,9vw,104px)/.9 var(--font-display);letter-spacing:-.06em;background:linear-gradient(180deg,#fff 10%,var(--c-hi) 120%);-webkit-background-clip:text;background-clip:text;color:transparent}
    .pill{display:inline-flex;align-items:center;gap:7px;margin-top:6px;height:26px;padding:0 12px;border-radius:999px;border:1px solid var(--line-2);background:rgba(0,0,0,.25);color:var(--sub);font:700 11.5px/1 var(--font-body);letter-spacing:.06em;white-space:nowrap}
    .pill::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--dim)}
    .pill[data-state="estimate"]{color:var(--gold);border-color:rgba(255,200,87,.35)}
    .pill[data-state="estimate"]::before{background:var(--gold);box-shadow:0 0 10px var(--gold)}
    .pill[data-state="exact"]{color:var(--mint);border-color:rgba(71,209,163,.4)}
    .pill[data-state="exact"]::before{background:var(--mint);box-shadow:0 0 10px var(--mint)}

    .hero-side{display:grid;gap:16px;min-width:0}
    .equation{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:stretch;gap:10px}
    .eq-tile{display:flex;flex-direction:column;gap:6px;min-width:0;padding:16px 16px 14px;border:1px solid var(--line);border-radius:var(--r-md);background:rgba(0,0,0,.22)}
    .eq-tile span{font:700 11.5px/1 var(--font-body);letter-spacing:.16em;color:var(--sub);text-transform:uppercase}
    .eq-tile b{font:700 clamp(30px,3.4vw,42px)/1 var(--font-display);letter-spacing:-.04em}
    .eq-tile small{font:500 12.5px/1.2 var(--font-body);color:var(--dim)}
    .eq-op{display:grid;place-items:center;color:var(--dim);font:500 22px/1 var(--font-display)}
    .next-hint{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 16px;border:1px solid rgba(76,201,255,.2);border-radius:var(--r-md);background:linear-gradient(90deg,rgba(76,201,255,.1),rgba(76,201,255,.02))}
    .next-kicker{display:block;margin-bottom:5px;font:700 11px/1 var(--font-body);letter-spacing:.2em;color:var(--c)}
    .next-hint p{color:#D4DEE7;font-size:14.5px;line-height:1.5}
    .next-hint p b{color:#fff}

    /* ---------- Layout ---------- */
    .layout{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:22px;align-items:start}
    .col-main{display:grid;gap:22px;min-width:0}
    .layout>.editor{position:sticky;top:96px;align-self:start}
    .lower{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:22px;align-items:start;margin-top:22px}
    .lower .routes{grid-template-columns:repeat(auto-fit,minmax(270px,1fr));align-items:start}
    .lower .routes .p-empty{grid-column:1/-1}
    .tovr[data-view="list"] .layout>.editor{display:none}
    .tovr[data-view="list"] .layout{grid-template-columns:1fr}

    /* ---------- Squad ---------- */
    .toolbar{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}
    .tovr .select{position:relative;display:inline-block}
    .tovr .select::after{content:"";position:absolute;right:15px;top:50%;width:7px;height:7px;margin-top:-6px;border-right:2px solid var(--sub);border-bottom:2px solid var(--sub);transform:rotate(45deg);pointer-events:none}
    .tovr .select select{appearance:none;-webkit-appearance:none;height:42px;padding:0 38px 0 16px;border:1px solid var(--line-2);border-radius:13px;background:rgba(255,255,255,.04);color:var(--ink);font:600 13.5px/1 var(--font-body);cursor:pointer}
    .tovr .select select option{background:#0F1A26;color:#fff}

    .pitch{position:relative;width:100%;max-width:640px;margin:0 auto;aspect-ratio:5/7;border-radius:22px;overflow:hidden;border:1px solid rgba(94,214,160,.22);color:rgba(210,255,232,.3);
      background:
        radial-gradient(120% 80% at 50% 0%,rgba(255,255,255,.07),transparent 60%),
        repeating-linear-gradient(180deg,#0f4a33 0 9.09%,#0c4230 9.09% 18.18%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.04),inset 0 -60px 80px -40px rgba(0,0,0,.45),0 30px 60px -30px rgba(0,0,0,.7)}
    .pitch-lines{position:absolute;inset:0;width:100%;height:100%}
    .chips{position:absolute;inset:0}

    /* Player chips */
    .chip{
      --a:#33475c;--b:#1c2b3b;--tone:#b9c7d4;--edge:rgba(255,255,255,.16);
      position:relative;display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:2px;padding:7px 4px 8px;
      border:1px solid var(--edge);border-radius:14px;cursor:pointer;color:var(--tone);text-align:center;
      background:linear-gradient(165deg,var(--a),var(--b));
      box-shadow:0 12px 24px -10px rgba(0,0,0,.65),0 1px 0 rgba(255,255,255,.18) inset;
      transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .2s,border-color .2s,left .55s cubic-bezier(.2,.8,.2,1),top .55s cubic-bezier(.2,.8,.2,1);
    }
    .chips .chip{position:absolute;left:calc(var(--x) * 1%);top:calc(var(--y) * 1%);transform:translate(-50%,-50%);width:clamp(54px,15.5%,86px);aspect-ratio:.8}
    .chips .chip:hover{transform:translate(-50%,-52%)}
    .chip-pos{font:800 10px/1 var(--font-body);letter-spacing:.08em;opacity:.9}
    .chip-ovr{font:700 clamp(19px,2.4vw,27px)/1 var(--font-display);letter-spacing:-.04em}
    .chip-pips{display:flex;gap:3px;height:5px}
    .chip-pips i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.22;transition:opacity .2s}
    .chip-pips i.on{opacity:1}
    .chip[data-tier="empty"]{--a:rgba(8,20,30,.55);--b:rgba(8,20,30,.55);--tone:rgba(235,245,255,.7);--edge:rgba(255,255,255,.28);border-style:dashed;box-shadow:none}
    .chip[data-tier="empty"] .chip-ovr{font-weight:500;opacity:.55}
    .chip[data-tier="slate"]{--a:#53677c;--b:#2a3a4c;--tone:#eaf1f7}
    .chip[data-tier="mint"]{--a:#2f9c7c;--b:#154c43;--tone:#ecfff8;--edge:rgba(130,255,210,.35)}
    .chip[data-tier="cyan"]{--a:#2a9fd6;--b:#143f66;--tone:#f1fbff;--edge:rgba(155,231,255,.5)}
    .chip[data-tier="gold"]{--a:#f5c351;--b:#9a6516;--tone:#2a1a02;--edge:rgba(255,236,170,.75);box-shadow:0 12px 26px -10px rgba(255,200,87,.55),0 1px 0 rgba(255,255,255,.5) inset}
    .chip.is-selected{border-color:#fff;border-style:solid;box-shadow:0 0 0 3px rgba(76,201,255,.9),0 0 28px rgba(76,201,255,.55),0 14px 28px -10px rgba(0,0,0,.7);z-index:3}
    .chip.is-weak::after{content:"";position:absolute;inset:-5px;border-radius:18px;border:2px solid var(--red);box-shadow:0 0 18px rgba(255,107,122,.55);pointer-events:none;animation:tovr-pulse 2.2s ease-in-out infinite}
    @keyframes tovr-pulse{50%{opacity:.4}}

    .bench{margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}
    .bench-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin-bottom:14px}
    .bench-head h3{font:700 16px/1 var(--font-display)}
    .bench-head p{color:var(--sub);font-size:13px;line-height:1.5}
    .bench-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .chip--bench{width:100%;aspect-ratio:1.05;padding:8px 4px 9px}

    .saved{display:flex;align-items:center;gap:8px;margin-top:18px;color:var(--dim);font-size:12.5px}
    .saved .dot{width:6px;height:6px;border-radius:50%;background:var(--mint);opacity:.8}

    /* List view */
    .list{display:grid;gap:8px}
    .l-group{margin:14px 2px 2px;font:700 12px/1 var(--font-body);letter-spacing:.18em;color:var(--c)}
    .l-group:first-child{margin-top:0}
    .lrow{display:grid;grid-template-columns:62px minmax(70px,1fr) auto 52px;align-items:center;gap:10px;padding:8px 12px;border:1px solid var(--line);border-radius:14px;background:rgba(0,0,0,.2);transition:border-color .2s,background .2s}
    .lrow:focus-within{border-color:rgba(76,201,255,.55);background:rgba(76,201,255,.05)}
    .lrow.is-weak{border-color:rgba(255,107,122,.55)}
    .l-name{display:flex;flex-direction:column;gap:3px}
    .l-name b{font:700 14px/1 var(--font-display)}
    .l-name small{font:600 11px/1 var(--font-body);color:var(--dim)}
    .lrow input{width:100%;min-width:0;height:42px;padding:0 12px;border:1px solid var(--line-2);border-radius:11px;background:#08141e;color:var(--ink);font:700 16px/1 var(--font-display);outline:0;transition:border-color .15s,box-shadow .15s}
    .lrow input::placeholder{color:#516577;font-weight:500}
    .lrow input:focus{border-color:var(--c);box-shadow:0 0 0 3px rgba(76,201,255,.14)}
    .lrow input[aria-invalid="true"]{border-color:var(--red)}
    .l-rank{display:inline-flex;align-items:center;border:1px solid var(--line-2);border-radius:11px;background:#08141e;overflow:hidden}
    .l-rank button{width:34px;height:40px;border:0;background:transparent;color:var(--sub);font:700 17px/1 var(--font-display);cursor:pointer}
    .l-rank button:hover{background:rgba(255,255,255,.07);color:#fff}
    .l-rank output{min-width:26px;text-align:center;font:700 15px/1 var(--font-display)}
    .l-ovr{justify-self:end;font:700 20px/1 var(--font-display);letter-spacing:-.03em;color:var(--c-hi)}
    .l-ovr[data-tier="gold"]{color:var(--gold)}
    .l-ovr[data-tier="empty"]{color:var(--dim);font-weight:500}

    /* ---------- Editor ---------- */
    .layout>.editor{z-index:5;border-color:rgba(76,201,255,.22);background:radial-gradient(420px 200px at 0% 0%,rgba(76,201,255,.1),transparent 70%),var(--glass)}
    .ed-grab{display:none}
    .ed-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
    .ed-kicker{display:block;margin-bottom:6px;font:700 11.5px/1 var(--font-body);letter-spacing:.2em;color:var(--c)}
    .ed-who h2{font:700 26px/1 var(--font-display);letter-spacing:-.03em}
    .ed-nav{display:flex;gap:8px}
    .ed-close{display:none}
    .ed-body{display:grid;gap:18px}
    .field .label,.field label,.ed-preview .label{display:block;margin-bottom:9px;font:700 12px/1 var(--font-body);letter-spacing:.14em;color:var(--sub);text-transform:uppercase}
    .stepper{display:grid;grid-template-columns:52px 1fr 52px;gap:8px}
    .step{height:52px;border:1px solid var(--line-2);border-radius:14px;background:rgba(255,255,255,.05);color:var(--ink);font:500 26px/1 var(--font-display);cursor:pointer;transition:background .15s,transform .12s}
    .step:hover{background:rgba(255,255,255,.1)}
    .step:active{transform:scale(.94)}
    .stepper input{width:100%;min-width:0;height:52px;padding:0 14px;border:1px solid var(--line-2);border-radius:14px;background:#07131c;color:#fff;text-align:center;font:700 28px/1 var(--font-display);letter-spacing:-.02em;outline:0;transition:border-color .15s,box-shadow .15s}
    .stepper input::placeholder{font-size:17px;font-weight:500;color:#4b6173;letter-spacing:0}
    .stepper input:focus{border-color:var(--c);box-shadow:0 0 0 4px rgba(76,201,255,.15)}
    .stepper input[aria-invalid="true"]{border-color:var(--red);box-shadow:0 0 0 4px rgba(255,107,122,.14)}
    .field-msg{margin-top:9px;color:var(--dim);font-size:12.5px;line-height:1.4;min-height:18px}
    .field-msg[data-bad="true"]{color:#ff9aa5}
    .ed-preview{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border:1px solid var(--line);border-radius:var(--r-md);background:rgba(0,0,0,.24)}
    .ed-preview .label{margin-bottom:6px}
    .ed-preview p{color:var(--dim);font-size:12.5px}
    .ed-preview strong{font:700 40px/1 var(--font-display);letter-spacing:-.05em;color:var(--c-hi)}
    .ed-preview strong[data-tier="gold"]{color:var(--gold)}
    .ed-preview strong[data-tier="empty"]{color:var(--dim);font-weight:500}
    .ed-foot{display:grid;grid-template-columns:auto 1fr;gap:10px;margin-top:18px}
    .ed-foot .btn{height:48px;border-radius:14px}

    /* ---------- Badges ---------- */
    .badge-list{display:grid;gap:10px}
    .badge{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:var(--r-md);background:rgba(0,0,0,.22);text-align:left;cursor:pointer;transition:border-color .2s,background .2s,transform .12s}
    .badge:hover{border-color:var(--line-2)}
    .badge:active{transform:scale(.985)}
    .badge-check{display:grid;place-items:center;width:28px;height:28px;border:1.5px solid var(--line-2);border-radius:9px;color:transparent;transition:all .2s}
    .badge-copy b{display:block;font:700 15px/1.2 var(--font-display)}
    .badge-copy small{display:block;margin-top:3px;color:var(--dim);font-size:12.5px}
    .badge em{font:700 18px/1 var(--font-display);font-style:normal;color:var(--dim);transition:color .2s}
    .badge[aria-pressed="true"]{border-color:rgba(76,201,255,.5);background:linear-gradient(90deg,rgba(76,201,255,.14),rgba(76,201,255,.03))}
    .badge[aria-pressed="true"] .badge-check{color:#04121b;border-color:transparent;background:linear-gradient(180deg,#8fe3ff,#4cc9ff)}
    .badge[aria-pressed="true"] em{color:var(--c-hi)}

    /* ---------- Planner ---------- */
    .target{display:grid;gap:12px}
    .target-ctl{display:grid;grid-template-columns:52px 1fr 52px;gap:8px}
    .target-box{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;height:52px;border:1px solid var(--line-2);border-radius:14px;background:#07131c;cursor:text;transition:border-color .15s,box-shadow .15s}
    .target-box:focus-within{border-color:var(--c);box-shadow:0 0 0 4px rgba(76,201,255,.15)}
    .target-box span{font:700 10px/1 var(--font-body);letter-spacing:.2em;color:var(--dim);text-transform:uppercase}
    .target-box input{width:100%;border:0;background:transparent;color:#fff;text-align:center;font:700 22px/1 var(--font-display);outline:0;padding:0}
    .jumps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
    .jumps button{height:38px;border:1px solid var(--line-2);border-radius:11px;background:rgba(255,255,255,.04);color:var(--sub);font:700 13.5px/1 var(--font-display);cursor:pointer;transition:all .15s}
    .jumps button:hover{color:#fff;background:rgba(255,255,255,.09)}
    .routes{display:grid;gap:12px;margin-top:18px}
    .p-empty{padding:16px;border:1px dashed rgba(255,255,255,.18);border-radius:var(--r-md);color:var(--sub);font-size:14px;line-height:1.55}
    .p-empty b{color:var(--ink)}
    .p-progress{width:100%;height:6px;margin-top:12px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}
    .p-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--c-lo),var(--c-hi));transition:width .4s}
    .p-done{border-style:solid;border-color:rgba(71,209,163,.4);background:rgba(71,209,163,.07);color:#bff3df}
    .route{border:1px solid var(--line);border-radius:var(--r-md);background:rgba(0,0,0,.2);overflow:hidden}
    .route.is-best{border-color:rgba(76,201,255,.5);background:linear-gradient(180deg,rgba(76,201,255,.1),rgba(0,0,0,.18))}
    .route>summary{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;list-style:none}
    .route>summary::-webkit-details-marker{display:none}
    .route-name{flex:1;min-width:0}
    .route-name b{display:flex;align-items:center;gap:8px;font:700 16px/1.2 var(--font-display)}
    .route-name small{display:block;margin-top:4px;color:var(--sub);font-size:12.5px}
    .route-badge{display:inline-flex;height:20px;align-items:center;padding:0 8px;border-radius:99px;background:linear-gradient(180deg,#8fe3ff,#4cc9ff);color:#04121b;font:800 10px/1 var(--font-body);letter-spacing:.08em}
    .route-total{text-align:right}
    .route-total strong{display:block;font:700 28px/1 var(--font-display);letter-spacing:-.04em;color:var(--c-hi)}
    .route-total span{font:600 11px/1 var(--font-body);color:var(--dim)}
    .route-body{padding:2px 16px 16px;display:grid;gap:14px}
    .r-group h4{margin:0 0 8px;font:700 11.5px/1 var(--font-body);letter-spacing:.16em;color:var(--c);text-transform:uppercase}
    .r-list{list-style:none;margin:0;padding:0;display:grid;gap:6px}
    .r-list li{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;border-radius:10px;background:rgba(255,255,255,.04);font-size:13.5px}
    .r-list li span{color:#D4DEE7;font-weight:600}
    .r-list li b{font:700 14px/1 var(--font-display);white-space:nowrap}
    .r-list li b i{font-style:normal;color:var(--dim);margin:0 5px}
    .r-list li b em{font-style:normal;color:var(--mint)}

    /* ---------- Weak links ---------- */
    .weak-list{display:grid;gap:8px}
    .w-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:var(--r-sm);background:rgba(0,0,0,.2);text-align:left;cursor:pointer;font:inherit;color:inherit;transition:border-color .15s,background .15s}
    .w-row:hover{border-color:var(--line-2);background:rgba(255,255,255,.04)}
    .w-row.is-lowest{border-color:rgba(255,107,122,.45);background:rgba(255,107,122,.06)}
    .w-rank{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:rgba(255,255,255,.07);font:700 13px/1 var(--font-display);color:var(--sub)}
    .is-lowest .w-rank{background:rgba(255,107,122,.2);color:#ffb3bb}
    .w-who{display:block}
    .w-who b{display:block;font:700 14.5px/1.2 var(--font-display)}
    .w-who small{display:block;margin-top:3px;color:var(--dim);font-size:12.5px}
    .w-ovr{font:700 24px/1 var(--font-display);letter-spacing:-.04em}

    /* ---------- Dock (mobile result bar) ---------- */
    .dock{display:none}

    /* ---------- Quick fill dialog ---------- */
    dialog.qf{width:min(520px,calc(100% - 28px));padding:0;border:1px solid var(--line-2);border-radius:var(--r-lg);background:#0c1824;color:#F5F8FB;box-shadow:0 40px 100px -20px rgba(0,0,0,.9)}
    dialog.qf::backdrop{background:rgba(3,8,13,.72);backdrop-filter:blur(5px)}
    .qf-card{display:grid;gap:14px;padding:24px}
    .qf-card h2{margin:0;font:700 22px/1.1 var(--font-display);letter-spacing:-.02em}
    .qf-card p{margin:0;color:#A7B4C3;font-size:14px;line-height:1.55}
    .qf-card p b{color:#fff}
    .qf-card textarea{width:100%;padding:14px;border:1px solid rgba(255,255,255,.14);border-radius:14px;background:#07131c;color:#fff;font:600 15px/1.6 var(--font-body);resize:vertical;outline:0}
    .qf-card textarea:focus{border-color:#4CC9FF;box-shadow:0 0 0 4px rgba(76,201,255,.15)}
    .qf-msg{min-height:20px;font-size:13px!important}
    .qf-msg[data-bad="true"]{color:#ff9aa5!important}
    .qf-actions{display:flex;justify-content:flex-end;gap:10px}

    .toast{position:fixed;left:50%;bottom:40px;z-index:1400;max-width:calc(100% - 32px);padding:12px 18px;border:1px solid rgba(71,209,163,.4);border-radius:14px;background:rgba(10,28,26,.95);color:#cffff0;font:600 14px/1.3 var(--font-body);box-shadow:0 20px 50px -10px rgba(0,0,0,.8);transform:translate(-50%,20px);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s}
    .toast.show{opacity:1;transform:translate(-50%,0)}

    /* ---------- Guide ---------- */
    .guide{margin-top:40px;border:1px solid var(--line);border-radius:30px;overflow:hidden;background:linear-gradient(180deg,rgba(14,25,37,.8),rgba(8,16,24,.9))}
    .guide-intro{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:32px;padding:clamp(24px,4vw,44px);border-bottom:1px solid var(--line);background:radial-gradient(640px 260px at 0% 0%,rgba(76,201,255,.1),transparent 65%)}
    .guide-intro h2{margin:14px 0 14px;font:700 clamp(28px,3.6vw,44px)/1.04 var(--font-display);letter-spacing:-.04em}
    .guide-intro p{max-width:760px;margin-bottom:12px;color:var(--sub);font-size:15.5px;line-height:1.75}
    .guide-note{align-self:start;padding:20px;border:1px solid rgba(76,201,255,.2);border-radius:var(--r-md);background:rgba(76,201,255,.05)}
    .guide-note span{display:block;font:700 11.5px/1 var(--font-body);letter-spacing:.2em;color:var(--c)}
    .guide-note strong{display:block;margin:12px 0;font:600 16px/1.5 var(--font-body);color:#e6f7ff}
    .guide-note small{color:var(--dim);font-size:12.5px}
    .guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line)}
    .guide-grid article{padding:clamp(22px,3vw,32px);background:#09141e}
    .guide-grid h3{display:flex;align-items:center;gap:12px;margin-bottom:14px;font:700 19px/1.2 var(--font-display);letter-spacing:-.02em}
    .guide-grid h3 i{display:grid;place-items:center;flex:0 0 32px;width:32px;height:32px;border:1px solid rgba(76,201,255,.25);border-radius:10px;background:rgba(76,201,255,.08);color:var(--c);font:700 12px/1 var(--font-body);font-style:normal}
    .guide-grid p,.guide-deep p{margin-bottom:12px;color:var(--sub);font-size:15px;line-height:1.75}
    .guide-grid p:last-child{margin-bottom:0}
    .guide-grid strong,.guide-deep strong{color:#e3f1f8}
    .guide-grid code{padding:2px 7px;border-radius:7px;background:rgba(255,255,255,.08);color:var(--c-hi);font:600 13.5px var(--font-body)}
    .example{margin:14px 0 12px;border:1px solid var(--line);border-radius:14px;overflow:hidden}
    .example>div{display:grid;grid-template-columns:1.2fr 1fr .6fr;gap:8px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line);font-size:14px}
    .example>div:last-child{border-bottom:0}
    .example span{color:var(--sub)}
    .example b{font:600 14px var(--font-body);color:#cfdde6}
    .example strong{text-align:right;font:700 16px var(--font-display);color:var(--c-hi)}
    .example .ex-head{background:rgba(255,255,255,.03);font:700 11px/1 var(--font-body);letter-spacing:.1em}
    .example .ex-head span{color:var(--dim)}
    .example .ex-total{background:rgba(76,201,255,.06)}
    .example .ex-total span{color:#fff}
    .guide-grid p.caption{font-size:13.5px;color:var(--dim)}
    .guide-deep{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:18px;padding:clamp(16px,2.4vw,24px);border-top:1px solid var(--line)}
    .deep-copy,.deep-card{padding:clamp(20px,2.6vw,30px);border:1px solid var(--line);border-radius:var(--r-lg);background:rgba(255,255,255,.02)}
    .deep-copy h3{margin:12px 0 12px;font:700 26px/1.1 var(--font-display);letter-spacing:-.03em}
    .formula{margin:16px 0;padding:18px;border:1px solid rgba(76,201,255,.2);border-radius:14px;background:#06111a;overflow-x:auto}
    .formula code{color:#c5f1ff;font:600 14px/1.7 var(--font-body);white-space:nowrap}
    .deep-card>span{display:block;font:700 11.5px/1 var(--font-body);letter-spacing:.2em;color:var(--dim)}
    .deep-card>strong{display:block;margin:12px 0 10px;font:700 20px/1.2 var(--font-display);color:#fff}
    .deep-links{display:grid;gap:8px;margin-top:16px}
    .deep-links a{display:block;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.03);color:var(--c-hi);font:600 13.5px/1.4 var(--font-body);transition:all .15s}
    .deep-links a:hover{border-color:rgba(76,201,255,.4);background:rgba(76,201,255,.08)}
    .faq{padding:clamp(22px,3vw,36px);border-top:1px solid var(--line)}
    .faq h3{margin:12px 0 18px;font:700 26px/1.1 var(--font-display);letter-spacing:-.03em}
    .faq details{border-top:1px solid var(--line);padding:18px 0}
    .faq summary{display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer;list-style:none;color:#e8f2f8;font:600 16px/1.45 var(--font-body)}
    .faq summary::-webkit-details-marker{display:none}
    .faq summary::after{content:"+";flex:0 0 auto;color:var(--c);font:500 24px/1 var(--font-display)}
    .faq details[open] summary::after{content:"−"}
    .faq details p{max-width:880px;margin-top:12px;color:var(--sub);font-size:15px;line-height:1.75}

    /* ---------- Responsive ---------- */
    @media (max-width:1100px){
      .layout{grid-template-columns:minmax(0,1fr) 360px}
      .lower{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}
    }
    @media (max-width:980px){
      .tovr{padding-top:96px;padding-bottom:150px}
      .layout,.lower{grid-template-columns:1fr}
      .lower .routes{grid-template-columns:1fr}
      .bench-grid{grid-template-columns:repeat(4,1fr)}
      .layout>.editor,.tovr[data-view] .layout>.editor{position:fixed;left:0;right:0;bottom:0;top:auto;z-index:1300;margin:0;border-radius:26px 26px 0 0;border-bottom:0;padding:10px 18px calc(18px + env(safe-area-inset-bottom,0px));max-height:86vh;overflow-y:auto;background:linear-gradient(180deg,#14283b,#0a1520);box-shadow:0 -30px 80px rgba(0,0,0,.7);transform:translateY(105%);visibility:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1),visibility 0s .35s}
      .layout>.editor[data-open="true"]{transform:none;visibility:visible;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
      .ed-grab{display:block;width:42px;height:4px;margin:2px auto 14px;border-radius:99px;background:rgba(255,255,255,.22)}
      .ed-close{display:grid}
      .ed-head{margin-bottom:14px}
      .ed-body{gap:14px}
      .tovr.sheet-open{padding-bottom:440px}
      .dock{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom,0px));z-index:1100;display:flex;align-items:center;gap:12px;height:52px;padding:0 22px;border:1px solid var(--line-2);border-radius:999px;background:linear-gradient(180deg,rgba(20,34,49,.92),rgba(9,18,27,.94));backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 20px 50px -10px rgba(0,0,0,.8);transform:translate(-50%,30px);opacity:0;pointer-events:none;visibility:hidden;transition:transform .3s,opacity .3s,visibility 0s .3s}
      .dock.show{transform:translate(-50%,0);opacity:1;visibility:visible;transition:transform .3s,opacity .3s}
      .tovr.sheet-open .dock{opacity:0;visibility:hidden}
      .dock span{font:700 11px/1 var(--font-body);letter-spacing:.18em;color:var(--sub)}
      .dock strong{font:700 28px/1 var(--font-display);letter-spacing:-.04em;color:var(--c-hi)}
      .dock small{font:700 11px/1 var(--font-body);color:var(--gold)}
      .dock small[data-exact="true"]{color:var(--mint)}
      .toast{bottom:160px}
    }
    @media (max-width:760px){
      .hero{grid-template-columns:1fr;justify-items:center;gap:22px;padding:24px 18px 20px;border-radius:26px}
      .hero-side{width:100%}
      .gauge{width:min(260px,72vw)}
      .guide-intro,.guide-grid,.guide-deep{grid-template-columns:1fr}
      .tovr .panel{padding:18px;border-radius:22px}
    }
    @media (max-width:560px){
      .tovr-wrap{width:calc(100% - 24px)}
      .equation{grid-template-columns:1fr 1fr 1fr;gap:8px}
      .eq-op{display:none}
      .eq-tile{padding:13px 12px 12px}
      .eq-tile span{font-size:10.5px;letter-spacing:.12em}
      .eq-tile b{font-size:30px}
      .eq-tile small{font-size:11.5px}
      .next-hint{flex-direction:column;align-items:stretch}
      .next-hint .btn{width:100%}
      .toolbar .select{flex:1 1 100%}
      .toolbar .select select{width:100%}
      .toolbar .btn{flex:1 1 0;padding:0 10px}
      .panel-head{flex-wrap:wrap}
      .bench-grid{gap:8px}
      .lrow{grid-template-columns:50px minmax(0,1fr) auto 42px;gap:8px;padding:8px}
      .l-rank button{width:30px}
      .example>div{padding:10px;font-size:13px}
    }
    @media (min-width:640px) and (max-width:980px){
      .bench-grid{grid-template-columns:repeat(7,1fr)}
    }
    @media (min-width:981px){
      .bench-grid{grid-template-columns:repeat(7,1fr)}
    }
    @media (prefers-reduced-motion:reduce){
      .tovr *,.tovr *::before,.tovr *::after{animation:none!important;transition-duration:.01ms!important}
    }
  </style>
  <script src="../scripts/team-ovr.js"></script>
</BaseLayout>
