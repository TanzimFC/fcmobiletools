---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RANK_OPTIONS, STARTING_XI_SIZE, MAX_SQUAD_SIZE, MAX_BADGE_SLOTS, BASE_OVR_MIN, BASE_OVR_MAX } from '../lib/teamOvr.js';
const POSITIONS=[['GK',50,88],['LB',18,68],['CB',38,73],['CB',62,73],['RB',82,68],['CM',30,49],['CM',50,45],['CM',70,49],['LW',17,25],['ST',50,18],['RW',83,25]];
---
<BaseLayout title="FC Mobile Team OVR Calculator" description="Calculate and optimize FC Mobile Team OVR from Base OVR, Rank and Team OVR bonuses.">
<section class="ovr-tool"><div class="wrap">
<header class="head"><div class="eyebrow">TANZIMFC TOOL / FC MOBILE</div><h1>Team OVR <span>Calculator</span></h1><p>Build your squad, see the exact OVR, then find the smartest route to your next target.</p></header>
<section class="result-card"><div><small id="result-label">LIVE ESTIMATE</small><strong id="result-number">--</strong><p id="result-status">Enter a Base OVR to start the estimate.</p></div><div class="breakdown"><div><span>BASE OVR</span><b id="base-avg">--</b></div><div><span>RANK</span><b id="rank-avg">--</b></div><div><span>BONUS</span><b id="badge-avg">+0</b></div></div></section>
<section class="workspace">
<div class="left-col">
<section class="block pitch-block"><div class="block-head"><div><small>01</small><h2>Starting XI</h2></div><b id="starter-count">0 / 11</b></div><p class="hint">4-3-3 formation. Enter only Base OVR and Rank.</p><div class="pitch"><img src="/assets/images/field.png" alt="FC Mobile football pitch"/><div class="formation" id="formation">{POSITIONS.map(([pos,x,y],i)=><article class="card" data-index={i} style={`--x:${x}%;--y:${y}%`}><div class="card-top"><span class="position">{pos}</span><span>Player {i+1}</span></div><input data-field="baseOVR" type="number" min={BASE_OVR_MIN} max={BASE_OVR_MAX} inputmode="numeric" placeholder="Base OVR"/><select data-field="rank"><option value="">Rank</option>{RANK_OPTIONS.map(r=><option value={r}>Rank {r}</option>)}</select><div class="card-ovr" data-card-ovr>--</div></article>)}</div></div></section>
</div>
<div class="right-col">
<section class="block overview"><div class="block-head"><div><small>02</small><h2>OVR Breakdown</h2></div></div><div class="ovr-lines"><div><span>Base OVR contribution</span><b id="break-base">--</b></div><div><span>Rank contribution</span><b id="break-rank">--</b></div><div><span>Badge bonus</span><b id="break-badge">+0</b></div><div class="total"><span>Team OVR</span><b id="break-total">--</b></div></div><details><summary>How was this calculated?</summary><div id="math">Enter players to see the live calculation.</div></details></section>
<section class="block subs-block"><div class="sub-heading"><div><div class="section-kicker">03 / SQUAD DEPTH</div><h2>Substitutes</h2><p>Optional players included in your squad average.</p></div><div class="sub-counter"><strong id="sub-count">0</strong><span>ACTIVE</span></div></div><div class="sub-empty" id="sub-empty"><div class="sub-empty-icon">+</div><div><strong>Add your bench</strong><span>Track up to 7 substitutes without crowding the lineup.</span></div></div><div class="subs" id="subs"></div><button class="add add-sub-btn" id="add-sub" type="button"><span>+</span> Add Substitute</button></section>
<section class="block badges-block"><div class="block-head"><div><small>04</small><h2>Badges</h2></div><b id="badge-total">+0 OVR</b></div><p class="hint">Each enabled badge adds exactly +1 Team OVR.</p><div class="badges">{Array.from({length:MAX_BADGE_SLOTS},(_,i)=><label class="badge"><input type="checkbox" data-badge={i}/><span>Badge {i+1}</span><b>+1 OVR</b></label>)}</div></section>
<section class="block planner"><div class="block-head"><div><small>05</small><h2>Reach X OVR</h2></div><span class="target-label">GOAL PLANNER</span></div><p class="hint">Set a target and find the smallest upgrade path.</p><div class="target-row"><label>Target Team OVR<input id="target-ovr" type="number" min="1" max="138" value="120" inputmode="numeric"/></label><div class="target-current"><small>CURRENT</small><strong id="planner-current">--</strong></div></div><div id="planner"><div class="planner-empty">Enter player values to calculate routes.</div></div></section>
<section class="block next"><div class="block-head"><div><small>06</small><h2>Next OVR</h2></div></div><div class="meter"><div class="meter-track"><span id="meter-fill"></span></div><div class="meter-copy"><strong id="next-number">--</strong><span id="next-needed">Enter player values</span></div></div><div id="next-routes" class="next-routes"></div></section>
<section class="block bottleneck"><div class="block-head"><div><small>07</small><h2>Biggest OVR Bottleneck</h2></div></div><div id="bottleneck"><div class="planner-empty">Enter player values to find the lowest OVR.</div></div></section>
</div></section>
<button class="reset" id="reset" type="button">Reset Squad</button>
</div></section>
<style>
.ovr-tool .result-card{position:sticky;top:104px;z-index:40;backdrop-filter:blur(18px);box-shadow:0 18px 55px rgba(0,0,0,.3)}
.ovr-tool .result-card strong{font-size:clamp(60px,7vw,86px)}
.ovr-tool .card{border-color:rgba(107,207,242,.42);background:linear-gradient(145deg,rgba(7,19,29,.96),rgba(9,20,29,.88));transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}
.ovr-tool .card:focus-within{transform:translateY(-2px);border-color:rgba(76,201,255,.72);box-shadow:0 14px 28px rgba(0,0,0,.28),0 0 0 3px rgba(76,201,255,.06)}
.ovr-tool .card-ovr{font-size:18px;color:#8ee4ff;text-shadow:0 0 14px rgba(76,201,255,.18)}
@media(max-width:760px){.ovr-tool .result-card{position:sticky;top:78px;z-index:35;margin-inline:0;box-shadow:0 12px 34px rgba(0,0,0,.35)}.ovr-tool .result-card strong{font-size:56px}.ovr-tool .breakdown{background:rgba(7,16,24,.55);backdrop-filter:blur(8px)}}
</style>\n</BaseLayout>
<style>
.ovr-tool{padding:46px 0 80px}.wrap{width:min(1240px,calc(100% - 30px));margin:auto}.head{margin-bottom:22px}.eyebrow{font:800 10px var(--mono);letter-spacing:.16em;color:var(--blue)}.head h1{font-size:clamp(40px,6vw,68px);line-height:.95;letter-spacing:-.055em;margin:12px 0}.head h1 span{color:var(--blue)}.head p{color:var(--muted);margin:0;font-size:14px}.result-card,.block{border:1px solid var(--border);background:var(--surface);border-radius:18px}.result-card{position:sticky;top:10px;z-index:20;padding:18px 22px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;gap:24px;background:linear-gradient(135deg,var(--surface2),var(--surface))}.result-card small{font:800 9px var(--mono);letter-spacing:.16em;color:var(--blue)}.result-card strong{display:block;font:900 58px/.95 var(--mono);letter-spacing:-.06em;margin:7px 0}.result-card p{margin:0;color:var(--muted);font-size:11px}.breakdown{display:grid;grid-template-columns:repeat(3,1fr);min-width:330px;border-left:1px solid var(--border)}.breakdown div{text-align:center;padding:5px 18px}.breakdown div+div{border-left:1px solid var(--border)}.breakdown span,.ovr-lines span{display:block;font:700 8px var(--mono);color:var(--muted);letter-spacing:.04em}.breakdown b{display:block;font:900 17px var(--mono);margin-top:5px}.workspace{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(330px,.65fr);gap:20px;align-items:start}.left-col,.right-col{min-width:0}.block{padding:18px;margin:0 0 20px}.block-head{display:flex;align-items:center;justify-content:space-between;gap:15px}.block-head>div{display:flex;align-items:center;gap:11px}.block-head small{font:800 9px var(--mono);color:var(--blue)}.block h2{margin:0;font-size:19px}.block h2 i{font:700 8px var(--mono);color:var(--muted);font-style:normal;margin-left:5px}.block-head>b{font:800 9px var(--mono);color:var(--blue);background:var(--blue3);padding:8px 9px;border-radius:8px}.target-label{font:800 8px var(--mono);color:var(--blue)}.hint{font-size:11px;color:var(--muted);margin:6px 0 15px}.pitch{position:relative;aspect-ratio:2/3;border-radius:16px;overflow:visible;border:1px solid #2d6249;background:#145335}.pitch>img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;border-radius:15px}.formation{position:absolute;inset:0}.card{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:clamp(66px,13%,112px);padding:7px;background:#07131deb;border:1px solid #6bcff2;border-radius:11px;box-shadow:0 8px 20px #0008;backdrop-filter:blur(5px)}.card-top{display:flex;justify-content:space-between;align-items:center;gap:3px;margin-bottom:6px}.position{font:900 10px var(--mono);color:#79ddff}.card-top span:last-child{font:700 7px var(--mono);color:#6c8494;white-space:nowrap}.card input,.card select{width:100%;height:30px;border:1px solid #294657;border-radius:6px;background:#0c1c27;color:#effaff;font:800 9px var(--mono);padding:0 5px;outline:0}.card input{height:32px;font-size:11px;margin-bottom:5px}.card-ovr{text-align:center;font:900 10px var(--mono);color:#79ddff;margin-top:5px}.ovr-lines{margin-top:12px}.ovr-lines>div{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border)}.ovr-lines b{font:900 18px var(--mono)}.ovr-lines .total{border-bottom:0;padding-top:16px}.ovr-lines .total b{font-size:30px;color:var(--blue)}details summary{cursor:pointer;font-weight:800;font-size:11px;margin-top:10px}.how #math,#math{font:700 10px/1.8 var(--mono);color:var(--muted);white-space:pre-wrap;margin:13px 0}.target-row{display:grid;grid-template-columns:1fr 105px;gap:10px;align-items:end}.target-row label{font-size:10px;font-weight:800;color:var(--muted)}.target-row input{display:block;width:100%;height:44px;margin-top:6px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);color:var(--text);padding:0 10px;font:900 18px var(--mono)}.target-current{height:44px;padding:5px 8px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);text-align:center}.target-current small{font:700 7px var(--mono);color:var(--muted)}.target-current strong{display:block;font:900 18px var(--mono)}.planner-empty{padding:14px;border:1px dashed var(--border);border-radius:10px;color:var(--muted);font-size:10px;line-height:1.6;margin-top:12px}.route{border:1px solid var(--border);border-radius:11px;padding:12px;margin-top:9px;background:var(--surface2)}.route.best{border-color:var(--blue)}.route-title{display:flex;justify-content:space-between;gap:10px;font-size:11px;font-weight:900}.route-title span{font:800 8px var(--mono);color:var(--blue)}.route p{font-size:10px;line-height:1.6;color:var(--muted);margin:7px 0 0}.meter{padding-top:12px}.meter-track{height:12px;border-radius:99px;background:var(--surface2);overflow:hidden;border:1px solid var(--border)}.meter-track span{display:block;height:100%;width:0;background:var(--blue);transition:width .2s}.meter-copy{display:flex;justify-content:space-between;align-items:center;margin-top:9px}.meter-copy strong{font:900 21px var(--mono)}.meter-copy span{font-size:10px;color:var(--muted);text-align:right}.next-routes{font-size:10px;color:var(--muted);line-height:1.7;margin-top:10px}.bottleneck-card{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:11px;background:var(--surface2);margin-top:12px}.bottleneck-ovr{font:900 24px var(--mono);color:var(--blue);min-width:48px}.bottleneck-card strong{font-size:11px}.bottleneck-card p{font-size:9px;line-height:1.5;color:var(--muted);margin:3px 0 0}.sub-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:14px;border-bottom:1px solid var(--border)}.sub-heading h2{margin:3px 0 0}.sub-heading p{margin:4px 0 0;color:var(--muted);font-size:10px}.section-kicker{font:800 8px var(--mono);letter-spacing:.12em;color:var(--blue)}.sub-counter{min-width:54px;padding:8px 10px;border:1px solid var(--border);border-radius:10px;background:var(--surface2);text-align:center}.sub-counter strong{display:block;font:900 20px var(--mono);color:var(--blue);line-height:1}.sub-counter span{display:block;font:800 6px var(--mono);color:var(--muted);margin-top:4px}.sub-empty{display:flex;align-items:center;gap:12px;padding:13px;margin-top:13px;border:1px dashed var(--border);border-radius:12px;background:var(--surface2)}.sub-empty-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:9px;background:var(--blue3);color:var(--blue);font:900 20px var(--mono)}.sub-empty strong,.sub-empty span{display:block}.sub-empty strong{font-size:11px}.sub-empty span{font-size:9px;color:var(--muted);margin-top:3px}.subs{display:grid;grid-template-columns:1fr;gap:8px;margin-top:12px}.sub{display:grid;grid-template-columns:minmax(74px,.55fr) 1fr 1fr auto;align-items:end;gap:8px;padding:10px;border:1px solid var(--border);background:var(--surface2);border-radius:12px}.sub-top{display:flex;align-items:center;justify-content:space-between;gap:5px;padding-bottom:2px}.sub-top b{font:900 8px var(--mono);color:var(--blue)}.sub-remove{width:30px;height:30px;border:1px solid var(--border);border-radius:7px;background:transparent;color:var(--muted);cursor:pointer;font-size:18px;line-height:1}.sub-remove:hover{border-color:var(--blue);color:var(--text)}.sub label{display:block;font:700 7px var(--mono);color:var(--muted)}.sub input,.sub select{width:100%;height:34px;margin-top:4px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);padding:0 7px;font:800 10px var(--mono)}.sub-foot{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:48px;height:34px;padding:0 6px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.sub-foot span{font:700 5px var(--mono);color:var(--muted);text-align:center}.sub-foot b{color:var(--blue);font:900 10px var(--mono);margin-top:2px}.add,.reset{width:100%;min-height:44px;border:1px dashed var(--border);border-radius:11px;background:transparent;color:var(--muted);font-weight:800;cursor:pointer}.add{margin-top:11px}.add-sub-btn{display:flex;align-items:center;justify-content:center;gap:7px}.add-sub-btn span{font-size:18px;color:var(--blue)}.add:hover,.reset:hover{border-color:var(--blue);color:var(--text)}.badges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.badge{min-width:0;display:flex;align-items:center;gap:8px;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface2);cursor:pointer}.badge input{width:18px;height:18px;flex:0 0 auto;accent-color:var(--blue)}.badge span{font-weight:800;font-size:12px;flex:1;min-width:0}.badge b{font:900 10px var(--mono);color:var(--blue);white-space:nowrap}.reset{background:var(--surface);border-style:solid;margin-top:0}
@media(max-width:900px){.workspace{grid-template-columns:1fr}.pitch{width:min(100%,620px);margin-inline:auto}.right-col{width:100%}}
@media(max-width:760px){.ovr-tool{padding-top:28px}.wrap{width:calc(100% - 18px)}.result-card{position:relative;top:auto;display:block}.breakdown{margin-top:14px;border-left:0;border-top:1px solid var(--border);padding-top:10px;min-width:0}.pitch{width:100%;aspect-ratio:2/3}.card{width:clamp(72px,20vw,94px);padding:5px}.card-top span:last-child{font-size:6px}.card input{height:29px;font-size:10px}.card select{height:24px;font-size:7px}.card-ovr{font-size:8px}.badges{grid-template-columns:1fr}.badge{min-height:52px}.target-row{grid-template-columns:1fr 90px}.block{padding:15px}.sub{grid-template-columns:1fr 1fr auto;gap:7px}.sub-top{grid-column:1/-1;padding-bottom:0}.sub-foot{grid-column:2;grid-row:2;min-width:0}.sub label:first-of-type{grid-column:1}.sub label:nth-of-type(2){grid-column:2}.sub-remove{grid-column:3;grid-row:2}}
@media(max-width:420px){.pitch{min-height:480px}.card{width:74px}.card input{height:27px;font-size:9px}.card select{height:23px}.card-top{margin-bottom:4px}.card-top span:last-child{font-size:5.5px}.block h2{font-size:17px}.badge{padding:13px}.target-row{grid-template-columns:1fr 82px}.sub{grid-template-columns:1fr 1fr auto;padding:9px}.sub-empty{align-items:flex-start}.sub-empty span{line-height:1.4}}
</style>
<script src="../scripts/team-ovr.js"></script>
