---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/tournament-premium.css';
import { DISCORD_URL } from '../../data/tournamentConfig.js';
---

<BaseLayout
  title="Tournament Samples"
  description="Preview FC Mobile tournament brackets, group standings, fixtures and league tables from FCMOBILETOOLS before hosting your own event."
>
  <main class="tp tsamp">
    <div class="tp-wrap">
      <header class="tp-hero">
        <span class="tp-eyebrow" data-reveal>Public showcase · Sample data</span>
        <h1 class="tp-title" data-reveal>See the tournament <span class="tp-shine">experience.</span></h1>
        <p class="tp-lede" data-reveal>
          Explore how a hosted FC Mobile competition can look: match brackets, group tables,
          fixtures, verified-score workflows and a clear route to the final.
        </p>
        <div class="sample-actions" data-reveal>
          <a class="tp-btn" href="/host-a-tournament/">Host with FCMOBILETOOLS</a>
          <a class="tp-btn ghost" href="/tournaments/">Browse tournaments</a>
        </div>
        <dl class="tp-stats" data-reveal>
          <div><b>03</b><span>Format previews</span></div>
          <div><b>01</b><span>Connected knockout path</span></div>
          <div><b>100%</b><span>Illustrative demo data</span></div>
        </dl>
      </header>

      <div class="sample-notice" role="note" data-reveal>
        <span class="notice-mark" aria-hidden="true">i</span>
        <p><strong>These are previews, not live tournaments.</strong> Player names, scores and tables on this page are fictional examples. They demonstrate the presentation and structure hosts can expect; they are not real registrations or recorded match results.</p>
      </div>

      <nav class="sample-jump" aria-label="Jump to a sample format" data-reveal>
        <a href="#knockout"><span>01</span> Knockout bracket <span aria-hidden="true">↘</span></a>
        <a href="#groups"><span>02</span> Groups + knockout <span aria-hidden="true">↘</span></a>
        <a href="#league"><span>03</span> League standings <span aria-hidden="true">↘</span></a>
      </nav>

      <section class="sample-section" id="knockout">
        <header class="sample-heading" data-reveal>
          <div><span class="sample-kicker">Sample 01 / Knockout</span><h2>One bracket. Every round.</h2><p>Follow an eight-player event from the quarter-finals to the champion, with scores shown beside each fixture.</p></div>
          <span class="sample-tag">8 players · Single elimination</span>
        </header>

        <div class="preview-panel" data-reveal>
          <div class="preview-top">
            <div><span class="live-dot"></span><span>COMPETITION PREVIEW</span></div>
            <span class="demo-label">SAMPLE DATA</span>
          </div>
          <div class="knockout-grid">
            <section class="bracket-round">
              <header><span>Round 01</span><b>Quarter-finals</b></header>
              <div class="match-card"><small>Match 01</small><div class="team-row winner"><span>Nova</span><b>3</b></div><div class="team-row"><span>Volt</span><b>1</b></div></div>
              <div class="match-card"><small>Match 02</small><div class="team-row winner"><span>Reign</span><b>2</b></div><div class="team-row"><span>Orbit</span><b>0</b></div></div>
              <div class="match-card"><small>Match 03</small><div class="team-row"><span>Apex</span><b>1</b></div><div class="team-row winner"><span>Frost</span><b>2</b></div></div>
              <div class="match-card"><small>Match 04</small><div class="team-row winner"><span>Pulse</span><b>4</b></div><div class="team-row"><span>Drift</span><b>2</b></div></div>
            </section>

            <section class="bracket-round semi-round">
              <header><span>Round 02</span><b>Semi-finals</b></header>
              <div class="match-card"><small>Match 05</small><div class="team-row winner"><span>Nova</span><b>2</b></div><div class="team-row"><span>Reign</span><b>1</b></div></div>
              <div class="match-card"><small>Match 06</small><div class="team-row"><span>Frost</span><b>0</b></div><div class="team-row winner"><span>Pulse</span><b>3</b></div></div>
              <div class="round-note">Winners advance to the final</div>
            </section>

            <section class="bracket-round final-round">
              <header><span>Round 03</span><b>Grand final</b></header>
              <div class="final-card">
                <span class="cup-mark" aria-hidden="true">✦</span>
                <small>CHAMPIONSHIP MATCH</small>
                <div class="final-team"><span>Nova</span><b>2</b></div>
                <div class="final-team champion"><span>Pulse</span><b>3</b></div>
                <div class="champion-stamp">PULSE · SAMPLE CHAMPION</div>
              </div>
              <div class="third-card"><small>Third-place match</small><b>Reign <span>1–0</span> Frost</b></div>
            </section>
          </div>
          <footer class="preview-foot"><span>Example results shown for visual demonstration.</span><span>03 rounds · 08 entrants</span></footer>
        </div>
      </section>

      <section class="sample-section" id="groups">
        <header class="sample-heading" data-reveal>
          <div><span class="sample-kicker">Sample 02 / Hybrid</span><h2>Groups that lead into knockouts.</h2><p>Give players a group-stage run, publish the table, then move qualifiers into the semi-finals and final.</p></div>
          <span class="sample-tag">8 players · 2 groups</span>
        </header>

        <div class="preview-panel" data-reveal>
          <div class="preview-top">
            <div><span class="live-dot"></span><span>GROUP STAGE TABLES</span></div>
            <span class="demo-label">SAMPLE DATA</span>
          </div>
          <div class="groups-grid">
            <section class="table-card">
              <header><b>Group A</b><span>Top 2 qualify</span></header>
              <table><thead><tr><th scope="col">#</th><th scope="col">Player</th><th scope="col">P</th><th scope="col">GD</th><th scope="col">Pts</th></tr></thead>
                <tbody>
                  <tr class="qualified"><td>1</td><th scope="row">Atlas</th><td>3</td><td>+4</td><td><b>7</b></td></tr>
                  <tr class="qualified"><td>2</td><th scope="row">Zenith</th><td>3</td><td>+2</td><td><b>6</b></td></tr>
                  <tr><td>3</td><th scope="row">Echo</th><td>3</td><td>−2</td><td>3</td></tr>
                  <tr><td>4</td><th scope="row">Orbit</th><td>3</td><td>−4</td><td>1</td></tr>
                </tbody>
              </table>
            </section>
            <section class="table-card">
              <header><b>Group B</b><span>Top 2 qualify</span></header>
              <table><thead><tr><th scope="col">#</th><th scope="col">Player</th><th scope="col">P</th><th scope="col">GD</th><th scope="col">Pts</th></tr></thead>
                <tbody>
                  <tr class="qualified"><td>1</td><th scope="row">Pulse</th><td>3</td><td>+3</td><td><b>7</b></td></tr>
                  <tr class="qualified"><td>2</td><th scope="row">Nova</th><td>3</td><td>+3</td><td><b>6</b></td></tr>
                  <tr><td>3</td><th scope="row">Frost</th><td>3</td><td>−2</td><td>3</td></tr>
                  <tr><td>4</td><th scope="row">Volt</th><td>3</td><td>−4</td><td>1</td></tr>
                </tbody>
              </table>
            </section>
          </div>

          <div class="playoff-block">
            <div class="playoff-heading"><div><span class="sample-kicker">Knockout phase</span><h3>From qualification to the final</h3></div><span class="demo-label">EXAMPLE SCORES</span></div>
            <div class="playoff-grid">
              <div class="playoff-match"><small>SEMI-FINAL 01</small><div><span>Atlas</span><b>1</b></div><div class="win"><span>Nova</span><b>2</b></div></div>
              <div class="playoff-match"><small>SEMI-FINAL 02</small><div class="win"><span>Pulse</span><b>3</b></div><div><span>Zenith</span><b>1</b></div></div>
              <div class="playoff-match playoff-final"><small>GRAND FINAL</small><div><span>Nova</span><b>1</b></div><div class="win"><span>Pulse</span><b>2</b></div><em>Pulse · Sample champion</em></div>
            </div>
          </div>
          <footer class="preview-foot"><span>Group standings and knockout results in one place.</span><span>Group → Semi-finals → Final</span></footer>
        </div>
      </section>

      <section class="sample-section" id="league">
        <header class="sample-heading" data-reveal>
          <div><span class="sample-kicker">Sample 03 / League</span><h2>A season at a glance.</h2><p>Keep the table, points race and completed fixtures together so players can follow progress without chasing updates.</p></div>
          <span class="sample-tag">6 players · Round robin</span>
        </header>

        <div class="league-layout" data-reveal>
          <div class="preview-panel league-table-panel">
            <div class="preview-top"><div><span class="live-dot"></span><span>LEAGUE TABLE</span></div><span class="demo-label">SAMPLE DATA</span></div>
            <div class="table-scroll">
              <table class="league-table"><thead><tr><th scope="col">#</th><th scope="col">Player</th><th scope="col">P</th><th scope="col">W</th><th scope="col">D</th><th scope="col">L</th><th scope="col">GD</th><th scope="col">Pts</th></tr></thead>
                <tbody>
                  <tr class="leader"><td>1</td><th scope="row">Reign</th><td>5</td><td>4</td><td>1</td><td>0</td><td>+6</td><td><b>13</b></td></tr>
                  <tr><td>2</td><th scope="row">Atlas</th><td>5</td><td>3</td><td>1</td><td>1</td><td>+3</td><td><b>10</b></td></tr>
                  <tr><td>3</td><th scope="row">Nova</th><td>5</td><td>3</td><td>0</td><td>2</td><td>+3</td><td><b>9</b></td></tr>
                  <tr><td>4</td><th scope="row">Pulse</th><td>5</td><td>2</td><td>1</td><td>2</td><td>0</td><td><b>7</b></td></tr>
                  <tr><td>5</td><th scope="row">Frost</th><td>5</td><td>1</td><td>0</td><td>4</td><td>−4</td><td><b>3</b></td></tr>
                  <tr><td>6</td><th scope="row">Volt</th><td>5</td><td>0</td><td>1</td><td>4</td><td>−8</td><td><b>1</b></td></tr>
                </tbody>
              </table>
            </div>
            <div class="table-key"><span><i></i> Top of table</span><span>Win 3 pts · Draw 1 pt</span></div>
          </div>

          <aside class="preview-panel fixtures-panel">
            <div class="preview-top"><div><span class="live-dot"></span><span>RECENT RESULTS</span></div><span class="demo-label">SAMPLE DATA</span></div>
            <div class="fixture-list">
              <div class="fixture-date">MATCHDAY 05</div>
              <div class="result-row"><span>Reign</span><b>2 – 0</b><span>Atlas</span><i>Final</i></div>
              <div class="result-row"><span>Nova</span><b>1 – 1</b><span>Pulse</span><i>Final</i></div>
              <div class="fixture-date">MATCHDAY 04</div>
              <div class="result-row"><span>Atlas</span><b>3 – 1</b><span>Frost</span><i>Final</i></div>
              <div class="result-row"><span>Reign</span><b>2 – 1</b><span>Volt</span><i>Final</i></div>
            </div>
            <p class="fixtures-note">Completed scores stay alongside the standings for quick reference.</p>
          </aside>
        </div>
      </section>

      <section class="sample-operations tp-sec" data-reveal>
        <div class="operations-copy"><span class="sample-kicker">The host workflow</span><h2>More than a bracket.</h2><p>Competition pages are only part of the setup. The hosting workflow is designed around match coordination, submitted score evidence and a clear route for resolving disputed results.</p></div>
        <div class="operation-list">
          <article><span>01</span><div><b>Set the competition</b><p>Choose a format, entrant count, stages and rules with the host team.</p></div></article>
          <article><span>02</span><div><b>Keep results accountable</b><p>Players report scores with screenshot evidence and their opponent can confirm or dispute them.</p></div></article>
          <article><span>03</span><div><b>Publish the progress</b><p>Show the standings, fixtures and bracket progression in a shareable public page.</p></div></article>
        </div>
      </section>

      <section class="tp-glass gold sample-cta tp-sec" data-reveal>
        <div class="in-c">
          <span class="sample-kicker">For tournament hosts</span>
          <h2>Your community. A proper competition page.</h2>
          <p>Tell us your format, expected player count and event timeline. We can discuss the setup and what your event needs.</p>
          <div class="sample-actions">
            <a class="tp-btn discord" href={DISCORD_URL} rel="noopener noreferrer">Talk to us on Discord</a>
            <a class="tp-btn ghost" href="/host-a-tournament/">Hosting details</a>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initFx } from '../../lib/tournamentFx.js';
  initFx();
</script>

<style>
  .tsamp { --samp-line:rgba(255,255,255,.09); --samp-surface:rgba(10,18,29,.88); }
  .tsamp .sample-actions { display:flex;justify-content:center;align-items:center;gap:12px;flex-wrap:wrap;margin-top:30px; }
  .tsamp .sample-notice { display:flex;align-items:flex-start;gap:14px;max-width:940px;margin:0 auto;padding:18px 20px;border:1px solid rgba(76,201,255,.22);border-radius:18px;background:rgba(76,201,255,.055); }
  .tsamp .notice-mark { display:grid;place-items:center;flex:none;width:25px;height:25px;border:1px solid rgba(76,201,255,.45);border-radius:50%;color:#8bddff;font:700 14px 'Space Grotesk'; }
  .tsamp .sample-notice p { margin:0;color:#aebdcb;font-size:13.5px;line-height:1.7; }
  .tsamp .sample-notice strong { color:#f4f7fb; }
  .tsamp .sample-jump { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:22px auto 0; }
  .tsamp .sample-jump a { display:flex;align-items:center;gap:10px;min-width:0;padding:15px 16px;border:1px solid var(--samp-line);border-radius:14px;background:rgba(255,255,255,.025);color:#dce5ee;text-decoration:none;font-size:13.5px;font-weight:650;transition:background .2s,border-color .2s,transform .2s; }
  .tsamp .sample-jump a:hover { transform:translateY(-2px);border-color:rgba(76,201,255,.35);background:rgba(76,201,255,.06); }
  .tsamp .sample-jump a span:first-child { color:#4cc9ff;font:700 12px 'Space Grotesk'; }
  .tsamp .sample-jump a span:last-child { margin-left:auto;color:#778a9c; }
  .tsamp .sample-section { margin-top:clamp(58px,8vw,94px);scroll-margin-top:30px; }
  .tsamp .sample-heading { display:flex;align-items:flex-end;justify-content:space-between;gap:22px;margin-bottom:22px; }
  .tsamp .sample-kicker { display:block;margin-bottom:10px;color:#f3c65e;font:700 11px/1.4 Inter,system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase; }
  .tsamp .sample-heading h2,.tsamp .operations-copy h2 { font-size:clamp(28px,4vw,44px);line-height:1.05; }
  .tsamp .sample-heading p { max-width:58ch;margin:12px 0 0;color:#97a8b9;font-size:14.5px;line-height:1.7; }
  .tsamp .sample-tag { display:inline-flex;align-items:center;justify-content:center;flex:none;padding:10px 13px;border:1px solid rgba(255,255,255,.11);border-radius:99px;color:#aebdcb;background:rgba(255,255,255,.035);font-size:11px;font-weight:700;letter-spacing:.04em; }
  .tsamp .preview-panel { min-width:0;overflow:hidden;border:1px solid rgba(255,255,255,.09);border-radius:22px;background:linear-gradient(155deg,rgba(15,27,41,.97),rgba(7,13,21,.97));box-shadow:0 28px 70px -48px rgba(0,0,0,.9); }
  .tsamp .preview-top { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 20px;border-bottom:1px solid var(--samp-line); }
  .tsamp .preview-top>div { display:flex;align-items:center;gap:9px;color:#c0ccd8;font-size:10px;font-weight:800;letter-spacing:.13em; }
  .tsamp .live-dot { width:6px;height:6px;border-radius:50%;background:#4cc9ff;box-shadow:0 0 13px rgba(76,201,255,.8); }
  .tsamp .demo-label { flex:none;color:#f4c85f;font-size:9px;font-weight:800;letter-spacing:.13em; }
  .tsamp .knockout-grid { display:grid;grid-template-columns:1.12fr .95fr .82fr;gap:14px;padding:22px;align-items:stretch; }
  .tsamp .bracket-round { display:flex;flex-direction:column;gap:12px;min-width:0; }
  .tsamp .bracket-round>header { display:flex;flex-direction:column;gap:5px;min-height:43px;padding:0 2px 8px;border-bottom:1px solid var(--samp-line); }
  .tsamp .bracket-round>header span { color:#72879b;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase; }
  .tsamp .bracket-round>header b { color:#eaf1f7;font:700 15px 'Space Grotesk'; }
  .tsamp .match-card { padding:10px 12px;border:1px solid rgba(255,255,255,.065);border-radius:13px;background:rgba(255,255,255,.025); }
  .tsamp .match-card>small,.tsamp .third-card>small { display:block;margin-bottom:8px;color:#718499;font-size:9px;font-weight:750;letter-spacing:.1em;text-transform:uppercase; }
  .tsamp .team-row,.tsamp .final-team { display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 8px;color:#a4b3c1;border-radius:7px;font-size:12.5px; }
  .tsamp .team-row b,.tsamp .final-team b { min-width:17px;text-align:center;color:#f4f7fb;font:700 13px 'Space Grotesk';font-variant-numeric:tabular-nums; }
  .tsamp .team-row.winner,.tsamp .final-team.champion { color:#ecfaff;background:rgba(76,201,255,.075); }
  .tsamp .team-row.winner b,.tsamp .final-team.champion b { color:#7edfff; }
  .tsamp .round-note { margin-top:auto;padding:10px 11px;border:1px dashed rgba(255,255,255,.12);border-radius:10px;color:#8294a5;font-size:11px;line-height:1.5; }
  .tsamp .final-card { padding:18px 14px;border:1px solid rgba(246,196,83,.25);border-radius:16px;background:linear-gradient(150deg,rgba(246,196,83,.075),rgba(255,255,255,.015));text-align:center; }
  .tsamp .cup-mark { display:grid;place-items:center;width:35px;height:35px;margin:0 auto 10px;border:1px solid rgba(246,196,83,.25);border-radius:12px;color:#ffe29a;background:rgba(246,196,83,.08); }
  .tsamp .final-card>small { display:block;margin-bottom:12px;color:#b9a671;font-size:8px;font-weight:800;letter-spacing:.11em; }
  .tsamp .final-team { padding:10px 9px;text-align:left; }
  .tsamp .champion-stamp { margin-top:12px;padding-top:12px;border-top:1px solid rgba(246,196,83,.18);color:#f6d88b;font-size:8px;font-weight:800;letter-spacing:.08em; }
  .tsamp .third-card { margin-top:13px;padding:12px;border:1px solid var(--samp-line);border-radius:12px;background:rgba(255,255,255,.02); }
  .tsamp .third-card>small { margin-bottom:7px; }
  .tsamp .third-card>b { color:#cbd6e0;font-size:12px; }
  .tsamp .third-card>b span { color:#f6d88b;font-variant-numeric:tabular-nums; }
  .tsamp .preview-foot { display:flex;justify-content:space-between;gap:16px;padding:13px 20px;border-top:1px solid var(--samp-line);color:#798da1;font-size:10.5px; }
  .tsamp .groups-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:20px; }
  .tsamp .table-card { min-width:0;overflow:hidden;border:1px solid var(--samp-line);border-radius:14px;background:rgba(255,255,255,.018); }
  .tsamp .table-card>header { display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 15px;border-bottom:1px solid var(--samp-line); }
  .tsamp .table-card>header b { color:#f2f6fb;font:700 17px 'Space Grotesk'; }
  .tsamp .table-card>header span { color:#8ba0b1;font-size:10px; }
  .tsamp .table-card table,.tsamp .league-table { width:100%;border-collapse:collapse;font-size:12px; }
  .tsamp .table-card th,.tsamp .table-card td,.tsamp .league-table th,.tsamp .league-table td { padding:12px 10px;border-bottom:1px solid rgba(255,255,255,.045);text-align:right;white-space:nowrap;color:#9dacbb;font-variant-numeric:tabular-nums; }
  .tsamp .table-card thead th,.tsamp .league-table thead th { color:#6f8499;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase; }
  .tsamp .table-card tr>*:nth-child(2),.tsamp .league-table tr>*:nth-child(2) { text-align:left; }
  .tsamp .table-card tbody th,.tsamp .league-table tbody th { color:#d6e0e9;font-weight:650; }
  .tsamp .table-card tbody tr:last-child>*,.tsamp .league-table tbody tr:last-child>* { border-bottom:0; }
  .tsamp .table-card .qualified { background:rgba(78,224,160,.04); }
  .tsamp .table-card .qualified td:first-child { color:#58dba8; }
  .tsamp .table-card .qualified td:last-child,.tsamp .table-card .qualified td:last-child b { color:#76e5b7; }
  .tsamp .playoff-block { padding:0 20px 20px; }
  .tsamp .playoff-heading { display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:13px;padding-top:20px;border-top:1px solid var(--samp-line); }
  .tsamp .playoff-heading h3 { font-size:22px; }
  .tsamp .playoff-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px; }
  .tsamp .playoff-match { padding:13px;border:1px solid var(--samp-line);border-radius:13px;background:rgba(255,255,255,.02); }
  .tsamp .playoff-match>small { display:block;margin-bottom:10px;color:#7f93a7;font-size:9px;font-weight:800;letter-spacing:.1em; }
  .tsamp .playoff-match>div { display:flex;justify-content:space-between;gap:10px;padding:7px 8px;color:#9fb0be;font-size:12px; }
  .tsamp .playoff-match>div b { color:#f3f7fb;font-family:'Space Grotesk'; }
  .tsamp .playoff-match>div.win { border-radius:7px;background:rgba(76,201,255,.075);color:#e9faff; }
  .tsamp .playoff-match>div.win b { color:#7edfff; }
  .tsamp .playoff-final { border-color:rgba(246,196,83,.23); }
  .tsamp .playoff-final em { display:block;margin-top:9px;color:#f6d88b;font-size:9px;font-style:normal;font-weight:750;letter-spacing:.04em; }
  .tsamp .league-layout { display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.75fr);gap:16px;align-items:start; }
  .tsamp .table-scroll { overflow-x:auto; }
  .tsamp .league-table { min-width:530px; }
  .tsamp .league-table th,.tsamp .league-table td { padding:13px 11px; }
