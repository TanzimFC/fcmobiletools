---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="Community Leaderboards | FCMobiletools"
  description="Weekly, monthly and all-time FCMobiletools community leaderboards powered by server-verified progression and tournament metrics."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="lb-page">
    <div class="lb-wrap">
      <AccountNav active="leaderboard" sectionLabel="Leaderboards" />

      <header class="lb-head acc-anim">
        <div>
          <span class="lb-kicker"><i class="lb-dot"></i> METRIC-DRIVEN RANKINGS</span>
          <h1>See who is climbing.</h1>
          <p>
            Rankings are powered by server-side snapshots across Weekly, Monthly and All-Time windows. Only accounts with public profile visibility enabled appear on public boards.
          </p>
        </div>

        <div class="lb-filters" id="lbFilters" role="group" aria-label="Filter leaderboards by period">
          <button type="button" class="lb-pill active" data-period="all">All Boards</button>
          <button type="button" class="lb-pill" data-period="weekly">Weekly</button>
          <button type="button" class="lb-pill" data-period="monthly">Monthly</button>
          <button type="button" class="lb-pill" data-period="all_time">All Time</button>
        </div>
      </header>

      <div id="root" class="lb-root">
        <div class="acc-skel lb-skel" aria-label="Loading leaderboards"></div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { escapeHtml as esc } from '../../lib/account-client.js';

  const root = document.getElementById('root');
  const fmt = (v) => Number(v || 0).toLocaleString();
  const titleCase = (v) =>
    String(v || '')
      .replaceAll('_', ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

  let allBoards = [];
  let selectedPeriod = 'all';

  function renderBoards() {
    const filtered =
      selectedPeriod === 'all'
        ? allBoards
        : allBoards.filter((b) => String(b.periodType || '').toLowerCase() === selectedPeriod);

    if (!filtered.length) {
      root.innerHTML = `
        <section class="lb-empty-card acc-anim">
          <span class="lb-empty-badge">CONFIGURABLE RANKING ENGINE</span>
          <h2>${allBoards.length ? 'No leaderboards for this time window' : 'No leaderboard is published yet'}</h2>
          <p>
            ${
              allBoards.length
                ? 'Select another period filter above to view published rankings.'
                : 'The FCMobiletools snapshot ranking engine is ready for Weekly, Monthly and All-Time boards across XP, tournament performance and community contributions.'
            }
          </p>

          <div class="lb-tier-preview">
            <article>
              <span class="tier-tag">WEEKLY</span>
              <strong>7-Day Sprint</strong>
              <p>Tracks active contributors and tournament competitors over the current week.</p>
            </article>
            <article>
              <span class="tier-tag">MONTHLY</span>
              <strong>Season Cycle</strong>
              <p>Aligned with monthly FC Mobile events and Division Rivals cycles.</p>
            </article>
            <article>
              <span class="tier-tag">ALL TIME</span>
              <strong>Hall of Records</strong>
              <p>Long-term standing across verified progression and tournament titles.</p>
            </article>
          </div>

          <div class="lb-empty-actions">
            <a class="lb-btn-primary" href="/profile/">Open My Profile →</a>
            <a class="lb-btn-secondary" href="/tournaments">View Live Tournaments</a>
          </div>
        </section>
      `;
      return;
    }

    root.innerHTML = `
      <div class="lb-stack acc-anim">
        ${filtered
          .map((board) => {
            const rows = Array.isArray(board.rows) ? board.rows : [];
            const top3 = rows.slice(0, 3);
            return `
              <section class="lb-board">
                <div class="lb-board-head">
                  <div>
                    <div class="lb-board-tags">
                      <span class="lb-tag">${esc(titleCase(board.periodType || 'All Time'))}</span>
                      ${board.metricKey ? `<span class="lb-tag lb-tag--sub">${esc(titleCase(board.metricKey))}</span>` : ''}
                    </div>
                    <h2>${esc(board.name)}</h2>
                    ${board.description ? `<p>${esc(board.description)}</p>` : ''}
                  </div>
                  <span class="lb-count">${fmt(rows.length)} ranked</span>
                </div>

                ${
                  top3.length
                    ? `<div class="lb-podium">
                        ${top3
                          .map(
                            (entry, idx) => `
                          <a class="podium-card rank-${idx + 1}" href="/profile/${encodeURIComponent(entry.username)}/">
                            <span class="podium-rank">#${fmt(entry.rank)}</span>
                            <div class="podium-avatar">${esc(String(entry.displayName || entry.username).slice(0, 2).toUpperCase())}</div>
                            <strong>${esc(entry.displayName || entry.username)}</strong>
                            <small>@${esc(entry.username)}</small>
                            <b class="podium-score">${fmt(entry.score)}</b>
                          </a>
                        `
                          )
                          .join('')}
                      </div>`
                    : ''
                }

                ${
                  rows.length
                    ? `<div class="lb-table">
                        ${rows
                          .map(
                            (entry) => `
                          <a class="lb-row" href="/profile/${encodeURIComponent(entry.username)}/">
                            <span class="lb-rank ${entry.rank <= 3 ? 'is-top' : ''}">#${fmt(entry.rank)}</span>
                            <div class="lb-user">
                              <strong>${esc(entry.displayName || entry.username)}</strong>
                              <small>@${esc(entry.username)}</small>
                            </div>
                            <span class="lb-score">${fmt(entry.score)}</span>
                          </a>
                        `
                          )
                          .join('')}
                      </div>`
                    : `<div class="lb-no-rows">No public entries recorded for this snapshot period yet.</div>`
                }
              </section>
            `;
          })
          .join('')}
      </div>
    `;
  }

  document.querySelectorAll('#lbFilters .lb-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#lbFilters .lb-pill').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPeriod = btn.dataset.period || 'all';
      renderBoards();
    });
  });

  async function load() {
    const response = await fetch('/api/public/leaderboard', { cache: 'no-store' });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'Unable to load leaderboards.');
    allBoards = Array.isArray(body.leaderboards) ? body.leaderboards : [];
    renderBoards();
  }

  load().catch((error) => {
    root.innerHTML = `<section class="lb-empty-card"><h2>Unable to load leaderboards</h2><p>${esc(error.message)}</p></section>`;
  });
</script>

<style is:global>
  .lb-page {
    min-height: calc(100vh - 80px);
    padding: 36px 18px 110px;
    background: radial-gradient(880px 440px at 50% 0%, rgba(76, 201, 255, 0.07), transparent 65%);
  }
  .lb-wrap {
    width: min(1140px, 100%);
    margin: 0 auto;
  }
  .lb-skel {
    height: 360px;
    border-radius: 24px;
  }

  .lb-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .lb-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.14em;
  }
  .lb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cc9ff;
    box-shadow: 0 0 10px #4cc9ff;
  }
  .lb-head h1 {
    margin: 10px 0 8px;
    font: 700 clamp(30px, 4.5vw, 48px) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
    color: #f5f8fb;
  }
  .lb-head p {
    margin: 0;
    max-width: 640px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }

  .lb-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .lb-pill {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(15, 26, 38, 0.85);
    color: #90a6b7;
    font: 700 12.5px/1 var(--font-body);
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease;
  }
  .lb-pill.active {
    color: #04131c;
    border-color: #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    font-weight: 800;
  }

  .lb-stack {
    display: grid;
    gap: 18px;
  }
  .lb-board {
    padding: 26px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 22px 58px rgba(0, 0, 0, 0.28);
  }
  .lb-board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 20px;
  }
  .lb-board-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .lb-tag {
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.12);
    border: 1px solid rgba(76, 201, 255, 0.26);
    color: #8ce2ff;
    font: 800 11px/1 var(--font-body);
  }
  .lb-tag--sub {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.09);
    color: #9bb1c1;
  }
  .lb-board-head h2 {
    margin: 0;
    font: 700 24px/1.15 var(--font-display);
    color: #f5f8fb;
  }
  .lb-board-head p {
    margin: 5px 0 0;
    color: #8ea4b5;
    font: 500 13.5px/1.5 var(--font-body);
  }
  .lb-count {
    padding: 6px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: #9cb2c2;
    font: 700 12px/1 var(--font-body);
  }

  .lb-podium {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }
  .podium-card {
    padding: 18px;
    border-radius: 18px;
    border: 1px solid rgba(76, 201, 255, 0.2);
    background: rgba(7, 16, 24, 0.78);
    text-decoration: none;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 4px;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .podium-card:hover {
    transform: translateY(-2px);
    border-color: #4cc9ff;
  }
  .podium-card.rank-1 {
    border-color: rgba(255, 211, 110, 0.4);
    background: radial-gradient(circle at 50% 0%, rgba(255, 211, 110, 0.12), rgba(7, 16, 24, 0.85) 65%);
  }
  .podium-rank {
    font: 800 12px/1 var(--font-body);
    color: #ffd36e;
  }
  .podium-avatar {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    margin: 4px 0;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font: 800 16px/1 var(--font-display);
  }
  .podium-card strong {
    color: #f5f8fb;
    font: 700 15px/1.2 var(--font-display);
  }
  .podium-card small {
    color: #849caf;
    font: 500 12px/1.2 var(--font-body);
  }
  .podium-score {
    margin-top: 6px;
    color: #4cc9ff;
    font: 800 16px/1 var(--font-display);
  }

  .lb-table {
    display: grid;
    gap: 8px;
  }
  .lb-row {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: #09141e;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .lb-row:hover {
    border-color: rgba(76, 201, 255, 0.35);
    transform: translateX(2px);
  }
  .lb-rank {
    color: #829bb0;
    font: 800 14px/1 var(--font-display);
  }
  .lb-rank.is-top {
    color: #ffd36e;
  }
  .lb-user strong {
    display: block;
    color: #f5f8fb;
    font: 700 14px/1.25 var(--font-body);
  }
  .lb-user small {
    display: block;
    margin-top: 2px;
    color: #7d95a6;
    font: 500 12px/1.2 var(--font-body);
  }
  .lb-score {
    color: #7ee0ff;
    font: 800 15px/1 var(--font-display);
  }
  .lb-no-rows {
    padding: 20px;
    border-radius: 14px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    color: #879fb0;
    text-align: center;
    font: 500 13.5px/1.5 var(--font-body);
  }

  /* Empty State */
  .lb-empty-card {
    padding: 36px;
    border-radius: 24px;
    border: 1px solid rgba(76, 201, 255, 0.18);
    background:
      radial-gradient(circle at 0% 0%, rgba(76, 201, 255, 0.09), transparent 55%),
      linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 24px 65px rgba(0, 0, 0, 0.3);
  }
  .lb-empty-badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.1);
    border: 1px solid rgba(76, 201, 255, 0.24);
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.1em;
  }
  .lb-empty-card h2 {
    margin: 14px 0 8px;
    font: 700 clamp(24px, 3.5vw, 34px) / 1.12 var(--font-display);
    color: #f5f8fb;
  }
  .lb-empty-card > p {
    margin: 0 0 22px;
    max-width: 680px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }
  .lb-tier-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .lb-tier-preview article {
    padding: 16px;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(7, 16, 24, 0.68);
  }
  .tier-tag {
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.1em;
  }
  .lb-tier-preview strong {
    display: block;
    margin: 6px 0 4px;
    color: #f5f8fb;
    font: 700 15px/1.25 var(--font-display);
  }
  .lb-tier-preview p {
    margin: 0;
    color: #88a0b2;
    font: 500 13px/1.5 var(--font-body);
  }
  .lb-empty-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .lb-btn-primary,
  .lb-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 12px;
    font: 700 13px/1 var(--font-body);
    text-decoration: none;
  }
  .lb-btn-primary {
    border: 1px solid #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font-weight: 800;
  }
  .lb-btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #101e2c;
    color: #e3eef6;
  }

  @media (max-width: 820px) {
    .lb-podium,
    .lb-tier-preview {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .lb-page {
      padding: 20px 12px 106px;
    }
    .lb-board,
    .lb-empty-card {
      padding: 20px 16px;
      border-radius: 20px;
    }
    .lb-row {
      grid-template-columns: 44px 1fr auto;
      padding: 12px;
    }
  }
</style>
