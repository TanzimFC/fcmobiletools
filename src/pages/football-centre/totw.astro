---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Football Centre · TOTW" description="FC Mobile Team of the Week tracker and player guide.">
  <main class="totw-page">
    <section class="totw-hero">
      <div>
        <span class="eyebrow">TEAM OF THE WEEK</span>
        <h1>TOTW <span>Player Hub</span></h1>
        <p>Track the latest Team of the Week update, inspect player roles, and keep an eye on the release before spending your FC Mobile resources.</p>
        <div class="totw-actions">
          <a href="https://www.youtube.com/watch?v=KvgulT3RtFE" target="_blank" rel="noopener noreferrer">Watch the latest update ↗</a>
          <span class="status-pill"><i></i> Update reference</span>
        </div>
      </div>
      <div class="totw-orb" aria-hidden="true"><b>TOTW</b><span>PLAYER<br/>HUB</span></div>
    </section>

    <section class="totw-video card">
      <div class="section-head"><div><span class="label">LATEST VIDEO</span><h2>What changed?</h2></div><span class="chip">VIDEO UPDATE</span></div>
      <div class="video-frame"><iframe src="https://www.youtube.com/embed/KvgulT3RtFE" title="FC Mobile TOTW update" loading="lazy" allowfullscreen></iframe></div>
    </section>

    <section class="section-head standalone"><div><span class="label">PLAYER FOCUS</span><h2>Build your shortlist</h2><p>Use this area for the players you actually care about instead of a long unverified card dump.</p></div></section>
    <section class="player-grid">
      <article class="player-card card"><div class="player-badge">LW</div><div><span class="label">ATTACK</span><h3>Best attacker</h3><p>Track the highest-impact forward once the weekly squad is confirmed.</p></div><span class="rating">—</span></article>
      <article class="player-card card"><div class="player-badge">CM</div><div><span class="label">MIDFIELD</span><h3>Best creator</h3><p>Compare passing, pace and work rate before choosing a midfield upgrade.</p></div><span class="rating">—</span></article>
      <article class="player-card card"><div class="player-badge">CB</div><div><span class="label">DEFENCE</span><h3>Best defender</h3><p>Watch for strong defensive stats, pace and useful in-game body types.</p></div><span class="rating">—</span></article>
      <article class="player-card card"><div class="player-badge">GK</div><div><span class="label">GOALKEEPER</span><h3>Best keeper</h3><p>Compare handling, reflexes and height before committing your resources.</p></div><span class="rating">—</span></article>
    </section>

    <section class="totw-guide grid-two">
      <article class="card"><span class="label">HOW TO USE</span><h3>1. Check the update</h3><p>Watch the linked update first, then confirm that the players are actually available in game.</p></article>
      <article class="card"><span class="label">THEN COMPARE</span><h3>2. Pick for your squad</h3><p>Prioritize positions you need. A higher OVR is not automatically a better fit for every squad.</p></article>
      <article class="card"><span class="label">RESOURCE CHECK</span><h3>3. Spend carefully</h3><p>Check your coins, points and upgrade path before buying or ranking a player.</p></article>
      <article class="card"><span class="label">WEEKLY RESET</span><h3>4. Revisit each TOTW</h3><p>This hub is designed to be refreshed weekly as new Team of the Week information becomes available.</p></article>
    </section>
  </main>

  <style>
    .totw-page{width:min(1180px,calc(100% - 40px));margin:auto;padding:34px 0 90px}.totw-hero{min-height:360px;border:1px solid var(--border);border-radius:24px;background:radial-gradient(circle at 82% 35%,#55c7f222,transparent 28%),linear-gradient(145deg,#0e1a24,#091016);padding:54px;display:flex;align-items:center;justify-content:space-between;gap:30px;overflow:hidden}.totw-hero h1{font-size:clamp(42px,6vw,76px);line-height:.95;letter-spacing:-.055em;margin:12px 0 18px}.totw-hero h1 span{color:var(--blue)}.totw-hero p{max-width:620px;color:var(--muted);font-size:14px;line-height:1.75}.eyebrow,.label{font:800 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.totw-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:24px}.totw-actions>a{display:inline-flex;align-items:center;min-height:42px;padding:10px 15px;border-radius:10px;background:linear-gradient(135deg,var(--blue),var(--blue2));color:#04131c;font-size:11px;font-weight:850}.status-pill,.chip{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--surface);border-radius:999px;padding:9px 12px;color:var(--muted);font:700 8px var(--mono);letter-spacing:.08em}.status-pill i{width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px #55c7f21a}.totw-orb{width:220px;height:220px;flex:0 0 220px;border:1px solid #55c7f244;border-radius:50%;display:grid;place-items:center;text-align:center;background:radial-gradient(circle,#55c7f21c,#081018 65%);box-shadow:inset 0 0 50px #55c7f20f}.totw-orb b{font:900 40px var(--mono);color:var(--blue)}.totw-orb span{position:absolute;margin-top:125px;font:800 8px var(--mono);letter-spacing:.16em;color:#8291a2}.totw-video{margin-top:18px;padding:22px}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.section-head h2{margin:5px 0 0;font-size:25px;letter-spacing:-.03em}.video-frame{aspect-ratio:16/9;border-radius:14px;overflow:hidden;border:1px solid var(--border);background:#05070a}.video-frame iframe{width:100%;height:100%;border:0}.standalone{margin:48px 0 18px}.standalone p{color:var(--muted);font-size:12px;margin:6px 0 0}.player-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.player-card{min-height:150px;padding:22px;display:grid;grid-template-columns:58px 1fr auto;align-items:center;gap:16px}.player-badge{width:58px;height:72px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(145deg,#12354a,#0d1118);border:1px solid #55c7f233;color:var(--blue);font:900 12px var(--mono)}.player-card h3{margin:6px 0 5px;font-size:18px}.player-card p,.totw-guide p{margin:0;color:var(--muted);font-size:11px;line-height:1.65}.rating{font:900 18px var(--mono);color:#718094}.grid-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}.grid-two .card{padding:22px}.grid-two h3{margin:7px 0 6px;font-size:17px}.card{border:1px solid var(--border);border-radius:18px;background:var(--surface)}
    @media(max-width:700px){.totw-page{width:calc(100% - 18px);padding-top:14px}.totw-hero{min-height:0;padding:30px 22px;align-items:flex-start}.totw-orb{width:125px;height:125px;flex-basis:125px}.totw-orb b{font-size:21px}.totw-orb span{margin-top:74px;font-size:6px}.totw-hero h1{font-size:42px}.totw-hero p{font-size:12px}.player-grid,.grid-two{grid-template-columns:1fr}.player-card{grid-template-columns:50px 1fr auto;padding:18px}.player-badge{width:50px;height:62px}.section-head{align-items:flex-start}.totw-video{padding:15px}.totw-actions>a{width:100%;justify-content:center}}
    @media(max-width:460px){.totw-orb{display:none}.totw-hero{padding:28px 20px}.totw-hero h1{font-size:38px}.totw-hero p{font-size:11px}.player-card{grid-template-columns:46px 1fr}.player-card .rating{display:none}}
  </style>
</BaseLayout>
