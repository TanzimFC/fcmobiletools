---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Football Centre · Settings" description="Football Centre settings and backup tools.">
  <section class="route-shell"><div class="route-head"><div><p class="eyebrow">FOOTBALL CENTRE</p><h1>Settings</h1><p>Cycle structure, scoring rules and backup controls.</p></div><a href="/football-centre" class="back">← Dashboard</a></div><iframe src="/legacy/football-centre.html#settings" title="Football Centre settings" class="app-frame"></iframe></section>
</BaseLayout>
<style>.route-shell{width:min(1240px,calc(100% - 28px));margin:auto;padding:30px 0 60px}.route-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:16px}.eyebrow{font-size:10px;letter-spacing:.14em;font-weight:900;color:#7c8b9c}.route-head h1{font-size:38px;letter-spacing:-.05em;margin:5px 0}.route-head p:not(.eyebrow){color:#7d8795;margin:0}.back{padding:10px 12px;border:1px solid #263747;border-radius:10px;text-decoration:none;color:#dce8f2;background:#101a24;font-size:11px;font-weight:800}.app-frame{width:100%;height:1500px;border:1px solid #20303e;border-radius:18px;background:#050b12}@media(max-width:700px){.route-shell{width:calc(100% - 18px);padding-top:20px}.route-head{align-items:flex-start;flex-direction:column}.back{width:100%;text-align:center}.app-frame{height:1800px}}</style>