---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="My Profile | FCMobiletools Account"
  description="Your FCMobiletools profile, XP progression, streaks, Quests, Tokens and account activity."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="prof-page">
    <div class="prof-wrap">
      <AccountNav active="profile" sectionLabel="Profile Hub" />

      <div id="profileRoot" class="prof-root">
        <!-- Shimmer skeleton while session & profile load -->
        <div class="prof-skeleton" aria-label="Loading profile">
          <div class="acc-skel skel-hero"></div>
          <div class="skel-kpi-grid">
            <div class="acc-skel skel-kpi"></div>
            <div class="acc-skel skel-kpi"></div>
            <div class="acc-skel skel-kpi"></div>
            <div class="acc-skel skel-kpi"></div>
          </div>
          <div class="acc-skel skel-main"></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import '../../scripts/survey-strip.js';
</script>
<script>
  import {
    accountAuth,
    accountApi,
    setCachedIdentity,
    clearCachedIdentity,
    computeLevelProgress,
    escapeHtml as esc
  } from '../../lib/account-client.js';

  const root = document.getElementById('profileRoot');
  const fmt = (v) => Number(v || 0).toLocaleString();
  const fmtDate = (v) =>
    v
      ? new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(v))
      : '—';
  const fmtDateTime = (v) =>
    v
      ? new Intl.DateTimeFormat(undefined, {
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        }).format(new Date(v))
      : '—';
  const titleCase = (v) =>
    String(v || 'Activity')
      .replaceAll('_', ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

  const rankTitle = (lv) => {
    const n = Number(lv) || 1;
    return n >= 35 ? 'Legend' : n >= 20 ? 'Elite' : n >= 10 ? 'Pro' : n >= 5 ? 'Challenger' : 'Rookie';
  };
  const ICON = {
    bolt: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>',
    coin: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5c0-1 1-1.7 2.5-1.7s2.5.7 2.5 1.7-1 1.5-2.5 1.8-2.5.8-2.5 1.8 1 1.7 2.5 1.7 2.5-.7 2.5-1.7"/></svg>',
    flame: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c4.4 0 7-2.9 7-6.6 0-2.6-1.5-4.4-3-6-.4 1.5-1.2 2.4-2.2 3 .3-3.4-1.2-6.4-4.3-8.9.2 3-1.2 4.5-2.6 6.4C5.6 11.7 5 13.2 5 15.4 5 19.1 7.6 22 12 22Z"/></svg>',
    check: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4M16 2v4M3 10h18M9 15.5l2 2 4-4"/></svg>'
  };
  const avatarRing = (pct) => `
    <svg class="ring" viewBox="0 0 112 112" aria-hidden="true">
      <defs><linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4cc9ff"/><stop offset="1" stop-color="#7ff0c4"/></linearGradient></defs>
      <circle class="ring-track" cx="56" cy="56" r="52"/>
      <circle class="ring-fill" cx="56" cy="56" r="52" pathLength="100" stroke-dasharray="100" stroke-dashoffset="${100 - Math.max(0, Math.min(100, pct))}"/>
    </svg>`;

  function renderGuestState(reasonTitle = 'Your FC Mobile companion identity.', reasonSub = '') {
    root.innerHTML = `
      <section class="guest-card acc-anim">
        <div class="guest-main">
          <span class="sec-kicker"><i class="kicker-dot"></i> FCMOBILETOOLS ACCOUNT</span>
          <h1>${esc(reasonTitle)}</h1>
          <p class="guest-lede">
            ${esc(
              reasonSub ||
                'Track your progression, custom @username, daily check-ins, Quests and community contributions in one personal hub. Every calculator, event timer and redeem code on FCMobiletools works without signing in.'
            )}
          </p>
          <div class="guest-actions">
            <a class="btn-primary" href="/account/">Sign in to Account →</a>
            <a class="btn-secondary" href="/account/?mode=signup">Create Free Account</a>
            <a class="btn-ghost" href="/leaderboard/">View Leaderboard</a>
          </div>
        </div>
        <div class="guest-features">
          <article>
            <span>01 · Identity</span>
            <strong>Custom Profile &amp; Privacy</strong>
            <p>Reserve your @username, display name, avatar and choose exactly which stats are public or private.</p>
          </article>
          <article>
            <span>02 · Progression</span>
            <strong>XP, Streaks &amp; Quest Progress</strong>
            <p>Earn verified XP from Quests, Achievements and approved community contributions.</p>
          </article>
          <article>
            <span>03 · Ecosystem</span>
            <strong>Connected Across Tools</strong>
            <p>Jump straight to Team OVR, Rank Up Calculator, Live Events and Redeem Codes anytime.</p>
          </article>
        </div>
      </section>
    `;
  }

  async function loadPublicFallback(username) {
    const response = await fetch('/api/public/profile/' + encodeURIComponent(username), { cache: 'no-store' });
    const body = await response.json().catch(() => ({}));
    if (!response.ok || !body?.profile) {
      renderGuestState('Profile unavailable', body?.error || 'This public profile does not exist or is set to private.');
      return;
    }
    const p = body.profile;
    const display = p.show_display_name === false ? p.username : p.display_name || p.username;
    const initials = String(display || 'FC').slice(0, 2).toUpperCase();
    const tStats = p.tournament_stats || null;

    root.innerHTML = `
      <section class="hero-card acc-anim">
        <div class="hero-identity">
          <div class="hero-avatar">
            ${p.avatar_url ? `<img src="${esc(p.avatar_url)}" alt="${esc(display)}" />` : `<span>${esc(initials)}</span>`}
            ${p.level != null ? `<b class="avatar-lvl">Lv. ${fmt(p.level)}</b>` : ''}
          </div>
          <div class="hero-copy">
            <div class="hero-badges">
              <span class="pill pill-cyan">Public Profile</span>
              ${p.selected_title ? `<span class="pill pill-amber">${esc(p.selected_title)}</span>` : ''}
            </div>
            <h1>${esc(display)}</h1>
            <p class="hero-handle">
              @${esc(p.username)}
              ${p.joined_at ? ` · Joined ${esc(fmtDate(p.joined_at))}` : ''}
            </p>
          </div>
        </div>
        <div class="hero-actions">
          <a class="btn-primary" href="/account/?mode=signup">Create Your Account</a>
          <a class="btn-secondary" href="/leaderboard/">Leaderboard</a>
        </div>
      </section>

      <section class="kpi-grid acc-anim acc-anim-d1">
        <article class="kpi-card">
          <small>LEVEL</small>
          <strong>${p.level != null ? fmt(p.level) : 'Private'}</strong>
          <span>Account progression</span>
        </article>
        <article class="kpi-card">
          <small>RECORDED XP</small>
          <strong>${p.xp != null ? fmt(p.xp) : 'Private'}</strong>
          <span>Verified experience</span>
        </article>
        <article class="kpi-card">
          <small>ACTIVE STREAK</small>
          <strong>${p.current_streak != null ? `🔥 ${fmt(p.current_streak)}d` : 'Private'}</strong>
          <span>${p.longest_streak != null ? `Best: ${fmt(p.longest_streak)}d` : 'Qualifying streak'}</span>
        </article>
        <article class="kpi-card">
          <small>FC MOBILE</small>
          <strong>${p.in_game_username ? esc(p.in_game_username) : "Player"}</strong>
          <span>${p.region_server ? esc(p.region_server) : "Region private"}</span>
        </article>
      </section>

      <section class="public-game-card acc-anim acc-anim-d2">
        <div><span class="sec-kicker"><i class="kicker-dot"></i> FC MOBILE IDENTITY</span><h2>Player details</h2></div>
        <div class="public-game-grid">
          ${p.in_game_username ? `<div><small>IN-GAME USERNAME</small><strong>${esc(p.in_game_username)}</strong></div>` : ""}
          ${p.fc_mobile_uid ? `<div><small>FC MOBILE UID</small><strong>${esc(p.fc_mobile_uid)}</strong></div>` : ""}
          ${p.region_server ? `<div><small>REGION / SERVER</small><strong>${esc(p.region_server)}</strong></div>` : ""}
          ${p.discord_handle ? `<div><small>DISCORD</small><strong>${esc(p.discord_handle)}</strong></div>` : ""}
          ${Array.isArray(p.player_tags) && p.player_tags.length ? `<div class="public-tags"><small>PLAY STYLE</small><div>${p.player_tags.map(tag=>`<span>${esc(tag)}</span>`).join("")}</div></div>` : ""}
        </div>
      </section>

    `;
  }

  async function loadAuthenticatedProfile() {
    const parts = location.pathname.split('/').filter(Boolean);
    const maybePublicUser = parts[0] === 'profile' && parts[1] && parts[1].toLowerCase() !== 'public'
      ? decodeURIComponent(parts[1]).toLowerCase()
      : '';

    if (maybePublicUser) {
      await loadPublicFallback(maybePublicUser);
      return;
    }

    const sessionResult = await accountAuth.auth.getSession();
    if (!sessionResult.data?.session) {
      clearCachedIdentity();
      renderGuestState();
      return;
    }

    const response = await accountApi('/api/account/me');
    const body = await response.json().catch(() => ({}));
    if (!response.ok || !body?.account) {
      if (response.status === 401) clearCachedIdentity();
      renderGuestState(body?.error || 'Session expired', 'Please sign in again to access your profile hub.');
      return;
    }

    const a = body.account;
    setCachedIdentity(a);

    const activity = Array.isArray(body.activity) ? body.activity : [];
    const lvInfo = computeLevelProgress(a.level, a.xp);
    const display = a.displayName || a.username;
    const initials = String(display || 'FC').slice(0, 2).toUpperCase();
    const isVerified = Boolean(a.emailConfirmedAt);
    let profileQuest = null;
    if (isVerified && !a.gameProfile?.complete) {
      try {
        const qr = await accountApi('/api/account/missions');
        const qb = await qr.json().catch(() => ({}));
        const pool = Array.isArray(qb.quests) ? qb.quests : Array.isArray(qb.missions) ? qb.missions : [];
        profileQuest = pool.find((q) => q.slug === 'complete-profile') || null;
      } catch {}
    }
    const publicUrl = `${location.origin}/profile/${encodeURIComponent(a.username)}/`;

    root.innerHTML = `
      <!-- IDENTITY HERO -->
      <section class="hero-card acc-anim">
        <div class="hero-identity">
          <div class="hero-avatar">
            ${avatarRing(lvInfo.percent)}
            ${a.avatarUrl ? `<img src="${esc(a.avatarUrl)}" alt="${esc(display)}" />` : `<span>${esc(initials)}</span>`}
            <b class="avatar-lvl">LV ${fmt(a.level)}</b>
          </div>

          <div class="hero-copy">
            <div class="hero-badges">
              <span class="pill pill-gold">${esc(rankTitle(a.level))}</span>
              <span class="pill pill-cyan">FCMobiletools Account</span>
              <span class="pill ${a.state === 'active' ? 'pill-green' : 'pill-amber'}">${esc(titleCase(a.state || 'active'))}</span>
              <span class="pill ${isVerified ? 'pill-green' : 'pill-amber'}">
                ${isVerified ? '✓ Email Verified' : 'Email Unverified'}
              </span>
            </div>
            <h1>${esc(display)}</h1>
            <p class="hero-handle">
              <strong>@${esc(a.username)}</strong>
              <span>·</span>
              <span>Joined ${esc(fmtDate(a.createdAt))}</span>
              ${a.email ? `<span>·</span><span>${esc(a.email)}</span>` : ''}
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <a class="btn-secondary" href="/settings/">Edit Profile &amp; Privacy</a>
          <a class="btn-secondary" href="/profile/${encodeURIComponent(a.username)}/">Public View ↗</a>
          <button class="btn-secondary" type="button" id="copyProfileUrlBtn" data-url="${esc(publicUrl)}">Copy Link</button>
          <button class="btn-danger-ghost" type="button" id="logoutBtn">Sign out</button>
        </div>

        <!-- Level & XP Bar -->
        <div class="xp-strip">
          <div class="xp-strip-head">
            <div>
              <strong>Level ${fmt(lvInfo.level)} Progression</strong>
              <span>XP balance · Next milestone in sight</span>
            </div>
            <div class="xp-strip-numbers">
              <b>${fmt(a.xp)} XP</b>
              <span>🔥 ${fmt(a.currentStreak)}d Streak (Best ${fmt(a.longestStreak)}d)</span>
            </div>
          </div>
          <div class="xp-bar-track" role="progressbar" aria-valuenow="${lvInfo.percent}" aria-valuemin="0" aria-valuemax="100">
            <span class="xp-bar-fill" style="width:${lvInfo.percent}%"></span>
          </div>
          <div class="xp-strip-foot">
            <span>Level <b>${fmt(lvInfo.level)}</b></span>
            <span><b>${lvInfo.percent}%</b> to Level <b>${fmt(lvInfo.level + 1)}</b></span>
          </div>
        </div>
      </section>

      ${profileQuest && !a.gameProfile?.complete ? `
        <section class="profile-quest-card acc-anim acc-anim-d1" id="profileQuestCard">
          <div class="profile-quest-head">
            <div class="profile-quest-badge"><span>01</span><small>ONE-TIME QUEST</small></div>
            <div class="profile-quest-copy">
              <span class="sec-kicker"><i class="kicker-dot"></i> COMPLETE YOUR PLAYER CARD</span>
              <h2>Finish your FC Mobile profile</h2>
              <p>Add your UID, in-game name and Region / Server. Discord and your play style are optional.</p>
            </div>
            <div class="profile-quest-rewards"><strong>+100 XP</strong><span>+15 Tokens</span></div>
          </div>
          <form id="profileQuestForm" class="profile-quest-form">
            <div class="profile-quest-fields">
              <label><span>FC Mobile UID</span><input name="fcMobileUid" required maxlength="32" value="${esc(a.gameProfile?.fcMobileUid || '')}" placeholder="Your FC Mobile UID" /></label>
              <label><span>In-game username</span><input name="inGameUsername" required maxlength="40" value="${esc(a.gameProfile?.inGameUsername || '')}" placeholder="Your in-game name" /></label>
              <label><span>Region / Server</span><input name="regionServer" required maxlength="40" value="${esc(a.gameProfile?.regionServer || '')}" placeholder="e.g. Asia, Europe, NA" /></label>
              <label><span>Discord <small>optional</small></span><input name="discordHandle" maxlength="64" value="${esc(a.gameProfile?.discordHandle || '')}" placeholder="Discord handle" /></label>
            </div>
            <div class="profile-quest-tags">
              <span>How do you play?</span>
              <div>
                ${['Competitive H2H','VSA Grinder','Investor','Theme Team Builder','Casual'].map((tag) => `
                  <label><input type="checkbox" value="${esc(tag)}" ${a.gameProfile?.playerTags?.includes(tag) ? 'checked' : ''} /><span>${esc(tag)}</span></label>
                `).join('')}
              </div>
            </div>
            <div class="profile-quest-foot">
              <span id="profileQuestMsg">Required: UID, in-game username and Region / Server.</span>
              <button class="btn-primary profile-quest-submit" type="submit">Save &amp; Finish Quest →</button>
            </div>
          </form>
        </section>
      ` : ''}
      <section class="public-game-card auth-game-card acc-anim acc-anim-d1">
        <div><span class="sec-kicker"><i class="kicker-dot"></i> FC MOBILE IDENTITY</span><h2>Your Player Card</h2><p>Keep the details you use in FC Mobile connected to this account.</p></div>
        <div class="public-game-grid">
          <div><small>IN-GAME USERNAME</small><strong>${esc(a.gameProfile?.inGameUsername || "Not added")}</strong></div>
          <div><small>FC MOBILE UID</small><strong>${esc(a.gameProfile?.fcMobileUid || "Not added")}</strong></div>
          <div><small>REGION / SERVER</small><strong>${esc(a.gameProfile?.regionServer || "Not added")}</strong></div>
          <div><small>DISCORD</small><strong>${esc(a.gameProfile?.discordHandle || "Optional")}</strong></div>
          ${Array.isArray(a.gameProfile?.playerTags) && a.gameProfile.playerTags.length ? `<div class="public-tags"><small>PLAY STYLE</small><div>${a.gameProfile.playerTags.map(tag=>`<span>${esc(tag)}</span>`).join("")}</div></div>` : ""}
        </div>
      </section>
      ${!isVerified ? `
        <aside class="verify-banner acc-anim acc-anim-d1">
          <div>
            <strong>Verify your email address to unlock account-only features</strong>
            <p>Check your inbox (${esc(a.email || 'your email')}) for the confirmation link so you can use Quests, Achievements, community submissions and reward redemptions.</p>
          </div>
          <a class="btn-secondary" href="/settings/">Account Settings →</a>
        </aside>
      ` : ''}

      <!-- 4-CARD KPI GRID -->
      <section class="kpi-grid acc-anim acc-anim-d1" aria-label="Account statistics">
        <article class="kpi-card kpi-card--xp">
          <div class="kpi-top"><span class="kpi-badge">Level ${fmt(a.level)}</span></div>
          <span class="kpi-ico">${ICON.bolt}</span>
          <span class="kpi-label">Progression</span>
          <strong><span data-count="${Number(a.xp || 0)}">${fmt(a.xp)}</span> <small>XP</small></strong>
          <p>Verified XP from your account activity.</p>
          <button type="button" class="kpi-link" data-jump-tab="xp">View XP history →</button>
        </article>

        <article class="kpi-card kpi-card--tokens">
          <div class="kpi-top"><span class="kpi-badge kpi-badge--mint">Tokens</span></div>
          <span class="kpi-ico">${ICON.coin}</span>
          <span class="kpi-label">Reward currency</span>
          <strong><span data-count="${Number(a.tokens || 0)}">${fmt(a.tokens)}</span> <small>TKN</small></strong>
          <p>Earned ${fmt(a.lifetimeEarnedTokens)} · Spent ${fmt(a.lifetimeSpentTokens)}</p>
          <button type="button" class="kpi-link" data-jump-tab="tokens">View Token history →</button>
        </article>

        <article class="kpi-card kpi-card--streak">
          <div class="kpi-top"><span class="kpi-badge kpi-badge--amber">Best ${fmt(a.longestStreak)}d</span></div>
          <span class="kpi-ico">${ICON.flame}</span>
          <span class="kpi-label">Activity streak</span>
          <strong>${fmt(a.currentStreak)} <small>DAYS</small></strong>
          <p>${a.lastQualifyingActivityAt ? `Last active ${esc(fmtDate(a.lastQualifyingActivityAt))}` : 'Updated on qualifying actions.'}</p>
          <a class="kpi-link" href="/missions/">Open Quests →</a>
        </article>

        <article class="kpi-card kpi-card--checkin">
          <div class="kpi-top"><span class="kpi-badge">UTC</span></div>
          <span class="kpi-ico">${ICON.check}</span>
          <span class="kpi-label">Daily check-in</span>
          <strong>Every <small>24 HOURS</small></strong>
          <p>Check in once every 24 hours to keep your streak alive.</p>
          <a class="kpi-link" href="/missions/">Check in →</a>
        </article>
      </section>

      <div class="dash-section-head acc-anim acc-anim-d2">
        <div>
          <span class="sec-kicker"><i class="kicker-dot"></i> ACCOUNT WORKSPACE</span>
          <h2>Progress &amp; activity</h2>
          <p>Keep an eye on your verified progression, token history and community activity from one place.</p>
        </div>
        <a class="btn-primary" href="/missions/">Open Quests →</a>
      </div>

      <div id="surveyStrip"></div>

      <!-- MAIN WORKSPACE GRID -->
      <section class="workspace-grid acc-anim acc-anim-d3">
        <!-- Left: Tabbed Activity, XP History, Token History & Community Submission -->
        <div class="ledger-panel">
          <div class="ledger-tabs" role="tablist" aria-label="Account history and contributions">
            <button type="button" class="ledger-tab active" data-tab="activity" role="tab" aria-selected="true">
              Recent Activity
            </button>
            <button type="button" class="ledger-tab" data-tab="xp" role="tab" aria-selected="false">
              XP History
            </button>
            <button type="button" class="ledger-tab" data-tab="tokens" role="tab" aria-selected="false">
              Token History
            </button>
            <button type="button" class="ledger-tab" data-tab="contribute" role="tab" aria-selected="false">
              Submit Correction
            </button>
          </div>

          <!-- TAB 1: RECENT ACTIVITY -->
          <div class="ledger-view" id="tab-activity">
            <div class="view-head">
              <div>
                <h2>Account Activity</h2>
                <p>Meaningful account events recorded server-side.</p>
              </div>
            </div>
            ${
              activity.length
                ? `<div class="feed-list">
                    ${activity
                      .map(
                        (item) => `
                      <div class="feed-row">
                        <span class="feed-ico" data-kind="${item.event_type?.includes('xp') ? 'xp' : item.event_type?.includes('token') ? 'token' : 'star'}">${item.event_type?.includes('xp') ? 'XP' : item.event_type?.includes('token') ? 'TK' : '★'}</span>
                        <div class="feed-main">
                          <strong>${esc(titleCase(item.event_type))}</strong>
                          <small>${esc(item.entity_type ? titleCase(item.entity_type) : 'Verified account event')}</small>
                        </div>
                        <time class="feed-time">${esc(fmtDateTime(item.created_at))}</time>
                      </div>
                    `
                      )
                      .join('')}
                  </div>`
                : `<div class="empty-state">
                    <strong>No activity events recorded yet</strong>
                    <p>Meaningful actions, such as completing Quests, unlocking Achievements or getting a correction approved, appear here automatically.</p>
                  </div>`
            }
          </div>

          <!-- TAB 2: XP LEDGER -->
          <div class="ledger-view" id="tab-xp" hidden>
            <div class="view-head">
              <div>
                <h2>XP Transaction History</h2>
                <p>See where your XP came from and when it changed.</p>
              </div>
            </div>
            <div id="xpLedgerList" class="feed-list">
              <div class="empty-state">Loading XP history…</div>
            </div>
          </div>

          <!-- TAB 3: TOKEN HISTORY -->
          <div class="ledger-view" id="tab-tokens" hidden>
            <div class="view-head">
              <div>
                <h2>Token History</h2>
                <p>See where your Tokens came from and what you spent.</p>
              </div>
            </div>
            <div id="tokenLedgerList" class="feed-list">
              <div class="empty-state">Loading Token history…</div>
            </div>
          </div>

          <!-- TAB 4: COMMUNITY CONTRIBUTION -->
          <div class="ledger-view" id="tab-contribute" hidden>
            <div class="view-head">
              <div>
                <h2>Submit a Correction or Report</h2>
                <p>Help keep FCMobiletools accurate. Submissions enter moderation review (submitted → pending review → approved/rejected) before any XP or token reward is granted.</p>
              </div>
            </div>
            <form id="contributionForm" class="contrib-form">
              <div class="contrib-row">
                <label>
                  <span>Contribution type</span>
                  <select name="submissionType" required>
                    <option value="correction">Data / Calculator Correction</option>
                    <option value="event_info">Event / Reset Timing Update</option>
