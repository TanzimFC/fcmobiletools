                <div>
                  <strong>Reward Catalogue</strong>
                  <small>Optional titles, badges &amp; perks</small>
                </div>
                <span>→</span>
              </a>
              <a href="/settings/">
                <div>
                  <strong>Privacy &amp; Settings</strong>
                  <small>Control public visibility</small>
                </div>
                <span>→</span>
              </a>
            </div>
          </section>

          <section class="side-card side-card--privacy">
            <span class="sec-kicker">PRIVACY BOUNDARY</span>
            <h3>Protected by Design</h3>
            <p>
              Email, authentication details, internal IDs and reward delivery data stay private. Public profiles only expose the fields you choose to show.
            </p>
            <a class="privacy-link" href="/settings/">Manage public profile fields →</a>
          </section>
        </aside>
      </section>
