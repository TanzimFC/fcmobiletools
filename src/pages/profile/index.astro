    const profileQuestForm = document.getElementById('profileQuestForm');
    profileQuestForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const button = form.querySelector('button[type="submit"]');
      const msg = document.getElementById('profileQuestMsg');
      const values = Object.fromEntries(new FormData(form).entries());
      const fcMobileUid = String(values.fcMobileUid || '').trim();
      const inGameUsername = String(values.inGameUsername || '').trim();
      const regionServer = String(values.regionServer || '').trim();
      const discordHandle = String(values.discordHandle || '').trim();
      const playerTags = [...form.querySelectorAll('.profile-quest-tags input:checked')].map((input) => input.value);

      if (fcMobileUid.length < 3 || fcMobileUid.length > 32 || !inGameUsername || inGameUsername.length > 40 || !regionServer || regionServer.length > 40) {
        msg.textContent = 'UID, in-game username and Region / Server are required.';
        msg.className = 'profile-quest-msg is-error';
        return;
      }

      button.disabled = true;
      const previous = button.textContent;
      button.textContent = 'Saving profile…';
      msg.textContent = '';

      try {
        const save = await accountApi('/api/account/game-profile', {
          method: 'PUT',
          body: JSON.stringify({ fcMobileUid, inGameUsername, regionServer, discordHandle, playerTags })
        });
        const saveBody = await save.json().catch(() => ({}));
        if (!save.ok) throw new Error(saveBody.error || 'Could not save your FC Mobile profile.');

        button.textContent = saveBody.questCompleted ? 'Quest complete ✓' : 'Profile saved ✓';
        msg.textContent = saveBody.questCompleted
          ? 'Player profile saved. Your Quest reward is on your balance.'
          : 'Player profile saved. Your Quest status will update automatically.';
        msg.className = 'profile-quest-msg is-ok';
        setTimeout(() => loadAuthenticatedProfile(), 650);
      } catch (error) {
        button.disabled = false;
        button.textContent = previous;
        msg.textContent = error?.message || 'Could not finish the profile Quest.';
        msg.className = 'profile-quest-msg is-error';
      }
    });

    // Bind Copy Public Profile Link
    const copyBtn = document.getElementById('copyProfileUrlBtn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.url || publicUrl);
        const prev = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        setTimeout(() => (copyBtn.textContent = prev), 1800);
      } catch {}
    });

    // Bind Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await accountAuth.auth.signOut();
      clearCachedIdentity();
      location.replace('/');
    });

    // Lazy-loaded XP & Token ledgers
    let xpLoaded = false;
    let tokensLoaded = false;

    async function loadXpLedger() {
      if (xpLoaded) return;
      const box = document.getElementById('xpLedgerList');
      if (!box) return;
      try {
        const r = await accountApi('/api/account/xp?limit=25');
        const b = await r.json().catch(() => ({}));
        const items = Array.isArray(b.items) ? b.items : [];
        xpLoaded = true;
        box.innerHTML = items.length
          ? items
              .map((tx) => {
                const amt = Number(tx.amount || 0);
                const sign = amt > 0 ? '+' : '';
                return `
                  <div class="feed-row">
                    <span class="feed-ico ${amt >= 0 ? 'is-pos' : 'is-neg'}">${sign}${fmt(amt)}</span>
                    <div class="feed-main">
                      <strong>${esc(tx.reason || titleCase(tx.source_type || 'XP Transaction'))}</strong>
                      <small>Source: ${esc(titleCase(tx.source_type || 'system'))}</small>
                    </div>
                    <time class="feed-time">${esc(fmtDateTime(tx.created_at))}</time>
                  </div>
                `;
              })
              .join('')
          : `<div class="empty-state">
              <strong>No XP transactions yet</strong>
              <p>Every XP addition or deduction will be recorded here with its timestamp and reason.</p>
            </div>`;
      } catch {
        box.innerHTML = '<div class="empty-state">Unable to load XP ledger right now.</div>';
      }
    }

    async function loadTokenLedger() {
      if (tokensLoaded) return;
      const box = document.getElementById('tokenLedgerList');
      if (!box) return;
      try {
        const r = await accountApi('/api/account/tokens?limit=25');
        const b = await r.json().catch(() => ({}));
        const items = Array.isArray(b.items) ? b.items : [];
        tokensLoaded = true;
        box.innerHTML = items.length
          ? items
              .map((tx) => {
                const amt = Number(tx.amount || 0);
                const sign = amt > 0 ? '+' : '';
                return `
                  <div class="feed-row">
                    <span class="feed-ico ${amt >= 0 ? 'is-pos' : 'is-neg'}">${sign}${fmt(amt)}</span>
                    <div class="feed-main">
                      <strong>${esc(tx.memo || titleCase(tx.entry_type || 'Token Entry'))}</strong>
                      <small>${esc(titleCase(tx.entry_type || 'ledger'))}${tx.expires_at ? ` · Expires ${esc(fmtDate(tx.expires_at))}` : ''}</small>
                    </div>
                    <time class="feed-time">${esc(fmtDateTime(tx.created_at))}</time>
                  </div>
                `;
              })
              .join('')
          : `<div class="empty-state">
              <strong>No token transactions yet</strong>
              <p>Token earnings, redemptions and adjustments are tracked here. Tokens have no fixed cash value.</p>
            </div>`;
      } catch {
        box.innerHTML = '<div class="empty-state">Unable to load token ledger right now.</div>';
      }
    }

    function activateTab(tabName) {
      document.querySelectorAll('.ledger-tab').forEach((btn) => {
        const active = btn.dataset.tab === tabName;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      ['activity', 'xp', 'tokens', 'contribute'].forEach((id) => {
        const view = document.getElementById('tab-' + id);
        if (view) view.hidden = id !== tabName;
      });
      if (tabName === 'xp') loadXpLedger();
      if (tabName === 'tokens') loadTokenLedger();
    }

    document.querySelectorAll('.ledger-tab').forEach((btn) => {
      btn.addEventListener('click', () => activateTab(btn.dataset.tab));
    });
    document.querySelectorAll('[data-jump-tab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activateTab(btn.dataset.jumpTab);
        document.querySelector('.ledger-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    if (location.hash === '#xp') activateTab('xp');
    else if (location.hash === '#tokens') activateTab('tokens');
    else if (location.hash === '#contribute') activateTab('contribute');

    // Bind Community Contribution Form
    const contribForm = document.getElementById('contributionForm');
    contribForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('contribMsg');
      const btn = contribForm.querySelector('button[type="submit"]');
      if (msg) {
        msg.textContent = '';
        msg.className = 'contrib-msg';
      }
      if (btn) btn.disabled = true;
      try {
        const fd = new FormData(contribForm);
        const res = await accountApi('/api/account/community-submissions', {
          method: 'POST',
          body: JSON.stringify({
            submissionType: fd.get('submissionType'),
            pageUrl: fd.get('pageUrl'),
            title: fd.get('title'),
            body: fd.get('body')
          })
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || 'Could not submit contribution.');
        if (msg) {
          msg.textContent = 'Submitted for admin review! Approved contributions earn verified progression.';
          msg.className = 'contrib-msg is-ok';
        }
        contribForm.reset();
      } catch (err) {
        if (msg) {
          msg.textContent = err.message || 'Submission failed.';
          msg.className = 'contrib-msg is-err';
        }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }

  loadAuthenticatedProfile().catch(() =>
    renderGuestState('Unable to load profile right now', 'Please refresh the page or check your connection.')
  );
</script>

