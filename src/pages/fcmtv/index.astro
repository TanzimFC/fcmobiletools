---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FCMTV_CONTENT } from '../../data/fcmtv.js';

const publishedVideos = FCMTV_CONTENT.videos
  .filter((video) => video.published)
  .sort((a, b) => Number(a.sortOrder || 0) - Number(b.sortOrder || 0));
const featuredVideo = publishedVideos.find((video) => video.featured) ?? publishedVideos[0];
const initialVideoId = featuredVideo?.youtubeId || 'eQYKSr71LsM';
const thumbnail = (id) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const safeInitialJson = JSON.stringify(publishedVideos).replace(/</g, '\\u003c');
---
<BaseLayout
  title="FCM TV | FC Mobile Tutorials & Gameplay Guides"
  description="Watch FC Mobile gameplay tutorials, captain picks, squad tips and game guides from TanzimFC on FCM TV."
  section="FCM TV"
>
  <main class="fcmtv-page">
    <div class="fcmtv-ambient" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="fcmtv-wrap">
      <section class="ftv-hero">
        <div class="ftv-hero-copy">
          <div class="ftv-kicker"><span class="ftv-live-dot"></span> FCMOBILETOOLS ORIGINALS</div>
          <h1>FCM <span>TV</span></h1>
          <p class="ftv-hero-lede">FC Mobile tutorials, captain picks and gameplay guides from TanzimFC.</p>
          <div class="ftv-hero-tags">
            <span><b>01</b> Captain picks</span>
            <span><b>02</b> Gameplay guides</span>
            <span><b>03</b> Updates &amp; tips</span>
          </div>
          <a class="ftv-channel-link" href="https://www.youtube.com/@tanzimfc" target="_blank" rel="noopener noreferrer">
            More from TanzimFC <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="ftv-hero-visual" aria-hidden="true">
          <div class="ftv-orbit ftv-orbit-one"></div>
          <div class="ftv-orbit ftv-orbit-two"></div>
          <div class="ftv-pitch-lines"></div>
          <div class="ftv-screen-art">
            <div class="ftv-screen-top"><span></span><span></span><span></span><small>FCM / TV</small></div>
            <div class="ftv-screen-play"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></div>
            <div class="ftv-screen-foot"><span>GAMEPLAY</span><b>ON AIR</b></div>
          </div>
          <div class="ftv-float-chip ftv-float-chip-top"><span>FC</span><b>GAME KNOWLEDGE</b></div>
          <div class="ftv-float-chip ftv-float-chip-bottom"><i></i><span>New guides</span></div>
        </div>
      </section>

      <section class="ftv-watch-layout" aria-label="Featured video">
        <article class="ftv-player-card">
          <div class="ftv-player-heading">
            <div class="ftv-player-eyebrow"><span class="ftv-equalizer"><i></i><i></i><i></i><i></i></span> NOW PLAYING</div>
            <span id="ftvPlayerStatus" class="ftv-player-status">Ready to play</span>
          </div>
          <div class="ftv-player-stage" id="ftvPlayerStage">
            <iframe
              id="ytPlayer"
              data-video-id={initialVideoId}
              src={`https://www.youtube.com/embed/${initialVideoId}?enablejsapi=1&origin=${Astro.url.origin}&controls=1&rel=0&playsinline=1`}
              title={featuredVideo?.title || 'FC Mobile video on FCM TV'}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <div class="ftv-player-info">
            <div class="ftv-selected-meta"><span id="ftvSelectedCategory">{featuredVideo?.category || 'FC Mobile'}</span><span class="ftv-meta-separator">/</span><span>FCM TV</span></div>
            <h2 id="ftvSelectedTitle">{featuredVideo?.title || 'FC Mobile guides'}</h2>
            <p id="ftvSelectedDescription">{featuredVideo?.description || 'Explore the latest FC Mobile guides and gameplay.'}</p>
            <div class="ftv-player-actions">
              <a id="ftvOpenYoutube" href={`https://www.youtube.com/watch?v=${initialVideoId}`} target="_blank" rel="noopener noreferrer">Open on YouTube <span aria-hidden="true">↗</span></a>
              <span class="ftv-player-hint">Choose a video to play next</span>
            </div>
          </div>
          <p id="ftvPlayerNotice" class="ftv-player-notice" role="status" hidden></p>
        </article>

        <aside class="ftv-side-panel">
          <div class="ftv-side-art"><div class="ftv-side-ring"></div><span class="ftv-side-mark">FC<span>TV</span></span></div>
          <span class="ftv-side-label">YOUR FC MOBILE WATCHLIST</span>
          <h2>Pick up a new trick.</h2>
          <p>Catch a captain breakdown, learn a better routine or get the context behind the latest in-game updates.</p>
          <div class="ftv-side-divider"></div>
          <div class="ftv-side-stat"><span>Videos in the library</span><strong id="ftvVideoCount">{publishedVideos.length}</strong></div>
          <a class="ftv-side-cta" href="#ftv-library">Browse the library <span aria-hidden="true">↓</span></a>
        </aside>
      </section>

      <section class="ftv-library" id="ftv-library">
        <div class="ftv-library-heading">
          <div>
            <div class="ftv-section-kicker"><span></span> THE LIBRARY</div>
            <h2>Find your next guide.</h2>
            <p>Choose a topic or search the collection.</p>
          </div>
          <label class="ftv-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
            <input id="ftvSearch" type="search" placeholder="Search videos..." autocomplete="off" aria-label="Search FCM TV videos" />
            <kbd>/</kbd>
          </label>
        </div>
        <div id="ftvCategories" class="ftv-categories" role="group" aria-label="Filter videos">
          <button class="ftv-filter is-active" type="button" data-category="all">All videos</button>
          {Array.from(new Set(publishedVideos.map((video) => video.category))).map((category) => (
            <button class="ftv-filter" type="button" data-category={category}>{category}</button>
          ))}
        </div>
        <div class="ftv-results-row"><span id="ftvResultsLabel">{publishedVideos.length} videos</span><span>Curated by TanzimFC</span></div>
        <div class="ftv-video-grid" id="ftvVideoGrid">
          {publishedVideos.map((video) => (
            <button type="button" class="ftv-video-card" data-play-video={video.id} aria-label={`Play ${video.title}`}>
              <span class="ftv-card-thumb">
                <img src={thumbnail(video.youtubeId)} alt="" loading="lazy" decoding="async" />
                <span class="ftv-card-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></span>
                {video.featured ? <span class="ftv-featured-label">FEATURED</span> : null}
              </span>
              <span class="ftv-card-copy">
                <span class="ftv-card-category">{video.category}</span>
                <strong>{video.title}</strong>
                <span class="ftv-card-description">{video.description}</span>
                <span class="ftv-card-footer"><span>Play video</span><span aria-hidden="true">↗</span></span>
              </span>
            </button>
          ))}
        </div>
        <div id="ftvEmptyState" class="ftv-empty-state" hidden>
          <span class="ftv-empty-icon">FC</span>
          <h3>No videos found</h3>
          <p>Try another search or choose a different topic.</p>
          <button type="button" id="ftvClearFilters">Clear filters</button>
        </div>
      </section>
      <div class="ftv-bottom-note"><span class="ftv-bottom-icon">▶</span><p>Videos play through YouTube. Playback and availability may vary by video or device.</p></div>
    </div>

    <div class="ftv-quiz-modal" id="ftvQuizModal" hidden aria-hidden="true">
      <button class="ftv-quiz-backdrop" type="button" data-quiz-close aria-label="Close quick question"></button>
      <section class="ftv-quiz-dialog" role="dialog" aria-modal="true" aria-labelledby="ftvQuizTitle">
        <button type="button" class="ftv-quiz-close" data-quiz-close aria-label="Close">×</button>
        <div class="ftv-quiz-kicker"><span>FCM TV</span><span class="ftv-quiz-clock">Closing in <b id="ftvQuizTimer">15</b>s</span></div>
        <div class="ftv-quiz-symbol" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"></path><path d="m8 12 2.5 2.5L16.5 9"></path></svg></div>
        <h2 id="ftvQuizTitle">Quick question</h2>
        <p id="ftvQuizQuestion" class="ftv-quiz-question"></p>
        <div id="ftvQuizOptions" class="ftv-quiz-options"></div>
        <p id="ftvQuizFeedback" class="ftv-quiz-feedback" aria-live="polite"></p>
        <button type="button" class="ftv-quiz-skip" data-quiz-close>Maybe later</button>
      </section>
    </div>
    <script type="application/json" id="fcmtvData" set:html={safeInitialJson}></script>
  </main>
</BaseLayout>

<script>
  const jsonSeed = document.getElementById('fcmtvData');
  let videos = [];
  try { videos = JSON.parse(jsonSeed?.textContent || '[]'); } catch { videos = []; }
  let selectedId = videos.find((video) => video.featured)?.id || videos[0]?.id || '';
  let player = null;
  let playerReady = false;
  let currentYoutubeId = document.getElementById('ytPlayer')?.dataset.videoId || '';
  let pendingYoutubeId = '';
  let pendingPlay = false;
  let activeCategory = 'all';
  let quizInterval = 0;
  let quizSeconds = 15;
  let tabSwitchCount = 0;
  let wasPlayingBeforeHide = false;
  let apiInitializationAttempted = false;

  const $ = (selector) => document.querySelector(selector);
  const htmlEscape = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[char]);
  const selectedVideo = () => videos.find((video) => video.id === selectedId) || videos[0] || null;
  const youtubeIdFrom = (value) => {
    const raw = String(value || '').trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(raw)) return raw;
    try {
      const url = new URL(raw);
      if (url.hostname === 'youtu.be') return url.pathname.split('/').filter(Boolean)[0] || '';
      if (/(^|\.)youtube(?:-nocookie)?\.com$/i.test(url.hostname)) {
        if (url.pathname === '/watch') return url.searchParams.get('v') || '';
        const pieces = url.pathname.split('/').filter(Boolean);
        if (['embed', 'shorts', 'live'].includes(pieces[0])) return pieces[1] || '';
      }
    } catch {}
    return '';
  };
  const watchUrl = (video) => 'https://www.youtube.com/watch?v=' + encodeURIComponent(video.youtubeId);
  const embedUrl = (id) => 'https://www.youtube.com/embed/' + encodeURIComponent(id) + '?enablejsapi=1&origin=' + encodeURIComponent(location.origin) + '&controls=1&rel=0&playsinline=1';

  function showNotice(message) {
    const notice = $('#ftvPlayerNotice');
    if (!notice) return;
    notice.textContent = message;
    notice.hidden = false;
    notice.classList.remove('ftv-notice-in');
    void notice.offsetWidth;
    notice.classList.add('ftv-notice-in');
  }

  function updateSelectedDetails(video) {
    if (!video) return;
    $('#ftvSelectedCategory').textContent = video.category || 'FC Mobile';
    $('#ftvSelectedTitle').textContent = video.title;
    $('#ftvSelectedDescription').textContent = video.description || '';
    $('#ftvOpenYoutube').href = watchUrl(video);
    const frame = $('#ytPlayer');
    if (frame) frame.title = video.title;
    document.querySelectorAll('[data-play-video]').forEach((button) => {
      button.classList.toggle('is-selected', button.dataset.playVideo === video.id);
    });
  }

  function cardMarkup(video) {
    return `<button type="button" class="ftv-video-card${video.id === selectedId ? ' is-selected' : ''}" data-play-video="${htmlEscape(video.id)}" aria-label="Play ${htmlEscape(video.title)}">
      <span class="ftv-card-thumb"><img src="https://i.ytimg.com/vi/${encodeURIComponent(video.youtubeId)}/hqdefault.jpg" alt="" loading="lazy" decoding="async"><span class="ftv-card-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg></span>${video.featured ? '<span class="ftv-featured-label">FEATURED</span>' : ''}</span>
      <span class="ftv-card-copy"><span class="ftv-card-category">${htmlEscape(video.category || 'FC Mobile')}</span><strong>${htmlEscape(video.title)}</strong><span class="ftv-card-description">${htmlEscape(video.description || '')}</span><span class="ftv-card-footer"><span>Play video</span><span aria-hidden="true">↗</span></span></span>
    </button>`;
  }

  function renderCategories() {
    const root = $('#ftvCategories');
    const categories = ['all', ...new Set(videos.map((video) => String(video.category || 'FC Mobile').trim()).filter(Boolean))];
    root.innerHTML = categories.map((category) => {
      const label = category === 'all' ? 'All videos' : category;
      return `<button class="ftv-filter${activeCategory === category ? ' is-active' : ''}" type="button" data-category="${htmlEscape(category)}">${htmlEscape(label)}</button>`;
    }).join('');
  }

  function renderVideoGrid() {
    const root = $('#ftvVideoGrid');
    const term = String($('#ftvSearch')?.value || '').trim().toLowerCase();
    const list = videos.filter((video) => {
      const matchesCategory = activeCategory === 'all' || video.category === activeCategory;
      const haystack = [video.title, video.description, video.category].join(' ').toLowerCase();
      return matchesCategory && (!term || haystack.includes(term));
    });
    root.innerHTML = list.map(cardMarkup).join('');
    $('#ftvResultsLabel').textContent = list.length + (list.length === 1 ? ' video' : ' videos');
    $('#ftvVideoCount').textContent = String(videos.length);
    $('#ftvEmptyState').hidden = list.length > 0;
    updateSelectedDetails(selectedVideo());
  }

  function closeQuiz() {
    const modal = $('#ftvQuizModal');
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    if (quizInterval) window.clearInterval(quizInterval);
    quizInterval = 0;
  }

  function showQuiz(video) {
    closeQuiz();
    const quiz = video?.quiz;
    if (!quiz?.question || !Array.isArray(quiz.choices) || quiz.choices.length < 2) return;
    quizSeconds = 15;
    $('#ftvQuizTimer').textContent = String(quizSeconds);
    $('#ftvQuizQuestion').textContent = quiz.question;
    $('#ftvQuizFeedback').textContent = '';
    $('#ftvQuizOptions').innerHTML = quiz.choices.map((choice, index) =>
      `<button type="button" class="ftv-quiz-option" data-quiz-answer="${index}">${htmlEscape(choice)}</button>`
    ).join('');
    const modal = $('#ftvQuizModal');
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    quizInterval = window.setInterval(() => {
      quizSeconds -= 1;
      $('#ftvQuizTimer').textContent = String(Math.max(0, quizSeconds));
      if (quizSeconds <= 0) closeQuiz();
    }, 1000);
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    const playButton = target.closest('[data-play-video]');
    if (playButton) {
      const video = videos.find((item) => item.id === playButton.dataset.playVideo);
      if (video) playVideo(video);
      return;
    }
    const categoryButton = target.closest('[data-category]');
    if (categoryButton && categoryButton.closest('#ftvCategories')) {
      activeCategory = categoryButton.dataset.category || 'all';
      renderCategories();
      renderVideoGrid();
      return;
    }
    if (target.closest('[data-quiz-close]')) {
      closeQuiz();
      return;
    }
    const answerButton = target.closest('[data-quiz-answer]');
    if (answerButton) {
      const video = selectedVideo();
      const correct = Number(answerButton.dataset.quizAnswer) === Number(video?.quiz?.answerIndex);
      $('#ftvQuizOptions').querySelectorAll('button').forEach((button) => {
        button.disabled = true;
        const answer = Number(button.dataset.quizAnswer);
        if (answer === Number(video?.quiz?.answerIndex)) button.classList.add('is-correct');
        else if (button === answerButton && !correct) button.classList.add('is-wrong');
      });
      $('#ftvQuizFeedback').textContent = correct ? 'That’s right. Nice work.' : 'Not quite. The highlighted answer is correct.';
      return;
    }
    if (target.closest('#ftvClearFilters')) {
      activeCategory = 'all';
      $('#ftvSearch').value = '';
      renderCategories();
      renderVideoGrid();
    }
  });

  function playVideo(video) {
    if (!video?.youtubeId) return;
    closeQuiz();
    const stage = $('#ftvPlayerStage');
    if (stage) {
      const smoothScroll = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      stage.scrollIntoView({behavior: smoothScroll ? 'smooth' : 'auto', block: 'center'});
    }
    const changed = selectedId !== video.id;
    selectedId = video.id;
    updateSelectedDetails(video);
    $('#ftvPlayerStatus').textContent = 'Ready to play';
    if (playerReady && player) {
      if (changed || currentYoutubeId !== video.youtubeId) {
        currentYoutubeId = video.youtubeId;
        player.loadVideoById({ videoId: video.youtubeId });
      } else {
        player.playVideo();
      }
    } else {
      pendingYoutubeId = video.youtubeId;
      pendingPlay = true;
      const frame = $('#ytPlayer');
      if (frame) frame.src = embedUrl(video.youtubeId);
    }
  }

  function initYouTubePlayer() {
    if (apiInitializationAttempted || !window.YT?.Player) return;
    apiInitializationAttempted = true;
    const startVideo = selectedVideo();
    const frame = $('#ytPlayer');
    if (!frame || !startVideo) return;
    currentYoutubeId = startVideo.youtubeId;
    player = new window.YT.Player('ytPlayer', {
      videoId: startVideo.youtubeId,
      playerVars: {
        autoplay: 0,
        controls: 1,
        rel: 0,
        playsinline: 1,
        enablejsapi: 1,
        origin: location.origin
      },
      events: {
        onReady: (event) => {
          player = event.target;
          playerReady = true;
          try { player.setPlaybackRate(1); } catch {}
          const pending = pendingYoutubeId;
          const shouldPlay = pendingPlay && !document.hidden;
          pendingYoutubeId = '';
          pendingPlay = false;
          if (pending && pending !== currentYoutubeId) {
            currentYoutubeId = pending;
            if (shouldPlay) player.loadVideoById({ videoId: pending });
            else player.cueVideoById({ videoId: pending });
          } else {
            $('#ftvPlayerStatus').textContent = 'Ready to play';
            if (shouldPlay) player.playVideo();
          }
        },
        onStateChange: (event) => {
          const state = window.YT.PlayerState;
          if (event.data === state.PLAYING) {
            $('#ftvPlayerStatus').textContent = 'Now playing';
          } else if (event.data === state.PAUSED) {
            $('#ftvPlayerStatus').textContent = 'Paused';
          } else if (event.data === state.ENDED) {
            $('#ftvPlayerStatus').textContent = 'Finished';
            showQuiz(selectedVideo());
          } else if (event.data === state.BUFFERING) {
            $('#ftvPlayerStatus').textContent = 'Loading video';
          } else if (event.data === state.CUED) {
            $('#ftvPlayerStatus').textContent = 'Ready to play';
          }
        },
        onPlaybackRateChange: (event) => {
          if (Number(event.data) !== 1) {
            try { player.setPlaybackRate(1); } catch {}
            showNotice('Playback speed is set to normal speed.');
          }
        },
        onError: () => {
          $('#ftvPlayerStatus').textContent = 'Unavailable';
          showNotice('This video is unavailable here. Try opening it directly on YouTube.');
        }
      }
    });
  }

  function loadYouTubeApi() {
    if (window.YT?.Player) {
      initYouTubePlayer();
      return;
    }
    const previousReady = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = () => {
      if (typeof previousReady === 'function') previousReady();
      initYouTubePlayer();
    };
    if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
      const script = document.createElement('script');
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      script.onerror = () => { $('#ftvPlayerStatus').textContent = 'Ready in YouTube player'; };
      document.head.appendChild(script);
    }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (!playerReady || !player || player.getPlayerState() !== window.YT?.PlayerState?.PLAYING) return;
      wasPlayingBeforeHide = true;
      tabSwitchCount += 1;
      player.pauseVideo();
      if (tabSwitchCount === 1) {
        showNotice('Playback paused while you are away. Press Play when you return.');
      } else {
        try { player.seekTo(0, true); } catch {}
        player.stopVideo();
        showNotice('Playback was reset. Press Play when you are ready to start again.');
      }
    } else if (wasPlayingBeforeHide) {
      wasPlayingBeforeHide = false;
      $('#ftvPlayerStatus').textContent = 'Paused';
    }
  });

  if ('IntersectionObserver' in window) {
    const playerObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.intersectionRatio < 0.25 && playerReady && player?.getPlayerState() === window.YT?.PlayerState?.PLAYING) {
          player.pauseVideo();
          showNotice('Playback paused while the player is off screen.');
        }
      }
    }, { threshold: [0, 0.25, 0.75, 1] });
    const playerStage = $('#ftvPlayerStage');
    if (playerStage) playerObserver.observe(playerStage);
  }

  $('#ftvSearch')?.addEventListener('input', renderVideoGrid);
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
      event.preventDefault();
      $('#ftvSearch')?.focus();
    }
    if (event.key === 'Escape') closeQuiz();
  });

  async function refreshLibrary() {
    try {
      const response = await fetch('/api/fcmtv', { headers: { accept: 'application/json' }, cache: 'no-store' });
      if (!response.ok) throw new Error('Unable to refresh the library.');
      const data = await response.json();
      if (!Array.isArray(data.videos)) throw new Error('The library is unavailable.');
      videos = data.videos;
      const selected = videos.find((video) => video.id === selectedId) || videos.find((video) => video.featured) || videos[0] || null;
      if (selected) {
        const videoChanged = selected.youtubeId !== currentYoutubeId;
        selectedId = selected.id;
        updateSelectedDetails(selected);
        if (videoChanged && playerReady && player) {
          currentYoutubeId = selected.youtubeId;
          player.cueVideoById(selected.youtubeId);
        } else if (videoChanged && !playerReady) {
          pendingYoutubeId = selected.youtubeId;
          pendingPlay = false;
          const frame = $('#ytPlayer');
          if (frame) frame.src = embedUrl(selected.youtubeId);
        }
      } else {
        $('#ftvVideoGrid').innerHTML = '';
        $('#ftvSelectedTitle').textContent = 'No videos available right now';
        $('#ftvSelectedDescription').textContent = 'Please check back later for new FC Mobile guides.';
        $('#ftvPlayerStatus').textContent = 'Library empty';
      }
      if (data.subtitle) $('.ftv-hero-lede').textContent = data.subtitle;
      renderCategories();
      renderVideoGrid();
    } catch {
      renderCategories();
      renderVideoGrid();
    }
  }

  const closeOnBackdrop = $('#ftvQuizModal');
  closeOnBackdrop?.addEventListener('click', (event) => {
    if (event.target === closeOnBackdrop) closeQuiz();
  });

  renderCategories();
  renderVideoGrid();
  loadYouTubeApi();
  refreshLibrary();
</script>

<style is:global>
  .fcmtv-page{position:relative;isolation:isolate;min-height:100vh;overflow:hidden;background:#071018;color:#f5f8fb;padding:clamp(22px,4vw,54px) 0 80px}
  .fcmtv-ambient{position:absolute;z-index:-1;inset:0;pointer-events:none;overflow:hidden}
  .fcmtv-ambient i{position:absolute;width:480px;height:480px;border-radius:50%;filter:blur(100px);opacity:.18;animation:ftvDrift 20s ease-in-out infinite}
  .fcmtv-ambient i:nth-child(1){top:-200px;left:-160px;background:#21baff}
  .fcmtv-ambient i:nth-child(2){top:640px;right:-250px;background:#336cff;animation-delay:-7s}
