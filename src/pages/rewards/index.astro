---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="Rewards Catalogue | FCMobiletools Account"
  description="Optional FCMobiletools loyalty perks, profile titles, badges, cosmetics and limited community rewards."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="rw-page">
    <div class="rw-wrap">
      <AccountNav active="rewards" sectionLabel="Rewards" />

      <header class="rw-head acc-anim">
        <div>
          <span class="rw-kicker"><i class="rw-dot"></i> OPTIONAL LOYALTY CATALOGUE</span>
          <h1>Optional perks, zero gimmicks.</h1>
          <p>
            Redeem earned Tokens for profile titles, badges, frames and limited community rewards when available. FCMobiletools does not assign a cash value or fixed exchange rate to XP or Tokens.
          </p>
        </div>
      </header>

      <div id="root" class="rw-root">
        <div class="acc-skel rw-skel" aria-label="Loading rewards catalogue"></div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { accountAuth, escapeHtml as esc } from '../../lib/account-client.js';

  const root = document.getElementById('root');
  const fmt = (v) => Number(v || 0).toLocaleString();
  const titleCase = (v) =>
    String(v || 'reward')
      .replaceAll('_', ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

  const ART = {
    frame: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="48" height="48" rx="14"/><rect x="16" y="16" width="32" height="32" rx="9" stroke-opacity=".55"/><circle cx="32" cy="27" r="6"/><path d="M20 44c2-6 6-8 12-8s10 2 12 8"/><path d="M8 20l6-6M50 14l6 6" stroke-opacity=".6"/></svg>',
    title: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h48v20H8z" rx="4"/><path d="M8 22l6-8h36l6 8M16 32h14M16 37h8M40 30l2.5 5 5.5.8-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.5-.8z" stroke-opacity=".85"/></svg>',
    badge: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M32 6l20 7v16c0 13-8.5 22-20 27C20.500 51 12 42 12 29V13z"/><path d="M32 20l4 8.200 9 1.300-6.500 6.300 1.500 9-8-4.300-8 4.300 1.500-9L19 29.500l9-1.300z"/></svg>',
    cosmetic: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M32 6c14 0 24 9 24 21 0 8-5 11-11 11h-5c-3 0-4 2-3 5 1.500 4-1 8-6 8-12 0-23-9-23-23C8 15 18 6 32 6z"/><circle cx="21" cy="26" r="3"/><circle cx="32" cy="18" r="3"/><circle cx="44" cy="24" r="3"/></svg>',
    perk: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M34 6 14 34h15l-3 24 24-32H35z"/></svg>',
    community: '<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="24" width="48" height="12" rx="3"/><path d="M32 24v32M52 36v14a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4V36"/><path d="M32 24c-6 0-12-2-12-8s7-6 12 8c5-14 12-14 12-8s-6 8-12 8z"/></svg>'
  };
  const artFor = (type) => {
    const t = String(type || '').toLowerCase();
    if (t.includes('frame')) return ART.frame;
    if (t.includes('title')) return ART.title;
    if (t.includes('badge')) return ART.badge;
    if (t.includes('cosmetic') || t.includes('colour') || t.includes('color')) return ART.cosmetic;
    if (t.includes('community') || t.includes('promo') || t.includes('drop')) return ART.community;
    return ART.perk;
  };
  // Visual tier is derived from price only, so pricier perks look rarer.
  const tierFor = (cost) => {
    const c = Number(cost || 0);
    return c >= 1500 ? 'legendary' : c >= 800 ? 'epic' : c >= 400 ? 'rare' : 'common';
  };
  const COIN_SVG = '<svg class="rw-coin" viewBox="0 0 96 96" aria-hidden="true"><defs><radialGradient id="cg" cx=".35" cy=".3" r=".9"><stop offset="0" stop-color="#fff6d0"/><stop offset=".5" stop-color="#f6c453"/><stop offset="1" stop-color="#a87a14"/></radialGradient></defs><circle cx="48" cy="48" r="44" fill="url(#cg)"/><circle cx="48" cy="48" r="34" fill="none" stroke="#8a6410" stroke-opacity=".55" stroke-width="3"/><path d="M48 26l5.500 14.500H69L56.500 49.500 61 65 48 56 35 65l4.500-15.500L27 40.500h15.500z" fill="#8a6410" fill-opacity=".7"/></svg>';

  async function load() {
    const session = await accountAuth.auth.getSession();
    if (!session.data?.session) {
      root.innerHTML = `
        <section class="rw-empty-card acc-anim">
          <span class="rw-empty-badge">REWARD CATALOGUE</span>
          <h2>Sign in to view your Token balance &amp; rewards</h2>
          <p>Rewards are optional community perks for registered members. The entire FCMobiletools website remains free and open without an account.</p>
          <div class="rw-empty-actions">
            <a class="rw-btn-primary" href="/account/">Sign in to Account →</a>
            <a class="rw-btn-secondary" href="/account/?mode=signup">Create Free Account</a>
          </div>
        </section>
      `;
      return;
    }

    async function fetchRewards(accessToken) {
      return fetch('/api/account/rewards', {
        headers: { authorization: 'Bearer ' + accessToken },
        cache: 'no-store'
      });
    }

    let r = await fetchRewards(session.data.session.access_token);

    // Email confirmation can happen in another tab/device while the current
    // access token still carries the old auth state. Refresh once before showing
    // a verification wall.
    if (r.status === 401 || r.status === 403) {
      const refreshed = await accountAuth.auth.refreshSession();
      if (refreshed.data?.session?.access_token) {
        r = await fetchRewards(refreshed.data.session.access_token);
      }
    }

    const b = await r.json().catch(() => ({}));
    if (!r.ok) {
      const isVerification = r.status === 403;
      const isAuth = r.status === 401;
      root.innerHTML = `
        <section class="rw-empty-card acc-anim">
          <span class="rw-empty-badge">${isVerification ? 'VERIFICATION REQUIRED' : isAuth ? 'SESSION EXPIRED' : 'REWARD SERVICE'}</span>
          <h2>${esc(b.error || 'Unable to load rewards')}</h2>
          <p>${esc(
            isVerification
              ? 'Confirm your email address, then return here. You can resend the verification email from Account Settings.'
              : isAuth
                ? 'Your account session has expired. Sign in again to continue.'
                : 'The reward service returned an error. Your account is not being marked unverified.'
          )}</p>
          <div class="rw-empty-actions">
            <a class="rw-btn-primary" href="${isVerification ? '/settings/' : '/profile/'}">${isVerification ? 'Account Settings' : 'Back to Profile'}</a>
          </div>
        </section>
      `;
      return;
    }

    const economy = b.economy || {};
    const balance = Number(b.tokenBalance || 0);
    const rewards = Array.isArray(b.rewards) ? b.rewards : [];

    const locked = rewards
      .filter((r) => Number(r.cost || 0) > balance && !(r.stock !== null && Number(r.stock) <= 0))
      .sort((x, y) => Number(x.cost) - Number(y.cost))[0];
    const nextBlock = locked
      ? `<div class="rw-next">
           <div class="rw-next-row"><span>Next unlock · ${esc(locked.name)}</span><b>${fmt(balance)} / ${fmt(locked.cost)}</b></div>
           <div class="qb-bar"><i style="width:${Math.min(100, Math.round((balance / Number(locked.cost)) * 100))}%"></i></div>
         </div>`
      : '';

    const balanceBar = `
      <section class="rw-balance-bar acc-anim">
        ${COIN_SVG}
        <div class="rw-bal-main">
          <span class="rw-bal-label">AVAILABLE BALANCE</span>
          <strong><span data-count="${balance}">${fmt(balance)}</span> <small>${esc(economy.display_name || 'Tokens')}</small></strong>
          <p>Verified balance · XP and Tokens have no fixed cash value.</p>
          ${nextBlock}
        </div>
        <div class="rw-bal-actions">
          <a class="rw-btn-secondary" href="/profile/#tokens">View Token History →</a>
          <a class="rw-btn-secondary" href="/missions/">Earn via Quests</a>
        </div>
      </section>
    `;

    if (!rewards.length) {
      root.innerHTML =
        balanceBar +
        `
        <section class="rw-empty-card acc-anim acc-anim-d1">
          <span class="rw-empty-badge">CATALOGUE STANDBY</span>
          <h2>No rewards are active right now</h2>
          <p>
            The reward catalogue is configurable from the Admin Workspace. Cosmetics, profile titles, badges and limited-stock community perks appear here when enabled.
          </p>
          <div class="rw-types-grid">
            <article>
              <strong>Profile Titles &amp; Badges</strong>
              <span>Custom identity cosmetics displayed on your public profile and leaderboard row.</span>
            </article>
            <article>
              <strong>Promotional &amp; Event Drops</strong>
              <span>Limited-stock or seasonal community rewards when funded and scheduled.</span>
            </article>
            <article>
              <strong>Server-Verified Redemption</strong>
              <span>Every redemption uses idempotency keys and eligibility checks on the server.</span>
            </article>
          </div>
        </section>
      `;
      return;
    }

    root.innerHTML =
      balanceBar +
      `
      <div class="rw-grid acc-anim acc-anim-d1">
        ${rewards
          .map((item) => {
            const canAfford = balance >= Number(item.cost || 0);
            const outOfStock = item.stock !== null && Number(item.stock) <= 0;
            const tier = tierFor(item.cost);
            const pct = Math.min(100, Math.round((balance / Math.max(1, Number(item.cost || 1))) * 100));
            return `
              <article class="rw-card" data-tier="${tier}">
                <div class="rw-art" aria-hidden="true">${artFor(item.rewardType)}</div>
                <div class="rw-card-top">
                  <span class="rw-type-pill">${esc(titleCase(item.rewardType || 'Perk'))}</span>
                  <span class="rw-stock-pill ${outOfStock ? 'is-out' : ''}">
                    ${item.stock === null ? 'Available' : outOfStock ? 'Out of stock' : `${fmt(item.stock)} left`}
                  </span>
                </div>
                <div class="rw-body">
                  <h2>${esc(item.name)}</h2>
                  <p>${esc(item.description || 'Optional FCMobiletools community reward.')}</p>
                  ${!canAfford && !outOfStock ? `<div class="rw-meter"><div class="rw-meter-row"><span>Your progress</span><b>${fmt(Math.max(0, Number(item.cost) - balance))} more to go</b></div><div class="qb-bar"><i style="width:${pct}%"></i></div></div>` : ''}
                  <div class="rw-card-foot">
                    <div class="rw-cost">
                      <small>COST</small>
                      <strong>${fmt(item.cost)} ${esc(item.currencyCode || 'Tokens')}</strong>
                    </div>
                    <button
                      type="button"
                      class="rw-redeem-btn"
                      data-redeem="${esc(item.id)}"
                      ${!canAfford || outOfStock ? 'disabled' : ''}
                    >
                      ${outOfStock ? 'Sold Out' : !canAfford ? 'Locked' : 'Redeem'}
                    </button>
                  </div>
                  <p class="rw-card-msg" data-msg-for="${esc(item.id)}" hidden></p>
                </div>
              </article>
            `;
          })
          .join('')}
      </div>
    `;

    root.querySelectorAll('[data-redeem]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const rewardId = btn.dataset.redeem;
        const msgEl = root.querySelector(`[data-msg-for="${CSS.escape(rewardId)}"]`);
        btn.disabled = true;
        const prevText = btn.textContent;
        btn.textContent = 'Processing…';
        if (msgEl) {
          msgEl.hidden = true;
          msgEl.textContent = '';
        }
        try {
          const s = await accountAuth.auth.getSession();
          const rr = await fetch('/api/account/rewards/' + encodeURIComponent(rewardId) + '/redeem', {
            method: 'POST',
            headers: {
              authorization: 'Bearer ' + s.data.session.access_token,
              'content-type': 'application/json'
            },
            body: JSON.stringify({ idempotencyKey: crypto.randomUUID() })
          });
          const rb = await rr.json().catch(() => ({}));
          if (!rr.ok) throw new Error(rb.error || 'Redemption failed.');
          btn.textContent = 'Redemption Recorded ✓';
          if (msgEl) {
            msgEl.hidden = false;
            msgEl.className = 'rw-card-msg is-ok';
            msgEl.textContent = 'Redemption request verified and added to your Token history.';
          }
        } catch (e) {
          btn.disabled = false;
          btn.textContent = prevText;
          if (msgEl) {
            msgEl.hidden = false;
            msgEl.className = 'rw-card-msg is-err';
            msgEl.textContent = e.message || 'Unable to redeem this reward.';
          }
        }
      });
    });
  }

  load().catch((e) => {
    root.innerHTML = `<section class="rw-empty-card"><h2>Unable to load rewards</h2><p>${esc(e.message)}</p></section>`;
  });
</script>

<style is:global>
  .rw-page {
    min-height: calc(100vh - 80px);
    padding: 36px 18px 110px;
    background: radial-gradient(880px 440px at 15% 0%, rgba(76, 201, 255, 0.07), transparent 65%);
  }
  .rw-wrap {
    width: min(1140px, 100%);
    margin: 0 auto;
  }
  .rw-skel {
    height: 320px;
    border-radius: 24px;
  }

  .rw-head {
    margin-bottom: 22px;
  }
  .rw-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.14em;
  }
  .rw-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cc9ff;
    box-shadow: 0 0 10px #4cc9ff;
  }
  .rw-head h1 {
    margin: 10px 0 8px;
    font: 700 clamp(30px, 4.5vw, 48px) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
    color: #f5f8fb;
  }
  .rw-head p {
    margin: 0;
    max-width: 660px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }

  .rw-balance-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 24px 28px;
    border-radius: 22px;
    border: 1px solid rgba(76, 201, 255, 0.24);
    background:
      radial-gradient(circle at 0% 0%, rgba(76, 201, 255, 0.12), transparent 55%),
      linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.28);
    margin-bottom: 16px;
  }
  .rw-bal-label {
    color: #7992a4;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.12em;
  }
  .rw-bal-main strong {
    display: block;
    margin: 6px 0 4px;
    font: 800 clamp(26px, 3.5vw, 36px) / 1.05 var(--font-display);
    color: #f5f8fb;
  }
  .rw-bal-main strong small {
    font-size: 15px;
    color: #4cc9ff;
  }
  .rw-bal-main p {
    margin: 0;
    color: #8ca2b3;
    font: 500 13px/1.5 var(--font-body);
  }
  .rw-bal-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .rw-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .rw-card {
    padding: 24px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .rw-card:hover {
    transform: translateY(-2px);
    border-color: rgba(76, 201, 255, 0.3);
  }
  .rw-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .rw-type-pill {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.12);
    border: 1px solid rgba(76, 201, 255, 0.26);
    color: #8ce2ff;
    font: 700 11.5px/1 var(--font-body);
  }
  .rw-stock-pill {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(71, 209, 108, 0.12);
    color: #88eba0;
    font: 700 11.5px/1 var(--font-body);
  }
  .rw-stock-pill.is-out {
    background: rgba(255, 130, 124, 0.12);
    color: #ffaaa3;
  }
  .rw-card h2 {
    margin: 0;
    font: 700 20px/1.2 var(--font-display);
    color: #f5f8fb;
  }
  .rw-card p {
    margin: 0;
    color: #90a6b7;
    font: 500 13.5px/1.6 var(--font-body);
  }
  .rw-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .rw-cost small {
    display: block;
    color: #778fa1;
    font: 800 10.5px/1 var(--font-body);
    letter-spacing: 0.1em;
  }
  .rw-cost strong {
    display: block;
    margin-top: 4px;
    color: #f5f8fb;
    font: 800 17px/1.1 var(--font-display);
  }
  .rw-redeem-btn {
    min-height: 42px;
    padding: 0 16px;
    border-radius: 11px;
    border: 1px solid #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font: 800 13px/1 var(--font-body);
    cursor: pointer;
  }
  .rw-redeem-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .rw-card-msg {
    margin: 0;
    font: 600 12.5px/1.4 var(--font-body);
  }
  .rw-card-msg.is-ok { color: #7ee898; }
  .rw-card-msg.is-err { color: #ff9e96; }

  /* Empty Card */
  .rw-empty-card {
    padding: 36px;
    border-radius: 24px;
    border: 1px solid rgba(76, 201, 255, 0.18);
    background:
      radial-gradient(circle at 0% 0%, rgba(76, 201, 255, 0.09), transparent 55%),
      linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 24px 65px rgba(0, 0, 0, 0.3);
  }
  .rw-empty-badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.1);
    border: 1px solid rgba(76, 201, 255, 0.24);
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.1em;
  }
  .rw-empty-card h2 {
    margin: 14px 0 8px;
    font: 700 clamp(24px, 3.5vw, 34px) / 1.12 var(--font-display);
    color: #f5f8fb;
  }
  .rw-empty-card > p {
    margin: 0 0 22px;
    max-width: 680px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }
  .rw-types-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .rw-types-grid article {
    padding: 16px;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(7, 16, 24, 0.68);
  }
  .rw-types-grid strong {
    display: block;
    color: #edf5fb;
    font: 700 14.5px/1.25 var(--font-display);
    margin-bottom: 5px;
  }
  .rw-types-grid span {
    color: #88a0b2;
    font: 500 13px/1.5 var(--font-body);
  }

  .rw-empty-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .rw-btn-primary,
  .rw-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 12px;
    font: 700 13px/1 var(--font-body);
    text-decoration: none;
  }
  .rw-btn-primary {
    border: 1px solid #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font-weight: 800;
  }
  .rw-btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #101e2c;
    color: #e3eef6;
  }

  @media (max-width: 860px) {
    .rw-grid,
    .rw-types-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .rw-page {
      padding: 20px 12px 106px;
    }
    .rw-balance-bar,
    .rw-empty-card,
    .rw-card {
      padding: 20px 16px;
      border-radius: 20px;
    }
  }
</style>
