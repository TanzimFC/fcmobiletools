  .hx-lead { max-width: 560px; margin-top: 26px; color: var(--soft); font: 400 clamp(16px, 1.5vw, 19px)/1.65 var(--body); }
  .hx-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hx-proof { display: flex; flex-wrap: wrap; gap: 10px 0; margin-top: 36px; color: var(--muted); font: 500 14px/1 var(--body); }
  .hx-proof li { display: inline-flex; align-items: center; gap: 7px; }
  .hx-proof li + li::before { content: ""; width: 4px; height: 4px; margin: 0 16px; border-radius: 50%; background: rgba(139, 224, 255, .5); }
  .hx-proof b { color: var(--text); font: 700 15px/1 var(--display); }

  .hx-in { animation: hxIn .9s var(--ease) var(--d, 0s) backwards; }

  /* ───────── LIVE CONSOLE ───────── */
  .hx-console { position: relative; z-index: 6; margin-top: -136px; }
  .hx-console__grid { display: grid; grid-template-columns: 1fr 1.25fr 1fr; grid-template-areas: "reset radar code"; gap: 14px; }
  .hx-reset { grid-area: reset; } .hx-radar { grid-area: radar; } .hx-code { grid-area: code; }
  .hx-panel { position: relative; display: flex; flex-direction: column; gap: 18px; min-height: 262px; padding: 22px 24px; border: 1px solid var(--line); border-radius: 26px;
    background: linear-gradient(160deg, rgba(20, 42, 58, .82), rgba(8, 22, 32, .88)); -webkit-backdrop-filter: blur(24px) saturate(1.25); backdrop-filter: blur(24px) saturate(1.25);
    box-shadow: 0 34px 80px -34px rgba(0, 0, 0, .8), inset 0 1px 0 rgba(255, 255, 255, .07); }
  .hx-panel::before { content: ""; position: absolute; left: 24px; right: 24px; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, rgba(76, 201, 255, .7), transparent); opacity: .6; }
  .hx-panel__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .hx-panel__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; color: var(--muted); font: 500 13px/1.3 var(--body); }
  .hx-panel__foot b { color: var(--text); font-weight: 600; }
  .hx-label { display: inline-flex; align-items: center; gap: 9px; color: var(--soft); font: 600 12.5px/1 var(--body); letter-spacing: .12em; text-transform: uppercase; }
  .hx-label .hx-i { font-size: 17px; color: var(--cyan); }
  .hx-chip { padding: 6px 11px; border: 1px solid var(--line); border-radius: 99px; background: var(--glass-2); color: var(--soft); font: 600 12px/1 var(--body); white-space: nowrap; }

  .hx-clock { display: flex; align-items: baseline; gap: 4px; margin-top: 4px; font: 700 clamp(48px, 5.2vw, 66px)/1 var(--display); font-variant-numeric: tabular-nums; letter-spacing: -.03em; }
  .hx-clock i { padding: 0 2px; color: rgba(76, 201, 255, .55); font-style: normal; animation: hxBlink 1s steps(2, jump-none) infinite; }
  .hx-bar { height: 6px; border-radius: 99px; background: rgba(255, 255, 255, .08); overflow: hidden; }
  .hx-bar span { display: block; width: 100%; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--cyan), var(--mint)); transform: scaleX(0); transform-origin: left; transition: transform 1s linear; }

  .hx-radar__list { display: grid; gap: 2px; }
  .hx-row { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; align-items: center; gap: 14px; margin: 0 -12px; padding: 11px 12px; border-radius: 14px; transition: background .2s; }
