---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, img, fmtDate, iso } from '../lib/blog.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { summarizeRedeemPayload } from '../lib/redeem-summary.js';
import { safeScriptJson } from '../lib/redeem.js';
import { FOOTBALL_CENTRE_CONTENT as FC } from '../data/footballCentre.js';
import { TOOLS, GOALS, ACCENTS, iconSvg } from '../data/siteTools.js';
import { getFormation } from '../lib/teamOvr.js';

/* ───────────────────────── data ───────────────────────── */
const posts = await getPosts();
const latest = posts.slice(0, 5);
const buildTime = Date.now();

// Local Astro development can use the seed data for previewing. Production is hydrated
// from the same D1-backed live endpoint as the Redeem Codes page.
const DEV_REDEEM_SUMMARY = import.meta.env.DEV
  ? { ...summarizeRedeemPayload({ codes: REDEEM_CODES, serverDate: new Date().toISOString().slice(0, 10) }), developmentFallback: true }
  : null;

const rgb = (hex) => [1, 3, 5].map((i) => parseInt(String(hex).slice(i, i + 2), 16) || 0).join(',');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayMonth = (value) => {
  const d = value ? new Date(value) : null;
  return d && !Number.isNaN(d.valueOf()) ? `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}` : '';
};

// Reset time
const [resetH, resetM] = String(FC.schedule?.dailyResetUtc || '01:00').split(':').map((n) => Number(n) || 0);
const resetLabel = `${String(resetH).padStart(2, '0')}:${String(resetM).padStart(2, '0')} UTC`;

// Keep the homepage, Events hub and admin overrides on the same event catalog.
const normalizeEventTitle = (value) => String(value ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const homepageCatalog = (Array.isArray(FC.eventsCatalog) ? FC.eventsCatalog : []).map((event) => ({ ...event }));
const homepageOverrides = [
  FC.eventCountdown?.enabled ? FC.eventCountdown : null,
  FC.secondaryEvent?.enabled ? FC.secondaryEvent : null,
  ...(Array.isArray(FC.upcomingEvents) ? FC.upcomingEvents : [])
].filter((event) => event?.title && event.startUtc);

for (const override of homepageOverrides) {
  const match = homepageCatalog.find((event) =>
    normalizeEventTitle(event.title) === normalizeEventTitle(override.title) ||
    (override.id && event.id === override.id)
  );
  if (match) {
    match.startUtc = override.startUtc || match.startUtc;
    if (override.endUtc) match.endUtc = override.endUtc;
    if (override.banner) match.banner = override.banner;
  } else {
    homepageCatalog.push({
      id: override.id || normalizeEventTitle(override.title),
      tier: 'side',
      title: override.title,
      kicker: 'FC Mobile event',
      startUtc: override.startUtc,
      endUtc: override.endUtc || '',
      summary: override.subtitle || 'Event details will be updated as they are confirmed in-game.',
      banner: override.banner || '',
      accent: '#4cc9ff',
      highlights: [],
      href: '/events/',
      confidence: 'guide'
    });
  }
}

const homepageEvents = homepageCatalog
  .map((event) => {
    const start = Date.parse(event.startUtc);
    const end = event.endUtc ? Date.parse(event.endUtc) : NaN;
    const unconfirmed = event.confidence === 'community';
    const state = unconfirmed ? 'upcoming' : start > buildTime ? 'upcoming' : Number.isFinite(end) && end <= buildTime ? 'ended' : 'live';
    return { ...event, start, end, state };
  })
  .filter((event) => Number.isFinite(event.start) && event.state !== 'ended')
  .sort((a, b) => {
    const rank = (event) => event.state === 'upcoming' ? 2 : event.tier === 'main' ? 0 : 1;
    return rank(a) - rank(b) || (a.state === 'upcoming'
      ? a.start - b.start
      : (Number.isFinite(a.end) ? a.end : Number.POSITIVE_INFINITY) - (Number.isFinite(b.end) ? b.end : Number.POSITIVE_INFINITY));
  })
  .slice(0, 4);

// The event radar follows the same active catalog and drops expired legacy entries.
const radar = [];
const pushEvent = (event, kind) => {
  if (!event?.title || !event.startUtc) return;
  const start = Date.parse(event.startUtc);
  const end = event.endUtc ? Date.parse(event.endUtc) : NaN;
  if (!Number.isFinite(start) || (Number.isFinite(end) && end <= buildTime)) return;
  if (radar.some((row) => row.title.toLowerCase() === event.title.toLowerCase())) return;
  radar.push({ title: event.title, start, kind, label: event.accent || '', confidence: event.confidence || '' });
};
homepageCatalog.forEach((event) => pushEvent(event, 'event'));
if (FC.divisionRivalsReset?.enabled) {
  const anchor = Date.parse(FC.divisionRivalsReset.anchorUtc);
  const cycle = (FC.divisionRivalsReset.cycleDays || 28) * 864e5;
  if (!Number.isNaN(anchor)) {
    let next = anchor;
    while (next <= buildTime) next += cycle;
    radar.push({ title: 'Division Rivals reset', start: next, kind: 'reset', label: '', confidence: '' });
  }
}
radar.sort((a, b) => {
  const liveA = a.start <= buildTime && a.confidence !== 'community' ? 0 : 1;
  const liveB = b.start <= buildTime && b.confidence !== 'community' ? 0 : 1;
  return liveA - liveB || a.start - b.start;
});
const radarRows = radar.slice(0, 5);

const gift = FC.maintenanceGift?.enabled ? FC.maintenanceGift : null;
const launchPost = posts.find((p) => p.slug === 'fc-mobile-27-launch-third-anniversary');
const seasonHref = launchPost ? launchPost.href : '/fc-mobile-27';

// Display strings (kept out of the template so the markup stays simple)
// Filled in after the rows are decorated below.
radarRows.forEach((r) => {
  r.isExpected = r.confidence === 'community';
  r.isLive = r.start <= buildTime && !r.isExpected;
  r.sub = r.isExpected ? 'Expected · ' + dayMonth(r.start) : r.isLive ? 'Since ' + dayMonth(r.start) : dayMonth(r.start);
  r.initial = r.isExpected ? 'Expected' : r.isLive ? 'Live' : dayMonth(r.start);
});
const liveNow = radarRows.find((r) => r.isLive && r.kind === 'event');
const liveLine = liveNow ? `Live now: ${liveNow.title}` : 'FC Mobile 27 season';
// Current redeem-code UI is hydrated by the shared live summary client.

/* ───────────────────────── icons ───────────────────────── */
const ICON = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  ticket: '<path d="M3 9a2 2 0 0 0 0 6v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 1 0-6V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M13 5v2M13 11v2M13 17v2"/>',
  ovr: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  bolt: '<path d="M13 2 4.5 13H11l-1 9L19.5 11H13z"/>',
  rank: '<path d="m17 11-5-5-5 5"/><path d="m17 18-5-5-5 5"/>',
  shuffle: '<path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/>',
  pulse: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  youtube: '<path d="M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5C1.7 9.7 1.6 10.8 1.6 12s.1 2.3.4 3.5a3 3 0 0 0 2.1 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.3.4-3.5s-.1-2.3-.4-3.5z"/><path d="m10 9 5 3-5 3z"/>',
  discord: '<path d="M7 7c3-1.2 7-1.2 10 0 1.8 2.6 2.7 5.4 2.9 8.6-1.4 1-2.7 1.5-4 1.9l-.9-1.5c.6-.2 1.1-.5 1.6-.9-3.4 1.4-7.8 1.4-11.2 0 .5.4 1 .7 1.6.9l-.9 1.5c-1.3-.4-2.6-.9-4-1.9C4.3 12.4 5.2 9.6 7 7z"/><circle cx="9.5" cy="12.5" r="1"/><circle cx="14.5" cy="12.5" r="1"/>',
  x: '<path d="M4 4l16 16M20 4 4 20"/>',
};
const svg = (name, extra = '') =>
  `<svg class="hx-i ${extra}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICON[name]}</svg>`;

/* ───────────────────────── tools ───────────────────────── */
// Shared catalogue: the homepage, /tools and /start all read src/data/siteTools.js.
const tools = TOOLS;
const byId = (id) => TOOLS.find((t) => t.id === id);

// Bento grid: Team OVR leads, the next four are the most visited, the rest fill the grid.
const bentoTools = ['codes', 'events', 'training', 'rank-up', 'investment', 'shards', 'gauntlet'].map(byId);

// An example squad for the Team OVR tile. It is an illustration, and is labelled as one.
const demoSlots = getFormation('433').slots;
const demoOvr = [86, 84, 88, 85, 87, 89, 86, 90, 88, 91, 92];
const demoAvg = Math.round(demoOvr.reduce((a, b) => a + b, 0) / demoOvr.length);

// The beginner path: the first four goals. /start has all six plus a glossary.
const startGoals = GOALS.slice(0, 4);

/* ───────────────────────── FAQ (single source for page + JSON-LD) ───────────────────────── */
const faqs = [
  { q: 'What is FCMOBILETOOLS?', a: 'FCMOBILETOOLS is a fan-made FC Mobile resource hub for redeem codes, live events, reset times, calculators, planners, guides and game updates. It is not affiliated with EA SPORTS or FC Mobile.' },
  { q: 'Where can I find current FC Mobile redeem codes?', a: 'The Redeem Codes page lists the status and reward of every code and points you to the official EA redemption flow.' },
  { q: 'Which FC Mobile tools are available?', a: "Team OVR, Training, Rank Up and Investment calculators, the Gauntlet Planner, Shards Counter, Football Centre and A Nation's Story answer finder." },
  { q: 'When does the FC Mobile daily reset happen?', a: `The daily reset is at ${resetLabel}. The live countdown at the top of this page shows the time remaining and converts the reset to your own time zone.` },
];

const SITE = 'https://fcmobiletools.online';
const title = 'FC Mobile Tools, Codes & Calculators';
const description =
  'FC Mobile tools for squad building, live events, redeem codes and upgrades. Explore free calculators, planners, trackers and guides from FCMOBILETOOLS.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': SITE + '/#homepage', url: SITE + '/', name: title, description, isPartOf: { '@id': SITE + '/#website' } },
    {
      '@type': 'ItemList',
      name: 'FC Mobile tools and resources',
      itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: SITE + t.href })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="hx" id="main">

    <!-- Hero: same artwork as before, calmer type -->
    <section class="hx-hero" aria-labelledby="hx-h1">
      <picture class="hx-hero__img" aria-hidden="true">
        <source media="(max-width: 700px)" srcset="/assets/images/hero-home-mobile.webp" type="image/webp" />
        <img src="/assets/images/hero-home.webp" alt="" width="1918" height="820" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hx-hero__shade" aria-hidden="true"></div>

      <div class="hx-wrap hx-hero__inner">
        <p class="hx-status"><span class="hx-dot" aria-hidden="true"></span>{liveLine}</p>
        <h1 id="hx-h1" class="hx-h1"><span class="fx-text">FC Mobile Tools for Squad Building, Events and Upgrades</span></h1>
        <p class="hx-sub">Free FC Mobile tools for squad planning, training, rank ups, live events, redeem codes and more.</p>

        <div class="hx-actions">
          <a class="hx-btn hx-btn--primary" href="/redeem-codes"><span>Get today's redeem code</span><span set:html={svg('arrow')} /></a>
          <a class="hx-btn hx-btn--ghost" href="/events"><span>See live events</span></a>
          <a class="hx-btn hx-btn--quiet" href="/start/"><span>New here? Start here</span></a>
        </div>

        <ul class="hx-jump" aria-label="Popular tools">
          <li><a href="/team-ovr/"><span set:html={iconSvg('ovr')} />Team OVR</a></li>
          <li><a href="/training-calculator/"><span set:html={iconSvg('training')} />Training</a></li>
          <li><a href="/rank-up-calculator/"><span set:html={iconSvg('rank')} />Rank Up</a></li>
          <li><a href="/investment-calculator/"><span set:html={iconSvg('investment')} />Investment</a></li>
          <li><a href="/trivia/"><span set:html={iconSvg('trivia')} />Trivia</a></li>
        </ul>

        <ul class="hx-proof" aria-label="Site at a glance">
          <li><b>{tools.length}</b> free tools</li>
          <li>No account needed</li>
          <li><b>{posts.length}</b> guides and updates</li>
          <li data-fcmt-code-proof>Checking code status</li>
        </ul>
      </div>
    </section>

    <!-- Live board: reset clock, event radar, current code -->
    <section class="hx-board" aria-label="Live status">
      <div class="hx-wrap">
        <div class="hx-board__grid">

          <article class="hx-cell hx-reset">
            <header class="hx-cell__head">
              <span class="hx-label"><span set:html={svg('clock')} />Next daily reset</span>
              <span class="hx-chip" data-hx-tz>Local time</span>
            </header>
            <div class="hx-clock" role="timer" aria-label="Time until next daily reset">
              <span data-hx-h>--</span><i>:</i><span data-hx-m>--</span><i>:</i><span data-hx-s>--</span>
            </div>
            <div class="hx-bar" aria-hidden="true"><span data-hx-bar></span></div>
            <footer class="hx-cell__foot">
              <span>Your time <b data-hx-local>--:--</b></span>
              <span>{resetLabel}</span>
            </footer>
          </article>

          <article class="hx-cell hx-radar">
            <header class="hx-cell__head">
              <span class="hx-label"><span set:html={svg('calendar')} />Event radar</span>
              <a class="hx-textlink" href="/events">All events <span set:html={svg('arrow')} /></a>
            </header>
            <ul class="hx-radar__list">
              {radarRows.slice(0, 4).map((r) => (
                <li>
                  <a href="/events" class:list={['hx-row', r.isLive && 'is-live']} data-hx-ts={r.start} data-hx-kind={r.kind} data-hx-confidence={r.confidence}>
                    <span class="hx-row__dot" aria-hidden="true"></span>
                    <span class="hx-row__main">
                      <b>{r.title}</b>
                      <small>{r.sub}</small>
                    </span>
                    <span class="hx-row__cd" data-hx-cd>{r.initial}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>

          <article class="hx-cell hx-code is-none" data-fcmt-current-code>
            <header class="hx-cell__head">
              <span class="hx-label"><span set:html={svg('ticket')} />Redeem code</span>
              <span class="hx-chip hx-chip--status" data-fcmt-code-status>Checking</span>
            </header>
            <div class="hx-code__body" data-fcmt-code-body>
              <p class="hx-code__none">Checking the current code.</p>
              <p class="hx-code__reward">The full list shows every code with its reward, region and expiry date.</p>
              <a class="hx-textlink" href="/redeem-codes/">Open the full list <span set:html={svg('arrow')} /></a>
            </div>
            <footer class="hx-cell__foot">
              <span data-fcmt-code-foot>Live data from the Redeem Codes page</span>
            </footer>
          </article>
        </div>
      </div>
    </section>

    {homepageEvents.length > 0 && (
      <section class="hx-section hx-events" id="current-events" aria-labelledby="hx-events-h">
        <div class="hx-wrap">
          <header class="hx-section__head hx-section__head--row">
            <div>
              <h2 id="hx-events-h">FC Mobile 27 live &amp; upcoming events</h2>
              <p>See what is live, what is coming next and where to check event rewards before spending your resources.</p>
            </div>
            <a class="hx-textlink hx-textlink--lg" href="/events/">Open the full event tracker <span set:html={svg('arrow')} /></a>
          </header>
          <div class="hx-events__grid">
            {homepageEvents.map((event) => (
              <a class="hx-event-card" href={'/events/#event-' + event.id} style={'--hx-event-accent:' + (event.accent || '#4cc9ff')}>
                <span class="hx-event-card__media">
                  {event.banner
                    ? <img src={event.banner} alt={event.title + ' FC Mobile 27 event banner'} width="800" height="450" loading="lazy" decoding="async" />
                    : <span class="hx-event-card__fallback">FC MOBILE 27</span>}
                  <span class="hx-event-card__status" data-state={event.state} data-confidence={event.confidence || ''}>
                    {event.confidence === 'community' ? 'Expected' : event.state === 'live' ? 'Live now' : 'Upcoming'}
                  </span>
                </span>
                <span class="hx-event-card__copy">
                  <small>{event.kicker || 'FC Mobile event'}</small>
                  <b>{event.title}</b>
                  <span class="hx-event-card__summary">{event.summary}</span>
                  <span class="hx-event-card__dates">
                    {dayMonth(event.startUtc)}{event.endUtc ? ' – ' + dayMonth(event.endUtc) : ''}
                  </span>
                  <em>Event details <span aria-hidden="true">↗</span></em>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Beginner path -->
    <section class="hx-section" id="start" aria-labelledby="hx-start-h">
      <div class="hx-wrap">
        <header class="hx-section__head hx-section__head--row">
          <div>
            <h2 id="hx-start-h">New here? Start with what you want to do</h2>
            <p>Pick a goal. Each one opens the right page first, and you can come back for the rest.</p>
          </div>
          <a class="hx-textlink hx-textlink--lg" href="/start/">See all paths <span set:html={svg('arrow')} /></a>
        </header>
        <div class="hx-recent" data-recent-tools hidden>
          <span class="hx-recent__label">Pick up where you left off</span>
          <div class="hx-recent__list" data-recent-list></div>
        </div>
        <div class="hx-goals" data-rv-group>
          {startGoals.map((g) => (
            <a class="hx-goal" href={g.first.href} style={`--ac:${ACCENTS[g.accent]}`}>
              <span class="hx-goal__ico" set:html={iconSvg(g.icon)}></span>
              <b>{g.title}</b>
              <small>{g.lead}</small>
              <span class="hx-goal__go">{g.first.label}<span set:html={svg('arrow')} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tools showcase -->
    <section class="hx-section hx-section--tight" id="tools" aria-labelledby="hx-tools-h">
      <div class="hx-wrap">
        <header class="hx-section__head hx-section__head--row">
          <div>
            <h2 id="hx-tools-h">Free FC Mobile tools</h2>
            <p>Calculators that show the cost of an upgrade before you spend, and trackers for what is live.</p>
          </div>
          <a class="hx-textlink hx-textlink--lg" href="/tools/">Browse all {tools.length} tools <span set:html={svg('arrow')} /></a>
        </header>

        <div class="hx-bento" data-rv-group>
          <a class="hx-tile hx-tile--hero" href="/team-ovr/" style={`--ac:${ACCENTS.cyan}`}>
            <span class="hx-tile__copy">
              <span class="hx-tag">Popular</span>
              <b>Team OVR Calculator</b>
              <small>Enter your squad, choose from 28 formations and see your Team OVR with the cheapest way to gain the next point. Save it as an image.</small>
              <span class="hx-tile__go">Open calculator <span set:html={svg('arrow')} /></span>
            </span>
            <span class="hx-pitch" aria-hidden="true">
              <svg viewBox="0 0 100 140" preserveAspectRatio="none">
                <g fill="none" stroke="currentColor" stroke-width=".9" opacity=".45">
                  <rect x="4" y="4" width="92" height="132" rx="2"/><path d="M4 70h92"/><circle cx="50" cy="70" r="11"/>
                  <rect x="24" y="4" width="52" height="19"/><rect x="24" y="117" width="52" height="19"/>
                </g>
                {demoSlots.map((slot, i) => (
                  <g transform={`translate(${slot.x} ${slot.y * 0.98 + 1})`}>
                    <rect x="-7.4" y="-8" width="14.8" height="16" rx="3" class="hx-pitch__chip" data-hi={demoOvr[i] >= 90 ? '1' : '0'} />
                    <text y="2.6" text-anchor="middle" class="hx-pitch__num">{demoOvr[i]}</text>
                  </g>
                ))}
              </svg>
              <span class="hx-pitch__cap">Example squad · Team OVR <b>{demoAvg}</b></span>
            </span>
          </a>
          {bentoTools.slice(0, 4).map((t) => (
            <a class="hx-tile" href={t.href} style={`--ac:${ACCENTS[t.accent]}`}>
              <span class="hx-tile__ico" set:html={iconSvg(t.icon)}></span>
              <b>{t.name}</b>
              <small>{t.short}</small>
              <span class="hx-tile__arrow" set:html={svg('arrow')}></span>
            </a>
          ))}
          {bentoTools.slice(4).map((t) => (
            <a class="hx-tile" href={t.href} style={`--ac:${ACCENTS[t.accent]}`}>
