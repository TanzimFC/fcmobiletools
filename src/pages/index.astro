---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const latestArticles = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft)).sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0)).slice(0, 4);
const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
---
<BaseLayout title="FC Mobile Tools" description="A focused FC Mobile toolkit for redeem codes, Football Centre, Team OVR, A Nation's Story and guides.">
  <main class="home-v2">
    <section class="hero-v2">
      <div class="wrap hero-v2-grid">
        <div class="hero-v2-copy">
          <p class="eyebrow">FC MOBILE TOOLS · BY TANZIMFC</p>
          <h1>Everything useful.<br><span>One place.</span></h1>
          <p class="lead">Redeem codes, event resources, calculators, answers and practical FC Mobile guides — built to get you to the useful part faster.</p>
          <div class="hero-v2-actions">
            <a class="btn-v2 primary" href="/redeem-codes">Check Redeem Codes <b>↗</b></a>
            <a class="btn-v2" href="/football-centre">Open Football Centre <b>↗</b></a>
          </div>
          <div class="hero-v2-meta"><span><b>01</b> TOOLS</span><span><b>02</b> TRACKERS</span><span><b>03</b> GUIDES</span><span><b>04</b> ANSWERS</span></div>
        </div>
        <div class="hero-v2-art" aria-hidden="true"><img src="/assets/images/herobeli.png" alt="" /></div>
      </div>
    </section>

    <section class="wrap home-v2-section">
      <div class="v2-heading"><div><p class="eyebrow">01 / CORE TOOLS</p><h2>Start with what you need.</h2></div><p>Fast access to the resources players use most, with calculators and guides kept close by.</p></div>
      <div class="v2-tool-grid">
        <a class="v2-card featured" href="/redeem-codes"><span>DATABASE / 01</span><div class="card-icon">↗</div><h3>Redeem Codes</h3><p>Find working codes, search the archive and jump to EA's redemption page.</p><strong>CHECK LATEST CODES</strong></a>
        <a class="v2-card featured green" href="/football-centre"><span>TRACKER / 02</span><div class="card-icon">↗</div><h3>Football Centre</h3><p>Track matches, points, rewards and event progress in one focused dashboard.</p><strong>OPEN FOOTBALL CENTRE</strong></a>
        <a class="v2-card" href="/team-ovr"><span>CALCULATOR / 03</span><h3>Team OVR</h3><p>Calculate Team OVR from base OVR, ranks and eligible badges.</p><strong>OPEN CALCULATOR →</strong></a>
        <a class="v2-card" href="/a-nations-story"><span>ANSWERS / 04</span><h3>A Nation's Story</h3><p>Search questions and find the exact answer without digging.</p><strong>GET THE ANSWER →</strong></a>
        <a class="v2-card" href="/training-calculator"><span>CALCULATOR / 05</span><h3>Training Calculator</h3><p>Calculate training XP, fodder players, excess XP and estimated cost.</p><strong>CALCULATE →</strong></a>
        <a class="v2-card" href="/rank-up-calculator"><span>CALCULATOR / 06</span><h3>Rank Up Calculator</h3><p>Calculate Rank Up Points, OVR gain, Skill Points and upgrade cost.</p><strong>CALCULATE →</strong></a>
      </div>
    </section>

    <section class="v2-quick"><div class="wrap v2-quick-grid"><div><p class="eyebrow">02 / QUICK START</p><h2>Need something<br><span>right now?</span></h2><p>Skip the browsing. Go directly to the resource.</p></div><div class="v2-links"><a href="/redeem-codes"><i>01</i><b>Check latest redeem codes</b><span>→</span></a><a href="/football-centre"><i>02</i><b>Open Football Centre</b><span>→</span></a><a href="/team-ovr"><i>03</i><b>Calculate Team OVR</b><span>→</span></a><a href="/a-nations-story"><i>04</i><b>Find an A Nation's Story answer</b><span>→</span></a><a href="/blog"><i>05</i><b>Read latest guides</b><span>→</span></a></div></div></section>

    <section class="wrap home-v2-section latest-v2"><div class="v2-heading"><div><p class="eyebrow">03 / LATEST CONTENT</p><h2>Fresh from the<br><span>FC Mobile desk.</span></h2></div><a class="v2-text-link" href="/blog">View all articles →</a></div>{latestArticles.length ? <div class="v2-article-grid">{latestArticles.map((post) => <a class="v2-article" href={`/blog/${post.slug}/`}>{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <div class="v2-placeholder"><span>FC</span></div>}<div><div class="v2-article-meta"><span>{post.data.category}</span><span>{readingTime(post)} min read</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt ?? post.data.description}</p><strong>Read article →</strong></div></a>)}</div> : <div class="v2-empty"><b>No published articles yet.</b><span>New Markdown articles will appear here automatically when published.</span></div>}</section>

    <section class="wrap v2-principles"><div><p class="eyebrow">04 / THE IDEA</p><h2>Less searching.<br><span>More playing.</span></h2></div><div><p class="v2-principles-lead">FC Mobile Tools is built around practical resources that answer a specific question quickly, with time-sensitive information easy to reach.</p><div class="principle-grid"><div><b>01</b><strong>USEFUL FIRST</strong><p>No filler around the tools.</p></div><div><b>02</b><strong>LIVE WHERE IT MATTERS</strong><p>Codes and event resources stay easy to reach.</p></div><div><b>03</b><strong>PLAYER FOCUSED</strong><p>Designed around everyday FC Mobile workflows.</p></div></div></div></section>
  </main>
</BaseLayout>
<style>
.home-v2{overflow:hidden;background:#f5fbfd;color:#10242e}.home-v2 .wrap{width:min(1180px,calc(100% - 40px));margin:auto}.home-v2 .eyebrow{margin:0;color:#0787b7;font:900 9px var(--mono);letter-spacing:.15em}.hero-v2{position:relative;overflow:hidden;background:linear-gradient(115deg,#e9f8fc 0%,#f7fcfd 52%,#dff4ee 100%);border-bottom:1px solid #cfe7ee}.hero-v2-grid{min-height:610px;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;position:relative}.hero-v2-copy{position:relative;z-index:2;padding:75px 0}.hero-v2 h1{font-size:clamp(55px,7vw,88px);line-height:.9;letter-spacing:-.065em;margin:18px 0;color:#10242e}.hero-v2 h1 span,.v2-heading h2 span,.v2-quick h2 span,.v2-principles h2 span{color:#078fbd}.hero-v2 .lead{max-width:600px;color:#58717d;font-size:14px;line-height:1.8;margin:22px 0 28px}.hero-v2-actions{display:flex;gap:9px}.btn-v2{display:inline-flex;align-items:center;gap:9px;padding:13px 16px;border:1px solid #c7e0e8;border-radius:10px;background:#fff;color:#17303b;font:900 9px var(--mono);box-shadow:0 7px 20px #0d6f8910}.btn-v2.primary{background:#0b9aca;border-color:#0b9aca;color:#fff}.btn-v2:hover{transform:translateY(-2px);border-color:#0b9aca}.hero-v2-meta{display:flex;gap:20px;flex-wrap:wrap;margin-top:40px;padding-top:17px;border-top:1px solid #c7e0e8;max-width:650px}.hero-v2-meta span{font:800 7px var(--mono);color:#6c8791}.hero-v2-meta b{color:#078fbd;margin-right:5px}.hero-v2-art{height:100%;display:flex;align-items:center;justify-content:center;padding:35px 0 35px 15px}.hero-v2-art img{width:min(100%,590px);max-height:540px;object-fit:contain;filter:drop-shadow(0 25px 35px #164a5a22)}.home-v2-section{padding:82px 0}.v2-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:24px}.v2-heading h2{font-size:clamp(31px,4vw,48px);line-height:1;letter-spacing:-.05em;margin:8px 0 0}.v2-heading>p{max-width:390px;color:#68808a;font-size:11px;line-height:1.7;margin:0}.v2-tool-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:11px}.v2-card{grid-column:span 2;position:relative;min-height:205px;padding:23px;border:1px solid #d5e8ed;border-radius:16px;background:#fff;text-decoration:none;color:#10242e;box-shadow:0 5px 18px #164c5a09;transition:.2s}.v2-card.featured{grid-column:span 3;min-height:245px;background:linear-gradient(145deg,#fff,#edf9fc)}.v2-card.green{background:linear-gradient(145deg,#fff,#eefaf4)}.v2-card:hover{transform:translateY(-4px);border-color:#79c6dc;box-shadow:0 18px 38px #164c5a14}.v2-card>span{font:900 8px var(--mono);letter-spacing:.12em;color:#078fbd}.v2-card.green>span{color:#299c61}.card-icon{position:absolute;right:19px;top:17px;width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:#e7f7fb;color:#078fbd;font-weight:900}.green .card-icon{background:#e6f7ed;color:#299c61}.v2-card h3{font-size:23px;letter-spacing:-.03em;margin:35px 0 8px}.v2-card:not(.featured) h3{font-size:19px;margin-top:42px}.v2-card p{max-width:430px;color:#6a818b;font-size:11px;line-height:1.7;margin:0}.v2-card strong{position:absolute;bottom:20px;left:23px;color:#078fbd;font:900 8px var(--mono)}.green strong{color:#299c61}.v2-quick{background:#0d2d3a;color:#eef9fc}.v2-quick-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center;padding:72px 0}.v2-quick h2{font-size:clamp(36px,5vw,58px);line-height:.94;letter-spacing:-.055em;margin:9px 0}.v2-quick p:not(.eyebrow){color:#8da9b3;font-size:11px}.v2-links{border-top:1px solid #ffffff18}.v2-links a{display:grid;grid-template-columns:40px 1fr 20px;align-items:center;gap:10px;padding:17px 0;border-bottom:1px solid #ffffff18;color:#e5f2f5;text-decoration:none}.v2-links i{font:800 8px var(--mono);font-style:normal;color:#59cbe5}.v2-links b{font-size:13px}.v2-links span{color:#7d9aa5}.v2-links a:hover b,.v2-links a:hover span{color:#59cbe5}.latest-v2{border-bottom:1px solid #d5e8ed}.v2-text-link{color:#078fbd;font:900 8px var(--mono);text-decoration:none}.v2-article-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.v2-article{display:grid;grid-template-columns:180px 1fr;min-height:180px;border:1px solid #d5e8ed;border-radius:14px;overflow:hidden;background:#fff;color:#10242e;text-decoration:none;transition:.2s}.v2-article:hover{transform:translateY(-3px);border-color:#79c6dc;box-shadow:0 16px 35px #164c5a12}.v2-article img,.v2-placeholder{width:100%;height:100%;min-height:180px;object-fit:cover}.v2-placeholder{display:grid;place-items:center;background:#eaf7fa;color:#078fbd;font:900 35px var(--mono)}.v2-article>div:last-child{padding:18px}.v2-article-meta{display:flex;gap:10px;font:800 7px var(--mono);color:#078fbd;text-transform:uppercase}.v2-article-meta span:last-child{color:#8299a2}.v2-article h3{font-size:18px;line-height:1.08;margin:11px 0 7px}.v2-article p{font-size:10px;line-height:1.6;color:#6a818b;margin:0}.v2-article strong{display:block;margin-top:13px;color:#078fbd;font:900 7px var(--mono)}.v2-empty{padding:28px;border:1px dashed #c8e0e7;border-radius:13px;display:grid;gap:5px}.v2-empty span{font-size:10px;color:#6a818b}.v2-principles{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;padding:85px 0}.v2-principles h2{font-size:clamp(40px,5vw,61px);line-height:.94;letter-spacing:-.055em;margin:10px 0}.v2-principles-lead{max-width:570px;color:#607984;font-size:14px;line-height:1.8;margin:0}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:35px}.principle-grid div{padding:17px;border:1px solid #d5e8ed;border-radius:12px;background:#fff}.principle-grid b{font:900 8px var(--mono);color:#078fbd}.principle-grid strong{display:block;margin-top:19px;font:900 8px var(--mono)}.principle-grid p{font-size:9px;line-height:1.6;color:#6a818b}@media(max-width:850px){.hero-v2-grid{grid-template-columns:1fr;min-height:auto}.hero-v2-art{position:absolute;right:-130px;bottom:-40px;width:65%;height:70%;opacity:.2}.hero-v2-copy{padding:90px 0 105px}.v2-tool-grid{grid-template-columns:1fr 1fr}.v2-card,.v2-card.featured{grid-column:span 1}.v2-card.featured{min-height:220px}.v2-quick-grid,.v2-principles{grid-template-columns:1fr;gap:40px}.v2-article-grid{grid-template-columns:1fr}}@media(max-width:560px){.home-v2 .wrap{width:calc(100% - 28px)}.hero-v2-copy{padding:72px 0 85px}.hero-v2 h1{font-size:51px}.hero-v2-actions{flex-direction:column}.btn-v2{justify-content:center}.hero-v2-meta{gap:12px}.hero-v2-art{right:-155px;width:100%;opacity:.16}.home-v2-section{padding:64px 0}.v2-heading{display:block}.v2-heading>p{margin-top:16px}.v2-tool-grid{grid-template-columns:1fr}.v2-card,.v2-card.featured{grid-column:span 1}.v2-quick-grid{padding:62px 0}.v2-article{grid-template-columns:1fr}.v2-article img,.v2-placeholder{min-height:150px}.principle-grid{grid-template-columns:1fr}.v2-principles{padding:65px 0}}
</style>