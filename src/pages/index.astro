---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, img, fmtDate, iso } from '../lib/blog.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { FOOTBALL_CENTRE_CONTENT as FC } from '../data/footballCentre.js';

const posts = await getPosts();
const latest = posts.slice(0, 4);
const buildTime = Date.now();
const isLiveCode = (code) => code.status === 'active' && (!code.expiryDate || Date.parse(code.expiryDate + 'T23:59:59Z') > buildTime);
const liveCodes = REDEEM_CODES.filter(isLiveCode);
const featuredCode = liveCodes[0] ?? null;
const lastCode = featuredCode ?? REDEEM_CODES[0] ?? null;
const lastChecked = REDEEM_CODES.map((code) => code.lastVerified).filter(Boolean).sort().pop() ?? null;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayMonth = (value) => {
  const date = value ? new Date(value) : null;
  return date && !Number.isNaN(date.valueOf()) ? date.getUTCDate() + ' ' + MONTHS[date.getUTCMonth()] : '';
};
const resetParts = String(FC.schedule?.dailyResetUtc || '01:00').split(':').map((part) => Number(part) || 0);
const resetH = resetParts[0] || 0;
const resetM = resetParts[1] || 0;
const resetLabel = String(resetH).padStart(2, '0') + ':' + String(resetM).padStart(2, '0') + ' UTC';
const radar = [];
const pushEvent = (event, kind) => {
  if (!event?.title || !event.startUtc) return;
  const start = Date.parse(event.startUtc);
  if (Number.isNaN(start) || radar.some((row) => row.title.toLowerCase() === event.title.toLowerCase())) return;
  radar.push({ title: event.title, start, kind, accent: event.accent || '' });
};
if (FC.eventCountdown?.enabled) pushEvent(FC.eventCountdown, 'event');
if (FC.secondaryEvent?.enabled) pushEvent(FC.secondaryEvent, 'event');
(FC.upcomingEvents ?? []).forEach((event) => pushEvent(event, 'event'));
if (FC.divisionRivalsReset?.enabled) {
  const anchor = Date.parse(FC.divisionRivalsReset.anchorUtc);
  const cycle = (FC.divisionRivalsReset.cycleDays || 28) * 864e5;
  if (!Number.isNaN(anchor)) {
    let next = anchor;
    while (next <= buildTime) next += cycle;
    radar.push({ title: 'Division Rivals reset', start: next, kind: 'reset', accent: '' });
  }
}
radar.sort((a, b) => (a.start <= buildTime ? 0 : 1) - (b.start <= buildTime ? 0 : 1) || a.start - b.start);
const radarRows = radar.slice(0, 3);
const gift = FC.maintenanceGift?.enabled ? FC.maintenanceGift : null;
const launchPost = posts.find((post) => post.slug === 'fc-mobile-27-launch-third-anniversary');
const seasonHref = launchPost ? launchPost.href : '/fc-mobile-27';

const ICON = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  ticket: '<path d="M3 9a2 2 0 0 0 0 6v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 1 0-6V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M13 5v2M13 11v2M13 17v2"/>',
  squad: '<path d="M12 3 20 7v5c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V7l8-4z"/><path d="m9 12 2 2 4-4"/>',
  bolt: '<path d="M13 2 4.5 13H11l-1 9L19.5 11H13z"/>',
  rank: '<path d="m17 11-5-5-5 5M17 18l-5-5-5 5"/>',
  chart: '<path d="M3 3v18h18"/><path d="m7 14 4-4 4 3 6-8"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  discord: '<path d="M7 7c3-1.2 7-1.2 10 0 1.8 2.6 2.7 5.4 2.9 8.6-1.4 1-2.7 1.5-4 1.9l-.9-1.5c.6-.2 1.1-.5 1.6-.9-3.4 1.4-7.8 1.4-11.2 0 .5.4 1 .7 1.6.9l-.9 1.5c-1.3-.4-2.6-.9-4-1.9C4.3 12.4 5.2 9.6 7 7z"/><circle cx="9.5" cy="12.5" r="1"/><circle cx="14.5" cy="12.5" r="1"/>',
  youtube: '<path d="M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5C1.7 9.7 1.6 10.8 1.6 12s.1 2.3.4 3.5a3 3 0 0 0 2.1 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.3.4-3.5s-.1-2.3-.4-3.5z"/><path d="m10 9 5 3-5 3z"/>'
};
const svg = (name, extra = '') => '<svg class="pr-icon ' + extra + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + ICON[name] + '</svg>';
const tools = [
  { href: '/team-ovr', name: 'Team OVR', category: 'squad', label: 'Squad builder', text: 'See the rating before you spend coins on upgrades.', icon: 'squad', tone: 'cyan' },
  { href: '/training-calculator', name: 'Training Calculator', category: 'squad', label: 'XP planning', text: 'Map training levels and plan the resources you need.', icon: 'bolt', tone: 'mint' },
  { href: '/rank-up-calculator', name: 'Rank Up Calculator', category: 'squad', label: 'Rank planning', text: 'Compare rank-up costs and squad OVR gains.', icon: 'rank', tone: 'violet' },
  { href: '/investment-calculator', name: 'Market Calculator', category: 'market', label: 'Market maths', text: 'Check tax, net profit and break-even prices before a sale.', icon: 'chart', tone: 'amber' },
  { href: '/gauntlet-planner', name: 'Gauntlet Planner', category: 'events', label: 'Event planning', text: 'Plan rotations and player availability for your run.', icon: 'calendar', tone: 'violet' },
  { href: '/shards-counter', name: 'Shards Counter', category: 'events', label: 'Progress tracker', text: 'Track your Star Shards balance against your next reward.', icon: 'star', tone: 'mint' },
  { href: '/trivia/', name: 'Trivia', category: 'events', label: 'Answers + practice', text: 'Find Season Recap and A Nation’s Story answers, then practice.', icon: 'book', tone: 'cyan' },
  { href: '/leagues/', name: 'Find a League', category: 'community', label: 'Community', text: 'Find a club or meet players looking for a league.', icon: 'users', tone: 'amber' }
];
const faqItems = [
  { q: 'Where are the latest FC Mobile redeem codes?', a: 'Open the Redeem Codes page for listed rewards, region details and each code’s current status. Use the official EA redemption flow to claim a reward.' },
  { q: 'Which FC Mobile calculators are available?', a: 'FCMOBILETOOLS includes Team OVR, Training, Rank Up and market calculators, plus the Gauntlet Planner and Shards Counter.' },
  { q: 'When does the daily reset happen?', a: 'The configured FC Mobile daily reset is ' + resetLabel + '. The counter on this page updates every second and displays your local reset time.' },
  { q: 'Is FCMOBILETOOLS an official EA website?', a: 'No. FCMOBILETOOLS is an independent fan-made resource and is not affiliated with or endorsed by EA SPORTS or FC Mobile.' }
];
const SITE = 'https://fcmobiletools.online';
const title = 'FC Mobile Tools, Redeem Codes, Calculators & Guides | FCMOBILETOOLS';
const description = 'The FC Mobile player workspace for redeem codes, live events, squad calculators, reset countdowns, guides and community tools.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': SITE + '/#homepage', url: SITE + '/', name: title, description, isPartOf: { '@id': SITE + '/#website' } },
    { '@type': 'ItemList', name: 'FC Mobile tools and resources', itemListElement: [{ name: 'Redeem Codes', href: '/redeem-codes' }, ...tools].map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name || 'Redeem Codes', url: SITE + (item.href || '/redeem-codes') })) },
    { '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="pr-home" id="content">
    <section class="pr-hero" aria-labelledby="pr-hero-title">
      <img class="pr-hero__image" src="/assets/images/hero-home.webp" alt="" width="1918" height="820" fetchpriority="high" decoding="async" />
      <div class="pr-hero__veil" aria-hidden="true"></div>
      <div class="pr-hero__grid" aria-hidden="true"></div>
      <div class="pr-shell pr-hero__layout">
        <div class="pr-hero__copy">
          <p class="pr-eyebrow pr-rise" style="--delay: .04s"><span class="pr-live-dot"></span> THE PLAYER WORKSPACE <span class="pr-eyebrow__line"></span> FC MOBILE 27</p>
          <h1 id="pr-hero-title" class="pr-display pr-rise" style="--delay: .1s">EVERYTHING USEFUL.<span>ONE <em>BETTER</em> MOVE.</span></h1>
          <p class="pr-hero__lead pr-rise" style="--delay: .18s">Codes before they expire. Calculators before you spend. Event answers when you need them. Your FC Mobile routine, without the tab hunt.</p>
          <div class="pr-hero__actions pr-rise" style="--delay: .26s">
            <a class="pr-button pr-button--primary" href="#toolkit"><span>Explore the toolkit</span><span set:html={svg('arrow')} /></a>
            <a class="pr-button pr-button--glass" href="/redeem-codes"><span set:html={svg('ticket')} /><span>Redeem codes</span></a>
          </div>
          <div class="pr-hero__proof pr-rise" style="--delay: .34s">
            <span><b>{tools.length + 1}</b> player tools</span>
            <i></i>
            <span><b>{liveCodes.length}</b> active codes now</span>
            <i></i>
            <span><b>{posts.length}</b> guides & updates</span>
          </div>
        </div>

        <aside class="pr-command pr-rise" style="--delay: .22s" aria-label="FC Mobile quick status">
          <div class="pr-command__top"><span class="pr-command__signal"><i></i> LIVE DESK</span><span class="pr-command__serial">FCM / 027</span></div>
          <div class="pr-command__headline"><span class="pr-command__orbit" aria-hidden="true"><i></i><i></i><i></i></span><div><small>YOUR NEXT SESSION</small><strong>Starts here.</strong></div></div>
          <a class="pr-command__row" href="/redeem-codes"><span class="pr-command__glyph pr-tone-mint" set:html={svg('ticket')} /><span><b>Redeem codes</b><small>{liveCodes.length > 0 ? liveCodes.length + ' active right now' : 'Check the latest status'}</small></span><span class="pr-command__arrow" set:html={svg('arrow')} /></a>
          <a class="pr-command__row" href="/events"><span class="pr-command__glyph pr-tone-cyan" set:html={svg('calendar')} /><span><b>Live events</b><small>{radarRows.length > 0 ? 'Countdowns and event timing' : 'Open the event hub'}</small></span><span class="pr-command__arrow" set:html={svg('arrow')} /></a>
          <a class="pr-command__row" href="/team-ovr"><span class="pr-command__glyph pr-tone-violet" set:html={svg('squad')} /><span><b>Squad planning</b><small>Check your OVR before upgrading</small></span><span class="pr-command__arrow" set:html={svg('arrow')} /></a>
          <div class="pr-command__foot"><span>BUILT FOR THE NEXT KICKOFF</span><span class="pr-command__footmark">↗</span></div>
        </aside>
      </div>
      <a class="pr-scroll-cue" href="#live-desk" aria-label="Scroll to the live desk"><span></span> SCROLL TO CONTROL</a>
    </section>

    <div class="pr-quickbar" aria-label="Quick access">
      <div class="pr-shell pr-quickbar__inner">
        <span class="pr-quickbar__label">QUICK ACCESS</span>
        <a href="/redeem-codes"><span set:html={svg('ticket')} />Redeem codes <span class="pr-quickbar__arrow">↗</span></a>
        <a href="/events"><span set:html={svg('calendar')} />Events <span class="pr-quickbar__arrow">↗</span></a>
        <a href="/trivia/"><span set:html={svg('book')} />Trivia answers <span class="pr-quickbar__arrow">↗</span></a>
        <a href="/leagues/"><span set:html={svg('users')} />Find a league <span class="pr-quickbar__arrow">↗</span></a>
      </div>
    </div>

    <section class="pr-section pr-live-section" id="live-desk" aria-labelledby="pr-live-title">
      <div class="pr-shell">
        <header class="pr-section-head pr-reveal">
          <div><p class="pr-overline">01 / THE LIVE DESK</p><h2 id="pr-live-title">Know the timing.<br /><em>Make the move.</em></h2></div>
          <p class="pr-section-intro">A real-time snapshot built from FCMOBILETOOLS data. No fake urgency, no guessed status.</p>
        </header>

        <div class="pr-live-grid">
          <article class="pr-live-card pr-reset-card pr-reveal" style="--stagger: 0ms">
            <div class="pr-card-top"><span class="pr-label"><span set:html={svg('clock')} /> DAILY RESET</span><span class="pr-status">UTC / LIVE</span></div>
            <p class="pr-card-caption">NEXT RESET IN</p>
            <div class="pr-countdown" role="timer" aria-label="Time until the next daily reset"><span data-pr-hours>--</span><i>:</i><span data-pr-minutes>--</span><i>:</i><span data-pr-seconds>--</span></div>
            <div class="pr-countdown-track"><i data-pr-progress></i></div>
            <div class="pr-reset-foot"><span>YOUR LOCAL RESET <b data-pr-local>--:--</b></span><span>{resetLabel}</span></div>
          </article>

          <article class="pr-live-card pr-event-card pr-reveal" style="--stagger: 90ms">
            <div class="pr-card-top"><span class="pr-label"><span set:html={svg('calendar')} /> EVENT RADAR</span><a href="/events" class="pr-mini-link">Open event hub <span>↗</span></a></div>
            {radarRows.length ? (
              <ul class="pr-event-list">
                {radarRows.map((row, index) => (
                  <li><a href="/events" class:list={['pr-event-row', row.start <= buildTime && 'is-live']} data-pr-event data-ts={row.start} data-kind={row.kind}>
                    <span class="pr-event-index">0{index + 1}</span><span class="pr-event-name"><b>{row.title}</b><small>{row.start <= buildTime ? 'In progress' : dayMonth(row.start)}</small></span><span class="pr-event-time" data-pr-event-time>{dayMonth(row.start)}</span>
                  </a></li>
                ))}
              </ul>
            ) : (
              <div class="pr-empty-event"><span class="pr-empty-event__icon" set:html={svg('calendar')} /><b>Event timing is quiet.</b><span>Open the events hub for the current schedule.</span></div>
            )}
          </article>

          <article class="pr-live-card pr-code-card pr-reveal" style="--stagger: 180ms" data-pr-code-card data-expires={featuredCode?.expiryDate ? Date.parse(featuredCode.expiryDate + 'T23:59:59Z') : ''}>
            <div class="pr-card-top"><span class="pr-label"><span set:html={svg('ticket')} /> REDEEM INTEL</span><span class:list={['pr-code-status', featuredCode ? 'is-active' : ''] } data-pr-code-status>{featuredCode ? 'ACTIVE' : 'CHECK STATUS'}</span></div>
            {featuredCode ? (
              <>
                <p class="pr-code-caption">LATEST LISTED ACTIVE CODE</p>
                <button type="button" class="pr-code-copy" data-pr-copy={featuredCode.code} aria-label={'Copy redeem code ' + featuredCode.code}>
                  <strong>{featuredCode.code}</strong><span class="pr-code-copy__button"><span set:html={svg('copy')} /><em data-pr-copy-label>Copy</em></span>
                </button>
                <p class="pr-code-reward">{featuredCode.reward}</p>
                <p class="pr-code-meta">{featuredCode.region || 'Global'}{featuredCode.lastVerified ? ' · verified ' + dayMonth(featuredCode.lastVerified) : ''}</p>
              </>
            ) : (
              <>
                <p class="pr-code-caption">NO ACTIVE CODE FOUND</p>
                <div class="pr-code-none"><b>{lastCode ? lastCode.code : 'Stay in the loop'}</b><span>{lastCode ? 'Latest recorded code is no longer active.' : 'New code status appears on the codes page.'}</span></div>
                <p class="pr-code-meta">{lastChecked ? 'Last code check: ' + dayMonth(lastChecked) : 'Code status is checked regularly'}</p>
              </>
            )}
            <a class="pr-code-link" href="/redeem-codes">See all redeem codes <span>↗</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="pr-section pr-toolkit" id="toolkit" aria-labelledby="pr-toolkit-title">
      <div class="pr-shell">
        <header class="pr-section-head pr-reveal">
          <div><p class="pr-overline">02 / YOUR TOOLKIT</p><h2 id="pr-toolkit-title">Less guesswork.<br /><em>Better decisions.</em></h2></div>
          <p class="pr-section-intro">Built for the decisions FC Mobile keeps putting in front of you. Pick a lane; get straight to the tool.</p>
        </header>

        <div class="pr-filterbar pr-reveal" role="group" aria-label="Filter tools">
          <button class="is-selected" type="button" data-pr-filter="all" aria-pressed="true">All tools <span>09</span></button>
          <button type="button" data-pr-filter="squad" aria-pressed="false">Squad building</button>
          <button type="button" data-pr-filter="market" aria-pressed="false">Market</button>
          <button type="button" data-pr-filter="events" aria-pressed="false">Events & trivia</button>
          <button type="button" data-pr-filter="community" aria-pressed="false">Community</button>
        </div>

        <div class="pr-tools-grid" data-pr-tools>
          <a class="pr-tool pr-tool--feature pr-reveal" href="/redeem-codes" data-pr-tool data-category="events" style="--tone: #6EF0C2; --tone-rgb: 110,240,194">
            <span class="pr-tool__flare" aria-hidden="true"></span><span class="pr-tool__top"><span class="pr-tool__icon" set:html={svg('ticket')} /><span class="pr-tool__category">REWARDS / 01</span><span class="pr-tool__corner" set:html={svg('arrow')} /></span>
            <span class="pr-tool__main"><span class="pr-tool__tag"><i></i> CODE TRACKER</span><h3>Redeem Codes</h3><p>Find the latest rewards, check their status, then copy a code in one click.</p></span>
            <span class="pr-tool__bottom"><b>{liveCodes.length} active listed</b><span>Open code desk <span>↗</span></span></span>
          </a>
          {tools.map((tool, index) => (
            <a class:list={['pr-tool', 'pr-reveal']} href={tool.href} data-pr-tool data-category={tool.category} style={'--tone: ' + ({ cyan: '#4CC9FF', mint: '#6EF0C2', violet: '#A99BFF', amber: '#FFC36B' }[tool.tone]) + '; --tone-rgb: ' + ({ cyan: '76,201,255', mint: '110,240,194', violet: '169,155,255', amber: '255,195,107' }[tool.tone]) + '; --stagger: ' + ((index % 4) * 65) + 'ms'}>
              <span class="pr-tool__top"><span class="pr-tool__icon" set:html={svg(tool.icon)} /><span class="pr-tool__category">{tool.label}</span><span class="pr-tool__corner" set:html={svg('arrow')} /></span>
              <span class="pr-tool__main"><h3>{tool.name}</h3><p>{tool.text}</p></span>
              <span class="pr-tool__bottom"><b>{tool.category === 'squad' ? 'SQUAD' : tool.category === 'market' ? 'MARKET' : tool.category === 'community' ? 'COMMUNITY' : 'EVENTS'}</b><span>Open tool <span>↗</span></span></span>
            </a>
          ))}
        </div>
        <p class="pr-filter-empty" data-pr-filter-empty hidden>No tools in this category yet. Choose another filter.</p>
      </div>
    </section>

    <section class="pr-season-section" aria-labelledby="pr-season-title">
      <div class="pr-shell">
        <div class="pr-season pr-reveal">
          <div class="pr-season__backdrop" aria-hidden="true"></div>
          <img class="pr-season__art" src="/assets/images/hero-striker.webp" alt="" width="900" height="711" loading="lazy" decoding="async" />
          <div class="pr-season__content">
            <p class="pr-overline">03 / SEASON BRIEFING</p><p class="pr-season__eyebrow"><span class="pr-live-dot"></span> THIRD ANNIVERSARY SEASON</p>
            <h2 id="pr-season-title">FC MOBILE 27.<br /><em>Get up to speed.</em></h2>
            <p class="pr-season__text">The season brings Game Plans, Gauntlet Mode and PlayStyles into the mix. Use the update hub for the feature guide, practical details and installation information.</p>
            <div class="pr-season__chips"><span>GAME PLANS</span><span>GAUNTLET MODE</span><span>PLAYSTYLES</span></div>
            <div class="pr-season__actions"><a class="pr-button pr-button--primary" href={seasonHref}>Read the season guide <span set:html={svg('arrow')} /></a><a class="pr-text-link" href="/fc-mobile-27">Open update hub <span>↗</span></a></div>
          </div>
          {gift && <aside class="pr-gift"><span class="pr-gift__heading"><span set:html={svg('star')} /> {gift.title}</span><ul>{(gift.items ?? []).map((item) => <li><span set:html={svg('check')} />{item}</li>)}</ul><small>{gift.note}</small></aside>}
          <span class="pr-season__stamp" aria-hidden="true">S27</span>
        </div>
      </div>
    </section>

    <section class="pr-section pr-editorial" aria-labelledby="pr-editorial-title">
      <div class="pr-shell">
        <header class="pr-section-head pr-reveal">
          <div><p class="pr-overline">04 / THE EDITORIAL DESK</p><h2 id="pr-editorial-title">Know what changed.<br /><em>Skip the noise.</em></h2></div>
          <a class="pr-text-link" href="/blog">All articles <span>↗</span></a>
        </header>
        {latest.length ? (
          <div class="pr-news-grid">
            <a class="pr-news-feature pr-reveal" href={latest[0].href} style={'--article-accent: ' + (latest[0].section?.accent || '#4CC9FF')}>
              <span class="pr-news-feature__media">
                {latest[0].cover ? <img src={img(latest[0].cover, 1000)} alt={latest[0].imageAlt || ''} width="1000" height="563" loading="lazy" decoding="async" /> : <span class="pr-news-placeholder">FCM<span>TOOLS / NEWS</span></span>}
                <span class="pr-news-feature__tag">LATEST BRIEFING</span><span class="pr-news-feature__read">Read story ↗</span>
              </span>
              <span class="pr-news-feature__body">
                <span class="pr-news-meta"><b>{latest[0].section?.label || 'FC Mobile'}</b>{latest[0].date && <time datetime={iso(latest[0].date)}>{fmtDate(latest[0].date, 'medium')}</time>}{latest[0].minutes ? <span>{latest[0].minutes} MIN READ</span> : null}</span>
                <h3>{latest[0].title}</h3><p>{latest[0].excerpt}</p>
              </span>
            </a>
            <div class="pr-news-list">
              {latest.slice(1).map((post, index) => (
                <a class="pr-news-item pr-reveal" href={post.href} style={'--article-accent: ' + (post.section?.accent || '#4CC9FF') + '; --stagger: ' + (index * 80) + 'ms'}>
                  <span class="pr-news-item__thumb">{post.cover ? <img src={img(post.cover, 360)} alt="" width="360" height="240" loading="lazy" decoding="async" /> : <span>FCM</span>}</span>
