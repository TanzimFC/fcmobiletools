---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const latestArticles=(await getCollection('blog',({data})=>data.status==='published'&&!data.draft)).sort((a,b)=>(b.data.publishedAt?.valueOf()??0)-(a.data.publishedAt?.valueOf()??0)).slice(0,4);
const readingTime=post=>post.data.readingTime??Math.max(1,Math.ceil((post.body?.split(/\\s+/).filter(Boolean).length??0)/220));
---
<BaseLayout title="FC Mobile Tools" description="FC Mobile tools, redeem codes, live reset tracking, calculators and guides from FCMOBILETOOLS">
<main class="home">
<section class="home-hero"><div class="hero-bg"></div><div class="hero-shade"></div><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">FCMOBILETOOLS <span>·</span> PLAYER COMMAND CENTER</p><h1>Everything useful<br /><em>starts here</em></h1><p>Check what is live, see the next reset in your local time, redeem codes and use the calculators you actually need</p><div class="hero-actions"><a class="btn primary" href="/reset-center">Open Live Center <span>↗</span></a><a class="btn" href="/redeem-codes">Redeem Codes <span>↗</span></a></div><div class="hero-points"><span><i></i> UTC synced</span><span><i></i> Local time aware</span><span><i></i> Live updates</span></div></div></div></section>
<section class="wrap live-section"><div class="section-head"><div><p class="eyebrow">01 / LIVE</p><h2>Know what happens <em>next</em></h2></div><p>One place for the daily reset, Anniversary Event and Division Rivals cycle</p></div><a class="live-panel" href="/reset-center"><div><span class="live-mark"><i></i> LIVE CENTER</span><h3>Daily reset · Anniversary Event · Division Rivals</h3><p>Open the unified countdown center with UTC reference, automatic local-time conversion and animated progress</p></div><b>OPEN CENTER ↗</b></a></section>
<section class="wrap tools-section"><div class="section-head"><div><p class="eyebrow">02 / TOOLS</p><h2>Built for the <em>actual grind</em></h2></div><p>Fast utilities without pushing secondary tools into the spotlight</p></div><div class="tool-grid">
<a class="tool-card featured cyan" href="/redeem-codes"><span>01 / REDEEM</span><h3>Redeem Codes</h3><p>Check current codes and move straight to redemption</p><strong>CHECK CODES →</strong></a>
<a class="tool-card featured" href="/team-ovr"><span>02 / CALCULATOR</span><h3>Team OVR</h3><p>Calculate squad OVR from player ratings and upgrades</p><strong>CALCULATE →</strong></a>
<a class="tool-card" href="/training-calculator"><span>03</span><h3>Training Calculator</h3><p>Plan XP, fodder, levels and excess XP</p><strong>OPEN →</strong></a>
<a class="tool-card" href="/rank-up-calculator"><span>04</span><h3>Rank Up Calculator</h3><p>Calculate Rank Up Points, OVR gain and Skill Points</p><strong>OPEN →</strong></a>
<a class="tool-card" href="/football-centre"><span>05</span><h3>Football Centre</h3><p>Track matches, points, rewards and event resources</p><strong>OPEN →</strong></a>
<a class="tool-card" href="/a-nations-story"><span>06</span><h3>A Nation's Story</h3><p>Find event answers without digging</p><strong>FIND ANSWERS →</strong></a>
</div></section>
<section class="wrap latest-section"><div class="section-head"><div><p class="eyebrow">03 / LATEST</p><h2>Fresh <em>guides</em></h2></div><a class="section-link" href="/blog">VIEW ALL →</a></div>{latestArticles.length?<div class="article-grid">{latestArticles.map(post=><a class="article-card" href={`/blog/${post.slug}/`}>{post.data.image?<img src={post.data.image} alt="" loading="lazy" />:<div class="placeholder">FC</div>}<div><div class="meta"><span>{post.data.category}</span><span>{readingTime(post)} MIN</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt??post.data.description}</p><strong>READ ARTICLE →</strong></div></a>)}</div>:<div class="empty">No published articles yet</div>}</section>
<section class="wrap closing"><div><p class="eyebrow">04 / FCMOBILETOOLS</p><h2>Less searching<br /><em>more playing</em></h2></div><a href="/reset-center">Make the Live Center your starting point <span>↗</span></a></section>
</main>
</BaseLayout>
<style>
.home{background:var(--bg);color:var(--text);overflow:hidden}.home .wrap{width:min(1180px,calc(100% - 36px));margin:auto}.home .eyebrow{margin:0;color:var(--blue);font:900 9px var(--mono);letter-spacing:.16em}.home-hero{position:relative;min-height:670px;border-bottom:1px solid var(--border);overflow:hidden;background:#060d13}.hero-bg{position:absolute;inset:0;background:url('/assets/images/herobeli.png') center/cover no-repeat;opacity:.7}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#05090df7 0%,#05090dd2 43%,#05090d66 76%,#05090dc0 100%),linear-gradient(0deg,#05090df4 0%,transparent 50%,#05090d55 100%)}.hero-inner{position:relative;z-index:2;min-height:670px;display:flex;align-items:center;padding:90px 0 60px}.hero-copy{max-width:760px}.hero-copy .eyebrow span{color:var(--muted);margin:0 5px}.hero-copy h1{font-size:clamp(56px,8vw,98px);line-height:.86;letter-spacing:-.07em;margin:19px 0}.hero-copy h1 em,.section-head h2 em,.closing h2 em{font-style:normal;color:var(--blue)}.hero-copy>p{max-width:680px;color:#a7b7c1;font-size:14px;line-height:1.8;margin:0}.hero-actions{display:flex;gap:9px;margin-top:30px}.btn{display:inline-flex;gap:10px;align-items:center;padding:14px 17px;border:1px solid #314250;border-radius:9px;background:#091017b8;color:#eef7fa;text-decoration:none;font:900 8px var(--mono);transition:.2s}.btn.primary{background:var(--blue);border-color:var(--blue);color:#061018}.btn:hover{transform:translateY(-2px);border-color:var(--blue)}.hero-points{display:flex;gap:15px;margin-top:22px;color:#728596;font:800 7px var(--mono);letter-spacing:.04em}.hero-points i{display:inline-block;width:5px;height:5px;border-radius:50%;background:#63e3a1;margin-right:5px}.live-section,.tools-section,.latest-section{padding:80px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:22px}.section-head h2{font-size:clamp(32px,4.5vw,53px);line-height:.94;letter-spacing:-.06em;margin:10px 0 0}.section-head>p{max-width:370px;color:var(--muted);font-size:10px;line-height:1.7;margin:0}.live-panel{display:flex;justify-content:space-between;align-items:center;gap:25px;padding:26px;border:1px solid #1e394a;border-radius:17px;background:linear-gradient(120deg,#091721,#081117);color:var(--text);text-decoration:none;transition:.25s}.live-panel:hover{transform:translateY(-4px);border-color:#3a6b84;box-shadow:0 24px 55px #0007}.live-mark{display:inline-flex;align-items:center;gap:7px;color:#72e3a2;font:900 8px var(--mono);letter-spacing:.13em}.live-mark i{width:6px;height:6px;border-radius:50%;background:#62e3a1;box-shadow:0 0 0 5px #62e3a111;animation:blink 1.4s infinite}.live-panel h3{font-size:23px;letter-spacing:-.035em;margin:13px 0 7px}.live-panel p{margin:0;color:#7f91a2;font-size:10px}.live-panel>b{color:var(--blue);font:900 8px var(--mono);white-space:nowrap}.tool-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:11px}.tool-card{grid-column:span 2;position:relative;min-height:190px;padding:21px;border:1px solid var(--border);border-radius:15px;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.tool-card.featured{grid-column:span 3;min-height:235px;background:linear-gradient(145deg,#0c1c27,#081219)}.tool-card.cyan{background:linear-gradient(145deg,#0d1d25,#081219)}.tool-card:hover{transform:translateY(-4px);border-color:#36596a;box-shadow:0 20px 45px #0005}.tool-card>span{font:900 8px var(--mono);letter-spacing:.13em;color:var(--blue)}.tool-card h3{font-size:20px;letter-spacing:-.03em;margin:37px 0 8px}.tool-card.featured h3{font-size:27px;margin-top:48px}.tool-card p{max-width:440px;color:var(--muted);font-size:10px;line-height:1.7;margin:0}.tool-card strong{position:absolute;left:21px;bottom:19px;color:var(--blue);font:900 8px var(--mono)}.latest-section{border-bottom:1px solid var(--border)}.section-link{color:var(--blue);text-decoration:none;font:900 8px var(--mono)}.article-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.article-card{display:grid;grid-template-columns:170px 1fr;min-height:175px;overflow:hidden;border:1px solid var(--border);border-radius:13px;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.article-card:hover{transform:translateY(-3px);border-color:#36596a}.article-card img,.placeholder{width:100%;height:100%;min-height:175px;object-fit:cover}.placeholder{display:grid;place-items:center;background:#0b1c25;color:var(--blue);font:900 34px var(--mono)}.article-card>div:last-child{padding:17px}.meta{display:flex;gap:10px;color:var(--blue);font:900 7px var(--mono)}.meta span:last-child{color:#6e8490}.article-card h3{font-size:16px;line-height:1.1;margin:10px 0 7px}.article-card p{color:var(--muted);font-size:9px;line-height:1.6;margin:0}.article-card strong{display:block;color:var(--blue);font:900 7px var(--mono);margin-top:12px}.empty{padding:25px;border:1px dashed #263744;border-radius:12px;color:var(--muted);font-size:10px}.closing{display:flex;justify-content:space-between;align-items:end;gap:40px;padding:80px 0 100px}.closing h2{font-size:clamp(42px,5vw,64px);line-height:.9;letter-spacing:-.065em;margin:11px 0}.closing>a{padding:15px 17px;border:1px solid #244354;border-radius:10px;background:#09151c;color:#9fdff2;text-decoration:none;font:800 8px var(--mono)}.closing>a span{margin-left:15px}@keyframes blink{50%{opacity:.35;transform:scale(.8)}}@media(max-width:850px){.tool-grid{grid-template-columns:1fr 1fr}.tool-card,.tool-card.featured{grid-column:span 1}.tool-card.featured{min-height:220px}.article-grid{grid-template-columns:1fr}.closing{align-items:start;flex-direction:column}}@media(max-width:560px){.home .wrap{width:calc(100% - 28px)}.home-hero,.hero-inner{min-height:620px}.hero-inner{padding:75px 0 40px}.hero-copy h1{font-size:clamp(49px,14vw,72px)}.tool-grid{grid-template-columns:1fr}.tool-card,.tool-card.featured{min-height:200px}.section-head{align-items:start;flex-direction:column;gap:12px}.live-panel{align-items:start;flex-direction:column}.hero-points{flex-wrap:wrap}.article-card{grid-template-columns:110px 1fr}}
</style>