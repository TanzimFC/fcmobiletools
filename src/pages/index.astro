  .pr-news-all { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 16px 18px; margin-top: auto; border: 1px solid rgba(76,201,255,.14); border-radius: 15px; background: linear-gradient(105deg,rgba(76,201,255,.07),rgba(76,201,255,.015)); }.pr-news-all b,.pr-news-all small { display: block; }.pr-news-all b { color: #d6e6ee; font: 800 9px/1 var(--pr-body); letter-spacing: .1em; }.pr-news-all small { margin-top: 6px; color: #7e95a5; font-size: 10px; }.pr-news-all > span:last-child { color: var(--pr-cyan); font-size: 10px; font-weight: 750; white-space: nowrap; }.pr-empty-news { padding: 35px; border: 1px dashed var(--pr-line); border-radius: 18px; color: var(--pr-muted); }

  /* Creator + community */
