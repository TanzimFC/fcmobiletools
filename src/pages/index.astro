  .hx-event-card__dates { margin-top: auto; padding-top: 5px; color: var(--muted-strong); font-size: 12px; font-weight: 700; }
  .hx-event-card__copy em { display: flex; align-items: center; gap: 7px; margin-top: 5px; color: var(--hx-event-accent); font: 700 12px/1 var(--font-body); font-style: normal; }
  .hx-event-card__copy em span { transition: transform .2s; }
  .hx-event-card:hover .hx-event-card__copy em span { transform: translate(2px,-2px); }

  /* Beginner path */
  .hx-start { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .hx-start a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); color: inherit; text-decoration: none; transition: border-color .15s, background .15s; }
  .hx-start a:hover { border-color: var(--primary); background: var(--surface2); }
  .hx-start__n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); font: 700 16px/1 var(--font-display); color: var(--primary); }
  .hx-start__text b { display: block; margin-bottom: 4px; font: 700 19px/1.25 var(--font-display); letter-spacing: -.01em; }
  .hx-start__text small { display: block; font-size: 15px; line-height: 1.45; color: var(--muted); }
  .hx-start__go { color: var(--dim); font-size: 20px; display: inline-flex; transition: transform .15s, color .15s; }
  .hx-start a:hover .hx-start__go { color: var(--primary); transform: translate(2px, -2px); }

  /* Tools by purpose */
  .hx-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .hx-group h3 { margin: 0 0 6px; font-size: 21px; }
  .hx-group > p { margin: 0 0 18px; font-size: 15px; color: var(--muted); }
  .hx-group ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .hx-group a { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; padding: 15px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .hx-group a b { font: 600 16px/1.3 var(--font-body); }
  .hx-group a small { grid-column: 1; margin-top: 2px; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .hx-group__go { grid-column: 2; grid-row: 1 / 3; align-self: center; display: inline-flex; color: var(--dim); transition: transform .15s, color .15s; }
  .hx-group a:hover b { color: var(--primary); }
  .hx-group a:hover .hx-group__go { color: var(--primary); transform: translate(2px, -2px); }

  /* Season 27 */
  .hx-season { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); overflow: hidden; }
  .hx-season__art { width: 100%; height: 100%; min-height: 340px; object-fit: cover; object-position: center top; background: #0a141d; }
  .hx-season__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: clamp(26px, 4vw, 48px); }
  .hx-season__copy h2, .hx-season__copy p { margin: 0; }
  .hx-season__copy p { color: var(--muted); font-size: 17px; max-width: 38em; }
  .hx-season .hx-actions { margin-top: 6px; }
  .hx-gift { width: 100%; padding: 16px 18px; border: 1px solid rgba(245, 196, 81, .3); border-radius: var(--r-md); background: rgba(245, 196, 81, .05); }
  .hx-gift .hx-label { color: var(--reward); font-weight: 600; font-size: 14px; }
  .hx-gift .hx-label .hx-i { color: var(--reward); }
  .hx-gift ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .hx-gift li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--muted-strong); }
  .hx-gift li .hx-i { margin-top: 4px; width: 14px; height: 14px; color: var(--success); }
  .hx-gift small { display: block; margin-top: 12px; color: var(--dim); font-size: 13px; }

  /* Articles */
  .hx-news { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 36px; }
  .hx-feature { display: flex; flex-direction: column; gap: 18px; color: inherit; text-decoration: none; }
  .hx-feature__media { display: block; aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: var(--surface2); }
  .hx-feature__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--hx-ease); }
  .hx-feature:hover img { transform: scale(1.02); }
  .hx-feature__ph { display: grid; place-items: center; height: 100%; font: 700 32px var(--font-display); color: var(--dim); }
  .hx-feature h3 { margin: 10px 0 8px; font-size: clamp(22px, 2.4vw, 30px); }
  .hx-feature:hover h3 { color: var(--primary); }
  .hx-feature p { margin: 0; color: var(--muted); }
  .hx-meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font: 500 13px/1.3 var(--font-body); color: var(--dim); }
  .hx-meta b { color: var(--muted-strong); font-weight: 600; }
  .hx-list { list-style: none; margin: 0; padding: 0; align-content: start; }
  .hx-list li:first-child .hx-item { padding-top: 0; }
  .hx-item { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .hx-item__media { display: block; aspect-ratio: 3 / 2; border-radius: var(--r-sm); overflow: hidden; background: var(--surface2); }
  .hx-item__media img { width: 100%; height: 100%; object-fit: cover; }
  .hx-item h3 { margin: 8px 0 0; font: 600 16px/1.4 var(--font-body); letter-spacing: 0; }
  .hx-item:hover h3 { color: var(--primary); }
  .hx-empty { color: var(--muted); }

  /* FAQ */
  .hx-faq { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); }
  .hx-faq__lead h2 { margin: 0 0 12px; }
  .hx-faq__lead p { margin: 0 0 18px; color: var(--muted); font-size: 17px; }
  .hx-faq__list details { border-top: 1px solid var(--line); }
  .hx-faq__list details:last-child { border-bottom: 1px solid var(--line); }
  .hx-faq__list summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; font: 600 17px/1.4 var(--font-body); cursor: pointer; list-style: none; }
  .hx-faq__list summary::-webkit-details-marker { display: none; }
  .hx-faq__list summary i { position: relative; flex: none; width: 14px; height: 14px; }
  .hx-faq__list summary i::before, .hx-faq__list summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 2px; background: var(--muted); border-radius: 2px; transition: transform .2s; }
  .hx-faq__list summary i::after { transform: rotate(90deg); }
  .hx-faq__list details[open] summary i::after { transform: rotate(0); }
  .hx-faq__list details p { margin: 0 0 20px; max-width: 60ch; color: var(--muted); }

  /* Creator */
  .hx-cta { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 28px; padding: 32px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .hx-cta__logo { width: 72px; height: auto; border-radius: var(--r-md); }
  .hx-cta__copy h2 { margin: 0 0 8px; font-size: clamp(24px, 3vw, 32px); }
  .hx-cta__copy p { margin: 0; color: var(--muted); max-width: 40em; }
  .hx-cta__links { display: flex; flex-wrap: wrap; gap: 10px; }

  /* Responsive */
  @media (max-width: 960px) {
    .hx-events__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hx-board__grid { grid-template-columns: 1fr; }
    .hx-cell + .hx-cell { border-left: 0; border-top: 1px solid var(--line); }
    .hx-groups { grid-template-columns: 1fr; gap: 36px; }
    .hx-season, .hx-news, .hx-faq { grid-template-columns: 1fr; }
    .hx-season__art { min-height: 0; aspect-ratio: 16 / 9; }
    .hx-cta { grid-template-columns: 1fr; text-align: left; }
    .hx-cta__logo { width: 56px; }
  }
  @media (max-width: 700px) {
    .hx-hero { min-height: 0; padding: 120px 0 120px; align-items: flex-start; }
    .hx-hero__img img { object-position: 62% 40%; }
    .hx-hero__shade { background: linear-gradient(180deg, rgba(6, 17, 26, .86) 0%, rgba(6, 17, 26, .62) 40%, rgba(6, 17, 26, .3) 64%, var(--bg) 100%); }
    .hx-start { grid-template-columns: 1fr; }
    .hx-start a { padding: 18px; gap: 14px; }
    .hx-item { grid-template-columns: 96px minmax(0, 1fr); }
    .hx-board { margin-top: -56px; }
  }
  @media (max-width: 520px) {
    .hx-events__grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx-event-card, .hx-event-card__media img, .hx-event-card__copy em span { transition: none; }
    .hx-event-card:hover { transform: none; }
    .hx-event-card:hover .hx-event-card__media img { transform: none; }
  }
  
  /* ===================== v3 premium layer ===================== */

  /* Hero: one-time entrance, then still. transform + opacity only. */
  .hx-h1 { font-size: clamp(38px, 5.4vw, 74px); max-width: 13em; line-height: 1; }
  .hx-hero__inner > * { animation: hx-rise .8s var(--ease) both; }
  .hx-hero__inner > :nth-child(1) { animation-delay: .04s; }
  .hx-hero__inner > :nth-child(2) { animation-delay: .12s; }
  .hx-hero__inner > :nth-child(3) { animation-delay: .2s; }
  .hx-hero__inner > :nth-child(4) { animation-delay: .28s; }
  .hx-hero__inner > :nth-child(5) { animation-delay: .36s; }
  .hx-hero__inner > :nth-child(6) { animation-delay: .44s; }
  .hx-hero__img img { animation: hx-settle 1.8s var(--ease) both; }
  @keyframes hx-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes hx-settle { from { transform: scale(1.05); } to { transform: none; } }
  .hx-dot { background: var(--pitch); box-shadow: 0 0 0 4px rgba(61, 220, 151, .18); }
  .hx-status { padding: 8px 14px 8px 12px; border: 1px solid rgba(61, 220, 151, .3); border-radius: 999px; background: rgba(61, 220, 151, .09); color: #c9f6df; }
  .hx-btn { transition: transform .25s var(--ease), background .2s, border-color .2s, box-shadow .3s var(--ease); }
  .hx-btn:hover { transform: translateY(-2px); }
  .hx-btn--quiet { border-color: transparent; background: transparent; color: var(--muted-strong); text-decoration: underline; text-decoration-color: rgba(255, 255, 255, .25); text-underline-offset: 5px; padding-inline: 10px; }
  .hx-btn--quiet:hover { background: transparent; color: var(--text); text-decoration-color: var(--primary); }
  .hx-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }
  .hx-jump a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 15px 9px 11px; border: 1px solid var(--line-soft); border-radius: 999px; background: rgba(8, 18, 28, .62); color: var(--muted-strong); font: 600 13.5px/1 var(--font-body); text-decoration: none; transition: transform .25s var(--ease), border-color .2s, background .2s, color .2s; }
  .hx-jump a:hover { transform: translateY(-2px); border-color: rgba(76, 201, 255, .5); background: rgba(76, 201, 255, .1); color: #fff; }
  .hx-jump svg { width: 16px; height: 16px; color: var(--primary); }
  .hx-proof li + li::before { content: "·"; margin-right: 24px; color: var(--dim); }

  /* Live board: scoreboard clock, glowing progress, depth */
  .hx-board__grid { border-color: var(--line-hi); background: linear-gradient(165deg, rgba(23, 44, 66, .95), rgba(9, 20, 31, .98)); box-shadow: var(--card-edge), 0 44px 90px -44px rgba(0, 0, 0, .95), 0 0 90px -54px rgba(76, 201, 255, .7); }
  .hx-cell + .hx-cell { border-left-color: var(--line-soft); }
  .hx-clock { gap: 6px; }
  .hx-clock span { display: inline-grid; place-items: center; min-width: 1.55em; padding: .1em .18em; border: 1px solid var(--line-soft); border-radius: 12px; background: rgba(255, 255, 255, .05); box-shadow: inset 0 -12px 18px -14px rgba(0, 0, 0, .7); }
  .hx-clock i { color: var(--primary); opacity: .7; }
  .hx-bar { height: 5px; background: rgba(255, 255, 255, .07); }
  .hx-bar span { background: linear-gradient(90deg, var(--primary), var(--pitch)); box-shadow: 0 0 14px rgba(76, 201, 255, .5); }
  .hx-row { transition: transform .25s var(--ease); }
  .hx-row:hover { transform: translateX(3px); }
  .hx-row.is-live .hx-row__dot { background: var(--pitch); box-shadow: 0 0 0 4px rgba(61, 220, 151, .16); }
  .hx-code { background: radial-gradient(120% 100% at 0% 0%, rgba(245, 196, 81, .09), transparent 60%); }
  .hx-copy { border-color: rgba(245, 196, 81, .4); background: rgba(245, 196, 81, .06); transition: border-color .2s, transform .25s var(--ease), background .2s; }
  .hx-copy:hover { border-color: var(--reward); background: rgba(245, 196, 81, .11); transform: translateY(-1px); }

  /* Section rhythm */
  .hx-section__head h2 { position: relative; padding-top: 18px; }
  .hx-section__head h2::before { content: ""; position: absolute; left: 0; top: 0; width: 44px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--primary), var(--pitch)); }

  /* Beginner goals */
  .hx-recent { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: 0 0 18px; }
  .hx-recent[hidden] { display: none; }
  .hx-recent__label { color: var(--muted); font: 600 14px/1 var(--font-body); }
  .hx-recent__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .hx-recent__list a { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px 7px 8px; border: 1px solid var(--line-soft); border-radius: 999px; background: rgba(255, 255, 255, .03); color: var(--text); font: 600 14px/1 var(--font-body); text-decoration: none; transition: transform .25s var(--ease), border-color .2s, background .2s; }
  .hx-recent__list a:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--ac) 55%, transparent); background: color-mix(in srgb, var(--ac) 10%, transparent); }
  .hx-recent__ico { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; color: var(--ac); background: color-mix(in srgb, var(--ac) 16%, transparent); }
  .hx-recent__ico svg { width: 14px; height: 14px; }
  .hx-goals { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .hx-goal { position: relative; display: flex; flex-direction: column; gap: 8px; min-height: 236px; padding: 22px; border: 1px solid var(--line-soft); border-radius: var(--r-lg); overflow: hidden; color: inherit; text-decoration: none; background: radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--ac) 16%, transparent), transparent 62%), var(--card-fill); box-shadow: var(--card-edge), var(--shadow-sm); transition: transform .35s var(--ease), border-color .25s, box-shadow .35s var(--ease); }
  .hx-goal:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--ac) 55%, transparent); box-shadow: var(--card-edge), var(--shadow-md), 0 0 54px -28px var(--ac); }
  .hx-goal__ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; color: var(--ac); background: color-mix(in srgb, var(--ac) 15%, transparent); border: 1px solid color-mix(in srgb, var(--ac) 32%, transparent); }
  .hx-goal__ico svg { width: 23px; height: 23px; }
  .hx-goal b { margin-top: 10px; font: 700 19px/1.2 var(--font-display); letter-spacing: -.02em; }
  .hx-goal small { color: var(--muted); font: 500 14px/1.5 var(--font-body); }
  .hx-goal__go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 10px; color: var(--ac); font: 700 13.5px/1.25 var(--font-body); }
  .hx-goal__go .hx-i { width: 15px; height: 15px; transition: transform .3s var(--ease); }
  .hx-goal:hover .hx-goal__go .hx-i { transform: translate(3px, -3px); }

  /* Tools bento */
  .hx-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(170px, auto); gap: 14px; }
  .hx-tile { position: relative; display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 20px; border: 1px solid var(--line-soft); border-radius: var(--r-lg); overflow: hidden; color: inherit; text-decoration: none; background: radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--ac, #4cc9ff) 13%, transparent), transparent 62%), var(--card-fill); box-shadow: var(--card-edge), var(--shadow-sm); transition: transform .35s var(--ease), border-color .25s, box-shadow .35s var(--ease); }
  .hx-tile:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--ac, #4cc9ff) 55%, transparent); box-shadow: var(--card-edge), var(--shadow-md), 0 0 54px -28px var(--ac, #4cc9ff); }
  .hx-tile__ico { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 10px; border-radius: 12px; color: var(--ac); background: color-mix(in srgb, var(--ac) 15%, transparent); border: 1px solid color-mix(in srgb, var(--ac) 32%, transparent); transition: transform .35s var(--ease); }
  .hx-tile__ico svg { width: 22px; height: 22px; }
  .hx-tile:hover .hx-tile__ico { transform: scale(1.08) rotate(-4deg); }
  .hx-tile b { font: 700 17px/1.25 var(--font-display); letter-spacing: -.015em; }
  .hx-tile small { color: var(--muted); font: 500 14px/1.45 var(--font-body); }
  .hx-tile__arrow { position: absolute; top: 18px; right: 18px; color: var(--dim); transition: color .2s, transform .3s var(--ease); }
  .hx-tile__arrow .hx-i, .hx-tile__go .hx-i { width: 18px; height: 18px; }
  .hx-tile:hover .hx-tile__arrow { color: var(--ac); transform: translate(3px, -3px); }
  .hx-tile__go { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 12px; color: var(--ac, var(--primary)); font: 700 14px/1 var(--font-body); }
  .hx-tag { align-self: flex-start; padding: 4px 9px; border: 1px solid rgba(245, 196, 81, .3); border-radius: 999px; background: rgba(245, 196, 81, .14); color: #ffe29a; font: 700 11.5px/1 var(--font-body); }
  .hx-tile--hero { grid-column: span 2; grid-row: span 2; flex-direction: row; gap: 14px; padding: 26px; background: radial-gradient(90% 70% at 100% 100%, rgba(61, 220, 151, .16), transparent 62%), radial-gradient(120% 90% at 0% 0%, rgba(76, 201, 255, .18), transparent 60%), var(--card-fill); }
  .hx-tile__copy { display: flex; flex: 1 1 48%; flex-direction: column; gap: 10px; min-width: 0; }
  .hx-tile--hero b { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.1; letter-spacing: -.03em; }
  .hx-tile--hero small { font-size: 15px; }
  .hx-pitch { position: relative; flex: 0 0 46%; align-self: center; aspect-ratio: 5 / 7; max-height: 100%; margin: 0; border-radius: 14px; overflow: hidden; color: rgba(210, 255, 232, .8); background: repeating-linear-gradient(180deg, #0f4a33 0 9.09%, #0c4230 9.09% 18.18%); box-shadow: inset 0 0 0 1px rgba(94, 214, 160, .25); }
  .hx-pitch svg { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform .8s var(--ease); }
  .hx-tile--hero:hover .hx-pitch svg { transform: scale(1.03); }
  .hx-pitch__chip { fill: #1d4d6e; stroke: rgba(155, 231, 255, .55); stroke-width: .6; }
  .hx-pitch__chip[data-hi='1'] { fill: #9a6516; stroke: rgba(255, 236, 170, .85); }
  .hx-pitch__num { fill: #eaf6ff; font: 700 6.2px var(--font-display); }
  .hx-pitch__cap { position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 7px 10px; border-radius: 8px; background: rgba(4, 12, 18, .78); color: #cfe3ee; font: 600 12px/1.3 var(--font-body); text-align: center; }
  .hx-pitch__cap b { color: #ffe29a; }
  .hx-tile--all { justify-content: center; border-style: dashed; border-color: var(--line-hi); background: rgba(255, 255, 255, .02); box-shadow: none; }
  .hx-tile--all b { font-size: 19px; }

  /* Cards further down the page */
  .hx-season, .hx-cta, .hx-feature, .hx-item { border: 1px solid var(--line-soft); background: var(--card-fill); box-shadow: var(--card-edge), var(--shadow-sm); }
  .hx-season, .hx-cta { border-radius: var(--r-lg); }
  .hx-feature, .hx-item { transition: transform .3s var(--ease), border-color .25s, box-shadow .3s var(--ease); }
  .hx-feature:hover, .hx-item:hover { transform: translateY(-3px); border-color: rgba(76, 201, 255, .35); box-shadow: var(--card-edge), var(--shadow-md); }
  .hx-news { gap: 20px; }
  .hx-feature { gap: 14px; padding: 14px 14px 22px; border-radius: var(--r-lg); }
  .hx-feature__body { padding: 0 8px; }
  .hx-list { display: grid; gap: 12px; }
  .hx-item { padding: 12px; border-radius: var(--r-md); align-items: center; }
  .hx-list li:first-child .hx-item { padding-top: 12px; }
  .hx-faq__list details { border-radius: var(--r-md); transition: border-color .2s, background .2s; }
