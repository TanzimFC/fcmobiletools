  .hx h1, .hx h2, .hx h3 { font-family: var(--display); color: var(--text); font-weight: 700; }
  .hx :focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
  .hx-wrap { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
  .hx-i { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .hx-grad { background: linear-gradient(100deg, #4cc9ff 0%, #6ef0c2 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* ───────── buttons / links ───────── */
  .hx-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; height: 54px; padding: 0 22px; border: 1px solid transparent; border-radius: 16px; font: 700 15px/1 var(--body); white-space: nowrap; transition: transform .25s var(--ease), box-shadow .25s var(--ease), background .25s, border-color .25s; }
  .hx-btn .hx-i { font-size: 18px; transition: transform .25s var(--ease); }
