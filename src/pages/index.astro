---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FC Mobile Tools" description="FC Mobile tools for Team OVR, redeem codes, Football Centre, trivia and guides from TanzimFC.">
  <section class="hero home-hero">
    <div class="wrap hero-content">
      <div class="hero-badge"><span></span> TANZIMFC / FC MOBILE TOOLS</div>
      <p class="eyebrow">YOUR FC MOBILE COMMAND CENTRE</p>
      <h1>Build better.<br /><span>Play smarter.</span></h1>
      <p class="hero-copy">Useful FC Mobile tools without the clutter. Calculate your Team OVR, check redeem codes, track Football Centre progress, test your knowledge and keep up with guides.</p>
      <div class="hero-actions"><a class="btn primary" href="/team-ovr">Open Team OVR</a><a class="btn" href="/redeem-codes">Check Redeem Codes</a></div>
      <div class="hero-stats"><div><b>5</b><span>TOOLS &amp; FEATURES</span></div><div><b>LIVE</b><span>CODE DATABASE</span></div><div><b>FREE</b><span>FOR PLAYERS</span></div></div>
    </div>
  </section>
  <section class="wrap section-block tools-home">
    <div class="section-heading"><div><p class="eyebrow">NEW &amp; USEFUL</p><h2>Tools built for the grind.</h2><p class="section-lede">Start with the tool you need, then come back whenever your squad or event changes.</p></div></div>
    <div class="feature-grid tool-grid">
      <a class="feature-card featured-tool" href="/team-ovr"><span>01 / CALCULATOR</span><h3>Team OVR Calculator</h3><p>Build your squad, add ranks and badges, and see your exact Team OVR update live.</p><strong>BUILD YOUR SQUAD →</strong></a>
      <a class="feature-card featured-tool" href="/redeem-codes"><span>02 / DATABASE</span><h3>Redeem Codes</h3><p>Check active FC Mobile codes, copy them in one tap and go straight to EA's redemption page.</p><strong>CHECK CODES →</strong></a>
      <a class="feature-card" href="/football-centre"><span>03 / TRACKER</span><h3>Football Centre</h3><p>Track matches, points, rewards and event progress from one focused dashboard.</p><strong>OPEN CENTRE →</strong></a>
      <a class="feature-card" href="/trivia"><span>04 / QUIZ</span><h3>Trivia</h3><p>Test your FC Mobile knowledge with questions across nations, days and difficulty.</p><strong>PLAY TRIVIA →</strong></a>
      <a class="feature-card" href="/blog"><span>05 / GUIDES</span><h3>Blog &amp; Guides</h3><p>Event explainers, strategies, analysis and practical tips for making better decisions.</p><strong>READ GUIDES →</strong></a>
    </div>
  </section>
  <section class="home-callout"><div class="wrap callout-inner"><div><p class="eyebrow">START HERE</p><h2>One site. The tools you actually need.</h2><p>Whether you are building a squad or hunting for a working code, TanzimFC keeps the useful stuff close.</p></div><div class="callout-actions"><a class="btn primary" href="/team-ovr">Team OVR</a><a class="btn" href="/redeem-codes">Redeem Codes</a></div></div></section>
  <section class="wrap section-block creator-section" id="creator"><div><p class="eyebrow">THE PROJECT</p><h2>Made for FC Mobile players.</h2><p>FC Mobile Tools is a focused companion site for players who want useful information and practical tools without the noise.</p></div><a class="btn" href="/creator">About TanzimFC →</a></section>
</BaseLayout>
<style>
.hero-badge{display:inline-flex;align-items:center;gap:8px;margin-bottom:18px;padding:7px 10px;border:1px solid #55c7f233;border-radius:999px;background:#55c7f20d;color:#a9dff3;font:800 8px var(--mono);letter-spacing:.08em}.hero-badge span{width:6px;height:6px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px #55c7f21f}.hero-stats{display:flex;margin-top:42px;border-top:1px solid #ffffff18;padding-top:18px;width:min(620px,100%)}.hero-stats div{min-width:150px;padding-right:25px;margin-right:25px;border-right:1px solid #ffffff18}.hero-stats div:last-child{border:0}.hero-stats b,.hero-stats span{display:block}.hero-stats b{font:900 17px var(--mono)}.hero-stats span{font:700 7px var(--mono);letter-spacing:.1em;color:#77889a;margin-top:3px}.section-lede{max-width:620px;color:var(--muted);font-size:12px;margin:9px 0 0;line-height:1.7}.tool-grid{grid-template-columns:repeat(6,1fr)}.tool-grid .feature-card{grid-column:span 2}.tool-grid .featured-tool:nth-child(1),.tool-grid .featured-tool:nth-child(2){grid-column:span 3;min-height:215px}.feature-card strong{display:block;margin-top:20px;color:var(--blue);font:900 8px var(--mono);letter-spacing:.06em}.home-callout{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:linear-gradient(100deg,#0d2634,#091017)}.callout-inner{padding:65px 0;display:flex;align-items:center;justify-content:space-between;gap:30px}.callout-inner h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.045em;line-height:1.05;margin:0}.callout-inner p:last-child{max-width:560px;color:var(--muted);font-size:12px}.callout-actions{display:flex;gap:9px;flex:0 0 auto}
@media(max-width:850px){.tool-grid{grid-template-columns:1fr 1fr}.tool-grid .feature-card,.tool-grid .featured-tool:nth-child(1),.tool-grid .featured-tool:nth-child(2){grid-column:span 1}.tool-grid .featured-tool:nth-child(1),.tool-grid .featured-tool:nth-child(2){min-height:190px}.callout-inner{align-items:flex-start;flex-direction:column}.hero-stats div{min-width:0;flex:1;margin-right:12px;padding-right:12px}}
@media(max-width:560px){.hero-stats{margin-top:30px}.hero-stats b{font-size:14px}.hero-stats span{font-size:6px}.tool-grid{grid-template-columns:1fr}.tool-grid .feature-card,.tool-grid .featured-tool:nth-child(1),.tool-grid .featured-tool:nth-child(2){grid-column:span 1}.callout-actions{width:100%;flex-direction:column}.callout-actions .btn{width:100%}}
</style>
