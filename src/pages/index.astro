---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const latestArticles = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft)).sort((a,b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0)).slice(0, 4);
const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
---
<BaseLayout title="FC Mobile Tools" description="A focused FC Mobile toolkit for redeem codes, Football Centre, Team OVR, A Nation's Story and guides.">
  <main class="home">
    <section class="hero"><div class="wrap hero-copy"><p class="eyebrow">TANZIMFC / FC MOBILE TOOLS</p><p class="kicker">THE FC MOBILE TOOLKIT</p><h1>Everything useful.<br><span>One place.</span></h1><p class="lead">Check redeem codes, track Football Centre progress, build your squad and get A Nation's Story answers without digging through clutter.</p><div class="hero-buttons"><a class="btn primary" href="/redeem-codes">Check redeem codes <b>↗</b></a><a class="btn" href="/a-nations-story">A Nation's Story <b>↗</b></a></div><div class="signals"><span><b>01</b> REDEEM CODES</span><span><b>02</b> FOOTBALL CENTRE</span><span><b>03</b> TEAM OVR</span><span><b>04</b> A NATION'S STORY</span></div></div></section>
    <section class="wrap section tools"><div class="section-title"><div><p class="eyebrow">01 / CORE TOOLS</p><h2>Start with what matters.</h2></div><p>The most useful FC Mobile resources stay front and centre. Calculators stay available without taking over the homepage.</p></div><div class="tool-grid">
      <a class="tool-card featured" href="/redeem-codes"><span>DATABASE / 01</span><div class="tool-number">01</div><h3>Redeem Codes</h3><p>Find working codes, search the archive and jump directly to EA's redemption page.</p><strong>CHECK LATEST CODES <b>↗</b></strong></a>
      <a class="tool-card featured" href="/football-centre"><span>TRACKER / 02</span><div class="tool-number">02</div><h3>Football Centre</h3><p>Track matches, points, rewards and event progress in one focused dashboard.</p><strong>OPEN FOOTBALL CENTRE <b>↗</b></strong></a>
      <a class="tool-card" href="/team-ovr"><span>CALCULATOR / 03</span><div class="tool-number">03</div><h3>Team OVR</h3><p>Calculate exact Team OVR from base OVR, ranks and eligible badges.</p><strong>OPEN CALCULATOR <b>↗</b></strong></a>
      <a class="tool-card nation-tool" href="/a-nations-story"><span>ANSWERS / 04</span><div class="tool-number">04</div><h3>A Nation's Story</h3><p>Search the exact FC Mobile question and see every option and answer instantly.</p><strong>GET THE ANSWER <b>↗</b></strong></a>
      <a class="tool-card" href="/blog"><span>GUIDES / 05</span><h3>Blog &amp; Guides</h3><p>Read practical FC Mobile explainers, event coverage, strategies and analysis.</p><strong>READ <b>↗</b></strong></a>
      <a class="tool-card secondary-tool" href="/training-calculator"><span>CALCULATOR / 06</span><h3>Training Calculator</h3><p>Calculate training XP, fodder players, excess XP and estimated cost.</p><strong>CALCULATE TRAINING <b>↗</b></strong></a>
      <a class="tool-card secondary-tool" href="/rank-up-calculator"><span>CALCULATOR / 07</span><h3>Rank Up Calculator</h3><p>Calculate Rank Up Points, OVR gain, Skill Points and upgrade cost.</p><strong>CALCULATE RANK UP <b>↗</b></strong></a>
    </div></section>
    <section class="quick"><div class="wrap quick-inner"><div><p class="eyebrow">02 / QUICK START</p><h2>Need something right now?</h2><p>Go straight to the resources players use most.</p></div><div class="quick-links"><a href="/redeem-codes"><span>01</span><b>Check latest redeem codes</b><i>→</i></a><a href="/football-centre"><span>02</span><b>Open Football Centre</b><i>→</i></a><a href="/team-ovr"><span>03</span><b>Calculate Team OVR</b><i>→</i></a><a href="/a-nations-story"><span>04</span><b>Find an A Nation's Story answer</b><i>→</i></a><a href="/blog"><span>05</span><b>Read latest guides</b><i>→</i></a></div></div></section>
    <section class="wrap section latest-articles"><div class="section-title"><div><p class="eyebrow">03 / LATEST CONTENT</p><h2>Fresh from the<br><span>FC Mobile desk.</span></h2></div><a class="text-link" href="/blog">View all articles →</a></div>{latestArticles.length ? <div class="article-grid">{latestArticles.map((post) => <a class="home-article" href={`/blog/${post.slug}/`}>{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <div class="home-article-placeholder"><span>{post.data.type === 'player-review' ? 'REV' : 'FC'}</span></div>}<div class="home-article-body"><div class="home-article-meta"><span>{post.data.category}</span><span>{readingTime(post)} min read</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt ?? post.data.description}</p><strong>Read article →</strong></div></a>)}</div> : <div class="content-empty"><p>No published articles yet.</p><span>New Markdown articles will appear here automatically when published.</span></div>}</section>
    <section class="wrap section philosophy"><div><p class="eyebrow">04 / THE IDEA</p><h2>Less searching.<br><span>More playing.</span></h2></div><div class="philosophy-copy"><p>FC Mobile Tools is built around practical resources that answer a specific question quickly, with the most time-sensitive information easiest to reach.</p><div class="principles"><div><b>01</b><span>USEFUL FIRST</span><p>No filler around the tools.</p></div><div><b>02</b><span>LIVE WHERE IT MATTERS</span><p>Codes and event resources stay easy to reach.</p></div><div><b>03</b><span>PLAYER FOCUSED</span><p>Designed around everyday FC Mobile workflows.</p></div></div></div></section>
  </main>
</BaseLayout>
<style>
.home{overflow:hidden}.hero{position:relative;min-height:680px;display:flex;align-items:center;overflow:hidden;color:#eef8fc;background:#0d2b3a url('/assets/images/herobeli.png') center/cover no-repeat;border-bottom:1px solid #ffffff12}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#07131bf0 0%,#07131bd8 25%,#07131b82 52%,#07131b20 78%,#07131b42 100%),linear-gradient(0deg,#07131b72,transparent 48%);pointer-events:none}.hero-copy{position:relative;z-index:2;width:min(1180px,calc(100% - 40px));padding:104px 0 90px;padding-left:clamp(24px,7vw,105px)}.eyebrow{font:800 9px var(--mono);letter-spacing:.15em;color:var(--blue)}.kicker{font:800 10px var(--mono);letter-spacing:.2em;color:#8ca0ad;margin:34px 0 10px}.hero h1{font-size:clamp(54px,7vw,88px);line-height:.9;letter-spacing:-.065em;margin:0}.hero h1 span,.latest-articles h2 span{color:var(--blue)}.lead{max-width:620px;color:#b9cbd4;font-size:14px;line-height:1.75;margin:24px 0}.hero-buttons{display:flex;gap:9px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 16px;border:1px solid #ffffff20;border-radius:9px;color:#dceaf0;text-decoration:none;font:900 9px var(--mono);transition:.2s;background:#07131b66;backdrop-filter:blur(4px)}.btn:hover{border-color:var(--blue);color:var(--blue);background:#55c7f20b}.btn.primary{background:var(--blue);border-color:var(--blue);color:#06131a}.btn b{font-size:12px}.signals{display:flex;gap:20px;flex-wrap:wrap;margin-top:48px;padding-top:18px;border-top:1px solid #ffffff20;max-width:760px}.signals span{font:700 7px var(--mono);color:#91a5b0}.signals b{color:#e4f2f7;margin-right:5px}.section{padding:90px 0}.section-title{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:25px}.section-title h2,.quick h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.05em;margin:7px 0 0}.section-title>p{max-width:400px;color:var(--muted);font-size:11px;line-height:1.7;margin:0}.text-link{color:var(--blue);font:900 8px var(--mono);text-decoration:none}.tool-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.tool-card{grid-column:span 2;position:relative;min-height:190px;padding:22px;border:1px solid var(--border);border-radius:15px;background:var(--surface);color:var(--text);text-decoration:none;overflow:hidden;transition:.2s}.tool-card.featured{grid-column:span 3;min-height:260px;background:linear-gradient(145deg,#101b24,#0d1118)}.tool-card:nth-child(3),.tool-card:nth-child(4){grid-column:span 2;min-height:220px}.tool-card:hover,.home-article:hover{border-color:#55c7f255;transform:translateY(-3px);box-shadow:0 18px 45px #55c7f20b}.tool-card>span{font:800 8px var(--mono);letter-spacing:.12em;color:var(--blue)}.tool-number{position:absolute;right:15px;top:8px;font:900 80px var(--mono);color:#55c7f208;line-height:1}.tool-card h3{font-size:23px;letter-spacing:-.03em;margin:27px 0 8px}.tool-card p{max-width:460px;color:var(--muted);font-size:11px;line-height:1.7;margin:0}.tool-card strong{position:absolute;left:22px;bottom:20px;color:var(--blue);font:900 8px var(--mono)}.secondary-tool{opacity:.82}.secondary-tool h3{font-size:19px}.nation-tool{background:linear-gradient(145deg,#10232b,#0d1118)}.quick{background:#07131b;color:#eef8fc;border-top:1px solid #ffffff0e;border-bottom:1px solid #ffffff0e}.quick-inner{padding:75px 0;display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.quick p{color:#778d9a;font-size:11px}.quick-links{border-top:1px solid #ffffff13}.quick-links a{display:grid;grid-template-columns:40px 1fr 25px;align-items:center;padding:18px 0;border-bottom:1px solid #ffffff13;color:#dce8ed;text-decoration:none}.quick-links span{font:800 8px var(--mono);color:var(--blue)}.quick-links b{font-size:13px}.quick-links i{font-style:normal;color:#647985;text-align:right}.quick-links a:hover b,.quick-links a:hover i{color:var(--blue)}.latest-articles{border-bottom:1px solid var(--border)}.article-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.home-article{display:grid;grid-template-columns:180px 1fr;min-height:180px;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.home-article img,.home-article-placeholder{width:100%;height:100%;min-height:180px;object-fit:cover}.home-article-placeholder{display:flex;align-items:center;justify-content:center;background:var(--surface2);font:900 34px var(--mono);color:var(--blue3)}.home-article-placeholder span{color:var(--blue);opacity:.5}.home-article-body{padding:18px}.home-article-meta{display:flex;gap:10px;font:800 7px var(--mono);color:var(--blue);text-transform:uppercase}.home-article-meta span:last-child{color:var(--muted)}.home-article h3{font-size:18px;line-height:1.05;margin:12px 0 8px}.home-article p{font-size:10px;line-height:1.6;color:var(--muted);margin:0}.home-article strong{display:block;margin-top:15px;color:var(--blue);font:900 7px var(--mono)}.content-empty{border:1px dashed var(--border);border-radius:13px;padding:30px}.content-empty p{font-weight:800;margin:0 0 5px}.content-empty span{font-size:10px;color:var(--muted)}.philosophy{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.philosophy h2{font-size:clamp(38px,5vw,60px);line-height:.95;letter-spacing:-.055em;margin:10px 0}.philosophy h2 span{color:var(--blue)}.philosophy-copy>p{font-size:14px;line-height:1.8;color:var(--muted);max-width:560px}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:35px}.principles div{padding:16px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.principles b{font:900 8px var(--mono);color:var(--blue)}.principles span{display:block;font:900 8px var(--mono);margin-top:20px}.principles p{font-size:9px;color:var(--muted);line-height:1.6}@media(max-width:850px){.hero-copy{padding:80px 0}.quick-inner,.philosophy{grid-template-columns:1fr;gap:40px}.tool-grid{grid-template-columns:1fr 1fr}.tool-card,.tool-card.featured,.tool-card:nth-child(3),.tool-card:nth-child(4){grid-column:span 1}.tool-card.featured{min-height:230px}.principles{grid-template-columns:1fr 1fr}.article-grid{grid-template-columns:1fr}}@media(max-width:560px){.hero{min-height:650px;background-position:65% center}.hero-copy{width:calc(100% - 28px);padding:70px 0 58px}.hero h1{font-size:52px}.hero-buttons{flex-direction:column}.hero-buttons .btn{width:100%}.signals{gap:12px}.signals span{font-size:6px}.tool-grid{grid-template-columns:1fr}.tool-card,.tool-card.featured,.tool-card:nth-child(3),.tool-card:nth-child(4){grid-column:span 1}.principles{grid-template-columns:1fr}.section{padding:65px 0}.home-article{grid-template-columns:1fr}.home-article img,.home-article-placeholder{min-height:150px}}
</style>
