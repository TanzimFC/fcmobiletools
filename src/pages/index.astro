---
export const prerender = false;
Astro.response.headers.set('Cache-Control','public, max-age=0, s-maxage=15, stale-while-revalidate=60');
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/blog-supabase.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const latestArticles = (await getPublishedPosts()).slice(0, 5);

const activeCodes = REDEEM_CODES.filter((item) => item.status === 'active');
const featuredCode = activeCodes[0] ?? REDEEM_CODES[0] ?? null;
const secondaryEvent = FOOTBALL_CENTRE_CONTENT.secondaryEvent ?? {};
const dailyResetUtc = String(FOOTBALL_CENTRE_CONTENT.schedule?.dailyResetUtc || '01:00');
const resetHourUtc = Number(dailyResetUtc.split(':')[0]) || 1;
const unbreakableStartUtc = secondaryEvent.startUtc || '2026-10-15T00:00:00.000Z';

const optimizeCloudinary = (url, width) => {
  const value = String(url ?? '');
  return value.includes('res.cloudinary.com') && value.includes('/image/upload/')
    ? value.replace('/image/upload/', '/image/upload/f_auto,q_auto,dpr_auto,w_' + width + '/')
    : value;
};

const readingTime = (post) =>
  post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));

const fmtDate = (d) =>
  d
    ? new Date(d).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : '';

const SITE = 'https://fcmobiletools.com';
const title = 'FC Mobile Tools, Redeem Codes, Calculators & Guides';
const description =
  'FCMOBILETOOLS is the FC Mobile hub for redeem codes, live events, reset times, calculators, planners, guides and the latest Season 27 updates.';

const tools = [
  { href: '/redeem-codes', eyebrow: 'LIVE', name: 'Redeem Codes', text: 'Current codes, rewards and official redemption', icon: 'ticket', featured: true },
  { href: '/team-ovr', eyebrow: 'CALCULATOR', name: 'Team OVR', text: 'Check your squad rating before upgrades', icon: 'spark' },
  { href: '/training-calculator', eyebrow: 'CALCULATOR', name: 'Training Calculator', text: 'Plan XP, fodder and training levels', icon: 'bolt' },
  { href: '/rank-up-calculator', eyebrow: 'CALCULATOR', name: 'Rank Up Calculator', text: 'Compare Rank Up costs and OVR gains', icon: 'arrow' },
  { href: '/gauntlet-planner', eyebrow: 'PLANNER', name: 'Gauntlet Mode Planner', text: 'Plan rotations and player availability', icon: 'grid' },
  { href: '/football-centre', eyebrow: 'TRACKER', name: 'Football Centre', text: 'Matches, points and event resources', icon: 'pulse' },
  { href: '/a-nations-story', eyebrow: 'ANSWERS', name: "A Nation's Story", text: 'Find event answers without digging', icon: 'book' },
  { href: '/fc-mobile-27', eyebrow: 'SEASON 27', name: 'FC Mobile 27', text: 'Updates, features and current coverage', icon: 'star' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': SITE + '/#homepage',
      url: SITE + '/',
      name: title,
      description,
      isPartOf: { '@id': SITE + '/#website' },
    },
    {
      '@type': 'ItemList',
      name: 'FC Mobile tools and resources',
      itemListElement: tools.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        url: SITE + tool.href,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is FCMOBILETOOLS',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'FCMOBILETOOLS is a fan-made FC Mobile resource hub for redeem codes, live events, reset times, calculators, planners, guides and game updates.',
          },
        },
        {
          '@type': 'Question',
          name: 'Where can I find current FC Mobile redeem codes',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The Redeem Codes page lists current code status and rewards and points players to the official EA redemption flow.',
          },
        },
        {
          '@type': 'Question',
          name: 'Which FC Mobile calculators are available',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'FCMOBILETOOLS includes Team OVR, Training and Rank Up calculators plus additional planning and event tools.',
          },
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="home-premium" id="main">
    <section class="hero-premium" aria-labelledby="hero-title">
      <div class="hero-premium__image" aria-hidden="true">
        <img
          src="/assets/images/herobeli.png"
          alt=""
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-premium__overlay" aria-hidden="true"></div>
      <div class="hero-premium__texture" aria-hidden="true"></div>
      <div class="hero-premium__light hero-premium__light--one" aria-hidden="true"></div>

      <div class="wrap-premium hero-premium__inner">
        <div class="hero-premium__copy">
          <div class="hero-kicker hero-enter" style="--delay:.03s">
            <span class="hero-kicker__dot"></span>
            FC MOBILE 27
            <span class="hero-kicker__rule"></span>
            LIVE RESOURCE HUB
          </div>

          <h1 id="hero-title">
            <span class="hero-title__line hero-enter" style="--delay:.1s">Everything useful</span>
            <span class="hero-title__line hero-title__line--accent hero-enter" style="--delay:.18s">starts here</span>
          </h1>

          <p class="hero-premium__lead hero-enter" style="--delay:.28s">
            Live event timing, redeem codes, calculators and guides, designed to help you find the right thing faster
          </p>

          <div class="hero-premium__actions hero-enter" style="--delay:.36s">
            <a class="premium-btn premium-btn--primary" href="/events">
              <span>Explore live events</span>
              <b>↗</b>
            </a>
            <a class="premium-btn premium-btn--outline" href="/redeem-codes">
              <span>Check redeem codes</span>
              <b>→</b>
            </a>
          </div>

          <div class="hero-meta hero-enter" style="--delay:.44s" aria-label="FCMOBILETOOLS highlights">
            <span><i></i> Updated resources</span>
            <span><i></i> Local-time friendly</span>
            <span><i></i> Built for daily play</span>
          </div>
        </div>
      </div>

      <div class="hero-floor" aria-hidden="true"></div>
      <div class="hero-scrollmark" aria-hidden="true">
        <span></span>
        <b>EXPLORE</b>
      </div>
    </section>

    <section class="live-rail-section" aria-labelledby="live-now-title">
      <div class="wrap-premium">
        <div class="live-rail">
          <div class="live-rail__label">
            <span class="section-eyebrow">LIVE NOW</span>
            <h2 id="live-now-title">Stay ahead of the next reset</h2>
          </div>

          <div class="live-rail__clock">
            <span>DAILY RESET</span>
            <strong id="reset-time-premium">--:--:--</strong>
            <small id="reset-zone-premium">YOUR LOCAL TIME</small>
          </div>

          <div class="live-rail__events">
            <a class="rail-event rail-event--live" href="/events">
              <span class="rail-event__status"><i></i> LIVE</span>
              <b>Anniversary</b>
              <small>24 SEP 2026</small>
            </a>
            <a class="rail-event" href="/events">
              <span class="rail-event__status">UP NEXT</span>
              <b>{secondaryEvent.title || 'Unbreakable'}</b>
              <small>15 OCT 2026</small>
            </a>
            <a class="rail-event" href="/events">
              <span class="rail-event__status rail-event__status--reset">RESET</span>
              <b>Division Rivals</b>
              <small>22 OCT 2026</small>
            </a>
          </div>

          <a class="live-rail__arrow" href="/events" aria-label="Open all live events">↗</a>
        </div>
      </div>
    </section>

    <section class="code-premium-section" aria-labelledby="code-premium-title">
      <div class="wrap-premium">
        <div class="code-premium reveal">
          <div class="code-premium__shine" aria-hidden="true"></div>
          <div class="code-premium__left">
            <div class="code-status"><i></i> ACTIVE CODE <span>{featuredCode?.region || 'GLOBAL'}</span></div>
            <span class="section-eyebrow">LATEST REDEEM CODE</span>
            <h2 id="code-premium-title">{featuredCode?.code || 'CHECK CODES'}</h2>
            <p>{featuredCode?.reward || 'Open the redeem page to see the latest available reward.'}</p>
            <div class="code-details">
              <span><small>RELEASED</small><b>{featuredCode?.releaseDate || '—'}</b></span>
              <span><small>VERIFIED</small><b>{featuredCode?.lastVerified || '—'}</b></span>
            </div>
          </div>

          <div class="code-premium__right">
            <div class="code-orbit" aria-hidden="true"><span>FCM</span><b>27</b></div>
            <div>
              <p>Current code status is pulled from the site database</p>
              <a class="premium-btn premium-btn--primary" href="/redeem-codes"><span>Open redeem codes</span><b>↗</b></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tools-premium-section" id="tools" aria-labelledby="tools-title">
      <div class="wrap-premium">
        <div class="section-heading reveal">
          <div>
            <span class="section-eyebrow">THE TOOLKIT</span>
            <h2 id="tools-title">Use the tool<br /><em>you need next</em></h2>
          </div>
          <p>Everything is arranged around real FC Mobile decisions, from squad building to event progress</p>
        </div>

        <div class="tools-premium-grid">
          {tools.map((tool, index) => (
            <a class:list={['premium-tool', tool.featured ? 'premium-tool--featured' : '', index === 5 ? 'premium-tool--wide' : '']} href={tool.href}>
              <div class="premium-tool__top">
                <span>{tool.eyebrow}</span>
                <b>{String(index + 1).padStart(2, '0')}</b>
              </div>
              <span class="premium-tool__icon" aria-hidden="true">
                {tool.icon === 'ticket' && <svg viewBox="0 0 24 24"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h11A2.5 2.5 0 0 1 20 8.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 15.5z"/><path d="M8 6v12M16 10h.01M16 14h.01"/></svg>}
                {tool.icon === 'spark' && <svg viewBox="0 0 24 24"><path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7z"/><path d="m19 15 .7 2.3L22 18l-2.3.7z"/></svg>}
                {tool.icon === 'bolt' && <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13H11l-1 9L19.5 11H13z"/></svg>}
                {tool.icon === 'arrow' && <svg viewBox="0 0 24 24"><path d="M4 18 10 12l4 4 6-6"/><path d="M14 10h6v6"/></svg>}
                {tool.icon === 'grid' && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg>}
                {tool.icon === 'pulse' && <svg viewBox="0 0 24 24"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg>}
                {tool.icon === 'book' && <svg viewBox="0 0 24 24"><path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H20v16H7.5A2.5 2.5 0 0 0 5 21z"/><path d="M5 5.5V21M9 7h7M9 11h7"/></svg>}
                {tool.icon === 'star' && <svg viewBox="0 0 24 24"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>}
              </span>
              <h3>{tool.name}</h3>
              <p>{tool.text}</p>
              <span class="premium-tool__go" aria-hidden="true">↗</span>
              <span class="premium-tool__glow" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="editorial-title">
      <div class="wrap-premium">
        <div class="section-heading reveal">
          <div>
            <span class="section-eyebrow">THE EDITORIAL DESK</span>
            <h2 id="editorial-title">What’s new</h2>
          </div>
          <a class="premium-link" href="/blog">Read all articles <b>↗</b></a>
        </div>

        {latestArticles.length ? (
          <div class="editorial-grid reveal">
            {latestArticles[0] && (
              <article class="editorial-feature">
                <a href={`/blog/${latestArticles[0].slug}/`}>
                  <div class="editorial-feature__image">
                    {latestArticles[0].data.image ? (
                      <img src={optimizeCloudinary(latestArticles[0].data.image, 1100)} alt={latestArticles[0].data.title} width="1100" height="619" loading="lazy" decoding="async" />
                    ) : <span>FCM</span>}
                    <i>FEATURED</i>
                  </div>
                  <div class="editorial-feature__body">
                    <div class="editorial-meta"><span>{latestArticles[0].data.category}</span>{latestArticles[0].data.publishedAt && <time datetime={new Date(latestArticles[0].data.publishedAt).toISOString()}>{fmtDate(latestArticles[0].data.publishedAt)}</time>}</div>
                    <h3>{latestArticles[0].data.title}</h3>
                    <p>{latestArticles[0].data.excerpt ?? latestArticles[0].data.description}</p>
                    <span class="premium-link">Read article <b>↗</b></span>
                  </div>
                </a>
              </article>
            )}

            <div class="editorial-list">
              {latestArticles.slice(1).map((post) => (
                <article class="editorial-row">
                  <a href={`/blog/${post.slug}/`}>
                    <div class="editorial-row__image">
                      {post.data.image ? <img src={optimizeCloudinary(post.data.image, 420)} alt="" width="420" height="236" loading="lazy" decoding="async" /> : <span>FCM</span>}
                    </div>
                    <div class="editorial-row__body">
                      <div class="editorial-meta"><span>{post.data.category}</span>{post.data.publishedAt && <time datetime={new Date(post.data.publishedAt).toISOString()}>{fmtDate(post.data.publishedAt)}</time>}</div>
                      <h3>{post.data.title}</h3>
                      <b aria-hidden="true">↗</b>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        ) : (
          <p class="empty-editorial">New articles are on the way</p>
        )}
      </div>
    </section>

    <section class="seo-premium-section" aria-labelledby="seo-title">
      <div class="wrap-premium seo-premium">
        <div class="seo-premium__lead reveal">
          <span class="section-eyebrow">FC MOBILE RESOURCE HUB</span>
          <h2 id="seo-title">Less hunting<br /><em>more playing</em></h2>
        </div>
        <div class="seo-premium__copy reveal">
          <p>FCMOBILETOOLS brings the useful parts of FC Mobile into one place, from live event schedules and reset timing to redeem codes, calculators, planners and current guides</p>
          <p>Use the site when you need a quick calculation, an event answer, the latest code status or a clear update on what changed in FC Mobile 27</p>
          <a class="premium-link" href="/legal/about">About FCMOBILETOOLS <b>↗</b></a>
        </div>
      </div>
    </section>

    <section class="faq-premium-section" aria-labelledby="faq-title">
      <div class="wrap-premium">
        <div class="section-heading reveal">
          <div>
            <span class="section-eyebrow">QUICK ANSWERS</span>
            <h2 id="faq-title">Start here</h2>
          </div>
        </div>
        <div class="faq-premium-grid reveal">
          <details>
            <summary>What is FCMOBILETOOLS <span>+</span></summary>
            <p>A fan-made FC Mobile hub for redeem codes, live events, reset timing, calculators, planners, guides and updates</p>
          </details>
          <details>
            <summary>Where are the current redeem codes <span>+</span></summary>
            <p>Open Redeem Codes for the current status, rewards and the official EA redemption route</p>
          </details>
          <details>
            <summary>Which calculators are available <span>+</span></summary>
            <p>Team OVR, Training and Rank Up calculators are available alongside event and planning tools</p>
          </details>
        </div>
      </div>
    </section>

    <section class="final-premium-section">
      <div class="wrap-premium">
        <div class="final-premium reveal">
          <div>
            <span class="section-eyebrow">YOUR NEXT MOVE</span>
            <h2>Everything useful<br /><em>starts here</em></h2>
          </div>
          <div class="final-premium__actions">
            <a class="premium-btn premium-btn--primary" href="/events"><span>Explore live events</span><b>↗</b></a>
            <a class="premium-btn premium-btn--outline" href="#tools"><span>Open the toolkit</span><b>↓</b></a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ resetHourUtc }}>
  const resetHour = Number(resetHourUtc) || 1;
  const clock = document.getElementById('reset-time-premium');
  const zone = document.getElementById('reset-zone-premium');
  const pad = (value) => String(value).padStart(2, '0');
  const DAY = 86400000;

  function updateResetClock() {
    const now = new Date();
    const next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), resetHour));
    if (next <= now) next.setTime(next.getTime() + DAY);
    const remaining = Math.max(0, next.getTime() - now.getTime());
    const sec = Math.floor(remaining / 1000);

    if (clock) clock.textContent = `${pad(Math.floor(sec / 3600))}:${pad(Math.floor((sec % 3600) / 60))}:${pad(sec % 60)}`;
    if (zone) {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'LOCAL TIME';
      zone.textContent = tz.replace(/_/g, ' ');
    }
  }

  updateResetClock();
  window.setInterval(updateResetClock, 1000);

  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries, io) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -5% 0px' });
    reveals.forEach((item) => observer.observe(item));
  } else {
    reveals.forEach((item) => item.classList.add('is-visible'));
  }

  const art = document.querySelector('.hero-art');
  if (art && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.matchMedia('(hover:hover)').matches) {
    window.addEventListener('pointermove', (event) => {
      const x = (event.clientX / window.innerWidth - .5) * 2;
      const y = (event.clientY / window.innerHeight - .5) * 2;
      art.style.setProperty('--px', (x * 4).toFixed(2) + 'px');
      art.style.setProperty('--py', (y * 3).toFixed(2) + 'px');
    }, { passive: true });
  }
</script>

<style is:global>
  .home-premium {
    --hp-bg: #061018;
    --hp-bg-2: #08131c;
    --hp-surface: #0a1821;
    --hp-surface-2: #0d202b;
    --hp-border: rgba(144, 203, 224, .14);
    --hp-border-strong: rgba(88, 215, 249, .34);
    --hp-text: #eef9fc;
    --hp-soft: #b9cbd2;
    --hp-muted: #78909b;
    --hp-accent: #56dbff;
    --hp-accent-2: #76efce;
    --hp-display: "Space Grotesk", var(--font-display, sans-serif);
    background:
      radial-gradient(1100px 620px at 10% 0%, rgba(46, 166, 207, .09), transparent 65%),
      radial-gradient(900px 620px at 92% 20%, rgba(71, 114, 210, .065), transparent 62%),
      var(--hp-bg);
    color: var(--hp-text);
    overflow: clip;
    position: relative;
  }

  .home-premium, .home-premium * { box-sizing: border-box; }
  .home-premium .wrap-premium { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .home-premium a { color: inherit; text-decoration: none; }
  .home-premium p, .home-premium h1, .home-premium h2, .home-premium h3 { margin: 0; }
  .home-premium h1, .home-premium h2, .home-premium h3 { font-family: var(--hp-display); }
  .home-premium :focus-visible { outline: 2px solid var(--hp-accent); outline-offset: 4px; }
  .section-eyebrow {
    display: inline-block;
    color: #6fdef7;
    font: 800 9px/1 "Inter", sans-serif;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  /* HERO */
  .hero-premium {
    position: relative;
    min-height: min(820px, 88svh);
    display: grid;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    background: #061018;
    border-bottom: 1px solid var(--hp-border);
  }

  .hero-premium__image {
    position: absolute;
    inset: 0;
    z-index: -4;
    overflow: hidden;
    background: #07131b;
  }

  .hero-premium__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    transform: scale(1.035);
    filter: saturate(.98) contrast(1.04);
    opacity: .62;
    animation: heroImageEnter 1.8s cubic-bezier(.2,.72,.2,1) both;
  }

  .hero-premium__overlay {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      linear-gradient(90deg, rgba(6,16,24,.985) 0%, rgba(6,16,24,.93) 30%, rgba(6,16,24,.58) 55%, rgba(6,16,24,.16) 100%),
      linear-gradient(180deg, rgba(6,16,24,.18) 0%, rgba(6,16,24,.18) 50%, #061018 100%);
  }

  .hero-premium__texture {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .12;
    background-image:
      linear-gradient(rgba(193,231,240,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(193,231,240,.05) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: linear-gradient(90deg, rgba(0,0,0,.58), transparent 78%);
  }

  .hero-premium__light {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
  }

  .hero-premium__light--one {
    width: 620px;
    height: 620px;
    right: -160px;
    top: -170px;
    background: radial-gradient(circle, rgba(86,219,255,.14), transparent 68%);
    animation: heroLightOne 11s ease-in-out infinite;
  }

  .hero-premium__inner {
    min-height: 820px;
    position: relative;
    display: grid;
    align-items: center;
    padding: 108px 0 78px;
  }

  .hero-premium__copy {
    position: relative;
    z-index: 3;
    max-width: 760px;
    padding: 24px 0;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #8aa7b2;
    font: 800 9px/1 "Inter", sans-serif;
    letter-spacing: .13em;
  }

  .hero-kicker__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #69efb5;
    box-shadow: 0 0 20px rgba(105,239,181,.50);
    animation: dotPulse 2.2s ease-out infinite;
  }

  .hero-kicker__rule {
    width: 36px;
    height: 1px;
    background: rgba(122,190,210,.24);
  }

  .hero-premium h1 {
    margin-top: 25px;
    font-size: clamp(60px, 8.4vw, 110px);
    line-height: .87;
    letter-spacing: -.071em;
    max-width: 860px;
  }

  .hero-title__line {
    display: block;
    opacity: 0;
    transform: translateY(36px);
    animation: titleEnter .95s cubic-bezier(.18,.78,.2,1) var(--delay) forwards;
  }

  .hero-title__line--accent {
    background: linear-gradient(105deg, var(--hp-accent) 0%, var(--hp-accent-2) 70%, #e9fffa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-premium__lead {
    max-width: 625px;
    margin-top: 28px !important;
    color: var(--hp-soft);
    font: 400 clamp(16px, 1.5vw, 19px)/1.72 "Inter", sans-serif;
  }

  .hero-premium__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 34px;
  }

  .premium-btn {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 0 17px 0 20px;
    border: 1px solid transparent;
    border-radius: 13px;
    font: 700 13px/1 "Inter", sans-serif;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease, background .25s ease;
  }

  .premium-btn b {
    font-size: 17px;
    font-weight: 500;
    transition: transform .25s ease;
  }

  .premium-btn:hover b { transform: translate(2px,-2px); }

  .premium-btn--primary {
    color: #06202a !important;
    background: linear-gradient(110deg, #56dbff, #76efce);
    box-shadow: 0 17px 46px rgba(78,212,242,.16);
  }

  .premium-btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 23px 60px rgba(78,212,242,.25);
  }

  .premium-btn--outline {
    border-color: rgba(161,208,222,.18);
    background: rgba(255,255,255,.035);
    color: var(--hp-text) !important;
    backdrop-filter: blur(12px);
  }

  .premium-btn--outline:hover {
    transform: translateY(-3px);
    border-color: var(--hp-border-strong);
    background: rgba(86,219,255,.055);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 26px;
    color: #607a86;
    font: 800 8px/1 "Inter", sans-serif;
    text-transform: uppercase;
    letter-spacing: .09em;
  }

  .hero-meta span { display: inline-flex; align-items: center; gap: 7px; }
  .hero-meta i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #58d9ef;
  }

  .hero-enter {
    opacity: 0;
    transform: translateY(14px);
    animation: fadeEnter .8s cubic-bezier(.2,.8,.2,1) var(--delay) forwards;
  }

  .hero-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 190px;
    z-index: -1;
    background: linear-gradient(180deg, transparent, rgba(5,14,21,.92));
    pointer-events: none;
  }

  .hero-scrollmark {
    position: absolute;
    left: 50%;
    bottom: 21px;
    z-index: 5;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 9px;
    color: #55707c;
    font: 800 7px/1 "Inter", sans-serif;
    letter-spacing: .15em;
  }

  .hero-scrollmark span {
    display: block;
    width: 21px;
    height: 33px;
    border: 1px solid rgba(137,192,207,.22);
    border-radius: 99px;
    position: relative;
  }

  .hero-scrollmark span::after {
    content: "";
    position: absolute;
    top: 7px;
    left: 50%;
    width: 2px;
    height: 7px;
    border-radius: 9px;
    background: #72dff3;
    transform: translateX(-50%);
    animation: scrollDot 1.8s ease-in-out infinite;
  }

  /* LIVE RAIL */
  .live-rail-section { padding-top: 54px; }
  .live-rail {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 1.1fr) 180px minmax(390px, 1.7fr) 48px;
    align-items: stretch;
    border: 1px solid var(--hp-border);
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(120deg, rgba(13,31,42,.95), rgba(7,19,27,.98));
    box-shadow: 0 22px 60px rgba(0,0,0,.14);
  }

  .live-rail__label,
  .live-rail__clock,
  .live-rail__events,
  .live-rail__arrow { min-width: 0; }
  .live-rail__label { padding: 19px 20px; }
  .live-rail__label h2 { margin-top: 6px; font-size: 19px; line-height: 1.06; letter-spacing: -.035em; }
  .live-rail__clock { display: grid; place-content: center; padding: 13px 16px; border-left: 1px solid var(--hp-border); border-right: 1px solid var(--hp-border); background: rgba(255,255,255,.018); }
  .live-rail__clock > span { color: #526f7c; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .12em; }
  .live-rail__clock strong { margin-top: 6px; color: #e8fbff; font: 800 25px/.95 var(--hp-display); font-variant-numeric: tabular-nums; letter-spacing: -.04em; }
  .live-rail__clock small { margin-top: 5px; color: #5f7e89; font: 700 7px/1.2 "Inter", sans-serif; }
  .live-rail__events { display: grid; grid-template-columns: repeat(3, 1fr); }
  .rail-event { padding: 16px 15px; display: grid; align-content: center; gap: 5px; transition: background .25s ease, padding-left .25s ease; }
  .rail-event + .rail-event { border-left: 1px solid var(--hp-border); }
  .rail-event:hover { background: rgba(86,219,255,.045); padding-left: 18px; }
  .rail-event__status { color: #68cce6; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .13em; }
  .rail-event__status i, .code-status i { width: 6px; height: 6px; display: inline-block; margin-right: 5px; border-radius: 50%; background: #69efb5; box-shadow: 0 0 12px rgba(105,239,181,.48); }
  .rail-event__status--reset { color: #b7a7f2; }
  .rail-event b { font: 750 13px/1.2 "Inter", sans-serif; }
  .rail-event small { color: #56727e; font: 700 7px/1 "Inter", sans-serif; letter-spacing: .08em; }
  .live-rail__arrow { display: grid; place-items: center; border-left: 1px solid var(--hp-border); color: #7edcf0; font: 500 21px/1 "Inter", sans-serif; transition: background .2s ease, color .2s ease; }
  .live-rail__arrow:hover { background: rgba(86,219,255,.06); color: #d9fbff; }

  /* CODE */
  .code-premium-section { padding-top: 96px; }
  .code-premium {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr .6fr;
    min-height: 300px;
    overflow: hidden;
    border: 1px solid rgba(86,219,255,.18);
    border-radius: 28px;
    background:
      radial-gradient(620px 280px at 0 50%, rgba(86,219,255,.10), transparent 70%),
      radial-gradient(500px 250px at 100% 0, rgba(118,239,206,.08), transparent 70%),
      linear-gradient(135deg, #0b202b, #07141d 64%);
    box-shadow: 0 28px 80px rgba(0,0,0,.18);
  }

  .code-premium__shine {
    position: absolute;
    inset: -30%;
    background: linear-gradient(108deg, transparent 42%, rgba(255,255,255,.035) 49%, transparent 56%);
    transform: translateX(-55%);
    animation: codeSweep 8s ease-in-out infinite;
    pointer-events: none;
  }

  .code-premium__left { padding: 34px 40px; position: relative; z-index: 1; }
  .code-status { display: flex; align-items: center; gap: 7px; color: #83eebd; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .code-status span { margin-left: auto; color: #567480; }
  .code-premium__left > .section-eyebrow { margin-top: 31px; color: #547682; }
  .code-premium__left h2 { margin-top: 8px; font-size: clamp(44px, 6vw, 78px); line-height: .86; letter-spacing: .06em; }
  .code-premium__left > p { max-width: 620px; margin-top: 14px !important; color: #abc2ca; font: 400 16px/1.55 "Inter", sans-serif; }
  .code-details { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 22px; }
  .code-details small { display: block; color: #4c6975; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .1em; }
  .code-details b { display: block; margin-top: 5px; color: #b9cfd6; font: 700 10px/1 "Inter", sans-serif; }
  .code-premium__right { display: grid; grid-template-columns: 115px 1fr; align-items: center; gap: 19px; padding: 35px 34px 35px 10px; border-left: 1px solid rgba(129, 203, 224, .11); background: rgba(0,0,0,.09); position: relative; z-index: 1; }
  .code-premium__right p { margin-bottom: 13px !important; color: #607d88; font: 400 9px/1.55 "Inter", sans-serif; }
  .code-premium__right .premium-btn { width: 100%; }
  .code-orbit { width: 104px; height: 104px; display: grid; place-items: center; align-content: center; position: relative; border: 1px solid rgba(86,219,255,.22); border-radius: 28px; background: radial-gradient(circle, rgba(86,219,255,.12), transparent 67%), #0b1b24; box-shadow: inset 0 0 0 10px rgba(255,255,255,.012), 0 0 40px rgba(86,219,255,.09); }
  .code-orbit::before, .code-orbit::after { content: ""; position: absolute; border: 1px solid rgba(118,239,206,.16); border-radius: 50%; }
  .code-orbit::before { inset: 10px; animation: orbitSpin 8s linear infinite; }
  .code-orbit::after { inset: 21px; opacity: .6; }
  .code-orbit span { color: #8be6f4; font: 900 23px/1 var(--hp-display); letter-spacing: -.05em; }
  .code-orbit b { margin-top: 5px; color: #5f8b98; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .16em; }

  /* SECTION HEADING */
  .tools-premium-section { padding-top: 108px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 29px; }
  .section-heading h2 { margin-top: 8px; font-size: clamp(38px, 5.4vw, 62px); line-height: .92; letter-spacing: -.058em; }
  .section-heading h2 em { color: #6fd9ec; font-style: normal; }
  .section-heading > p { max-width: 340px; color: #718995; font: 400 13px/1.7 "Inter", sans-serif; }

  /* TOOLS */
  .tools-premium-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 11px; }
  .premium-tool {
    grid-column: span 3;
    position: relative;
    min-height: 245px;
    overflow: hidden;
    padding: 21px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hp-border);
    border-radius: 20px;
    background: linear-gradient(150deg, #0b1b25, #07131c);
    transition: transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s ease, box-shadow .3s ease;
  }
  .premium-tool::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(260px 220px at 100% 0, rgba(86,219,255,.10), transparent 70%),
      linear-gradient(135deg, rgba(255,255,255,.025), transparent 38%);
    opacity: .7;
  }
  .premium-tool:hover { transform: translateY(-6px); border-color: rgba(86,219,255,.28); box-shadow: 0 25px 60px rgba(0,0,0,.18); }
  .premium-tool--featured { grid-column: span 6; min-height: 245px; background: radial-gradient(380px 260px at 100% 0, rgba(86,219,255,.16), transparent 65%), linear-gradient(150deg, #0e2734, #091822 68%); }
  .premium-tool--wide { grid-column: span 6; }
  .premium-tool__top, .premium-tool__icon, .premium-tool h3, .premium-tool p, .premium-tool__go, .premium-tool__glow { position: relative; z-index: 2; }
  .premium-tool__top { display: flex; justify-content: space-between; align-items: center; color: #5b7985; font: 800 7px/1 "Inter", sans-serif; letter-spacing: .12em; }
  .premium-tool__top b { color: #385966; font: 800 7px/1 "Inter", sans-serif; }
  .premium-tool__icon { width: 39px; height: 39px; margin-top: 26px; display: grid; place-items: center; border: 1px solid rgba(86,219,255,.15); border-radius: 11px; color: #7bdff2; background: rgba(86,219,255,.035); transition: transform .3s ease, background .3s ease; }
  .premium-tool__icon svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .premium-tool h3 { margin-top: auto; padding-top: 17px; font-size: 21px; line-height: 1.04; letter-spacing: -.035em; }
  .premium-tool--featured h3, .premium-tool--wide h3 { font-size: 27px; }
  .premium-tool p { max-width: 390px; margin-top: 8px !important; color: #6f8a96; font: 400 10px/1.6 "Inter", sans-serif; }
  .premium-tool__go { position: absolute; right: 18px; bottom: 18px; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid rgba(135, 194, 208, .12); border-radius: 50%; color: #5f808c; transition: .25s ease; }
  .premium-tool__glow { position: absolute; width: 120px; height: 120px; right: -34px; bottom: -42px; border-radius: 50%; background: rgba(86,219,255,.13); filter: blur(32px); opacity: 0; transition: opacity .3s ease; }
  .premium-tool:hover .premium-tool__icon { transform: translateY(-2px) scale(1.04); background: rgba(86,219,255,.07); }
  .premium-tool:hover .premium-tool__go { background: var(--hp-accent); border-color: var(--hp-accent); color: #06202a; transform: rotate(45deg); }
  .premium-tool:hover .premium-tool__glow { opacity: 1; }

  /* EDITORIAL */
  .editorial-section { padding-top: 110px; }
  .premium-link { display: inline-flex; align-items: center; gap: 7px; color: #83dfef !important; font: 700 11px/1 "Inter", sans-serif; }
  .premium-link b { font-size: 15px; font-weight: 500; transition: transform .2s ease; }
  .premium-link:hover b { transform: translate(2px,-2px); }
  .editorial-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 12px; }
  .editorial-feature > a { display: grid; height: 100%; grid-template-rows: auto 1fr; overflow: hidden; border: 1px solid var(--hp-border); border-radius: 23px; background: linear-gradient(150deg,#0b1c26,#07131b); transition: transform .3s ease,border-color .3s ease,box-shadow .3s ease; }
  .editorial-feature > a:hover { transform: translateY(-5px); border-color: rgba(86,219,255,.28); box-shadow: 0 28px 68px rgba(0,0,0,.2); }
  .editorial-feature__image { min-height: 325px; position: relative; overflow: hidden; background: #07131a; }
  .editorial-feature__image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .editorial-feature > a:hover img { transform: scale(1.045); }
  .editorial-feature__image i { position: absolute; left: 16px; top: 16px; padding: 7px 9px; border: 1px solid rgba(86,219,255,.18); border-radius: 999px; background: rgba(6,16,24,.67); backdrop-filter: blur(10px); color: #7dddee; font: 800 7px/1 "Inter",sans-serif; font-style: normal; letter-spacing: .12em; }
  .editorial-feature__image > span { height: 100%; display: grid; place-items: center; color: #63d5ed; font: 900 42px/1 var(--hp-display); }
  .editorial-feature__body { padding: 24px; }
  .editorial-meta { display: flex; flex-wrap: wrap; gap: 6px 13px; color: #54707c; font: 800 8px/1 "Inter",sans-serif; letter-spacing: .09em; text-transform: uppercase; }
  .editorial-meta span { color: #66d8ef; }
  .editorial-feature h3 { margin-top: 12px; font-size: clamp(25px,3.2vw,37px); line-height: 1.05; letter-spacing: -.045em; }
  .editorial-feature__body > p { margin-top: 11px !important; color: #77919c; font: 400 11px/1.7 "Inter",sans-serif; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .editorial-feature__body > .premium-link { margin-top: 17px; }
  .editorial-list { display: grid; gap: 9px; }
  .editorial-row { min-height: 0; overflow: hidden; border: 1px solid var(--hp-border); border-radius: 17px; background: #091720; transition: transform .25s ease,border-color .25s ease; }
  .editorial-row:hover { transform: translateY(-3px); border-color: rgba(86,219,255,.24); }
  .editorial-row > a { display: grid; grid-template-columns: 130px 1fr; min-height: 133px; }
  .editorial-row__image { overflow: hidden; background: #06121a; }
  .editorial-row__image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .55s ease; }
  .editorial-row:hover img { transform: scale(1.05); }
  .editorial-row__image span { height: 100%; display: grid; place-items: center; color: #4bb9d2; font: 900 18px/1 var(--hp-display); }
  .editorial-row__body { position: relative; padding: 17px 40px 16px 18px; display: flex; flex-direction: column; justify-content: center; }
  .editorial-row h3 { margin-top: 7px; font-size: 16px; line-height: 1.25; letter-spacing: -.02em; }
  .editorial-row__body > b { position: absolute; top: 50%; right: 16px; color: #5c7b87; font: 500 15px/1 "Inter",sans-serif; transform: translateY(-50%); transition: transform .2s ease,color .2s ease; }
  .editorial-row:hover .editorial-row__body > b { transform: translate(2px,-12px); color: #8bdff0; }

  /* SEO */
  .seo-premium-section { margin-top: 110px; border-top: 1px solid var(--hp-border); padding-top: 55px; }
  .seo-premium { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(45px, 8vw, 120px); }
  .seo-premium__lead h2 { margin-top: 9px; font-size: clamp(40px, 5vw, 59px); line-height: .93; letter-spacing: -.055em; }
  .seo-premium__lead h2 em { color: #6fd9ec; font-style: normal; }
  .seo-premium__copy { max-width: 700px; }
  .seo-premium__copy p { color: #78919c; font: 400 13px/1.8 "Inter",sans-serif; }
  .seo-premium__copy p + p { margin-top: 15px !important; }
  .seo-premium__copy .premium-link { margin-top: 20px; }

  /* FAQ */
  .faq-premium-section { padding-top: 105px; }
  .faq-premium-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 9px; }
  .faq-premium-grid details { padding: 17px 18px; border: 1px solid var(--hp-border); border-radius: 16px; background: #091720; transition: border-color .25s ease, background .25s ease; }
  .faq-premium-grid details[open] { border-color: rgba(86,219,255,.25); background: #0a1a23; }
  .faq-premium-grid summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 15px; cursor: pointer; color: #dcecf1; font: 700 12px/1.3 "Inter",sans-serif; }
  .faq-premium-grid summary::-webkit-details-marker { display: none; }
  .faq-premium-grid summary span { color: #68d9ee; font: 400 19px/1 "Inter",sans-serif; transition: transform .2s ease; }
  .faq-premium-grid details[open] summary span { transform: rotate(45deg); }
  .faq-premium-grid details p { margin-top: 12px !important; color: #718c98; font: 400 10px/1.7 "Inter",sans-serif; }

  /* FINAL */
  .final-premium-section { padding: 105px 0 125px; }
  .final-premium { position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: center; padding: clamp(33px, 5vw, 54px); border: 1px solid rgba(86,219,255,.20); border-radius: 28px; background: radial-gradient(650px 290px at 100% 0, rgba(86,219,255,.12), transparent 70%), linear-gradient(145deg,#0c202b,#08151e); }
  .final-premium::before { content: ""; position: absolute; width: 360px; height: 360px; right: -130px; bottom: -180px; border-radius: 50%; background: radial-gradient(circle,rgba(118,239,206,.10),transparent 68%); filter: blur(2px); }
  .final-premium h2 { margin-top: 8px; font-size: clamp(39px,5.7vw,71px); line-height: .94; letter-spacing: -.06em; position: relative; }
  .final-premium h2 em { color: #6fd9ec; font-style: normal; }
  .final-premium__actions { position: relative; display: flex; flex-wrap: wrap; gap: 10px; }

  /* REVEALS / MOTION */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .72s ease, transform .72s cubic-bezier(.2,.82,.2,1); }
  .reveal.is-visible { opacity: 1; transform: none; }

  @keyframes heroImageEnter { from { opacity: 0; transform: scale(1.08); } to { opacity: .62; transform: scale(1.035); } }
  @keyframes titleEnter { to { opacity: 1; transform: none; } }
  @keyframes fadeEnter { to { opacity: 1; transform: none; } }
  @keyframes heroLightOne { 50% { transform: translate3d(-22px,18px,0) scale(1.05); } }
  @keyframes heroLightTwo { 50% { transform: translate3d(24px,-18px,0) scale(.94); } }
  @keyframes dotPulse { 70% { box-shadow: 0 0 0 8px rgba(105,239,181,0); } 100% { box-shadow: 0 0 0 0 rgba(105,239,181,0); } }
  @keyframes artworkHalo { 50% { transform: scale(1.05); opacity: .86; } }
  @keyframes artworkFloat { 50% { transform: rotate(2deg) translateY(-7px); } }
  @keyframes scanMove { 0%,18% { left:-10%; opacity:0; } 22% { opacity:1; } 55% { left:105%; opacity:.55; } 63%,100% { left:105%; opacity:0; } }
  @keyframes scrollDot { 0%,100% { transform: translate(-50%,0); opacity:1; } 50% { transform: translate(-50%,8px); opacity:.25; } }
  @keyframes codeSweep { 0%,58% { transform: translateX(-55%); } 72%,100% { transform: translateX(55%); } }
  @keyframes orbitSpin { to { transform: rotate(360deg); } }

  @media (max-width: 1040px) {
    .hero-premium__inner { grid-template-columns: 1fr .9fr; gap: 15px; }
    .hero-art { min-height: 540px; }
    .hero-art__frame { width: min(560px, 50vw); }
    .live-rail { grid-template-columns: minmax(220px,1fr) 165px minmax(340px,1.5fr) 44px; }
    .premium-tool { grid-column: span 4; }
    .premium-tool--featured, .premium-tool--wide { grid-column: span 6; }
  }

  @media (max-width: 820px) {
    .home-premium .wrap-premium { width: calc(100% - 28px); }

    .hero-premium { min-height: 760px; }
    .hero-premium__inner { min-height: 760px; grid-template-columns: 1fr; padding: 92px 0 74px; }
