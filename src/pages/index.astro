    background-size: 96px 96px; -webkit-mask-image: radial-gradient(ellipse 60% 70% at 15% 40%, #000, transparent 75%); mask-image: radial-gradient(ellipse 60% 70% at 15% 40%, #000, transparent 75%); }
  .hx-hero__inner { position: relative; }
  .hx-kicker { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; font: 600 12.5px/1 var(--body); letter-spacing: .14em; text-transform: uppercase; color: var(--soft); }
