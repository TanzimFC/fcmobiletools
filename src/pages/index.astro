    .pr-hero__layout { grid-template-columns: 1fr; gap: 35px; }.pr-hero__copy { max-width: 690px; }.pr-command { width: min(100%,510px); margin-left: auto; }
    .pr-scroll-cue { left: 18px; bottom: 24px; font-size: 8px; }.pr-scroll-cue span { width: 22px; height: 30px; }
    .pr-quickbar__inner { justify-content: flex-start; gap: 8px; overflow-x: auto; padding-top: 8px; padding-bottom: 8px; scrollbar-width: none; }.pr-quickbar__inner::-webkit-scrollbar { display: none; }.pr-quickbar__label { display: none; }.pr-quickbar a { padding-inline: 12px; }
    .pr-section { padding: 78px 0; }.pr-live-section { padding-top: 82px; }.pr-toolkit { padding-top: 8px; }
    .pr-section-head { align-items: flex-start; flex-direction: column; gap: 16px; margin-bottom: 27px; }.pr-section-intro { max-width: 520px; }
    .pr-live-grid { grid-template-columns: 1fr 1fr; }.pr-reset-card { grid-column: span 1; }.pr-event-card { grid-column: span 1; }.pr-code-card { grid-column: span 2; }
    .pr-countdown { font-size: clamp(28px,5vw,37px); }.pr-tools-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }.pr-tool--feature { grid-column: span 2; }
    .pr-season { min-height: 470px; align-items: flex-start; }.pr-season__content { max-width: 620px; padding: 40px 30px; }.pr-season__art { right: -8%; bottom: -10%; width: 66%; height: 70%; opacity: .55; }.pr-gift { right: 16px; bottom: 16px; width: min(235px,42%); }
    .pr-news-grid { grid-template-columns: 1fr; }.pr-news-feature__media,.pr-news-feature__media img { min-height: 220px; }.pr-news-list { display: grid; grid-template-columns: 1fr 1fr; }.pr-news-all { grid-column: 1/-1; }
    .pr-community { grid-template-columns: 72px minmax(0,1fr); gap: 18px; }.pr-community__mark { width: 70px; height: 70px; }.pr-community__mark img { width: 62px; height: 62px; }.pr-community__links { grid-column: 1/-1; display: grid; grid-template-columns: 1fr 1fr 1fr; }.pr-community__links .pr-button { grid-column: span 1; }.pr-community__links > a:not(.pr-button) { min-width: 0; padding-inline: 9px; }
    .pr-faq-layout { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 560px) {
