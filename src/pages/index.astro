    .pr-live-grid { grid-template-columns: 1fr; gap: 10px; }.pr-reset-card,.pr-event-card,.pr-code-card { grid-column: auto; }.pr-live-card { padding: 18px; border-radius: 18px; }.pr-countdown { font-size: 35px; }.pr-card-caption { margin-top: 23px !important; }.pr-event-row { min-height: 60px; }
    .pr-toolkit { padding-top: 0; }.pr-filterbar { overflow-x: auto; flex-wrap: nowrap; padding: 5px; margin: 0 -1px 17px; scrollbar-width: none; }.pr-filterbar::-webkit-scrollbar { display: none; }.pr-filterbar button { flex: 0 0 auto; min-height: 36px; padding-inline: 10px; font-size: 10px; }
