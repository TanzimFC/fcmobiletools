---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FC Mobile Tools" description="FC Mobile tools, Football Centre, calculators and answers from TanzimFC.">
  <main class="home-clean">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">FC MOBILE TOOLS · BY TANZIMFC</p>
        <h1>Play smarter.<br /><span>Find it faster.</span></h1>
        <p class="lead">Practical FC Mobile tools, event resources, calculators and answers in one place.</p>
      </div>
    </section>
    <section class="wrap tools">
      <div class="head"><p class="eyebrow">TOOLS &amp; RESOURCES</p><h2>Useful tools, without the clutter.</h2></div>
      <div class="grid">
        <a href="/football-centre"><b>01 / TRACKER</b><h3>Football Centre</h3><p>Matches, points, rewards and event resources.</p><span>OPEN →</span></a>
        <a href="/team-ovr"><b>02 / CALCULATOR</b><h3>Team OVR</h3><p>Work out Team OVR from your squad and upgrades.</p><span>OPEN →</span></a>
        <a href="/a-nations-story"><b>03 / ANSWERS</b><h3>A Nation's Story</h3><p>Find event questions and their answers.</p><span>SEARCH →</span></a>
        <a href="/training-calculator"><b>04 / CALCULATOR</b><h3>Training Calculator</h3><p>Calculate XP, fodder, excess XP and estimated cost.</p><span>CALCULATE →</span></a>
        <a href="/rank-up-calculator"><b>05 / CALCULATOR</b><h3>Rank Up Calculator</h3><p>Calculate Rank Up Points, OVR gain, Skill Points and cost.</p><span>CALCULATE →</span></a>
        <a href="/creator"><b>06 / TOOL</b><h3>Creator</h3><p>Open the FC Mobile creator resource.</p><span>OPEN →</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
.home-clean{min-height:70vh}.wrap{width:min(1180px,calc(100% - 40px));margin:0 auto}.eyebrow{margin:0;color:var(--blue);font:900 9px var(--mono);letter-spacing:.16em}.hero{padding:110px 0 90px;background:linear-gradient(135deg,var(--surface2),var(--bg));border-bottom:1px solid var(--border)}h1{margin:18px 0;font-size:clamp(52px,8vw,92px);line-height:.9;letter-spacing:-.06em}h1 span{color:var(--blue)}.lead{max-width:600px;color:var(--muted);font-size:14px;line-height:1.8}.tools{padding:70px 0}.head{margin-bottom:28px}.head h2{margin:10px 0 0;font-size:clamp(30px,4vw,48px);letter-spacing:-.05em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid a{position:relative;min-height:190px;padding:22px;border:1px solid var(--border);border-radius:14px;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.grid a:hover{transform:translateY(-3px);border-color:var(--blue)}.grid b,.grid span{font:900 8px var(--mono);color:var(--blue)}.grid h3{margin:38px 0 8px;font-size:21px}.grid p{margin:0;color:var(--muted);font-size:11px;line-height:1.7}.grid span{position:absolute;left:22px;bottom:20px}@media(max-width:760px){.grid{grid-template-columns:1fr}.hero{padding:80px 0 65px}}
</style>
