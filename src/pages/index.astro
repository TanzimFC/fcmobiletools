---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, img, fmtDate, iso } from '../lib/blog.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { summarizeRedeemPayload } from '../lib/redeem-summary.js';
import { safeScriptJson } from '../lib/redeem.js';
import { FOOTBALL_CENTRE_CONTENT as FC } from '../data/footballCentre.js';

/* ───────────────────────── data ───────────────────────── */
const posts = await getPosts();
const latest = posts.slice(0, 5);
const buildTime = Date.now();

// Local Astro development can use the seed data for previewing. Production is hydrated
// from the same D1-backed live endpoint as the Redeem Codes page.
const DEV_REDEEM_SUMMARY = import.meta.env.DEV
  ? { ...summarizeRedeemPayload({ codes: REDEEM_CODES, serverDate: new Date().toISOString().slice(0, 10) }), developmentFallback: true }
  : null;

const rgb = (hex) => [1, 3, 5].map((i) => parseInt(String(hex).slice(i, i + 2), 16) || 0).join(',');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayMonth = (value) => {
  const d = value ? new Date(value) : null;
  return d && !Number.isNaN(d.valueOf()) ? `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}` : '';
};

// Reset time
const [resetH, resetM] = String(FC.schedule?.dailyResetUtc || '01:00').split(':').map((n) => Number(n) || 0);
const resetLabel = `${String(resetH).padStart(2, '0')}:${String(resetM).padStart(2, '0')} UTC`;

// Event radar: live event + upcoming events + next Division Rivals reset, all from the site's own data.
const radar = [];
const pushEvent = (e, kind) => {
  if (!e?.title || !e.startUtc) return;
  const start = Date.parse(e.startUtc);
  if (Number.isNaN(start)) return;
  if (radar.some((r) => r.title.toLowerCase() === e.title.toLowerCase())) return;
  radar.push({ title: e.title, start, kind, label: e.accent || '' });
};
if (FC.eventCountdown?.enabled) pushEvent(FC.eventCountdown, 'event');
if (FC.secondaryEvent?.enabled) pushEvent(FC.secondaryEvent, 'event');
(FC.upcomingEvents ?? []).forEach((e) => pushEvent(e, 'event'));
if (FC.divisionRivalsReset?.enabled) {
  const anchor = Date.parse(FC.divisionRivalsReset.anchorUtc);
  const cycle = (FC.divisionRivalsReset.cycleDays || 28) * 864e5;
  if (!Number.isNaN(anchor)) {
    let next = anchor;
    while (next <= buildTime) next += cycle;
    radar.push({ title: 'Division Rivals reset', start: next, kind: 'reset', label: '' });
  }
}
radar.sort((a, b) => {
  const al = a.start <= buildTime ? 0 : 1;
  const bl = b.start <= buildTime ? 0 : 1;
  return al - bl || a.start - b.start;
});
const radarRows = radar.slice(0, 5);

const gift = FC.maintenanceGift?.enabled ? FC.maintenanceGift : null;
const launchPost = posts.find((p) => p.slug === 'fc-mobile-27-launch-third-anniversary');
const seasonHref = launchPost ? launchPost.href : '/fc-mobile-27';

// Display strings (kept out of the template so the markup stays simple)
radarRows.forEach((r) => {
  r.isLive = r.start <= buildTime;
  r.sub = r.isLive ? 'Since ' + dayMonth(r.start) : dayMonth(r.start);
  r.initial = r.isLive ? 'Live' : dayMonth(r.start);
});
// Current redeem-code UI is hydrated by the shared live summary client.

/* ───────────────────────── icons ───────────────────────── */
const ICON = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  ticket: '<path d="M3 9a2 2 0 0 0 0 6v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 1 0-6V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M13 5v2M13 11v2M13 17v2"/>',
  ovr: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  bolt: '<path d="M13 2 4.5 13H11l-1 9L19.5 11H13z"/>',
  rank: '<path d="m17 11-5-5-5 5"/><path d="m17 18-5-5-5 5"/>',
  shuffle: '<path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/>',
  pulse: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  youtube: '<path d="M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5C1.7 9.7 1.6 10.8 1.6 12s.1 2.3.4 3.5a3 3 0 0 0 2.1 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.3.4-3.5s-.1-2.3-.4-3.5z"/><path d="m10 9 5 3-5 3z"/>',
  discord: '<path d="M7 7c3-1.2 7-1.2 10 0 1.8 2.6 2.7 5.4 2.9 8.6-1.4 1-2.7 1.5-4 1.9l-.9-1.5c.6-.2 1.1-.5 1.6-.9-3.4 1.4-7.8 1.4-11.2 0 .5.4 1 .7 1.6.9l-.9 1.5c-1.3-.4-2.6-.9-4-1.9C4.3 12.4 5.2 9.6 7 7z"/><circle cx="9.5" cy="12.5" r="1"/><circle cx="14.5" cy="12.5" r="1"/>',
  x: '<path d="M4 4l16 16M20 4 4 20"/>',
};
const svg = (name, extra = '') =>
  `<svg class="hx-i ${extra}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICON[name]}</svg>`;

/* ───────────────────────── tools (JSON-LD + count) ───────────────────────── */
const tools = [
  { href: '/redeem-codes', name: 'Redeem Codes' }, { href: '/team-ovr', name: 'Team OVR Calculator' },
  { href: '/training-calculator', name: 'Training Calculator' }, { href: '/rank-up-calculator', name: 'Rank Up Calculator' },
  { href: '/gauntlet-planner', name: 'Gauntlet Planner' }, { href: '/investment-calculator', name: 'Investment Calculator' },
  { href: '/shards-counter', name: 'Shards Counter' }, { href: '/trivia/', name: 'Trivia Answers' },
  { href: '/football-centre', name: 'Football Centre' }, { href: '/events', name: 'Events & Resets' },
];

/* ───────────────── beginner path: start from the goal, not the tool name ───────────────── */
const intents = [
  { goal: 'Get free rewards', help: 'See today’s working redeem codes and copy one in a tap.', name: 'Redeem codes', href: '/redeem-codes', live: true },
  { goal: 'Know what’s happening in the game', help: 'Event countdowns, resets and what each one gives you.', name: 'Events & resets', href: '/events' },
  { goal: 'Check how strong my squad is', help: 'Add your players and get your Team OVR instantly.', name: 'Team OVR calculator', href: '/team-ovr' },
  { goal: 'Plan my player upgrades', help: 'Work out the XP, cards and coins an upgrade will cost.', name: 'Training calculator', href: '/training-calculator', alt: { name: 'Rank Up calculator', href: '/rank-up-calculator' } },
  { goal: 'Decide if a trade is worth it', help: 'Enter the buy and sell price to see profit after tax.', name: 'Investment calculator', href: '/investment-calculator' },
  { goal: 'Plan my Gauntlet matches', help: 'Spread your players across matches so nobody runs out.', name: 'Gauntlet planner', href: '/gauntlet-planner' },
  { goal: 'Find trivia answers', help: 'Search any question, then practise until you know it.', name: 'Trivia answers', href: '/trivia/' },
  { goal: 'Track my Star Shards', help: 'Set a target and see exactly how far you are.', name: 'Shards counter', href: '/shards-counter', alt: { name: 'Football Centre', href: '/football-centre' } },
];

/* ───────────────────────── FAQ (single source for page + JSON-LD) ───────────────────────── */
const faqs = [
  { q: 'What is FCMOBILETOOLS?', a: 'FCMOBILETOOLS is a fan-made FC Mobile resource hub for redeem codes, live events, reset times, calculators, planners, guides and game updates. It is not affiliated with EA SPORTS or FC Mobile.' },
  { q: 'Where can I find current FC Mobile redeem codes?', a: 'The Redeem Codes page lists the status and reward of every code and points you to the official EA redemption flow.' },
  { q: 'Which FC Mobile tools are available?', a: "Team OVR, Training, Rank Up and Investment calculators, the Gauntlet Planner, Shards Counter, Football Centre and A Nation's Story answer finder." },
  { q: 'When does the FC Mobile daily reset happen?', a: `The daily reset is at ${resetLabel}. The live countdown at the top of this page shows the time remaining and converts the reset to your own time zone.` },
];

const SITE = 'https://fcmobiletools.online';
const title = 'FC Mobile Tools, Codes & Calculators';
const description =
  'FCMOBILETOOLS is the FC Mobile hub for redeem codes, live events, reset times, calculators, the Shards Counter, planners, event answers, guides and the latest Season 27 updates.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': SITE + '/#homepage', url: SITE + '/', name: title, description, isPartOf: { '@id': SITE + '/#website' } },
    {
      '@type': 'ItemList',
      name: 'FC Mobile tools and resources',
      itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: SITE + t.href })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="hx" id="main">

    <!-- ═════════════ HERO ═════════════ -->
    <section class="hx-hero" aria-labelledby="hx-h1">
      <picture class="hx-hero__img" aria-hidden="true">
        <source media="(max-width: 700px)" srcset="/assets/images/hero-home-mobile.webp" type="image/webp" />
        <img src="/assets/images/hero-home.webp" alt="" width="1918" height="820" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hx-hero__shade" aria-hidden="true"></div>

      <div class="wrap hx-hero__inner">
        <h1 id="hx-h1" class="hx-h1">Free codes, timers and calculators for FC&nbsp;Mobile.</h1>
        <p class="hx-lead">Check today’s redeem codes, see when the next event starts, and work out your upgrades. No account needed.</p>
        <div class="hx-actions">
          <a class="btn hx-btn primary" href="/redeem-codes"><span>Get today’s codes</span><span set:html={svg('arrow')} /></a>
          <a class="btn hx-btn ghost" href="#start"><span>New here? Start here</span></a>
        </div>
      </div>
    </section>

    <!-- ═════════════ SCOREBOARD ═════════════ -->
    <section class="wrap hx-board-wrap" aria-label="Live status">
      <div class="hx-board">

        <article class="hx-cell hx-reset">
          <h2 class="hx-label">Next daily reset</h2>
          <div class="hx-clock" role="timer" aria-label="Time until next daily reset">
            <span data-hx-h>--</span><i>:</i><span data-hx-m>--</span><i>:</i><span data-hx-s>--</span>
          </div>
          <div class="hx-bar" aria-hidden="true"><span data-hx-bar></span></div>
          <p class="hx-sub">Your time <b data-hx-local>--:--</b> <span class="hx-dim">· <span data-hx-tz>local</span> · {resetLabel}</span></p>
        </article>

        <article class="hx-cell hx-radar">
          <div class="hx-cell__head">
            <h2 class="hx-label">What’s on</h2>
            <a class="hx-textlink" href="/events">All events</a>
          </div>
          <ul class="hx-radar__list">
            {radarRows.slice(0, 4).map((r) => (
              <li>
                <a href="/events" class:list={['hx-row', r.isLive && 'is-live']} data-hx-ts={r.start} data-hx-kind={r.kind}>
                  <span class="hx-row__main"><b>{r.title}</b><small>{r.sub}</small></span>
                  <span class="hx-row__cd" data-hx-cd>{r.initial}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>

        <article class="hx-cell hx-code is-none" data-fcmt-current-code>
          <div class="hx-cell__head">
            <h2 class="hx-label">Redeem code</h2>
            <span class="hx-chip" data-fcmt-code-status>Loading</span>
          </div>
          <div class="hx-code__body" data-fcmt-code-body>
            <p class="hx-code__none">Checking for the latest code…</p>
            <a class="hx-textlink" href="/redeem-codes/">Open full code list →</a>
          </div>
          <p class="hx-sub hx-dim" data-fcmt-code-foot>Live data from the Redeem Codes page</p>
        </article>
      </div>
    </section>

    <!-- ═════════════ START HERE ═════════════ -->
    <section class="sec" id="start" aria-labelledby="hx-start-h">
      <div class="wrap hx-start">
        <div class="hx-start__lead">
          <h2 id="hx-start-h">New here? Start with what you want to do.</h2>
          <p>Pick a goal and we’ll open the right tool. Every tool begins with a short guide, so you’re never left guessing.</p>
          <p class="hx-dim">{posts.length} guides · {tools.length} free tools · no sign-up to use them</p>
        </div>
        <ul class="hx-intents">
          {intents.map((t) => (
            <li>
              <a class="hx-intent" href={t.href}>
                <span class="hx-intent__goal">{t.goal}{t.live && <em class="hx-chip live" data-fcmt-code-count>Live</em>}</span>
                <span class="hx-intent__help">{t.help}</span>
                <span class="hx-intent__go">{t.name} <span set:html={svg('arrow')} /></span>
              </a>
              {t.alt && <a class="hx-intent__alt" href={t.alt.href}>Or open {t.alt.name}</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═════════════ SEASON 27 ═════════════ -->
    <section class="sec" aria-labelledby="hx-s27-h">
      <div class="wrap">
        <div class="hx-season">
          <img class="hx-season__art" src="/assets/images/hero-striker.webp" alt="" width="900" height="711" loading="lazy" decoding="async" />
          <div class="hx-season__copy">
            <p class="chip live">Season 27</p>
            <h2 id="hx-s27-h">FC Mobile 27 is live.</h2>
            <p>The third-anniversary season landed on 24 September with Game Plans, Gauntlet Mode, PlayStyles and major optimizations. It keeps your existing club instead of wiping it.</p>
            <div class="hx-actions">
              <a class="btn hx-btn primary" href={seasonHref}><span>Read the launch guide</span><span set:html={svg('arrow')} /></a>
              <a class="btn hx-btn ghost" href="/fc-mobile-27"><span>Update hub</span></a>
            </div>
          </div>
          {gift && (
            <aside class="hx-gift" aria-label={gift.title}>
              <h3>{gift.title}</h3>
              <ul>{(gift.items ?? []).map((item) => <li><span set:html={svg('check')} />{item}</li>)}</ul>
              <small>{gift.note}</small>
            </aside>
          )}
        </div>
      </div>
    </section>

    <!-- ═════════════ ARTICLES ═════════════ -->
    <section class="sec" aria-labelledby="hx-news-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="hx-news-h">Latest from the journal</h2>
          <a class="sec-link" href="/blog">All articles →</a>
        </div>

        {latest.length ? (
          <div class="hx-news">
            <a class="hx-feature" href={latest[0].href}>
              <span class="hx-feature__media">
                {latest[0].cover
                  ? <img src={img(latest[0].cover, 1100)} alt={latest[0].imageAlt || ''} width="1100" height="619" loading="lazy" decoding="async" />
                  : <span class="hx-feature__ph">FC Mobile Tools</span>}
              </span>
              <span class="hx-feature__body">
                <span class="hx-meta"><b>{latest[0].section.label}</b>{latest[0].date && <time datetime={iso(latest[0].date)}>{fmtDate(latest[0].date, 'medium')}</time>}<span>{latest[0].minutes} min read</span></span>
                <h3>{latest[0].title}</h3>
                <p>{latest[0].excerpt}</p>
              </span>
            </a>
            <ul class="hx-list">
              {latest.slice(1).map((p) => (
                <li>
                  <a class="hx-item" href={p.href}>
                    <span class="hx-item__media">{p.cover ? <img src={img(p.cover, 360)} alt="" width="360" height="240" loading="lazy" decoding="async" /> : <span>FC</span>}</span>
                    <span class="hx-item__body">
                      <span class="hx-meta"><b>{p.section.label}</b>{p.date && <time datetime={iso(p.date)}>{fmtDate(p.date, 'short')}</time>}</span>
                      <h3>{p.title}</h3>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="hx-dim">New articles are on the way.</p>
        )}
      </div>
    </section>

    <!-- ═════════════ FAQ ═════════════ -->
    <section class="sec" aria-labelledby="hx-faq-h">
      <div class="wrap hx-faq">
        <div>
          <h2 id="hx-faq-h">Quick answers</h2>
          <p class="hx-dim">The basics, in plain words. Still stuck? Ask in our Discord.</p>
          <a class="sec-link" href="/legal/about">About FCMOBILETOOLS →</a>
        </div>
        <div class="hx-faq__list">
          {faqs.map((f, i) => (
            <details name="hx-faq" open={i === 0}>
              <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═════════════ COMMUNITY ═════════════ -->
    <section class="sec" aria-labelledby="hx-cta-h">
      <div class="wrap">
        <div class="hx-cta">
          <img class="hx-cta__logo" src="/assets/images/creator-tf.webp" alt="TanzimFC logo" width="481" height="512" loading="lazy" decoding="async" />
          <div class="hx-cta__copy">
            <h2 id="hx-cta-h">Made by a player, for players.</h2>
            <p>New tools and guides land as FC Mobile changes. Follow along and tell us what to build next.</p>
          </div>
          <div class="hx-cta__links">
            <a class="btn hx-btn primary" href="https://discord.gg/nRzsqCurUb" target="_blank" rel="noopener"><span set:html={svg('discord')} /><span>Join Discord</span></a>
            <a class="btn hx-btn ghost" href="https://www.youtube.com/@tanzimfc" target="_blank" rel="noopener"><span set:html={svg('youtube')} /><span>YouTube</span></a>
            <a class="btn hx-btn ghost" href="https://x.com/TanzimFC" target="_blank" rel="noopener"><span set:html={svg('x')} /><span>X</span></a>
          </div>
        </div>
      </div>
    </section>

    <script type="application/json" id="fcmt-current-redeem-bootstrap" is:inline set:html={safeScriptJson(DEV_REDEEM_SUMMARY)}></script>
    <script>import '../scripts/current-redeem-code.js';</script>

    <script define:vars={{ resetH, resetM }}>
(() => {
  const root = document.querySelector('.hx');
  if (!root) return;
  const pad = (n) => String(n).padStart(2, '0');
  const DAY = 864e5;

  /* daily reset clock */
  const elH = root.querySelector('[data-hx-h]');
  const elM = root.querySelector('[data-hx-m]');
  const elS = root.querySelector('[data-hx-s]');
  const elBar = root.querySelector('[data-hx-bar]');
  const elLocal = root.querySelector('[data-hx-local]');
  const elTz = root.querySelector('[data-hx-tz]');
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (elTz && tz) elTz.textContent = tz.split('/').pop().replace(/_/g, ' ');
  } catch (_) {}
  const nextReset = (now) => {
    const d = new Date(now);
    let t = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), resetH, resetM);
    if (t <= now) t += DAY;
    return t;
  };
  if (elLocal) elLocal.textContent = new Date(nextReset(Date.now())).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  /* event countdowns */
  const rows = [...root.querySelectorAll('[data-hx-ts]')].map((row) => ({ row, ts: Number(row.dataset.hxTs), out: row.querySelector('[data-hx-cd]') }));
  const fmtLeft = (ms) => {
    const s = Math.max(0, Math.floor(ms / 1000));
    const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
    return d > 0 ? `${d}d ${pad(h)}h ${pad(m)}m` : `${pad(h)}:${pad(m)}:${pad(s % 60)}`;
  };

  /* redeem code expiry (static build, so double-check on the client) */
  const codeCard = root.querySelector('.hx-code');
  let trackedCode = '', trackedExpiry = NaN, codeExpired = false;
  const expireCode = () => {
    if (codeExpired || !codeCard || !trackedCode) return;
    codeExpired = true;
    codeCard.classList.remove('is-active');
    codeCard.classList.add('is-none', 'is-expired');
    const st = codeCard.querySelector('[data-fcmt-code-status]');
    if (st) st.textContent = 'Expired';
    const btn = codeCard.querySelector('[data-hx-copy]');
    if (btn) btn.disabled = true;
  };

  const tick = () => {
    const now = Date.now();
    if (elH) {
      const left = nextReset(now) - now;
      const s = Math.floor(left / 1000);
      elH.textContent = pad(Math.floor(s / 3600));
      elM.textContent = pad(Math.floor((s % 3600) / 60));
      elS.textContent = pad(s % 60);
      if (elBar) elBar.style.transform = `scaleX(${Math.min(1, Math.max(0, 1 - left / DAY)).toFixed(4)})`;
    }
    for (const r of rows) {
      if (!r.out) continue;
      if (r.ts <= now) {
        r.row.classList.add('is-live');
        const day = Math.floor((now - r.ts) / DAY) + 1;
        r.out.textContent = r.row.dataset.hxKind === 'reset' ? 'Now' : `Live · Day ${day}`;
      } else {
        r.out.textContent = fmtLeft(r.ts - now);
      }
    }
    const liveCopy = codeCard?.querySelector('[data-hx-copy]');
    const currentCode = liveCopy?.dataset.hxCopy || '';
    const currentExpiry = codeCard?.dataset.hxExpires ? Number(codeCard.dataset.hxExpires) : NaN;
    if (currentCode !== trackedCode || currentExpiry !== trackedExpiry) {
      trackedCode = currentCode; trackedExpiry = currentExpiry; codeExpired = false;
      codeCard?.classList.remove('is-expired');
    }
    if (currentCode && Number.isFinite(currentExpiry) && now > currentExpiry) expireCode();
  };
  tick();
  setInterval(tick, 1000);
})();
    </script>
  </main>
</BaseLayout>

