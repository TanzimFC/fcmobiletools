  @media (max-width: 370px) {
    .pr-display { font-size: 37px; }.pr-hero__proof span { font-size: 8px; }.pr-tools-grid { grid-template-columns: 1fr; }.pr-tool--feature { grid-column: auto; }.pr-tool { min-height: 195px; }.pr-tool__bottom { flex-direction: row; align-items: center; }.pr-season h2 { font-size: 38px; }.pr-community h2 { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-home *, .pr-home *::before, .pr-home *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; transition-delay: 0ms !important; }
    .pr-home.pr-js .pr-reveal { opacity: 1 !important; transform: none !important; }
  }
</style>

<script define:vars={{ resetH, resetM }}>
(() => {
  const root = document.querySelector('.pr-home');
  if (!root) return;
  root.classList.add('pr-js');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (value) => String(value).padStart(2, '0');
  const dayMs = 864e5;
  const hoursOut = root.querySelector('[data-pr-hours]');
  const minutesOut = root.querySelector('[data-pr-minutes]');
  const secondsOut = root.querySelector('[data-pr-seconds]');
  const progressOut = root.querySelector('[data-pr-progress]');
  const localOut = root.querySelector('[data-pr-local]');
  const nextReset = (now) => {
    const date = new Date(now);
    let resetAt = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), resetH, resetM);
    if (resetAt <= now) resetAt += dayMs;
    return resetAt;
  };
  if (localOut) localOut.textContent = new Date(nextReset(Date.now())).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const eventRows = Array.from(root.querySelectorAll('[data-pr-event]')).map((row) => ({ row, ts: Number(row.dataset.ts), out: row.querySelector('[data-pr-event-time]') }));
  const formatEventTime = (ms) => {
    const secs = Math.max(0, Math.floor(ms / 1000));
    const days = Math.floor(secs / 86400);
    const hours = Math.floor((secs % 86400) / 3600);
    const mins = Math.floor((secs % 3600) / 60);
    return days > 0 ? days + 'd ' + pad(hours) + 'h' : pad(hours) + ':' + pad(mins);
  };
  const codeCard = root.querySelector('[data-pr-code-card]');
  const codeExpires = codeCard ? Number(codeCard.dataset.expires) : NaN;
  const expireCode = () => {
    if (!codeCard || codeCard.classList.contains('is-expired')) return;
    codeCard.classList.add('is-expired');
    const status = codeCard.querySelector('[data-pr-code-status]');
    if (status) status.textContent = 'EXPIRED';
    const copy = codeCard.querySelector('[data-pr-copy]');
    if (copy) copy.disabled = true;
  };
  const tick = () => {
    const now = Date.now();
    if (hoursOut && minutesOut && secondsOut) {
      const left = Math.max(0, nextReset(now) - now);
      const secs = Math.floor(left / 1000);
      hoursOut.textContent = pad(Math.floor(secs / 3600));
      minutesOut.textContent = pad(Math.floor((secs % 3600) / 60));
      secondsOut.textContent = pad(secs % 60);
      if (progressOut) progressOut.style.transform = 'scaleX(' + Math.min(1, Math.max(0, 1 - left / dayMs)).toFixed(4) + ')';
    }
    eventRows.forEach(({ row, ts, out }) => {
      if (!out || !Number.isFinite(ts)) return;
      if (ts <= now) {
        row.classList.add('is-live');
        const elapsedDays = Math.floor((now - ts) / dayMs) + 1;
        out.textContent = row.dataset.kind === 'reset' ? 'Reset' : 'LIVE · D' + elapsedDays;
      } else {
        out.textContent = formatEventTime(ts - now);
      }
    });
    if (codeCard && Number.isFinite(codeExpires) && codeExpires > 0 && now > codeExpires) expireCode();
  };
  tick();
  window.setInterval(tick, 1000);

  const copyButton = root.querySelector('[data-pr-copy]');
  if (copyButton) {
    const label = copyButton.querySelector('[data-pr-copy-label]');
    let restoreTimer;
    copyButton.addEventListener('click', async () => {
      const value = copyButton.dataset.prCopy || '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch (_) {
        const input = document.createElement('textarea');
        input.value = value;
        input.setAttribute('readonly', '');
        input.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
        document.body.appendChild(input);
        input.select();
        try { copied = document.execCommand('copy'); } catch (_) {}
        input.remove();
      }
      copyButton.classList.toggle('is-copied', copied);
      if (label) label.textContent = copied ? 'Copied' : 'Select to copy';
      window.clearTimeout(restoreTimer);
      restoreTimer = window.setTimeout(() => {
        copyButton.classList.remove('is-copied');
        if (label) label.textContent = 'Copy';
      }, 1700);
    });
  }

  const filters = Array.from(root.querySelectorAll('[data-pr-filter]'));
  const toolCards = Array.from(root.querySelectorAll('[data-pr-tool]'));
  const emptyState = root.querySelector('[data-pr-filter-empty]');
  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.prFilter || 'all';
      filters.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-selected', active);
        item.setAttribute('aria-pressed', String(active));
      });
      let visible = 0;
      toolCards.forEach((card) => {
        const show = selected === 'all' || card.dataset.category === selected;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (emptyState) emptyState.hidden = visible > 0;
    });
  });

  const cards = Array.from(root.querySelectorAll('[data-pr-tool]'));
  if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    cards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        card.style.setProperty('--mx', x + 'px');
        card.style.setProperty('--my', y + 'px');
        const rx = ((y / rect.height) - .5) * -2.4;
        const ry = ((x / rect.width) - .5) * 2.4;
        card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
        card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
      }, { passive: true });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  const reveals = Array.from(root.querySelectorAll('.pr-reveal'));
  if (reducedMotion || !('IntersectionObserver' in window)) {
    reveals.forEach((element) => element.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: .09, rootMargin: '0px 0px -4% 0px' });
    reveals.forEach((element) => observer.observe(element));
  }
})();
</script>
