  .hx-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 22px 50px -12px rgba(76, 201, 255, .75), inset 0 1px 0 rgba(255, 255, 255, .4); }
  .hx-btn--ghost { color: var(--text); background: rgba(255, 255, 255, .05); border-color: var(--line); backdrop-filter: blur(14px); }
  .hx-btn--ghost:hover { transform: translateY(-2px); border-color: rgba(76, 201, 255, .5); background: rgba(76, 201, 255, .08); }
  .hx-textlink { display: inline-flex; align-items: center; gap: 6px; color: var(--cyan-soft); font: 600 14px/1 var(--body); }
  .hx-textlink .hx-i { font-size: 16px; transition: transform .2s var(--ease); }
  .hx-textlink:hover .hx-i, a:hover > .hx-textlink .hx-i, a:hover .hx-textlink .hx-i { transform: translate(2px, -2px); }
  .hx-textlink--lg { font-size: 15px; }

  /* ───────── HERO ───────── */
  .hx-hero { position: relative; isolation: isolate; display: flex; align-items: center; min-height: clamp(660px, 90svh, 880px); padding: 140px 0 190px; overflow: hidden; }
  .hx-hero__img { position: absolute; inset: 0; z-index: -3; background: #07131c; }
