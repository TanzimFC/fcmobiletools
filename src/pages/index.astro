  .pr-community__mark { width: 96px; height: 96px; display: grid; place-items: center; overflow: hidden; border-radius: 23px; border: 1px solid rgba(76,201,255,.17); background: rgba(76,201,255,.05); box-shadow: inset 0 1px 0 rgba(255,255,255,.05); }.pr-community__mark img { width: 88px; height: 88px; object-fit: contain; }
  .pr-community__copy .pr-overline { margin-bottom: 12px !important; }.pr-community h2 { font-size: clamp(26px,3.1vw,39px); line-height: 1.05; }.pr-community__copy > p:last-child { max-width: 600px; margin-top: 12px !important; color: #91a6b4; font-size: 11px; line-height: 1.75; }
  .pr-community__links { display: flex; flex-direction: column; gap: 8px; }.pr-community__links .pr-button { min-height: 45px; justify-content: flex-start; padding-inline: 13px; }.pr-community__links .pr-button .pr-icon:first-child { width: 16px; height: 16px; }.pr-community__links .pr-button .pr-icon:last-child { margin-left: auto; }.pr-community__links > a:not(.pr-button) { min-height: 41px; display: flex; align-items: center; gap: 10px; padding: 0 13px; border: 1px solid rgba(185,216,235,.09); border-radius: 12px; color: #acbdc9; font-size: 10px; font-weight: 700; transition: .2s; }.pr-community__links > a:not(.pr-button) .pr-icon { width: 16px; height: 16px; color: var(--pr-cyan); }.pr-community__links > a:not(.pr-button) span:last-child { margin-left: auto; color: #6e8799; }.pr-community__links > a:not(.pr-button):hover { border-color: rgba(76,201,255,.24); color: #fff; background: rgba(76,201,255,.04); }

  /* FAQ */
  .pr-faq-section { padding-top: 55px; }
  .pr-faq-layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(38px,8vw,120px); }
  .pr-faq-intro h2 { font-size: clamp(34px,4vw,52px); }.pr-faq-intro > p:not(.pr-overline) { margin-top: 18px !important; max-width: 320px; color: #8fa3b0; font-size: 12px; line-height: 1.85; }.pr-faq-intro .pr-text-link { margin-top: 23px; }
  .pr-faq-list details { border-bottom: 1px solid rgba(185,216,235,.1); }.pr-faq-list details:first-child { border-top: 1px solid rgba(185,216,235,.1); }
  .pr-faq-list summary { min-height: 74px; display: flex; align-items: center; gap: 15px; cursor: pointer; list-style: none; color: #dce8ef; font-size: 13px; font-weight: 700; }.pr-faq-list summary::-webkit-details-marker { display: none; }
  .pr-faq-number { color: #54758a; font: 800 9px/1 var(--pr-display); }.pr-faq-list summary > span:nth-child(2) { flex: 1; }.pr-faq-list summary i { width: 28px; height: 28px; flex: 0 0 28px; position: relative; border: 1px solid rgba(185,216,235,.13); border-radius: 9px; background: rgba(255,255,255,.025); }.pr-faq-list summary i::before,.pr-faq-list summary i::after { content: ""; position: absolute; left: 50%; top: 50%; width: 9px; height: 1px; transform: translate(-50%,-50%); background: #8ea4b3; transition: transform .2s; }.pr-faq-list summary i::after { transform: translate(-50%,-50%) rotate(90deg); }.pr-faq-list details[open] summary i { border-color: rgba(76,201,255,.25); background: rgba(76,201,255,.07); }.pr-faq-list details[open] summary i::after { transform: translate(-50%,-50%) rotate(0); }
  .pr-faq-list details > p { padding: 0 48px 23px 31px; color: #8da2b0; font-size: 12px; line-height: 1.85; }

  /* Motion and reveal */
  .pr-rise { animation: pr-rise .85s var(--pr-ease) var(--delay,0s) both; }
  .pr-reveal { opacity: 1; transform: none; }
  .pr-home.pr-js .pr-reveal { opacity: 0; transform: translateY(20px); transition: opacity .65s var(--pr-ease),transform .65s var(--pr-ease); transition-delay: var(--stagger,0ms); }
  .pr-home.pr-js .pr-reveal.is-visible { opacity: 1; transform: none; }
  .pr-home.pr-js .pr-tool.pr-reveal { transform: perspective(1100px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(14px); }
  .pr-home.pr-js .pr-tool.pr-reveal.is-visible { transform: perspective(1100px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(0); }
  .pr-home.pr-js .pr-tool.pr-reveal:hover.is-visible { transform: perspective(1100px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(-3px); }
  .pr-home.pr-js .pr-reveal[hidden] { display: none !important; }
  @keyframes pr-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes pr-image-enter { from { opacity: .3; transform: scale(1.035); } to { opacity: .86; transform: scale(1); } }
  @keyframes pr-pulse { 70% { box-shadow: 0 0 0 9px rgba(110,240,194,0); } 100% { box-shadow: 0 0 0 0 rgba(110,240,194,0); } }
  @keyframes pr-orbit { to { transform: rotate(360deg); } }
  @keyframes pr-scroll { 0%,100% { transform: translate(-50%,0); opacity: 1; } 70% { transform: translate(-50%,11px); opacity: 0; } }

  @media (max-width: 1120px) {
    .pr-hero__layout { grid-template-columns: minmax(0,1fr) 320px; gap: 34px; }
    .pr-display { font-size: clamp(46px,6.3vw,76px); }
    .pr-live-grid { grid-template-columns: .95fr 1.1fr; }.pr-code-card { grid-column: span 2; }
    .pr-code-card { min-height: 210px; }.pr-tool { min-height: 226px; padding: 16px; }.pr-tool--feature { padding: 20px; }
    .pr-tools-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .pr-community { grid-template-columns: 80px minmax(0,1fr) 215px; gap: 22px; padding: 27px; }.pr-community__mark { width: 78px; height: 78px; border-radius: 20px; }.pr-community__mark img { width: 70px; height: 70px; }
    .pr-news-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 820px) {
