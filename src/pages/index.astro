---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, img, fmtDate, iso } from '../lib/blog.js';
import { REDEEM_CODES } from '../data/redeemCodes.js';
import { FOOTBALL_CENTRE_CONTENT as FC } from '../data/footballCentre.js';

/* ───────────────────────── data ───────────────────────── */
const posts = await getPosts();
const latest = posts.slice(0, 5);
const buildTime = Date.now();

// Codes: only call a code "active" if its status says so AND it has not passed its expiry date.
const isLiveCode = (c) =>
  c.status === 'active' && (!c.expiryDate || Date.parse(c.expiryDate + 'T23:59:59Z') > buildTime);
const liveCodes = REDEEM_CODES.filter(isLiveCode);
const featuredCode = liveCodes[0] ?? null;
const lastCode = featuredCode ?? REDEEM_CODES[0] ?? null;
const lastChecked = REDEEM_CODES.map((c) => c.lastVerified).filter(Boolean).sort().pop() ?? null;

const rgb = (hex) => [1, 3, 5].map((i) => parseInt(String(hex).slice(i, i + 2), 16) || 0).join(',');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayMonth = (value) => {
  const d = value ? new Date(value) : null;
  return d && !Number.isNaN(d.valueOf()) ? `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]}` : '';
};

// Reset time
const [resetH, resetM] = String(FC.schedule?.dailyResetUtc || '01:00').split(':').map((n) => Number(n) || 0);
const resetLabel = `${String(resetH).padStart(2, '0')}:${String(resetM).padStart(2, '0')} UTC`;

// Event radar: live event + upcoming events + next Division Rivals reset, all from the site's own data.
const radar = [];
const pushEvent = (e, kind) => {
  if (!e?.title || !e.startUtc) return;
  const start = Date.parse(e.startUtc);
  if (Number.isNaN(start)) return;
  if (radar.some((r) => r.title.toLowerCase() === e.title.toLowerCase())) return;
  radar.push({ title: e.title, start, kind, label: e.accent || '' });
};
if (FC.eventCountdown?.enabled) pushEvent(FC.eventCountdown, 'event');
if (FC.secondaryEvent?.enabled) pushEvent(FC.secondaryEvent, 'event');
(FC.upcomingEvents ?? []).forEach((e) => pushEvent(e, 'event'));
if (FC.divisionRivalsReset?.enabled) {
  const anchor = Date.parse(FC.divisionRivalsReset.anchorUtc);
  const cycle = (FC.divisionRivalsReset.cycleDays || 28) * 864e5;
  if (!Number.isNaN(anchor)) {
    let next = anchor;
    while (next <= buildTime) next += cycle;
    radar.push({ title: 'Division Rivals reset', start: next, kind: 'reset', label: '' });
  }
}
radar.sort((a, b) => {
  const al = a.start <= buildTime ? 0 : 1;
  const bl = b.start <= buildTime ? 0 : 1;
  return al - bl || a.start - b.start;
});
const radarRows = radar.slice(0, 5);

const gift = FC.maintenanceGift?.enabled ? FC.maintenanceGift : null;
const launchPost = posts.find((p) => p.slug === 'fc-mobile-27-launch-third-anniversary');
const seasonHref = launchPost ? launchPost.href : '/fc-mobile-27';

// Display strings (kept out of the template so the markup stays simple)
const kicker = ['FC Mobile 27', FC.eventCountdown?.accent].filter(Boolean).join(' · ');
radarRows.forEach((r) => {
  r.isLive = r.start <= buildTime;
  r.sub = r.isLive ? 'Since ' + dayMonth(r.start) : dayMonth(r.start);
  r.initial = r.isLive ? 'Live' : dayMonth(r.start);
});
const recentCodes = REDEEM_CODES.slice(0, 3).map((c) => ({ code: c.code, reward: c.reward, live: isLiveCode(c) }));
const codeFoot = featuredCode
  ? (featuredCode.region || 'Global') + ' · verified ' + dayMonth(featuredCode.lastVerified)
  : (lastChecked ? 'Checked ' + dayMonth(lastChecked) : 'Checked regularly');
const codeNote = lastCode
  ? (lastCode.expiryDate ? ' expired ' + dayMonth(lastCode.expiryDate) : ' has expired')
  : '';

/* ───────────────────────── icons ───────────────────────── */
const ICON = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  ticket: '<path d="M3 9a2 2 0 0 0 0 6v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a2 2 0 0 1 0-6V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M13 5v2M13 11v2M13 17v2"/>',
  ovr: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  bolt: '<path d="M13 2 4.5 13H11l-1 9L19.5 11H13z"/>',
  rank: '<path d="m17 11-5-5-5 5"/><path d="m17 18-5-5-5 5"/>',
  shuffle: '<path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/>',
  pulse: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/>',
  youtube: '<path d="M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5C1.7 9.7 1.6 10.8 1.6 12s.1 2.3.4 3.5a3 3 0 0 0 2.1 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1c.3-1.2.4-2.3.4-3.5s-.1-2.3-.4-3.5z"/><path d="m10 9 5 3-5 3z"/>',
  discord: '<path d="M7 7c3-1.2 7-1.2 10 0 1.8 2.6 2.7 5.4 2.9 8.6-1.4 1-2.7 1.5-4 1.9l-.9-1.5c.6-.2 1.1-.5 1.6-.9-3.4 1.4-7.8 1.4-11.2 0 .5.4 1 .7 1.6.9l-.9 1.5c-1.3-.4-2.6-.9-4-1.9C4.3 12.4 5.2 9.6 7 7z"/><circle cx="9.5" cy="12.5" r="1"/><circle cx="14.5" cy="12.5" r="1"/>',
  x: '<path d="M4 4l16 16M20 4 4 20"/>',
};
const svg = (name, extra = '') =>
  `<svg class="hx-i ${extra}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICON[name]}</svg>`;

/* ───────────────────────── tools ───────────────────────── */
const CYAN = '#4CC9FF', MINT = '#6EF0C2', AMBER = '#FFC36B', VIOLET = '#A99BFF';
const tools = [
  { href: '/redeem-codes', tag: 'Live', name: 'Redeem Codes', text: 'Every code with its reward, region and status, plus a direct route to official redemption.', icon: 'ticket', accent: MINT, size: 'hero' },
  { href: '/team-ovr', tag: 'Calculator', name: 'Team OVR', text: 'Check your squad rating before you upgrade.', icon: 'ovr', accent: CYAN, size: 'sm' },
  { href: '/training-calculator', tag: 'Calculator', name: 'Training Calculator', text: 'Plan XP, fodder and training levels.', icon: 'bolt', accent: CYAN, size: 'sm' },
  { href: '/rank-up-calculator', tag: 'Calculator', name: 'Rank Up Calculator', text: 'Compare Rank Up costs and OVR gains.', icon: 'rank', accent: CYAN, size: 'sm' },
  { href: '/gauntlet-planner', tag: 'Planner', name: 'Gauntlet Planner', text: 'Plan rotations and player availability.', icon: 'shuffle', accent: VIOLET, size: 'sm' },
  { href: '/football-centre', tag: 'Tracker', name: 'Football Centre', text: 'Showdown results, points progress and event resources in one live hub.', icon: 'pulse', accent: MINT, size: 'wide' },
  { href: '/a-nations-story', tag: 'Answers', name: "A Nation's Story", text: 'Event answers without the digging.', icon: 'book', accent: AMBER, size: 'sm' },
  { href: '/fc-mobile-27', tag: 'Season 27', name: 'FC Mobile 27', text: 'Update hub with features, install guide and coverage.', icon: 'star', accent: AMBER, size: 'sm' },
];

/* ───────────────────────── FAQ (single source for page + JSON-LD) ───────────────────────── */
const faqs = [
  { q: 'What is FCMOBILETOOLS?', a: 'FCMOBILETOOLS is a fan-made FC Mobile resource hub for redeem codes, live events, reset times, calculators, planners, guides and game updates. It is not affiliated with EA SPORTS or FC Mobile.' },
  { q: 'Where can I find current FC Mobile redeem codes?', a: 'The Redeem Codes page lists the status and reward of every code and points you to the official EA redemption flow.' },
  { q: 'Which FC Mobile calculators are available?', a: 'Team OVR, Training and Rank Up calculators, plus an Investment Calculator and a Gauntlet Mode Planner for squad rotation.' },
  { q: 'When does the FC Mobile daily reset happen?', a: `The daily reset is at ${resetLabel}. The live countdown at the top of this page shows the time remaining and converts the reset to your own time zone.` },
];

const SITE = 'https://fcmobiletools.online';
const title = 'FC Mobile Tools, Redeem Codes, Calculators & Guides';
const description =
  'FCMOBILETOOLS is the FC Mobile hub for redeem codes, live events, reset times, calculators, planners, guides and the latest Season 27 updates.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': SITE + '/#homepage', url: SITE + '/', name: title, description, isPartOf: { '@id': SITE + '/#website' } },
    {
      '@type': 'ItemList',
      name: 'FC Mobile tools and resources',
      itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: SITE + t.href })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="hx" id="main">

    <!-- ═════════════ HERO ═════════════ -->
    <section class="hx-hero" aria-labelledby="hx-h1">
      <picture class="hx-hero__img" aria-hidden="true">
        <source media="(max-width: 700px)" srcset="/assets/images/hero-home-mobile.webp" type="image/webp" />
        <img src="/assets/images/hero-home.webp" alt="" width="1918" height="820" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hx-hero__shade" aria-hidden="true"></div>
      <div class="hx-hero__grid" aria-hidden="true"></div>

      <div class="hx-wrap hx-hero__inner">
        <p class="hx-kicker hx-in" style="--d:.05s">
          <span class="hx-live"><i></i>Live</span>
          <span>{kicker}</span>
        </p>

        <h1 id="hx-h1" class="hx-h1">
          <span class="hx-in" style="--d:.12s">EVERYTHING USEFUL</span>
          <span class="hx-in hx-grad" style="--d:.2s">STARTS HERE...</span>
        </h1>

        <p class="hx-lead hx-in" style="--d:.3s">
          Live countdowns, redeem codes, calculators and guides for FC Mobile 27. Everything you check before you play, in one place.
        </p>

        <div class="hx-actions hx-in" style="--d:.38s">
          <a class="hx-btn hx-btn--primary" href="/redeem-codes"><span>Check redeem codes</span><span set:html={svg('arrow')} /></a>
          <a class="hx-btn hx-btn--ghost" href="/events"><span>See live events</span></a>
        </div>

        <ul class="hx-proof hx-in" style="--d:.46s" aria-label="Site at a glance">
          <li><b>{tools.length}</b> tools &amp; planners</li>
          <li><b>{posts.length}</b> guides &amp; updates</li>
          {lastChecked && <li>Codes checked <b>{dayMonth(lastChecked)}</b></li>}
        </ul>
      </div>
    </section>

    <!-- ═════════════ LIVE CONSOLE ═════════════ -->
    <section class="hx-console" aria-label="Live status">
      <div class="hx-wrap hx-console__grid">

        <!-- Reset -->
        <article class="hx-panel hx-reset hx-reveal" style="--i:0">
          <header class="hx-panel__head">
            <span class="hx-label"><span set:html={svg('clock')} />Next daily reset</span>
            <span class="hx-chip" data-hx-tz>Local time</span>
          </header>
          <div class="hx-clock" role="timer" aria-label="Time until next daily reset">
            <span data-hx-h>--</span><i>:</i><span data-hx-m>--</span><i>:</i><span data-hx-s>--</span>
          </div>
          <div class="hx-bar" aria-hidden="true"><span data-hx-bar></span></div>
          <footer class="hx-panel__foot">
            <span>Your time <b data-hx-local>--:--</b></span>
            <span>{resetLabel}</span>
          </footer>
        </article>

        <!-- Event radar -->
        <article class="hx-panel hx-radar hx-reveal" style="--i:1">
          <header class="hx-panel__head">
            <span class="hx-label"><span set:html={svg('calendar')} />Event radar</span>
            <a class="hx-textlink" href="/events">All events <span set:html={svg('arrow')} /></a>
          </header>
          <ul class="hx-radar__list">
            {radarRows.map((r) => (
              <li>
                <a href="/events" class:list={['hx-row', r.isLive && 'is-live']} data-hx-ts={r.start} data-hx-kind={r.kind}>
                  <span class="hx-row__dot" aria-hidden="true"></span>
                  <span class="hx-row__main">
                    <b>{r.title}</b>
                    <small>{r.sub}</small>
                  </span>
                  <span class="hx-row__cd" data-hx-cd>{r.initial}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>

        <!-- Redeem code -->
        <article class:list={['hx-panel', 'hx-code', 'hx-reveal', featuredCode ? 'is-active' : 'is-none']} style="--i:2" data-hx-expires={featuredCode?.expiryDate ? Date.parse(featuredCode.expiryDate + 'T23:59:59Z') : undefined}>
          <header class="hx-panel__head">
            <span class="hx-label"><span set:html={svg('ticket')} />Redeem code</span>
            <span class="hx-chip hx-chip--status" data-hx-status>{featuredCode ? 'Active' : 'None active'}</span>
          </header>

          {featuredCode ? (
            <div class="hx-code__body">
              <button type="button" class="hx-copy" data-hx-copy={featuredCode.code} aria-label={`Copy code ${featuredCode.code}`}>
                <strong>{featuredCode.code}</strong>
                <span class="hx-copy__act"><span set:html={svg('copy', 'hx-copy__i')} /><em data-hx-copy-label>Copy</em></span>
              </button>
              <p class="hx-code__reward">{featuredCode.reward}</p>
            </div>
          ) : (
            <div class="hx-code__body">
              <p class="hx-code__none">No active code right now</p>
              <p class="hx-code__reward">
                {lastCode && <>Last code <b>{lastCode.code}</b>{codeNote}. </>}New codes show up here as soon as they drop.
              </p>
            </div>
          )}

          <footer class="hx-panel__foot">
            <span>{codeFoot}</span>
            <a class="hx-textlink" href="/redeem-codes">Open codes <span set:html={svg('arrow')} /></a>
          </footer>
        </article>
      </div>
    </section>

    <!-- ═════════════ TOOLKIT ═════════════ -->
    <section class="hx-section" id="tools" aria-labelledby="hx-tools-h">
      <div class="hx-wrap">
        <header class="hx-head hx-reveal">
          <div>
            <span class="hx-eyebrow">The toolkit</span>
            <h2 id="hx-tools-h">Use the tool you need <span class="hx-grad">next.</span></h2>
          </div>
          <p>Built around real FC Mobile decisions, from squad building to event progress.</p>
        </header>

        <div class="hx-bento" data-hx-bento>
          {tools.map((t, i) => (
            <a class={`hx-tile hx-tile--${t.size} hx-reveal`} style={`--a:${t.accent};--ar:${rgb(t.accent)};--i:${i % 4}`} href={t.href}>
              <span class="hx-tile__glow" aria-hidden="true"></span>
              <span class="hx-tile__mark" aria-hidden="true" set:html={svg(t.icon)} />
              <span class="hx-tile__top">
                <span class="hx-tile__ico" aria-hidden="true" set:html={svg(t.icon)} />
                <span class="hx-tile__tag">{t.tag}</span>
              </span>

              {t.size === 'hero' && (
                <span class="hx-recent" aria-hidden="true">
                  {recentCodes.map((c) => (
                    <span class:list={['hx-recent__row', c.live && 'is-live']}>
                      <b>{c.code}</b><i>{c.reward}</i><em>{c.live ? 'Active' : 'Expired'}</em>
                    </span>
                  ))}
                </span>
              )}

              {t.size === 'hero' && (
                <span class="hx-tile__stats" aria-hidden="true">
                  <span><b>{REDEEM_CODES.length}</b>codes tracked</span>
                  <span><b>{liveCodes.length}</b>active now</span>
                  {lastChecked && <span><b>{dayMonth(lastChecked)}</b>last checked</span>}
                </span>
              )}

              <span class="hx-tile__body">
                <h3>{t.name}</h3>
                <p>{t.text}</p>
              </span>
              <span class="hx-tile__go" aria-hidden="true" set:html={svg('arrow')} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═════════════ SEASON 27 ═════════════ -->
    <section class="hx-section" aria-labelledby="hx-s27-h">
      <div class="hx-wrap">
        <div class="hx-season hx-reveal">
          <div class="hx-season__glow" aria-hidden="true"></div>
          <img class="hx-season__art" src="/assets/images/hero-striker.webp" alt="" width="900" height="711" loading="lazy" decoding="async" />

          <div class="hx-season__copy">
            <span class="hx-eyebrow">Season 27 briefing</span>
            <h2 id="hx-s27-h">FC&nbsp;Mobile&nbsp;27 <span class="hx-grad">is&nbsp;live.</span></h2>
            <p>The third-anniversary season landed on 24 September with Game Plans, Gauntlet Mode, PlayStyles and major optimizations, and it keeps your existing club instead of wiping it.</p>
            <ul class="hx-pills" aria-label="What's new in FC Mobile 27">
              <li>Game Plans</li><li>Gauntlet Mode</li><li>PlayStyles</li><li>Optimizations</li>
            </ul>
            <div class="hx-actions">
              <a class="hx-btn hx-btn--primary" href={seasonHref}><span>Read the launch guide</span><span set:html={svg('arrow')} /></a>
              <a class="hx-btn hx-btn--ghost" href="/fc-mobile-27"><span>Update hub</span></a>
            </div>
          </div>

          {gift && (
            <aside class="hx-gift" aria-label={gift.title}>
              <span class="hx-label"><span set:html={svg('gift')} />{gift.title}</span>
              <ul>
                {(gift.items ?? []).map((item) => <li><span set:html={svg('check')} />{item}</li>)}
              </ul>
              <small>{gift.note}</small>
            </aside>
          )}
        </div>
      </div>
    </section>

    <!-- ═════════════ EDITORIAL ═════════════ -->
    <section class="hx-section" aria-labelledby="hx-news-h">
      <div class="hx-wrap">
        <header class="hx-head hx-reveal">
          <div>
            <span class="hx-eyebrow">The editorial desk</span>
            <h2 id="hx-news-h">What's <span class="hx-grad">new.</span></h2>
          </div>
          <a class="hx-textlink hx-textlink--lg" href="/blog">All articles <span set:html={svg('arrow')} /></a>
        </header>

        {latest.length ? (
          <div class="hx-news">
            <a class="hx-feature hx-reveal" href={latest[0].href} style={`--a:${latest[0].section.accent};--ar:${rgb(latest[0].section.accent)}`}>
              <span class="hx-feature__media">
                {latest[0].cover
                  ? <img src={img(latest[0].cover, 1100)} alt={latest[0].imageAlt || ''} width="1100" height="619" loading="lazy" decoding="async" />
                  : <span class="hx-feature__ph">FCM</span>}
                <span class="hx-feature__badge">Featured</span>
              </span>
              <span class="hx-feature__body">
                <span class="hx-meta"><b>{latest[0].section.label}</b>{latest[0].date && <time datetime={iso(latest[0].date)}>{fmtDate(latest[0].date, 'medium')}</time>}<span>{latest[0].minutes} min read</span></span>
                <h3>{latest[0].title}</h3>
                <p>{latest[0].excerpt}</p>
                <span class="hx-textlink">Read article <span set:html={svg('arrow')} /></span>
              </span>
            </a>

            <ul class="hx-list">
              {latest.slice(1).map((p, i) => (
                <li class="hx-reveal" style={`--i:${i}`}>
                  <a class="hx-item" href={p.href} style={`--a:${p.section.accent};--ar:${rgb(p.section.accent)}`}>
                    <span class="hx-item__media">
                      {p.cover ? <img src={img(p.cover, 360)} alt="" width="360" height="240" loading="lazy" decoding="async" /> : <span>FCM</span>}
                    </span>
                    <span class="hx-item__body">
                      <span class="hx-meta"><b>{p.section.label}</b>{p.date && <time datetime={iso(p.date)}>{fmtDate(p.date, 'short')}</time>}</span>
                      <h3>{p.title}</h3>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="hx-empty">New articles are on the way.</p>
        )}
      </div>
    </section>

    <!-- ═════════════ FAQ ═════════════ -->
    <section class="hx-section" aria-labelledby="hx-faq-h">
      <div class="hx-wrap hx-faq">
        <div class="hx-faq__lead hx-reveal">
          <span class="hx-eyebrow">Quick answers</span>
          <h2 id="hx-faq-h">Less hunting, <span class="hx-grad">more playing.</span></h2>
          <p>FCMOBILETOOLS puts the useful parts of FC Mobile in one place so you can get an answer and get back to the game.</p>
