  .hx-code.is-active .hx-chip--status { color: var(--mint); border-color: rgba(110, 240, 194, .35); background: rgba(110, 240, 194, .1); }
  .hx-code.is-none .hx-chip--status { color: var(--amber); border-color: rgba(255, 195, 107, .35); background: rgba(255, 195, 107, .09); }

  /* ───────── sections / headings ───────── */
  .hx-section { padding-top: clamp(76px, 10vw, 132px); }
  .hx-section--last { padding-bottom: clamp(72px, 8vw, 112px); }
  .hx-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 40px; }
  .hx-head p { max-width: 340px; color: var(--muted); font: 400 15.5px/1.65 var(--body); }
  .hx-eyebrow { display: inline-flex; align-items: center; gap: 12px; color: var(--cyan); font: 700 12.5px/1 var(--body); letter-spacing: .16em; text-transform: uppercase; }
