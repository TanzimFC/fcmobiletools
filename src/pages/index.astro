---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const latestArticles = (await getCollection('blog', ({ data }) => data.status === 'published' && !data.draft))
  .sort((a, b) => (b.data.publishedAt?.valueOf() ?? 0) - (a.data.publishedAt?.valueOf() ?? 0))
  .slice(0, 4);
const readingTime = (post) => post.data.readingTime ?? Math.max(1, Math.ceil((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 220));
---

<BaseLayout title="FC Mobile Tools" description="FC Mobile tools, redeem codes, calculators, market investment tools, Football Centre, answers and guides from FCMOBILETOOLS.">
  <main class="home">
    <section class="home-hero">
      <div class="hero-bg" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">FC MOBILE TOOLS <span>·</span> BUILT FOR PLAYERS</p>
          <h1>Play smarter<br /><em>move with data</em></h1>
          <p>Redeem codes, event resources and purpose-built calculators for the decisions FC Mobile players make every day</p>
          <div class="hero-actions"><a class="btn primary" href="/investment-calculator">Investment Calculator <span>↗</span></a><a class="btn" href="/redeem-codes">Redeem Codes <span>↗</span></a></div>
        </div>
        <div class="hero-readout"><span>NEW TOOL</span><strong>INVEST</strong><b>MARKET LAB</b><i>BUY → SELL → NET RETURN</i></div>
      </div>
    </section>

    <section class="wrap tools-section">
      <div class="section-head"><div><p class="eyebrow">01 / TOOLS</p><h2>The useful stuff <em>lives here</em></h2></div><p>Calculators and trackers designed around real FC Mobile workflows</p></div>
      <div class="tool-grid">
        <a class="tool-card featured" href="/investment-calculator"><span>NEW / 01</span><b class="icon">↗</b><h3>Investment Calculator</h3><p>Model buy price, sell price, tax, net return, profit, ROI and break-even for market investments</p><strong>RUN THE DEAL →</strong></a>
        <a class="tool-card featured cyan" href="/redeem-codes"><span>REDEEM / 02</span><b class="icon">↗</b><h3>Redeem Codes</h3><p>Check current FC Mobile codes and move straight to redemption</p><strong>CHECK CODES →</strong></a>
        <a class="tool-card" href="/team-ovr"><span>CALCULATOR / 03</span><h3>Team OVR</h3><p>Calculate squad OVR from player ratings and upgrades</p><strong>OPEN →</strong></a>
        <a class="tool-card" href="/training-calculator"><span>CALCULATOR / 04</span><h3>Training Calculator</h3><p>Plan XP, fodder, levels and excess XP</p><strong>CALCULATE →</strong></a>
        <a class="tool-card" href="/rank-up-calculator"><span>CALCULATOR / 05</span><h3>Rank Up Calculator</h3><p>Calculate Rank Up Points, OVR gain and Skill Points</p><strong>CALCULATE →</strong></a>
        <a class="tool-card" href="/football-centre"><span>TRACKER / 06</span><h3>Football Centre</h3><p>Track matches, points, rewards and event resources</p><strong>OPEN CENTRE →</strong></a>
        <a class="tool-card" href="/a-nations-story"><span>ANSWERS / 07</span><h3>A Nation's Story</h3><p>Find event questions and answers without the digging</p><strong>FIND ANSWERS →</strong></a>
      </div>
    </section>

    <section class="wrap latest-section">
      <div class="section-head"><div><p class="eyebrow">02 / LATEST GUIDES</p><h2>Fresh from the <em>desk</em></h2></div><a class="section-link" href="/blog">VIEW ALL →</a></div>
      {latestArticles.length ? <div class="article-grid">{latestArticles.map((post) => <a class="article-card" href={`/blog/${post.slug}/`}>{post.data.image ? <img src={post.data.image} alt="" loading="lazy" /> : <div class="placeholder">FC</div>}<div><div class="meta"><span>{post.data.category}</span><span>{readingTime(post)} MIN</span></div><h3>{post.data.title}</h3><p>{post.data.excerpt ?? post.data.description}</p><strong>READ ARTICLE →</strong></div></a>)}</div> : <div class="empty">No published articles yet</div>}
    </section>

    <section class="wrap principles"><div><p class="eyebrow">03 / BUILT FOR PLAYERS</p><h2>Less searching<br /><em>more playing</em></h2></div><div class="principle-copy"><p>FCMOBILETOOLS focuses on practical resources that answer a specific question quickly</p><div class="principle-grid"><div><b>01</b><strong>USEFUL FIRST</strong><span>Tools stay at the centre</span></div><div><b>02</b><strong>EASY TO REACH</strong><span>Important resources stay visible</span></div><div><b>03</b><strong>PLAYER FOCUSED</strong><span>Built around real workflows</span></div></div></div></section>
  </main>
</BaseLayout>

<style>
.home{background:var(--bg);color:var(--text);overflow:hidden}.home .wrap{width:min(1180px,calc(100% - 36px));margin:auto}.home .eyebrow{margin:0;color:var(--blue);font:900 9px var(--mono);letter-spacing:.16em}.home-hero{position:relative;min-height:670px;border-bottom:1px solid var(--border);overflow:hidden;background:#060d13}.hero-bg{position:absolute;inset:0;background:url('/assets/images/herobeli.png') center/cover no-repeat;opacity:.75}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#05090df5 0%,#05090dc9 43%,#05090d55 76%,#05090db8 100%),linear-gradient(0deg,#05090df2 0%,transparent 50%,#05090d55 100%)}.hero-inner{position:relative;z-index:2;min-height:670px;display:grid;grid-template-columns:1fr 310px;align-items:center;gap:80px;padding:90px 0 60px}.hero-copy{max-width:760px}.hero-copy .eyebrow span{color:var(--muted);margin:0 5px}.hero-copy h1{font-size:clamp(56px,8vw,98px);line-height:.86;letter-spacing:-.07em;margin:19px 0}.hero-copy h1 em,.section-head h2 em,.principles h2 em{font-style:normal;color:var(--blue)}.hero-copy>p{max-width:650px;color:#a7b7c1;font-size:14px;line-height:1.8;margin:0}.hero-actions{display:flex;gap:9px;margin-top:30px}.btn{display:inline-flex;gap:10px;align-items:center;padding:14px 17px;border:1px solid #314250;border-radius:9px;background:#091017b8;color:#eef7fa;text-decoration:none;font:900 8px var(--mono);transition:.2s}.btn.primary{background:var(--blue);border-color:var(--blue);color:#061018}.btn:hover{transform:translateY(-2px);border-color:var(--blue)}.hero-readout{display:grid;gap:8px;padding:25px;border:1px solid #3fd5ff2a;border-radius:24px;background:linear-gradient(145deg,#0d1b25e8,#071018e8);box-shadow:0 30px 90px #0009;backdrop-filter:blur(12px)}.hero-readout span{font:900 8px var(--mono);color:var(--blue);letter-spacing:.15em}.hero-readout strong{font:900 50px var(--mono);letter-spacing:-.08em}.hero-readout b{font:900 8px var(--mono);color:#7f96a2}.hero-readout i{font:800 7px var(--mono);font-style:normal;color:#536d7a;margin-top:20px;padding-top:14px;border-top:1px solid #ffffff0d}.tools-section{padding:85px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:24px}.section-head h2{font-size:clamp(32px,4.5vw,53px);line-height:.94;letter-spacing:-.06em;margin:10px 0 0}.section-head>p{max-width:360px;color:var(--muted);font-size:10px;line-height:1.7;margin:0}.tool-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:11px}.tool-card{grid-column:span 2;position:relative;min-height:205px;padding:21px;border:1px solid var(--border);border-radius:15px;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.tool-card.featured{grid-column:span 3;min-height:255px;background:linear-gradient(145deg,#0c1c27,#081219)}.tool-card.cyan{background:linear-gradient(145deg,#0d1d25,#081219)}.tool-card:hover{transform:translateY(-4px);border-color:#36596a;box-shadow:0 20px 45px #0005}.tool-card>span{font:900 8px var(--mono);letter-spacing:.13em;color:var(--blue)}.tool-card.cyan>span{color:#62d8f9}.tool-card .icon{position:absolute;right:18px;top:17px;width:31px;height:31px;display:grid;place-items:center;border:1px solid #ffffff10;border-radius:8px;color:var(--blue);font:900 12px var(--mono)}.tool-card h3{font-size:20px;letter-spacing:-.03em;margin:37px 0 8px}.tool-card.featured h3{font-size:27px;margin-top:48px}.tool-card p{max-width:440px;color:var(--muted);font-size:10px;line-height:1.7;margin:0}.tool-card strong{position:absolute;left:21px;bottom:19px;color:var(--blue);font:900 8px var(--mono)}.latest-section{padding:85px 0;border-bottom:1px solid var(--border)}.section-link{color:var(--blue);text-decoration:none;font:900 8px var(--mono)}.article-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.article-card{display:grid;grid-template-columns:170px 1fr;min-height:175px;overflow:hidden;border:1px solid var(--border);border-radius:13px;background:var(--surface);color:var(--text);text-decoration:none;transition:.2s}.article-card:hover{transform:translateY(-3px);border-color:#36596a}.article-card img,.placeholder{width:100%;height:100%;min-height:175px;object-fit:cover}.placeholder{display:grid;place-items:center;background:#0b1c25;color:var(--blue);font:900 34px var(--mono)}.article-card>div:last-child{padding:17px}.meta{display:flex;gap:10px;color:var(--blue);font:900 7px var(--mono)}.meta span:last-child{color:#6e8490}.article-card h3{font-size:16px;line-height:1.1;margin:10px 0 7px}.article-card p{color:var(--muted);font-size:9px;line-height:1.6;margin:0}.article-card strong{display:block;color:var(--blue);font:900 7px var(--mono);margin-top:12px}.empty{padding:25px;border:1px dashed #263744;border-radius:12px;color:var(--muted);font-size:10px}.principles{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;padding:85px 0 105px}.principles h2{font-size:clamp(42px,5vw,64px);line-height:.9;letter-spacing:-.065em;margin:11px 0}.principle-copy>p{max-width:560px;color:#9cafba;font-size:13px;line-height:1.8;margin:0}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:30px}.principle-grid div{padding:16px;border:1px solid var(--border);border-radius:11px;background:var(--surface)}.principle-grid b{font:900 8px var(--mono);color:var(--blue)}.principle-grid strong{display:block;margin-top:19px;font:900 8px var(--mono)}.principle-grid span{display:block;margin-top:8px;color:var(--muted);font-size:9px;line-height:1.5}@media(max-width:850px){.hero-inner,.principles{grid-template-columns:1fr}.hero-readout{display:none}.tool-grid{grid-template-columns:1fr 1fr}.tool-card,.tool-card.featured{grid-column:span 1}.tool-card.featured{min-height:230px}.article-grid{grid-template-columns:1fr}}@media(max-width:560px){.home .wrap{width:calc(100% - 28px)}.home-hero,.hero-inner{min-height:620px}.hero-inner{padding:75px 0 40px}.hero-copy h1{font-size:clamp(49px,14vw,72px)}.tool-grid{grid-template-columns:1fr}.tool-card,.tool-card.featured{min-height:200px}.section-head{align-items:start;flex-direction:column;gap:12px}.principle-grid{grid-template-columns:1fr}.article-card{grid-template-columns:110px 1fr}.article-card img,.placeholder{min-height:175px}}
</style>
