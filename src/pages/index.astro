  .hx-tile::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity .3s;
    background: radial-gradient(380px circle at var(--mx, 85%) var(--my, 0%), rgba(var(--ar), .2), transparent 62%); }
  .hx-tile:hover { transform: translateY(-5px); border-color: rgba(var(--ar), .5); box-shadow: 0 30px 70px -28px rgba(0, 0, 0, .8), 0 0 0 1px rgba(var(--ar), .12); }
  .hx-tile:hover::before { opacity: 1; }
  .hx-tile__glow { position: absolute; z-index: -1; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: rgba(var(--ar), .12); filter: blur(46px); }
  .hx-tile__mark { position: absolute; z-index: -1; right: -26px; bottom: -34px; width: 190px; height: 190px; color: var(--a); opacity: .075; transition: transform .5s var(--ease), opacity .3s; pointer-events: none; }
