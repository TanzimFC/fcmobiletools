---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FC Mobile Tools" description="Track FC Mobile events, plan progress, play trivia and read practical guides from TanzimFC.">
  <section class="hero home-hero">
    <div class="wrap hero-content">
      <p class="eyebrow">FC MOBILE TOOLS</p>
      <h1>Play smarter.<br /><span>Know what's next.</span></h1>
      <p class="hero-copy">Track events, plan your progress, find useful tools and read practical FC Mobile guides — all in one place.</p>
      <div class="hero-actions"><a class="btn primary" href="/football-centre">Football Centre</a><a class="btn" href="/blog">Read the blog</a></div>
    </div>
  </section>
  <section class="wrap section-block">
    <div class="section-heading"><div><p class="eyebrow">TOOLS</p><h2>Everything in one place.</h2></div></div>
    <div class="feature-grid">
      <a class="feature-card" href="/football-centre"><span>01</span><h3>Football Centre</h3><p>Track matchdays, points, rewards and progress.</p></a>
      <a class="feature-card" href="/trivia"><span>02</span><h3>Trivia</h3><p>Explore FC Mobile trivia by nation, day and difficulty.</p></a>
      <a class="feature-card" href="/fc-mobile-beta"><span>03</span><h3>FC Mobile Beta</h3><p>Keep up with beta information and useful resources.</p></a>
      <a class="feature-card" href="/blog"><span>04</span><h3>Blog & Guides</h3><p>Event explainers, strategies, analysis and practical guides.</p></a>
      <a class="feature-card" href="/creator"><span>05</span><h3>TanzimFC</h3><p>Meet the creator and follow the project.</p></a>
    </div>
  </section>
  <section class="wrap section-block creator-section" id="creator">
    <div><p class="eyebrow">THE PROJECT</p><h2>Built for FC Mobile players.</h2><p>FC Mobile Tools is a focused companion site for players who want useful information without the clutter.</p></div>
    <a class="btn" href="/creator">About TanzimFC →</a>
  </section>
</BaseLayout>
