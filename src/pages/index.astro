    .pr-season-section { padding: 0 0 20px; }.pr-season { min-height: 495px; border-radius: 20px; align-items: flex-start; }.pr-season__backdrop { background: linear-gradient(180deg,rgba(8,22,32,.85),#091722 57%,#091722); }.pr-season__art { right: -19%; bottom: -5%; width: 100%; height: 54%; opacity: .32; }.pr-season__content { padding: 29px 21px 150px; }.pr-season h2 { font-size: 42px; }.pr-season__text { font-size: 11px; }.pr-season__actions { align-items: flex-start; flex-direction: column; gap: 16px; margin-top: 22px; }.pr-season__actions .pr-button { width: 100%; }.pr-season__stamp { right: 18px; top: 18px; font-size: 57px; }.pr-gift { left: 17px; right: 17px; bottom: 15px; width: auto; padding: 12px; }.pr-gift ul { grid-template-columns: 1fr 1fr; }
    .pr-editorial { padding-top: 45px; }.pr-news-feature__media,.pr-news-feature__media img { min-height: 180px; }.pr-news-feature__body { padding: 18px; }.pr-news-feature h3 { font-size: 24px; }.pr-news-list { display: flex; }.pr-news-item { min-height: 94px; }.pr-news-item__thumb { width: 100px; min-height: 94px; flex-basis: 100px; }.pr-news-item__body { padding: 12px 28px 12px 12px; }.pr-news-item__body strong { font-size: 12px; }.pr-news-all { align-items: flex-start; flex-direction: column; }
    .pr-community-section { padding: 12px 0 25px; }.pr-community { grid-template-columns: 52px minmax(0,1fr); gap: 14px; padding: 20px 16px; border-radius: 19px; }.pr-community__mark { width: 50px; height: 50px; border-radius: 14px; }.pr-community__mark img { width: 44px; height: 44px; }.pr-community__copy .pr-overline { font-size: 7px; letter-spacing: .1em; }.pr-community h2 { font-size: 25px; }.pr-community__copy > p:last-child { font-size: 10px; }.pr-community__links { grid-template-columns: 1fr; }.pr-community__links .pr-button { grid-column: auto; }.pr-community__links > a:not(.pr-button) { min-height: 43px; }
    .pr-faq-section { padding-top: 35px; }.pr-faq-list summary { min-height: 68px; gap: 10px; font-size: 12px; }.pr-faq-list summary i { width: 25px; height: 25px; flex-basis: 25px; }.pr-faq-list details > p { padding: 0 18px 20px 25px; font-size: 11px; }
