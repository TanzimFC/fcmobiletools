---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Achievements" description="Your FCMobiletools achievements and progress." robots="noindex,nofollow" googlebot="noindex,nofollow">
  <main class="account-list-page">
    <section class="intro"><span class="eyebrow">ACHIEVEMENTS</span><h1>Build your track record.</h1><p>Achievements are configurable milestones. They can be added or changed without rebuilding your profile system.</p></section>
    <div id="root"><div class="loading">Loading achievements…</div></div>
  </main>
</BaseLayout>
<style>
.account-list-page{width:min(1080px,calc(100% - 28px));margin:0 auto;padding:62px 0 100px}.intro{margin-bottom:18px}.eyebrow{color:var(--primary);font:800 9px var(--font-body);letter-spacing:.14em}.intro h1{margin:11px 0 7px;font:700 clamp(38px,6vw,64px)/.96 var(--font-display);letter-spacing:-.055em;color:var(--text)}.intro p{max-width:720px;margin:0;color:var(--muted);font:500 13px/1.75 var(--font-body)}.loading,.empty,.achievement{border:1px solid rgba(255,255,255,.08);border-radius:18px;background:linear-gradient(145deg,rgba(15,26,38,.98),rgba(7,16,24,.98))}.loading,.empty{padding:24px;color:var(--muted);font:600 11px var(--font-body)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.achievement{padding:20px}.achievement h2{margin:0;font:700 18px var(--font-display)}.achievement p{margin:6px 0 0;color:#7890a0;font:500 10px/1.65 var(--font-body)}.meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}.meta span{padding:6px 8px;border:1px solid rgba(76,201,255,.12);border-radius:999px;background:rgba(76,201,255,.045);color:#8fdcf6;font:800 8px var(--font-body)}.bar{height:7px;margin-top:13px;border-radius:999px;background:#0a141d;overflow:hidden}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#4cc9ff,#9fe6ff)}.status{margin-top:9px;color:#708696;font:700 9px var(--font-body)}
@media(max-width:720px){.grid{grid-template-columns:1fr}.account-list-page{padding-top:42px}}
</style>
<script>
import { accountAuth } from '../../lib/account-client.js';
const root=document.querySelector('#root');const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){
 const session=await accountAuth.auth.getSession();
 if(!session.data.session){root.innerHTML='<div class="empty">Sign in to see your achievement progress.<br><a href="/account/" style="color:#4cc9ff;font-weight:800">Open Account</a></div>';return;}
 const r=await fetch('/api/account/achievements',{headers:{authorization:'Bearer '+session.data.session.access_token},cache:'no-store'});
 const b=await r.json().catch(()=>({})); if(!r.ok) throw new Error(b.error||'Unable to load achievements.');
 root.innerHTML=b.achievements?.length?'<div class="grid">'+b.achievements.map(a=>{const done=a.status==='unlocked';const pct=Math.min(100,Math.max(0,Number(a.progressPercent||0)));return '<article class="achievement"><h2>'+esc(a.name)+'</h2><p>'+esc(a.description||'')+'</p><div class="meta">'+(a.xpReward>0?'<span>XP '+Number(a.xpReward).toLocaleString()+'</span>':'')+(a.tokenReward>0?'<span>Tokens '+Number(a.tokenReward).toLocaleString()+'</span>':'')+'<span>'+esc(done?'Unlocked':a.status||'Locked')+'</span></div><div class="bar"><i style="width:'+pct+'%"></i></div><div class="status">'+esc(done?'Unlocked on '+(a.unlockedAt||''):(a.progressLabel||'Progress tracked when a qualifying action is verified.'))+'</div></article>'}).join('')+'</div>':'<div class="empty">No achievements are active yet. Admins can add milestones later without changing the account architecture.</div>';
}
load().catch(e=>root.innerHTML='<div class="empty">'+esc(e.message)+'</div>');
</script>