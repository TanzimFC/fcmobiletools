---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Creator Login — FCMOBILETOOLS"
  description="Private creator workspace sign in."
  robots="noindex,nofollow,noarchive"
  googlebot="noindex,nofollow,noarchive"
>
<main class="creator-login">
  <div class="cl-aurora" aria-hidden="true"></div>
  <div class="login-grid">
    <section class="copy">
      <span class="cl-eyebrow"><i></i> CREATOR WORKSPACE</span>
      <h1>Write. Review.<br /><em>Get published.</em></h1>
      <p class="cl-lede">Use your creator account to manage drafts, redeem-code updates, approval feedback and your profile.</p>

      <ul class="cl-points">
        <li>
          <span class="cl-pt-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg>
          </span>
          <div><strong>Draft with a real editor</strong><small>Rich formatting, images and live preview.</small></div>
        </li>
        <li>
          <span class="cl-pt-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
          </span>
          <div><strong>Editorial review</strong><small>Get approval feedback before anything goes live.</small></div>
        </li>
        <li>
          <span class="cl-pt-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/></svg>
          </span>
          <div><strong>Redeem-code updates</strong><small>Submit fresh codes for the community.</small></div>
        </li>
      </ul>

      <a href="/creator/" class="back">← Back to creators</a>
    </section>

    <form class="card" id="creatorLogin" novalidate>
      <div class="cl-card-head">
        <div class="mark">FC</div>
        <div>
          <h2>Welcome back</h2>
          <p>Sign in to open your workspace.</p>
        </div>
      </div>

      <label class="cl-field">
        <span>Username</span>
        <div class="cl-input">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M5 20c1.5-3.5 4.2-5 7-5s5.5 1.5 7 5"/></svg>
          <input name="username" autocomplete="username" placeholder="Your creator username" required />
        </div>
      </label>

      <label class="cl-field">
        <span>Password</span>
        <div class="cl-input">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          <input name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
        </div>
      </label>

      <button type="submit" id="submit"><span>Open workspace</span>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <p id="error" role="alert"></p>
      <div class="cl-foot"><i></i> Encrypted session · Creator access only</div>
    </form>
  </div>
</main>
<script is:inline>
const form=document.querySelector('#creatorLogin'), error=document.querySelector('#error'), submit=document.querySelector('#submit');
const label=submit?.querySelector('span');
form?.addEventListener('submit',async e=>{
  e.preventDefault(); error.textContent=''; submit.disabled=true; submit.classList.add('loading'); if(label) label.textContent='Opening…';
  try{
    const r=await fetch('/api/creator/login',{method:'POST',headers:{'content-type':'application/json'},credentials:'same-origin',body:JSON.stringify(Object.fromEntries(new FormData(form)))});
    const body=await r.json().catch(()=>({}));
    if(!r.ok) throw new Error(body.error||'Sign in failed.');
    location.replace('/admin/');
  }catch(err){error.textContent=err.message;submit.disabled=false;submit.classList.remove('loading');if(label) label.textContent='Open workspace';}
});
</script>
<style>
.creator-login{position:relative;isolation:isolate;min-height:100vh;padding:clamp(112px,12vw,150px) 20px 90px;overflow:hidden;
  background:radial-gradient(760px 420px at 12% 0,rgba(76,201,255,.14),transparent 62%),radial-gradient(640px 400px at 94% 10%,rgba(165,148,255,.11),transparent 62%),var(--bg)}
.creator-login::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.5;background-image:linear-gradient(rgba(255,255,255,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0,#000 20%,transparent 78%);mask-image:radial-gradient(ellipse 80% 60% at 50% 0,#000 20%,transparent 78%)}
.cl-aurora{position:absolute;z-index:-1;width:520px;height:520px;left:-120px;bottom:-200px;border-radius:50%;background:rgba(91,227,166,.07);filter:blur(90px);pointer-events:none}
.login-grid{width:min(1040px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:clamp(40px,7vw,90px);align-items:center}
.cl-eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--primary);font:800 11px/1 var(--font-body);letter-spacing:.2em}
.cl-eyebrow i{width:22px;height:1px;background:linear-gradient(90deg,transparent,var(--primary))}
.copy h1{margin:18px 0 18px;font:700 clamp(46px,6vw,76px)/.98 var(--font-display);letter-spacing:-.055em;color:#f5f9fc}
.copy h1 em{font-style:normal;background:linear-gradient(100deg,#a8ecff,#4cc9ff 55%,#a594ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.cl-lede{max-width:520px;margin:0 0 30px;color:#9db1c1;font:500 16px/1.7 var(--font-body)}
.cl-points{list-style:none;margin:0 0 30px;padding:0;display:grid;gap:12px;max-width:520px}
.cl-points li{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:16px;background:linear-gradient(160deg,rgba(22,38,56,.6),rgba(8,16,25,.7));box-shadow:inset 0 0 0 1px rgba(255,255,255,.07),inset 0 1px 0 rgba(255,255,255,.05)}
.cl-pt-ico{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:11px;color:var(--primary);background:rgba(76,201,255,.1);box-shadow:inset 0 0 0 1px rgba(76,201,255,.25)}
.cl-points strong{display:block;color:#eef6fb;font:700 14px/1.3 var(--font-display)}
.cl-points small{display:block;margin-top:2px;color:#7f96a8;font:500 12.5px/1.45 var(--font-body)}
.back{display:inline-flex;align-items:center;gap:6px;color:#8edffc;font:700 13px/1 var(--font-body);transition:transform .2s,color .2s}
.back:hover{color:#fff;transform:translateX(-3px)}

.card{position:relative;padding:30px;border-radius:26px;background:linear-gradient(165deg,rgba(23,39,58,.78),rgba(8,16,25,.94));box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 40px 90px -30px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.07)}
.card::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(155deg,rgba(120,214,255,.5),rgba(255,255,255,.05) 30%,rgba(255,255,255,.03) 70%,rgba(165,148,255,.35));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
.cl-card-head{display:flex;align-items:center;gap:15px;margin-bottom:26px}
.mark{flex:none;width:52px;height:52px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,#a8ecff,#4cc9ff 55%,#4f7dff);color:#04131c;font:800 15px/1 var(--font-display);box-shadow:0 12px 30px -8px rgba(76,201,255,.6),inset 0 1px 0 rgba(255,255,255,.6)}
.card h2{margin:0;font:700 26px/1.1 var(--font-display);letter-spacing:-.04em;color:#f5f9fc}
.cl-card-head p{margin:4px 0 0;color:#8aa0b1;font:500 13.5px/1.4 var(--font-body)}
.cl-field{display:block;margin-top:16px}
.cl-field>span{display:block;margin-bottom:8px;color:#c6d6e2;font:700 12.5px/1.2 var(--font-body);letter-spacing:.02em}
.cl-input{position:relative;display:flex;align-items:center}
.cl-input svg{position:absolute;left:15px;color:#5f7a8d;pointer-events:none;transition:color .2s}
.cl-input:focus-within svg{color:var(--primary)}
.cl-input input{width:100%;min-height:52px;padding:0 16px 0 44px;border:0;border-radius:14px;outline:0;color:#f3f8fc;font:600 15px/1 var(--font-body);background:rgba(3,9,14,.65);box-shadow:inset 0 0 0 1px rgba(255,255,255,.09),inset 0 2px 6px rgba(0,0,0,.35);transition:box-shadow .2s,background .2s}
.cl-input input::placeholder{color:#55697a;font-weight:500}
.cl-input input:focus{background:rgba(5,14,22,.9);box-shadow:inset 0 0 0 1px rgba(76,201,255,.75),0 0 0 4px rgba(76,201,255,.13)}
.card button[type=submit]{position:relative;overflow:hidden;width:100%;min-height:54px;margin-top:24px;display:flex;align-items:center;justify-content:center;gap:10px;border:0;border-radius:15px;cursor:pointer;color:#04131c;font:800 15px/1 var(--font-body);background:linear-gradient(180deg,#b6f0ff,#5ccfff 55%,#2fb4ee);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),inset 0 -2px 0 rgba(0,80,120,.25),0 16px 34px -12px rgba(76,201,255,.75);transition:transform .2s,box-shadow .25s}
.card button[type=submit]:hover:not(:disabled){transform:translateY(-2px);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),inset 0 -2px 0 rgba(0,80,120,.25),0 22px 42px -12px rgba(76,201,255,.9)}
.card button[type=submit]:active:not(:disabled){transform:scale(.985)}
.card button[type=submit]:disabled{opacity:.75;cursor:wait}
.card button.loading svg{display:none}
.card button.loading::before{content:"";width:15px;height:15px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:clSpin .7s linear infinite}
@keyframes clSpin{to{transform:rotate(360deg)}}
.card p#error{min-height:20px;margin:14px 0 0;color:#ff9f95;font:700 13px/1.4 var(--font-body)}
.card p#error:not(:empty){padding:11px 13px;border-radius:12px;background:rgba(255,125,134,.08);box-shadow:inset 0 0 0 1px rgba(255,125,134,.28)}
.cl-foot{display:flex;align-items:center;gap:9px;margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.07);color:#6c8294;font:600 12px/1 var(--font-body)}
.cl-foot i{width:7px;height:7px;border-radius:50%;background:#5be3a6;box-shadow:0 0 0 4px rgba(91,227,166,.12),0 0 12px rgba(91,227,166,.6)}
@media(max-width:860px){.login-grid{grid-template-columns:1fr;gap:38px}.copy h1{font-size:clamp(44px,12vw,64px)}.card{padding:24px}}
@media(prefers-reduced-motion:reduce){.card button.loading::before{animation:none}}
</style>
</BaseLayout>
