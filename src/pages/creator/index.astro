---
export const prerender = false;
Astro.response.headers.set('Cache-Control','no-store, max-age=0, must-revalidate');
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/blog-supabase.js';
const remotePosts=await getPublishedPosts();
const posts=remotePosts.slice(0,6);
---
<BaseLayout title="Creators — FCMOBILETOOLS" description="Creators and community contributors behind FCMOBILETOOLS.">
<main class="creator-page">
<section class="hero"><div class="wrap hero-inner"><div><p class="eyebrow">COMMUNITY / CREATORS</p><h1>People behind<br /><em>the content.</em></h1><p class="lede">A small place for the FC Mobile creators and knowledgeable community writers whose work appears on FCMOBILETOOLS.</p></div><article class="profile"><img src="/assets/images/Annotation%202026-08-16%20121359.png" alt="TanzimFC"><span>CREATOR / BUILDER</span><h2>TanzimFC</h2><p>Tools, live resources, guides, updates and analysis.</p><div class="links"><a href="https://www.youtube.com/@tanzimfc" target="_blank" rel="noopener">YouTube</a><a href="https://discord.com/invite/B4a7AxuU69" target="_blank" rel="noopener">Discord</a><a href="https://x.com/TanzimFC" target="_blank" rel="noopener">X</a><a href="/creator/login">Creator workspace ↗</a></div></article></div></section>
<section class="wrap body"><div class="section-head"><div><p class="eyebrow">CREATOR PROFILE</p><h2>TanzimFC</h2></div><a href="/blog/author/tanzimfc/">View all articles ↗</a></div><div class="profile-grid"><article class="about"><span class="label">ABOUT</span><p>FC Mobile tools and content built around the things players actually need: live event information, calculators, redeem codes, guides and useful analysis.</p><div class="chips"><span>Updates</span><span>Guides</span><span>Analysis</span><span>Tools</span></div></article><article class="latest"><span class="label">LATEST WORK</span>{posts.map(post=><a href={'/blog/' + post.slug + '/'}><small>{post.data.category}</small><strong>{post.data.title}</strong></a>)}</article></div>
<section id="write" class="write"><div><p class="eyebrow">WRITE WITH US</p><h2>Have something useful to add?</h2><p>We may open a small number of creator spots for FC Mobile writers with strong knowledge of events, tactics, reviews or game updates. Articles are reviewed before publication.</p></div><a href="/legal/contact">Get in touch ↗</a></section></section>
</main>
</BaseLayout>
<style>
.creator-page{background:var(--bg);overflow:hidden}.wrap{width:min(1160px,calc(100% - 28px));margin:auto}.hero{border-bottom:1px solid var(--border);background:radial-gradient(circle at 80% 0,#55c7f21e,transparent 34%),linear-gradient(180deg,#07131b,#061018)}.hero-inner{min-height:560px;padding:70px 0;display:grid;grid-template-columns:minmax(0,1fr) 360px;align-items:center;gap:70px}.eyebrow,.label{color:var(--blue);font:900 8px var(--mono);letter-spacing:.16em}.hero h1{font-size:clamp(58px,8vw,94px);line-height:.87;letter-spacing:-.078em;margin:17px 0}.hero h1 em{font-style:normal;color:var(--blue)}.lede{max-width:650px;color:#8fa3af;font-size:13px;line-height:1.8}.profile{padding:23px;border:1px solid #294454;border-radius:22px;background:linear-gradient(145deg,#0d1b24,#081118);box-shadow:0 30px 90px #0009;animation:float 5s ease-in-out infinite}.profile img{width:92px;height:92px;border-radius:22px;object-fit:cover;border:1px solid #315264}.profile>span{display:block;margin-top:17px;color:#627d8a;font:800 7px var(--mono)}.profile h2{font-size:28px;letter-spacing:-.05em;margin:5px 0}.profile p{margin:0;color:#7e929e;font-size:10px}.links{display:flex;gap:7px;flex-wrap:wrap;margin-top:17px}.links a{padding:8px 10px;border:1px solid #294454;border-radius:8px;color:#90def7;text-decoration:none;font:800 7px var(--mono);transition:.18s}.links a:hover{transform:translateY(-2px);border-color:#55c7f2}@keyframes float{50%{transform:translateY(-5px)}}.body{padding:70px 0 90px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.section-head h2{font-size:42px;letter-spacing:-.06em;margin:7px 0}.section-head a{color:#8cddff;text-decoration:none;font:800 7px var(--mono)}.profile-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:12px}.about,.latest{padding:22px;border:1px solid var(--border);border-radius:16px;background:#09141b}.about p{color:#8297a3;font-size:11px;line-height:1.8;margin:12px 0 18px}.chips{display:flex;flex-wrap:wrap;gap:6px}.chips span{padding:6px 8px;border:1px solid #294454;border-radius:99px;color:#7f96a3;font:800 7px var(--mono)}.latest{display:grid;gap:0}.latest>a{display:grid;gap:5px;padding:12px 0;border-top:1px solid #1b2e38;text-decoration:none}.latest>a:first-of-type{border-top:0}.latest small{color:var(--blue);font:800 7px var(--mono);text-transform:uppercase}.latest strong{color:#d5e4ea;font-size:11px}.write{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-top:45px;padding:24px;border:1px solid #294a5c;border-radius:17px;background:radial-gradient(circle at 0 0,#55c7f216,transparent 45%),#09141c}.write h2{font-size:25px;margin:7px 0}.write p:last-child{max-width:670px;color:#8297a3;font-size:10px;line-height:1.7;margin:0}.write>a{padding:11px 13px;border:1px solid #55c7f24a;border-radius:9px;background:#55c7f20b;color:#96e3ff;text-decoration:none;font:900 7px var(--mono);white-space:nowrap}@media(max-width:820px){.hero-inner{grid-template-columns:1fr;padding:55px 0}.profile-grid{grid-template-columns:1fr}.write{align-items:start;flex-direction:column}}@media(max-width:520px){.section-head{align-items:start;flex-direction:column}.section-head h2{font-size:34px}}
</style>