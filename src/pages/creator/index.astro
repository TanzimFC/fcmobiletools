---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Creator" description="TanzimFC creator profile and official links."><section class="shell"><div class="head"><div><p>FC MOBILE TOOLS · CREATOR</p><h1>TanzimFC</h1><span>Guides, tools, event coverage and FC Mobile content.</span></div><a href="/">← Home</a></div><iframe src="/legacy/creator.html" title="TanzimFC creator page" class="frame"></iframe></section></BaseLayout>
<style>.shell{width:min(1160px,calc(100% - 28px));margin:auto;padding:30px 0 70px}.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:15px}.head p{font-size:10px;letter-spacing:.14em;color:#7dd3fc;font-weight:900}.head h1{font-size:42px;letter-spacing:-.05em;margin:4px 0}.head span{color:#8b97a5;font-size:13px}.head a{padding:10px 12px;border:1px solid #263747;border-radius:10px;background:#101a24;text-decoration:none;font-size:11px;font-weight:800}.frame{width:100%;height:1800px;border:1px solid #20303e;border-radius:18px;background:#050b12}@media(max-width:700px){.shell{width:calc(100% - 18px)}.head{align-items:flex-start;flex-direction:column;gap:12px}.head a{width:100%;text-align:center}.frame{height:2300px}}</style>
