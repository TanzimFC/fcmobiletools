---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const event = FOOTBALL_CENTRE_CONTENT.eventCountdown;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Event Countdown | FCMOBILETOOLS',
  description: 'Live FC Mobile event countdown with the current event window shown in your local time.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.com').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Event Countdown | FCMOBILETOOLS" description="Live FC Mobile event countdown with the current event window shown in your local time">
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <main class="event-page">
    <div class="event-glow glow-a"></div><div class="event-glow glow-b"></div>
    <section class="event-hero">
      {event.banner && <img class="event-banner" src={event.banner} alt={event.title} />}
      <div class="event-content">
        <span class="eyebrow">{event.accent}</span>
        <h1>{event.title}</h1>
        <p>{event.subtitle}</p>
        <div class="status" id="status">Loading event timing</div>
        <div class="timer" aria-label="Event countdown">
          <div><strong id="days">--</strong><span>DAYS</span></div><b>:</b>
          <div><strong id="hours">--</strong><span>HOURS</span></div><b>:</b>
          <div><strong id="minutes">--</strong><span>MINUTES</span></div><b>:</b>
          <div><strong id="seconds">--</strong><span>SECONDS</span></div>
        </div>
        <div class="meta"><div><span>NEXT CHANGE</span><strong id="next">—</strong></div><div><span>YOUR LOCAL TIME</span><strong id="local">—</strong></div></div>
      </div>
    </section>
    <section class="event-note">
      <span>EVENT TIMING</span>
      <p id="note">The event schedule is maintained from the admin panel. The countdown automatically switches from start time to end time when the event goes live.</p>
    </section>
  </main>
</BaseLayout>
<script define:vars={{ startUtc: event.startUtc, endUtc: event.endUtc, enabled: event.enabled }}>
  const els = ['days','hours','minutes','seconds'].reduce((a,id)=>{a[id]=document.getElementById(id);return a},{});
  const statusEl=document.getElementById('status'),nextEl=document.getElementById('next'),localEl=document.getElementById('local'),noteEl=document.getElementById('note');
  const dateFmt=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});
  const localFmt=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
  const pad=n=>String(n).padStart(2,'0');
  const empty=()=>{Object.values(els).forEach(x=>x.textContent='--');nextEl.textContent='—';};
  const update=()=>{
    if(!enabled || !startUtc || !endUtc){statusEl.textContent='Timing not configured';empty();return}
    const now=Date.now(),start=Date.parse(startUtc),end=Date.parse(endUtc);
    if(!Number.isFinite(start)||!Number.isFinite(end)||end<=start){statusEl.textContent='Timing needs an admin update';empty();return}
    let target= start>now ? start : end>now ? end : null;
    if(!target){statusEl.textContent='Event ended';empty();nextEl.textContent=dateFmt.format(end);localEl.textContent=localFmt.format(new Date());noteEl.textContent='The event window has ended. Update the dates in Admin when the next event is announced.';return}
    statusEl.textContent=start>now?'Starts in':'Ends in';
    const diff=Math.max(0,target-now),total=Math.floor(diff/1000);
    els.days.textContent=String(Math.floor(total/86400)).padStart(2,'0');els.hours.textContent=pad(Math.floor(total%86400/3600));els.minutes.textContent=pad(Math.floor(total%3600/60));els.seconds.textContent=pad(total%60);
    nextEl.textContent=dateFmt.format(new Date(target));localEl.textContent=localFmt.format(new Date(now));
  };
  update();const timer=setInterval(update,250);document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()});window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});
</script>
<style>
.event-page{min-height:calc(100vh - 70px);position:relative;overflow:hidden;background:#06090e;color:#f5f8fc;padding:clamp(35px,6vw,80px) 18px 90px}.event-glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.13;pointer-events:none}.glow-a{left:-260px;top:40px;background:#36c6ff}.glow-b{right:-280px;top:280px;background:#536dff}.event-hero{position:relative;z-index:1;max-width:1080px;margin:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:34px;align-items:center}.event-banner{width:100%;max-height:600px;object-fit:cover;border-radius:24px;border:1px solid #1b2a39;box-shadow:0 35px 100px #0009}.event-content{padding:10px 0}.eyebrow{display:inline-block;color:#55c7f2;font:800 9px var(--mono,monospace);letter-spacing:.16em}.event-content h1{margin:16px 0 12px;font-size:clamp(42px,6vw,76px);line-height:.95;letter-spacing:-.06em}.event-content>p{max-width:570px;color:#8a98aa;font-size:14px;line-height:1.75}.status{display:inline-flex;margin-top:25px;padding:8px 11px;border:1px solid #294252;border-radius:999px;color:#9bdfff;background:#0a1820;font:800 8px var(--mono,monospace);letter-spacing:.08em;text-transform:uppercase}.timer{display:flex;align-items:flex-start;gap:9px;margin:25px 0}.timer div{min-width:70px}.timer strong{display:block;font:800 clamp(34px,5vw,58px)/.9 var(--mono,monospace);letter-spacing:-.08em}.timer span{display:block;margin-top:9px;color:#536377;font:800 7px var(--mono,monospace);letter-spacing:.14em}.timer>b{color:#314053;font:700 30px var(--mono,monospace);padding-top:1px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px}.meta div{padding:13px 14px;border-left:1px solid #2a4050;background:#ffffff02}.meta span{display:block;color:#536277;font:800 7px var(--mono,monospace);letter-spacing:.13em}.meta strong{display:block;margin-top:6px;color:#dbe5ef;font-size:11px}.event-note{position:relative;z-index:1;max-width:1080px;margin:60px auto 0;padding:18px 20px;border:1px solid #182533;border-radius:14px;background:#080f16}.event-note span{color:#52667b;font:800 8px var(--mono,monospace);letter-spacing:.15em}.event-note p{margin:8px 0 0;color:#748397;font-size:11px;line-height:1.7}@media(max-width:820px){.event-hero{grid-template-columns:1fr}.event-banner{max-height:420px}.event-content h1{font-size:52px}}@media(max-width:520px){.event-page{padding-inline:13px}.event-banner{border-radius:16px}.timer{gap:5px}.timer div{min-width:0;flex:1}.timer strong{font-size:32px}.timer>b{font-size:22px}.meta{grid-template-columns:1fr}}
</style>
