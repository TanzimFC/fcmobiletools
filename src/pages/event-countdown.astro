---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const event = FOOTBALL_CENTRE_CONTENT.eventCountdown;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Anniversary Event Countdown | FCMOBILETOOLS',
  description: 'Live FC Mobile Anniversary Event countdown with local-time timing and live event status.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.com').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Anniversary Event Countdown | FCMOBILETOOLS" description="Live FC Mobile Anniversary Event countdown with local-time timing and live event status">
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <main class="event-page">
    <div class="event-glow glow-a"></div><div class="event-glow glow-b"></div>
    <section class="event-hero" id="eventHero">
      {event.banner && <img class="event-banner" src={event.banner} alt={event.title} />}
      <div class="event-content">
        <span class="eyebrow">{event.accent}</span>
        <h1>{event.title}</h1>
        <p>{event.subtitle}</p>
        <div class="status" id="status">Loading event timing</div>
        <div class="timer" aria-label="Event countdown">
          <div><strong id="days">--</strong><span>DAYS</span></div><b>:</b>
          <div><strong id="hours">--</strong><span>HOURS</span></div><b>:</b>
          <div><strong id="minutes">--</strong><span>MINUTES</span></div><b>:</b>
          <div><strong id="seconds">--</strong><span>SECONDS</span></div>
        </div>
        <div class="meta"><div><span>NEXT CHANGE</span><strong id="next">—</strong></div><div><span>YOUR LOCAL TIME</span><strong id="local">—</strong></div></div>
        <button class="sound-toggle" id="soundToggle" type="button" aria-pressed="false">Enable live sound</button>
      </div>
    </section>
    <section class="event-note">
      <span>EVENT TIMING</span>
      <p id="note">The countdown follows the admin event window. When the countdown reaches zero, this page stays live and changes into an active event state instead of stopping.</p>
    </section>
  </main>
</BaseLayout>
<script define:vars={{ startUtc: event.startUtc, endUtc: event.endUtc, enabled: event.enabled }}>
  const els = ['days','hours','minutes','seconds'].reduce((a,id)=>{a[id]=document.getElementById(id);return a},{});
  const statusEl=document.getElementById('status'),nextEl=document.getElementById('next'),localEl=document.getElementById('local'),noteEl=document.getElementById('note'),soundToggle=document.getElementById('soundToggle'),hero=document.getElementById('eventHero');
  const dateFmt=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});
  const localFmt=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
  const pad=n=>String(n).padStart(2,'0');
  let soundOn=false,wasLive=false,audioContext=null;
  const beep=()=>{if(!soundOn)return;try{audioContext ||= new (window.AudioContext||window.webkitAudioContext)();const osc=audioContext.createOscillator(),gain=audioContext.createGain();osc.frequency.value=880;gain.gain.setValueAtTime(.0001,audioContext.currentTime);gain.gain.exponentialRampToValueAtTime(.08,audioContext.currentTime+.02);gain.gain.exponentialRampToValueAtTime(.0001,audioContext.currentTime+.22);osc.connect(gain).connect(audioContext.destination);osc.start();osc.stop(audioContext.currentTime+.24)}catch{}};
  soundToggle.addEventListener('click',()=>{soundOn=!soundOn;soundToggle.setAttribute('aria-pressed',String(soundOn));soundToggle.textContent=soundOn?'Live sound enabled':'Enable live sound';if(soundOn){audioContext ||= new (window.AudioContext||window.webkitAudioContext)();beep()}});
  const empty=()=>Object.values(els).forEach(x=>x.textContent='--');
  const update=()=>{
    if(!enabled || !startUtc){statusEl.textContent='Timing not configured';empty();nextEl.textContent='—';return}
    const now=Date.now(),start=Date.parse(startUtc),end=endUtc?Date.parse(endUtc):NaN;
    if(!Number.isFinite(start)|| (endUtc && !Number.isFinite(end)) || (Number.isFinite(end)&&end<=start)){statusEl.textContent='Timing needs an admin update';empty();return}
    if(now<start){
      statusEl.textContent='Starts in';hero.classList.remove('is-live');
      const diff=start-now,total=Math.floor(diff/1000);els.days.textContent=String(Math.floor(total/86400)).padStart(2,'0');els.hours.textContent=pad(Math.floor(total%86400/3600));els.minutes.textContent=pad(Math.floor(total%3600/60));els.seconds.textContent=pad(total%60);nextEl.textContent=dateFmt.format(new Date(start));noteEl.textContent='The Anniversary Event countdown is waiting for the scheduled start. When it reaches zero, the page switches automatically to LIVE.';wasLive=false;
    } else if(!Number.isFinite(end) || now<end){
      if(!wasLive) beep(); wasLive=true; statusEl.textContent='LIVE NOW';hero.classList.add('is-live');els.days.textContent='00';els.hours.textContent='00';els.minutes.textContent='00';els.seconds.textContent='00';nextEl.textContent=Number.isFinite(end)?dateFmt.format(new Date(end)):'Event active';noteEl.textContent=Number.isFinite(end)?'The event is live now. The page will keep showing LIVE until the configured end time.':'The event is live now. It stays LIVE until you set an end time or update the event from Admin.';
    } else {
      statusEl.textContent='Event ended';hero.classList.remove('is-live');empty();nextEl.textContent=dateFmt.format(new Date(end));noteEl.textContent='The event window has ended. Update the dates in Admin when the next event is announced.';
    }
    localEl.textContent=localFmt.format(new Date(now));
  };
  update();const timer=setInterval(update,250);document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()});window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});
</script>
<style>
.event-page{min-height:calc(100vh - 70px);position:relative;overflow:hidden;background:#06090e;color:#f5f8fc;padding:clamp(35px,6vw,80px) 18px 90px}.event-glow{position:absolute;width:520px;height:520px;border-radius:50%;filter:blur(110px);opacity:.13;pointer-events:none}.glow-a{left:-260px;top:40px;background:#36c6ff}.glow-b{right:-280px;top:280px;background:#536dff}.event-hero{position:relative;z-index:1;max-width:1080px;margin:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:34px;align-items:center}.event-banner{width:100%;max-height:600px;object-fit:cover;border-radius:24px;border:1px solid #1b2a39;box-shadow:0 35px 100px #0009}.event-content{padding:10px 0}.eyebrow{display:inline-block;color:#55c7f2;font:800 9px var(--mono,monospace);letter-spacing:.16em}.event-content h1{margin:16px 0 12px;font-size:clamp(42px,6vw,76px);line-height:.95;letter-spacing:-.06em}.event-content>p{max-width:570px;color:#8a98aa;font-size:14px;line-height:1.75}.status{display:inline-flex;margin-top:25px;padding:8px 11px;border:1px solid #294252;border-radius:999px;color:#9bdfff;background:#0a1820;font:800 8px var(--mono,monospace);letter-spacing:.08em;text-transform:uppercase}.timer{display:flex;align-items:flex-start;gap:9px;margin:25px 0}.timer div{min-width:70px}.timer strong{display:block;font:800 clamp(34px,5vw,58px)/.9 var(--mono,monospace);letter-spacing:-.08em}.timer span{display:block;margin-top:9px;color:#536377;font:800 7px var(--mono,monospace);letter-spacing:.14em}.timer>b{color:#314053;font:700 30px var(--mono,monospace);padding-top:1px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px}.meta div{padding:13px 14px;border-left:1px solid #2a4050;background:#ffffff02}.meta span{display:block;color:#536277;font:800 7px var(--mono,monospace);letter-spacing:.13em}.meta strong{display:block;margin-top:6px;color:#dbe5ef;font-size:11px}.sound-toggle{margin-top:12px;border:1px solid #294252;border-radius:10px;background:#09151c;color:#91cce0;padding:9px 11px;font:800 8px var(--mono,monospace);cursor:pointer}.is-live .status{color:#8dffbc;border-color:#275f45;background:#0a2117;box-shadow:0 0 30px #54e79822}.is-live .event-banner{animation:livePulse 2.8s ease-in-out infinite}@keyframes livePulse{50%{box-shadow:0 35px 100px #0009,0 0 42px #5ee7a455}}.event-note{position:relative;z-index:1;max-width:1080px;margin:60px auto 0;padding:18px 20px;border:1px solid #182533;border-radius:14px;background:#080f16}.event-note span{color:#52667b;font:800 8px var(--mono,monospace);letter-spacing:.15em}.event-note p{margin:8px 0 0;color:#748397;font-size:11px;line-height:1.7}@media(max-width:820px){.event-hero{grid-template-columns:1fr}.event-banner{max-height:420px}.event-content h1{font-size:52px}}@media(max-width:520px){.event-page{padding-inline:13px}.event-banner{border-radius:16px}.timer{gap:5px}.timer div{min-width:0;flex:1}.timer strong{font-size:32px}.timer>b{font-size:22px}.meta{grid-template-columns:1fr}}
</style>
