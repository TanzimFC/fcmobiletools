---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const event = FOOTBALL_CENTRE_CONTENT.eventCountdown;
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events and Reset | FCMOBILETOOLS',
  description: 'Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.com').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Events and Reset | FCMOBILETOOLS" description="Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion">
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<main class="events-page">
  <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div><div class="scanlines"></div>

  <section class="hero">
    <div class="hero-top">
      <div class="eyebrow"><span class="live-dot"></span> LIVE FC MOBILE TIMING</div>
      <div class="clock-strip"><span>LOCAL</span><strong id="localClock">--:--:--</strong><i></i><span>UTC</span><strong id="utcClock">--:--:--</strong></div>
    </div>
    <div class="hero-copy">
      <span class="hero-number">27</span>
      <div><h1>Reset <em>Center</em></h1><p>One screen for the FC Mobile clocks that matter. Maintenance, season events, daily reset and Division Rivals.</p></div>
    </div>
  </section>

  <section class="maintenance-feature">
    <div class="maintenance-glow"></div>
    <div class="warning-badge">🚧</div>
    <div class="maintenance-main">
      <div class="feature-label">FC MOBILE 27 · SEASON UPDATE</div>
      <h2>Maintenance <span>21:30 UTC</span><b>→</b><span>02:00 UTC</span></h2>
      <p>Scheduled maintenance runs through midnight into September 24. The Season Update and anniversary event follow the maintenance window.</p>
    </div>
    <div class="maintenance-time"><small>YOUR TIME</small><strong id="maintenanceLocal">—</strong><span>Automatic conversion</span></div>
  </section>

  <section class="feature-grid">
    <article class="event-feature" id="eventCard">
      {event.banner && <div class="event-image"><img src={event.banner} alt={event.title} loading="eager" /><div class="image-shade"></div><span class="image-tag">FC MOBILE 27</span></div>}
      <div class="event-body">
        <div class="section-line"><span>{event.accent}</span><strong id="eventStatus"><i></i> STARTING SOON</strong></div>
        <h2>{event.title}</h2>
        <p>{event.subtitle}</p>
        <div class="big-countdown" aria-label="Anniversary Event countdown">
          <div><strong id="ed">--</strong><small>DAYS</small></div><b>:</b><div><strong id="eh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="em">--</strong><small>MINUTES</small></div><b>:</b><div><strong id="es">--</strong><small>SECONDS</small></div>
        </div>
        <div class="event-meta"><div><small>STARTS UTC</small><strong id="eventUtc">—</strong></div><div><small>STARTS LOCAL</small><strong id="eventLocal">—</strong></div></div>
        <div class="event-note"><span></span><p id="eventNote">Waiting for the configured event start</p></div>
      </div>
    </article>

    <div class="side-stack">
      <article class="reset-card daily-card">
        <div class="card-symbol">01</div><div class="card-copy"><span class="feature-label">DAILY RESET</span><h2>Daily Reset</h2><p>Every day at 01:00 UTC.</p></div><span class="cycle-pill">24H</span>
        <div class="mini-countdown"><div><strong id="dh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="dm">--</strong><small>MIN</small></div><b>:</b><div><strong id="ds">--</strong><small>SEC</small></div></div>
        <div class="bar"><span id="dailyPct">0%</span><i><b id="dailyBar"></b></i></div>
        <div class="reset-meta"><span>NEXT RESET</span><strong id="dailyLocal">—</strong></div>
      </article>

      <article class="reset-card rivals-card">
        <div class="card-symbol">DR</div><div class="card-copy"><span class="feature-label">DIVISION RIVALS</span><h2>Season Reset</h2><p>{rivals.cycleDays}-day competitive cycle.</p></div><span class="cycle-pill">{rivals.cycleDays}D</span>
        <div class="mini-countdown"><div><strong id="rh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="rm">--</strong><small>MIN</small></div><b>:</b><div><strong id="rs">--</strong><small>SEC</small></div></div>
        <div class="bar"><span id="rivalsPct">0%</span><i><b id="rivalsBar"></b></i></div>
        <div class="reset-meta"><span>NEXT RESET</span><strong id="rivalsLocal">—</strong></div>
      </article>
    </div>
  </section>

  <section class="timeline-section">
    <div class="section-heading"><div><span class="feature-label">UP NEXT</span><h2>The FC Mobile clock</h2></div><p>All times are calculated from UTC, then converted in your browser.</p></div>
    <div class="timeline">
      <div class="timeline-item"><span class="timeline-index">01</span><div><small>DAILY · 01:00 UTC</small><strong>Daily Reset</strong><p>Rewards and daily activities reset.</p></div><em id="dailyMark">NEXT</em></div>
      <div class="timeline-item"><span class="timeline-index">27</span><div><small id="eventTimelineUtc">24 SEP 2026</small><strong>Anniversary Event</strong><p>FC Mobile 27 season event begins.</p></div><em id="eventMark">EVENT</em></div>
      <div class="timeline-item"><span class="timeline-index">DR</span><div><small id="rivalsTimelineUtc">—</small><strong>Division Rivals</strong><p>Current competitive season reaches reset.</p></div><em>CYCLE</em></div>
    </div>
  </section>

  <section class="timezone-panel">
    <div><span class="feature-label">TIMEZONE SAFE</span><h2>UTC stays fixed.<br /><em>Your time moves with you.</em></h2><p>The countdowns use scheduled UTC timestamps. Your browser handles local conversion, so the same event moment stays consistent worldwide.</p></div>
    <button id="soundToggle" type="button" aria-pressed="false"><b>◉</b><span>Enable reset alerts</span></button>
  </section>
</main>

<script define:vars={{ startUtc: event.startUtc, endUtc: event.endUtc, eventEnabled: event.enabled, anchorUtc: rivals.anchorUtc, cycleDays: rivals.cycleDays, rivalsEnabled: rivals.enabled }}>
const $=id=>document.getElementById(id),DAY=86400000,pad=n=>String(n).padStart(2,'0');
const zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';
const maintenanceStart=Date.parse('2026-09-23T21:30:00Z'),maintenanceEnd=Date.parse('2026-09-24T02:00:00Z');
const localFmt=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
const utcFmt=new Intl.DateTimeFormat('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZone:'UTC',timeZoneName:'short'});
const shortFmt=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
let alerts=false,audio=null,lastEventState='before',lastDailyReset=0,lastRivalsReset=0;

const beep=(freq=760)=>{if(!alerts)return;try{audio??=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(.0001,audio.currentTime);g.gain.exponentialRampToValueAtTime(.08,audio.currentTime+.02);g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+.25);o.connect(g).connect(audio.destination);o.start();o.stop(audio.currentTime+.26)}catch{}};
$('soundToggle').addEventListener('click',()=>{alerts=!alerts;$('soundToggle').setAttribute('aria-pressed',String(alerts));$('soundToggle').innerHTML=alerts?'<b>●</b> Reset alerts enabled':'<b>◉</b> Enable reset alerts';if(alerts){audio??=new(window.AudioContext||window.webkitAudioContext)();beep(920)}});

const dailyNext=now=>{const d=new Date(now),base=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate(),1);return now<base?base:base+DAY};
const rivalsNext=now=>{const a=Date.parse(anchorUtc),cycle=(Number(cycleDays)||28)*DAY;if(!Number.isFinite(a))return NaN;if(now<a)return a;return a+(Math.floor((now-a)/cycle)+1)*cycle};
const clock=(prefix,ms)=>{const total=Math.max(0,Math.floor((ms-Date.now())/1000));$(prefix+'h').textContent=pad(Math.floor(total/3600));$(prefix+'m').textContent=pad(Math.floor(total%3600/60));$(prefix+'s').textContent=pad(total%60)};

const update=()=>{
 const now=Date.now(),d=new Date(now);
 $('localClock').textContent=shortFmt.format(d);$('utcClock').textContent=utcFmt.format(d);$('maintenanceLocal').textContent=shortFmt.format(new Date(maintenanceStart))+' → '+shortFmt.format(new Date(maintenanceEnd));

 const dn=dailyNext(now),dailyStart=dn-DAY,dp=Math.min(100,Math.max(0,((now-dailyStart)/DAY)*100));
 clock('d',dn);$('dailyBar').style.width=dp+'%';$('dailyPct').textContent=dp.toFixed(1)+'%';$('dailyUtc').textContent=utcFmt.format(new Date(dn));$('dailyLocal').textContent=localFmt.format(new Date(dn));
 if(dn!==lastDailyReset){if(lastDailyReset&&now>=lastDailyReset)beep(680);lastDailyReset=dn}

 const rn=rivalsEnabled?rivalsNext(now):NaN,cycle=(Number(cycleDays)||28)*DAY;
 if(Number.isFinite(rn)){const start=rn-cycle,rp=Math.min(100,Math.max(0,((now-start)/cycle)*100));clock('r',rn);$('rivalsBar').style.width=rp+'%';$('rivalsPct').textContent=rp.toFixed(1)+'%';$('rivalsUtc').textContent=utcFmt.format(new Date(rn));$('rivalsLocal').textContent=localFmt.format(new Date(rn));$('rivalsTimelineUtc').textContent=utcFmt.format(new Date(rn));if(rn!==lastRivalsReset){if(lastRivalsReset&&now>=lastRivalsReset)beep(620);lastRivalsReset=rn}else{}}

 const start=Date.parse(startUtc),end=endUtc?Date.parse(endUtc):NaN,card=$('eventCard');
 if(!eventEnabled||!Number.isFinite(start)){ $('eventStatus').innerHTML='<i></i> NOT CONFIGURED';$('eventNote').textContent='Event timing is currently disabled or needs an Admin update';card.classList.remove('is-live');}
 else if(now<start){const total=Math.floor((start-now)/1000);$('ed').textContent=String(Math.floor(total/86400)).padStart(2,'0');$('eh').textContent=pad(Math.floor(total%86400/3600));$('em').textContent=pad(Math.floor(total%3600/60));$('es').textContent=pad(total%60);$('eventStatus').innerHTML='<i></i> STARTING SOON';$('eventNote').textContent='The event will switch to LIVE automatically at the configured start time';card.classList.remove('is-live');lastEventState='before'}
 else if(!Number.isFinite(end)||now<end){$('ed').textContent='00';$('eh').textContent='00';$('em').textContent='00';$('es').textContent='00';$('eventStatus').innerHTML='<i></i> LIVE NOW';$('eventNote').textContent=Number.isFinite(end)?'Event is live and will remain active until the configured end time':'Event is live — set an end time in Admin when the event window is known';if(lastEventState!=='live'){beep(980);lastEventState='live'}card.classList.add('is-live')}
 else{$('ed').textContent='00';$('eh').textContent='00';$('em').textContent='00';$('es').textContent='00';$('eventStatus').innerHTML='<i></i> EVENT ENDED';$('eventNote').textContent='The configured event window has ended — update it from Admin for the next event';card.classList.remove('is-live');lastEventState='ended'}
 $('eventUtc').textContent=Number.isFinite(start)?utcFmt.format(new Date(start)):'—';$('eventLocal').textContent=Number.isFinite(start)?localFmt.format(new Date(start)):'—';$('eventTimelineUtc').textContent=Number.isFinite(start)?utcFmt.format(new Date(start)):'EVENT DATE';
 $('dailyMark').textContent='NEXT';$('eventMark').textContent=lastEventState==='live'?'LIVE':'EVENT';
};
update();const timer=setInterval(update,250);document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()});window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});
</script>

<style>
.events-page{position:relative;min-height:calc(100vh - 70px);overflow:hidden;padding:38px 18px 100px;background:#05080d;color:#edf5fa;font-family:var(--sans,system-ui,sans-serif)}
.ambient{position:absolute;border-radius:50%;pointer-events:none;filter:blur(110px);opacity:.13}.ambient-one{width:620px;height:620px;left:-350px;top:100px;background:#1689b7}.ambient-two{width:560px;height:560px;right:-300px;top:560px;background:#624cff}.scanlines{position:absolute;inset:0;opacity:.025;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0,transparent 3px,#9de8ff 4px)}
.hero,.maintenance-feature,.feature-grid,.timeline-section,.timezone-panel{position:relative;z-index:1;width:min(1160px,100%);margin-inline:auto}
.hero{padding:15px 0 27px}.hero-top{display:flex;justify-content:space-between;align-items:center}.eyebrow,.feature-label{font:900 7px var(--mono,monospace);letter-spacing:.17em;color:#62cbed}.eyebrow{display:flex;gap:8px;align-items:center}.live-dot{width:7px;height:7px;border-radius:50%;background:#5de0a0;box-shadow:0 0 0 6px #5de0a014;animation:pulse 1.5s infinite}@keyframes pulse{50%{opacity:.35;transform:scale(.7)}}.clock-strip{display:flex;align-items:center;gap:8px;color:#526878;font:800 6px var(--mono)}.clock-strip strong{color:#d8e8ef;font-size:9px}.clock-strip i{width:1px;height:13px;background:#263944}.hero-copy{display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:end;margin-top:50px}.hero-number{font:900 clamp(120px,19vw,225px)/.72 var(--mono);letter-spacing:-.13em;color:#0d1a22;text-shadow:1px 1px 0 #254050;user-select:none}.hero h1{margin:0;font-size:clamp(55px,8vw,94px);line-height:.83;letter-spacing:-.075em}.hero h1 em{font-style:normal;color:#5bcdf4}.hero-copy p{max-width:650px;margin:17px 0 0;color:#778b9b;font-size:12px;line-height:1.75}.maintenance-feature{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:20px;padding:19px 21px;border:1px solid #55421f;border-radius:18px;background:linear-gradient(105deg,#151008,#0a1015 65%);box-shadow:0 24px 70px #0008;overflow:hidden}.maintenance-glow{position:absolute;width:280px;height:120px;left:0;top:0;background:#ffb52e12;filter:blur(40px);pointer-events:none}.warning-badge{position:relative;width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:#241a09;border:1px solid #765b2c;font-size:21px;animation:float 2.5s ease-in-out infinite}@keyframes float{50%{transform:translateY(-3px) rotate(-2deg)}}.maintenance-main{position:relative}.maintenance-main h2{margin:7px 0 6px;font:900 clamp(18px,2.3vw,25px)/1 var(--mono);letter-spacing:-.06em}.maintenance-main h2 span{color:#f3d69a}.maintenance-main h2 b{color:#6f7c82;margin:0 8px}.maintenance-main p{margin:0;color:#80867f;font-size:9px;line-height:1.5}.maintenance-time{position:relative;text-align:right;padding-left:25px;border-left:1px solid #342f25}.maintenance-time small,.maintenance-time span{display:block;color:#596c79;font:800 6px var(--mono);letter-spacing:.13em}.maintenance-time strong{display:block;margin:5px 0;color:#dff5fb;font:900 10px var(--mono)}.feature-grid{display:grid;grid-template-columns:1.55fr .75fr;gap:14px;margin-top:14px}.event-feature,.reset-card{border:1px solid #1a2c38;background:#080e14;box-shadow:0 25px 70px #0008}.event-feature{display:grid;grid-template-columns:.9fr 1.1fr;min-height:510px;border-radius:22px;overflow:hidden}.event-image{position:relative;min-height:100%;overflow:hidden;background:#071018}.event-image img{width:100%;height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.2,.7,.2,1),filter .5s}.event-feature:hover .event-image img{transform:scale(1.055);filter:saturate(1.15) contrast(1.04)}.image-shade{position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,#080e14),linear-gradient(0deg,#080e14aa,transparent 45%)}.image-tag{position:absolute;left:16px;top:16px;padding:7px 9px;border:1px solid #ffffff20;border-radius:999px;background:#061018bb;backdrop-filter:blur(8px);color:#cdeaf2;font:900 6px var(--mono);letter-spacing:.13em}.event-body{padding:31px 29px;display:flex;flex-direction:column;justify-content:center}.section-line{display:flex;justify-content:space-between;align-items:center;gap:10px}.section-line>span{color:#62cbed;font:900 7px var(--mono);letter-spacing:.15em}.status{display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border:1px solid #294253;border-radius:999px;color:#91a7b4;background:#09151c;font:900 6px var(--mono);white-space:nowrap}.status i{width:6px;height:6px;border-radius:50%;background:#62e3a1}.event-body h2{margin:18px 0 8px;font-size:clamp(34px,4vw,55px);line-height:.9;letter-spacing:-.065em}.event-body>p{margin:0;color:#8193a1;font-size:10px;line-