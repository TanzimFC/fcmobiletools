---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const event = FOOTBALL_CENTRE_CONTENT.eventCountdown;
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset;
const secondary = FOOTBALL_CENTRE_CONTENT.secondaryEvent;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events and Reset | FCMOBILETOOLS',
  description: 'Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.com').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Events and Reset | FCMOBILETOOLS" description="Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion">
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<main class="events-page">
  <div class="fx fx-a"></div><div class="fx fx-b"></div><div class="grid-bg"></div>

  <header class="topbar">
    <div class="brand"><span class="pulse"></span><span>FCMOBILETOOLS</span><b>EVENTS & RESET</b></div>
    <div class="live-clock"><span>LOCAL</span><strong id="localClock">--:--:--</strong><i></i><span>UTC</span><strong id="utcClock">--:--:--</strong><em id="zoneLabel">LOCAL</em></div>
  </header>

  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span>FC MOBILE 27</span><b>LIVE TIMING CENTER</b></div>
      <h1>Events <em>&amp;</em> Reset</h1>
      <p>The FC Mobile timing board. Maintenance, events and resets stay live automatically — with your browser local time as the primary clock and UTC as the universal reference.</p>
      <div class="hero-actions"><a href="#next">See what's next <span>↓</span></a><button id="notifyBtn">◉ Notify me at reset</button></div>
    </div>
    <div class="hero-dial" aria-hidden="true"><div class="dial-ring r1"></div><div class="dial-ring r2"></div><div class="dial-ring r3"></div><div class="dial-core"><small>SEASON</small><strong>27</strong><span>LIVE</span></div></div>
  </section>

  <section class="maintenance" id="maintenanceCard">
    <div class="maint-status"><span class="warning">!</span><div><small>SEASON UPDATE</small><strong id="maintState">MAINTENANCE WINDOW</strong></div></div>
    <div class="maint-main"><h2 id="maintenanceUtcRange">—</h2><p id="maintenanceDescription">Scheduled maintenance before the Anniversary / Season 27 update.</p></div>
    <div class="maint-local"><small>YOUR LOCAL TIME</small><strong id="maintenanceLocal">—</strong><span id="maintCountdown">—</span></div>
  </section>

  <section class="section-head" id="next"><div><small>01 · MAIN EVENT</small><h2>What's happening next</h2></div><span id="syncLabel">● LIVE · SYNCING</span></section>

  <section class="event-layout">
    <article class="main-event" id="eventCard">
      <div class="event-art"><img src={event.banner} alt={event.title} /><div class="art-gradient"></div><div class="art-top"><span>ANNIVERSARY</span><b id="eventBadge">UP NEXT</b></div><div class="art-bottom"><small>FC MOBILE 27</small><strong id="eventArtState">STARTING SOON</strong></div></div>
      <div class="event-info">
        <div class="event-label"><span>{event.accent}</span><b id="eventStatus"><i></i> STARTING SOON</b></div>
        <h3>{event.title}</h3><p class="event-desc">{event.subtitle}</p>
        <div class="countdown"><div><strong id="ed">--</strong><small>DAYS</small></div><i>:</i><div><strong id="eh">--</strong><small>HOURS</small></div><i>:</i><div><strong id="em">--</strong><small>MIN</small></div><i>:</i><div><strong id="es">--</strong><small>SEC</small></div></div>
        <div class="time-grid"><div><small>STARTS IN YOUR TIME</small><strong id="eventLocal">—</strong></div><div><small>UTC REFERENCE</small><strong id="eventUtc">—</strong></div></div>
        <div class="event-state"><span id="stateDot"></span><p id="eventNote">Calculating live event status…</p></div>
      </div>
    </article>

    <aside class="reset-stack">
      <article class="reset-card">
        <div class="card-head"><span class="card-no">02</span><b>EVERY 24H</b></div><small class="label">DAILY RESET</small><h3>Daily Reset</h3><p>Automatically repeats at 01:00 UTC.</p>
        <div class="small-count"><strong id="dh">--</strong><i>:</i><strong id="dm">--</strong><i>:</i><strong id="ds">--</strong></div>
        <div class="progress"><i id="dailyBar"></i></div><div class="reset-foot"><span id="dailyPct">0%</span><strong id="dailyLocal">—</strong></div><small class="utc" id="dailyUtc">—</small>
      </article>
      <article class="reset-card">
        <div class="card-head"><span class="card-no">DR</span><b>28 DAY CYCLE</b></div><small class="label">DIVISION RIVALS</small><h3>Season Reset</h3><p>Calculated from the configured season anchor.</p>
        <div class="small-count"><strong id="rh">--</strong><i>:</i><strong id="rm">--</strong><i>:</i><strong id="rs">--</strong></div>
        <div class="progress"><i id="rivalsBar"></i></div><div class="reset-foot"><span id="rivalsPct">0%</span><strong id="rivalsLocal">—</strong></div><small class="utc" id="rivalsUtc">—</small>
      </article>
    </aside>
  </section>

  <section class="side-event">
    <div class="side-art"><img src={secondary.banner} alt={secondary.title} /><span>UPCOMING</span></div>
    <div class="side-copy"><small class="label">02 · UPCOMING SIDE EVENT</small><h2>{secondary.title}</h2><p>{secondary.subtitle}</p><div class="side-date"><small>COMING</small><strong>24 SEP</strong><span>2026</span></div><p class="note">{secondary.note}</p></div>
    <div class="side-count"><small>EVENT COUNTDOWN</small><strong id="secondaryCountdown">--:--:--</strong><span id="secondaryState">WAITING</span></div>
  </section>

  <section class="timeline"><div class="section-head"><div><small>03 · QUICK VIEW</small><h2>Your next moments</h2></div><p>No manual refresh. The page keeps its own clock.</p></div>
    <div class="moment-grid"><div><span>01</span><small>DAILY</small><strong>Daily Reset</strong><b id="momentDaily">—</b></div><div class="active"><span>27</span><small>SEASON 27</small><strong>Anniversary Event</strong><b id="momentEvent">—</b></div><div><span>DR</span><small>COMPETITIVE</small><strong>Division Rivals</strong><b id="momentRivals">—</b></div></div>
  </section>

  <footer class="trust"><div><small>TIMEZONE SAFE</small><h2>One schedule.<br><em>Every timezone.</em></h2></div><p>All scheduled moments are based on UTC. Your browser converts them automatically, so the countdown remains consistent wherever you are.</p><span id="footerSync">LIVE</span></footer>
</main><script define:vars={{ startUtc:event.startUtc, endUtc:event.endUtc, eventEnabled:event.enabled, anchorUtc:rivals.anchorUtc, cycleDays:rivals.cycleDays, rivalsEnabled:rivals.enabled, secondaryStartUtc:secondary.startUtc, dailyResetUtc:FOOTBALL_CENTRE_CONTENT.schedule?.dailyResetUtc || "01:00", maintenanceOffsetMinutes:FOOTBALL_CENTRE_CONTENT.schedule?.maintenanceOffsetMinutes || 270, maintenanceLabel:FOOTBALL_CENTRE_CONTENT.schedule?.maintenanceLabel || "Scheduled maintenance before the Anniversary / Season 27 update." }}>
(() => {
const $=id=>document.getElementById(id),DAY=86400000,pad=n=>String(Math.max(0,Number(n)||0)).padStart(2,'0');
const safeDate=v=>{const n=Date.parse(v||'');return Number.isFinite(n)?n:NaN};
const fmt=zone=>new Intl.DateTimeFormat('en-GB',{timeZone:zone,weekday:'short',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZoneName:'short'});
const short=zone=>new Intl.DateTimeFormat('en-GB',{timeZone:zone,day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
const localZone=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';
const localFull=fmt(localZone),localShort=short(localZone),utcFull=fmt('UTC');
const set=(id,v)=>{const x=$(id);if(x)x.textContent=v};
const eventFallback='2026-09-24T02:00:00.000Z';
const dailyResetParts=String(dailyResetUtc||'01:00').split(':').map(Number);
const dailyResetHour=Number.isFinite(dailyResetParts[0])?Math.max(0,Math.min(23,dailyResetParts[0])):1;
const dailyResetMinute=Number.isFinite(dailyResetParts[1])?Math.max(0,Math.min(59,dailyResetParts[1])):0;
const maintenanceOffset=Math.max(0,Number(maintenanceOffsetMinutes)||270);
let eventCfg={startUtc:safeDate(startUtc)?startUtc:eventFallback,endUtc:endUtc||'',enabled:eventEnabled!==false};
let rivalsCfg={anchorUtc:safeDate(anchorUtc)?anchorUtc:eventFallback,cycleDays:Number(cycleDays)||28,enabled:rivalsEnabled!==false};
let secondaryCfg={startUtc:safeDate(secondaryStartUtc)?secondaryStartUtc:'2026-09-24T00:00:00.000Z'};
set('zoneLabel',localZone);
const duration=ms=>{let s=Math.max(0,Math.floor(ms/1000));return{d:Math.floor(s/86400),h:Math.floor(s%86400/3600),m:Math.floor(s%3600/60),s:s%60}};
const write=(p,ms,days=true)=>{const t=duration(ms);if(days)set(p+'d',pad(t.d));set(p+'h',pad(t.h));set(p+'m',pad(t.m));set(p+'s',pad(t.s))};
const dailyNext=now=>{const d=new Date(now),b=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate(),dailyResetHour,dailyResetMinute);return now<b?b:b+DAY};
const rivalsNext=now=>{const a=safeDate(rivalsCfg.anchorUtc),cy=Math.max(1,Number(rivalsCfg.cycleDays)||28)*DAY;if(!Number.isFinite(a))return NaN;if(now<a)return a;return a+(Math.floor((now-a)/cy)+1)*cy};
const sync=async()=>{try{const r=await fetch('/api/football?live='+Date.now(),{cache:'no-store',credentials:'same-origin'});if(!r.ok)throw Error();const c=(await r.json())?.content;if(c?.eventCountdown?.startUtc)eventCfg={...eventCfg,...c.eventCountdown};if(c?.divisionRivalsReset?.anchorUtc)rivalsCfg={...rivalsCfg,...c.divisionRivalsReset};if(c?.secondaryEvent?.startUtc)secondaryCfg={...secondaryCfg,...c.secondaryEvent};set('syncLabel','● LIVE · SYNCED');set('footerSync','LIVE · SYNCED')}catch{set('syncLabel','● LIVE · AUTO CLOCK');set('footerSync','CLOCK RUNNING')}};
const render=()=>{
 const now=Date.now(),start=safeDate(eventCfg.startUtc),end=safeDate(eventCfg.endUtc),maintStart=Number.isFinite(start)?start-maintenanceOffset*60000:NaN;
 set('localClock',localFull.format(new Date(now)));set('utcClock',utcFull.format(new Date(now)));set('zoneLabel',localZone);
 if(Number.isFinite(maintStart)&&Number.isFinite(start)){set('maintenanceLocal',localShort.format(new Date(maintStart))+' → '+localShort.format(new Date(start)));set('maintenanceUtcRange',utcFull.format(new Date(maintStart))+' → '+utcFull.format(new Date(start)));set('maintenanceDescription',maintenanceLabel);set('maintCountdown',now<maintStart?'Maintenance starts '+localShort.format(new Date(maintStart)):now<start?duration(start-now).h+'h '+pad(duration(start-now).m)+'m until update':'Update window reached');set('maintState',now<maintStart?'MAINTENANCE WINDOW':now<start?'MAINTENANCE SOON':'UPDATE WINDOW COMPLETE')}
 const dn=dailyNext(now),ds=dn-DAY,dp=((now-ds)/DAY)*100;write('d',dn-now);set('dailyBar',null);const db=$('dailyBar');if(db)db.style.width=Math.min(100,Math.max(0,dp))+'%';set('dailyPct',Math.floor(dp)+'%');set('dailyLocal',localFull.format(new Date(dn)));set('dailyUtc',utcFull.format(new Date(dn)));set('momentDaily',localShort.format(new Date(dn)));
 const rn=rivalsCfg.enabled!==false?rivalsNext(now):NaN,cy=(Number(rivalsCfg.cycleDays)||28)*DAY;if(Number.isFinite(rn)){const rs=rn-cy,rp=((now-rs)/cy)*100;write('r',rn-now,false);const rb=$('rivalsBar');if(rb)rb.style.width=Math.min(100,Math.max(0,rp))+'%';set('rivalsPct',Math.floor(rp)+'%');set('rivalsLocal',localFull.format(new Date(rn)));set('rivalsUtc',utcFull.format(new Date(rn)));set('momentRivals',localShort.format(new Date(rn)))}
 if(eventCfg.enabled!==false&&Number.isFinite(start)){const before=now<start,live=!before&&(!Number.isFinite(end)||now<end);write('e',Math.max(0,start-now));set('eventLocal',localFull.format(new Date(start)));set('eventUtc',utcFull.format(new Date(start)));set('momentEvent',before?localShort.format(new Date(start)):(live?'LIVE NOW':'ENDED'));set('eventStatus',(before?'● STARTING SOON':live?'● LIVE NOW':'● ENDED'));set('eventBadge',before?'UP NEXT':live?'LIVE':'ENDED');set('eventArtState',before?'STARTING SOON':live?'LIVE NOW':'ENDED');set('eventNote',before?(now>=maintStart&&now<start?'Maintenance is active before the event start.':'Countdown is running automatically — no refresh needed.'):(live?'The event is live now.':'This event has ended.'));const dot=$('stateDot');if(dot)dot.className=live?'live':''}
 const sc=safeDate(secondaryCfg.startUtc)||safeDate('2026-09-24T00:00:00Z'),sd=duration(sc-now);set('secondaryCountdown',sd.d>0?pad(sd.d)+'d '+pad(sd.h)+':'+pad(sd.m)+':'+pad(sd.s):pad(sd.h)+':'+pad(sd.m)+':'+pad(sd.s));set('secondaryState',now<sc?'UPCOMING':'LIVE');
};
setInterval(render,1000);setInterval(sync,20000);render();sync();document.addEventListener('visibilitychange',()=>{if(!document.hidden){render();sync()}});
})();
</script><style>
:root{--bg:#05080b;--panel:#0a1116;--panel2:#0d171d;--line:#1b303a;--cyan:#5de0ff;--green:#54e5a0;--text:#edf8fb;--muted:#78909b;--dim:#506771;--mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
.events-page{min-height:100vh;background:#05080b;color:var(--text);padding:18px 22px 80px;position:relative;overflow:hidden;font-family:Inter,system-ui,sans-serif}.grid-bg{position:absolute;inset:0;opacity:.12;background-image:linear-gradient(#1b3944 1px,transparent 1px),linear-gradient(90deg,#1b3944 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,#000,transparent 70%);pointer-events:none}.fx{position:absolute;border-radius:50%;filter:blur(100px);opacity:.16;pointer-events:none}.fx-a{width:500px;height:500px;background:#00a9d0;left:-330px;top:250px}.fx-b{width:450px;height:450px;background:#6745ff;right:-300px;top:900px}.topbar,.hero,.maintenance,.section-head,.event-layout,.side-event,.timeline,.trust{max-width:1180px;margin-inline:auto;position:relative;z-index:1}.topbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #14252d;padding:2px 0 16px}.brand{display:flex;align-items:center;gap:10px;font:900 9px var(--mono);letter-spacing:.1em}.brand b{margin-left:6px;color:#62818c;font-size:7px;border-left:1px solid #28404a;padding-left:12px}.pulse{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px #54e5a015}.live-clock{display:flex;align-items:center;gap:8px;font:800 7px var(--mono);color:#68828c}.live-clock strong{color:#dcecf1;font-size:10px}.live-clock i{height:13px;width:1px;background:#29404a}
.hero{min-height:410px;display:flex;align-items:center;justify-content:space-between;gap:50px;padding:65px 0 45px}.hero-copy{max-width:700px}.eyebrow{display:flex;gap:9px;align-items:center;font:900 7px var(--mono);letter-spacing:.13em}.eyebrow span{padding:7px 9px;border:1px solid #23505f;border-radius:999px;color:var(--cyan);background:#07151a}.eyebrow b{color:#617b86}.hero h1{font-size:clamp(60px,9vw,106px);line-height:.82;letter-spacing:-.08em;margin:18px 0}.hero h1 em{font-style:normal;color:var(--cyan)}.hero p{max-width:600px;color:var(--muted);font-size:11px;line-height:1.8}.hero-actions{display:flex;gap:10px;margin-top:25px}.hero-actions a,.hero-actions button{border:1px solid #25404b;background:#0a1419;color:#d5ebf0;padding:11px 14px;border-radius:9px;font:900 7px var(--mono);text-decoration:none;cursor:pointer}.hero-actions a{background:var(--cyan);color:#041014;border-color:var(--cyan)}.hero-actions span{margin-left:8px}.hero-dial{width:300px;height:300px;position:relative;display:grid;place-items:center;flex:none}.dial-ring{position:absolute;border:1px solid #24505c;border-radius:50%;transform:rotate(-25deg)}.r1{width:280px;height:125px}.r2{width:215px;height:270px;transform:rotate(42deg);border-color:#29443f}.r3{width:175px;height:175px;border-style:dashed}.dial-core{width:110px;height:110px;border:1px solid #326274;border-radius:50%;background:#091319;display:grid;place-items:center;align-content:center;box-shadow:0 0 70px #39d8ff16}.dial-core small,.dial-core span{font:900 6px var(--mono);letter-spacing:.2em;color:#64828d}.dial-core strong{font:900 55px/.8 var(--mono);letter-spacing:-.1em}
.maintenance{display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;padding:18px;border:1px solid #594622;border-radius:15px;background:linear-gradient(100deg,#161106,#0a1115);box-shadow:0 20px 70px #0009}.maint-status{display:flex;gap:10px;align-items:center}.warning{width:40px;height:40px;display:grid;place-items:center;border-radius:11px;background:#2a1f0d;border:1px solid #6a5226;color:#ffd36d;font-weight:900}.maint-status small,.maint-local small{display:block;color:#657b84;font:900 6px var(--mono);letter-spacing:.1em}.maint-status strong{display:block;margin-top:4px;font:900 9px var(--mono)}.maint-main h2{margin:0;font:900 22px var(--mono);letter-spacing:-.06em}.maint-main h2 span{font-size:7px;color:#687d86}.maint-main h2 i{font-style:normal;color:#536d77;margin:0 7px}.maint-main p{margin:5px 0 0;color:#71858e;font-size:8px}.maint-local{text-align:right;border-left:1px solid #3c321e;padding-left:20px}.maint-local strong{display:block;margin:6px 0;font:900 8px var(--mono)}.maint-local span{color:#6c817f;font:700 6px var(--mono)}
.section-head{display:flex;justify-content:space-between;align-items:end;margin-top:55px;margin-bottom:15px}.section-head small,.label,.section-head>div>small,.trust small{font:900 6px var(--mono);letter-spacing:.16em;color:var(--cyan)}.section-head h2{margin:7px 0 0;font-size:30px;letter-spacing:-.06em}.section-head>span{color:#58b88e;font:900 6px var(--mono)}
.event-layout{display:grid;grid-template-columns:1.55fr .75fr;gap:13px}.main-event{min-height:555px;border:1px solid var(--line);border-radius:19px;background:var(--panel);overflow:hidden;display:grid;grid-template-columns:.92fr 1.08fr;box-shadow:0 30px 90px #000b}.event-art{position:relative;overflow:hidden;background:#071015}.event-art img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1s}.main-event:hover .event-art img{transform:scale(1.04)}.art-gradient{position:absolute;inset:0;background:linear-gradient(90deg,transparent 35%,#0a1116),linear-gradient(0deg,#061016d9,transparent 55%)}.art-top,.art-bottom{position:absolute;left:16px;right:16px;display:flex;justify-content:space-between;align-items:center}.art-top{top:16px}.art-top span,.art-top b,.art-bottom strong{padding:7px 9px;border-radius:999px;background:#071017d9;border:1px solid #ffffff1e;font:900 6px var(--mono);letter-spacing:.1em}.art-top span{color:#b8e3ed}.art-top b{color:var(--cyan)}.art-bottom{bottom:16px}.art-bottom small{font:900 6px var(--mono);color:#9bcbd7;letter-spacing:.12em}.event-info{padding:35px 30px;display:flex;flex-direction:column;justify-content:center}.event-label{display:flex;justify-content:space-between;gap:12px;align-items:center}.event-label>span{color:#6f919d;font:900 6px var(--mono);letter-spacing:.12em}.event-label>b{font:900 6px var(--mono);color:#a9c4cd}.event-label i{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--green);margin-right:5px}.event-info h3{font-size:clamp(38px,4.4vw,62px);line-height:.88;letter-spacing:-.08em;margin:14px 0}.event-desc{color:#758c96;font-size:9px;line-height:1.65;margin:0}.countdown{display:flex;align-items:center;gap:8px;margin:34px 0 24px}.countdown div{min-width:52px}.countdown strong{font:900 clamp(31px,4vw,49px)/.85 var(--mono);letter-spacing:-.08em}.countdown small{display:block;margin-top:7px;color:#55717c;font:900 5px var(--mono);letter-spacing:.08em}.countdown>i{font:900 20px 