---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOOTBALL_CENTRE_CONTENT } from '../data/footballCentre.js';

const event = FOOTBALL_CENTRE_CONTENT.eventCountdown;
const rivals = FOOTBALL_CENTRE_CONTENT.divisionRivalsReset;
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FC Mobile Events and Reset | FCMOBILETOOLS',
  description: 'Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion.',
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://fcmobiletools.com').href,
  publisher: { '@type': 'Organization', name: 'FCMOBILETOOLS' },
};
---
<BaseLayout title="FC Mobile Events and Reset | FCMOBILETOOLS" description="Live FC Mobile daily reset, Anniversary Event and Division Rivals season reset countdowns in one place, with UTC reference and automatic local-time conversion">
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<main class="events-page">
  <div class="aurora aurora-a"></div><div class="aurora aurora-b"></div><div class="grid-glow"></div>

  <section class="hero">
    <div class="hero-kicker"><span class="live-dot"></span> FCMOBILETOOLS / LIVE TIMING</div>
    <h1>Events and <em>Reset</em></h1>
    <p>Every important FC Mobile timing signal in one place — daily reset, Anniversary Event and Division Rivals season reset, all driven from the same UTC clock.</p>
    <div class="hero-bar">
      <div><span>YOUR LOCAL CLOCK</span><strong id="localClock">—</strong></div>
      <div><span>UTC REFERENCE</span><strong id="utcClock">—</strong></div>
      <button id="soundToggle" type="button" aria-pressed="false"><b>◉</b> Enable reset alerts</button>
    </div>
  </section>

  <section class="command-grid">
    <article class="main-card event-card" id="eventCard">
      {event.banner && <img src={event.banner} alt={event.title} loading="eager" />}
      <div class="card-content">
        <div class="card-head"><span class="label">{event.accent}</span><span class="status" id="eventStatus"><i></i> STARTING SOON</span></div>
        <h2>{event.title}</h2>
        <p>{event.subtitle}</p>
        <div class="countdown" aria-label="Anniversary Event countdown">
          <div><strong id="ed">--</strong><small>DAYS</small></div><b>:</b><div><strong id="eh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="em">--</strong><small>MINUTES</small></div><b>:</b><div><strong id="es">--</strong><small>SECONDS</small></div>
        </div>
        <div class="details"><div><small>EVENT START — UTC</small><strong id="eventUtc">—</strong></div><div><small>EVENT START — LOCAL</small><strong id="eventLocal">—</strong></div></div>
        <p class="state-note" id="eventNote">Waiting for the configured event start</p>
      </div>
    </article>

    <article class="reset-card daily-card">
      <div class="card-head"><div><span class="label">DAILY RESET</span><h2>Daily Reset</h2></div><span class="status live"><i></i> EVERY DAY</span></div>
      <p>The daily UTC reset reference, converted automatically to your local timezone.</p>
      <div class="mini-countdown"><div><strong id="dh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="dm">--</strong><small>MINUTES</small></div><b>:</b><div><strong id="ds">--</strong><small>SECONDS</small></div></div>
      <div class="progress"><div><span>RESET PROGRESS</span><strong id="dailyPct">0%</strong></div><i><b id="dailyBar"></b></i></div>
      <div class="details"><div><small>NEXT RESET — UTC</small><strong id="dailyUtc">—</strong></div><div><small>NEXT RESET — LOCAL</small><strong id="dailyLocal">—</strong></div></div>
    </article>

    <article class="reset-card rivals-card">
      <div class="card-head"><div><span class="label">DIVISION RIVALS</span><h2>Season Reset</h2></div><span class="status live"><i></i> {rivals.cycleDays} DAYS</span></div>
      <p>{rivals.label}</p>
      <div class="mini-countdown"><div><strong id="rh">--</strong><small>HOURS</small></div><b>:</b><div><strong id="rm">--</strong><small>MINUTES</small></div><b>:</b><div><strong id="rs">--</strong><small>SECONDS</small></div></div>
      <div class="progress"><div><span>SEASON PROGRESS</span><strong id="rivalsPct">0%</strong></div><i><b id="rivalsBar"></b></i></div>
      <div class="details"><div><small>NEXT RESET — UTC</small><strong id="rivalsUtc">—</strong></div><div><small>NEXT RESET — LOCAL</small><strong id="rivalsLocal">—</strong></div></div>
    </article>
  </section>

  <section class="schedule">
    <div class="schedule-head"><div><span class="label">ALL IN ONE PLACE</span><h2>What happens next</h2></div><p>These clocks share one timing model, so the same UTC instant is displayed correctly for every visitor.</p></div>
    <div class="timeline">
      <div class="timeline-item"><span class="node"></span><div><b>01:00 UTC</b><strong>Daily Reset</strong><small>Repeats every day</small></div><span class="next-mark" id="dailyMark">NEXT</span></div>
      <div class="timeline-item"><span class="node"></span><div><b id="eventTimelineUtc">24 SEP 2026</b><strong>Anniversary Event</strong><small>Event state changes automatically at start</small></div><span class="next-mark" id="eventMark">EVENT</span></div>
      <div class="timeline-item"><span class="node"></span><div><b id="rivalsTimelineUtc">—</b><strong>Division Rivals Reset</strong><small>{rivals.cycleDays}-day season cycle</small></div><span class="next-mark">CYCLE</span></div>
    </div>
  </section>

  <section class="reference">
    <div><span class="label">TIMEZONE SAFE</span><h2>UTC is the reference<br /><em>local time is yours</em></h2><p>All countdowns use the scheduled UTC timestamp internally. Your browser then converts that exact moment to its own IANA timezone. Nothing depends on the visitor's server location.</p></div>
    <div class="reference-cards"><div><b>01:00 UTC</b><span>Daily reset reference</span></div><div><b>{rivals.cycleDays} DAYS</b><span>Division Rivals cycle</span></div><div><b>LIVE</b><span>Event status rolls automatically</span></div></div>
  </section>
</main>

<script define:vars={{ startUtc: event.startUtc, endUtc: event.endUtc, eventEnabled: event.enabled, anchorUtc: rivals.anchorUtc, cycleDays: rivals.cycleDays, rivalsEnabled: rivals.enabled }}>
const $=id=>document.getElementById(id),DAY=86400000,pad=n=>String(n).padStart(2,'0');
const zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';
const localFmt=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
const utcFmt=new Intl.DateTimeFormat('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZone:'UTC',timeZoneName:'short'});
const shortFmt=new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'});
let alerts=false,audio=null,lastEventState='before',lastDailyReset=0,lastRivalsReset=0;

const beep=(freq=760)=>{if(!alerts)return;try{audio??=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(.0001,audio.currentTime);g.gain.exponentialRampToValueAtTime(.08,audio.currentTime+.02);g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+.25);o.connect(g).connect(audio.destination);o.start();o.stop(audio.currentTime+.26)}catch{}};
$('soundToggle').addEventListener('click',()=>{alerts=!alerts;$('soundToggle').setAttribute('aria-pressed',String(alerts));$('soundToggle').innerHTML=alerts?'<b>●</b> Reset alerts enabled':'<b>◉</b> Enable reset alerts';if(alerts){audio??=new(window.AudioContext||window.webkitAudioContext)();beep(920)}});

const dailyNext=now=>{const d=new Date(now),base=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate(),1);return now<base?base:base+DAY};
const rivalsNext=now=>{const a=Date.parse(anchorUtc),cycle=(Number(cycleDays)||28)*DAY;if(!Number.isFinite(a))return NaN;if(now<a)return a;return a+(Math.floor((now-a)/cycle)+1)*cycle};
const clock=(prefix,ms)=>{const total=Math.max(0,Math.floor((ms-Date.now())/1000));$(prefix+'h').textContent=pad(Math.floor(total/3600));$(prefix+'m').textContent=pad(Math.floor(total%3600/60));$(prefix+'s').textContent=pad(total%60)};

const update=()=>{
 const now=Date.now(),d=new Date(now);
 $('localClock').textContent=shortFmt.format(d);$('utcClock').textContent=utcFmt.format(d);

 const dn=dailyNext(now),dailyStart=dn-DAY,dp=Math.min(100,Math.max(0,((now-dailyStart)/DAY)*100));
 clock('d',dn);$('dailyBar').style.width=dp+'%';$('dailyPct').textContent=dp.toFixed(1)+'%';$('dailyUtc').textContent=utcFmt.format(new Date(dn));$('dailyLocal').textContent=localFmt.format(new Date(dn));
 if(dn!==lastDailyReset){if(lastDailyReset&&now>=lastDailyReset)beep(680);lastDailyReset=dn}

 const rn=rivalsEnabled?rivalsNext(now):NaN,cycle=(Number(cycleDays)||28)*DAY;
 if(Number.isFinite(rn)){const start=rn-cycle,rp=Math.min(100,Math.max(0,((now-start)/cycle)*100));clock('r',rn);$('rivalsBar').style.width=rp+'%';$('rivalsPct').textContent=rp.toFixed(1)+'%';$('rivalsUtc').textContent=utcFmt.format(new Date(rn));$('rivalsLocal').textContent=localFmt.format(new Date(rn));$('rivalsTimelineUtc').textContent=utcFmt.format(new Date(rn));if(rn!==lastRivalsReset){if(lastRivalsReset&&now>=lastRivalsReset)beep(620);lastRivalsReset=rn}else{}}

 const start=Date.parse(startUtc),end=endUtc?Date.parse(endUtc):NaN,card=$('eventCard');
 if(!eventEnabled||!Number.isFinite(start)){ $('eventStatus').innerHTML='<i></i> NOT CONFIGURED';$('eventNote').textContent='Event timing is currently disabled or needs an Admin update';card.classList.remove('is-live');}
 else if(now<start){const total=Math.floor((start-now)/1000);$('ed').textContent=String(Math.floor(total/86400)).padStart(2,'0');$('eh').textContent=pad(Math.floor(total%86400/3600));$('em').textContent=pad(Math.floor(total%3600/60));$('es').textContent=pad(total%60);$('eventStatus').innerHTML='<i></i> STARTING SOON';$('eventNote').textContent='The event will switch to LIVE automatically at the configured start time';card.classList.remove('is-live');lastEventState='before'}
 else if(!Number.isFinite(end)||now<end){$('ed').textContent='00';$('eh').textContent='00';$('em').textContent='00';$('es').textContent='00';$('eventStatus').innerHTML='<i></i> LIVE NOW';$('eventNote').textContent=Number.isFinite(end)?'Event is live and will remain active until the configured end time':'Event is live — set an end time in Admin when the event window is known';if(lastEventState!=='live'){beep(980);lastEventState='live'}card.classList.add('is-live')}
 else{$('ed').textContent='00';$('eh').textContent='00';$('em').textContent='00';$('es').textContent='00';$('eventStatus').innerHTML='<i></i> EVENT ENDED';$('eventNote').textContent='The configured event window has ended — update it from Admin for the next event';card.classList.remove('is-live');lastEventState='ended'}
 $('eventUtc').textContent=Number.isFinite(start)?utcFmt.format(new Date(start)):'—';$('eventLocal').textContent=Number.isFinite(start)?localFmt.format(new Date(start)):'—';$('eventTimelineUtc').textContent=Number.isFinite(start)?utcFmt.format(new Date(start)):'EVENT DATE';
 $('dailyMark').textContent='NEXT';$('eventMark').textContent=lastEventState==='live'?'LIVE':'EVENT';
};
update();const timer=setInterval(update,250);document.addEventListener('visibilitychange',()=>{if(!document.hidden)update()});window.addEventListener('pagehide',()=>clearInterval(timer),{once:true});
</script>

<style>
.events-page{min-height:calc(100vh - 70px);position:relative;overflow:hidden;background:#05090e;color:#f5f8fc;padding:clamp(48px,7vw,88px) 18px 100px}.aurora{position:absolute;width:620px;height:620px;border-radius:50%;filter:blur(130px);opacity:.12;pointer-events:none}.aurora-a{left:-360px;top:20px;background:#39c7ff}.aurora-b{right:-360px;top:420px;background:#596cff}.grid-glow{position:absolute;inset:0;opacity:.035;background-image:linear-gradient(#7cdfff 1px,transparent 1px),linear-gradient(90deg,#7cdfff 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,#000,transparent 80%);pointer-events:none}.hero,.command-grid,.schedule,.reference{position:relative;z-index:1;width:min(1140px,100%);margin-inline:auto}.hero{text-align:center}.hero-kicker{display:inline-flex;align-items:center;gap:8px;color:#72d6f4;font:900 8px var(--mono,monospace);letter-spacing:.17em}.live-dot{width:7px;height:7px;border-radius:50%;background:#64e4a0;box-shadow:0 0 0 6px #64e4a012;animation:dotPulse 1.4s infinite}@keyframes dotPulse{50%{opacity:.3;transform:scale(.7)}}.hero h1{margin:18px 0 13px;font-size:clamp(54px,8vw,92px);line-height:.86;letter-spacing:-.075em}.hero h1 em{font-style:normal;color:#55c7f2}.hero>p{max-width:740px;margin:auto;color:#8d9bad;font-size:14px;line-height:1.8}.hero-bar{display:flex;align-items:center;justify-content:center;gap:9px;margin:28px auto 0;flex-wrap:wrap}.hero-bar>div,.hero-bar button{min-height:40px;padding:10px 13px;border:1px solid #1c3341;border-radius:10px;background:#09131a}.hero-bar>div{text-align:left}.hero-bar span{display:block;color:#52687a;font:800 6px var(--mono);letter-spacing:.13em}.hero-bar strong{display:block;color:#d9edf3;font:900 10px var(--mono);margin-top:3px}.hero-bar button{color:#7fd4ee;font:900 7px var(--mono);cursor:pointer;transition:.2s}.hero-bar button:hover{border-color:#55c7f2;transform:translateY(-2px)}.command-grid{display:grid;grid-template-columns:1.18fr .82fr;gap:13px;margin-top:48px}.main-card,.reset-card{border:1px solid #1b2d3b;border-radius:22px;background:linear-gradient(145deg,#0a151d,#071017);box-shadow:0 28px 85px #0008;overflow:hidden}.main-card{display:grid;grid-template-columns:minmax(0,.92fr) minmax(330px,1.08fr);min-height:430px}.main-card>img{width:100%;height:100%;min-height:430px;object-fit:cover}.card-content{padding:28px 30px}.card-head{display:flex;justify-content:space-between;gap:12px;align-items:start}.label{color:#55c7f2;font:900 7px var(--mono);letter-spacing:.15em}.status{display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border:1px solid #294253;border-radius:999px;color:#8ea2af;background:#09151c;font:900 7px var(--mono);letter-spacing:.07em;white-space:nowrap}.status i{width:6px;height:6px;border-radius:50%;background:#62e3a1;box-shadow:0 0 0 4px #62e3a112}.card-content h2{font-size:clamp(32px,4vw,53px);line-height:.92;letter-spacing:-.06em;margin:17px 0 9px}.card-content>p{color:#8796a8;font-size:11px;line-height:1.7;margin:0}.countdown{display:flex;align-items:flex-start;gap:7px;margin:28px 0}.countdown div{min-width:56px}.countdown strong{display:block;font:900 clamp(30px,3.7vw,50px)/.9 var(--mono);letter-spacing:-.08em}.countdown small,.mini-countdown small{display:block;margin-top:8px;color:#506477;font:800 6px var(--mono);letter-spacing:.12em}.countdown>b,.mini-countdown>b{color:#304151;font:700 22px var(--mono)}.details{display:grid;grid-template-columns:1fr 1fr;gap:8px}.details div{padding:11px 12px;border-left:1px solid #294052;background:#ffffff02}.details small{display:block;color:#53677a;font:800 6px var(--mono);letter-spacing:.12em}.details strong{display:block;color:#d9e7ef;font-size:9px;line-height:1.5;margin-top:5px}.state-note{margin-top:10px!important;color:#61c9e9!important;font:800 7px var(--mono)!important}.is-live{border-color:#7f3038;box-shadow:0 28px 85px #0008,0 0 70px #ff3b4522}.is-live .status{color:#9cffc5;border-color:#2b6548;background:#092017}.is-live .status i{background:#ff4652;box-shadow:0 0 0 4px #ff465214,0 0 16px #ff4652;animation:liveBlink .7s infinite}@keyframes liveBlink{50%{opacity:.25;transform:scale(.65)}}.is-live>img{animation:bannerPulse 2.6s ease-in-out infinite}@keyframes bannerPulse{50%{filter:saturate(1.12) brightness(1.06);transform:scale(1.012)}}.reset-card{padding:25px;transition:.25s}.reset-card:hover{transform:translateY(-5px);border-color:#31586d;box-shadow:0 30px 70px #0009}.reset-card+.reset-card{margin-top:13px}.reset-card h2{margin:7px 0 0;font-size:21px;letter-spacing:-.04em}.reset-card>p{color:#8190a2;font-size:10px;line-height:1.65;margin:14px 0 0}.mini-countdown{display:flex;align-items:flex-start;gap:6px;margin:24px 0 18px}.mini-countdown div{min-width:54px}.mini-countdown strong{font:900 clamp(28px,3vw,43px)/.9 var(--mono);letter-spacing:-.08em}.progress{margin-top:16px}.progress>div{display:flex;justify-content:space-between;color:#5f7385;font:800 7px var(--mono);letter-spacing:.1em}.progress>div strong{color:#d9f5ff;font-size:8px}.progress>i{display:block;height:8px;margin-top:7px;border-radius:999px;background:#111d26;border:1px solid #1b303e;overflow:hidden}.progress>i b{display:block;height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#536dff,#55c7f2);box-shadow:0 0 18px #55c7f255;transition:width .25s linear;position:relative}.progress>i b:after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent,#fff8,transparent);transform:translateX(-120%);animation:scan 1.7s linear infinite}@keyframes scan{to{transform:translateX(120%)}}.schedule{margin-top:72px;padding-top:25px;border-top:1px solid #182936}.schedule-head{display:flex;justify-content:space-between;align-items:end;gap:35px}.schedule-head h2{font-size:34px;letter-spacing:-.05em;margin:9px 0 0}.schedule-head p{max-width:420px;color:#748596;font-size:10px;line-height:1.7;margin:0}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.timeline-item{position:relative;display:flex;align-items:flex-start;gap:12px;padding:17px;border:1px solid #182a37;border-radius:14px;background:#080f15;transition:.2s}.timeline-item:hover{transform:translateY(-3px);border-color:#315468}.node{width:8px;height:8px;flex:none;margin-top:4px;border-radius:50%;background:#55c7f2;box-shadow:0 0 0 5px #55c7f211}.timeline-item b,.timeline-item strong,.timeline-item small{display:block}.timeline-item b{color:#55c7f2;font:900 7px var(--mono);letter-spacing:.08em}.timeline-item strong{margin-top:6px;color:#dce7ee;font-size:13px}.timeline-item small{margin-top:4px;color:#6e8293;font-size:8px;line-height:1.5}.next-mark{margin-left:auto;color:#6bde9e;font:900 6px var(--mono);letter-spacing:.1em}.reference{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:72px;padding:26px 0 0;border-top:1px solid #182936}.reference h2{font-size:31px;line-height:.96;letter-spacing:-.055em;margin:9px 0 12px}.reference h2 em{font-style:normal;color:#55c7f2}.reference p{max-width:570px;color:#748596;font-size:10px;line-height:1.8}.reference-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;align-self:end}.reference-cards div{padding:14px;border:1px solid #182a37;border-radius:12px;background:#080f15}.reference-cards b{display:block;color:#dce8ef;font:900 10px var(--mono)}.reference-cards span{display:block;margin-top:6px;color:#6d8090;font-size:8px;line-height:1.4}@media(max-width:930px){.command-grid{grid-template-columns:1fr}.main-card{grid-template-columns:1fr 1fr}.timeline{grid-template-columns:1fr}.reference{grid-template-columns:1fr}}@media(max-width:650px){.events-page{padding-inline:13px}.main-card{grid-template-columns:1fr}.main-card>img{min-height:250px;max-height:360px}.card-content{padding:22px}.details{grid-template-columns:1fr}.hero h1{font-size:52px}.hero-bar{justify-content:stretch}.hero-bar>div,.hero-bar button{flex:1}.countdown{gap:4px}.countdown div{min-width:0;flex:1}.countdown strong{font-size:29px}.mini-countdown div{min-width:0;flex:1}.mini-countdown strong{font-size:27px}.reference-cards{grid-template-columns:1fr}.schedule{margin-top:55px}}
</style>