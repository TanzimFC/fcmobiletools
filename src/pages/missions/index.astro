---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="Missions | FCMobiletools Account"
  description="Configurable daily, weekly, event and community missions with server-side verification on FCMobiletools."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="mod-page">
    <div class="mod-wrap">
      <AccountNav active="missions" sectionLabel="Missions" />

      <header class="mod-head acc-anim">
        <div>
          <span class="mod-kicker"><i class="mod-dot"></i> CONFIGURABLE PROGRESSION</span>
          <h1>Useful activity, not a click farm.</h1>
          <p>
            Missions reward verified FC Mobile companion actions—such as tournament matches, event objectives and approved data contributions. Page refreshes never grant XP.
          </p>
        </div>

        <div class="mod-filters" id="missionFilters" role="group" aria-label="Filter missions">
          <button type="button" class="filter-pill active" data-filter="all">All Missions</button>
          <button type="button" class="filter-pill" data-filter="daily">Daily</button>
          <button type="button" class="filter-pill" data-filter="weekly">Weekly</button>
          <button type="button" class="filter-pill" data-filter="one_time">One-Time</button>
          <button type="button" class="filter-pill" data-filter="community">Community</button>
        </div>
      </header>

      <div id="root" class="mod-root">
        <div class="mod-skel-grid" aria-label="Loading missions">
          <div class="acc-skel mod-skel-card"></div>
          <div class="acc-skel mod-skel-card"></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { accountAuth, escapeHtml as esc } from '../../lib/account-client.js';

  const root = document.getElementById('root');
  const fmt = (v) => Number(v || 0).toLocaleString();
  const titleCase = (v) =>
    String(v || 'mission')
      .replaceAll('_', ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

  let allMissions = [];
  let currentFilter = 'all';

  function renderMissionsList() {
    const filtered =
      currentFilter === 'all'
        ? allMissions
        : allMissions.filter(
            (m) =>
              String(m.missionType || '').toLowerCase() === currentFilter ||
              String(m.taskType || '').toLowerCase() === currentFilter
          );

    if (!filtered.length) {
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">SERVER-VERIFIED MISSION ENGINE</div>
          <h2>${allMissions.length ? 'No missions in this category' : 'No missions are active right now'}</h2>
          <p>
            ${
              allMissions.length
                ? 'Switch the filter above to view available missions in other categories.'
                : 'The FCMobiletools mission engine is ready, and missions appear here automatically as soon as the team enables them in the Admin Workspace.'
            }
          </p>
          <div class="mod-pillar-row">
            <article>
              <strong>Server-Observable</strong>
              <span>Tournament participation, calculator milestones and streak progression verified server-side.</span>
            </article>
            <article>
              <strong>Moderated Contributions</strong>
              <span>Corrections and community reports follow a pending → approved → rewarded review path.</span>
            </article>
            <article>
              <strong>Anti-Farming Limits</strong>
              <span>Per-user daily/weekly caps, cooldowns and idempotent ledgers prevent spam loops.</span>
            </article>
          </div>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="/profile/#contribute">Submit a Correction →</a>
            <a class="mod-btn-secondary" href="/events/">Open Live Events Hub</a>
            <a class="mod-btn-secondary" href="/tournaments">Browse Tournaments</a>
          </div>
        </section>
      `;
      return;
    }

    root.innerHTML = `
      <div class="mod-grid acc-anim">
        ${filtered
          .map((m) => {
            const isDone = m.statusLabel === 'Completed';
            const isPending = m.statusLabel === 'Pending review';
            return `
              <article class="mission-card ${isDone ? 'is-completed' : ''}">
                <div class="mission-top">
                  <div class="mission-tags">
                    <span class="tag-type">${esc(titleCase(m.missionType || m.taskType || 'Mission'))}</span>
                    <span class="tag-verify">
                      ${m.verificationMethod === 'moderated' ? 'Moderated Review' : 'Server Verified'}
                    </span>
                  </div>
                  <span class="status-badge ${isDone ? 'is-done' : isPending ? 'is-pending' : ''}">
                    ${esc(m.statusLabel || 'Available')}
                  </span>
                </div>

                <h2>${esc(m.title)}</h2>
                <p>${esc(m.description || 'Complete the qualifying objective to earn this reward.')}</p>

                <div class="mission-foot">
                  <div class="reward-pills">
                    ${m.xpReward > 0 ? `<span class="rw-xp">+${fmt(m.xpReward)} XP</span>` : ''}
                    ${m.tokenReward > 0 ? `<span class="rw-tk">+${fmt(m.tokenReward)} Tokens</span>` : ''}
                    ${m.dailyLimit ? `<span class="rw-limit">${fmt(m.dailyLimit)}/day max</span>` : ''}
                  </div>
                </div>
              </article>
            `;
          })
          .join('')}
      </div>
    `;
  }

  document.querySelectorAll('#missionFilters .filter-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#missionFilters .filter-pill').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      if (allMissions.length) renderMissionsList();
    });
  });

  async function load() {
    const session = await accountAuth.auth.getSession();
    if (!session.data?.session) {
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">OPTIONAL ACCOUNT FEATURE</div>
          <h2>Sign in to view your personal missions</h2>
          <p>Normal calculators, redeem codes, events and guides on FCMobiletools never require an account. Sign in if you want to track mission progress, streaks and XP.</p>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="/account/">Sign in to Account →</a>
            <a class="mod-btn-secondary" href="/account/?mode=signup">Create Free Account</a>
          </div>
        </section>
      `;
      return;
    }

    const r = await fetch('/api/account/missions', {
      headers: { authorization: 'Bearer ' + session.data.session.access_token },
      cache: 'no-store'
    });
    const b = await r.json().catch(() => ({}));
    if (!r.ok) {
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">VERIFICATION REQUIRED</div>
          <h2>${esc(b.error || 'Unable to load missions')}</h2>
          <p>Confirm your email address from the verification link sent during signup to unlock missions and progression rewards.</p>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="/profile/">Back to Profile</a>
            <a class="mod-btn-secondary" href="/settings/">Account Settings</a>
          </div>
        </section>
      `;
      return;
    }

    allMissions = Array.isArray(b.missions) ? b.missions : [];
    renderMissionsList();
  }

  load().catch((e) => {
    root.innerHTML = `<section class="mod-empty-card"><h2>Unable to load missions</h2><p>${esc(e.message)}</p></section>`;
  });
</script>

<style is:global>
  .mod-page {
    min-height: calc(100vh - 80px);
    padding: 36px 18px 110px;
    background: radial-gradient(880px 440px at 12% 0%, rgba(76, 201, 255, 0.07), transparent 65%);
  }
  .mod-wrap {
    width: min(1140px, 100%);
    margin: 0 auto;
  }

  .mod-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .mod-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mod-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4cc9ff;
    box-shadow: 0 0 10px #4cc9ff;
  }
  .mod-head h1 {
    margin: 10px 0 8px;
    font: 700 clamp(30px, 4.5vw, 48px) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
    color: #f5f8fb;
  }
  .mod-head p {
    margin: 0;
    max-width: 640px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }

  .mod-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .filter-pill {
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(15, 26, 38, 0.85);
    color: #90a6b7;
    font: 700 12.5px/1 var(--font-body);
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .filter-pill:hover {
    color: #f5f8fb;
    border-color: rgba(76, 201, 255, 0.3);
  }
  .filter-pill.active {
    color: #04131c;
    border-color: #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    font-weight: 800;
  }

  .mod-skel-grid,
  .mod-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .mod-skel-card {
    height: 190px;
    border-radius: 20px;
  }

  .mission-card {
    padding: 24px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .mission-card:hover {
    transform: translateY(-2px);
    border-color: rgba(76, 201, 255, 0.32);
  }
  .mission-card.is-completed {
    border-color: rgba(71, 209, 108, 0.3);
  }

  .mission-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mission-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag-type,
  .tag-verify {
    padding: 4px 9px;
    border-radius: 999px;
    font: 700 11px/1 var(--font-body);
  }
  .tag-type {
    background: rgba(76, 201, 255, 0.12);
    border: 1px solid rgba(76, 201, 255, 0.25);
    color: #8ce2ff;
  }
  .tag-verify {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #93a9b9;
  }
  .status-badge {
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: #b7cbd8;
    font: 700 11.5px/1 var(--font-body);
  }
  .status-badge.is-done {
    background: rgba(71, 209, 108, 0.14);
    color: #88eba0;
  }
  .status-badge.is-pending {
    background: rgba(255, 191, 104, 0.14);
    color: #ffd36e;
  }

  .mission-card h2 {
    margin: 0;
    font: 700 20px/1.2 var(--font-display);
    color: #f5f8fb;
  }
  .mission-card p {
    margin: 0;
    color: #90a6b7;
    font: 500 13.5px/1.6 var(--font-body);
  }

  .reward-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 6px;
  }
  .reward-pills span {
    padding: 6px 11px;
    border-radius: 999px;
    font: 800 11.5px/1 var(--font-body);
  }
  .rw-xp {
    background: rgba(76, 201, 255, 0.12);
    border: 1px solid rgba(76, 201, 255, 0.28);
    color: #8ee0ff;
  }
  .rw-tk {
    background: rgba(71, 209, 108, 0.12);
    border: 1px solid rgba(71, 209, 108, 0.28);
    color: #88eba0;
  }
  .rw-limit {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #8fa5b6;
  }

  /* Empty / Info State */
  .mod-empty-card {
    padding: 36px;
    border-radius: 24px;
    border: 1px solid rgba(76, 201, 255, 0.18);
    background:
      radial-gradient(circle at 0% 0%, rgba(76, 201, 255, 0.09), transparent 55%),
      linear-gradient(155deg, rgba(15, 26, 38, 0.96), rgba(8, 16, 24, 0.96));
    box-shadow: 0 24px 65px rgba(0, 0, 0, 0.3);
  }
  .mod-empty-badge {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(76, 201, 255, 0.1);
    border: 1px solid rgba(76, 201, 255, 0.24);
    color: #4cc9ff;
    font: 800 11px/1 var(--font-body);
    letter-spacing: 0.1em;
  }
  .mod-empty-card h2 {
    margin: 14px 0 8px;
    font: 700 clamp(24px, 3.5vw, 34px) / 1.12 var(--font-display);
    color: #f5f8fb;
  }
  .mod-empty-card > p {
    margin: 0 0 22px;
    max-width: 680px;
    color: #93a8b8;
    font: 500 14.5px/1.65 var(--font-body);
  }

  .mod-pillar-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .mod-pillar-row article {
    padding: 16px;
    border-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(7, 16, 24, 0.68);
  }
  .mod-pillar-row strong {
    display: block;
    color: #ecf5fb;
    font: 700 14.5px/1.25 var(--font-display);
    margin-bottom: 5px;
  }
  .mod-pillar-row span {
    color: #88a0b2;
    font: 500 13px/1.5 var(--font-body);
  }

  .mod-empty-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mod-btn-primary,
  .mod-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 12px;
    font: 700 13px/1 var(--font-body);
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  .mod-btn-primary {
    border: 1px solid #6ed8ff;
    background: linear-gradient(135deg, #9fe6ff, #4cc9ff);
    color: #04131c;
    font-weight: 800;
  }
  .mod-btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #101e2c;
    color: #e3eef6;
  }

  @media (max-width: 860px) {
    .mod-grid,
    .mod-skel-grid,
    .mod-pillar-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .mod-page {
      padding: 20px 12px 106px;
    }
    .mod-empty-card,
    .mission-card {
      padding: 20px 16px;
      border-radius: 20px;
    }
  }
</style>
