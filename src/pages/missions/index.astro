---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
---
<BaseLayout
  title="Quests | FCMobiletools Account"
  description="Daily Quests, one-time objectives and checked rewards for your FCMobiletools account."
  robots="noindex,nofollow"
  googlebot="noindex,nofollow"
>
  <main class="mod-page">
    <div class="mod-wrap">
      <AccountNav active="missions" sectionLabel="Quests" />

      <header class="mod-head acc-anim">
        <div>
          <span class="mod-kicker"><i class="mod-dot"></i> QUEST BOARD</span>
          <h1>Your Quests. Your streak. Your Tokens.</h1>
          <p>
            Daily Quests rotate automatically at 00:00 UTC. Weekly Quests rotate every Thursday at 00:00 UTC. One-time Quests cover things like finishing your FC Mobile profile or connecting your socials. A button click alone never pays out.
          </p>
        </div>

        <div class="mod-filters" id="missionFilters" role="group" aria-label="Filter quests">
          <button type="button" class="filter-pill active" data-filter="all">All Quests</button>
          <button type="button" class="filter-pill" data-filter="daily">Daily</button>
          <button type="button" class="filter-pill" data-filter="weekly">Weekly</button>
          <button type="button" class="filter-pill" data-filter="one_time">One-Time</button>
          <button type="button" class="filter-pill" data-filter="community">Community</button>
        </div>
      </header>

      <div id="surveyStrip"></div>

      <section id="streakPanel" class="streak-panel acc-anim acc-anim-d1" aria-live="polite">
        <div class="streak-orbit" aria-hidden="true"></div>
        <div class="streak-main">
          <div class="streak-icon"><span>🔥</span></div>
          <div>
            <span class="streak-kicker">DAILY CHECK-IN · UTC</span>
            <h2 id="streakTitle">Keep your streak alive.</h2>
            <p id="streakCopy">Check in once every 24 hours. Your streak is still tracked by UTC date.</p>
          </div>
        </div>
        <div class="streak-stats">
          <div><span>Current</span><strong id="streakCurrent">0 days</strong></div>
          <div><span>Best</span><strong id="streakBest">0 days</strong></div>
          <div><span>Freeze</span><strong id="streakFreeze">0</strong></div>
        </div>
        <div class="streak-timers" aria-label="Check-in timers">
          <div><span>UTC RESET</span><strong id="streakResetTimer">24h 00m</strong><small>UTC streak date changes</small></div>
          <div><span>24H COOLDOWN</span><strong id="streakCooldownTimer">Ready</strong><small>After each successful check-in</small></div>
        </div>
        <div class="streak-week" id="streakWeek" aria-label="Weekly streak progress"></div>
        <button type="button" class="streak-checkin" id="streakCheckinBtn">Check in</button>
      </section>

      <div id="root" class="mod-root">
        <div class="mod-skel-grid" aria-label="Loading quests">
          <div class="acc-skel mod-skel-card"></div>
          <div class="acc-skel mod-skel-card"></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import '../../scripts/survey-strip.js';
</script>
<script>
  import { accountAuth, escapeHtml as esc } from '../../lib/account-client.js';

  const root = document.getElementById('root');
  const fmt = (v) => Number(v || 0).toLocaleString();
  const titleCase = (v) =>
    String(v || 'mission')
      .replaceAll('_', ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());

  const QICON = {
    daily: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/><path d="M12 8v4l2.5 2"/></svg>',
    one_time: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>',
    weekly: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4M16 2v4M3 10h18M8 15h3M13 15h3"/></svg>',
    community: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.8c1.9.7 3.2 2.4 3.6 5.2"/></svg>'
  };
  const BOLT = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>';
  const COIN = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>';
  const kindOf = (m) => {
    const k = String(m.missionType || m.taskType || 'daily').toLowerCase();
    return QICON[k] ? k : 'daily';
  };

  function summaryRibbon(list) {
    const total = list.length;
    const done = list.filter((m) => m.statusLabel === 'Completed').length;
    const open = list.filter((m) => m.statusLabel !== 'Completed');
    const xp = open.reduce((n, m) => n + Number(m.xpReward || 0), 0);
    const tk = open.reduce((n, m) => n + Number(m.tokenReward || 0), 0);
    const pct = total ? Math.round((done / total) * 100) : 0;
    return `
      <section class="qb-summary" aria-label="Quest progress">
        <div class="qb-periods">
          <span><b>Daily reset</b> 00:00 UTC</span>
          <span><b>Weekly reset</b> ${esc(questPeriods.weeklyResetLabel || 'Thursday 00:00 UTC')}</span>
        </div>
        <div class="qb-stat">
          <small>Board progress</small>
          <strong>${fmt(done)} <em>/ ${fmt(total)} complete</em></strong>
          <div class="qb-bar"><i style="width:${pct}%"></i></div>
        </div>
        <div class="qb-stat qb-stat--cyan"><small>XP available</small><strong>+${fmt(xp)}</strong></div>
        <div class="qb-stat qb-stat--gold"><small>Tokens available</small><strong>+${fmt(tk)}</strong></div>
        <div class="qb-stat"><small>Awaiting review</small><strong>${fmt(list.filter((m) => m.statusLabel === 'Pending review').length)}</strong></div>
      </section>`;
  }

  let allQuests = [];
  let currentFilter = 'all';
  let accountState = null;
  let questPeriods = {
    dailyResetAt: null,
    weeklyResetAt: null,
    weeklyResetLabel: 'Thursday 00:00 UTC'
  };
  let questRefreshTimer = 0;

  function questActionFor(m) {
    if (m.statusLabel === 'Completed') return '<span class="mission-complete-note">Reward claimed ✓</span>';
    if (m.statusLabel === 'Pending review') return '<span class="mission-complete-note">Sent for review</span>';

    const slug=String(m.slug||'').toLowerCase();
    const checkButton=(label='Check Quest')=>
      `<button type="button" class="mission-action-primary" data-mission-complete="${esc(m.id)}" data-mission-proof="">${label}</button>`;

    if (slug==='complete-profile') {
      return `<div class="mission-actions"><a class="mission-action-secondary" href="/settings/">Finish Profile</a>${checkButton('Check Profile')}</div>`;
    }
    if (slug==='verify-email') {
      return `<div class="mission-actions"><a class="mission-action-secondary" href="/settings/">Open Settings</a>${checkButton('Check Email')}</div>`;
    }
    const links={
      'daily-events-check':['/events/','Open Events'],
      'daily-redeem-codes-check':['/redeem-codes/','Open Codes'],
      'daily-rank-up-check':['/rank-up-calculator/','Open Rank Up'],
      'daily-team-ovr-check':['/team-ovr/','Open Team OVR'],
      'daily-training-check':['/training-calculator/','Open Training'],
      'daily-investment-check':['/investment-calculator/','Open Investment']
    };
    if(links[slug]){
      return `<div class="mission-actions"><a class="mission-action-secondary" href="${links[slug][0]}">${links[slug][1]}</a>${checkButton()}</div>`;
    }
    if(['follow-x','join-discord'].includes(slug)){
      const social={
        'follow-x':['https://x.com/TanzimFC','Open X'],
        'join-discord':['https://discord.com/invite/B4a7AxuU69','Join Discord']
      }[slug];
      return `<div class="social-quest-box"><div class="social-proof-row"><input type="text" maxlength="64" placeholder="Your handle" data-social-proof="${esc(m.id)}" /><a class="mission-action-secondary" href="${social[0]}" target="_blank" rel="noopener">${social[1]}</a></div>${checkButton('Send for Review')}</div>`;
    }
    if (slug==='reach-level-3') return `<div class="mission-actions"><a class="mission-action-secondary" href="/profile/">View Progress</a>${checkButton('Check Level')}</div>`;
    if (slug==='build-three-day-streak') return `<div class="mission-actions"><a class="mission-action-secondary" href="/missions/">View Streak</a>${checkButton('Check Streak')}</div>`;
    if (slug==='approved-community-contribution') return `<div class="mission-actions"><a class="mission-action-secondary" href="/profile/#contribute">Submit Correction</a>${checkButton('Check Approval')}</div>`;
    return `<div class="mission-actions">${checkButton()}</div>`;
  }

  function renderQuestsList() {
    const filtered =
      currentFilter === 'all'
        ? allQuests
        : allQuests.filter(
            (m) =>
              String(m.missionType || '').toLowerCase() === currentFilter ||
              String(m.taskType || '').toLowerCase() === currentFilter
          );

    if (!filtered.length) {
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">AUTOMATIC QUEST ENGINE</div>
          <h2>${allQuests.length ? 'No quests in this category' : 'No quests are active right now'}</h2>
          <p>
            ${
              allQuests.length
                ? 'Switch the filter above to see another Quest type.'
                : 'Daily Quests rotate from the active pool at 00:00 UTC. Weekly Quests rotate every Thursday at 00:00 UTC.'
            }
          </p>
          <div class="mod-pillar-row">
            <article>
              <strong>Checked Activity</strong>
              <span>Calculator milestones, streaks and Quest progress are checked server-side.</span>
            </article>
            <article>
              <strong>Community Review</strong>
              <span>Corrections and community reports follow a pending → approved → rewarded review path.</span>
            </article>
            <article>
              <strong>Fair Limits</strong>
              <span>Daily caps, cooldowns and server checks stop easy repeat claims.</span>
            </article>
          </div>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="/profile/#contribute">Submit a Correction →</a>
            <a class="mod-btn-secondary" href="/events/">Open Live Events Hub</a>

          </div>
        </section>
      `;
      return;
    }

    root.innerHTML = summaryRibbon(allQuests) + `
      <div class="mod-grid acc-anim">
        ${filtered
          .map((m) => {
            const isDone = m.statusLabel === 'Completed';
            const isPending = m.statusLabel === 'Pending review';
            const action = questActionFor(m);

            return `
              <article class="mission-card ${isDone ? 'is-completed' : ''}" data-kind="${kindOf(m)}">
                <span class="q-ico" aria-hidden="true">${isDone ? '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>' : QICON[kindOf(m)]}</span>
                <div class="mission-top">
                  <div class="mission-tags">
                    <span class="tag-type">${esc(titleCase(m.missionType || m.taskType || 'Quest'))}</span>
                    <span class="tag-verify">
                      ${m.verificationMethod === 'moderated' ? 'Community Review' : 'Server Checked'}
                    </span>
                  </div>
                  <span class="status-badge ${isDone ? 'is-done' : isPending ? 'is-pending' : ''}">
                    ${esc(m.statusLabel || 'Available')}
                  </span>
                </div>

                <h2>${esc(m.title)}</h2>
                <p>${esc(m.description || 'Complete the qualifying objective to earn this reward.')}</p>

                <div class="mission-foot">
                  <div class="reward-pills">
                    ${m.xpReward > 0 ? `<span class="rw-xp">${BOLT}+${fmt(m.xpReward)} XP</span>` : ''}
                    ${m.tokenReward > 0 ? `<span class="rw-tk">${COIN}+${fmt(m.tokenReward)} Tokens</span>` : ''}
                    ${m.dailyLimit ? `<span class="rw-limit">${fmt(m.dailyLimit)}/day max</span>` : ''}
                    ${m.weeklyLimit ? `<span class="rw-limit">${fmt(m.weeklyLimit)}/week max</span>` : ''}
                  </div>
                  ${action}
                </div>
                <p class="mission-action-msg" data-mission-msg="${esc(m.id)}" hidden></p>
              </article>
            `;
          })
          .join('')}
      </div>
    `;
  }

  async function completeQuest(taskId, proof, button) {
    const msg = root.querySelector(`[data-mission-msg="${CSS.escape(taskId)}"]`);
    const session = await accountAuth.auth.getSession();
    if (!session.data?.session) throw new Error('Your session expired. Sign in again.');
    button.disabled = true;
    const previous = button.textContent;
    button.textContent = 'Checking…';
    if (msg) { msg.hidden = true; msg.textContent = ''; }

    try {
      let accessToken=session.data.session.access_token;
      let start = await fetch('/api/account/missions/' + encodeURIComponent(taskId) + '/start', {
        method: 'POST',
        headers: {
          authorization: 'Bearer ' + accessToken,
          'content-type': 'application/json'
        },
        body: JSON.stringify({ idempotencyKey: crypto.randomUUID() })
      });
      let startBody = await start.json().catch(() => ({}));

      if ((start.status === 401 || start.status === 403)) {
        const refreshed = await accountAuth.auth.refreshSession();
        if (refreshed.data?.session?.access_token) {
          accessToken=refreshed.data.session.access_token;
          start = await fetch('/api/account/missions/' + encodeURIComponent(taskId) + '/start', {
            method: 'POST',
            headers: {
              authorization: 'Bearer ' + accessToken,
              'content-type': 'application/json'
            },
            body: JSON.stringify({ idempotencyKey: crypto.randomUUID() })
          });
          startBody = await start.json().catch(() => ({}));
        }
      }

      if (!start.ok || !startBody?.attemptId) throw new Error(startBody?.error || 'Unable to start this quest.');

      const complete = await fetch('/api/account/missions/' + encodeURIComponent(taskId) + '/complete', {
        method: 'POST',
        headers: {
          authorization: 'Bearer ' + accessToken,
          'content-type': 'application/json'
        },
        body: JSON.stringify({
          attemptId: startBody.attemptId,
          clientElapsedMs: 1000,
          proof: proof || ''
        })
      });
      const body = await complete.json().catch(() => ({}));
      if (!complete.ok) throw new Error(body?.error || 'Unable to complete this quest.');

      if (msg) {
        msg.hidden = false;
        msg.className = 'mission-action-msg is-ok';
        msg.textContent = 'Quest complete. XP and Tokens are now on your balance.';
      }
      button.textContent = 'Completed ✓';
      window.setTimeout(() => load(), 650);
    } catch (error) {
      button.disabled = false;
      button.textContent = previous;
      if (msg) {
        msg.hidden = false;
        msg.className = 'mission-action-msg is-err';
        msg.textContent = error?.message || 'Unable to complete this quest.';
      }
    }
  }

  root.addEventListener('click', (event) => {
    const button = event.target.closest('[data-mission-complete]');
    if (!button) return;
    const proofInput = root.querySelector(`[data-social-proof="${CSS.escape(button.dataset.missionComplete)}"]`);
    completeQuest(button.dataset.missionComplete, proofInput?.value?.trim() || button.dataset.missionProof || '', button).catch(() => {});
  });

  document.querySelectorAll('#missionFilters .filter-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#missionFilters .filter-pill').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      if (allQuests.length) renderQuestsList();
    });
  });

  function formatCountdown(ms) {
    const total=Math.max(0,Math.ceil(ms/1000));
    const h=Math.floor(total/3600), m=Math.floor((total%3600)/60), s=total%60;
    return h ? `${h}h ${String(m).padStart(2,'0')}m` : `${m}m ${String(s).padStart(2,'0')}s`;
  }

  const CHECK_IN_COOLDOWN_MS = 24 * 60 * 60 * 1000;
  let streakTimer=0;
  let streakState={};

  function nextUtcResetMs(){
    const next=new Date();
    next.setUTCHours(24,0,0,0);
    return Math.max(0,next.getTime()-Date.now());
  }

  function renderStreakTimers(streak){
    const reset=document.getElementById('streakResetTimer');
    const cooldown=document.getElementById('streakCooldownTimer');
    if(!reset||!cooldown) return;
    reset.textContent=formatCountdown(nextUtcResetMs());
    const last=streak?.lastCheckInAt ? new Date(streak.lastCheckInAt) : null;
    const cooldownLeft=last ? Math.max(0,CHECK_IN_COOLDOWN_MS-(Date.now()-last.getTime())) : 0;
    cooldown.textContent=cooldownLeft>0 ? formatCountdown(cooldownLeft) : 'Ready';
  }

  function renderStreak(streak) {
    streakState=streak||{};
    const current=Number(streak?.current||0), best=Number(streak?.longest||0), freezes=Number(streak?.freezes||0);
    const last=streak?.lastCheckInAt ? new Date(streak.lastCheckInAt) : null;
    const btn=document.getElementById('streakCheckinBtn');
    const weekEl=document.getElementById('streakWeek');
    if(weekEl){
      const inWeek=current===0?0:((current-1)%7)+1;
      const sameDay=last && new Date().toISOString().slice(0,10)===String(streak?.lastCheckInUtcDate||'');
      weekEl.innerHTML='<span class="lbl">7-day cycle</span>'+Array.from({length:7},(_,i)=>{
        const on=i<inWeek, today=on&&i===inWeek-1&&sameDay;
        return `<span class="streak-pip${on?' on':''}${today?' today':''}${i===6?' final':''}">${i===6?'★':i+1}</span>`;
      }).join('');
    }
    document.getElementById('streakCurrent').textContent=current+' day'+(current===1?'':'s');
    document.getElementById('streakBest').textContent=best+' day'+(best===1?'':'s');
    document.getElementById('streakFreeze').textContent=String(freezes);
    const copy=document.getElementById('streakCopy');
    const title=document.getElementById('streakTitle');
    if(last) {
      const elapsed=Date.now()-last.getTime();
      const cooldownLeft=Math.max(0,CHECK_IN_COOLDOWN_MS-elapsed);
      if(cooldownLeft>0) {
        title.textContent='Check-in cooldown is active.';
        copy.textContent='Your next check-in opens 24 hours after your last successful check-in. The UTC streak reset is shown separately.';
        btn.textContent='Next check-in in '+formatCountdown(cooldownLeft); btn.disabled=true;
      } else {
        title.textContent=current?'Keep the streak alive.':'Start your streak.';
        copy.textContent='Your 24-hour cooldown is complete. A Streak Freeze can protect one missed UTC day.';
        btn.textContent=current?'Check in & keep streak':'Start check-in'; btn.disabled=false;
      }
    } else {
      title.textContent='Start your streak.';
      copy.textContent='Your first successful check-in starts your streak at 1 day. After that, check in every 24 hours.';
      btn.textContent='Check in'; btn.disabled=false;
    }
  }

  if(!streakTimer){
    streakTimer=window.setInterval(()=>{
      renderStreakTimers(streakState);
      const btn=document.getElementById('streakCheckinBtn');
      const last=streakState?.lastCheckInAt ? new Date(streakState.lastCheckInAt) : null;
      if(btn && last){
        const cooldownLeft=Math.max(0,CHECK_IN_COOLDOWN_MS-(Date.now()-last.getTime()));
        const shouldDisable=cooldownLeft>0;
        if(btn.disabled!==shouldDisable) renderStreak(streakState);
      }
    },1000);
  }

  async function handleCheckIn() {
    const btn=document.getElementById('streakCheckinBtn');
    if(!btn||btn.disabled) return;
    const session=await accountAuth.auth.getSession();
    if(!session.data?.session){
      btn.textContent='Sign in to check in';
      btn.disabled=false;
      const copy=document.getElementById('streakCopy');
      if(copy) copy.textContent='Sign in to start your UTC streak and earn the daily check-in reward.';
      btn.onclick=()=>{ location.href='/account/'; };
      return;
    }
    btn.onclick=null;
    btn.disabled=true; const previous=btn.textContent; btn.textContent='Checking…';
    try {
      const r=await fetch('/api/account/check-in',{method:'POST',headers:{authorization:'Bearer '+session.data.session.access_token,'content-type':'application/json'},body:JSON.stringify({idempotencyKey:crypto.randomUUID()})});
      const body=await r.json().catch(()=>({}));
      if(!r.ok) throw new Error(body.error||body.message||'Unable to check in right now.');
      if(body.xpReward||body.tokenReward){
        btn.textContent='Checked in ✓';
      } else if(body.alreadyCheckedIn){
        btn.textContent='Checked in today ✓';
      }
      const me=await fetch('/api/account/me',{headers:{authorization:'Bearer '+session.data.session.access_token},cache:'no-store'});
      const state=await me.json().catch(()=>({}));
      accountState=state.account||accountState;
      renderStreak(state.streak||{});
      setTimeout(()=>load(),450);
    } catch(error) {
      btn.disabled=false; btn.textContent=previous;
      const copy=document.getElementById('streakCopy'); if(copy) copy.textContent=error.message;
    }
  }

  document.getElementById('streakCheckinBtn')?.addEventListener('click', handleCheckIn);

  let lastQuestLoadAt=0;
  async function refreshQuestsOnReturn(){
    if(Date.now()-lastQuestLoadAt<500) return;
    lastQuestLoadAt=Date.now();
    try{ await load(); }catch{}
  }
  window.addEventListener('pageshow',event=>{ if(event.persisted) refreshQuestsOnReturn(); });
  window.addEventListener('fcmobiletools:quest-status-changed',refreshQuestsOnReturn);

  async function load() {
    lastQuestLoadAt=Date.now();
    const session = await accountAuth.auth.getSession();
    if (!session.data?.session) {
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">OPTIONAL ACCOUNT FEATURE</div>
          <h2>Sign in to view your personal quests</h2>
          <p>Normal calculators, redeem codes, events and guides on FCMobiletools never require an account. Sign in if you want to track Quest progress, streaks and XP.</p>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="/account/">Sign in to Account →</a>
            <a class="mod-btn-secondary" href="/account/?mode=signup">Create Free Account</a>
          </div>
        </section>
      `;
      return;
    }

    async function fetchQuests(accessToken) {
      return fetch('/api/account/quests', {
        headers: { authorization: 'Bearer ' + accessToken },
        cache: 'no-store'
      });
    }

    const sessionToken=session.data.session.access_token;
    const meResponse=await fetch('/api/account/me',{headers:{authorization:'Bearer '+sessionToken},cache:'no-store'});
    const meBody=await meResponse.json().catch(()=>({}));
    accountState=meBody.account||null;
    renderStreak(meBody.streak||{});

    let r = await fetchQuests(sessionToken);

    if (r.status === 401 || r.status === 403) {
      const refreshed = await accountAuth.auth.refreshSession();
      if (refreshed.data?.session?.access_token) {
        r = await fetchQuests(refreshed.data.session.access_token);
      }
    }

    const b = await r.json().catch(() => ({}));
    if (!r.ok) {
      const isVerification = r.status === 403;
      const isAuth = r.status === 401;
      root.innerHTML = `
        <section class="mod-empty-card acc-anim">
          <div class="mod-empty-badge">${isVerification ? 'VERIFICATION REQUIRED' : isAuth ? 'SESSION EXPIRED' : 'QUEST SERVICE'}</div>
          <h2>${esc(b.error || 'Unable to load quests')}</h2>
          <p>${esc(
            isVerification
              ? 'Confirm your email address, then return here. You can resend the verification email from Account Settings.'
              : isAuth
                ? 'Your account session has expired. Sign in again to continue.'
                : 'The Quest service hit an error. Your account is still fine. Try again in a moment.'
          )}</p>
          <div class="mod-empty-actions">
            <a class="mod-btn-primary" href="${isVerification ? '/settings/' : '/profile/'}">${isVerification ? 'Account Settings' : 'Back to Profile'}</a>
          </div>
        </section>
      `;
      return;
    }

    allQuests = Array.isArray(b.quests) ? b.quests : (Array.isArray(b.missions) ? b.missions : []);
    questPeriods = b.periods || questPeriods;

    if (questRefreshTimer) window.clearTimeout(questRefreshTimer);
    const dailyResetMs = questPeriods.dailyResetAt ? Math.max(1000, new Date(questPeriods.dailyResetAt).getTime() - Date.now() + 500) : 86400000;
    const weeklyResetMs = questPeriods.weeklyResetAt ? Math.max(1000, new Date(questPeriods.weeklyResetAt).getTime() - Date.now() + 500) : 604800000;
    questRefreshTimer = window.setTimeout(() => load().catch(() => {}), Math.min(dailyResetMs, weeklyResetMs));

    renderQuestsList();
  }

  load().catch((e) => {
    root.innerHTML = `<section class="mod-empty-card"><h2>Unable to load quests</h2><p>${esc(e.message)}</p></section>`;
  });
</script>

