---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyHtml from '../../../components/LegacyHtml.astro';

export function getStaticPaths() {
  return Array.from({ length: 9 }, (_, i) => ({ params: { day: String(i + 1) } }));
}

const { day } = Astro.params;
const title = `FC Mobile France Trivia Day ${day} Answers`;
const description = `FC Mobile France A Nation's Story Day ${day} trivia questions, answers and explanations.`;
---
<BaseLayout title={title} description={description}>
  <LegacyHtml file={`trivia/france/day-${day}.html`} />
</BaseLayout>
