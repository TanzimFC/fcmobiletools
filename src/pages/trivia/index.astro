---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEASON_RECAP_QUESTION_COUNT } from '../../data/seasonRecapTrivia.js';
const banner = '/assets/trivia/season-recap-banner.jpg';
---
<BaseLayout
  title="FC Mobile Trivia | Season Recap & A Nation's Story"
  description="Find the latest FC Mobile 27 Extra Time Season Recap answers or browse every A Nation's Story answer set in one place."
>
  <main class="trivia-hub">
    <section class="hub-intro">
      <span class="eyebrow">FC MOBILE 27 / TRIVIA</span>
      <h1>Know the answer.<br /><span>Get back in game.</span></h1>
      <p>Two trivia collections. One place to find the question you remember.</p>
    </section>

    <section class="mode-grid" aria-label="Trivia collections">
      <a class="recap-card" href="/trivia/season-recap/">
        <div class="recap-art">
          <img src={banner} width="1024" height="572" alt="FC Mobile 27 Season Recap Challenge banner" loading="lazy" decoding="async" fetchpriority="low" />
          <span class="art-shade"></span>
          <span class="art-label">EXTRA TIME · OCTOBER 2026</span>
          <span class="art-content">
            <strong>Season Recap</strong>
            <span>Challenge answers</span>
            <em>{SEASON_RECAP_QUESTION_COUNT} stored questions · Searchable answer list</em>
          </span>
        </div>
        <div class="card-foot"><span>Find current Extra Time answers</span><b>VIEW ANSWERS ↗</b></div>
      </a>

      <a class="nation-card" href="/a-nations-story/">
        <div class="nation-kicker">A NATION'S STORY · MOVED TO TRIVIA</div>
        <div class="nation-symbol" aria-hidden="true"><span>球</span><i></i><b></b></div>
        <h2>A Nation's Story</h2>
        <p>Japan, Netherlands, Mexico, France and Brazil. Search by a player, year, team, or any part of a question.</p>
        <div class="nation-bottom"><span>All nations · Day-by-day answers</span><b>OPEN NATION'S STORY ↗</b></div>
      </a>
    </section>

    <div class="move-note">
      <span class="note-mark">i</span>
      <p><strong>A Nation's Story is now part of Trivia.</strong> Use the Nation's Story card above to reach its answer hub and day-by-day pages.</p>
      <a href="/a-nations-story/">View A Nation's Story <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</BaseLayout>

<style>
.trivia-hub{--trivia-blue:#4cc9ff;max-width:1160px;margin:0 auto;padding:44px 20px 100px;color:#f5f8fb}
.eyebrow{display:inline-flex;align-items:center;gap:9px;color:#4cc9ff;font:800 10px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em}
.eyebrow:before{content:"";display:inline-block;width:24px;height:1px;background:#4cc9ff}
.hub-intro{padding:18px 0 34px}
.hub-intro h1{font-family:"Space Grotesk",Inter,system-ui,sans-serif;font-size:clamp(50px,7.5vw,88px);line-height:.92;letter-spacing:-.075em;margin:20px 0 17px}
.hub-intro h1 span{color:#4cc9ff}
.hub-intro p{font-size:15px;line-height:1.7;color:#a7b4c3;max-width:570px;margin:0}
.mode-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:16px;align-items:stretch}
.recap-card,.nation-card{min-width:0;overflow:hidden;border:1px solid rgba(255,255,255,.09);border-radius:22px;background:#0f1a26;text-decoration:none;color:#f5f8fb;transition:transform .28s cubic-bezier(.22,1,.36,1),border-color .28s,box-shadow .28s}
.recap-card:hover,.nation-card:hover{transform:translateY(-4px);border-color:rgba(76,201,255,.48);box-shadow:0 28px 70px -45px rgba(76,201,255,.52)}
.recap-art{position:relative;isolation:isolate;overflow:hidden;aspect-ratio:1024/572;background:#0c1824}
.recap-art img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .55s cubic-bezier(.22,1,.36,1)}
.recap-card:hover .recap-art img{transform:scale(1.025)}
.art-shade{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(5,12,19,.05) 14%,rgba(5,12,19,.15) 36%,rgba(5,12,19,.92) 100%),linear-gradient(90deg,rgba(5,12,19,.2),transparent 70%)}
.art-label{position:absolute;z-index:2;left:24px;top:22px;border:1px solid rgba(255,255,255,.22);border-radius:999px;background:rgba(5,12,19,.5);padding:8px 11px;color:#e5f8ff;font:800 8px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;backdrop-filter:blur(12px)}
.art-content{position:absolute;z-index:2;left:25px;right:22px;bottom:25px;display:flex;flex-direction:column;align-items:flex-start}
.art-content strong{font:700 clamp(30px,4.1vw,49px)/1 "Space Grotesk",Inter,system-ui,sans-serif;letter-spacing:-.06em}
.art-content>span{font-size:14px;font-weight:650;color:#d9e9f0;margin-top:6px}
.art-content em{font-style:normal;color:#a8bdca;font-size:10px;margin-top:13px}
.card-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 22px}
.card-foot span{color:#9eafbd;font-size:11px}
.card-foot b,.nation-bottom b{font:900 8px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em;color:#4cc9ff;white-space:nowrap}
.nation-card{display:flex;flex-direction:column;padding:26px;position:relative;background:radial-gradient(340px 250px at 100% 0,rgba(76,201,255,.14),transparent 70%),linear-gradient(160deg,#122333,#0c1520)}
.nation-kicker{font:900 8px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.11em;color:#4cc9ff}
.nation-symbol{height:130px;display:flex;align-items:center;justify-content:center;position:relative;margin:6px 0 4px;overflow:hidden}
.nation-symbol span{position:relative;z-index:1;font-family:serif;font-size:96px;font-weight:900;line-height:1;color:rgba(76,201,255,.72);text-shadow:0 0 60px rgba(76,201,255,.22);transform:rotate(-9deg)}
.nation-symbol i,.nation-symbol b{position:absolute;width:124px;height:124px;border:1px solid rgba(76,201,255,.24);border-radius:50%;transform:rotate(32deg) scaleX(1.7)}
.nation-symbol b{width:92px;height:92px;transform:rotate(-35deg) scaleX(1.7);border-color:rgba(255,255,255,.09)}
.nation-card h2{font:700 clamp(27px,3vw,36px)/1.03 "Space Grotesk",Inter,system-ui,sans-serif;letter-spacing:-.055em;margin:12px 0}
.nation-card>p{font-size:12px;line-height:1.8;color:#a7b4c3;margin:0 0 28px;max-width:430px}
.nation-bottom{display:flex;flex-direction:column;gap:13px;margin-top:auto;padding-top:17px;border-top:1px solid rgba(255,255,255,.1)}
.nation-bottom span{font-size:10px;color:#93a9b8}
.move-note{display:flex;align-items:center;gap:13px;margin-top:16px;padding:16px 18px;border:1px solid rgba(255,255,255,.07);border-radius:14px;background:rgba(15,26,38,.68)}
.note-mark{display:grid;place-items:center;flex:0 0 25px;width:25px;height:25px;border-radius:50%;background:rgba(76,201,255,.12);color:#4cc9ff;font:800 13px/1 Inter,system-ui,sans-serif}
.move-note p{flex:1;margin:0;color:#9eafbd;font-size:11px;line-height:1.65}
.move-note p strong{color:#e8f5fa;font-weight:700}
.move-note>a{color:#4cc9ff;font:800 9px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap;text-decoration:none}
.move-note>a:hover{color:#a5e7ff}
@media(max-width:820px){.mode-grid{grid-template-columns:1fr}.nation-card{min-height:365px}.nation-symbol{height:100px}.nation-symbol span{font-size:76px}.nation-card h2{font-size:31px}}
@media(max-width:560px){.trivia-hub{padding:27px 14px 70px}.hub-intro{padding:14px 0 26px}.hub-intro h1{font-size:clamp(43px,13vw,62px)}.hub-intro p{font-size:13px}.mode-grid{gap:12px}.recap-card,.nation-card{border-radius:17px}.art-label{left:14px;top:14px;font-size:7px}.art-content{left:15px;right:13px;bottom:15px}.art-content strong{font-size:32px}.art-content>span{font-size:12px}.art-content em{font-size:9px}.card-foot{align-items:flex-start;flex-direction:column;gap:9px;padding:14px 15px}.nation-card{padding:20px}.nation-symbol{height:92px}.nation-symbol span{font-size:72px}.move-note{align-items:flex-start;flex-wrap:wrap;padding:14px}.move-note p{flex-basis:calc(100% - 42px)}.move-note>a{margin-left:38px}}
@media(prefers-reduced-motion:reduce){.recap-card,.nation-card,.recap-art img{transition:none}}
</style>
