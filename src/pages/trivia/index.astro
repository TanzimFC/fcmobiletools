---
import TriviaLayout from '../../layouts/TriviaLayout.astro';
import { ICONS } from '../../lib/triviaIcons.js';
import { SEASON_RECAP_META as SR, SEASON_RECAP_QUESTION_COUNT } from '../../data/seasonRecapTrivia.js';
import { buildNationQuestions, nationImage, NATION_STYLE } from '../../lib/triviaNations.js';
import { NATIONS_STORY } from '../../data/aNationsStory.js';
import { breadcrumbLd, absolute } from '../../lib/triviaCore.js';
import { EXTRA_TIME_ROUTE, NATIONS_ROUTE, SEASON_RECAP_ROUTE } from '../../lib/triviaRoutes.js';

const ansCount = buildNationQuestions().length;
const nationCount = NATIONS_STORY.length;
const fan = ['japan', 'france', 'brazil'];

const title = 'FC Mobile Trivia Answers: Season Recap & A Nation\'s Story';
const description = `Choose between two FC Mobile trivia collections: ${SEASON_RECAP_QUESTION_COUNT} Season Recap (Challenge) answers in Extra Time, or ${ansCount} A Nation's Story questions grouped by nation and day.`;
const faq = [
  ['How does FC Mobile trivia work?', `There are two kinds. Extra Time trivia runs for a limited window and gives you a round of roughly 10 to 30 questions (Season Recap currently uses 30 questions with 2 options each). A Nation's Story is a day-by-day set with 4 options per question. Correct answers earn points, and in Extra Time faster answers typically earn more.`],
  ['How many Season Recap questions are there?', `The game draws 30 questions per round from a larger pool. We list ${SEASON_RECAP_QUESTION_COUNT} questions with their answers, checked against two independent guides on ${SR.verifiedLabel}.`],
  ['Why do I only see two options in Season Recap?', 'Season Recap shows two options and exactly one is right. A few questions, such as which clubs qualified for the Champions League, have many valid answers, so every valid answer is listed.'],
  ['Where did A Nation\'s Story go?', `It has its own collection at ${NATIONS_ROUTE}. Each nation has an overview, and each day groups all questions, options and correct answers together.`],
  ['Are the questions the same for everyone?', 'Extra Time rounds are drawn at random from the pool, so two players rarely see the same 30. A Nation\'s Story is fixed by nation and day, so everyone sees the same set.']
];
const jsonLd = [
  breadcrumbLd([{ name: 'Home', href: '/' }, { name: 'Trivia', href: '/trivia/' }]),
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: absolute('/trivia/'), description,
    hasPart: [
      { '@type': 'WebPage', name: 'Extra Time trivia answers', url: absolute(EXTRA_TIME_ROUTE) },
      { '@type': 'WebPage', name: "A Nation's Story trivia answers", url: absolute(NATIONS_ROUTE) }
    ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }
];
---
<TriviaLayout title={title} description={description} image={SR.banner.jpg} jsonLd={jsonLd}>
  <header class="tv-wrap tv-hero">
    <div class="tv-hero-copy">
      <span class="tv-eyebrow"><i class="tv-live"></i>Two trivia collections</span>
      <h1 class="tv-h1">Know every answer.<br /><span class="tv-grad">Win every round.</span></h1>
      <p class="tv-lede">Choose the format you need: searchable answers and practice for Extra Time, or football-history challenges organised by nation and day.</p>
      <div class="tv-actions" style="margin-top:18px">
        <a class="tv-btn" href={EXTRA_TIME_ROUTE}>Explore Extra Time</a>
        <a class="tv-btn ghost" href={NATIONS_ROUTE}>Explore A Nation&apos;s Story</a>
      </div>
      <p class="tv-note">Each collection has its own search, answer list and practice modes.</p>
    </div>
    <div class="tv-hero-visual" aria-hidden="true">
      <div class="tv-float f1">
        <span class="lbl">Extra Time · Season Recap</span>
        <h3>Which team won the 2025/26 Premier League title?</h3>
        <div class="tv-fopts"><div class="tv-fopt ok">Arsenal <i>✓</i></div><div class="tv-fopt">Liverpool</div></div>
      </div>
      <div class="tv-float f2">
        <span class="lbl">Round result</span>
        <div class="tv-ringbox"><svg class="tv-ring" viewBox="0 0 110 110"><circle class="bg" cx="55" cy="55" r="46" /><circle class="fg" cx="55" cy="55" r="46" /></svg>
        <div class="tv-ringnum"><span>28</span><small>of 30 correct</small></div></div>
      </div>
      <div class="tv-float f3">
        <div class="tv-streak"><b>🔥 9</b><span>answer<br />streak</span></div>
      </div>
    </div>
  </header>

  <div class="tv-wrap">
    <div class="tv-stats tv-reveal">
      <div class="tv-stat"><b data-count={SEASON_RECAP_QUESTION_COUNT + ansCount}>{(SEASON_RECAP_QUESTION_COUNT + ansCount).toLocaleString('en-US')}</b><span>Questions with answers</span></div>
      <div class="tv-stat"><b data-count="2">2</b><span>Trivia collections</span></div>
      <div class="tv-stat"><b data-count={nationCount}>{nationCount}</b><span>Nations in A Nation&apos;s Story</span></div>
      <div class="tv-stat"><b>{SR.verifiedLabel.replace(', 2026', '')}</b><span>Answers last verified</span></div>
    </div>
  </div>

  <section class="tv-wrap tv-section" id="collections">
    <div class="tv-sec-head tv-reveal"><div><span class="tv-kicker">Two collections</span><h2 class="tv-h2">Pick your trivia.</h2></div></div>
    <div class="tv-colls">
      <a class="tv-card tv-coll tv-edge tv-spot tv-reveal" href={EXTRA_TIME_ROUTE} style="--d:1">
        <div class="tv-coll-art tv-art" data-label="Season Recap">
          <img data-optional src={SR.banner.webp} width={SR.banner.width} height={SR.banner.height} alt={SR.banner.alt} loading="lazy" decoding="async" />
          <div class="tv-coll-badges"><span class="tv-pill live"><i class="tv-live"></i>Live now</span><span class="tv-pill gold">Season Recap</span></div>
        </div>
        <div class="tv-coll-body">
          <h2>Extra Time</h2>
          <p>Limited-time trivia events with rounds of up to 30 questions. Season Recap (Challenge) is on right now, with every answer listed and searchable.</p>
          <div class="tv-coll-meta"><span class="tv-pill accent"><b>{SEASON_RECAP_QUESTION_COUNT}</b> answers</span><span class="tv-pill"><b>2</b> options</span><span class="tv-pill"><b>30</b> per round</span></div>
          <div class="tv-coll-go">Open Extra Time <span set:html={ICONS.arrow} style="display:grid;place-items:center;width:42px;height:42px;border-radius:50%" /></div>
        </div>
      </a>
      <a class="tv-card tv-coll tv-edge tv-spot tv-reveal" href={NATIONS_ROUTE} style="--d:2">
        <div class="tv-fan">
          {fan.map((n) => <img src={nationImage(n, 640)} width="640" height="360" alt="" loading="lazy" decoding="async" />)}
        </div>
        <div class="tv-coll-body">
          <h2>A Nation's Story</h2>
          <p>Day-by-day football history for each nation, with four options per question. Each day has one page containing its complete question set and answers.</p>
          <div class="tv-coll-meta"><span class="tv-pill accent"><b>{ansCount}</b> questions</span><span class="tv-pill"><b>{nationCount}</b> nations</span><span class="tv-pill"><b>4</b> options</span></div>
          <div class="tv-coll-go">Open A Nation's Story <span set:html={ICONS.arrow} style="display:grid;place-items:center;width:42px;height:42px;border-radius:50%" /></div>
        </div>
      </a>
    </div>
  </section>

  <section class="tv-wrap tv-section" id="how-it-works">
    <div class="tv-sec-head tv-reveal">
      <div><span class="tv-kicker">How trivia works</span><h2 class="tv-h2">Two formats, one goal.</h2></div>
      <div class="tv-seg" role="tablist" aria-label="Trivia type">
        <button role="tab" aria-selected="true" aria-controls="how-et" data-how="et">Extra Time</button>
        <button role="tab" aria-selected="false" aria-controls="how-ans" data-how="ans">A Nation's Story</button>
      </div>
    </div>
    <div class="tv-how tv-reveal" id="how-et" role="tabpanel">
      <ol class="tv-steps">
        <li><div><h3>Open the Extra Time event</h3><p>Trivia sits inside the Extra Time hub and runs for a limited window. Season Recap (Challenge) is currently open.</p></div></li>
        <li><div><h3>Play a round of 10 to 30 questions</h3><p>Extra Time rounds are usually 10 to 30 questions. Season Recap serves 30, each with just 2 options.</p></div></li>
        <li><div><h3>Questions come from a bigger pool</h3><p>Rounds are drawn from a larger pool, so your 30 differ from a friend's. That is why this site lists the whole pool.</p></div></li>
        <li><div><h3>Correct and fast scores best</h3><p>Correct answers earn points, and faster answers typically earn more. Points climb through reward tiers.</p></div></li>
      </ol>
      <div class="tv-facts">
        <div class="tv-fact"><b>10–30</b><span>questions in a typical round</span></div>
        <div class="tv-fact"><b>2</b><span>options in Season Recap</span></div>
        <div class="tv-fact"><b>{SEASON_RECAP_QUESTION_COUNT}</b><span>answers listed in the pool</span></div>
        <div class="tv-fact"><b>10</b><span>reward tiers up to 60,000 points</span></div>
      </div>
    </div>
    <div class="tv-how" id="how-ans" role="tabpanel" hidden>
      <ol class="tv-steps">
        <li><div><h3>Choose a nation</h3><p>Each nation is its own story with its own set of questions. We cover {nationCount} so far.</p></div></li>
        <li><div><h3>Play it day by day</h3><p>A nation unfolds across Day 1 to Day 9, and the questions are different on every day.</p></div></li>
        <li><div><h3>Pick from four options</h3><p>Every question has 4 options. Early days are easier and later days dig into football history.</p></div></li>
        <li><div><h3>Jump to the right question</h3><p>Search results open the nation and day page, then scroll to the matching question in that complete set.</p></div></li>
      </ol>
      <div class="tv-facts">
        <div class="tv-fact"><b>4</b><span>options per question</span></div>
        <div class="tv-fact"><b>9</b><span>days per nation</span></div>
        <div class="tv-fact"><b>{ansCount}</b><span>questions grouped into day pages</span></div>
        <div class="tv-fact"><b>{nationCount}</b><span>nations available</span></div>
      </div>
    </div>

    <div class="tv-table-wrap tv-reveal" style="margin-top:34px">
      <table class="tv-table">
        <caption class="sr-only" style="position:absolute;left:-9999px">Extra Time compared with A Nation's Story</caption>
        <thead><tr><th></th><th>Extra Time</th><th>A Nation's Story</th></tr></thead>
        <tbody>
          <tr><th scope="row">Question set</th><td>10 to 30 (Season Recap: 30)</td><td>One complete day per page</td></tr>
          <tr><th scope="row">Options</th><td>2 per question</td><td>4 per question</td></tr>
          <tr><th scope="row">Question set</th><td>Random from a larger pool</td><td>Fixed by nation and day</td></tr>
          <tr><th scope="row">Availability</th><td>Limited-time event</td><td>Day-by-day, per nation</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="tv-wrap tv-section" id="accounts">
    <div class="tv-card tv-box tv-reveal">
      <span class="tv-kicker">Free to play</span>
      <h2 class="tv-h2">Answers and practice stay free.</h2>
      <p class="tv-sub">Browse either collection and practise without an account. Sign in only for your profile, Quests, achievements and Tokens.</p>
      <div class="tv-actions">
        <a class="tv-btn" href="/account/">Sign in or create a free account</a>
        <a class="tv-btn ghost" href={EXTRA_TIME_ROUTE}>Season Recap</a>
        <a class="tv-btn ghost" href={NATIONS_ROUTE}>A Nation&apos;s Story</a>
      </div>
    </div>
  </section>

  <section class="tv-wrap tv-section" id="faq">
    <div class="tv-sec-head tv-reveal"><div><span class="tv-kicker">FAQ</span><h2 class="tv-h2">Quick answers.</h2></div></div>
    <div class="tv-faq tv-reveal">
      {faq.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <script>
    // Switch the "How trivia works" panels (both are visible without JS).
    const tabs = document.querySelectorAll('[data-how]');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => { const on = t === tab; t.setAttribute('aria-selected', String(on)); document.getElementById(on ? t.getAttribute('aria-controls') : t.getAttribute('aria-controls')).hidden = !on; });
    }));
    // JS only: show just the first panel to start with.
    document.getElementById('how-ans').hidden = true;
  </script>
</TriviaLayout>
