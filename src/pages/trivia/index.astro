---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyHtml from '../../components/LegacyHtml.astro';
---
<BaseLayout title="FC Mobile Trivia Answers, France, Mexico & Brazil" description="FC Mobile trivia answers for France, Mexico and Brazil, with daily questions, explanations and a player finder for Who Am I clues.">
  <section class="trivia-tools-banner">
    <div><small>NEW · TRIVIA PLAYER FINDER</small><h1>Stuck on a player clue?</h1><p>Search by nation, position, shirt number or player name and get to the answer faster.</p></div>
    <a href="/trivia/player-search">Open Player Finder <b>↗</b></a>
  </section>
  <LegacyHtml file="trivia/index.html" />
</BaseLayout>
<style>
.trivia-tools-banner{width:min(1120px,calc(100% - 40px));margin:24px auto 0;padding:22px 24px;display:flex;justify-content:space-between;align-items:center;gap:25px;border:1px solid #55c7f244;border-radius:16px;background:linear-gradient(135deg,#0d202a,#0d1118);color:#eef8fc}.trivia-tools-banner small{font:900 8px var(--mono);letter-spacing:.14em;color:var(--blue)}.trivia-tools-banner h1{font-size:24px;margin:7px 0 3px;letter-spacing:-.04em}.trivia-tools-banner p{margin:0;color:var(--muted);font-size:11px}.trivia-tools-banner a{flex:0 0 auto;padding:11px 14px;border:1px solid var(--blue);border-radius:9px;color:#06131a;background:var(--blue);font:900 9px var(--mono)}.trivia-tools-banner b{font-size:12px}@media(max-width:650px){.trivia-tools-banner{width:calc(100% - 28px);align-items:flex-start;flex-direction:column}.trivia-tools-banner a{width:100%;text-align:center}}
</style>
