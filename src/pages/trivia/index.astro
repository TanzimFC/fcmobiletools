---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Trivia" description="FC Mobile A Nation's Story trivia for France, Mexico and Brazil.">
  <section class="trivia-shell">
    <div class="trivia-head"><div><p class="eyebrow">FC MOBILE TOOLS · A NATION'S STORY</p><h1>Trivia</h1><p>Choose a nation and jump straight into the existing daily quiz library.</p></div><a class="btn" href="/">Back home</a></div>
    <nav class="nation-nav" aria-label="Trivia nations"><a class="active" href="/trivia">Overview</a><a href="/trivia/france/">France</a><a href="/trivia/mexico/">Mexico</a><a href="/trivia/brazil/">Brazil</a></nav>
    <div class="frame-wrap"><iframe src="/trivia/index.html" title="FC Mobile Trivia" class="quiz-frame"></iframe></div>
  </section>
</BaseLayout>
<style>.trivia-shell{width:min(1160px,calc(100% - 28px));margin:auto;padding:30px 0 70px}.trivia-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:18px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.14em;color:#a78bfa}.trivia-head h1{font-size:clamp(32px,5vw,50px);letter-spacing:-.055em;margin:4px 0}.trivia-head p:not(.eyebrow){color:#8b8794;margin:0;font-size:13px}.btn{padding:10px 13px;border:1px solid #2b2538;border-radius:10px;background:#121019;color:#eee;text-decoration:none;font-size:11px;font-weight:800}.nation-nav{display:flex;gap:5px;overflow:auto;scrollbar-width:none;padding:5px;border:1px solid #24242a;border-radius:14px;background:#0d0d10;margin-bottom:12px}.nation-nav::-webkit-scrollbar{display:none}.nation-nav a{flex:0 0 auto;padding:9px 13px;border-radius:9px;color:#888392;font-size:11px;font-weight:850;text-decoration:none}.nation-nav a:hover,.nation-nav a.active{background:#211735;color:#fff;box-shadow:inset 0 0 0 1px #8b5cf640}.frame-wrap{overflow:hidden;border:1px solid #24242a;border-radius:18px;background:#050505;box-shadow:0 24px 70px #0006}.quiz-frame{display:block;width:100%;height:2100px;border:0}@media(max-width:700px){.trivia-shell{width:calc(100% - 18px);padding-top:20px}.trivia-head{align-items:flex-start;flex-direction:column}.trivia-head .btn{width:100%;text-align:center}.quiz-frame{height:2500px}}
</style>
