---
import TriviaLayout from '../../../../layouts/TriviaLayout.astro';
import Crumbs from '../../../../components/trivia/Crumbs.astro';
import { NATIONS_STORY } from '../../../../data/aNationsStory.js';
import { buildNationQuestions, nationImage, dayUrl, NATION_STYLE } from '../../../../lib/triviaNations.js';
import { breadcrumbLd } from '../../../../lib/triviaCore.js';
import { NATIONS_ROUTE, playUrl } from '../../../../lib/triviaRoutes.js';
import { ICONS } from '../../../../lib/triviaIcons.js';

export function getStaticPaths() {
  return NATIONS_STORY.map((nation) => ({ params: { country: nation.slug }, props: { nation } }));
}
const { nation } = Astro.props;
const st = NATION_STYLE[nation.slug];
const qs = buildNationQuestions().filter((q) => q.nation === nation.slug);
const title = `FC Mobile A Nation's Story ${nation.name} Trivia Answers (All ${nation.days.length} Days)`;
const description = `All ${qs.length} FC Mobile A Nation's Story ${nation.name} trivia answers across ${nation.days.length} days, with every option and the correct answer. ${nation.description || ''}`.trim();
const base = `/trivia/a-nations-story/${nation.slug}/`;
const jsonLd = [breadcrumbLd([{ name: 'Home', href: '/' }, { name: 'Trivia', href: '/trivia/' }, { name: "A Nation's Story", href: NATIONS_ROUTE }, { name: nation.name, href: base }])];
---
<TriviaLayout title={title} description={description} image={nationImage(nation.slug)} accentRgb={st.glow} jsonLd={jsonLd}>
  <div class="tv-wrap">
    <Crumbs trail={[{ name: 'Home', href: '/' }, { name: 'Trivia', href: '/trivia/' }, { name: "A Nation's Story", href: NATIONS_ROUTE }, { name: nation.name }]} />
    <header class="tv-nhero">
      <div>
        <span class="tv-eyebrow">{nation.flag} {nation.name} · A Nation's Story</span>
        <h1 class="tv-h1">{nation.name} <span class="tv-grad">trivia answers</span></h1>
        <p class="tv-lede">{qs.length} questions across {nation.days.length} days. Each day page contains the complete set with four options and correct answers. Use the question links below to jump to a specific question within its group.</p>
        <div class="tv-actions">
          <a class="tv-btn lg pulse" href={playUrl({ set: 'nations-story', nation: nation.slug })} data-play>Practice {nation.name} <span set:html={ICONS.arrow} style="display:contents" /></a>
          <a class="tv-btn ghost lg" href={dayUrl(nation.slug, 'day-1')}>Read Day 1</a>
        </div>
      </div>
      <div class="tv-art" data-label={nation.name}>
        <img src={nationImage(nation.slug, 1280)} srcset={`${nationImage(nation.slug, 640)} 640w, ${nationImage(nation.slug, 1280)} 1280w`} sizes="(max-width: 920px) 100vw, 580px" width="1280" height="720" alt={`${nation.name} A Nation's Story trivia`} fetchpriority="high" decoding="async" />
      </div>
    </header>
  </div>

  <section class="tv-wrap tv-section" style="padding-top:64px">
    <div class="tv-sec-head tv-reveal"><div><span class="tv-kicker">{nation.days.length} days</span><h2 class="tv-h2">Choose a day</h2></div></div>
    <div class="tv-days">
      {nation.days.map((day, i) => {
        const dayQs = qs.filter((q) => q.dayId === day.id);
        return (
          <article class="tv-card tv-day tv-spot tv-reveal" style={`--d:${i % 3}`}>
            <div class="tv-day-top"><span class="tv-day-no">{String(i + 1).padStart(2, '0')}</span>{day.level && <span class="tv-pill accent">{day.level}</span>}</div>
            <h3>{day.title} · {dayQs.length} question{dayQs.length === 1 ? '' : 's'}</h3>
            <ul>{dayQs.map((q) => <li><a href={q.url}>{q.question}</a></li>)}</ul>
            <div class="tv-day-actions">
              <a class="tv-day-cta" href={dayUrl(nation.slug, day.id)}>Day {i + 1} answers →</a>
              <a class="tv-day-play" href={playUrl({ set: 'nations-story', nation: nation.slug, day: i + 1 })}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.8v14.4a.8.8 0 0 0 1.2.7l11.5-7.2a.8.8 0 0 0 0-1.4L8.2 4.1A.8.8 0 0 0 7 4.8Z" fill="currentColor"/></svg>Play</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</TriviaLayout>
