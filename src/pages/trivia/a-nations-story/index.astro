---
import TriviaLayout from '../../../layouts/TriviaLayout.astro';
import Crumbs from '../../../components/trivia/Crumbs.astro';
import SearchBox from '../../../components/trivia/SearchBox.astro';
import { ICONS } from '../../../lib/triviaIcons.js';
import { NATIONS_STORY } from '../../../data/aNationsStory.js';
import { buildNationQuestions, nationImage, nationUrl, NATION_STYLE } from '../../../lib/triviaNations.js';
import { breadcrumbLd } from '../../../lib/triviaCore.js';
import { NATIONS_ROUTE, playUrl } from '../../../lib/triviaRoutes.js';

const all = buildNationQuestions();
const counts = Object.fromEntries(NATIONS_STORY.map((n) => [n.slug, all.filter((q) => q.nation === n.slug).length]));
const dayCount = NATIONS_STORY.reduce((sum, n) => sum + n.days.length, 0);
const title = "FC Mobile A Nation's Story Answers: Every Nation & Day";
const description = `Browse ${all.length} FC Mobile A Nation's Story questions across ${NATIONS_STORY.length} nations and ${dayCount} day pages. Each day keeps its complete question set, four options and correct answers together.`;
const jsonLd = [breadcrumbLd([{ name: 'Home', href: '/' }, { name: 'Trivia', href: '/trivia/' }, { name: "A Nation's Story", href: NATIONS_ROUTE }])];
---
<TriviaLayout title={title} description={description} image={nationImage('japan')} jsonLd={jsonLd}>
  <div class="tv-wrap">
    <Crumbs trail={[{ name: 'Home', href: '/' }, { name: 'Trivia', href: '/trivia/' }, { name: "A Nation's Story" }]} />
    <span class="tv-eyebrow">🌍 A Nation's Story</span>
    <h1 class="tv-h1">Every nation. <span class="tv-grad">Every answer.</span></h1>
    <p class="tv-lede">Browse the football-history challenges by nation, then open a day to see every question, all four options and the correct answers together. Search results jump to the right question inside its day page.</p>
    <SearchBox scope="ans" placeholder="Search a question, player or year…" />
    <div class="tv-actions"><a class="tv-btn lg pulse" href={playUrl({ set: 'nations-story' })} data-play>Practice a nation <span set:html={ICONS.arrow} style="display:contents" /></a><a class="tv-btn ghost lg" href="/trivia/#how-it-works">How it works</a></div>
    <div class="tv-stats tv-reveal" style="margin-top:28px">
      <div class="tv-stat"><b>{NATIONS_STORY.length}</b><span>Nations</span></div>
      <div class="tv-stat"><b>{dayCount}</b><span>Day pages</span></div>
      <div class="tv-stat"><b>{all.length}</b><span>Questions</span></div>
      <div class="tv-stat"><b>4</b><span>Options per question</span></div>
    </div>
  </div>

  <section class="tv-wrap tv-section" style="padding-top:56px">
    <div class="tv-nations">
      {NATIONS_STORY.map((n, i) => {
        const st = NATION_STYLE[n.slug];
        return (
          <article class="tv-card tv-nation tv-edge tv-spot tv-reveal" style={`--g:${st.glow};--d:${i % 2}`}>
            <div class="tv-art" data-label={n.name}>
              <img src={nationImage(n.slug, 1280)} srcset={`${nationImage(n.slug, 640)} 640w, ${nationImage(n.slug, 1280)} 1280w`} sizes="(max-width: 920px) 100vw, 590px" width="1280" height="720" alt={`${n.name} A Nation's Story trivia answers`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="tv-nation-foot">
              <span class="tv-nation-flag">{n.flag}</span>
              <div><h3><a class="tv-stretch" href={nationUrl(n.slug)}>{n.name}</a></h3><p>{counts[n.slug]} questions · {n.days.length} days · {st.blurb}</p></div>
              <a class="tv-btn sm tv-nation-play" href={playUrl({ set: 'nations-story', nation: n.slug })} data-play>Play</a>
              <span class="go" set:html={ICONS.arrow} />
            </div>
          </article>
        );
      })}
    </div>
    <p class="tv-note" style="margin-top:22px">Each nation has its own overview. Open a day for the full grouped question set; question search links to an anchor on that page. More nations will be added as the game releases them.</p>
  </section>
</TriviaLayout>
