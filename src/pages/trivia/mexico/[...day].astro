---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegacyHtml from '../../../components/LegacyHtml.astro';

export function getStaticPaths() {
  return Array.from({ length: 9 }, (_, i) => ({ params: { day: `day-${i + 1}` } }));
}

const route = Astro.params.day || '';
const day = route.replace(/^day-/, '');
const title = `FC Mobile Mexico Trivia Day ${day} Answers`;
const description = `FC Mobile Mexico A Nation's Story trivia Day ${day}: questions, correct answers, hints and explanations.`;
---
<BaseLayout title={title} description={description}>
  <LegacyHtml file={`trivia/mexico/day-${day}/index.html`} />
</BaseLayout>
