/* =========================================================
   FC MOBILE TOOLS — SHARED VISUAL SYSTEM
   Football Centre keeps its existing layout/UX.
   ========================================================= */

body{
  background:var(--fc-bg);
  color:var(--fc-text);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

.app{
  width:min(var(--fc-content-width),calc(100% - 28px));
}

.card,
.match-card,
.stat,
.control-group,
.history-row,
.social{
  box-shadow:none;
}

.card{
  background:var(--fc-surface);
  border:1px solid var(--fc-border);
  border-radius:var(--fc-radius-md);
}

.card:hover{
  border-color:#302f38;
}

.site-nav,
.tool-nav{
  background:#050505e8;
  border-color:var(--fc-border);
  backdrop-filter:blur(16px);
}

.site-nav a,
.tool-nav button{
  color:var(--fc-text-muted);
}

.site-nav a:hover,
.tool-nav button:hover{
  color:#fff;
  background:#ffffff05;
  transform:none;
}

.site-nav .active,
.tool-nav button.active{
  color:#fff;
  background:#8b5cf61a;
  box-shadow:inset 0 0 0 1px #8b5cf633;
}

.eyebrow{
  color:var(--fc-purple-light);
}

.section-label{
  color:var(--fc-text-muted);
}

.stat{
  background:var(--fc-surface-2);
  border-color:var(--fc-border);
}

.stat span,
.kpi p,
.recent,
.hero-meta,
.history-meta{
  color:var(--fc-text-muted);
}

.progress{
  background:#09090b;
  border-color:var(--fc-border);
}

.progress-fill{
  background:var(--fc-purple);
  box-shadow:0 0 14px #8b5cf644;
}

.btn{
  background:#ffffff05;
  color:#dddde3;
  border-color:var(--fc-border);
}

.btn:hover{
  background:#8b5cf60b;
  border-color:#8b5cf655;
}

.btn.primary{
  background:#fff;
  color:#080808;
  border-color:#fff;
}

.btn.primary:hover{
  background:#f0f0f2;
}

.match-card{
  background:var(--fc-surface);
  border-color:var(--fc-border);
}

.match-card:hover{
  border-color:#36353e;
  box-shadow:none;
}

.match-card.has-pick{
  border-color:#8b5cf655;
}

.match-card.correct{
  border-color:#48d98a55;
  background:var(--fc-surface);
}

.match-card.wrong{
  border-color:#ef718055;
  background:var(--fc-surface);
}

.match-card.draw{
  border-color:#d7b45b55;
  background:var(--fc-surface);
}

.choice{
  background:#ffffff05;
  color:var(--fc-text-muted);
  border-color:var(--fc-border);
}

.choice:hover{
  color:#fff;
  background:#8b5cf60b;
  border-color:#8b5cf655;
  box-shadow:none;
}

.choice.selected{
  color:#fff;
  background:#8b5cf61a;
  border-color:#8b5cf655;
  box-shadow:none;
}

.choice.win.selected{
  background:#48d98a18;
  border-color:#48d98a66;
  color:#8be8b5;
}

.choice.draw.selected{
  background:#d7b45b18;
  border-color:#d7b45b66;
  color:#ead28a;
}

.choice.loss.selected{
  background:#ef718018;
  border-color:#ef718066;
  color:#ffabb3;
}

.pill{
  background:#ffffff05;
  border-color:var(--fc-border);
  color:var(--fc-text-muted);
}

.pill.inprogress{
  color:var(--fc-purple-light);
  background:#8b5cf612;
  border-color:#8b5cf655;
}

.pill.done{
  color:#8be8b5;
  background:#48d98a12;
  border-color:#48d98a55;
}

/* Analysis cards */
.analysis-card{
  background:var(--fc-surface);
  border-color:var(--fc-border);
}

.analysis-badge{
  background:#050505d9;
  border-color:#ffffff18;
}

.analysis-play{
  background:#8b5cf6;
  box-shadow:0 0 24px #8b5cf655;
}

.analysis-link{
  background:#8b5cf612;
  border-color:#8b5cf655;
  color:#d8d1ff;
}

.analysis-link:hover{
  background:#8b5cf61c;
  border-color:#8b5cf677;
}

.analysis-link.secondary{
  background:#ffffff05;
  border-color:var(--fc-border);
  color:#aaaab2;
}

/* Dashboard video */
.quick-guide{
  margin-top:13px;
  padding:16px;
}

.quick-guide-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-bottom:12px;
}

.quick-guide h2{
  margin:2px 0 0;
  font-size:15px;
}

.quick-guide p{
  margin:3px 0 0;
  color:var(--fc-text-muted);
  font-size:10px;
}

.guide-player{
  position:relative;
  width:100%;
  aspect-ratio:16/7;
  max-height:390px;
  overflow:hidden;
  border-radius:var(--fc-radius-md);
  background:#08080a;
  border:1px solid var(--fc-border);
}

.guide-player iframe{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  border:0;
  display:block;
}

/* Analysis player */
.analysis-player{
  background:var(--fc-surface);
  border-color:var(--fc-border);
}

.analysis-player .video-wrap{
  position:relative;
  width:100%;
  aspect-ratio:16/9;
  overflow:hidden;
  border-radius:var(--fc-radius-lg);
  background:#08080a;
  border:1px solid var(--fc-border);
}

.analysis-player iframe{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  border:0;
}

@media(max-width:720px){
  .quick-guide-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .quick-guide .btn{
    width:100%;
  }

  .guide-player{
    aspect-ratio:16/9;
    max-height:none;
  }
}
