'AZ Alkmaar':'https://commons.wikimedia.org/wiki/Special:Redirect/file/AZ_Alkmaar.svg',
'FC Utrecht':'https://commons.wikimedia.org/wiki/Special:Redirect/file/FC_Utrecht.svg',
'Newcastle United':'https://upload.wikimedia.org/wikipedia/en/thumb/5/56/Newcastle_United_Logo.svg/250px-Newcastle_United_Logo.svg.png',
'Liverpool FC':'https://upload.wikimedia.org/wikipedia/en/thumb/0/0c/Liverpool_FC.svg/250px-Liverpool_FC.svg.png',
'Udinese Calcio':'https://upload.wikimedia.org/wikipedia/en/thumb/c/ce/Udinese_Calcio_logo.svg/250px-Udinese_Calcio_logo.svg.png',
