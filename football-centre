:root{
  --fc-bg:#050505;
  --fc-surface:#0d0d10;
  --fc-surface-2:#121216;
  --fc-border:#24242a;

  --fc-text:#f5f5f7;
  --fc-text-secondary:#bdbdc5;
  --fc-text-muted:#898991;
  --fc-text-faint:#62626b;

  --fc-purple:#8b5cf6;
  --fc-purple-light:#a78bfa;

  --fc-success:#48d98a;
  --fc-error:#ef7180;

  --fc-content-width:1080px;

  --fc-radius-sm:9px;
  --fc-radius-md:15px;
  --fc-radius-lg:18px;
  --fc-radius-xl:22px;

  --bg:var(--fc-bg);
  --p:var(--fc-surface);
  --p2:var(--fc-surface-2);
  --line:var(--fc-border);
  --txt:var(--fc-text);
  --muted:var(--fc-text-muted);
  --purple:var(--fc-purple);
  --blue:#6f9cff;
  --green:var(--fc-success);
  --red:var(--fc-error);
  --yellow:#d7b45b;
}
.dashboard-currency{width:34px;height:34px;object-fit:contain;vertical-align:-7px;margin-right:7px;filter:drop-shadow(0 0 10px rgba(124,92,255,.38))}
.team-btn,.result-btn,.tool-nav button,.social,.site-nav a{transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease,background .18s ease,filter .18s ease}
.team-btn:hover,.result-btn:hover,.tool-nav button:hover,.social:hover,.site-nav a:hover{transform:translateY(-1px);filter:brightness(1.08)}


