};
const PAIRS=[
[['Sevilla FC','Rayo Vallecano'],['AZ Alkmaar','FC Utrecht']],
[['Newcastle United','Liverpool FC'],['Udinese Calcio','Como 1907']],
[['Team A','Team B'],['Team A','Team B']],
[['Team A','Team B'],['Team A','Team B']]
];
const clone=x=>JSON.parse(JSON.stringify(x)),uid=()=>Math.random().toString(36).slice(2)+Date.now().toString(36),esc=x=>String(x??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function defaults(){return{version:4,cycle:clone(DEFAULT),days:DEFAULT.map((n,i)=>({id:'d'+(i+1),matches:Array.from({length:n},(_,j)=>({id:uid(),a:PAIRS[i]?.[j]?.[0]||'Team A',b:PAIRS[i]?.[j]?.[1]||'Team B',pick:null,result:'Pending',difficulty:'Other'}))}))}}
function normalize(x){const d=defaults();
if(x&&Array.isArray(x.days)&&x.days[1]){
const confirmed=PAIRS[1]||[];
x.days[1].matches=(x.days[1].matches||[]).map((m,j)=>{
if(!m||typeof m!=='object')return m;
if((m.a==='Team A'||!m.a)&&confirmed[j])m.a=confirmed[j][0];
if((m.b==='Team B'||!m.b)&&confirmed[j])m.b=confirmed[j][1];
return m;
});
}
if(x&&Array.isArray(x.days))x.days.forEach(day=>(day.matches||[]).forEach(m=>{
if(m.a==='Sevilla')m.a='Sevilla FC'; if(m.a==='Rayo')m.a='Rayo Vallecano'; if(m.a==='AZ')m.a='AZ Alkmaar';
if(m.b==='Sevilla')m.b='Sevilla FC'; if(m.b==='Rayo')m.b='Rayo Vallecano'; if(m.b==='AZ')m.b='AZ Alkmaar'; if(m.difficulty!=='Other')m.difficulty='World Class';
}));
if(!x||typeof x!=='object')return d;const cy=Array.isArray(x.cycle)&&x.cycle.length?x.cycle.map(n=>Math.max(1,Math.min(8,Number(n)||1))):DEFAULT;d.cycle=cy;d.days=cy.map((n,i)=>{const old=x.days?.[i],oms=old?.matches||[],pairs=PAIRS[i]||[];return{id:old?.id||'d'+(i+1),matches:Array.from({length:n},(_,j)=>{const s=oms[j]||{};return{id:s.id||uid(),a:typeof s.a==='string'&&s.a.trim()?s.a:(pairs[j]?.[0]||'Team A'),b:typeof s.b==='string'&&s.b.trim()?s.b:(pairs[j]?.[1]||'Team B'),pick:s.pick==='A'||s.pick==='B'?s.pick:null,result:['Pending','Win','Draw','Loss'].includes(s.result)?s.result:'Pending',difficulty:s.difficulty==='World Class'?'World Class':'Other'}})} });return d}
function load(){try{return normalize(JSON.parse(localStorage.getItem(KEY)||'null'))}catch{return defaults()}}let data=load();
const save=()=>localStorage.setItem(KEY,JSON.stringify(data)),all=()=>data.days.flatMap(d=>d.matches),isPlayed=m=>m.result!=='Pending',isWorld=m=>m.difficulty!=='Other',pts=m=>isPlayed(m)?BASE+(isWorld(m)?WORLD:0)+(m.result==='Win'?WIN:0):0;
function calc(){
 const ms=all(),done=ms.filter(isPlayed),wins=done.filter(m=>m.result==='Win').length;
 const show=done.reduce((s,m)=>s+BASE+(m.result==='Win'?WIN:0),0);
 const match=done.reduce((s,m)=>s+(isWorld(m)?WORLD:0),0);
 const current=show+match,rem=ms.length-done.length;
 const futureBase=ms.filter(m=>!isPlayed(m)).reduce((s,m)=>s+BASE+(isWorld(m)?WORLD:0),0);
 const best=current+futureBase+rem*WIN;
 const worst=current+futureBase;
 const need=Math.max(0,TARGET-current);
 const min=need?Math.max(0,Math.min(rem,Math.ceil(Math.max(0,need-futureBase)/WIN))):0;
 return{ms,done,wins,show,match,current,rem,best,worst,min,acc:done.length?wins/done.length*100:0}
}
