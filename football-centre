  document.querySelectorAll('.page').forEach(e=>e.classList.toggle('active',e.id===p));
  document.querySelectorAll('.tool-nav button').forEach(e=>e.classList.toggle('active',e.dataset.page===p));
  if(hash)history.replaceState(null,'','#'+p);
  if(scrollTop)window.scrollTo({top:0,behavior:'smooth'});
}
function openAnalysis(matchday=1){
  const cfg=ANALYSIS_VIDEOS[matchday]||ANALYSIS_VIDEOS[1];
  go('analysis',true,false);
  const box=document.getElementById('analysis-player');
  const frame=document.getElementById('analysisIframe');
  const eyebrow=document.getElementById('analysisPlayerEyebrow');
  const title=document.getElementById('analysisPlayerTitle');
  const hint=document.getElementById('analysisPlayerHint');
  const src=`https://www.youtube.com/embed/${cfg.id}?si=-G1JGPxdfEfK3yhx&controls=1&rel=0&playsinline=1`;
  eyebrow.textContent=cfg.title.toUpperCase();
  title.textContent=`Watch ${cfg.title}`;
  hint.textContent='The video is loaded only when you choose to play it.';
  frame.setAttribute('title',`Football Centre ${cfg.title}`);
  if(frame.getAttribute('src')!==src)frame.setAttribute('src',src);
  box.hidden=false;
  requestAnimationFrame(()=>box.scrollIntoView({behavior:'smooth',block:'start'}));
}
function closeAnalysis(){
  const box=document.getElementById('analysis-player');
  const frame=document.getElementById('analysisIframe');
  frame.removeAttribute('src');
  box.hidden=true;
}
function renderMatches(){
 const root=document.getElementById('matchdays');root.innerHTML='';
 data.days.forEach((d,i)=>{
  const done=d.matches.filter(isPlayed),wins=done.filter(m=>m.result==='Win').length;
  const started=d.matches.some(m=>m.pick||isPlayed(m));
  const state=done.length===d.matches.length?'Completed':started?'In progress':'Not started';
  const stateClass=state==='Completed'?'done':state==='In progress'?'inprogress':' ';
  const points=d.matches.reduce((s,m)=>s+pts(m),0);
  const wrap=document.createElement('section');wrap.className='card matchday';
  wrap.innerHTML=`<div class="matchday-head"><div><div class="eyebrow">MATCHDAY ${i+1}</div><div class="day-title">${done.length}/${d.matches.length} played · ${wins} correct</div></div><div class="day-status"><span class="pill ${stateClass}">${state}</span><span class="pill">${points.toLocaleString()} pts</span></div></div><div class="match-list"></div>`;
  const list=wrap.querySelector('.match-list');
  d.matches.forEach((m,j)=>{
   const a=team(m.a),b=team(m.b),card=document.createElement('article');
   card.className='match-card '+(m.result==='Win'?'correct':m.result==='Loss'?'wrong':m.result==='Draw'?'draw':'')+(m.pick?' has-pick':'');
   const img=t=>t.logo?`<img src="${esc(t.logo)}" alt="${esc(t.name)} logo" onerror="this.style.display='none'">`:'<div class="logo-placeholder"></div>';
   const earned=isPlayed(m)?pts(m):0;
   const pointLabel=isPlayed(m)?`+${earned}`:'—';
   const difficultyLabel=isWorld(m)?'WORLD CLASS · +20':'OTHER · +0';
   card.innerHTML=`<div class="match-top"><span class="showdown-label"><img class="showdown-mini" src="https://tanzimfc.fcmobiletools.workers.dev/assets/images/Showdown_card.png" alt=""> SHOWDOWN ${j+1}</span><span class="points ${m.result==='Win'?'win':''}">${pointLabel}</span></div>
   <div class="matchup"><div class="team">${img(a)}<div class="team-name">${esc(a.name)}</div><div class="team-sub">TEAM A</div></div><div class="vs">VS</div><div class="team">${img(b)}<div class="team-name">${esc(b.name)}</div><div class="team-sub">TEAM B</div></div></div>
   <div class="controls">
    <div class="control-group"><div class="control-label"><span>PICK</span><span>${m.pick?'SELECTED':'CHOOSE TEAM'}</span></div><div class="segment"><button class="choice ${m.pick==='A'?'selected':''}" data-a="pick" data-v="A">${esc(a.name)}</button><button class="choice ${m.pick==='B'?'selected':''}" data-a="pick" data-v="B">${esc(b.name)}</button></div></div>
    <div class="control-group"><div class="control-label"><span>RESULT</span><span>${m.result==='Pending'?'PENDING':m.result==='Win'?'WON':m.result==='Loss'?'LOST':'DRAW'}</span></div><div class="segment three"><button class="choice win ${m.result==='Win'?'selected':''}" data-a="result" data-v="Win">WON</button><button class="choice draw ${m.result==='Draw'?'selected':''}" data-a="result" data-v="Draw">DRAW</button><button class="choice loss ${m.result==='Loss'?'selected':''}" data-a="result" data-v="Loss">LOST</button></div></div>
    <div class="control-group difficulty-group"><div class="control-label"><span>DIFFICULTY</span><span>${difficultyLabel}</span></div><div class="segment two"><button class="choice ${isWorld(m)?'selected':''}" data-a="difficulty" data-v="World Class">WORLD CLASS <small>+20</small></button><button class="choice ${!isWorld(m)?'selected':''}" data-a="difficulty" data-v="Other">OTHER <small>+0</small></button></div></div>
   </div><div class="match-actions"><span class="earned-note">${isPlayed(m)?(isWorld(m)?'World Class bonus included':'No World Class bonus'):'Choose a difficulty for this match'}</span><span class="match-action-links"><button class="analysis-link match-analysis-link" type="button" data-a="analysis">🎬 Analysis</button><button class="reset" data-a="reset">↺ Reset</button></span></div>`;
   card.querySelectorAll('[data-a]').forEach(btn=>btn.addEventListener('click',()=>{
    if(btn.dataset.a==='pick')m.pick=btn.dataset.v;
    if(btn.dataset.a==='result')m.result=btn.dataset.v;
    if(btn.dataset.a==='difficulty')m.difficulty=btn.dataset.v;
    if(btn.dataset.a==='reset'){m.pick=null;m.result='Pending';m.difficulty='World Class'} if(btn.dataset.a==='analysis'){openAnalysis(i+1);return}
    save();renderAll(false)
   }));
   list.appendChild(card)
  });
  root.appendChild(wrap)
 })
}
function renderHistory(){const root=document.getElementById('historyList');root.innerHTML=data.days.map((d,i)=>{const done=d.matches.filter(isPlayed),wins=done.filter(m=>m.result==='Win').length,points=d.matches.reduce((s,m)=>s+pts(m),0),started=d.matches.some(m=>m.pick||isPlayed(m)),state=done.length===d.matches.length?'Completed':started?'In progress':'Not started';return`<div class="history-row"><div><div class="history-title">Matchday ${i+1}</div><div class="history-meta">${done.length}/${d.matches.length} played · ${wins} correct</div></div><div class="history-meta"><b style="color:#eee8ff">${points.toLocaleString()} pts</b><br>${state}</div></div>`}).join('')}
function renderCycle(){const root=document.getElementById('cycleEditor');root.innerHTML='';data.cycle.forEach((n,i)=>{const r=document.createElement('div');r.className='cycle-row';r.innerHTML=`<span>Matchday ${i+1}</span><input type="number" min="1" max="8" value="${n}"><button class="icon-btn" ${data.cycle.length===1?'disabled':''}>×</button>`;r.querySelector('input').addEventListener('change',e=>{const next=Math.max(1,Math.min(8,Number(e.target.value)||1)),old=data.days[i]?.matches||[];data.cycle[i]=next;data.days[i].matches=Array.from({length:next},(_,j)=>old[j]||{id:uid(),a:PAIRS[i]?.[j]?.[0]||'Team A',b:PAIRS[i]?.[j]?.[1]||'Team B',pick:null,result:'Pending',difficulty:'World Class'});save();renderAll(false);toast('Matchday updated')});r.querySelector('.icon-btn').addEventListener('click',()=>{if(data.cycle.length===1)return;data.cycle.splice(i,1);data.days.splice(i,1);save();renderAll(false);toast('Matchday removed')});root.appendChild(r)});document.getElementById('cyclePill').textContent=`${data.cycle.length} MATCHDAYS · ${data.cycle.reduce((a,b)=>a+b,0)} GAMES`}
document.addEventListener('click',e=>{
 const b=e.target.closest('[data-analysis-open]');
 if(b){e.preventDefault();openAnalysis(Number(b.dataset.analysisOpen)||1);}
});
document.getElementById('closeAnalysisPlayer')?.addEventListener('click',closeAnalysis);
function renderAll(nav=true){renderDash();renderMatches();renderHistory();renderCycle();if(nav)go(location.hash.slice(1)||'dashboard',false)}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();go(b.dataset.page,true)}));document.getElementById('addMatchday').addEventListener('click',()=>{const i=data.cycle.length;data.cycle.push(2);data.days.push({id:'d'+(i+1),matches:[0,1].map(()=>({id:uid(),a:'Team A',b:'Team B',pick:null,result:'Pending',difficulty:'Other'}))});save();renderAll(false);toast('Matchday added')});document.getElementById('restoreDefaults').addEventListener('click',()=>{const old=data.days;data.cycle=clone(DEFAULT);data.days=data.cycle.map((n,i)=>({id:'d'+(i+1),matches:Array.from({length:n},(_,j)=>old[i]?.matches[j]||{id:uid(),a:PAIRS[i][j][0],b:PAIRS[i][j][1],pick:null,result:'Pending',difficulty:'World Class'})}));save();renderAll(false);toast('Defaults restored')});document.getElementById('backup').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({app:'Football Centre Calculator',version:5,exportedAt:new Date().toISOString(),cycle:data.cycle,days:data.days},null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='football-centre-backup.json';a.click();URL.revokeObjectURL(u);toast('Backup downloaded')});document.getElementById('restoreFile').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{data=normalize(JSON.parse(r.result));save();renderAll(false);go('dashboard');toast('Backup restored')}catch{toast('Invalid backup file')}};r.readAsText(f);e.target.value=''});addEventListener('hashchange',()=>go(location.hash.slice(1)||'dashboard',false));renderAll();
})();
</script></body></html>
