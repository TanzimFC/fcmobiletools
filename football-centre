document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();go(b.dataset.page,true)}));document.getElementById('addMatchday').addEventListener('click',()=>{const i=data.cycle.length;data.cycle.push(2);data.days.push({id:'d'+(i+1),matches:[0,1].map(()=>({id:uid(),a:'Team A',b:'Team B',pick:null,result:'Pending',difficulty:'Other'}))});save();renderAll(false);toast('Matchday added')});document.getElementById('restoreDefaults').addEventListener('click',()=>{const old=data.days;data.cycle=clone(DEFAULT);data.days=data.cycle.map((n,i)=>({id:'d'+(i+1),matches:Array.from({length:n},(_,j)=>old[i]?.matches[j]||{id:uid(),a:PAIRS[i][j][0],b:PAIRS[i][j][1],pick:null,result:'Pending',difficulty:'World Class'})}));save();renderAll(false);toast('Defaults restored')});document.getElementById('backup').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({app:'Football Centre Calculator',version:5,exportedAt:new Date().toISOString(),cycle:data.cycle,days:data.days},null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='football-centre-backup.json';a.click();URL.revokeObjectURL(u);toast('Backup downloaded')});document.getElementById('restoreFile').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{data=normalize(JSON.parse(r.result));save();renderAll(false);go('dashboard');toast('Backup restored')}catch{toast('Invalid backup file')}};r.readAsText(f);e.target.value=''});addEventListener('hashchange',()=>go(location.hash.slice(1)||'dashboard',false));renderAll();
})();
