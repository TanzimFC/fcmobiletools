  if(!active){body.innerHTML='<b>No matchday currently in progress.</b>';return;}
  const pending=active.d.matches.find(m=>m.pick&&!isPlayed(m));
  const picked=pending.pick==='A'?pending.a:pending.b;
  body.innerHTML=`<div style="font-size:13px;font-weight:950;margin-bottom:6px">Matchday ${active.i+1}</div><div style="font-weight:900">${esc(picked)} prediction selected</div><div class="recent" style="margin-top:5px">→ Enter result after the match</div>`;
}
