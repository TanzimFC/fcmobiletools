{
  "name": "fcmobiletools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-legacy.mjs && astro dev --port 3000 --host 0.0.0.0",
    "build": "node scripts/check-worker-syntax.mjs && node scripts/check-admin-scripts.mjs && node scripts/build-static.mjs",
    "astro:build": "astro build",
    "test:team-ovr": "node scripts/test-team-ovr.mjs",
    "test:training": "node scripts/test-training-calculator.mjs",
    "test:rank-up": "node scripts/test-rank-up-calculator.mjs",
    "preview": "wrangler dev ./dist",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.2.1",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "hash-wasm": "^4.12.0",
    "remark-gfm": "^4.0.1",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "packageManager": "npm@10.9.2"
}
