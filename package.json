{
  "name": "fcmobiletools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/player-data/generate-playstyle-assets.mjs && node scripts/player-data/generate-top-players.mjs && node scripts/check-worker-syntax.mjs && node scripts/verify-editorial-runtime.mjs && node scripts/build-static.mjs",
    "astro:build": "astro build",
    "test:team-ovr": "node scripts/test-team-ovr.mjs",
    "test:training": "node scripts/test-training-calculator.mjs",
    "test:rank-up": "node scripts/test-rank-up-calculator.mjs",
    "preview": "wrangler dev ./dist",
    "deploy": "npm run build && wrangler deploy",
    "player-index": "node scripts/player-data/generate-top-players.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "hash-wasm": "^4.12.0",
    "remark-gfm": "^4.0.1",
    "@astrojs/cloudflare": "^12.2.1"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
