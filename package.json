{
  "name": "fcmobiletools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-legacy.mjs && astro dev --port 3000 --host 0.0.0.0",
    "build": "node scripts/check-worker-syntax.mjs && node scripts/check-admin-scripts.mjs && npm test && node scripts/build-static.mjs",
    "astro:build": "astro build",
    "test:team-ovr": "node scripts/test-team-ovr.mjs",
    "test:training": "node scripts/test-training-calculator.mjs",
    "test:rank-up": "node scripts/test-rank-up-calculator.mjs",
    "preview": "wrangler dev ./dist",
    "deploy": "npm run build && wrangler deploy",
    "test:leagues": "node scripts/test-leagues.mjs",
    "test:league-smart": "node scripts/test-league-smart.mjs",
    "test:trivia": "node scripts/test-trivia.mjs",
    "test:giveaway": "node scripts/test-giveaway.mjs",
    "trivia:banner": "node scripts/cache-trivia-banner.mjs",
    "test:upload-quota": "node scripts/test-image-upload-quota.mjs",
    "test:playstyle-finder": "node scripts/test-playstyle-finder.mjs",
    "test": "npm run test:i18n && npm run test:push && npm run test:team-ovr && npm run test:training && npm run test:rank-up && npm run test:upload-quota && npm run test:playstyle-finder && npm run test:leagues && npm run test:league-smart && npm run test:trivia && npm run test:giveaway && npm run test:ads",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:push": "node scripts/test-push.mjs && node --no-warnings scripts/test-push-worker.mjs && node --no-warnings scripts/test-push-client.mjs",
    "test:ads": "node --no-warnings scripts/test-ads.mjs",
    "ads:art": "node scripts/make-ad-art.mjs && cp src/styles/ads.css public/assets/ads-preview.css"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.2.1",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^5.14.1",
    "hash-wasm": "^4.12.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  },
  "packageManager": "npm@10.9.2"
}
