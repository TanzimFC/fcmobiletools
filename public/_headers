# Fingerprinted Astro build assets can be cached for a year safely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache public images in browsers to reduce repeat downloads while limiting staleness.
/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Season Recap is a local, static answer reference. Revalidate the HTML daily.
 /trivia/season-recap/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
