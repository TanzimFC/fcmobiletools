{
  "name": "fcmobiletools-anniversary-player-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "discover": "node collector.mjs --discover",
    "pilot": "node collector.mjs --limit 5",
    "pilot:assets": "node collector.mjs --limit 5 --download-images",
    "collect": "node collector.mjs --all --download-images",
    "validate": "node validate.mjs",
    "pilot:progression": "node collector.mjs --limit 5 --capture-progression",
    "collect:fresh": "node collector.mjs --all --download-images --fresh",
    "import:catalog": "node import-catalog.mjs",
    "import:catalog:dry": "node import-catalog.mjs --dry-run"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  }
}
