# Copy this file to .env locally; never commit the real .env file.
# Supabase project URL can be omitted for this FCMobiletools project.
SUPABASE_URL=https://moczgrwxtfexdbjthxpd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Backblaze B2 native API credentials.
B2_ACCOUNT_ID=replace-with-b2-account-id
B2_APPLICATION_KEY=replace-with-b2-application-key
B2_BUCKET_ID=replace-with-b2-bucket-id
B2_BUCKET_NAME=replace-with-public-bucket-name
# Public download base / custom CDN host, without a trailing slash.
# Example shape: https://assets.example.com
B2_PUBLIC_BASE_URL=https://replace-with-your-public-b2-domain

# Fallback only if a card's exact Anniversary template cannot be identified from its metadata.
# The observed dataset suggests LIVE at 117+ OVR and BASE below 117.
ANNIVERSARY_LIVE_MIN_OVR=117
